IDENTIFICATION DIVISION.
PROGRAM-ID. CLTGUARD.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BKIDMP".
01 WS-LOCK-NAME PIC X(24).
01 WS-LOCK-STATUS PIC X(02).
01 WS-PREV-OP PIC X(16).
01 WS-HIT PIC X(01).

LINKAGE SECTION.
COPY "CLTGDP".

PROCEDURE DIVISION USING BK-CLT-GUARD.
    MOVE "N" TO GD-HIT
    EVALUATE GD-OP
        WHEN "LOCK" PERFORM DO-LOCK
        WHEN "UNLOCK" PERFORM DO-UNLOCK
        WHEN "BEGIN" PERFORM DO-BEGIN
        WHEN "END" PERFORM DO-END
        WHEN OTHER
            MOVE "99" TO GD-RC
    END-EVALUATE
    GOBACK.

DO-LOCK.
    MOVE "00" TO GD-RC
    MOVE SPACES TO WS-LOCK-NAME
    STRING "CLT-" DELIMITED SIZE GD-LOCK-ID DELIMITED SIZE
        INTO WS-LOCK-NAME
    END-STRING
    CALL "BLCK" USING WS-LOCK-NAME GD-OPERATOR "A"
        WS-LOCK-STATUS
    IF WS-LOCK-STATUS NOT = "00"
        MOVE "24" TO GD-RC
    END-IF.

DO-UNLOCK.
    MOVE SPACES TO WS-LOCK-NAME
    STRING "CLT-" DELIMITED SIZE GD-LOCK-ID DELIMITED SIZE
        INTO WS-LOCK-NAME
    END-STRING
    CALL "BLCK" USING WS-LOCK-NAME GD-OPERATOR "R"
        WS-LOCK-STATUS.

DO-BEGIN.
    MOVE "00" TO GD-RC
    IF GD-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE GD-REQUEST TO BK-IDM-TXN-ID
    MOVE GD-OPERATION TO BK-IDM-OPERATION
    MOVE "B" TO BK-IDM-MODE
    MOVE SPACES TO BK-IDM-RESULT
    CALL "BIDM" USING BK-IDM-PARMS
    IF BK-IDM-STATUS = "22"
        MOVE "G" TO BK-IDM-MODE
        CALL "BIDM" USING BK-IDM-PARMS
        EVALUATE BK-IDM-STATUS
            WHEN "C"
                MOVE BK-IDM-RESULT TO GD-RESULT
                MOVE "Y" TO GD-HIT
            WHEN "F"
                CONTINUE
            WHEN OTHER
                MOVE "24" TO GD-RC
        END-EVALUATE
    ELSE
        IF BK-IDM-STATUS NOT = "00"
            MOVE BK-IDM-STATUS TO GD-RC
        END-IF
    END-IF.

DO-END.
    IF GD-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE GD-REQUEST TO BK-IDM-TXN-ID
    MOVE SPACES TO BK-IDM-RESULT
    IF GD-RC = "00"
        MOVE GD-RESULT TO BK-IDM-RESULT
        MOVE "C" TO BK-IDM-MODE
    ELSE
        MOVE GD-RESULT TO BK-IDM-RESULT
        MOVE "F" TO BK-IDM-MODE
    END-IF
    CALL "BIDM" USING BK-IDM-PARMS.
