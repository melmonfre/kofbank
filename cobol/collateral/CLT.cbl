IDENTIFICATION DIVISION.
PROGRAM-ID. CLT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CURR-FILE ASSIGN TO WS-CURR-FILE
    ORGANIZATION IS LINE SEQUENTIAL
    ACCESS MODE IS SEQUENTIAL
    FILE STATUS IS WS-CURR-ST.

DATA DIVISION.
FILE SECTION.
FD CURR-FILE.
01 CURR-REC-LINE PIC X(200).

WORKING-STORAGE SECTION.
01 WS-ENT PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-AB PIC X(120).
01 WS-AA PIC X(120).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTSTO".
COPY "CLTCFGP".
COPY "CLTQL".
01 WS-HOME PIC X(80).
01 WS-CURR-FILE PIC X(200).
01 WS-CURR-ST PIC X(02).
01 WS-ACT PIC X(16).
01 WS-NEXT PIC X(12).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "COLLATERAL".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-OK PIC X(01).
01 WS-FOUND PIC X(01).
01 WS-EOF PIC X(01).
01 WS-I PIC 9(05).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
 01 TYPE-TABLE.
    05 T-NAME PIC X(20) OCCURS 12 TIMES.
 01 KIND-TABLE.
    05 K-NAME PIC X(20) OCCURS 5 TIMES.
 01 WS-KEY PIC X(20).
 01 BK-CLT-COLL.
    COPY "CLTC".

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    PERFORM INIT-TABLES
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    EVALUATE CP-OP
        WHEN "CREATE" PERFORM DO-CREATE
        WHEN "GET" PERFORM DO-GET
        WHEN "VALIDATE" PERFORM DO-ACTION
        WHEN "REVIEW" PERFORM DO-ACTION
        WHEN "REINSTATE" PERFORM DO-ACTION
        WHEN "INVALIDATE" PERFORM DO-ACTION
        WHEN "ENCUMBER" PERFORM DO-ACTION
        WHEN "CANCEL" PERFORM DO-ACTION
        WHEN "EXPIRE" PERFORM DO-ACTION
        WHEN "SETEXP" PERFORM DO-SETEXP
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN COLLATERAL OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

DO-CREATE.
    PERFORM VALIDATE-NEW
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-DUP-REF
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-ID
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-CLT-COLL
    MOVE CP-COLL-ID TO CT-ID
    MOVE CP-COLL-TYPE TO CT-TYPE
    MOVE "REGISTER" TO CT-STATUS
    MOVE CP-CUST-ID TO CT-CUST-ID
    MOVE CP-OWNER-ID TO CT-OWNER-ID
    MOVE CP-OWNER-KIND TO CT-OWNER-KIND
    MOVE CP-GUARANTOR TO CT-GUARANTOR
    MOVE CP-GUARANTEED TO CT-GUARANTEED
    MOVE CP-BENEFICIARY TO CT-BENEFICIARY
    MOVE CP-CURRENCY TO CT-CURRENCY
    MOVE CP-GUARANTEE-MAX TO CT-GUARANTEE-MAX
    MOVE CP-REG-REF TO CT-REG-REF
    MOVE CP-EXTERNAL-REF TO CT-EXTERNAL-REF
    MOVE CP-JURISDICTION TO CT-JURISDICTION
    MOVE CP-DESCRIPTION TO CT-DESCRIPTION
    MOVE CP-EFF-DATE TO CT-EFF-DATE
    MOVE CP-EXP-DATE TO CT-EXP-DATE
    MOVE CP-REASON TO CT-REASON
    MOVE CP-OPERATOR TO CT-OPERATOR
    MOVE WS-BIZDATE TO CT-CREATED
    MOVE WS-BIZDATE TO CT-UPDATED
    MOVE 1 TO CT-VERSION
    MOVE "N" TO CT-REVIEW-FLAG
    MOVE "N" TO CT-DOC-REQ
    MOVE "NOT-REQ" TO CT-DOC-STATE
    MOVE 0 TO CT-VALUATION
    MOVE 0 TO CT-HAIRCUT-BPS
    MOVE 0 TO CT-ADJUSTED
    MOVE 0 TO CT-ELIGIBLE
    MOVE 0 TO CT-ALLOCATED
    MOVE 0 TO CT-AVAILABLE
    MOVE 0 TO CT-GUARANTEE-MAX
    MOVE CP-GUARANTEE-MAX TO CT-GUARANTEE-MAX
    PERFORM LOAD-TYPE-POLICY
    IF CT-DOC-REQ = "Y"
        MOVE "MISSING" TO CT-DOC-STATE
    ELSE
        MOVE "NOT-REQ" TO CT-DOC-STATE
    END-IF
    PERFORM COMPUTE-HASH
    MOVE "WRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "COLLATERAL WRITE FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM SHOW-COLLATERAL
    MOVE "COLLATERAL REGISTERED" TO CP-MSG
    MOVE CP-COLL-ID TO WS-ENT
    MOVE "CREAT" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    MOVE CT-STATUS TO WS-AA
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

DO-GET.
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM SHOW-COLLATERAL.

DO-ACTION.
    MOVE CP-OP TO WS-ACT
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CT-STATUS TO CP-STATUS
    CALL "CLTST" USING CT-STATUS WS-ACT WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE WS-STT-RC TO CP-RC
        MOVE WS-STT-MSG TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NEXT TO CT-STATUS
    IF CP-REASON NOT = SPACES
        MOVE CP-REASON TO CT-REASON
    END-IF
    IF WS-ACT = "EXPIRE"
        MOVE WS-BIZDATE TO CT-EXP-DATE
    END-IF
    PERFORM SAVE-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM RECOMPUTE-STATE
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM SHOW-COLLATERAL
    MOVE WS-ACT TO CP-MSG
    MOVE CP-COLL-ID TO WS-ENT
    MOVE "CHG" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    MOVE CP-STATUS TO WS-AB
    MOVE CT-STATUS TO WS-AA
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

DO-SETEXP.
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CP-EFF-DATE = 0
        MOVE CT-EFF-DATE TO CP-EFF-DATE
    END-IF
    IF CP-EXP-DATE NOT = 0
        IF CP-EXP-DATE <= CP-EFF-DATE
            MOVE "20" TO CP-RC
            MOVE "EXPIRATION AFTER EFFECTIVE REQUIRED" TO CP-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    MOVE CP-EFF-DATE TO CT-EFF-DATE
    MOVE CP-EXP-DATE TO CT-EXP-DATE
    PERFORM SAVE-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM SHOW-COLLATERAL
    MOVE "DATES UPDATED" TO CP-MSG
    MOVE CP-COLL-ID TO WS-ENT
    MOVE "DATE" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    MOVE CP-EXP-DATE TO WS-AA
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

VALIDATE-NEW.
    MOVE CP-COLL-TYPE TO WS-ACT
    PERFORM CHECK-TYPE-KNOWN
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CP-CUST-ID = SPACES
        MOVE "20" TO CP-RC
        MOVE "CUSTOMER REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-OWNER-ID = SPACES
        MOVE "20" TO CP-RC
        MOVE "OWNER REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-OWNER-KIND
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-CURRENCY
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CP-GUARANTEE-MAX < 0
        MOVE "20" TO CP-RC
        MOVE "GUARANTEE MAX INVALID" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-GUARANTEE-FIELDS
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CP-EXP-DATE NOT = 0
        IF CP-EFF-DATE = 0
            MOVE "20" TO CP-RC
            MOVE "EFFECTIVE DATE REQUIRED" TO CP-MSG
        ELSE
            IF CP-EXP-DATE <= CP-EFF-DATE
                MOVE "20" TO CP-RC
                MOVE "EXPIRATION AFTER EFFECTIVE REQUIRED" TO CP-MSG
            END-IF
        END-IF
    END-IF.

CHECK-GUARANTEE-FIELDS.
    MOVE "N" TO WS-OK
    IF CP-COLL-TYPE = "GUARANTEE"
        OR CP-COLL-TYPE = "PERSONAL-GUARANTEE"
        OR CP-COLL-TYPE = "CORPORATE-GUARANTEE"
        MOVE "Y" TO WS-OK
    END-IF
    IF WS-OK = "Y"
        IF CP-GUARANTOR = SPACES
            MOVE "20" TO CP-RC
            MOVE "GUARANTOR REQUIRED" TO CP-MSG
            EXIT PARAGRAPH
        END-IF
        IF CP-GUARANTEE-MAX <= 0
            MOVE "20" TO CP-RC
            MOVE "GUARANTEE MAX REQUIRED" TO CP-MSG
        END-IF
    END-IF.

CHECK-TYPE-KNOWN.
    MOVE FUNCTION TRIM(CP-COLL-TYPE) TO WS-KEY
    MOVE WS-KEY TO CP-COLL-TYPE
    MOVE "N" TO WS-OK
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 12
        IF WS-KEY = T-NAME(WS-I)
            MOVE "Y" TO WS-OK
        END-IF
    END-PERFORM
    IF WS-OK = "N"
        MOVE "20" TO CP-RC
        MOVE "UNKNOWN COLLATERAL TYPE" TO CP-MSG
    END-IF.

CHECK-OWNER-KIND.
    MOVE FUNCTION TRIM(CP-OWNER-KIND) TO WS-KEY
    MOVE WS-KEY TO CP-OWNER-KIND
    MOVE "N" TO WS-OK
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 5
        IF WS-KEY = K-NAME(WS-I)
            MOVE "Y" TO WS-OK
        END-IF
    END-PERFORM
    IF WS-OK = "N"
        MOVE "20" TO CP-RC
        MOVE "UNKNOWN OWNER KIND" TO CP-MSG
    END-IF.

INIT-TABLES.
    MOVE "CASH" TO T-NAME(1)
    MOVE "DEPOSIT" TO T-NAME(2)
    MOVE "SECURITIES" TO T-NAME(3)
    MOVE "VEHICLE" TO T-NAME(4)
    MOVE "REAL-ESTATE" TO T-NAME(5)
    MOVE "EQUIPMENT" TO T-NAME(6)
    MOVE "RECEIVABLE" TO T-NAME(7)
    MOVE "INVENTORY" TO T-NAME(8)
    MOVE "GUARANTEE" TO T-NAME(9)
    MOVE "PERSONAL-GUARANTEE" TO T-NAME(10)
    MOVE "CORPORATE-GUARANTEE" TO T-NAME(11)
    MOVE "OTHER" TO T-NAME(12)
    MOVE "CUSTOMER" TO K-NAME(1)
    MOVE "CO-OWNER" TO K-NAME(2)
    MOVE "THIRD-PARTY" TO K-NAME(3)
    MOVE "CORPORATE" TO K-NAME(4)
    MOVE "INSTITUTION" TO K-NAME(5).

CHECK-CURRENCY.
    MOVE "N" TO WS-OK
    MOVE SPACES TO WS-CURR-FILE
    STRING FUNCTION TRIM(WS-HOME) "/etc/currencies.cfg"
        DELIMITED SIZE INTO WS-CURR-FILE
    OPEN INPUT CURR-FILE
    IF WS-CURR-ST = "00"
        MOVE "N" TO WS-EOF
        PERFORM UNTIL WS-EOF = "Y"
            READ CURR-FILE
                AT END MOVE "Y" TO WS-EOF
                NOT AT END
                    IF CURR-REC-LINE(1:3) = CP-CURRENCY
                        MOVE "Y" TO WS-OK
                    END-IF
            END-READ
        END-PERFORM
        CLOSE CURR-FILE
    ELSE
        IF CP-CURRENCY = WS-CURRENCY
            MOVE "Y" TO WS-OK
        END-IF
    END-IF
    IF WS-OK = "N"
        MOVE "20" TO CP-RC
        MOVE "UNSUPPORTED CURRENCY" TO CP-MSG
    END-IF.

CHECK-DUP-REF.
    IF CP-REG-REF = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-FOUND
    MOVE SPACES TO BK-CLT-LIST
    MOVE "COLL" TO QL-OP
    CALL "CLTQRY" USING BK-CLT-LIST
    IF QL-RC NOT = "00"
        MOVE QL-RC TO CP-RC
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QL-COUNT
        MOVE SPACES TO BK-CLT-COLL
        MOVE QL-ID(WS-I) TO CT-ID
        MOVE "GET" TO ST-OP
        CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
        IF ST-RC = "00"
            IF CT-REG-REF = CP-REG-REF
                MOVE "Y" TO WS-FOUND
            END-IF
        END-IF
    END-PERFORM
    IF WS-FOUND = "Y"
        MOVE "22" TO CP-RC
        MOVE "REGISTRATION REFERENCE DUPLICATE" TO CP-MSG
    END-IF.

RECOMPUTE-STATE.
    MOVE "RECOMPUTE" TO CP-OP
    CALL "CLTCAL" USING BK-CLT-PARMS.

LOAD-COLLATERAL.
    MOVE SPACES TO BK-CLT-COLL
    MOVE CP-COLL-ID TO CT-ID
    MOVE "GET" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "COLLATERAL NOT FOUND" TO CP-MSG
    END-IF.

SAVE-COLLATERAL.
    MOVE WS-BIZDATE TO CT-UPDATED
    ADD 1 TO CT-VERSION
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "COLLATERAL UPDATE FAILED" TO CP-MSG
    END-IF.

COMPUTE-HASH.
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(CT-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CT-STATUS) DELIMITED SIZE "|" DELIMITED SIZE
        CT-VERSION DELIMITED SIZE INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO CT-HASH.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CP-COLL-ID
    STRING "S" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CP-COLL-ID
    END-STRING.

LOAD-TYPE-POLICY.
    MOVE CP-COLL-TYPE TO CG-TYPE
    CALL "CLTCFG" USING BK-CLT-CFG
    MOVE CG-MULTI TO CT-MULTI
    MOVE CG-DOC-REQ TO CT-DOC-REQ.

SHOW-COLLATERAL.
    MOVE CT-ID TO CP-COLL-ID
    MOVE CT-TYPE TO CP-COLL-TYPE
    MOVE CT-STATUS TO CP-STATUS
    MOVE CT-CUST-ID TO CP-CUST-ID
    MOVE CT-OWNER-ID TO CP-OWNER-ID
    MOVE CT-OWNER-KIND TO CP-OWNER-KIND
    MOVE CT-CURRENCY TO CP-CURRENCY
    MOVE CT-VALUATION TO CP-VALUATION
    MOVE CT-VALUATION-ID TO CP-VALUATION-ID
    MOVE CT-ADJUSTED TO CP-ADJUSTED
    MOVE CT-ELIGIBLE TO CP-ELIGIBLE
    MOVE CT-ALLOCATED TO CP-ALLOCATED
    MOVE CT-AVAILABLE TO CP-AVAILABLE
    MOVE CT-GUARANTEE-MAX TO CP-GUARANTEE-MAX
    MOVE CT-REG-REF TO CP-REG-REF
    MOVE CT-EXTERNAL-REF TO CP-EXTERNAL-REF
    MOVE CT-EFF-DATE TO CP-EFF-DATE
    MOVE CT-EXP-DATE TO CP-EXP-DATE
    MOVE CT-DOC-REQ TO CP-DOC-REQ
    MOVE CT-DOC-STATE TO CP-DOC-STATE
    MOVE CT-REVIEW-FLAG TO CP-REVIEW
    MOVE CT-MULTI TO CP-MULTI.
