IDENTIFICATION DIVISION.
PROGRAM-ID. CLTRELEA.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-ENT PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-AB PIC X(120).
01 WS-AA PIC X(120).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTSTO".
COPY "CLTGDP".
01 WS-HOME PIC X(80).
01 WS-LOCKED PIC X(01).
01 WS-PREV PIC X(16).
01 BK-CLT-COLL.
   COPY "CLTC".
01 BK-CLT-ALLOC.
   COPY "CLTA".

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    MOVE "N" TO WS-LOCKED
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    IF CP-OP NOT = "RELEASE"
        MOVE "99" TO CP-RC
        MOVE "UNKNOWN ALLOCATION OP" TO CP-MSG
        GOBACK
    END-IF
    PERFORM LOAD-ALLOCATION
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE AA-COLL-ID TO CP-COLL-ID
    PERFORM GUARD-LOCK
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM GUARD-BEGIN
    IF CP-RC = "00" AND CP-REPLAY = "Y"
        PERFORM GUARD-UNLOCK
        GOBACK
    END-IF
    IF CP-RC NOT = "00"
        PERFORM GUARD-END
        PERFORM GUARD-UNLOCK
        GOBACK
    END-IF
    PERFORM DO-RELEASE
    PERFORM GUARD-END
    PERFORM GUARD-UNLOCK
    GOBACK.

DO-RELEASE.
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM LOAD-ALLOCATION
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF AA-STATUS NOT = "ACTIVE"
        MOVE "20" TO CP-RC
        MOVE "ALLOCATION NOT ACTIVE" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "RELEASED" TO AA-STATUS
    MOVE WS-BIZDATE TO AA-RELEASE-DATE
    MOVE CP-REASON TO AA-REASON
    ADD 1 TO AA-VERSION
    MOVE WS-BIZDATE TO AA-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "ALLOCATION UPDATE FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM RECOMPUTE
    MOVE "RELEASED" TO CP-STATUS
    MOVE "ALLOCATION RELEASED" TO CP-MSG
    MOVE CP-ALLOCATION-ID TO WS-ENT
    MOVE "RLSE" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

GUARD-LOCK.
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "LOCK" TO GD-OP
    MOVE CP-COLL-ID TO GD-LOCK-ID
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "COLLATERAL BUSY" TO CP-MSG
    ELSE
        MOVE "Y" TO WS-LOCKED
    END-IF.

GUARD-UNLOCK.
    IF WS-LOCKED = "Y"
        MOVE SPACES TO BK-CLT-GUARD
        MOVE "UNLOCK" TO GD-OP
        MOVE CP-COLL-ID TO GD-LOCK-ID
        MOVE CP-OPERATOR TO GD-OPERATOR
        CALL "CLTGUARD" USING BK-CLT-GUARD
    END-IF.

GUARD-BEGIN.
    MOVE "N" TO CP-REPLAY
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "BEGIN" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CLTRELEASE" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "REQUEST IN PROGRESS" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF GD-HIT = "Y"
        MOVE GD-RESULT(1:12) TO CP-ALLOCATION-ID
        MOVE "Y" TO CP-REPLAY
        MOVE "RELEASE REPLAY" TO CP-MSG
    END-IF.

GUARD-END.
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "END" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CLTRELEASE" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    MOVE CP-RC TO GD-RC
    IF CP-RC = "00"
        MOVE CP-ALLOCATION-ID TO GD-RESULT
    ELSE
        MOVE CP-MSG TO GD-RESULT
    END-IF
    CALL "CLTGUARD" USING BK-CLT-GUARD.

LOAD-COLLATERAL.
    MOVE SPACES TO BK-CLT-COLL
    MOVE CP-COLL-ID TO CT-ID
    MOVE "GET" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "COLLATERAL NOT FOUND" TO CP-MSG
    END-IF.

LOAD-ALLOCATION.
    MOVE SPACES TO BK-CLT-ALLOC
    MOVE CP-ALLOCATION-ID TO AA-ID
    MOVE "GET" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "ALLOCATION NOT FOUND" TO CP-MSG
    END-IF.

RECOMPUTE.
    MOVE CP-OP TO WS-PREV
    MOVE "RECOMPUTE" TO CP-OP
    CALL "CLTCAL" USING BK-CLT-PARMS
    MOVE WS-PREV TO CP-OP.
