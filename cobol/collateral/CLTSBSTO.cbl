IDENTIFICATION DIVISION.
PROGRAM-ID. CLTSBSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT SUB-FILE ASSIGN TO WS-SUB-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS SU-ID
        FILE STATUS IS WS-SUB-ST.

DATA DIVISION.
FILE SECTION.
FD SUB-FILE.
01 SUB-REC.
   COPY "CLTSB".

WORKING-STORAGE SECTION.
01 WS-SUB-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-SUB-ST PIC X(02).

LINKAGE SECTION.
COPY "CLTSTO".
01 BK-CLT-SUBST.
   COPY "CLTSB".

PROCEDURE DIVISION USING BK-CLT-STO-REQ BK-CLT-SUBST.
    MOVE "00" TO ST-RC
    MOVE SPACES TO ST-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-SUB-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltsub.idx"
        DELIMITED SIZE INTO WS-SUB-PATH
    PERFORM OPEN-STORE
    IF ST-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE ST-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO ST-RC
            MOVE "UNKNOWN SUBSTITUTION STORE OP" TO ST-MSG
    END-EVALUATE
    CLOSE SUB-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O SUB-FILE
    IF WS-SUB-ST = "35"
        OPEN OUTPUT SUB-FILE
        CLOSE SUB-FILE
        OPEN I-O SUB-FILE
    END-IF
    IF WS-SUB-ST NOT = "00"
        MOVE WS-SUB-ST TO ST-RC
        MOVE "CANNOT OPEN SUBSTITUTION INDEX" TO ST-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CLT-SUBST TO SUB-REC
    WRITE SUB-REC
        INVALID KEY
            MOVE "22" TO ST-RC
            MOVE "SUBSTITUTION ALREADY EXISTS" TO ST-MSG
    END-WRITE.

DO-REWRITE.
    MOVE SU-ID OF BK-CLT-SUBST TO SU-ID OF SUB-REC
    READ SUB-FILE
    IF WS-SUB-ST = "00"
        MOVE BK-CLT-SUBST TO SUB-REC
        REWRITE SUB-REC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "SUBSTITUTION NOT FOUND" TO ST-MSG
    END-IF.

DO-GET.
    MOVE SU-ID OF BK-CLT-SUBST TO SU-ID OF SUB-REC
    READ SUB-FILE
    IF WS-SUB-ST = "00"
        MOVE SUB-REC TO BK-CLT-SUBST
        MOVE "00" TO ST-RC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "SUBSTITUTION NOT FOUND" TO ST-MSG
    END-IF.
