IDENTIFICATION DIVISION.
PROGRAM-ID. CLTVSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT VAL-FILE ASSIGN TO WS-VAL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS VA-ID
        FILE STATUS IS WS-VAL-ST.

DATA DIVISION.
FILE SECTION.
FD VAL-FILE.
01 VAL-REC.
   COPY "CLTV".

WORKING-STORAGE SECTION.
01 WS-VAL-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-VAL-ST PIC X(02).

LINKAGE SECTION.
COPY "CLTSTO".
01 BK-CLT-VAL.
   COPY "CLTV".

PROCEDURE DIVISION USING BK-CLT-STO-REQ BK-CLT-VAL.
    MOVE "00" TO ST-RC
    MOVE SPACES TO ST-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-VAL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltval.idx"
        DELIMITED SIZE INTO WS-VAL-PATH
    PERFORM OPEN-STORE
    IF ST-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE ST-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO ST-RC
            MOVE "UNKNOWN VALUATION STORE OP" TO ST-MSG
    END-EVALUATE
    CLOSE VAL-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O VAL-FILE
    IF WS-VAL-ST = "35"
        OPEN OUTPUT VAL-FILE
        CLOSE VAL-FILE
        OPEN I-O VAL-FILE
    END-IF
    IF WS-VAL-ST NOT = "00"
        MOVE WS-VAL-ST TO ST-RC
        MOVE "CANNOT OPEN VALUATION INDEX" TO ST-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CLT-VAL TO VAL-REC
    WRITE VAL-REC
        INVALID KEY
            MOVE "22" TO ST-RC
            MOVE "VALUATION ALREADY EXISTS" TO ST-MSG
    END-WRITE.

DO-REWRITE.
    MOVE VA-ID OF BK-CLT-VAL TO VA-ID OF VAL-REC
    READ VAL-FILE
    IF WS-VAL-ST = "00"
        MOVE BK-CLT-VAL TO VAL-REC
        REWRITE VAL-REC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "VALUATION NOT FOUND" TO ST-MSG
    END-IF.

DO-GET.
    MOVE VA-ID OF BK-CLT-VAL TO VA-ID OF VAL-REC
    READ VAL-FILE
    IF WS-VAL-ST = "00"
        MOVE VAL-REC TO BK-CLT-VAL
        MOVE "00" TO ST-RC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "VALUATION NOT FOUND" TO ST-MSG
    END-IF.
