IDENTIFICATION DIVISION.
PROGRAM-ID. CLTDSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT DISP-FILE ASSIGN TO WS-DISP-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS DP-ID
        FILE STATUS IS WS-DISP-ST.

DATA DIVISION.
FILE SECTION.
FD DISP-FILE.
01 DISP-REC.
   COPY "CLTDS".

WORKING-STORAGE SECTION.
01 WS-DISP-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-DISP-ST PIC X(02).

LINKAGE SECTION.
COPY "CLTSTO".
01 BK-CLT-DISP.
   COPY "CLTDS".

PROCEDURE DIVISION USING BK-CLT-STO-REQ BK-CLT-DISP.
    MOVE "00" TO ST-RC
    MOVE SPACES TO ST-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-DISP-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltdisp.idx"
        DELIMITED SIZE INTO WS-DISP-PATH
    PERFORM OPEN-STORE
    IF ST-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE ST-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO ST-RC
            MOVE "UNKNOWN DISPOSITION STORE OP" TO ST-MSG
    END-EVALUATE
    CLOSE DISP-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O DISP-FILE
    IF WS-DISP-ST = "35"
        OPEN OUTPUT DISP-FILE
        CLOSE DISP-FILE
        OPEN I-O DISP-FILE
    END-IF
    IF WS-DISP-ST NOT = "00"
        MOVE WS-DISP-ST TO ST-RC
        MOVE "CANNOT OPEN DISPOSITION INDEX" TO ST-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CLT-DISP TO DISP-REC
    WRITE DISP-REC
        INVALID KEY
            MOVE "22" TO ST-RC
            MOVE "DISPOSITION ALREADY EXISTS" TO ST-MSG
    END-WRITE.

DO-REWRITE.
    MOVE DP-ID OF BK-CLT-DISP TO DP-ID OF DISP-REC
    READ DISP-FILE
    IF WS-DISP-ST = "00"
        MOVE BK-CLT-DISP TO DISP-REC
        REWRITE DISP-REC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "DISPOSITION NOT FOUND" TO ST-MSG
    END-IF.

DO-GET.
    MOVE DP-ID OF BK-CLT-DISP TO DP-ID OF DISP-REC
    READ DISP-FILE
    IF WS-DISP-ST = "00"
        MOVE DISP-REC TO BK-CLT-DISP
        MOVE "00" TO ST-RC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "DISPOSITION NOT FOUND" TO ST-MSG
    END-IF.
