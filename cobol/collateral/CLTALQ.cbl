IDENTIFICATION DIVISION.
PROGRAM-ID. CLTALQ.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ALOC-FILE ASSIGN TO WS-A-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS AA-ID
        FILE STATUS IS WS-A-ST.
    SELECT SUB-FILE ASSIGN TO WS-S-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS SU-ID
        FILE STATUS IS WS-S-ST.
    SELECT ENF-FILE ASSIGN TO WS-E-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS EF-ID
        FILE STATUS IS WS-E-ST.
    SELECT DISP-FILE ASSIGN TO WS-X-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS DP-ID
        FILE STATUS IS WS-X-ST.

DATA DIVISION.
FILE SECTION.
FD ALOC-FILE.
01 ALOC-REC.
   COPY "CLTA".
FD SUB-FILE.
01 SUB-REC.
   COPY "CLTSB".
FD ENF-FILE.
01 ENF-REC.
   COPY "CLTEN".
FD DISP-FILE.
01 DISP-REC.
   COPY "CLTDS".

WORKING-STORAGE SECTION.
01 WS-A-PATH PIC X(200).
01 WS-S-PATH PIC X(200).
01 WS-E-PATH PIC X(200).
01 WS-X-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-A-ST PIC X(02).
01 WS-S-ST PIC X(02).
01 WS-E-ST PIC X(02).
01 WS-X-ST PIC X(02).
01 WS-EOF PIC X(01).

LINKAGE SECTION.
COPY "CLTQL".

PROCEDURE DIVISION USING BK-CLT-LIST.
    MOVE "00" TO QL-RC
    MOVE SPACES TO QL-MSG
    MOVE 0 TO QL-COUNT
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    PERFORM BUILD-PATHS
    EVALUATE QL-OP
        WHEN "ALLOC" PERFORM SCAN-ALLOC-BY-COLL
        WHEN "ALLOCX" PERFORM SCAN-ALLOC-BY-OBL
        WHEN "SUBS" PERFORM SCAN-SUBSTS
        WHEN "ENFS" PERFORM SCAN-ENFS
        WHEN "DISPS" PERFORM SCAN-DISPS
        WHEN OTHER
            MOVE "99" TO QL-RC
            MOVE "UNKNOWN COLLATERAL LIST OP" TO QL-MSG
    END-EVALUATE
    GOBACK.

BUILD-PATHS.
    MOVE SPACES TO WS-A-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltalloc.idx"
        DELIMITED SIZE INTO WS-A-PATH
    MOVE SPACES TO WS-S-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltsub.idx"
        DELIMITED SIZE INTO WS-S-PATH
    MOVE SPACES TO WS-E-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltenf.idx"
        DELIMITED SIZE INTO WS-E-PATH
    MOVE SPACES TO WS-X-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltdisp.idx"
        DELIMITED SIZE INTO WS-X-PATH.

SCAN-ALLOC-BY-COLL.
    OPEN INPUT ALOC-FILE
    IF WS-A-ST NOT = "00"
        CLOSE ALOC-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ ALOC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF AA-COLL-ID OF ALOC-REC = QL-FILTER
                    PERFORM TAKE-ALLOC
                END-IF
        END-READ
    END-PERFORM
    CLOSE ALOC-FILE.

SCAN-ALLOC-BY-OBL.
    OPEN INPUT ALOC-FILE
    IF WS-A-ST NOT = "00"
        CLOSE ALOC-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ ALOC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF AA-OBL-ID OF ALOC-REC = QL-OBL-ID
                    AND AA-STATUS OF ALOC-REC = "ACTIVE"
                    PERFORM TAKE-ALLOC
                END-IF
        END-READ
    END-PERFORM
    CLOSE ALOC-FILE.

TAKE-ALLOC.
    PERFORM ADD-ROW
    IF QL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE AA-ID OF ALOC-REC TO QL-ID(QL-COUNT)
    MOVE AA-COLL-ID OF ALOC-REC TO QL-COLL(QL-COUNT)
    MOVE AA-STATUS OF ALOC-REC TO QL-STATUS(QL-COUNT)
    MOVE AA-AMOUNT OF ALOC-REC TO QL-AMOUNT(QL-COUNT)
    MOVE AA-CURRENCY OF ALOC-REC TO QL-CURRENCY(QL-COUNT)
    MOVE AA-ALLOC-DATE OF ALOC-REC TO QL-DATE(QL-COUNT)
    MOVE AA-OBL-ID OF ALOC-REC TO QL-TEXT(QL-COUNT).

SCAN-SUBSTS.
    OPEN INPUT SUB-FILE
    IF WS-S-ST NOT = "00"
        CLOSE SUB-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ SUB-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF SU-SRC-COLL OF SUB-REC = QL-FILTER
                    OR SU-DST-COLL OF SUB-REC = QL-FILTER
                    PERFORM TAKE-SUBST
                END-IF
        END-READ
    END-PERFORM
    CLOSE SUB-FILE.

TAKE-SUBST.
    PERFORM ADD-ROW
    IF QL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SU-ID OF SUB-REC TO QL-ID(QL-COUNT)
    MOVE SU-DST-COLL OF SUB-REC TO QL-COLL(QL-COUNT)
    MOVE SU-STATUS OF SUB-REC TO QL-STATUS(QL-COUNT)
    MOVE SU-AMOUNT OF SUB-REC TO QL-AMOUNT(QL-COUNT)
    MOVE SU-CURRENCY OF SUB-REC TO QL-CURRENCY(QL-COUNT)
    MOVE SU-EFF-DATE OF SUB-REC TO QL-DATE(QL-COUNT)
    MOVE SU-OBL-ID OF SUB-REC TO QL-TEXT(QL-COUNT).

SCAN-ENFS.
    OPEN INPUT ENF-FILE
    IF WS-E-ST NOT = "00"
        CLOSE ENF-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ ENF-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF EF-COLL-ID OF ENF-REC = QL-FILTER
                    OR EF-CASE-ID OF ENF-REC = QL-CASE
                    OR EF-OBL-ID OF ENF-REC = QL-OBL-ID
                    PERFORM TAKE-ENF
                END-IF
        END-READ
    END-PERFORM
    CLOSE ENF-FILE.

TAKE-ENF.
    PERFORM ADD-ROW
    IF QL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE EF-ID OF ENF-REC TO QL-ID(QL-COUNT)
    MOVE EF-COLL-ID OF ENF-REC TO QL-COLL(QL-COUNT)
    MOVE EF-STATUS OF ENF-REC TO QL-STATUS(QL-COUNT)
    MOVE EF-AMOUNT OF ENF-REC TO QL-AMOUNT(QL-COUNT)
    MOVE EF-CURRENCY OF ENF-REC TO QL-CURRENCY(QL-COUNT)
    MOVE EF-DATE OF ENF-REC TO QL-DATE(QL-COUNT)
    MOVE EF-CASE-ID OF ENF-REC TO QL-TEXT(QL-COUNT).

SCAN-DISPS.
    OPEN INPUT DISP-FILE
    IF WS-X-ST NOT = "00"
        CLOSE DISP-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ DISP-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF DP-COLL-ID OF DISP-REC = QL-FILTER
                    OR DP-ENFORCE-ID OF DISP-REC = QL-CASE
                    PERFORM TAKE-DISP
                END-IF
        END-READ
    END-PERFORM
    CLOSE DISP-FILE.

TAKE-DISP.
    PERFORM ADD-ROW
    IF QL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE DP-ID OF DISP-REC TO QL-ID(QL-COUNT)
    MOVE DP-COLL-ID OF DISP-REC TO QL-COLL(QL-COUNT)
    MOVE DP-STATUS OF DISP-REC TO QL-STATUS(QL-COUNT)
    MOVE DP-PROCEEDS OF DISP-REC TO QL-AMOUNT(QL-COUNT)
    MOVE DP-APPLIED OF DISP-REC TO QL-AMT2(QL-COUNT)
    MOVE DP-CURRENCY OF DISP-REC TO QL-CURRENCY(QL-COUNT)
    MOVE DP-DATE OF DISP-REC TO QL-DATE(QL-COUNT)
    MOVE DP-ENFORCE-ID OF DISP-REC TO QL-TEXT(QL-COUNT).

ADD-ROW.
    IF QL-COUNT >= 300
        MOVE "37" TO QL-RC
        MOVE "COLLATERAL LIST LIMIT EXCEEDED" TO QL-MSG
        MOVE "Y" TO WS-EOF
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO QL-COUNT.
