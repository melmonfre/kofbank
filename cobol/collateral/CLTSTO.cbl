IDENTIFICATION DIVISION.
PROGRAM-ID. CLTSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT COLL-FILE ASSIGN TO WS-COLL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CT-ID
        FILE STATUS IS WS-COLL-ST.

DATA DIVISION.
FILE SECTION.
FD COLL-FILE.
01 COLL-REC.
   COPY "CLTC".

WORKING-STORAGE SECTION.
01 WS-COLL-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-COLL-ST PIC X(02).

LINKAGE SECTION.
COPY "CLTSTO".
01 BK-CLT-COLL.
   COPY "CLTC".

PROCEDURE DIVISION USING BK-CLT-STO-REQ BK-CLT-COLL.
    MOVE "00" TO ST-RC
    MOVE SPACES TO ST-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-COLL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltcoll.idx"
        DELIMITED SIZE INTO WS-COLL-PATH
    PERFORM OPEN-STORE
    IF ST-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE ST-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO ST-RC
            MOVE "UNKNOWN COLLATERAL STORE OP" TO ST-MSG
    END-EVALUATE
    CLOSE COLL-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O COLL-FILE
    IF WS-COLL-ST = "35"
        OPEN OUTPUT COLL-FILE
        CLOSE COLL-FILE
        OPEN I-O COLL-FILE
    END-IF
    IF WS-COLL-ST NOT = "00"
        MOVE WS-COLL-ST TO ST-RC
        MOVE "CANNOT OPEN COLLATERAL INDEX" TO ST-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CLT-COLL TO COLL-REC
    WRITE COLL-REC
        INVALID KEY
            MOVE "22" TO ST-RC
            MOVE "COLLATERAL ALREADY EXISTS" TO ST-MSG
    END-WRITE.

DO-REWRITE.
    MOVE CT-ID OF BK-CLT-COLL TO CT-ID OF COLL-REC
    READ COLL-FILE
    IF WS-COLL-ST = "00"
        MOVE BK-CLT-COLL TO COLL-REC
        REWRITE COLL-REC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "COLLATERAL NOT FOUND" TO ST-MSG
    END-IF.

DO-GET.
    MOVE CT-ID OF BK-CLT-COLL TO CT-ID OF COLL-REC
    READ COLL-FILE
    IF WS-COLL-ST = "00"
        MOVE COLL-REC TO BK-CLT-COLL
        MOVE "00" TO ST-RC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "COLLATERAL NOT FOUND" TO ST-MSG
    END-IF.
