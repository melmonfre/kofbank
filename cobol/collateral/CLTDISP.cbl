IDENTIFICATION DIVISION.
PROGRAM-ID. CLTDISP.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-ENT PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-AB PIC X(120).
01 WS-AA PIC X(120).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTSTO".
COPY "CLTGDP".
COPY "CLTQL".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CLTDISPOS".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-ACT PIC X(16).
01 WS-PREV PIC X(16).
01 WS-OPSAVE PIC X(16).
01 WS-I PIC 9(05).
01 WS-LOCKED PIC X(01).
01 WS-GDNAME PIC X(12).
01 WS-TQ-OP PIC X(08).
01 WS-TQ-ID PIC X(12).
01 WS-TQ-RC PIC X(02).
01 BK-CLT-COLL.
   COPY "CLTC".
01 BK-CLT-ALLOC.
   COPY "CLTA".
01 BK-CLT-ENF.
   COPY "CLTEN".
01 BK-CLT-DISP.
   COPY "CLTDS".
01 WS-TXN-REC.
   COPY "BTXREC".

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    MOVE "N" TO WS-LOCKED
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    EVALUATE CP-OP
        WHEN "DISPOSE" PERFORM DO-DISPOSE
        WHEN "DISP-SETTLE" PERFORM DO-SETTLE
        WHEN "DISP-CANCEL" PERFORM DO-CANCEL
        WHEN "DISP-GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN DISPOSITION OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

DO-DISPOSE.
    PERFORM LOAD-ENFORCEMENT
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    IF EF-STATUS NOT = "ENFORCED"
        MOVE "20" TO CP-RC
        MOVE "ENFORCEMENT NOT ENFORCED" TO CP-MSG
        GOBACK
    END-IF
    MOVE EF-COLL-ID TO CP-COLL-ID
    PERFORM LOCK-COLLATERAL
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM GUARD-BEGIN
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    IF CP-REPLAY = "Y"
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    PERFORM LOAD-ENFORCEMENT
    PERFORM CHECK-OPEN-DISP
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    MOVE "REC-START" TO WS-ACT
    CALL "CLTST" USING CT-STATUS WS-ACT WS-PREV
        CP-RC CP-MSG
    IF CP-RC NOT = "00"
        MOVE "20" TO CP-RC
        MOVE "COLLATERAL NOT DISPOSEABLE" TO CP-MSG
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    PERFORM BUILD-ID
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    PERFORM STORE-DISPOSITION
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    MOVE WS-PREV TO CT-STATUS
    ADD 1 TO CT-VERSION
    MOVE WS-BIZDATE TO CT-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    PERFORM GUARD-END
    MOVE "DISPOSITION PENDING" TO CP-MSG
    PERFORM EMIT-DISP
    PERFORM UNLOCK-COLLATERAL
    GOBACK.

CHECK-OPEN-DISP.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "DISPS" TO QL-OP
    MOVE CP-ENFORCE-ID TO QL-CASE
    CALL "CLTALQ" USING BK-CLT-LIST
    IF QL-RC NOT = "00"
        MOVE QL-RC TO CP-RC
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QL-COUNT
        IF QL-STATUS(WS-I) = "PENDING"
            MOVE "22" TO CP-RC
            MOVE "DISPOSITION ALREADY OPEN" TO CP-MSG
        END-IF
    END-PERFORM.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CP-DISPOSITION-ID
    STRING "D" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CP-DISPOSITION-ID
    END-STRING.

STORE-DISPOSITION.
    MOVE SPACES TO BK-CLT-DISP
    MOVE CP-DISPOSITION-ID TO DP-ID
    MOVE CP-ENFORCE-ID TO DP-ENFORCE-ID
    MOVE EF-COLL-ID TO DP-COLL-ID
    MOVE EF-OBL-TYPE TO DP-OBL-TYPE
    MOVE EF-OBL-ID TO DP-OBL-ID
    MOVE "PENDING" TO DP-STATUS
    MOVE CP-AMOUNT TO DP-VALUE
    IF CP-AMOUNT <= 0
        MOVE EF-AMOUNT TO DP-VALUE
    END-IF
    MOVE 0 TO DP-PROCEEDS
    MOVE 0 TO DP-APPLIED
    MOVE 0 TO DP-SURPLUS
    MOVE 0 TO DP-SHORTFALL
    MOVE CT-CURRENCY TO DP-CURRENCY
    MOVE WS-BIZDATE TO DP-DATE
    MOVE CP-REASON TO DP-REASON
    MOVE CP-OPERATOR TO DP-OPERATOR
    MOVE WS-BIZDATE TO DP-CREATED
    MOVE WS-BIZDATE TO DP-UPDATED
    MOVE 1 TO DP-VERSION
    MOVE "WRITE" TO ST-OP
    CALL "CLTDSTO" USING BK-CLT-STO-REQ BK-CLT-DISP
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "DISPOSITION WRITE FAILED" TO CP-MSG
    END-IF.

DO-SETTLE.
    PERFORM LOAD-DISPOSITION
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    IF DP-STATUS = "SETTLED"
        MOVE "DISPOSITION ALREADY SETTLED" TO CP-MSG
        MOVE DP-STATUS TO CP-STATUS
        GOBACK
    END-IF
    IF DP-STATUS NOT = "PENDING"
        MOVE "20" TO CP-RC
        MOVE "DISPOSITION NOT PENDING" TO CP-MSG
        GOBACK
    END-IF
    PERFORM VERIFY-TXN
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE DP-COLL-ID TO CP-COLL-ID
    PERFORM LOCK-COLLATERAL
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-DISPOSITION
    IF DP-STATUS NOT = "PENDING"
        MOVE "20" TO CP-RC
        MOVE "DISPOSITION NOT PENDING" TO CP-MSG
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    PERFORM APPLY-SETTLE
    PERFORM UNLOCK-COLLATERAL
    GOBACK.

VERIFY-TXN.
    IF CP-TXN-ID = SPACES
        MOVE "20" TO CP-RC
        MOVE "SETTLEMENT TXN REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "GET" TO WS-TQ-OP
    MOVE CP-TXN-ID TO WS-TQ-ID
    MOVE SPACES TO WS-TXN-REC
    CALL "BTXNQRY" USING WS-TQ-OP WS-TQ-ID WS-TXN-REC
        WS-TQ-RC
    IF WS-TQ-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "SETTLEMENT TXN NOT FOUND" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF TXN-STATUS OF WS-TXN-REC NOT = "ST"
        AND TXN-STATUS OF WS-TXN-REC NOT = "CP"
        MOVE "20" TO CP-RC
        MOVE "SETTLEMENT TXN NOT SETTLED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF TXN-CURRENCY OF WS-TXN-REC NOT = DP-CURRENCY
        MOVE "20" TO CP-RC
        MOVE "CURRENCY MISMATCH: FX UNRESOLVED" TO CP-MSG
    END-IF.

APPLY-SETTLE.
    MOVE TXN-AMOUNT OF WS-TXN-REC TO DP-PROCEEDS
    MOVE DP-PROCEEDS TO DP-APPLIED
    IF DP-APPLIED > DP-VALUE
        MOVE DP-VALUE TO DP-APPLIED
    END-IF
    COMPUTE DP-SURPLUS = DP-PROCEEDS - DP-APPLIED
    COMPUTE DP-SHORTFALL = DP-VALUE - DP-APPLIED
    MOVE "SETTLED" TO DP-STATUS
    MOVE WS-BIZDATE TO DP-SETTLE-DATE
    MOVE CP-TXN-ID TO DP-TXN-ID
    MOVE TXN-REF OF WS-TXN-REC TO DP-REFERENCE
    ADD 1 TO DP-VERSION
    MOVE WS-BIZDATE TO DP-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTDSTO" USING BK-CLT-STO-REQ BK-CLT-DISP
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "DISPOSITION UPDATE FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM LOAD-ENFORCEMENT
    MOVE "RECOVERED" TO EF-STATUS
    MOVE CP-TXN-ID TO EF-RECOVERY-REF
    ADD 1 TO EF-VERSION
    MOVE WS-BIZDATE TO EF-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTENFST" USING BK-CLT-STO-REQ BK-CLT-ENF
    PERFORM RELEASE-ALLOCATION
    PERFORM COMPLETE-COLLATERAL
    MOVE "SETTLED" TO CP-STATUS
    MOVE DP-APPLIED TO CP-APPLIED
    MOVE DP-SURPLUS TO CP-SURPLUS
    MOVE DP-SHORTFALL TO CP-SHORTFALL
    MOVE "DISPOSITION SETTLED" TO CP-MSG
    MOVE CP-DISPOSITION-ID TO WS-ENT
    MOVE "DSEND" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

RELEASE-ALLOCATION.
    IF DP-OBL-ID = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-CLT-LIST
    MOVE "ALLOCX" TO QL-OP
    MOVE DP-OBL-TYPE TO QL-OBL-TYPE
    MOVE DP-OBL-ID TO QL-OBL-ID
    CALL "CLTALQ" USING BK-CLT-LIST
    IF QL-RC NOT = "00"
        MOVE QL-RC TO CP-RC
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QL-COUNT
        IF QL-STATUS(WS-I) = "ACTIVE"
            MOVE QL-ID(WS-I) TO AA-ID
            MOVE "GET" TO ST-OP
            CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
            IF ST-RC = "00"
                IF AA-COLL-ID = DP-COLL-ID
                    MOVE "RELEASED" TO AA-STATUS
                    MOVE WS-BIZDATE TO AA-RELEASE-DATE
                    MOVE "COLLATERAL REALIZATION" TO AA-REASON
                    ADD 1 TO AA-VERSION
                    MOVE WS-BIZDATE TO AA-UPDATED
                    MOVE "REWRITE" TO ST-OP
                    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
                END-IF
            END-IF
        END-IF
    END-PERFORM.

COMPLETE-COLLATERAL.
    MOVE DP-COLL-ID TO CP-COLL-ID
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "REC-DONE" TO WS-ACT
    CALL "CLTST" USING CT-STATUS WS-ACT WS-PREV
        CP-RC CP-MSG
    IF CP-RC NOT = "00"
        MOVE "20" TO CP-RC
        MOVE "COLLATERAL STATE CHANGED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-PREV TO CT-STATUS
    MOVE 0 TO CT-ALLOCATED
    MOVE 0 TO CT-AVAILABLE
    ADD 1 TO CT-VERSION
    MOVE WS-BIZDATE TO CT-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL.

DO-CANCEL.
    PERFORM LOAD-DISPOSITION
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    IF DP-STATUS = "CANCELLED"
        MOVE "DISPOSITION ALREADY CANCELLED" TO CP-MSG
        MOVE DP-STATUS TO CP-STATUS
        GOBACK
    END-IF
    IF DP-STATUS NOT = "PENDING"
        MOVE "20" TO CP-RC
        MOVE "DISPOSITION NOT PENDING" TO CP-MSG
        GOBACK
    END-IF
    MOVE DP-COLL-ID TO CP-COLL-ID
    PERFORM LOCK-COLLATERAL
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-DISPOSITION
    IF DP-STATUS NOT = "PENDING"
        MOVE "20" TO CP-RC
        MOVE "DISPOSITION NOT PENDING" TO CP-MSG
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    MOVE "CANCELLED" TO DP-STATUS
    MOVE CP-REASON TO DP-REASON
    ADD 1 TO DP-VERSION
    MOVE WS-BIZDATE TO DP-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTDSTO" USING BK-CLT-STO-REQ BK-CLT-DISP
    PERFORM LOAD-COLLATERAL
    IF CP-RC = "00"
        MOVE "REC-NO" TO WS-ACT
    CALL "CLTST" USING CT-STATUS WS-ACT WS-PREV
            CP-RC CP-MSG
        IF CP-RC = "00"
            MOVE WS-PREV TO CT-STATUS
            ADD 1 TO CT-VERSION
            MOVE WS-BIZDATE TO CT-UPDATED
            MOVE "REWRITE" TO ST-OP
            CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
        END-IF
    END-IF
    MOVE "CANCELLED" TO CP-STATUS
    MOVE "DISPOSITION CANCELLED" TO CP-MSG
    PERFORM EMIT-DSCXL
    PERFORM UNLOCK-COLLATERAL
    GOBACK.

DO-GET.
    PERFORM LOAD-DISPOSITION
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE DP-ID TO CP-DISPOSITION-ID
    MOVE DP-ENFORCE-ID TO CP-ENFORCE-ID
    MOVE DP-COLL-ID TO CP-COLL-ID
    MOVE DP-OBL-TYPE TO CP-OBL-TYPE
    MOVE DP-OBL-ID TO CP-OBL-ID
    MOVE DP-STATUS TO CP-STATUS
    MOVE DP-VALUE TO CP-AMOUNT
    MOVE DP-PROCEEDS TO CP-VALUATION
    MOVE DP-APPLIED TO CP-APPLIED
    MOVE DP-SURPLUS TO CP-SURPLUS
    MOVE DP-SHORTFALL TO CP-SHORTFALL
    MOVE DP-CURRENCY TO CP-CURRENCY
    MOVE DP-DATE TO CP-DATE
    MOVE DP-SETTLE-DATE TO CP-RELEASE-DATE
    MOVE DP-TXN-ID TO CP-TXN-ID
    MOVE DP-REFERENCE TO CP-EXTERNAL-REF.

LOCK-COLLATERAL.
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "LOCK" TO GD-OP
    MOVE CP-COLL-ID TO GD-LOCK-ID
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "COLLATERAL BUSY" TO CP-MSG
    ELSE
        MOVE "Y" TO WS-LOCKED
    END-IF.

UNLOCK-COLLATERAL.
    IF WS-LOCKED = "Y"
        MOVE SPACES TO BK-CLT-GUARD
        MOVE "UNLOCK" TO GD-OP
        MOVE CP-COLL-ID TO GD-LOCK-ID
        MOVE CP-OPERATOR TO GD-OPERATOR
        CALL "CLTGUARD" USING BK-CLT-GUARD
        MOVE "N" TO WS-LOCKED
    END-IF.

GUARD-BEGIN.
    MOVE "N" TO CP-REPLAY
    IF CP-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "BEGIN" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    PERFORM SET-GD-NAME
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "REQUEST IN PROGRESS" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF GD-HIT = "Y"
        MOVE GD-RESULT(1:12) TO CP-DISPOSITION-ID
        MOVE "Y" TO CP-REPLAY
        MOVE "DISPOSITION REPLAY" TO CP-MSG
    END-IF.

GUARD-END.
    IF CP-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "END" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    PERFORM SET-GD-NAME
    MOVE CP-OPERATOR TO GD-OPERATOR
    MOVE CP-RC TO GD-RC
    IF CP-RC = "00"
        MOVE CP-DISPOSITION-ID TO GD-RESULT
    ELSE
        MOVE CP-MSG TO GD-RESULT
    END-IF
    CALL "CLTGUARD" USING BK-CLT-GUARD.

SET-GD-NAME.
    MOVE SPACES TO WS-GDNAME
    EVALUATE CP-OP
        WHEN "DISPOSE" MOVE "CLTDISPOSE" TO WS-GDNAME
        WHEN "DISP-SETTLE" MOVE "CLTDSPSETTLE" TO WS-GDNAME
        WHEN "DISP-CANCEL" MOVE "CLTDSPCANCEL" TO WS-GDNAME
        WHEN OTHER MOVE "CLTDISP" TO WS-GDNAME
    END-EVALUATE
    MOVE WS-GDNAME TO GD-OPERATION.


EMIT-DISP.
    MOVE CP-DISPOSITION-ID TO WS-ENT
    MOVE "DISP" TO WS-ALABEL
    MOVE SPACES TO WS-AB WS-AA
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL
        WS-AB WS-AA.

EMIT-DSCXL.
    MOVE CP-DISPOSITION-ID TO WS-ENT
    MOVE "DSCXL" TO WS-ALABEL
    MOVE SPACES TO WS-AB WS-AA
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL
        WS-AB WS-AA.

LOAD-COLLATERAL.
    MOVE SPACES TO BK-CLT-COLL
    MOVE CP-COLL-ID TO CT-ID
    MOVE "GET" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "COLLATERAL NOT FOUND" TO CP-MSG
    END-IF.

LOAD-ENFORCEMENT.
    MOVE SPACES TO BK-CLT-ENF
    IF CP-ENFORCE-ID = SPACES
        MOVE DP-ENFORCE-ID TO CP-ENFORCE-ID
    END-IF
    MOVE CP-ENFORCE-ID TO EF-ID
    MOVE "GET" TO ST-OP
    CALL "CLTENFST" USING BK-CLT-STO-REQ BK-CLT-ENF
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "ENFORCEMENT NOT FOUND" TO CP-MSG
    END-IF.

LOAD-DISPOSITION.
    MOVE SPACES TO BK-CLT-DISP
    MOVE CP-DISPOSITION-ID TO DP-ID
    MOVE "GET" TO ST-OP
    CALL "CLTDSTO" USING BK-CLT-STO-REQ BK-CLT-DISP
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "DISPOSITION NOT FOUND" TO CP-MSG
    END-IF.
