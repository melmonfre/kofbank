IDENTIFICATION DIVISION.
PROGRAM-ID. CLTENF.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-ENT PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-AB PIC X(120).
01 WS-AA PIC X(120).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTSTO".
COPY "CLTQL".
COPY "CLTGDP".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CLTENFORC".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-ACT PIC X(16).
01 WS-PREV PIC X(16).
01 WS-I PIC 9(05).
01 WS-OPSAVE PIC X(16).
01 WS-LOCKED PIC X(01).
01 BK-CLT-COLL.
   COPY "CLTC".
01 BK-CLT-ALLOC.
   COPY "CLTA".
01 BK-CLT-ENF.
   COPY "CLTEN".

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    MOVE "N" TO WS-LOCKED
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    EVALUATE CP-OP
        WHEN "ENFORCE" PERFORM DO-ENFORCE
        WHEN "ENF-COMPLETE" PERFORM DO-ENF-COMPLETE
        WHEN "ENF-CANCEL" PERFORM DO-ENF-CANCEL
        WHEN "ENF-GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN ENFORCEMENT OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

DO-ENFORCE.
    PERFORM LOCK-COLLATERAL
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM GUARD-BEGIN
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    IF CP-REPLAY = "Y"
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    PERFORM DO-WORK
    PERFORM GUARD-END
    PERFORM UNLOCK-COLLATERAL
    GOBACK.

DO-WORK.
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CP-ALLOCATION-ID NOT = SPACES
        PERFORM LOAD-ALLOCATION
        IF CP-RC NOT = "00"
            EXIT PARAGRAPH
        END-IF
        IF AA-COLL-ID NOT = CP-COLL-ID
            MOVE "20" TO CP-RC
            MOVE "ALLOCATION COLLATERAL MISMATCH" TO CP-MSG
            EXIT PARAGRAPH
        END-IF
        IF AA-STATUS NOT = "ACTIVE"
            MOVE "20" TO CP-RC
            MOVE "ALLOCATION NOT ACTIVE" TO CP-MSG
            EXIT PARAGRAPH
        END-IF
        IF CP-OBL-ID = SPACES
            MOVE AA-OBL-ID TO CP-OBL-ID
            MOVE AA-OBL-TYPE TO CP-OBL-TYPE
            MOVE AA-FAC-ID TO CP-FAC-ID
        END-IF
        IF CP-AMOUNT <= 0
            MOVE AA-AMOUNT TO CP-AMOUNT
        END-IF
    END-IF
    IF CP-AMOUNT > CT-ALLOCATED
        MOVE "20" TO CP-RC
        MOVE "ENFORCEMENT EXCEEDS ENCUMBRANCE" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-DUPLICATE
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-ID
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM STORE-ENFORCEMENT
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM MARK-PENDING
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CP-ENFORCE-ID TO WS-PREV
    MOVE "ENFORCEMENT PENDING" TO CP-MSG
    MOVE CP-ENFORCE-ID TO WS-ENT
    MOVE "ENF" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

CHECK-DUPLICATE.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "ENFS" TO QL-OP
    MOVE CP-COLL-ID TO QL-FILTER
    CALL "CLTALQ" USING BK-CLT-LIST
    IF QL-RC NOT = "00"
        MOVE QL-RC TO CP-RC
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QL-COUNT
        IF QL-STATUS(WS-I) = "PENDING" OR
           QL-STATUS(WS-I) = "ENFORCING"
            MOVE "20" TO CP-RC
            MOVE "ENFORCEMENT ALREADY OPEN" TO CP-MSG
        END-IF
    END-PERFORM.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CP-ENFORCE-ID
    STRING "E" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CP-ENFORCE-ID
    END-STRING.

STORE-ENFORCEMENT.
    MOVE SPACES TO BK-CLT-ENF
    MOVE CP-ENFORCE-ID TO EF-ID
    MOVE CP-COLL-ID TO EF-COLL-ID
    MOVE CP-ALLOCATION-ID TO EF-ALLOCATION-ID
    MOVE CP-OBL-TYPE TO EF-OBL-TYPE
    MOVE CP-OBL-ID TO EF-OBL-ID
    MOVE CP-CASE-ID TO EF-CASE-ID
    MOVE "PENDING" TO EF-STATUS
    MOVE CP-AMOUNT TO EF-AMOUNT
    MOVE CT-CURRENCY TO EF-CURRENCY
    MOVE WS-BIZDATE TO EF-DATE
    MOVE CP-REASON TO EF-REASON
    MOVE CP-OPERATOR TO EF-OPERATOR
    MOVE WS-BIZDATE TO EF-CREATED
    MOVE WS-BIZDATE TO EF-UPDATED
    MOVE 1 TO EF-VERSION
    MOVE "WRITE" TO ST-OP
    CALL "CLTENFST" USING BK-CLT-STO-REQ BK-CLT-ENF
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "ENFORCEMENT WRITE FAILED" TO CP-MSG
    END-IF.

MARK-PENDING.
    MOVE "ENF-START" TO WS-ACT
    CALL "CLTST" USING CT-STATUS WS-ACT WS-PREV
        CP-RC CP-MSG
    IF CP-RC NOT = "00"
        MOVE "20" TO CP-RC
        MOVE "ENFORCEMENT NOT ELIGIBLE" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-PREV TO CT-STATUS
    ADD 1 TO CT-VERSION
    MOVE WS-BIZDATE TO CT-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "COLLATERAL UPDATE FAILED" TO CP-MSG
    END-IF.

DO-ENF-COMPLETE.
    PERFORM LOAD-ENFORCEMENT
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    IF EF-STATUS = "ENFORCED"
        MOVE "ENFORCEMENT ALREADY COMPLETE" TO CP-MSG
        MOVE EF-STATUS TO CP-STATUS
        GOBACK
    END-IF
    IF EF-STATUS NOT = "PENDING"
        MOVE "20" TO CP-RC
        MOVE "ENFORCEMENT NOT PENDING" TO CP-MSG
        GOBACK
    END-IF
    MOVE EF-COLL-ID TO CP-COLL-ID
    PERFORM LOCK-COLLATERAL
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    MOVE "ENF-DONE" TO WS-ACT
    CALL "CLTST" USING CT-STATUS WS-ACT WS-PREV
        CP-RC CP-MSG
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-COLLATERAL
        GOBACK
    END-IF
    MOVE WS-PREV TO CT-STATUS
    ADD 1 TO CT-VERSION
    MOVE WS-BIZDATE TO CT-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    PERFORM LOAD-ENFORCEMENT
    MOVE "ENFORCED" TO EF-STATUS
    ADD 1 TO EF-VERSION
    MOVE WS-BIZDATE TO EF-UPDATED
    MOVE WS-BIZDATE TO EF-DATE
    MOVE "REWRITE" TO ST-OP
    CALL "CLTENFST" USING BK-CLT-STO-REQ BK-CLT-ENF
    MOVE EF-STATUS TO CP-STATUS
    MOVE "ENFORCEMENT COMPLETE" TO CP-MSG
    PERFORM EMIT-ENFEND
    PERFORM UNLOCK-COLLATERAL
    GOBACK.

DO-ENF-CANCEL.
    PERFORM LOAD-ENFORCEMENT
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    IF EF-STATUS = "CANCELLED"
        MOVE "ENFORCEMENT ALREADY CANCELLED" TO CP-MSG
        MOVE EF-STATUS TO CP-STATUS
        GOBACK
    END-IF
    IF EF-STATUS NOT = "PENDING"
        MOVE "20" TO CP-RC
        MOVE "ENFORCEMENT NOT PENDING" TO CP-MSG
        GOBACK
    END-IF
    MOVE EF-COLL-ID TO CP-COLL-ID
    PERFORM LOCK-COLLATERAL
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-ENFORCEMENT
    MOVE "CANCELLED" TO EF-STATUS
    MOVE CP-REASON TO EF-REASON
    ADD 1 TO EF-VERSION
    MOVE WS-BIZDATE TO EF-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTENFST" USING BK-CLT-STO-REQ BK-CLT-ENF
    MOVE "RECOMPUTE" TO WS-OPSAVE
    MOVE WS-OPSAVE TO CP-OP
    CALL "CLTCAL" USING BK-CLT-PARMS
    MOVE CP-STATUS TO WS-ACT
    MOVE WS-ACT TO CP-STATUS
    MOVE "ENFORCEMENT CANCELLED" TO CP-MSG
    PERFORM EMIT-ENFCXL
    PERFORM UNLOCK-COLLATERAL
    GOBACK.

DO-GET.
    PERFORM LOAD-ENFORCEMENT
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE EF-ID TO CP-ENFORCE-ID
    MOVE EF-COLL-ID TO CP-COLL-ID
    MOVE EF-ALLOCATION-ID TO CP-ALLOCATION-ID
    MOVE EF-OBL-TYPE TO CP-OBL-TYPE
    MOVE EF-OBL-ID TO CP-OBL-ID
    MOVE EF-CASE-ID TO CP-CASE-ID
    MOVE EF-STATUS TO CP-STATUS
    MOVE EF-AMOUNT TO CP-AMOUNT
    MOVE EF-CURRENCY TO CP-CURRENCY
    MOVE EF-RECOVERY-REF TO CP-EXTERNAL-REF.

LOCK-COLLATERAL.
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "LOCK" TO GD-OP
    MOVE CP-COLL-ID TO GD-LOCK-ID
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "COLLATERAL BUSY" TO CP-MSG
    ELSE
        MOVE "Y" TO WS-LOCKED
    END-IF.

UNLOCK-COLLATERAL.
    IF WS-LOCKED = "Y"
        MOVE SPACES TO BK-CLT-GUARD
        MOVE "UNLOCK" TO GD-OP
        MOVE CP-COLL-ID TO GD-LOCK-ID
        MOVE CP-OPERATOR TO GD-OPERATOR
        CALL "CLTGUARD" USING BK-CLT-GUARD
    END-IF.

GUARD-BEGIN.
    MOVE "N" TO CP-REPLAY
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "BEGIN" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CLTENFORCE" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "REQUEST IN PROGRESS" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF GD-HIT = "Y"
        MOVE GD-RESULT(1:12) TO CP-ENFORCE-ID
        MOVE "Y" TO CP-REPLAY
        MOVE "ENFORCEMENT REPLAY" TO CP-MSG
    END-IF.

GUARD-END.
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "END" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CLTENFORCE" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    MOVE CP-RC TO GD-RC
    IF CP-RC = "00"
        MOVE CP-ENFORCE-ID TO GD-RESULT
    ELSE
        MOVE CP-MSG TO GD-RESULT
    END-IF
    CALL "CLTGUARD" USING BK-CLT-GUARD.

LOAD-COLLATERAL.
    MOVE SPACES TO BK-CLT-COLL
    MOVE CP-COLL-ID TO CT-ID
    MOVE "GET" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "COLLATERAL NOT FOUND" TO CP-MSG
    END-IF.

LOAD-ALLOCATION.
    MOVE SPACES TO BK-CLT-ALLOC
    MOVE CP-ALLOCATION-ID TO AA-ID
    MOVE "GET" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "ALLOCATION NOT FOUND" TO CP-MSG
    END-IF.


EMIT-ENFEND.
    MOVE CP-ENFORCE-ID TO WS-ENT
    MOVE "ENFEND" TO WS-ALABEL
    MOVE SPACES TO WS-AB WS-AA
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL
        WS-AB WS-AA.

EMIT-ENFCXL.
    MOVE CP-ENFORCE-ID TO WS-ENT
    MOVE "ENFCXL" TO WS-ALABEL
    MOVE SPACES TO WS-AB WS-AA
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL
        WS-AB WS-AA.

LOAD-ENFORCEMENT.
    MOVE SPACES TO BK-CLT-ENF
    MOVE CP-ENFORCE-ID TO EF-ID
    MOVE "GET" TO ST-OP
    CALL "CLTENFST" USING BK-CLT-STO-REQ BK-CLT-ENF
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "ENFORCEMENT NOT FOUND" TO CP-MSG
    END-IF.
