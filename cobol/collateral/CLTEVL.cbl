IDENTIFICATION DIVISION.
PROGRAM-ID. CLTEVL.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-T PIC X(20).
01 WS-HOME PIC X(80).

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "N" TO CP-ELIG-YN
    MOVE SPACES TO CP-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    IF CP-STATUS = SPACES
        CALL "CLTLOAD" USING BK-CLT-PARMS
    END-IF
    PERFORM CHECK-TYPE
    IF CP-MSG NOT = SPACES
        GOBACK
    END-IF
    PERFORM CHECK-STATUS
    IF CP-MSG NOT = SPACES
        GOBACK
    END-IF
    PERFORM CHECK-OWNERSHIP
    IF CP-MSG NOT = SPACES
        GOBACK
    END-IF
    PERFORM CHECK-CURRENCY
    IF CP-MSG NOT = SPACES
        GOBACK
    END-IF
    PERFORM CHECK-VALUATION
    IF CP-MSG NOT = SPACES
        GOBACK
    END-IF
    PERFORM CHECK-EXPIRY
    IF CP-MSG NOT = SPACES
        GOBACK
    END-IF
    PERFORM CHECK-DOCS
    IF CP-MSG NOT = SPACES
        GOBACK
    END-IF
    PERFORM CHECK-GUARANTEE
    IF CP-MSG NOT = SPACES
        GOBACK
    END-IF
    IF CP-MSG NOT = SPACES
        GOBACK
    END-IF
    MOVE "Y" TO CP-ELIG-YN
    MOVE "ELIGIBLE" TO CP-MSG
    GOBACK.

CHECK-TYPE.
    MOVE CP-COLL-TYPE TO WS-T
    EVALUATE FUNCTION TRIM(WS-T)
        WHEN "CASH" PERFORM CONTINUE-CHK
        WHEN "DEPOSIT" PERFORM CONTINUE-CHK
        WHEN "SECURITIES" PERFORM CONTINUE-CHK
        WHEN "VEHICLE" PERFORM CONTINUE-CHK
        WHEN "REAL-ESTATE" PERFORM CONTINUE-CHK
        WHEN "EQUIPMENT" PERFORM CONTINUE-CHK
        WHEN "RECEIVABLE" PERFORM CONTINUE-CHK
        WHEN "INVENTORY" PERFORM CONTINUE-CHK
        WHEN "GUARANTEE" PERFORM CONTINUE-CHK
        WHEN "PERSONAL-GUARANTEE" PERFORM CONTINUE-CHK
        WHEN "CORPORATE-GUARANTEE" PERFORM CONTINUE-CHK
        WHEN "OTHER" PERFORM CONTINUE-CHK
        WHEN OTHER
            MOVE "UNKNOWN COLLATERAL TYPE" TO CP-MSG
    END-EVALUATE.

CONTINUE-CHK.
    CONTINUE.

CHECK-STATUS.
    EVALUATE FUNCTION TRIM(CP-STATUS)
        WHEN "VALID" PERFORM PASS-CHK
        WHEN "PARTPLED" PERFORM PASS-CHK
        WHEN "PLEDGED" PERFORM PASS-CHK
        WHEN "ENCUMBER" PERFORM PASS-CHK
        WHEN "RELPEND" PERFORM PASS-CHK
        WHEN OTHER
            MOVE "STATUS NOT ELIGIBLE" TO CP-MSG
    END-EVALUATE.

CHECK-OWNERSHIP.
    IF CP-OWNER-ID = SPACES
        MOVE "OWNER REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    EVALUATE FUNCTION TRIM(CP-OWNER-KIND)
        WHEN "CUSTOMER" PERFORM PASS-CHK
        WHEN "CO-OWNER" PERFORM PASS-CHK
        WHEN "THIRD-PARTY" PERFORM PASS-CHK
        WHEN "CORPORATE" PERFORM PASS-CHK
        WHEN "INSTITUTION" PERFORM PASS-CHK
        WHEN OTHER
            MOVE "OWNER KIND UNKNOWN" TO CP-MSG
    END-EVALUATE.

CHECK-CURRENCY.
    IF CP-CURRENCY = SPACES
        MOVE "CURRENCY REQUIRED" TO CP-MSG
    END-IF.

CHECK-VALUATION.
    IF CP-VALUATION <= 0
        MOVE "NO CURRENT VALUATION" TO CP-MSG
    END-IF.

CHECK-EXPIRY.
    IF CP-EXP-DATE NOT = 0
        IF CP-EXP-DATE < WS-BIZDATE
            MOVE "COLLATERAL EXPIRED" TO CP-MSG
        END-IF
    END-IF.

CHECK-DOCS.
    IF CP-DOC-REQ = "Y"
        IF CP-DOC-STATE NOT = "VERIFIED" AND
           CP-DOC-STATE NOT = "VALID"
            MOVE "REQUIRED DOCS MISSING" TO CP-MSG
        END-IF
    END-IF.

CHECK-GUARANTEE.
    MOVE CP-COLL-TYPE TO WS-T
    EVALUATE FUNCTION TRIM(WS-T)
        WHEN "GUARANTEE" PERFORM GUAR-CHK
        WHEN "PERSONAL-GUARANTEE" PERFORM GUAR-CHK
        WHEN "CORPORATE-GUARANTEE" PERFORM GUAR-CHK
        WHEN OTHER PERFORM PASS-CHK
    END-EVALUATE.

GUAR-CHK.
    IF CP-GUARANTOR = SPACES
        MOVE "GUARANTOR REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-GUARANTEE-MAX <= 0
        MOVE "GUARANTEE MAX REQUIRED" TO CP-MSG
    END-IF.

PASS-CHK.
    CONTINUE.
