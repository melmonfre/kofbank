IDENTIFICATION DIVISION.
PROGRAM-ID. CLTVAL.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-ENT PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-AB PIC X(120).
01 WS-AA PIC X(120).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTSTO".
COPY "CLTQL".
COPY "BKIDMP".
COPY "CLTCFGP".
COPY "BDATP".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CLTVALU".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-DATE PIC 9(08).
01 WS-HIT PIC X(01).
01 WS-FOUND PIC X(01).
01 WS-I PIC 9(05).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-PAYLOAD PIC X(200).
01 BK-CLT-COLL.
   COPY "CLTC".
01 BK-CLT-VAL.
   COPY "CLTV".

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    PERFORM BEGIN-OP
    IF WS-HIT = "Y"
        GOBACK
    END-IF
    IF CP-RC NOT = "00"
        PERFORM END-OP
        GOBACK
    END-IF
    EVALUATE CP-OP
        WHEN "CREATE" PERFORM DO-VALUATION
        WHEN "LIST" PERFORM DO-LIST
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN VALUATION OP" TO CP-MSG
    END-EVALUATE
    PERFORM END-OP
    GOBACK.

DO-VALUATION.
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM VALIDATE-VAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-ID
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM MARK-PREV
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM STORE-VALUATION
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM APPLY-TO-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM RECOMPUTE
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CP-VALUATION-ID TO WS-DATE
    MOVE "VALUATION RECORDED" TO CP-MSG
    MOVE CP-VALUATION-ID TO WS-ENT
    MOVE "VAL" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    MOVE CP-ADJUSTED TO WS-AMT-ED
    MOVE WS-AMT-ED TO WS-AA
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

VALIDATE-VAL.
    IF CP-VALUATION <= 0
        MOVE "20" TO CP-RC
        MOVE "VALUATION MUST BE POSITIVE" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-VAL-DATE = 0
        MOVE WS-BIZDATE TO CP-VAL-DATE
    END-IF
    IF CP-VAL-DATE < CT-CREATED
        MOVE "20" TO CP-RC
        MOVE "VALUATION DATE BEFORE CREATION" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CT-VALUATION-ID NOT = SPACES
        PERFORM LOAD-CURRENT-VAL
        IF CP-RC NOT = "00"
            EXIT PARAGRAPH
        END-IF
        IF CP-VAL-DATE < VA-DATE
            MOVE "20" TO CP-RC
            MOVE "VALUATION BEFORE CURRENT" TO CP-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    IF CP-CURRENCY = SPACES
        MOVE CT-CURRENCY TO CP-CURRENCY
    END-IF
    IF CP-CURRENCY NOT = CT-CURRENCY
        MOVE "20" TO CP-RC
        MOVE "VALUATION CURRENCY MISMATCH" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-SOURCE = SPACES
        MOVE "MANUAL" TO CP-SOURCE
    END-IF
    IF CP-METHOD = SPACES
        MOVE "DIRECT" TO CP-METHOD
    END-IF
    MOVE CT-TYPE TO CP-COLL-TYPE
    PERFORM RESOLVE-HAIRCUT
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM COMPUTE-THRU
    MOVE CT-ALLOCATED TO CP-ALLOCATED
    MOVE CT-GUARANTEE-MAX TO CP-GUARANTEE-MAX
    MOVE "VALUE" TO CP-OP
    CALL "CLTCAL" USING BK-CLT-PARMS
    MOVE "CREATE" TO CP-OP.

COMPUTE-THRU.
    MOVE 0 TO CP-VALID-THRU
    IF CG-VALID-DAYS > 0
        MOVE "ADD-DAYS" TO DAT-OP
        MOVE CP-VAL-DATE TO DAT-DATE
        MOVE CG-VALID-DAYS TO DAT-DAYS
        CALL "BDAT" USING BK-DAT-PARMS
        IF DAT-RC = "00"
            MOVE DAT-RESULT TO CP-VALID-THRU
        END-IF
    END-IF.

RESOLVE-HAIRCUT.
    IF CP-HAIRCUT-BPS = 0
        MOVE CP-COLL-TYPE TO CG-TYPE
        CALL "CLTCFG" USING BK-CLT-CFG
        MOVE CG-HAIRCUT-BPS TO CP-HAIRCUT-BPS
    END-IF
    IF CP-HAIRCUT-BPS > 10000
        MOVE "20" TO CP-RC
        MOVE "HAIRCUT CONFIGURATION INVALID" TO CP-MSG
    END-IF.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CP-VALUATION-ID
    STRING "V" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CP-VALUATION-ID
    END-STRING.

MARK-PREV.
    IF CT-VALUATION-ID = SPACES
        EXIT PARAGRAPH
    END-IF
    PERFORM LOAD-CURRENT-VAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SUPERSEDED" TO VA-STATUS
    ADD 1 TO VA-VERSION
    MOVE "REWRITE" TO ST-OP
    CALL "CLTVSTO" USING BK-CLT-STO-REQ BK-CLT-VAL
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "VALUATION SUPERSEDE FAILED" TO CP-MSG
    END-IF.

LOAD-COLLATERAL.
    MOVE SPACES TO BK-CLT-COLL
    MOVE CP-COLL-ID TO CT-ID
    MOVE "GET" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "COLLATERAL NOT FOUND" TO CP-MSG
    END-IF.

LOAD-CURRENT-VAL.
    MOVE SPACES TO BK-CLT-VAL
    MOVE CT-VALUATION-ID TO VA-ID
    MOVE "GET" TO ST-OP
    CALL "CLTVSTO" USING BK-CLT-STO-REQ BK-CLT-VAL
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "CURRENT VALUATION MISSING" TO CP-MSG
    END-IF.

STORE-VALUATION.
    MOVE SPACES TO BK-CLT-VAL
    MOVE CP-VALUATION-ID TO VA-ID
    MOVE CP-COLL-ID TO VA-COLL-ID
    MOVE CP-VAL-DATE TO VA-DATE
    MOVE CP-VALUATION TO VA-AMOUNT
    MOVE CP-CURRENCY TO VA-CURRENCY
    MOVE CP-SOURCE TO VA-SOURCE
    MOVE CP-METHOD TO VA-METHOD
    MOVE CP-HAIRCUT-BPS TO VA-HAIRCUT-BPS
    MOVE CP-ADJUSTED TO VA-ADJUSTED
    MOVE CP-ELIGIBLE TO VA-ELIGIBLE
    MOVE CP-VALID-THRU TO VA-VALID-THRU
    MOVE CT-VALUATION-ID TO VA-PREV-ID
    MOVE "CURRENT" TO VA-STATUS
    MOVE CP-REASON TO VA-REASON
    MOVE CP-OPERATOR TO VA-OPERATOR
    MOVE WS-BIZDATE TO VA-CREATED
    MOVE 1 TO VA-VERSION
    MOVE "WRITE" TO ST-OP
    CALL "CLTVSTO" USING BK-CLT-STO-REQ BK-CLT-VAL
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "VALUATION WRITE FAILED" TO CP-MSG
    END-IF.

APPLY-TO-COLLATERAL.
    MOVE CP-VALUATION-ID TO CT-VALUATION-ID
    MOVE CP-VALUATION TO CT-VALUATION
    MOVE CP-HAIRCUT-BPS TO CT-HAIRCUT-BPS
    MOVE "N" TO CT-REVIEW-FLAG
    MOVE WS-BIZDATE TO CT-UPDATED
    ADD 1 TO CT-VERSION
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "COLLATERAL UPDATE FAILED" TO CP-MSG
    END-IF.

RECOMPUTE.
    MOVE "RECOMPUTE" TO CP-OP
    CALL "CLTCAL" USING BK-CLT-PARMS
    PERFORM SYNC-VALUATION.

SYNC-VALUATION.
    MOVE SPACES TO BK-CLT-VAL
    MOVE CP-VALUATION-ID TO VA-ID
    MOVE "GET" TO ST-OP
    CALL "CLTVSTO" USING BK-CLT-STO-REQ BK-CLT-VAL
    IF ST-RC = "00"
        MOVE CP-ADJUSTED TO VA-ADJUSTED
        MOVE CP-ELIGIBLE TO VA-ELIGIBLE
        ADD 1 TO VA-VERSION
        MOVE "REWRITE" TO ST-OP
        CALL "CLTVSTO" USING BK-CLT-STO-REQ BK-CLT-VAL
    END-IF.

DO-LIST.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "VALU" TO QL-OP
    MOVE CP-COLL-ID TO QL-FILTER
    CALL "CLTQRY" USING BK-CLT-LIST
    MOVE QL-RC TO CP-RC
    MOVE QL-COUNT TO CP-COUNT.

BEGIN-OP.
    MOVE "N" TO WS-HIT
    IF CP-REQUEST = SPACES OR CP-OP NOT = "CREATE"
        EXIT PARAGRAPH
    END-IF
    MOVE CP-REQUEST TO BK-IDM-TXN-ID
    MOVE "CLTVALUATION" TO BK-IDM-OPERATION
    MOVE "B" TO BK-IDM-MODE
    MOVE SPACES TO BK-IDM-RESULT
    CALL "BIDM" USING BK-IDM-PARMS
    IF BK-IDM-STATUS = "22"
        MOVE "G" TO BK-IDM-MODE
        CALL "BIDM" USING BK-IDM-PARMS
        EVALUATE BK-IDM-STATUS
            WHEN "C"
                MOVE BK-IDM-RESULT(1:12) TO CP-VALUATION-ID
                MOVE "00" TO CP-RC
                MOVE "VALUATION REPLAY" TO CP-MSG
                MOVE "Y" TO WS-HIT
            WHEN "F"
                CONTINUE
            WHEN OTHER
                MOVE "24" TO CP-RC
                MOVE "REQUEST IN PROGRESS" TO CP-MSG
                MOVE "Y" TO WS-HIT
        END-EVALUATE
    ELSE
        IF BK-IDM-STATUS NOT = "00"
            MOVE BK-IDM-STATUS TO CP-RC
            MOVE "IDEMPOTENCY STORE ERROR" TO CP-MSG
        END-IF
    END-IF.

END-OP.
    IF CP-REQUEST = SPACES OR WS-HIT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE CP-REQUEST TO BK-IDM-TXN-ID
    MOVE SPACES TO BK-IDM-RESULT
    IF CP-RC = "00"
        MOVE CP-VALUATION-ID TO BK-IDM-RESULT(1:12)
        MOVE "C" TO BK-IDM-MODE
    ELSE
        MOVE CP-MSG TO BK-IDM-RESULT
        MOVE "F" TO BK-IDM-MODE
    END-IF
    CALL "BIDM" USING BK-IDM-PARMS.
