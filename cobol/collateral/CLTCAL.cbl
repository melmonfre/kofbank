IDENTIFICATION DIVISION.
PROGRAM-ID. CLTCAL.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTSTO".
COPY "CLTQL".
COPY "CLTDT".
01 WS-HOME PIC X(80).
01 WS-RAW PIC S9(17)V9999 COMP-3.
01 WS-CUT PIC S9(15)V99 COMP-3.
01 WS-ALLOC PIC S9(15)V99 COMP-3.
01 WS-NCOUNT PIC 9(05).
01 WS-I PIC 9(05).
01 WS-ACT PIC X(16).
01 WS-NEXT PIC X(12).
01 WS-ST-RC PIC X(02).
01 WS-ST-MSG PIC X(80).
01 WS-DOC-BEST PIC X(12).
01 WS-DOC-COUNT PIC 9(05).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 BK-CLT-COLL.
   COPY "CLTC".

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    EVALUATE CP-OP
        WHEN "VALUE" PERFORM COMPUTE-VALUE
        WHEN "RECOMPUTE" PERFORM DO-RECOMPUTE
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN COLLATERAL CALC OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

COMPUTE-VALUE.
    PERFORM CUT-VALUE
    MOVE CP-ADJUSTED TO CP-ELIGIBLE
    IF CP-GUARANTEE-MAX > 0
        IF CP-GUARANTEE-MAX < CP-ELIGIBLE
            MOVE CP-GUARANTEE-MAX TO CP-ELIGIBLE
        END-IF
    END-IF
    IF CP-ELIGIBLE < 0
        MOVE 0 TO CP-ELIGIBLE
    END-IF
    MOVE CP-ELIGIBLE TO CP-AVAILABLE
    SUBTRACT CP-ALLOCATED FROM CP-AVAILABLE
    IF CP-AVAILABLE < 0
        MOVE 0 TO CP-AVAILABLE
    END-IF.

CUT-VALUE.
    MOVE CP-VALUATION TO CP-ADJUSTED
    IF CP-HAIRCUT-BPS > 0
        IF CP-HAIRCUT-BPS > 10000
            MOVE 10000 TO CP-HAIRCUT-BPS
        END-IF
        COMPUTE WS-RAW =
            CP-VALUATION * CP-HAIRCUT-BPS / 10000
        MOVE WS-RAW TO WS-CUT
        SUBTRACT WS-CUT FROM CP-ADJUSTED
    END-IF
    IF CP-ADJUSTED < 0
        MOVE 0 TO CP-ADJUSTED
    END-IF.

DO-RECOMPUTE.
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM SUM-ALLOCATIONS
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM SCAN-DOCS
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM APPLY-VALUES
    PERFORM DERIVE-STATUS
    PERFORM COMPUTE-HASH
    MOVE WS-BIZDATE TO CT-UPDATED
    ADD 1 TO CT-VERSION
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "COLLATERAL UPDATE FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM EXPOSE-COLLATERAL.

LOAD-COLLATERAL.
    MOVE SPACES TO BK-CLT-COLL
    MOVE CP-COLL-ID TO CT-ID
    MOVE "GET" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "COLLATERAL NOT FOUND" TO CP-MSG
    END-IF.

SUM-ALLOCATIONS.
    MOVE 0 TO WS-ALLOC
    MOVE 0 TO WS-NCOUNT
    MOVE SPACES TO BK-CLT-LIST
    MOVE "ALLOC" TO QL-OP
    MOVE CP-COLL-ID TO QL-FILTER
    CALL "CLTALQ" USING BK-CLT-LIST
    IF QL-RC NOT = "00"
        MOVE QL-RC TO CP-RC
        MOVE "ALLOCATION LIST FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QL-COUNT
        IF QL-STATUS(WS-I) = "ACTIVE"
            ADD QL-AMOUNT(WS-I) TO WS-ALLOC
            ADD 1 TO WS-NCOUNT
        END-IF
    END-PERFORM.

SCAN-DOCS.
    MOVE 0 TO WS-DOC-COUNT
    MOVE "MISSING" TO WS-DOC-BEST
    MOVE SPACES TO BK-CLT-LIST
    MOVE "DOCS" TO QL-OP
    MOVE CP-COLL-ID TO QL-FILTER
    CALL "CLTQRY" USING BK-CLT-LIST
    IF QL-RC NOT = "00"
        MOVE QL-RC TO CP-RC
        EXIT PARAGRAPH
    END-IF
    MOVE QL-COUNT TO WS-DOC-COUNT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QL-COUNT
        IF QL-STATUS(WS-I) = "VERIFIED"
            IF QL-DATE(WS-I) = 0
                OR QL-DATE(WS-I) >= WS-BIZDATE
                MOVE "VERIFIED" TO WS-DOC-BEST
            END-IF
        END-IF
    END-PERFORM.

APPLY-VALUES.
    MOVE CT-VALUATION TO CP-VALUATION
    MOVE CT-HAIRCUT-BPS TO CP-HAIRCUT-BPS
    MOVE CT-GUARANTEE-MAX TO CP-GUARANTEE-MAX
    MOVE WS-ALLOC TO CP-ALLOCATED
    PERFORM COMPUTE-VALUE
    MOVE CP-ADJUSTED TO CT-ADJUSTED
    MOVE CP-ELIGIBLE TO CT-ELIGIBLE
    MOVE WS-ALLOC TO CT-ALLOCATED
    MOVE CP-AVAILABLE TO CT-AVAILABLE
    IF CT-DOC-REQ = "Y"
        MOVE WS-DOC-BEST TO CT-DOC-STATE
    ELSE
        MOVE "NOT-REQ" TO CT-DOC-STATE
    END-IF.

DERIVE-STATUS.
    MOVE SPACES TO WS-ACT
    IF WS-NCOUNT = 0
        MOVE "FREE-ALL" TO WS-ACT
    ELSE
        IF WS-ALLOC >= CT-ELIGIBLE
            MOVE "PLEDGE-FULL" TO WS-ACT
        ELSE
            MOVE "PLEDGE-PART" TO WS-ACT
        END-IF
    END-IF
    CALL "CLTST" USING CT-STATUS WS-ACT WS-NEXT
        WS-ST-RC WS-ST-MSG
    IF WS-ST-RC = "00"
        MOVE WS-NEXT TO CT-STATUS
    END-IF.

COMPUTE-HASH.
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(CT-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CT-STATUS) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CT-VALUATION-ID) DELIMITED SIZE "|" DELIMITED SIZE
        CT-ELIGIBLE DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CT-DOC-STATE) DELIMITED SIZE "|" DELIMITED SIZE
        CT-VERSION DELIMITED SIZE INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO CT-HASH.

EXPOSE-COLLATERAL.
    MOVE CT-ID TO CP-COLL-ID
    MOVE CT-TYPE TO CP-COLL-TYPE
    MOVE CT-STATUS TO CP-STATUS
    MOVE CT-CURRENCY TO CP-CURRENCY
    MOVE CT-OWNER-ID TO CP-OWNER-ID
    MOVE CT-OWNER-KIND TO CP-OWNER-KIND
    MOVE CT-VALUATION TO CP-VALUATION
    MOVE CT-VALUATION-ID TO CP-VALUATION-ID
    MOVE CT-HAIRCUT-BPS TO CP-HAIRCUT-BPS
    MOVE CT-ADJUSTED TO CP-ADJUSTED
    MOVE CT-ELIGIBLE TO CP-ELIGIBLE
    MOVE CT-ALLOCATED TO CP-ALLOCATED
    MOVE CT-AVAILABLE TO CP-AVAILABLE
    MOVE CT-GUARANTEE-MAX TO CP-GUARANTEE-MAX
    MOVE CT-EFF-DATE TO CP-EFF-DATE
    MOVE CT-EXP-DATE TO CP-EXP-DATE
    MOVE CT-DOC-REQ TO CP-DOC-REQ
    MOVE CT-DOC-STATE TO CP-DOC-STATE
    MOVE CT-REVIEW-FLAG TO CP-REVIEW
    MOVE CT-MULTI TO CP-MULTI
    MOVE CT-CUST-ID TO CP-CUST-ID
    MOVE CT-REG-REF TO CP-REG-REF
    MOVE CT-EXTERNAL-REF TO CP-EXTERNAL-REF
    MOVE CT-JURISDICTION TO CP-JURISDICTION
    MOVE CT-DESCRIPTION TO CP-DESCRIPTION
    MOVE WS-NCOUNT TO CP-COUNT.
