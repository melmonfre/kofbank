IDENTIFICATION DIVISION.
PROGRAM-ID. CLTDOC.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-ENT PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-AB PIC X(120).
01 WS-AA PIC X(120).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTSTO".
COPY "CLTQL".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CLTDOC".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-PREV PIC X(16).
01 WS-ACT PIC X(16).
01 BK-CLT-COLL.
   COPY "CLTC".
01 BK-CLT-DOC.
   COPY "CLTDT".

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    EVALUATE CP-OP
        WHEN "CREATE" PERFORM DO-CREATE
        WHEN "VERIFY" PERFORM DO-TRANSITION
        WHEN "EXPIRE" PERFORM DO-TRANSITION
        WHEN "INVALIDATE" PERFORM DO-TRANSITION
        WHEN "LIST" PERFORM DO-LIST
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN DOC OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

DO-CREATE.
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CP-DOC-TYPE = SPACES
        MOVE "20" TO CP-RC
        MOVE "DOC TYPE REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-ISSUE-DATE = 0
        MOVE WS-BIZDATE TO CP-ISSUE-DATE
    END-IF
    IF CP-EXP-DATE NOT = 0
        IF CP-EXP-DATE <= CP-ISSUE-DATE
            MOVE "20" TO CP-RC
            MOVE "DOC EXPIRATION AFTER ISSUE" TO CP-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    PERFORM BUILD-ID
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-CLT-DOC
    MOVE CP-DOC-ID TO DT-ID
    MOVE CP-COLL-ID TO DT-COLL-ID
    MOVE CP-DOC-TYPE TO DT-DOC-TYPE
    MOVE "RECEIVED" TO DT-STATUS
    MOVE CP-ISSUE-DATE TO DT-ISSUE-DATE
    MOVE CP-EXP-DATE TO DT-EXP-DATE
    MOVE CP-EXTERNAL-REF TO DT-EXTERNAL-REF
    MOVE CP-DESCRIPTION TO DT-DESCRIPTION
    MOVE CP-OPERATOR TO DT-OPERATOR
    MOVE WS-BIZDATE TO DT-CREATED
    MOVE WS-BIZDATE TO DT-UPDATED
    MOVE 1 TO DT-VERSION
    MOVE "WRITE" TO ST-OP
    CALL "CLTDTSTO" USING BK-CLT-STO-REQ BK-CLT-DOC
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "DOC WRITE FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM RECOMPUTE
    MOVE "DOC REGISTERED" TO CP-MSG
    MOVE CP-DOC-ID TO WS-ENT
    MOVE "DOC" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    MOVE CP-DOC-STATE TO WS-AA
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

DO-TRANSITION.
    MOVE CP-OP TO WS-ACT
    PERFORM LOAD-DOC
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE DT-STATUS TO CP-STATUS
    EVALUATE WS-ACT
        WHEN "VERIFY"
            IF DT-STATUS NOT = "RECEIVED"
                MOVE "20" TO CP-RC
                MOVE "INVALID DOC TRANSITION" TO CP-MSG
            ELSE
                MOVE "VERIFIED" TO DT-STATUS
            END-IF
        WHEN "EXPIRE"
            IF DT-STATUS NOT = "VERIFIED"
                MOVE "20" TO CP-RC
                MOVE "INVALID DOC TRANSITION" TO CP-MSG
            ELSE
                MOVE "EXPIRED" TO DT-STATUS
            END-IF
        WHEN "INVALIDATE"
            IF DT-STATUS = "INVALID"
                MOVE "20" TO CP-RC
                MOVE "INVALID DOC TRANSITION" TO CP-MSG
            ELSE
                MOVE "INVALID" TO DT-STATUS
            END-IF
    END-EVALUATE
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO DT-VERSION
    MOVE WS-BIZDATE TO DT-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTDTSTO" USING BK-CLT-STO-REQ BK-CLT-DOC
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "DOC UPDATE FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE DT-STATUS TO CP-DOC-STATE
    MOVE DT-COLL-ID TO CP-COLL-ID
    PERFORM RECOMPUTE
    MOVE WS-ACT TO CP-MSG.

DO-LIST.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "DOCS" TO QL-OP
    MOVE CP-COLL-ID TO QL-FILTER
    CALL "CLTQRY" USING BK-CLT-LIST
    MOVE QL-RC TO CP-RC
    MOVE QL-COUNT TO CP-COUNT.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CP-DOC-ID
    STRING "W" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CP-DOC-ID
    END-STRING.

LOAD-COLLATERAL.
    MOVE SPACES TO BK-CLT-COLL
    MOVE CP-COLL-ID TO CT-ID
    MOVE "GET" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "COLLATERAL NOT FOUND" TO CP-MSG
    END-IF.

LOAD-DOC.
    MOVE SPACES TO BK-CLT-DOC
    MOVE CP-DOC-ID TO DT-ID
    MOVE "GET" TO ST-OP
    CALL "CLTDTSTO" USING BK-CLT-STO-REQ BK-CLT-DOC
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "DOC NOT FOUND" TO CP-MSG
    END-IF.

RECOMPUTE.
    MOVE CP-OP TO WS-PREV
    MOVE "RECOMPUTE" TO CP-OP
    CALL "CLTCAL" USING BK-CLT-PARMS
    MOVE WS-PREV TO CP-OP.
