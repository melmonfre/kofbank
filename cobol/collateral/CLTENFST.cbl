IDENTIFICATION DIVISION.
PROGRAM-ID. CLTENFST.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ENF-FILE ASSIGN TO WS-ENF-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS EF-ID
        FILE STATUS IS WS-ENF-ST.

DATA DIVISION.
FILE SECTION.
FD ENF-FILE.
01 ENF-REC.
   COPY "CLTEN".

WORKING-STORAGE SECTION.
01 WS-ENF-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-ENF-ST PIC X(02).

LINKAGE SECTION.
COPY "CLTSTO".
01 BK-CLT-ENF.
   COPY "CLTEN".

PROCEDURE DIVISION USING BK-CLT-STO-REQ BK-CLT-ENF.
    MOVE "00" TO ST-RC
    MOVE SPACES TO ST-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-ENF-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltenf.idx"
        DELIMITED SIZE INTO WS-ENF-PATH
    PERFORM OPEN-STORE
    IF ST-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE ST-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO ST-RC
            MOVE "UNKNOWN ENFORCEMENT STORE OP" TO ST-MSG
    END-EVALUATE
    CLOSE ENF-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O ENF-FILE
    IF WS-ENF-ST = "35"
        OPEN OUTPUT ENF-FILE
        CLOSE ENF-FILE
        OPEN I-O ENF-FILE
    END-IF
    IF WS-ENF-ST NOT = "00"
        MOVE WS-ENF-ST TO ST-RC
        MOVE "CANNOT OPEN ENFORCEMENT INDEX" TO ST-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CLT-ENF TO ENF-REC
    WRITE ENF-REC
        INVALID KEY
            MOVE "22" TO ST-RC
            MOVE "ENFORCEMENT ALREADY EXISTS" TO ST-MSG
    END-WRITE.

DO-REWRITE.
    MOVE EF-ID OF BK-CLT-ENF TO EF-ID OF ENF-REC
    READ ENF-FILE
    IF WS-ENF-ST = "00"
        MOVE BK-CLT-ENF TO ENF-REC
        REWRITE ENF-REC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "ENFORCEMENT NOT FOUND" TO ST-MSG
    END-IF.

DO-GET.
    MOVE EF-ID OF BK-CLT-ENF TO EF-ID OF ENF-REC
    READ ENF-FILE
    IF WS-ENF-ST = "00"
        MOVE ENF-REC TO BK-CLT-ENF
        MOVE "00" TO ST-RC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "ENFORCEMENT NOT FOUND" TO ST-MSG
    END-IF.
