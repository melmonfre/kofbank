IDENTIFICATION DIVISION.
PROGRAM-ID. CLTSUB.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-ENT PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-AB PIC X(120).
01 WS-AA PIC X(120).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTSTO".
COPY "CLTGDP".
COPY "CLTQL".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-SUB PIC X(20) VALUE "CLTSUBST".
01 WS-SEQ-ALLOC PIC X(20) VALUE "CLTALLOC".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-ACT PIC X(16).
01 WS-PREV PIC X(16).
01 WS-OPSAVE PIC X(16).
01 WS-SRC-ID PIC X(12).
01 WS-DST-ID PIC X(12).
01 WS-LOCKED-SRC PIC X(01).
01 WS-LOCKED-DST PIC X(01).
01 WS-I PIC 9(05).
01 WS-OBL-TYPE PIC X(08).
01 WS-OBL-ID PIC X(12).
01 WS-FAC-ID PIC X(12).
01 WS-CUST PIC X(12).
01 WS-AMOUNT PIC S9(15)V99 COMP-3.
01 BK-CLT-COLL.
   COPY "CLTC".
01 BK-CLT-SUBST.
   COPY "CLTSB".
01 BK-CLT-ALLOC.
   COPY "CLTA".

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    MOVE "N" TO WS-LOCKED-SRC
    MOVE "N" TO WS-LOCKED-DST
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    EVALUATE CP-OP
        WHEN "SUBSTITUTE" PERFORM DO-SUBSTITUTE
        WHEN "SUBST-COMPLETE" PERFORM DO-COMPLETE
        WHEN "SUBST-CANCEL" PERFORM DO-CANCEL
        WHEN "SUBST-GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN SUBSTITUTION OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

DO-SUBSTITUTE.
    MOVE CP-SRC-COLL-ID TO WS-SRC-ID
    MOVE CP-DST-COLL-ID TO WS-DST-ID
    PERFORM LOAD-SRC-ALLOC
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    IF AA-COLL-ID NOT = WS-SRC-ID
        MOVE "20" TO CP-RC
        MOVE "ALLOCATION COLLATERAL MISMATCH" TO CP-MSG
        GOBACK
    END-IF
    IF AA-STATUS NOT = "ACTIVE"
        MOVE "20" TO CP-RC
        MOVE "ALLOCATION NOT ACTIVE" TO CP-MSG
        GOBACK
    END-IF
    MOVE AA-OBL-TYPE TO WS-OBL-TYPE
    MOVE AA-OBL-ID TO WS-OBL-ID
    MOVE AA-FAC-ID TO WS-FAC-ID
    MOVE AA-CUST-ID TO WS-CUST
    IF CP-AMOUNT <= 0
        MOVE AA-AMOUNT TO CP-AMOUNT
    END-IF
    IF CP-CURRENCY = SPACES
        MOVE AA-CURRENCY TO CP-CURRENCY
    END-IF
    IF CP-AMOUNT NOT = AA-AMOUNT
        MOVE "20" TO CP-RC
        MOVE "SUBSTITUTION AMOUNT MISMATCH" TO CP-MSG
        GOBACK
    END-IF
    IF WS-DST-ID = WS-SRC-ID
        MOVE "20" TO CP-RC
        MOVE "SAME COLLATERAL" TO CP-MSG
        GOBACK
    END-IF
    PERFORM LOCK-SRC
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOCK-DST
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-ALL
        GOBACK
    END-IF
    PERFORM GUARD-BEGIN
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-ALL
        GOBACK
    END-IF
    IF CP-REPLAY = "Y"
        PERFORM UNLOCK-ALL
        GOBACK
    END-IF
    PERFORM DO-WORK
    PERFORM GUARD-END
    PERFORM UNLOCK-ALL
    GOBACK.

DO-WORK.
    PERFORM CHECK-DST
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM MARK-SRC-PENDING
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-IDS
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM STORE-DST-ALLOC
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM STORE-SUBST
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SUBSTITUTION PENDING" TO CP-MSG
    MOVE "PENDING" TO CP-STATUS
    MOVE CP-SUBST-ID TO WS-ENT
    MOVE "SUB" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

CHECK-DST.
    MOVE CP-OP TO WS-OPSAVE
    MOVE WS-DST-ID TO CP-COLL-ID
    MOVE "RECOMPUTE" TO CP-OP
    CALL "CLTCAL" USING BK-CLT-PARMS
    MOVE WS-OPSAVE TO CP-OP
    IF CP-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "DST COLLATERAL NOT FOUND" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-AMOUNT > CP-AVAILABLE
        MOVE "20" TO CP-RC
        MOVE "DST CAPACITY EXCEEDED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SRC-ID TO CP-COLL-ID
    MOVE CP-CURRENCY TO WS-PREV
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CP-CURRENCY NOT = CT-CURRENCY
        MOVE "20" TO CP-RC
        MOVE "CURRENCY MISMATCH: FX UNRESOLVED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-DST-ID TO CP-COLL-ID
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        MOVE WS-SRC-ID TO CP-COLL-ID
        EXIT PARAGRAPH
    END-IF
    MOVE CP-CURRENCY TO CT-CURRENCY
    CALL "CLTEVL" USING BK-CLT-PARMS
    MOVE WS-SRC-ID TO CP-COLL-ID
    IF CP-ELIG-YN NOT = "Y"
        MOVE "20" TO CP-RC
        MOVE "DST COLLATERAL NOT ELIGIBLE" TO CP-MSG
    END-IF.

MARK-SRC-PENDING.
    MOVE WS-SRC-ID TO CP-COLL-ID
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SUB-START" TO WS-ACT
    CALL "CLTST" USING CT-STATUS WS-ACT WS-PREV
        CP-RC CP-MSG
    IF CP-RC NOT = "00"
        MOVE "20" TO CP-RC
        MOVE "SRC NOT SUBSTITUTABLE" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-PREV TO CT-STATUS
    ADD 1 TO CT-VERSION
    MOVE WS-BIZDATE TO CT-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "COLLATERAL UPDATE FAILED" TO CP-MSG
    END-IF.

BUILD-IDS.
    CALL "BSEQ" USING WS-SEQ-SUB WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CP-SUBST-ID
    STRING "B" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CP-SUBST-ID
    END-STRING
    CALL "BSEQ" USING WS-SEQ-ALLOC WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CP-DST-ALLOC-ID
    STRING "J" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CP-DST-ALLOC-ID
    END-STRING.

STORE-DST-ALLOC.
    MOVE SPACES TO BK-CLT-ALLOC
    MOVE CP-DST-ALLOC-ID TO AA-ID
    MOVE WS-DST-ID TO AA-COLL-ID
    MOVE WS-OBL-TYPE TO AA-OBL-TYPE
    MOVE WS-OBL-ID TO AA-OBL-ID
    MOVE WS-FAC-ID TO AA-FAC-ID
    MOVE WS-CUST TO AA-CUST-ID
    MOVE CP-AMOUNT TO AA-AMOUNT
    MOVE CP-CURRENCY TO AA-CURRENCY
    MOVE 2 TO AA-PRIORITY
    MOVE "PENDING" TO AA-STATUS
    MOVE WS-BIZDATE TO AA-ALLOC-DATE
    MOVE CP-REASON TO AA-REASON
    MOVE CP-OPERATOR TO AA-OPERATOR
    MOVE WS-BIZDATE TO AA-CREATED
    MOVE WS-BIZDATE TO AA-UPDATED
    MOVE 1 TO AA-VERSION
    MOVE "WRITE" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "ALLOCATION WRITE FAILED" TO CP-MSG
    END-IF.

STORE-SUBST.
    MOVE SPACES TO BK-CLT-SUBST
    MOVE CP-SUBST-ID TO SU-ID
    MOVE WS-SRC-ID TO SU-SRC-COLL
    MOVE WS-DST-ID TO SU-DST-COLL
    MOVE CP-ALLOCATION-ID TO SU-SRC-ALLOC
    MOVE CP-DST-ALLOC-ID TO SU-DST-ALLOC
    MOVE WS-OBL-TYPE TO SU-OBL-TYPE
    MOVE WS-OBL-ID TO SU-OBL-ID
    MOVE CP-AMOUNT TO SU-AMOUNT
    MOVE CP-CURRENCY TO SU-CURRENCY
    MOVE "PENDING" TO SU-STATUS
    MOVE WS-BIZDATE TO SU-EFF-DATE
    MOVE CP-REASON TO SU-REASON
    MOVE CP-OPERATOR TO SU-OPERATOR
    MOVE WS-BIZDATE TO SU-CREATED
    MOVE WS-BIZDATE TO SU-UPDATED
    MOVE 1 TO SU-VERSION
    MOVE "WRITE" TO ST-OP
    CALL "CLTSBSTO" USING BK-CLT-STO-REQ BK-CLT-SUBST
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "SUBSTITUTION WRITE FAILED" TO CP-MSG
    END-IF.

DO-COMPLETE.
    PERFORM LOAD-SUBST
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    IF SU-STATUS = "DONE"
        MOVE "SUBSTITUTION ALREADY COMPLETE" TO CP-MSG
        MOVE SU-STATUS TO CP-STATUS
        GOBACK
    END-IF
    IF SU-STATUS NOT = "PENDING"
        MOVE "20" TO CP-RC
        MOVE "SUBSTITUTION NOT PENDING" TO CP-MSG
        GOBACK
    END-IF
    MOVE SU-SRC-COLL TO WS-SRC-ID
    MOVE SU-DST-COLL TO WS-DST-ID
    MOVE CP-SUBST-ID TO WS-OPSAVE
    PERFORM LOCK-SRC
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOCK-DST
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-ALL
        GOBACK
    END-IF
    PERFORM LOAD-SUBST
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-ALL
        GOBACK
    END-IF
    IF SU-STATUS NOT = "PENDING"
        MOVE "20" TO CP-RC
        MOVE "SUBSTITUTION NOT PENDING" TO CP-MSG
        PERFORM UNLOCK-ALL
        GOBACK
    END-IF
    PERFORM APPLY-COMPLETE
    PERFORM UNLOCK-ALL
    GOBACK.

APPLY-COMPLETE.
    MOVE SU-SRC-ALLOC TO AA-ID
    MOVE "GET" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "SRC ALLOCATION NOT FOUND" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "SUBSTITUTED" TO AA-STATUS
    MOVE WS-BIZDATE TO AA-RELEASE-DATE
    ADD 1 TO AA-VERSION
    MOVE WS-BIZDATE TO AA-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    MOVE SU-DST-ALLOC TO AA-ID
    MOVE "GET" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "DST ALLOCATION NOT FOUND" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "ACTIVE" TO AA-STATUS
    ADD 1 TO AA-VERSION
    MOVE WS-BIZDATE TO AA-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    MOVE "DONE" TO SU-STATUS
    MOVE WS-BIZDATE TO SU-EFF-DATE
    ADD 1 TO SU-VERSION
    MOVE WS-BIZDATE TO SU-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSBSTO" USING BK-CLT-STO-REQ BK-CLT-SUBST
    MOVE WS-SRC-ID TO CP-COLL-ID
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SUB-DONE" TO WS-ACT
    CALL "CLTST" USING CT-STATUS WS-ACT WS-PREV
        CP-RC CP-MSG
    IF CP-RC NOT = "00"
        MOVE "20" TO CP-RC
        MOVE "SRC STATE CHANGED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-PREV TO CT-STATUS
    ADD 1 TO CT-VERSION
    MOVE WS-BIZDATE TO CT-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    MOVE WS-SRC-ID TO CP-COLL-ID
    PERFORM RECOMPUTE
    MOVE WS-DST-ID TO CP-COLL-ID
    PERFORM RECOMPUTE
    MOVE SU-DST-ALLOC TO CP-DST-ALLOC-ID
    MOVE "SUBSTITUTION COMPLETE" TO CP-MSG
    MOVE "DONE" TO CP-STATUS
    MOVE CP-SUBST-ID TO WS-ENT
    MOVE "SUBEND" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

DO-CANCEL.
    PERFORM LOAD-SUBST
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    IF SU-STATUS = "CANCELLED"
        MOVE "SUBSTITUTION ALREADY CANCELLED" TO CP-MSG
        MOVE SU-STATUS TO CP-STATUS
        GOBACK
    END-IF
    IF SU-STATUS NOT = "PENDING"
        MOVE "20" TO CP-RC
        MOVE "SUBSTITUTION NOT PENDING" TO CP-MSG
        GOBACK
    END-IF
    MOVE SU-SRC-COLL TO WS-SRC-ID
    MOVE SU-DST-COLL TO WS-DST-ID
    PERFORM LOCK-SRC
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOCK-DST
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-ALL
        GOBACK
    END-IF
    PERFORM LOAD-SUBST
    IF SU-STATUS NOT = "PENDING"
        MOVE "20" TO CP-RC
        MOVE "SUBSTITUTION NOT PENDING" TO CP-MSG
        PERFORM UNLOCK-ALL
        GOBACK
    END-IF
    PERFORM APPLY-CANCEL
    PERFORM UNLOCK-ALL
    GOBACK.

APPLY-CANCEL.
    MOVE "CANCELLED" TO SU-STATUS
    MOVE CP-REASON TO SU-REASON
    ADD 1 TO SU-VERSION
    MOVE WS-BIZDATE TO SU-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSBSTO" USING BK-CLT-STO-REQ BK-CLT-SUBST
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "SUBSTITUTION UPDATE FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SU-DST-ALLOC TO AA-ID
    MOVE "GET" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    IF ST-RC = "00"
        IF AA-STATUS = "PENDING"
            MOVE "INVALID" TO AA-STATUS
            ADD 1 TO AA-VERSION
            MOVE WS-BIZDATE TO AA-UPDATED
            MOVE "REWRITE" TO ST-OP
            CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
        END-IF
    END-IF
    MOVE WS-SRC-ID TO CP-COLL-ID
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SUB-CANCEL" TO WS-ACT
    CALL "CLTST" USING CT-STATUS WS-ACT WS-PREV
        CP-RC CP-MSG
    IF CP-RC NOT = "00"
        MOVE "20" TO CP-RC
        MOVE "SRC STATE CHANGED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-PREV TO CT-STATUS
    ADD 1 TO CT-VERSION
    MOVE WS-BIZDATE TO CT-UPDATED
    MOVE "REWRITE" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    PERFORM RECOMPUTE
    MOVE "SUBSTITUTION CANCELLED" TO CP-MSG
    MOVE "CANCELLED" TO CP-STATUS
    MOVE CP-SUBST-ID TO WS-ENT
    MOVE "SUBCXL" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

DO-GET.
    PERFORM LOAD-SUBST
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE SU-ID TO CP-SUBST-ID
    MOVE SU-SRC-COLL TO CP-SRC-COLL-ID
    MOVE SU-DST-COLL TO CP-DST-COLL-ID
    MOVE SU-SRC-ALLOC TO CP-ALLOCATION-ID
    MOVE SU-DST-ALLOC TO CP-DST-ALLOC-ID
    MOVE SU-STATUS TO CP-STATUS
    MOVE SU-AMOUNT TO CP-AMOUNT
    MOVE SU-CURRENCY TO CP-CURRENCY
    MOVE SU-OBL-ID TO CP-OBL-ID
    MOVE SU-EFF-DATE TO CP-EFF-DATE.

LOCK-SRC.
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "LOCK" TO GD-OP
    MOVE WS-SRC-ID TO GD-LOCK-ID
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "SRC COLLATERAL BUSY" TO CP-MSG
    ELSE
        MOVE "Y" TO WS-LOCKED-SRC
    END-IF.

LOCK-DST.
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "LOCK" TO GD-OP
    MOVE WS-DST-ID TO GD-LOCK-ID
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "DST COLLATERAL BUSY" TO CP-MSG
    ELSE
        MOVE "Y" TO WS-LOCKED-DST
    END-IF.

UNLOCK-ALL.
    IF WS-LOCKED-DST = "Y"
        MOVE SPACES TO BK-CLT-GUARD
        MOVE "UNLOCK" TO GD-OP
        MOVE WS-DST-ID TO GD-LOCK-ID
        MOVE CP-OPERATOR TO GD-OPERATOR
        CALL "CLTGUARD" USING BK-CLT-GUARD
        MOVE "N" TO WS-LOCKED-DST
    END-IF
    IF WS-LOCKED-SRC = "Y"
        MOVE SPACES TO BK-CLT-GUARD
        MOVE "UNLOCK" TO GD-OP
        MOVE WS-SRC-ID TO GD-LOCK-ID
        MOVE CP-OPERATOR TO GD-OPERATOR
        CALL "CLTGUARD" USING BK-CLT-GUARD
        MOVE "N" TO WS-LOCKED-SRC
    END-IF.

RECOMPUTE.
    MOVE CP-OP TO WS-OPSAVE
    MOVE "RECOMPUTE" TO CP-OP
    CALL "CLTCAL" USING BK-CLT-PARMS
    MOVE WS-OPSAVE TO CP-OP.

LOAD-COLLATERAL.
    MOVE SPACES TO BK-CLT-COLL
    MOVE CP-COLL-ID TO CT-ID
    MOVE "GET" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "COLLATERAL NOT FOUND" TO CP-MSG
    END-IF.

LOAD-SRC-ALLOC.
    MOVE SPACES TO BK-CLT-ALLOC
    MOVE CP-ALLOCATION-ID TO AA-ID
    MOVE "GET" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "ALLOCATION NOT FOUND" TO CP-MSG
    END-IF.

LOAD-SUBST.
    MOVE SPACES TO BK-CLT-SUBST
    MOVE CP-SUBST-ID TO SU-ID
    MOVE "GET" TO ST-OP
    CALL "CLTSBSTO" USING BK-CLT-STO-REQ BK-CLT-SUBST
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "SUBSTITUTION NOT FOUND" TO CP-MSG
    END-IF.

GUARD-BEGIN.
    MOVE "N" TO CP-REPLAY
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "BEGIN" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CLTSUBST" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "REQUEST IN PROGRESS" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF GD-HIT = "Y"
        MOVE GD-RESULT(1:12) TO CP-SUBST-ID
        MOVE GD-RESULT(13:12) TO CP-DST-ALLOC-ID
        MOVE "Y" TO CP-REPLAY
        MOVE "SUBSTITUTION REPLAY" TO CP-MSG
    END-IF.

GUARD-END.
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "END" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CLTSUBST" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    MOVE CP-RC TO GD-RC
    IF CP-RC = "00"
        MOVE CP-SUBST-ID TO GD-RESULT
        MOVE CP-DST-ALLOC-ID TO GD-RESULT(13:12)
    ELSE
        MOVE CP-MSG TO GD-RESULT
    END-IF
    CALL "CLTGUARD" USING BK-CLT-GUARD.
