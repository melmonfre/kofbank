IDENTIFICATION DIVISION.
PROGRAM-ID. CLTASTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ALOC-FILE ASSIGN TO WS-ALOC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS AA-ID
        FILE STATUS IS WS-ALOC-ST.

DATA DIVISION.
FILE SECTION.
FD ALOC-FILE.
01 ALOC-REC.
   COPY "CLTA".

WORKING-STORAGE SECTION.
01 WS-ALOC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-ALOC-ST PIC X(02).

LINKAGE SECTION.
COPY "CLTSTO".
01 BK-CLT-ALLOC.
   COPY "CLTA".

PROCEDURE DIVISION USING BK-CLT-STO-REQ BK-CLT-ALLOC.
    MOVE "00" TO ST-RC
    MOVE SPACES TO ST-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-ALOC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltalloc.idx"
        DELIMITED SIZE INTO WS-ALOC-PATH
    PERFORM OPEN-STORE
    IF ST-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE ST-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO ST-RC
            MOVE "UNKNOWN ALLOCATION STORE OP" TO ST-MSG
    END-EVALUATE
    CLOSE ALOC-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O ALOC-FILE
    IF WS-ALOC-ST = "35"
        OPEN OUTPUT ALOC-FILE
        CLOSE ALOC-FILE
        OPEN I-O ALOC-FILE
    END-IF
    IF WS-ALOC-ST NOT = "00"
        MOVE WS-ALOC-ST TO ST-RC
        MOVE "CANNOT OPEN ALLOCATION INDEX" TO ST-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CLT-ALLOC TO ALOC-REC
    WRITE ALOC-REC
        INVALID KEY
            MOVE "22" TO ST-RC
            MOVE "ALLOCATION ALREADY EXISTS" TO ST-MSG
    END-WRITE.

DO-REWRITE.
    MOVE AA-ID OF BK-CLT-ALLOC TO AA-ID OF ALOC-REC
    READ ALOC-FILE
    IF WS-ALOC-ST = "00"
        MOVE BK-CLT-ALLOC TO ALOC-REC
        REWRITE ALOC-REC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "ALLOCATION NOT FOUND" TO ST-MSG
    END-IF.

DO-GET.
    MOVE AA-ID OF BK-CLT-ALLOC TO AA-ID OF ALOC-REC
    READ ALOC-FILE
    IF WS-ALOC-ST = "00"
        MOVE ALOC-REC TO BK-CLT-ALLOC
        MOVE "00" TO ST-RC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "ALLOCATION NOT FOUND" TO ST-MSG
    END-IF.
