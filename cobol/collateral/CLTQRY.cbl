IDENTIFICATION DIVISION.
PROGRAM-ID. CLTQRY.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT COLL-FILE ASSIGN TO WS-C-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CT-ID
        FILE STATUS IS WS-C-ST.
    SELECT VAL-FILE ASSIGN TO WS-V-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS VA-ID
        FILE STATUS IS WS-V-ST.
    SELECT DOC-FILE ASSIGN TO WS-D-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS DT-ID
        FILE STATUS IS WS-D-ST.
    SELECT CASE-FILE ASSIGN TO WS-Y-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CC-ID
        FILE STATUS IS WS-Y-ST.

DATA DIVISION.
FILE SECTION.
FD COLL-FILE.
01 COLL-REC.
   COPY "CLTC".
FD VAL-FILE.
01 VAL-REC.
   COPY "CLTV".
FD DOC-FILE.
01 DOC-REC.
   COPY "CLTDT".
FD CASE-FILE.
01 CASE-REC.
   COPY "COLC".

WORKING-STORAGE SECTION.
01 WS-C-PATH PIC X(200).
01 WS-V-PATH PIC X(200).
01 WS-D-PATH PIC X(200).
01 WS-Y-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-C-ST PIC X(02).
01 WS-V-ST PIC X(02).
01 WS-D-ST PIC X(02).
01 WS-Y-ST PIC X(02).
01 WS-EOF PIC X(01).

LINKAGE SECTION.
COPY "CLTQL".

PROCEDURE DIVISION USING BK-CLT-LIST.
    MOVE "00" TO QL-RC
    MOVE SPACES TO QL-MSG
    MOVE 0 TO QL-COUNT
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    PERFORM BUILD-PATHS
    EVALUATE QL-OP
        WHEN "COLL" PERFORM SCAN-COLLATERALS
        WHEN "VALU" PERFORM SCAN-VALUATIONS
        WHEN "DOCS" PERFORM SCAN-DOCS
        WHEN "CASES" PERFORM SCAN-CASES
        WHEN OTHER
            MOVE "99" TO QL-RC
            MOVE "UNKNOWN COLLATERAL LIST OP" TO QL-MSG
    END-EVALUATE
    GOBACK.

BUILD-PATHS.
    MOVE SPACES TO WS-C-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltcoll.idx"
        DELIMITED SIZE INTO WS-C-PATH
    MOVE SPACES TO WS-V-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltval.idx"
        DELIMITED SIZE INTO WS-V-PATH
    MOVE SPACES TO WS-D-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltdoc.idx"
        DELIMITED SIZE INTO WS-D-PATH
    MOVE SPACES TO WS-Y-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/colcase.idx"
        DELIMITED SIZE INTO WS-Y-PATH.

SCAN-COLLATERALS.
    OPEN INPUT COLL-FILE
    IF WS-C-ST NOT = "00"
        CLOSE COLL-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ COLL-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM TAKE-COLLATERAL
        END-READ
    END-PERFORM
    CLOSE COLL-FILE.

TAKE-COLLATERAL.
    IF QL-CUST NOT = SPACES
        IF CT-OWNER-ID OF COLL-REC NOT = QL-CUST
            EXIT PARAGRAPH
        END-IF
    END-IF
    IF QL-FILTER NOT = SPACES
        IF CT-CUST-ID OF COLL-REC NOT = QL-FILTER
            EXIT PARAGRAPH
        END-IF
    END-IF
    PERFORM ADD-ROW
    IF QL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CT-ID OF COLL-REC TO QL-ID(QL-COUNT)
    MOVE CT-STATUS OF COLL-REC TO QL-STATUS(QL-COUNT)
    MOVE CT-ELIGIBLE OF COLL-REC TO QL-AMOUNT(QL-COUNT)
    MOVE CT-ALLOCATED OF COLL-REC TO QL-AMT2(QL-COUNT)
    MOVE CT-CURRENCY OF COLL-REC TO QL-CURRENCY(QL-COUNT)
    MOVE CT-EFF-DATE OF COLL-REC TO QL-DATE(QL-COUNT)
    MOVE CT-TYPE OF COLL-REC TO QL-TEXT(QL-COUNT).

SCAN-VALUATIONS.
    OPEN INPUT VAL-FILE
    IF WS-V-ST NOT = "00"
        CLOSE VAL-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ VAL-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF VA-COLL-ID OF VAL-REC = QL-FILTER
                    PERFORM TAKE-VALUATION
                END-IF
        END-READ
    END-PERFORM
    CLOSE VAL-FILE.

TAKE-VALUATION.
    PERFORM ADD-ROW
    IF QL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE VA-ID OF VAL-REC TO QL-ID(QL-COUNT)
    MOVE VA-COLL-ID OF VAL-REC TO QL-COLL(QL-COUNT)
    MOVE VA-STATUS OF VAL-REC TO QL-STATUS(QL-COUNT)
    MOVE VA-AMOUNT OF VAL-REC TO QL-AMOUNT(QL-COUNT)
    MOVE VA-CURRENCY OF VAL-REC TO QL-CURRENCY(QL-COUNT)
    MOVE VA-DATE OF VAL-REC TO QL-DATE(QL-COUNT)
    MOVE VA-METHOD OF VAL-REC TO QL-TEXT(QL-COUNT).

SCAN-DOCS.
    OPEN INPUT DOC-FILE
    IF WS-D-ST NOT = "00"
        CLOSE DOC-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ DOC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF DT-COLL-ID OF DOC-REC = QL-FILTER
                    PERFORM TAKE-DOC
                END-IF
        END-READ
    END-PERFORM
    CLOSE DOC-FILE.

TAKE-DOC.
    PERFORM ADD-ROW
    IF QL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE DT-ID OF DOC-REC TO QL-ID(QL-COUNT)
    MOVE DT-COLL-ID OF DOC-REC TO QL-COLL(QL-COUNT)
    MOVE DT-STATUS OF DOC-REC TO QL-STATUS(QL-COUNT)
    MOVE DT-EXP-DATE OF DOC-REC TO QL-DATE(QL-COUNT)
    MOVE DT-DOC-TYPE OF DOC-REC TO QL-TEXT(QL-COUNT).

SCAN-CASES.
    OPEN INPUT CASE-FILE
    IF WS-Y-ST NOT = "00"
        CLOSE CASE-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CASE-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF CC-LOAN-ID OF CASE-REC = QL-OBL-ID
                    PERFORM TAKE-CASE
                END-IF
        END-READ
    END-PERFORM
    CLOSE CASE-FILE.

TAKE-CASE.
    PERFORM ADD-ROW
    IF QL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CC-ID OF CASE-REC TO QL-ID(QL-COUNT)
    MOVE CC-STATUS OF CASE-REC TO QL-STATUS(QL-COUNT)
    MOVE CC-OVERDUE-AMT OF CASE-REC TO QL-AMOUNT(QL-COUNT)
    MOVE CC-CURRENCY OF CASE-REC TO QL-CURRENCY(QL-COUNT)
    MOVE CC-OPEN-DATE OF CASE-REC TO QL-DATE(QL-COUNT)
    MOVE CC-STAGE OF CASE-REC TO QL-TEXT(QL-COUNT).

ADD-ROW.
    IF QL-COUNT >= 300
        MOVE "37" TO QL-RC
        MOVE "COLLATERAL LIST LIMIT EXCEEDED" TO QL-MSG
        MOVE "Y" TO WS-EOF
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO QL-COUNT.
