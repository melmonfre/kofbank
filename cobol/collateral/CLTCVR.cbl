IDENTIFICATION DIVISION.
PROGRAM-ID. CLTCVR.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTSTO".
COPY "CLTQL".
01 WS-HOME PIC X(80).
01 WS-I PIC 9(05).
01 WS-TOTAL PIC S9(15)V99 COMP-3.
01 WS-NCOUNT PIC 9(05).
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-COVERED PIC S9(15)V99 COMP-3.
01 WS-SHORT PIC S9(15)V99 COMP-3.
01 BK-CLT-COLL.
   COPY "CLTC".

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    MOVE 0 TO WS-TOTAL
    MOVE 0 TO WS-NCOUNT
    MOVE SPACES TO BK-CLT-LIST
    MOVE "ALLOCX" TO QL-OP
    MOVE CP-OBL-TYPE TO QL-OBL-TYPE
    MOVE CP-OBL-ID TO QL-OBL-ID
    CALL "CLTALQ" USING BK-CLT-LIST
    IF QL-RC NOT = "00"
        MOVE QL-RC TO CP-RC
        MOVE "ALLOCATION LIST FAILED" TO CP-MSG
        GOBACK
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QL-COUNT
        IF QL-STATUS(WS-I) = "ACTIVE"
            IF QL-CURRENCY(WS-I) = CP-CURRENCY OR
               CP-CURRENCY = SPACES
                ADD QL-AMOUNT(WS-I) TO WS-TOTAL
                ADD 1 TO WS-NCOUNT
            END-IF
        END-IF
    END-PERFORM
    MOVE WS-TOTAL TO CP-ELIGIBLE
    MOVE WS-NCOUNT TO CP-COUNT
    MOVE CP-AMOUNT TO WS-AMT
    IF WS-AMT < 0
        MOVE 0 TO WS-AMT
    END-IF
    MOVE WS-AMT TO WS-COVERED
    MOVE 0 TO WS-SHORT
    IF WS-TOTAL < WS-COVERED
        MOVE WS-TOTAL TO WS-COVERED
        COMPUTE WS-SHORT = WS-AMT - WS-TOTAL
    END-IF
    MOVE WS-COVERED TO CP-ADJUSTED
    MOVE WS-SHORT TO CP-SHORTFALL
    IF WS-TOTAL >= WS-AMT
        MOVE "FULL" TO CP-STATUS
    ELSE
        IF WS-TOTAL > 0
            MOVE "PARTIAL" TO CP-STATUS
        ELSE
            MOVE "NONE" TO CP-STATUS
        END-IF
    END-IF
    MOVE "SECURED EXPOSURE COMPUTED" TO CP-MSG
    GOBACK.
