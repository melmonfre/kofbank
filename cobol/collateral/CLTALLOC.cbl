IDENTIFICATION DIVISION.
PROGRAM-ID. CLTALLOC.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-AMT-ED PIC -(15)9.99.
01 WS-ENT PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-AB PIC X(120).
01 WS-AA PIC X(120).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTSTO".
COPY "CLTQL".
COPY "CLTGDP".
COPY "BLNSTO".
COPY "BCRSTO".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CLTALLOC".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-LOCKED PIC X(01).
01 WS-OK PIC X(01).
01 WS-PREV PIC X(16).
01 WS-PREV-CUR PIC X(03).
01 WS-I PIC 9(05).
01 WS-ALLOC PIC S9(15)V99 COMP-3.
01 BK-CLT-COLL.
   COPY "CLTC".
01 BK-CLT-ALLOC.
   COPY "CLTA".
01 BK-LN-REC.
   COPY "BLN".
01 BK-CR-FAC.
   COPY "BCRF".

LINKAGE SECTION.
COPY "CLTP".

PROCEDURE DIVISION USING BK-CLT-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    MOVE "N" TO WS-LOCKED
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    IF CP-OP NOT = "ALLOCATE"
        MOVE "99" TO CP-RC
        MOVE "UNKNOWN ALLOCATION OP" TO CP-MSG
        GOBACK
    END-IF
    PERFORM GUARD-LOCK
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM GUARD-BEGIN
    IF CP-RC = "00" AND CP-REPLAY = "Y"
        PERFORM GUARD-UNLOCK
        GOBACK
    END-IF
    IF CP-RC NOT = "00"
        PERFORM GUARD-END
        PERFORM GUARD-UNLOCK
        GOBACK
    END-IF
    PERFORM DO-ALLOCATE
    PERFORM GUARD-END
    PERFORM GUARD-UNLOCK
    GOBACK.

DO-ALLOCATE.
    PERFORM LOAD-COLLATERAL
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-OBLIGATION
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-ELIGIBILITY
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-CAPACITY
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-ID
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM STORE-ALLOCATION
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM RECOMPUTE
    MOVE "ALLOCATION CREATED" TO CP-MSG
    MOVE CP-ALLOCATION-ID TO WS-ENT
    MOVE "ALLOC" TO WS-ALABEL
    MOVE SPACES TO WS-AB
    MOVE CP-ALLOCATED TO WS-AMT-ED
    MOVE WS-AMT-ED TO WS-AA
    CALL "CLTAUD" USING BK-CLT-PARMS WS-ENT WS-ALABEL WS-AB WS-AA.

GUARD-LOCK.
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "LOCK" TO GD-OP
    MOVE CP-COLL-ID TO GD-LOCK-ID
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "COLLATERAL BUSY" TO CP-MSG
    ELSE
        MOVE "Y" TO WS-LOCKED
    END-IF.

GUARD-UNLOCK.
    IF WS-LOCKED = "Y"
        MOVE SPACES TO BK-CLT-GUARD
        MOVE "UNLOCK" TO GD-OP
        MOVE CP-COLL-ID TO GD-LOCK-ID
        MOVE CP-OPERATOR TO GD-OPERATOR
        CALL "CLTGUARD" USING BK-CLT-GUARD
    END-IF.

GUARD-BEGIN.
    MOVE "N" TO CP-REPLAY
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "BEGIN" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CLTALLOCATE" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "REQUEST IN PROGRESS" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF GD-HIT = "Y"
        MOVE GD-RESULT(1:12) TO CP-ALLOCATION-ID
        MOVE "Y" TO CP-REPLAY
        MOVE "ALLOCATION REPLAY" TO CP-MSG
    END-IF.

GUARD-END.
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "END" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CLTALLOCATE" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    MOVE CP-RC TO GD-RC
    IF CP-RC = "00"
        MOVE CP-ALLOCATION-ID TO GD-RESULT
    ELSE
        MOVE CP-MSG TO GD-RESULT
    END-IF
    CALL "CLTGUARD" USING BK-CLT-GUARD.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CP-ALLOCATION-ID
    STRING "J" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CP-ALLOCATION-ID
    END-STRING.

LOAD-COLLATERAL.
    MOVE SPACES TO BK-CLT-COLL
    MOVE CP-COLL-ID TO CT-ID
    MOVE "GET" TO ST-OP
    CALL "CLTSTO" USING BK-CLT-STO-REQ BK-CLT-COLL
    IF ST-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "COLLATERAL NOT FOUND" TO CP-MSG
    END-IF.

CHECK-OBLIGATION.
    IF CP-OBL-ID = SPACES
        MOVE "20" TO CP-RC
        MOVE "OBLIGATION REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-AMOUNT <= 0
        MOVE "20" TO CP-RC
        MOVE "ALLOCATION MUST BE POSITIVE" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CP-CURRENCY TO WS-PREV-CUR
    MOVE SPACES TO CP-CURRENCY
    CALL "CLTOBL" USING BK-CLT-PARMS
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CP-CURRENCY NOT = CT-CURRENCY
        MOVE "20" TO CP-RC
        MOVE "COLLATERAL OBLIGATION CURRENCY MISMATCH" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF WS-PREV-CUR NOT = SPACES
        IF WS-PREV-CUR NOT = CT-CURRENCY
            MOVE "20" TO CP-RC
            MOVE "CURRENCY MISMATCH: FX UNRESOLVED" TO CP-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    MOVE CT-CURRENCY TO CP-CURRENCY.

CHECK-ELIGIBILITY.
    MOVE CT-STATUS TO CP-STATUS
    MOVE CT-TYPE TO CP-COLL-TYPE
    MOVE CT-CURRENCY TO CP-CURRENCY
    MOVE CT-OWNER-ID TO CP-OWNER-ID
    MOVE CT-OWNER-KIND TO CP-OWNER-KIND
    MOVE CT-GUARANTOR TO CP-GUARANTOR
    MOVE CT-GUARANTEE-MAX TO CP-GUARANTEE-MAX
    MOVE CT-VALUATION TO CP-VALUATION
    MOVE CT-EXP-DATE TO CP-EXP-DATE
    MOVE CT-DOC-REQ TO CP-DOC-REQ
    MOVE CT-DOC-STATE TO CP-DOC-STATE
    CALL "CLTEVL" USING BK-CLT-PARMS
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CP-ELIG-YN NOT = "Y"
        MOVE "20" TO CP-RC
        EXIT PARAGRAPH
    END-IF
    MOVE CT-ELIGIBLE TO CP-ELIGIBLE.

CHECK-CAPACITY.
    MOVE 0 TO WS-ALLOC
    MOVE "N" TO WS-OK
    MOVE SPACES TO BK-CLT-LIST
    MOVE "ALLOC" TO QL-OP
    MOVE CP-COLL-ID TO QL-FILTER
    CALL "CLTALQ" USING BK-CLT-LIST
    IF QL-RC NOT = "00"
        MOVE QL-RC TO CP-RC
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QL-COUNT
        IF QL-STATUS(WS-I) = "ACTIVE"
            ADD QL-AMOUNT(WS-I) TO WS-ALLOC
            IF QL-TEXT(WS-I) NOT = CP-OBL-ID
                MOVE "Y" TO WS-OK
            END-IF
        END-IF
    END-PERFORM
    IF CT-MULTI NOT = "Y"
        IF WS-OK = "Y"
            MOVE "20" TO CP-RC
            MOVE "MULTIPLE OBLIGATIONS NOT ALLOWED" TO CP-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    COMPUTE WS-ALLOC = WS-ALLOC + CP-AMOUNT
    IF WS-ALLOC > CT-ELIGIBLE
        MOVE "20" TO CP-RC
        MOVE "ALLOCATION EXCEEDS ELIGIBLE VALUE" TO CP-MSG
    END-IF.

STORE-ALLOCATION.
    MOVE SPACES TO BK-CLT-ALLOC
    MOVE CP-ALLOCATION-ID TO AA-ID
    MOVE CP-COLL-ID TO AA-COLL-ID
    MOVE CP-OBL-TYPE TO AA-OBL-TYPE
    MOVE CP-OBL-ID TO AA-OBL-ID
    MOVE CP-FAC-ID TO AA-FAC-ID
    MOVE CP-CUST-ID TO AA-CUST-ID
    MOVE CP-AMOUNT TO AA-AMOUNT
    MOVE CT-CURRENCY TO AA-CURRENCY
    IF CP-PRIORITY = 0
        MOVE 1 TO AA-PRIORITY
    ELSE
        MOVE CP-PRIORITY TO AA-PRIORITY
    END-IF
    MOVE "ACTIVE" TO AA-STATUS
    MOVE WS-BIZDATE TO AA-ALLOC-DATE
    MOVE CP-REASON TO AA-REASON
    MOVE CP-OPERATOR TO AA-OPERATOR
    MOVE WS-BIZDATE TO AA-CREATED
    MOVE WS-BIZDATE TO AA-UPDATED
    MOVE 1 TO AA-VERSION
    MOVE "WRITE" TO ST-OP
    CALL "CLTASTO" USING BK-CLT-STO-REQ BK-CLT-ALLOC
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CP-RC
        MOVE "ALLOCATION WRITE FAILED" TO CP-MSG
    END-IF.

RECOMPUTE.
    MOVE CP-OP TO WS-PREV
    MOVE "RECOMPUTE" TO CP-OP
    CALL "CLTCAL" USING BK-CLT-PARMS
    MOVE WS-PREV TO CP-OP.
