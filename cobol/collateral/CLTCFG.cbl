IDENTIFICATION DIVISION.
PROGRAM-ID. CLTCFG.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CFG-FILE ASSIGN TO WS-CFG-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-CFG-ST.

DATA DIVISION.
FILE SECTION.
FD CFG-FILE.
01 CFG-LINE PIC X(200).

WORKING-STORAGE SECTION.
01 WS-CFG-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CFG-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-T1 PIC X(20).
01 WS-N1 PIC 9(05).
01 WS-N2 PIC X(01).
01 WS-N3 PIC X(01).
01 WS-N4 PIC 9(04).
01 WS-N5 PIC 9(04).
01 WS-WANT PIC X(20).
01 WS-FOUND PIC X(01).

LINKAGE SECTION.
COPY "CLTCFGP".

PROCEDURE DIVISION USING BK-CLT-CFG.
    MOVE SPACES TO WS-WANT
    MOVE CG-TYPE TO WS-WANT
    MOVE 0 TO CG-HAIRCUT-BPS
    MOVE "Y" TO CG-MULTI
    MOVE "N" TO CG-DOC-REQ
    MOVE 0 TO CG-VALID-DAYS
    MOVE 0 TO CG-REVIEW-DAYS
    MOVE "00" TO CG-STATUS
    MOVE "N" TO WS-FOUND
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CFG-PATH
    STRING FUNCTION TRIM(WS-HOME) "/etc/collateral.cfg"
        DELIMITED SIZE INTO WS-CFG-PATH
    OPEN INPUT CFG-FILE
    IF WS-CFG-ST NOT = "00"
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CFG-FILE
            AT END
                MOVE "Y" TO WS-EOF
            NOT AT END
                PERFORM PARSE-LINE
        END-READ
    END-PERFORM
    CLOSE CFG-FILE
    IF WS-FOUND = "N"
        MOVE "24" TO CG-STATUS
    END-IF
    GOBACK.

PARSE-LINE.
    IF CFG-LINE(1:1) = "#" OR CFG-LINE = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-T1
    MOVE 0 TO WS-N1
    MOVE SPACES TO WS-N2
    MOVE SPACES TO WS-N3
    MOVE 0 TO WS-N4
    MOVE 0 TO WS-N5
    UNSTRING CFG-LINE DELIMITED BY "|"
        INTO WS-T1 WS-N1 WS-N2 WS-N3 WS-N4 WS-N5
    END-UNSTRING
    IF FUNCTION TRIM(WS-T1) = FUNCTION TRIM(WS-WANT)
        MOVE "Y" TO WS-FOUND
        MOVE WS-N1 TO CG-HAIRCUT-BPS
        MOVE WS-N2 TO CG-MULTI
        MOVE WS-N3 TO CG-DOC-REQ
        MOVE WS-N4 TO CG-VALID-DAYS
        MOVE WS-N5 TO CG-REVIEW-DAYS
    END-IF.
