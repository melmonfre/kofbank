IDENTIFICATION DIVISION.
PROGRAM-ID. CLTCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(24).
01 WS-P.
   05 WS-A PIC X(80).
   05 WS-B PIC X(80).
   05 WS-C PIC X(80).
   05 WS-D PIC X(80).
   05 WS-E PIC X(80).
   05 WS-F PIC X(80).
   05 WS-G PIC X(80).
   05 WS-H PIC X(80).
   05 WS-I2 PIC X(80).
   05 WS-J2 PIC X(80).
   05 WS-K2 PIC X(80).
   05 WS-L2 PIC X(80).
   05 WS-M2 PIC X(80).
   05 WS-N2 PIC X(80).
   05 WS-O2 PIC X(80).
   05 WS-Q2 PIC X(80).
01 WS-I PIC 9(05).
01 WS-UP PIC X(24).
01 WS-DT PIC 9(08).
COPY "CLTP".
COPY "CLTQL".

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "create" PERFORM DO-CREATE
        WHEN "get" PERFORM DO-GET
        WHEN "validate" PERFORM DO-ACTION
        WHEN "review" PERFORM DO-ACTION
        WHEN "reinstate" PERFORM DO-ACTION
        WHEN "invalidate" PERFORM DO-ACTION
        WHEN "encumber" PERFORM DO-ACTION
        WHEN "cancel" PERFORM DO-ACTION
        WHEN "expire" PERFORM DO-ACTION
        WHEN "setexp" PERFORM DO-SETEXP
        WHEN "value" PERFORM DO-VALUE
        WHEN "vlist" PERFORM DO-VLIST
        WHEN "recompute" PERFORM DO-RECOMPUTE
        WHEN "eligible" PERFORM DO-ELIGIBLE
        WHEN "cover" PERFORM DO-COVER
        WHEN "list" PERFORM DO-LIST
        WHEN "allocate" PERFORM DO-ALLOCATE
        WHEN "release" PERFORM DO-RELEASE
        WHEN "allocs" PERFORM DO-ALLOCS
        WHEN "obl-allocs" PERFORM DO-OBL-ALLOCS
        WHEN "substitute" PERFORM DO-SUBSTITUTE
        WHEN "subst-complete" PERFORM DO-SUBST-COMPLETE
        WHEN "subst-cancel" PERFORM DO-SUBST-CANCEL
        WHEN "subst-list" PERFORM DO-SUBST-LIST
        WHEN "enforce" PERFORM DO-ENFORCE
        WHEN "enforce-complete" PERFORM DO-ENF-COMPLETE
        WHEN "enforce-cancel" PERFORM DO-ENF-CANCEL
        WHEN "enf-list" PERFORM DO-ENF-LIST
        WHEN "dispose" PERFORM DO-DISPOSE
        WHEN "disp-settle" PERFORM DO-DISP-SETTLE
        WHEN "disp-cancel" PERFORM DO-DISP-CANCEL
        WHEN "disp-list" PERFORM DO-DISP-LIST
        WHEN "doc.create" PERFORM DO-DOC-CREATE
        WHEN "doc.verify" PERFORM DO-DOC-VERIFY
        WHEN "doc.expire" PERFORM DO-DOC-EXPIRE
        WHEN "doc.invalidate" PERFORM DO-DOC-INVALIDATE
        WHEN "doc-list" PERFORM DO-DOC-LIST
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN COLLATERAL OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-P
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H
            WS-I2 WS-J2 WS-K2 WS-L2 WS-M2 WS-N2 WS-O2 WS-Q2
    END-UNSTRING.

DO-CREATE.
    MOVE "CREATE" TO CP-OP
    MOVE WS-A TO CP-COLL-TYPE
    MOVE WS-B TO CP-CUST-ID
    MOVE WS-C TO CP-OWNER-ID
    MOVE WS-D TO CP-OWNER-KIND
    MOVE WS-E TO CP-CURRENCY
    MOVE WS-F TO CP-GUARANTOR
    MOVE WS-G TO CP-GUARANTEE-MAX
    MOVE WS-H TO CP-EXTERNAL-REF
    MOVE WS-I2 TO CP-REG-REF
    MOVE WS-J2 TO CP-JURISDICTION
    MOVE WS-K2 TO CP-DESCRIPTION
    MOVE WS-L2 TO CP-EFF-DATE
    MOVE WS-M2 TO CP-EXP-DATE
    MOVE WS-N2 TO CP-OPERATOR
    MOVE WS-O2 TO CP-CORR
    MOVE WS-Q2 TO CP-REQUEST
    CALL "CLT" USING BK-CLT-PARMS
    PERFORM SHOW-COLLATERAL.

DO-GET.
    MOVE "GET" TO CP-OP
    MOVE WS-A TO CP-COLL-ID
    CALL "CLT" USING BK-CLT-PARMS
    PERFORM SHOW-COLLATERAL.

DO-ACTION.
    MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(WS-OP)) TO WS-UP
    MOVE SPACES TO CP-OP
    EVALUATE WS-UP
        WHEN "VALIDATE" MOVE "VALIDATE" TO CP-OP
        WHEN "REVIEW" MOVE "REVIEW" TO CP-OP
        WHEN "REINSTATE" MOVE "REINSTATE" TO CP-OP
        WHEN "INVALIDATE" MOVE "INVALIDATE" TO CP-OP
        WHEN "ENCUMBER" MOVE "ENCUMBER" TO CP-OP
        WHEN "CANCEL" MOVE "CANCEL" TO CP-OP
        WHEN "EXPIRE" MOVE "EXPIRE" TO CP-OP
        WHEN OTHER MOVE "99" TO CP-OP
    END-EVALUATE
    IF CP-OP = "99"
        DISPLAY "rc=99"
        DISPLAY "msg=UNKNOWN COLLATERAL ACTION"
        GOBACK
    END-IF
    MOVE WS-A TO CP-COLL-ID
    MOVE WS-B TO CP-OPERATOR
    MOVE WS-C TO CP-CORR
    MOVE WS-D TO CP-REASON
    CALL "CLT" USING BK-CLT-PARMS
    PERFORM SHOW-COLLATERAL.

DO-SETEXP.
    MOVE "SETEXP" TO CP-OP
    MOVE WS-A TO CP-COLL-ID
    MOVE WS-B TO CP-EXP-DATE
    MOVE WS-C TO CP-OPERATOR
    CALL "CLT" USING BK-CLT-PARMS
    PERFORM SHOW-COLLATERAL.

DO-VALUE.
    MOVE "CREATE" TO CP-OP
    MOVE WS-A TO CP-COLL-ID
    MOVE WS-B TO CP-VALUATION
    MOVE WS-C TO CP-METHOD
    MOVE WS-D TO CP-SOURCE
    MOVE WS-E TO CP-REG-REF
    MOVE WS-F TO CP-VAL-DATE
    MOVE WS-G TO CP-VALID-THRU
    MOVE WS-H TO CP-OPERATOR
    MOVE WS-I2 TO CP-CORR
    MOVE WS-J2 TO CP-REQUEST
    CALL "CLTVAL" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "valuation=" FUNCTION TRIM(CP-VALUATION-ID)
    DISPLAY "adjusted=" CP-ADJUSTED
    DISPLAY "eligible=" CP-ELIGIBLE
    DISPLAY "available=" CP-AVAILABLE
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-RECOMPUTE.
    MOVE "RECOMPUTE" TO CP-OP
    MOVE WS-A TO CP-COLL-ID
    CALL "CLTCAL" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "valuation=" CP-VALUATION
    DISPLAY "adjusted=" CP-ADJUSTED
    DISPLAY "eligible=" CP-ELIGIBLE
    DISPLAY "allocated=" CP-ALLOCATED
    DISPLAY "available=" CP-AVAILABLE
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-ELIGIBLE.
    MOVE WS-A TO CP-COLL-ID
    CALL "CLTEVL" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "eligible=" CP-ELIG-YN
    DISPLAY "reason=" FUNCTION TRIM(CP-MSG).

DO-COVER.
    MOVE WS-A TO CP-OBL-TYPE
    MOVE WS-B TO CP-OBL-ID
    MOVE WS-C TO CP-AMOUNT
    CALL "CLTCVR" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "secured=" CP-ELIGIBLE
    DISPLAY "covered=" CP-ADJUSTED
    DISPLAY "shortfall=" CP-SHORTFALL
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-LIST.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "COLL" TO QL-OP
    MOVE WS-A TO QL-CUST
    MOVE WS-B TO QL-FILTER
    CALL "CLTQRY" USING BK-CLT-LIST
    PERFORM SHOW-ROWS.

DO-VLIST.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "VALU" TO QL-OP
    MOVE WS-A TO QL-FILTER
    CALL "CLTQRY" USING BK-CLT-LIST
    PERFORM SHOW-ROWS.

DO-ALLOCATE.
    MOVE "ALLOCATE" TO CP-OP
    MOVE WS-A TO CP-COLL-ID
    MOVE WS-B TO CP-OBL-TYPE
    MOVE WS-C TO CP-OBL-ID
    MOVE WS-D TO CP-AMOUNT
    MOVE WS-E TO CP-PRIORITY
    MOVE WS-F TO CP-REASON
    MOVE WS-G TO CP-OPERATOR
    MOVE WS-H TO CP-CORR
    MOVE WS-I2 TO CP-REQUEST
    CALL "CLTALLOC" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "allocation=" FUNCTION TRIM(CP-ALLOCATION-ID)
    DISPLAY "allocated=" CP-ALLOCATED
    DISPLAY "available=" CP-AVAILABLE
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-RELEASE.
    MOVE "RELEASE" TO CP-OP
    MOVE WS-A TO CP-ALLOCATION-ID
    MOVE WS-B TO CP-REASON
    MOVE WS-C TO CP-OPERATOR
    MOVE WS-D TO CP-CORR
    MOVE WS-E TO CP-REQUEST
    CALL "CLTRELEA" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-ALLOCS.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "ALLOC" TO QL-OP
    MOVE WS-A TO QL-FILTER
    CALL "CLTALQ" USING BK-CLT-LIST
    PERFORM SHOW-ROWS.

DO-OBL-ALLOCS.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "ALLOCX" TO QL-OP
    MOVE WS-A TO QL-OBL-TYPE
    MOVE WS-B TO QL-OBL-ID
    CALL "CLTALQ" USING BK-CLT-LIST
    PERFORM SHOW-ROWS.

DO-SUBSTITUTE.
    MOVE "SUBSTITUTE" TO CP-OP
    MOVE WS-A TO CP-SRC-COLL-ID
    MOVE WS-B TO CP-DST-COLL-ID
    MOVE WS-C TO CP-ALLOCATION-ID
    MOVE WS-D TO CP-AMOUNT
    MOVE WS-E TO CP-REASON
    MOVE WS-F TO CP-OPERATOR
    MOVE WS-G TO CP-CORR
    MOVE WS-H TO CP-REQUEST
    CALL "CLTSUB" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "substitution=" FUNCTION TRIM(CP-SUBST-ID)
    DISPLAY "dst-allocation=" FUNCTION TRIM(CP-DST-ALLOC-ID)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-SUBST-COMPLETE.
    MOVE "SUBST-COMPLETE" TO CP-OP
    MOVE WS-A TO CP-SUBST-ID
    MOVE WS-B TO CP-OPERATOR
    CALL "CLTSUB" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "dst-allocation=" FUNCTION TRIM(CP-DST-ALLOC-ID)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-SUBST-CANCEL.
    MOVE "SUBST-CANCEL" TO CP-OP
    MOVE WS-A TO CP-SUBST-ID
    MOVE WS-B TO CP-REASON
    MOVE WS-C TO CP-OPERATOR
    CALL "CLTSUB" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-SUBST-LIST.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "SUBS" TO QL-OP
    MOVE WS-A TO QL-FILTER
    CALL "CLTALQ" USING BK-CLT-LIST
    PERFORM SHOW-ROWS.

DO-ENFORCE.
    MOVE "ENFORCE" TO CP-OP
    MOVE WS-A TO CP-COLL-ID
    MOVE WS-B TO CP-ALLOCATION-ID
    MOVE WS-C TO CP-AMOUNT
    MOVE WS-D TO CP-CASE-ID
    MOVE WS-E TO CP-REASON
    MOVE WS-F TO CP-OPERATOR
    MOVE WS-G TO CP-CORR
    MOVE WS-H TO CP-REQUEST
    CALL "CLTENF" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "enforcement=" FUNCTION TRIM(CP-ENFORCE-ID)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-ENF-COMPLETE.
    MOVE "ENF-COMPLETE" TO CP-OP
    MOVE WS-A TO CP-ENFORCE-ID
    MOVE WS-B TO CP-OPERATOR
    CALL "CLTENF" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-ENF-CANCEL.
    MOVE "ENF-CANCEL" TO CP-OP
    MOVE WS-A TO CP-ENFORCE-ID
    MOVE WS-B TO CP-REASON
    MOVE WS-C TO CP-OPERATOR
    CALL "CLTENF" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-ENF-LIST.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "ENFS" TO QL-OP
    MOVE WS-A TO QL-FILTER
    MOVE WS-B TO QL-CASE
    MOVE WS-C TO QL-OBL-ID
    CALL "CLTALQ" USING BK-CLT-LIST
    PERFORM SHOW-ROWS.

DO-DISPOSE.
    MOVE "DISPOSE" TO CP-OP
    MOVE WS-A TO CP-ENFORCE-ID
    MOVE WS-B TO CP-AMOUNT
    MOVE WS-C TO CP-REASON
    MOVE WS-D TO CP-OPERATOR
    MOVE WS-E TO CP-CORR
    MOVE WS-F TO CP-REQUEST
    CALL "CLTDISP" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "disposition=" FUNCTION TRIM(CP-DISPOSITION-ID)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-DISP-SETTLE.
    MOVE "DISP-SETTLE" TO CP-OP
    MOVE WS-A TO CP-DISPOSITION-ID
    MOVE WS-B TO CP-TXN-ID
    MOVE WS-C TO CP-OPERATOR
    CALL "CLTDISP" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "applied=" CP-APPLIED
    DISPLAY "surplus=" CP-SURPLUS
    DISPLAY "shortfall=" CP-SHORTFALL
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-DISP-CANCEL.
    MOVE "DISP-CANCEL" TO CP-OP
    MOVE WS-A TO CP-DISPOSITION-ID
    MOVE WS-B TO CP-REASON
    MOVE WS-C TO CP-OPERATOR
    CALL "CLTDISP" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-DISP-LIST.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "DISPS" TO QL-OP
    MOVE WS-A TO QL-FILTER
    MOVE WS-B TO QL-CASE
    CALL "CLTALQ" USING BK-CLT-LIST
    PERFORM SHOW-ROWS.

DO-DOC-CREATE.
    MOVE "CREATE" TO CP-OP
    MOVE WS-A TO CP-COLL-ID
    MOVE WS-B TO CP-DOC-TYPE
    MOVE WS-C TO CP-DOC-ID
    MOVE WS-D TO CP-ISSUE-DATE
    MOVE WS-E TO CP-EXP-DATE
    MOVE WS-F TO CP-DESCRIPTION
    MOVE WS-G TO CP-OPERATOR
    CALL "CLTDOC" USING BK-CLT-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "document=" FUNCTION TRIM(CP-DOC-ID)
    DISPLAY "state=" FUNCTION TRIM(CP-DOC-STATE)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-DOC-VERIFY.
    PERFORM DOC-ACTION
    MOVE "VERIFY" TO CP-OP
    CALL "CLTDOC" USING BK-CLT-PARMS
    PERFORM SHOW-DOC.

DO-DOC-EXPIRE.
    PERFORM DOC-ACTION
    MOVE "EXPIRE" TO CP-OP
    CALL "CLTDOC" USING BK-CLT-PARMS
    PERFORM SHOW-DOC.

DO-DOC-INVALIDATE.
    PERFORM DOC-ACTION
    MOVE "INVALIDATE" TO CP-OP
    CALL "CLTDOC" USING BK-CLT-PARMS
    PERFORM SHOW-DOC.

DOC-ACTION.
    MOVE WS-A TO CP-DOC-ID
    MOVE WS-B TO CP-VERIFIED
    MOVE WS-C TO CP-OPERATOR.

SHOW-DOC.
    DISPLAY "rc=" CP-RC
    DISPLAY "document=" FUNCTION TRIM(CP-DOC-ID)
    DISPLAY "state=" FUNCTION TRIM(CP-DOC-STATE)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

DO-DOC-LIST.
    MOVE SPACES TO BK-CLT-LIST
    MOVE "DOCS" TO QL-OP
    MOVE WS-A TO QL-FILTER
    CALL "CLTQRY" USING BK-CLT-LIST
    PERFORM SHOW-ROWS.

SHOW-COLLATERAL.
    DISPLAY "rc=" CP-RC
    DISPLAY "collateral=" FUNCTION TRIM(CP-COLL-ID)
    DISPLAY "type=" FUNCTION TRIM(CP-COLL-TYPE)
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "valuation=" CP-VALUATION
    DISPLAY "adjusted=" CP-ADJUSTED
    DISPLAY "eligible=" CP-ELIGIBLE
    DISPLAY "allocated=" CP-ALLOCATED
    DISPLAY "available=" CP-AVAILABLE
    DISPLAY "exp=" CP-EXP-DATE
    DISPLAY "docstate=" FUNCTION TRIM(CP-DOC-STATE)
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

SHOW-ROWS.
    IF QL-RC NOT = "00"
        DISPLAY "rc=" QL-RC
        DISPLAY "msg=" FUNCTION TRIM(QL-MSG)
        GOBACK
    END-IF
    DISPLAY "rc=00"
    DISPLAY "count=" QL-COUNT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > QL-COUNT
        DISPLAY "row|" FUNCTION TRIM(QL-ID(WS-I)) "|"
            FUNCTION TRIM(QL-COLL(WS-I)) "|"
            FUNCTION TRIM(QL-STATUS(WS-I)) "|"
            QL-AMOUNT(WS-I) "|"
            FUNCTION TRIM(QL-CURRENCY(WS-I)) "|"
            QL-DATE(WS-I) "|"
            FUNCTION TRIM(QL-TEXT(WS-I))
    END-PERFORM.
