IDENTIFICATION DIVISION.
PROGRAM-ID. BJRN.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT JRN-FILE ASSIGN TO WS-JRN-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-JRN-ST.

DATA DIVISION.
FILE SECTION.
FD JRN-FILE.
01 JRN-LINE PIC X(500).

WORKING-STORAGE SECTION.
01 WS-JRN-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-JRN-ST PIC X(02).
01 WS-I PIC 9(04).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-TOT-DR PIC S9(15)V99 COMP-3 VALUE 0.
01 WS-TOT-CR PIC S9(15)V99 COMP-3 VALUE 0.
01 WS-HDR-BUF PIC X(400).
01 WS-HSH-LEN PIC 9(04).
01 WS-HSH PIC X(16).

LINKAGE SECTION.
COPY "BKJRNP".
COPY "BKPSTT".

PROCEDURE DIVISION USING BK-JRN-PARMS BK-PST-TABLE.
    MOVE "00" TO BK-JRN-RC
    MOVE SPACES TO BK-JRN-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-JRN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/journal.log"
        DELIMITED SIZE INTO WS-JRN-PATH
    PERFORM COMPUTE-TOTALS
    IF WS-TOT-DR NOT = WS-TOT-CR
        MOVE "20" TO BK-JRN-RC
        MOVE "JOURNAL NOT BALANCED" TO BK-JRN-MSG
        GOBACK
    END-IF
    IF BK-JRN-COUNT = 0 OR BK-JRN-COUNT > 50
        MOVE "20" TO BK-JRN-RC
        MOVE "INVALID POSTING COUNT" TO BK-JRN-MSG
        GOBACK
    END-IF
    PERFORM COMPUTE-HASH
    OPEN EXTEND JRN-FILE
    IF WS-JRN-ST = "35"
        OPEN OUTPUT JRN-FILE
    END-IF
    IF WS-JRN-ST NOT = "00"
        MOVE WS-JRN-ST TO BK-JRN-RC
        MOVE "CANNOT OPEN JOURNAL" TO BK-JRN-MSG
        GOBACK
    END-IF
    PERFORM WRITE-HEADER
    PERFORM WRITE-LINES
    CLOSE JRN-FILE
    GOBACK.

COMPUTE-TOTALS.
    MOVE 0 TO WS-TOT-DR
    MOVE 0 TO WS-TOT-CR
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BK-JRN-COUNT
        IF BK-PST-DC(WS-I) = "D"
            ADD BK-PST-AMOUNT(WS-I) TO WS-TOT-DR
        ELSE
            ADD BK-PST-AMOUNT(WS-I) TO WS-TOT-CR
        END-IF
    END-PERFORM.

COMPUTE-HASH.
    MOVE SPACES TO WS-HDR-BUF
    STRING FUNCTION TRIM(BK-JRN-ID) DELIMITED SIZE
        FUNCTION TRIM(BK-JRN-TXN-ID) DELIMITED SIZE
        FUNCTION TRIM(BK-JRN-TYPE) DELIMITED SIZE
        BK-JRN-BIZDATE DELIMITED SIZE
        BK-JRN-COUNT DELIMITED SIZE
        WS-TOT-DR DELIMITED SIZE
        INTO WS-HDR-BUF
    END-STRING
    MOVE 400 TO WS-HSH-LEN
    CALL "BHSH" USING WS-HDR-BUF WS-HSH-LEN WS-HSH
    MOVE WS-HSH TO BK-JRN-HASH.

WRITE-HEADER.
    MOVE SPACES TO JRN-LINE
    MOVE WS-TOT-DR TO WS-AMT-ED
    STRING "JRN|" DELIMITED SIZE
        FUNCTION TRIM(BK-JRN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-JRN-TXN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-JRN-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        BK-JRN-BIZDATE DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-JRN-CHANNEL) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-JRN-OPERATOR) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-JRN-CORR) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-JRN-REQUEST) DELIMITED SIZE "|" DELIMITED SIZE
        BK-JRN-COUNT DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        BK-JRN-HASH DELIMITED SIZE
        INTO JRN-LINE
    END-STRING
    WRITE JRN-LINE.

WRITE-LINES.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BK-JRN-COUNT
        MOVE SPACES TO JRN-LINE
        MOVE BK-PST-AMOUNT(WS-I) TO WS-AMT-ED
        STRING "PST|" DELIMITED SIZE
            FUNCTION TRIM(BK-JRN-ID) DELIMITED SIZE "|" DELIMITED SIZE
            WS-I DELIMITED SIZE "|" DELIMITED SIZE
            FUNCTION TRIM(BK-PST-GL(WS-I)) DELIMITED SIZE "|" DELIMITED SIZE
            BK-PST-DC(WS-I) DELIMITED SIZE "|" DELIMITED SIZE
            WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
            FUNCTION TRIM(BK-PST-CURRENCY(WS-I)) DELIMITED SIZE
            "|" DELIMITED SIZE
            FUNCTION TRIM(BK-PST-ENTITY(WS-I)) DELIMITED SIZE
            "|" DELIMITED SIZE
            FUNCTION TRIM(BK-PST-DESCR(WS-I)) DELIMITED SIZE
            "|" DELIMITED SIZE
            BK-PST-VALUEDATE(WS-I) DELIMITED SIZE
            INTO JRN-LINE
        END-STRING
        WRITE JRN-LINE
    END-PERFORM.
