IDENTIFICATION DIVISION.
PROGRAM-ID. BDAT.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-Y PIC S9(05).
01 WS-M PIC S9(05).
01 WS-D PIC S9(05).
01 WS-DIM PIC 9(02).
01 WS-LEAP PIC 9(01).
01 WS-N PIC S9(09).

LINKAGE SECTION.
COPY "BDATP".

PROCEDURE DIVISION USING BK-DAT-PARMS.
    MOVE "00" TO DAT-RC
    EVALUATE DAT-OP
        WHEN "ADD-DAYS" PERFORM DO-ADD-DAYS
        WHEN "ADD-MONTHS" PERFORM DO-ADD-MONTHS
        WHEN "DIFF-DAYS" PERFORM DO-DIFF-DAYS
        WHEN OTHER MOVE "99" TO DAT-RC
    END-EVALUATE
    GOBACK.

DO-ADD-DAYS.
    MOVE DAT-DATE TO DAT-RESULT
    MOVE DAT-DAYS TO WS-N
    PERFORM UNTIL WS-N = 0
        IF WS-N > 0
            PERFORM NEXT-DAY
            SUBTRACT 1 FROM WS-N
        ELSE
            PERFORM PREV-DAY
            ADD 1 TO WS-N
        END-IF
    END-PERFORM.

DO-ADD-MONTHS.
    MOVE DAT-DATE TO DAT-RESULT
    COMPUTE WS-Y = DAT-DATE / 10000
    COMPUTE WS-M = FUNCTION MOD(DAT-DATE / 100, 100)
    COMPUTE WS-D = FUNCTION MOD(DAT-DATE, 100)
    ADD DAT-MONTHS TO WS-M
    PERFORM UNTIL WS-M >= 1 AND WS-M <= 12
        IF WS-M > 12
            SUBTRACT 12 FROM WS-M
            ADD 1 TO WS-Y
        ELSE
            ADD 12 TO WS-M
            SUBTRACT 1 FROM WS-Y
        END-IF
    END-PERFORM
    PERFORM GET-DIM
    IF WS-D > WS-DIM
        MOVE WS-DIM TO WS-D
    END-IF
    COMPUTE DAT-RESULT = WS-Y * 10000 + WS-M * 100 + WS-D.

DO-DIFF-DAYS.
    MOVE 0 TO DAT-DAYS
    MOVE DAT-DATE TO DAT-RESULT
    PERFORM UNTIL DAT-RESULT = DAT-DATE2
        IF DAT-DATE <= DAT-DATE2
            PERFORM NEXT-DAY
            ADD 1 TO DAT-DAYS
        ELSE
            PERFORM PREV-DAY
            SUBTRACT 1 FROM DAT-DAYS
        END-IF
    END-PERFORM.

NEXT-DAY.
    PERFORM SPLIT
    ADD 1 TO WS-D
    PERFORM GET-DIM
    IF WS-D > WS-DIM
        MOVE 1 TO WS-D
        ADD 1 TO WS-M
        IF WS-M > 12
            MOVE 1 TO WS-M
            ADD 1 TO WS-Y
        END-IF
    END-IF
    PERFORM JOIN.

PREV-DAY.
    PERFORM SPLIT
    SUBTRACT 1 FROM WS-D
    IF WS-D < 1
        SUBTRACT 1 FROM WS-M
        IF WS-M < 1
            MOVE 12 TO WS-M
            SUBTRACT 1 FROM WS-Y
        END-IF
        PERFORM GET-DIM
        MOVE WS-DIM TO WS-D
    END-IF
    PERFORM JOIN.

SPLIT.
    COMPUTE WS-Y = DAT-RESULT / 10000
    COMPUTE WS-M = FUNCTION MOD(DAT-RESULT / 100, 100)
    COMPUTE WS-D = FUNCTION MOD(DAT-RESULT, 100).

JOIN.
    COMPUTE DAT-RESULT = WS-Y * 10000 + WS-M * 100 + WS-D.

GET-DIM.
    EVALUATE WS-M
        WHEN 1 MOVE 31 TO WS-DIM
        WHEN 2 PERFORM SET-FEB
        WHEN 3 MOVE 31 TO WS-DIM
        WHEN 4 MOVE 30 TO WS-DIM
        WHEN 5 MOVE 31 TO WS-DIM
        WHEN 6 MOVE 30 TO WS-DIM
        WHEN 7 MOVE 31 TO WS-DIM
        WHEN 8 MOVE 31 TO WS-DIM
        WHEN 9 MOVE 30 TO WS-DIM
        WHEN 10 MOVE 31 TO WS-DIM
        WHEN 11 MOVE 30 TO WS-DIM
        WHEN 12 MOVE 31 TO WS-DIM
    END-EVALUATE.

SET-FEB.
    MOVE 0 TO WS-LEAP
    IF FUNCTION MOD(WS-Y, 400) = 0
        MOVE 1 TO WS-LEAP
    ELSE
        IF FUNCTION MOD(WS-Y, 4) = 0 AND FUNCTION MOD(WS-Y, 100) NOT = 0
            MOVE 1 TO WS-LEAP
        END-IF
    END-IF
    IF WS-LEAP = 1
        MOVE 29 TO WS-DIM
    ELSE
        MOVE 28 TO WS-DIM
    END-IF.
