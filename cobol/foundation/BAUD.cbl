IDENTIFICATION DIVISION.
PROGRAM-ID. BAUD.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT AUD-FILE ASSIGN TO WS-AUD-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-AUD-ST.
    SELECT CTL-FILE ASSIGN TO WS-CTL-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-CTL-ST.

DATA DIVISION.
FILE SECTION.
FD AUD-FILE.
01 AUD-LINE PIC X(400).
FD CTL-FILE.
01 CTL-LINE PIC X(12).

WORKING-STORAGE SECTION.
01 WS-AUD-PATH PIC X(200).
01 WS-CTL-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-AUD-ST PIC X(02).
01 WS-CTL-ST PIC X(02).
01 WS-SEQ PIC 9(12) VALUE 0.
01 WS-NOW PIC X(14).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).

LINKAGE SECTION.
COPY "BKAUDP".

PROCEDURE DIVISION USING BK-AUD-PARMS.
    MOVE "00" TO BK-AUD-STATUS
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-AUD-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/audit/audit.log"
        DELIMITED SIZE INTO WS-AUD-PATH
    MOVE SPACES TO WS-CTL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/audseq.dat"
        DELIMITED SIZE INTO WS-CTL-PATH
    CALL "BCFG" USING WS-CFG
    PERFORM NEXT-SEQ
    PERFORM WRITE-AUDIT
    GOBACK.

NEXT-SEQ.
    OPEN INPUT CTL-FILE
    IF WS-CTL-ST = "00"
        READ CTL-FILE
            NOT AT END MOVE CTL-LINE TO WS-SEQ
        END-READ
        CLOSE CTL-FILE
    END-IF
    ADD 1 TO WS-SEQ
    OPEN OUTPUT CTL-FILE
    MOVE WS-SEQ TO CTL-LINE
    WRITE CTL-LINE
    CLOSE CTL-FILE.

WRITE-AUDIT.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE SPACES TO AUD-LINE
    STRING WS-SEQ DELIMITED SIZE "|" DELIMITED SIZE
        WS-NOW(1:14) DELIMITED SIZE "|" DELIMITED SIZE
        WS-BIZDATE DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-AUD-OPERATOR) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-AUD-ACTION) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-AUD-ENTITY) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-AUD-CORR) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-AUD-BEFORE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-AUD-AFTER) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(BK-AUD-RESULT) DELIMITED SIZE
        INTO AUD-LINE
    END-STRING
    OPEN EXTEND AUD-FILE
    IF WS-AUD-ST = "35"
        OPEN OUTPUT AUD-FILE
    END-IF
    IF WS-AUD-ST NOT = "00"
        MOVE WS-AUD-ST TO BK-AUD-STATUS
        GOBACK
    END-IF
    WRITE AUD-LINE
    CLOSE AUD-FILE.
