IDENTIFICATION DIVISION.
PROGRAM-ID. BCFG.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CFG-FILE ASSIGN TO WS-CFG-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-CFG-ST.

DATA DIVISION.
FILE SECTION.
FD CFG-FILE.
01 CFG-LINE PIC X(200).

WORKING-STORAGE SECTION.
01 WS-CFG-PATH PIC X(200).
01 WS-HOME-ENV PIC X(80).
01 WS-CFG-ST PIC X(02).
01 WS-KEY PIC X(40).
01 WS-VAL PIC X(120).
01 WS-DATE-IN PIC X(10).
01 WS-EOF PIC X(01) VALUE "N".
01 WS-DASH-POS PIC 9(02).
01 WS-YYYY PIC X(04).
01 WS-MM PIC X(02).
01 WS-DD PIC X(02).

LINKAGE SECTION.
01 LS-CFG.
   05 LS-HOME PIC X(80).
   05 LS-BIZDATE PIC 9(08).
   05 LS-CURRENCY PIC X(03).
   05 LS-JRN-GEN PIC 9(09).
   05 LS-STATUS PIC X(02).

PROCEDURE DIVISION USING LS-CFG.
    MOVE SPACES TO LS-HOME
    MOVE 0 TO LS-BIZDATE
    MOVE SPACES TO LS-CURRENCY
    MOVE 0 TO LS-JRN-GEN
    ACCEPT WS-HOME-ENV FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CFG-PATH
    STRING FUNCTION TRIM(WS-HOME-ENV) "/etc/bank.cfg"
        DELIMITED SIZE INTO WS-CFG-PATH
    OPEN INPUT CFG-FILE
    IF WS-CFG-ST NOT = "00"
        MOVE "35" TO LS-STATUS
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CFG-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM PARSE-LINE
        END-READ
    END-PERFORM
    CLOSE CFG-FILE
    MOVE "00" TO LS-STATUS
    GOBACK.

PARSE-LINE.
    IF CFG-LINE(1:1) = "#" OR CFG-LINE = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-KEY
    MOVE SPACES TO WS-VAL
    UNSTRING CFG-LINE DELIMITED BY "="
        INTO WS-KEY WS-VAL
    END-UNSTRING
    EVALUATE FUNCTION TRIM(WS-KEY)
        WHEN "home"
            MOVE FUNCTION TRIM(WS-VAL) TO LS-HOME
        WHEN "business-date"
            MOVE FUNCTION TRIM(WS-VAL) TO WS-DATE-IN
            MOVE WS-DATE-IN(1:4) TO WS-YYYY
            MOVE WS-DATE-IN(6:2) TO WS-MM
            MOVE WS-DATE-IN(9:2) TO WS-DD
            MOVE WS-YYYY TO LS-BIZDATE(1:4)
            MOVE WS-MM TO LS-BIZDATE(5:2)
            MOVE WS-DD TO LS-BIZDATE(7:2)
        WHEN "base-currency"
            MOVE FUNCTION TRIM(WS-VAL) TO LS-CURRENCY
        WHEN "journal-generation"
            MOVE FUNCTION TRIM(WS-VAL) TO LS-JRN-GEN
        WHEN OTHER
            CONTINUE
    END-EVALUATE.
