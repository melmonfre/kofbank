IDENTIFICATION DIVISION.
PROGRAM-ID. BLNUPD.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BLNSTO".
01 WS-AMT-ED PIC -(15)9.99.
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-I PIC 9(04).
01 WS-REV-PRIN PIC S9(15)V99 COMP-3.
01 WS-PAID PIC S9(15)V99 COMP-3.
01 BK-LN-REC.
   COPY "BLN".
01 BK-LN-INST.
   COPY "BLNI".

LINKAGE SECTION.
COPY "BLNOP".

PROCEDURE DIVISION USING BK-LN-PARMS.
    MOVE "00" TO CL-RC
    MOVE SPACES TO CL-MSG
    EVALUATE CL-OP
        WHEN "GET" PERFORM DO-GET
        WHEN "DISBURSED" PERFORM DO-SET-DISBURSED
        WHEN "APPLY-PAY" PERFORM DO-APPLY-PAY
        WHEN "REVPAY" PERFORM DO-REV-PAY
        WHEN "APPLY-WO" PERFORM DO-APPLY-WO
        WHEN "SET-OVERDUE" PERFORM DO-SET-OVERDUE
        WHEN OTHER
            MOVE "99" TO CL-RC
            MOVE "UNKNOWN LOAN UPDATE OP" TO CL-MSG
    END-EVALUATE
    GOBACK.

DO-GET.
    PERFORM LOAD-LOAN
    IF CL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE LN-PRINCIPAL TO CL-PRINCIPAL
    MOVE LN-OUTSTANDING TO CL-AMOUNT
    MOVE LN-STATUS TO CL-STATUS.

DO-SET-DISBURSED.
    PERFORM LOAD-LOAN
    IF CL-RC NOT = "00"
        GOBACK
    END-IF
    ADD CL-AMOUNT TO LN-DISBURSED
    MOVE CL-DATE TO LN-DISB-DATE
    MOVE CL-TXN-ID TO LN-DISB-TXN
    PERFORM RECALC
    PERFORM SAVE-LOAN.

DO-APPLY-PAY.
    PERFORM LOAD-LOAN
    IF CL-RC NOT = "00"
        GOBACK
    END-IF
    ADD CL-AMOUNT TO LN-PRINCIPAL-PAID
    PERFORM RECALC
    PERFORM SAVE-LOAN.

DO-REV-PAY.
    PERFORM LOAD-LOAN
    IF CL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE 0 TO WS-REV-PRIN
    PERFORM REVERSE-INSTS
    IF CL-RC NOT = "00"
        GOBACK
    END-IF
    SUBTRACT WS-REV-PRIN FROM LN-PRINCIPAL-PAID
    IF LN-PRINCIPAL-PAID < 0
        MOVE 0 TO LN-PRINCIPAL-PAID
    END-IF
    PERFORM RECALC
    PERFORM SAVE-LOAN.

REVERSE-INSTS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CL-PLAN-N
        MOVE SPACES TO BK-LN-INST
        MOVE LN-ID TO LI-LOAN-ID
        MOVE CL-P-INST(WS-I) TO LI-NUMBER
        MOVE "GET" TO NS-OP
        CALL "BLNISTO" USING BK-LN-STO-REQ BK-LN-INST
        IF NS-RC NOT = "00"
            MOVE NS-RC TO CL-RC
            MOVE "INSTALLMENT NOT FOUND" TO CL-MSG
            EXIT PERFORM
        END-IF
        SUBTRACT CL-P-FEE(WS-I) FROM LI-PAID-FEE
        SUBTRACT CL-P-INT(WS-I) FROM LI-PAID-INT
        SUBTRACT CL-P-PRIN(WS-I) FROM LI-PAID-PRIN
        IF LI-PAID-FEE < 0
            MOVE 0 TO LI-PAID-FEE
        END-IF
        IF LI-PAID-INT < 0
            MOVE 0 TO LI-PAID-INT
        END-IF
        IF LI-PAID-PRIN < 0
            MOVE 0 TO LI-PAID-PRIN
        END-IF
        ADD CL-P-PRIN(WS-I) TO WS-REV-PRIN
        PERFORM SET-INST-STATUS
        ADD 1 TO LI-VERSION
        MOVE "REWRITE" TO NS-OP
        CALL "BLNISTO" USING BK-LN-STO-REQ BK-LN-INST
        IF NS-RC NOT = "00"
            MOVE NS-RC TO CL-RC
            MOVE NS-MSG TO CL-MSG
            EXIT PERFORM
        END-IF
    END-PERFORM.

SET-INST-STATUS.
    COMPUTE WS-PAID = LI-PAID-FEE + LI-PAID-INT + LI-PAID-PRIN
    IF WS-PAID >= LI-TOTAL
        MOVE "PA" TO LI-STATUS
    ELSE
        IF WS-PAID > 0
            MOVE "PT" TO LI-STATUS
        ELSE
            MOVE "SC" TO LI-STATUS
        END-IF
    END-IF.

DO-APPLY-WO.
    PERFORM LOAD-LOAN
    IF CL-RC NOT = "00"
        GOBACK
    END-IF
    ADD CL-AMOUNT TO LN-PRINCIPAL-WO
    PERFORM RECALC
    PERFORM SAVE-LOAN.

DO-SET-OVERDUE.
    PERFORM LOAD-LOAN
    IF CL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE CL-AMOUNT TO LN-OVERDUE-PRIN
    PERFORM SAVE-LOAN.

RECALC.
    COMPUTE LN-OUTSTANDING =
        LN-DISBURSED - LN-PRINCIPAL-PAID - LN-PRINCIPAL-WO
    IF LN-OUTSTANDING < 0
        MOVE 0 TO LN-OUTSTANDING
    END-IF
    IF LN-OVERDUE-PRIN > LN-OUTSTANDING
        MOVE LN-OUTSTANDING TO LN-OVERDUE-PRIN
    END-IF.

LOAD-LOAN.
    MOVE SPACES TO BK-LN-REC
    MOVE CL-LOAN-ID TO LN-ID
    MOVE "GET" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE "23" TO CL-RC
        MOVE "LOAN NOT FOUND" TO CL-MSG
    END-IF.

SAVE-LOAN.
    ADD 1 TO LN-VERSION
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE NS-RC TO CL-RC
        MOVE NS-MSG TO CL-MSG
    END-IF.

COMPUTE-HASH.
    MOVE LN-PRINCIPAL TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(LN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        LN-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        LN-VERSION DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO LN-HASH.
