IDENTIFICATION DIVISION.
PROGRAM-ID. BLNIQ.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT INST-FILE ASSIGN TO WS-INST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS LI-KEY
        FILE STATUS IS WS-INST-ST.

DATA DIVISION.
FILE SECTION.
FD INST-FILE.
01 INST-REC.
   COPY "BLNI".

WORKING-STORAGE SECTION.
01 WS-INST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-INST-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-COUNT PIC 9(06).
01 WS-OP-ED PIC -(15)9.99.
01 WS-PR-ED PIC -(15)9.99.
01 WS-IN-ED PIC -(15)9.99.
01 WS-FE-ED PIC -(15)9.99.
01 WS-TD-ED PIC -(15)9.99.
01 WS-CL-ED PIC -(15)9.99.

LINKAGE SECTION.
01 LS-OP PIC X(08).
01 LS-LOAN PIC X(12).
01 LS-NUMBER PIC 9(04).
01 LS-RC PIC X(02).

PROCEDURE DIVISION USING LS-OP LS-LOAN LS-NUMBER LS-RC.
    MOVE "00" TO LS-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-INST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/loaninst.idx"
        DELIMITED SIZE INTO WS-INST-PATH
    OPEN INPUT INST-FILE
    IF WS-INST-ST NOT = "00"
        MOVE "35" TO LS-RC
        GOBACK
    END-IF
    EVALUATE LS-OP
        WHEN "GET" PERFORM DO-GET
        WHEN "LIST" PERFORM DO-LIST
        WHEN OTHER MOVE "99" TO LS-RC
    END-EVALUATE
    CLOSE INST-FILE
    GOBACK.

DO-GET.
    MOVE LS-LOAN TO LI-LOAN-ID
    MOVE LS-NUMBER TO LI-NUMBER
    READ INST-FILE
    IF WS-INST-ST = "00"
        PERFORM SHOW-INST
    ELSE
        MOVE "23" TO LS-RC
    END-IF.

DO-LIST.
    MOVE 0 TO WS-COUNT
    MOVE LS-LOAN TO LI-LOAN-ID
    MOVE 0 TO LI-NUMBER
    START INST-FILE KEY >= LI-KEY
        INVALID KEY MOVE "23" TO LS-RC
    END-START
    IF LS-RC = "00"
        MOVE "N" TO WS-EOF
        PERFORM UNTIL WS-EOF = "Y"
            READ INST-FILE NEXT RECORD
                AT END MOVE "Y" TO WS-EOF
                NOT AT END
                    IF LI-LOAN-ID = LS-LOAN
                        ADD 1 TO WS-COUNT
                        PERFORM SHOW-INST
                    ELSE
                        MOVE "Y" TO WS-EOF
                    END-IF
            END-READ
        END-PERFORM
        DISPLAY "installments=" WS-COUNT
    END-IF.

SHOW-INST.
    MOVE LI-OPEN-BAL TO WS-OP-ED
    MOVE LI-PRINCIPAL TO WS-PR-ED
    MOVE LI-INTEREST TO WS-IN-ED
    MOVE LI-FEES TO WS-FE-ED
    MOVE LI-TOTAL TO WS-TD-ED
    MOVE LI-CLOSE-BAL TO WS-CL-ED
    DISPLAY "installment=" LI-NUMBER
    DISPLAY "due-date=" LI-DUE-DATE
    DISPLAY "opening-balance=" WS-OP-ED
    DISPLAY "principal=" WS-PR-ED
    DISPLAY "interest=" WS-IN-ED
    DISPLAY "fees=" WS-FE-ED
    DISPLAY "total-due=" WS-TD-ED
    DISPLAY "closing-balance=" WS-CL-ED
    DISPLAY "status=" FUNCTION TRIM(LI-STATUS).
