IDENTIFICATION DIVISION.
PROGRAM-ID. BLNISTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT INST-FILE ASSIGN TO WS-INST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS LI-KEY
        FILE STATUS IS WS-INST-ST.

DATA DIVISION.
FILE SECTION.
FD INST-FILE.
01 INST-REC.
   COPY "BLNI".

WORKING-STORAGE SECTION.
01 WS-INST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-INST-ST PIC X(02).

LINKAGE SECTION.
COPY "BLNSTO".
01 BK-LN-INST-REC.
   COPY "BLNI".

PROCEDURE DIVISION USING BK-LN-STO-REQ BK-LN-INST-REC.
    MOVE "00" TO NS-RC
    MOVE SPACES TO NS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-INST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/loaninst.idx"
        DELIMITED SIZE INTO WS-INST-PATH
    PERFORM OPEN-STORE
    IF NS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE NS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO NS-RC
            MOVE "UNKNOWN LOAN INSTALLMENT STORE OP" TO NS-MSG
    END-EVALUATE
    CLOSE INST-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O INST-FILE
    IF WS-INST-ST = "35"
        OPEN OUTPUT INST-FILE
        CLOSE INST-FILE
        OPEN I-O INST-FILE
    END-IF
    IF WS-INST-ST NOT = "00"
        MOVE WS-INST-ST TO NS-RC
        MOVE "CANNOT OPEN LOAN INSTALLMENT INDEX" TO NS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-LN-INST-REC TO INST-REC
    WRITE INST-REC
        INVALID KEY
            MOVE "22" TO NS-RC
            MOVE "LOAN INSTALLMENT ALREADY EXISTS" TO NS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE LI-KEY OF BK-LN-INST-REC TO LI-KEY OF INST-REC
    READ INST-FILE
    IF WS-INST-ST = "00"
        MOVE BK-LN-INST-REC TO INST-REC
        REWRITE INST-REC
    ELSE
        MOVE "23" TO NS-RC
        MOVE "LOAN INSTALLMENT NOT FOUND" TO NS-MSG
    END-IF.

DO-GET.
    MOVE LI-KEY OF BK-LN-INST-REC TO LI-KEY OF INST-REC
    READ INST-FILE
    IF WS-INST-ST = "00"
        MOVE INST-REC TO BK-LN-INST-REC
        MOVE "00" TO NS-RC
    ELSE
        MOVE "23" TO NS-RC
        MOVE "LOAN INSTALLMENT NOT FOUND" TO NS-MSG
    END-IF.
