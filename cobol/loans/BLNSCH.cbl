IDENTIFICATION DIVISION.
PROGRAM-ID. BLNSCH.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BLNSTO".
COPY "BINTP".
COPY "BDATP".
01 WS-HOME PIC X(80).
01 WS-I PIC 9(04).
01 WS-REM PIC S9(15)V99 COMP-3.
01 WS-PER PIC S9(15)V99 COMP-3.
01 WS-PAY PIC S9(15)V99 COMP-3.
01 WS-FACTOR PIC S9(09)V9(06) COMP-3.
01 WS-RATE PIC S9(09)V9(06) COMP-3.
01 WS-PRIN-I PIC S9(15)V99 COMP-3.
01 WS-INT-I PIC S9(15)V99 COMP-3.
01 WS-PREV PIC 9(08).
01 WS-DUE PIC 9(08).
01 WS-DAYS PIC 9(05).
01 BK-LN-REC.
   COPY "BLN".
01 BK-LN-INST.
   COPY "BLNI".

LINKAGE SECTION.
COPY "BLNOP".

PROCEDURE DIVISION USING BK-LN-PARMS.
    MOVE "00" TO CL-RC
    MOVE SPACES TO CL-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CL-RC
        MOVE "CONFIG MISSING" TO CL-MSG
        GOBACK
    END-IF
    PERFORM LOAD-LOAN
    IF CL-RC NOT = "00"
        GOBACK
    END-IF
    IF LN-STATUS NOT = "CON" AND LN-STATUS NOT = "ACT"
        MOVE "20" TO CL-RC
        MOVE "LOAN NOT CONTRACTED" TO CL-MSG
        GOBACK
    END-IF
    IF LN-TERM = 0 OR LN-PRINCIPAL <= 0
        MOVE "20" TO CL-RC
        MOVE "LOAN TERMS INCOMPLETE" TO CL-MSG
        GOBACK
    END-IF
    MOVE LN-PRINCIPAL TO WS-REM
    MOVE LN-EFF-DATE TO WS-PREV
    IF WS-PREV = 0
        MOVE WS-BIZDATE TO WS-PREV
    END-IF
    DIVIDE LN-PRINCIPAL BY LN-TERM GIVING WS-PER ROUNDED
    IF LN-AMORT = "CSPY"
        PERFORM COMPUTE-PAYMENT
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LN-TERM
        PERFORM BUILD-INSTALLMENT
    END-PERFORM
    MOVE LN-TERM TO LN-INSTALLMENTS
    PERFORM SAVE-LOAN
    MOVE LN-TERM TO CL-TERM
    MOVE "SCHEDULE GENERATED" TO CL-MSG.

COMPUTE-PAYMENT.
    COMPUTE WS-RATE = LN-RATE-BPS / 10000
    COMPUTE WS-FACTOR = (1 + WS-RATE) ** LN-TERM
    IF WS-FACTOR > 1
        COMPUTE WS-PAY ROUNDED =
            LN-PRINCIPAL * WS-RATE * WS-FACTOR / (WS-FACTOR - 1)
    END-IF.

BUILD-INSTALLMENT.
    PERFORM DUE-DATE
    PERFORM INTEREST
    IF LN-AMORT = "CSPY"
        COMPUTE WS-PRIN-I = WS-PAY - WS-INT-I
    ELSE
        MOVE WS-PER TO WS-PRIN-I
    END-IF
    IF WS-I = LN-TERM
        MOVE WS-REM TO WS-PRIN-I
    END-IF
    IF WS-PRIN-I > WS-REM
        MOVE WS-REM TO WS-PRIN-I
    END-IF
    IF WS-PRIN-I < 0
        MOVE 0 TO WS-PRIN-I
    END-IF
    MOVE SPACES TO BK-LN-INST
    MOVE LN-ID TO LI-LOAN-ID
    MOVE WS-I TO LI-NUMBER
    MOVE WS-DUE TO LI-DUE-DATE
    MOVE WS-REM TO LI-OPEN-BAL
    MOVE WS-PRIN-I TO LI-PRINCIPAL
    MOVE WS-INT-I TO LI-INTEREST
    MOVE 0 TO LI-FEES
    COMPUTE LI-TOTAL = WS-PRIN-I + WS-INT-I
    MOVE 0 TO LI-PAID-PRIN
    MOVE 0 TO LI-PAID-INT
    MOVE 0 TO LI-PAID-FEE
    COMPUTE LI-CLOSE-BAL = WS-REM - WS-PRIN-I
    MOVE "SC" TO LI-STATUS
    MOVE WS-BIZDATE TO LI-EFF-DATE
    MOVE WS-BIZDATE TO LI-UPDATED
    MOVE 1 TO LI-VERSION
    MOVE "WRITE" TO NS-OP
    CALL "BLNISTO" USING BK-LN-STO-REQ BK-LN-INST
    IF NS-RC = "22"
        MOVE "REWRITE" TO NS-OP
        CALL "BLNISTO" USING BK-LN-STO-REQ BK-LN-INST
    END-IF
    IF NS-RC NOT = "00"
        MOVE NS-RC TO CL-RC
        MOVE NS-MSG TO CL-MSG
    END-IF
    MOVE LI-CLOSE-BAL TO WS-REM
    MOVE WS-DUE TO WS-PREV.

DUE-DATE.
    MOVE "ADD-MONTHS" TO DAT-OP
    MOVE LN-FIRST-DUE TO DAT-DATE
    COMPUTE DAT-MONTHS = WS-I - 1
    CALL "BDAT" USING BK-DAT-PARMS
    MOVE DAT-RESULT TO WS-DUE.

INTEREST.
    MOVE "DIFF-DAYS" TO DAT-OP
    MOVE WS-PREV TO DAT-DATE
    MOVE WS-DUE TO DAT-DATE2
    CALL "BDAT" USING BK-DAT-PARMS
    MOVE DAT-DAYS TO WS-DAYS
    IF WS-DAYS < 1
        MOVE 1 TO WS-DAYS
    END-IF
    MOVE "ACCRUE" TO INT-OP
    MOVE LN-RATE-BPS TO INT-BPS
    MOVE WS-REM TO INT-AMOUNT
    MOVE WS-DAYS TO INT-DAYS
    MOVE LN-BASIS TO INT-BASIS
    CALL "BINT" USING BK-INT-REQ
    IF INT-RC NOT = "00"
        MOVE INT-RC TO CL-RC
        MOVE INT-MSG TO CL-MSG
        MOVE 0 TO WS-INT-I
    ELSE
        MOVE INT-INTEREST TO WS-INT-I
    END-IF.

LOAD-LOAN.
    MOVE SPACES TO BK-LN-REC
    MOVE CL-LOAN-ID TO LN-ID
    MOVE "GET" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE "23" TO CL-RC
        MOVE "LOAN NOT FOUND" TO CL-MSG
    END-IF.

SAVE-LOAN.
    ADD 1 TO LN-VERSION
    MOVE "REWRITE" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE NS-RC TO CL-RC
        MOVE NS-MSG TO CL-MSG
    END-IF.
