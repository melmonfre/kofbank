IDENTIFICATION DIVISION.
PROGRAM-ID. BLNWOF.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BLNSTO".
COPY "BCRSTO".
COPY "BCRENVP".
COPY "BCREXP".
COPY "BTXNLFC".
COPY "BTXNRESP".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "LOANTXN".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-TXNREQ PIC X(24).
01 BK-LN-REC.
   COPY "BLN".

LINKAGE SECTION.
COPY "BLNOP".

PROCEDURE DIVISION USING BK-LN-PARMS.
    MOVE "00" TO CL-RC
    MOVE SPACES TO CL-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CL-RC
        MOVE "CONFIG MISSING" TO CL-MSG
        GOBACK
    END-IF
    MOVE "BEGIN" TO CEN-OP
    MOVE CL-REQUEST TO CEN-REQUEST
    MOVE "LOAN.WRITEOFF" TO CEN-OPERATION
    MOVE CL-OPERATOR TO CEN-OPERATOR
    MOVE CL-CORR TO CEN-CORR
    CALL "BCRENV" USING BK-CR-ENV
    IF CEN-HIT = "Y"
        MOVE CEN-ENTITY TO CL-TXN-ID
        MOVE "00" TO CL-RC
        MOVE CEN-MSG TO CL-MSG
        GOBACK
    END-IF
    IF CEN-RC NOT = "00"
        MOVE CEN-RC TO CL-RC
        MOVE CEN-MSG TO CL-MSG
        GOBACK
    END-IF
    PERFORM DO-WORK
    PERFORM FINISH
    GOBACK.

DO-WORK.
    PERFORM LOAD-LOAN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CL-AMOUNT <= 0
        MOVE "20" TO CL-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    IF CL-AMOUNT > LN-OUTSTANDING
        MOVE "20" TO CL-RC
        MOVE "AMOUNT EXCEEDS OUTSTANDING" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM RUN-TXN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "APPLY-WO" TO CL-OP
    MOVE LN-ID TO CL-LOAN-ID
    MOVE CL-AMOUNT TO CL-AMOUNT
    CALL "BLNUPD" USING BK-LN-PARMS
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "WRITEOFF" TO CE-OP
    MOVE LN-FAC-ID TO CE-FAC-ID
    MOVE CL-AMOUNT TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    MOVE CL-TXN-ID TO CEN-ENTITY
    MOVE "WO" TO CEN-STATUS
    MOVE CL-MSG TO CEN-MSG
    MOVE CL-RC TO CEN-RC
    MOVE CL-AMOUNT TO CEN-AMOUNT
    MOVE LN-CURRENCY TO CEN-CURRENCY
    MOVE "LOAN.WRITEOFF" TO CEN-EVT-PREFIX.

FINISH.
    MOVE CL-RC TO CEN-RC
    MOVE "END" TO CEN-OP
    CALL "BCRENV" USING BK-CR-ENV.

LOAD-LOAN.
    MOVE SPACES TO BK-LN-REC
    MOVE CL-LOAN-ID TO LN-ID
    MOVE "GET" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE "20" TO CL-RC
        MOVE "LOAN NOT FOUND" TO CL-MSG
    END-IF.

RUN-TXN.
    MOVE "CREATE" TO LFC-OP
    PERFORM DO-TXN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "AUTHORIZE" TO LFC-OP
    PERFORM DO-TXN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "POST" TO LFC-OP
    PERFORM DO-TXN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SETTLE" TO LFC-OP
    PERFORM DO-TXN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE TXR-ID TO CL-TXN-ID
    MOVE "WRITTEN OFF" TO CL-MSG.

DO-TXN.
    IF LFC-OP = "CREATE"
        CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
        MOVE WS-SEQ TO WS-ID-NUM
        MOVE WS-ID-NUM TO WS-ID-ED
        MOVE SPACES TO WS-TXNREQ
        STRING "TX" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
            INTO WS-TXNREQ
        END-STRING
    ELSE
        MOVE SPACES TO WS-TXNREQ
    END-IF
    MOVE "CREDWOFF" TO LFC-TYPE
    MOVE SPACES TO LFC-SRC
    MOVE SPACES TO LFC-DST
    MOVE CL-AMOUNT TO LFC-AMOUNT
    MOVE LN-CURRENCY TO LFC-CURRENCY
    MOVE "LOAN WRITE OFF" TO LFC-DESCR
    MOVE CL-OPERATOR TO LFC-OPERATOR
    MOVE CL-CORR TO LFC-CORR
    MOVE WS-TXNREQ TO LFC-REQUEST
    MOVE LN-FAC-ID TO LFC-FACILITY
    MOVE 0 TO LFC-PRINCIPAL
    MOVE 0 TO LFC-INTEREST
    MOVE 0 TO LFC-FEE-AMT
    MOVE LN-ID TO LFC-REF
    MOVE TXR-ID TO LFC-TXN-ID
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    IF TXR-RC NOT = "00"
        MOVE TXR-RC TO CL-RC
        MOVE TXR-MSG TO CL-MSG
    END-IF.
