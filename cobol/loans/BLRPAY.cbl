IDENTIFICATION DIVISION.
PROGRAM-ID. BLRPAY.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BLNSTO".
COPY "BCRSTO".
COPY "BCRENVP".
COPY "BCREXP".
COPY "BTXNLFC".
COPY "BTXNRESP".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "LOANTXN".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-TXNREQ PIC X(24).
01 WS-INST PIC 9(04).
01 WS-REMAIN PIC S9(15)V99 COMP-3.
01 WS-OUT-LEFT PIC S9(15)V99 COMP-3.
01 WS-DUE-FEE PIC S9(15)V99 COMP-3.
01 WS-DUE-INT PIC S9(15)V99 COMP-3.
01 WS-DUE-PRIN PIC S9(15)V99 COMP-3.
01 WS-TF PIC S9(15)V99 COMP-3.
01 WS-TI PIC S9(15)V99 COMP-3.
01 WS-TP PIC S9(15)V99 COMP-3.
01 WS-TAKE PIC S9(15)V99 COMP-3.
01 WS-PAID PIC S9(15)V99 COMP-3.
01 WS-ORD PIC X(16).
01 WS-DONE PIC X(01).
01 WS-I PIC 9(04).
01 WS-N-PLAN PIC 9(04) VALUE 0.
01 WS-PLAN-MAX PIC 9(04) VALUE 200.
01 WS-PLAN.
   05 WS-P-ROW OCCURS 200 TIMES.
      10 WS-P-INST PIC 9(04).
      10 WS-P-FEE PIC S9(15)V99 COMP-3.
      10 WS-P-INT PIC S9(15)V99 COMP-3.
      10 WS-P-PRIN PIC S9(15)V99 COMP-3.
01 BK-LN-REC.
   COPY "BLN".
01 BK-LN-INST.
   COPY "BLNI".

LINKAGE SECTION.
COPY "BLNOP".

PROCEDURE DIVISION USING BK-LN-PARMS.
    MOVE "00" TO CL-RC
    MOVE SPACES TO CL-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CL-RC
        MOVE "CONFIG MISSING" TO CL-MSG
        GOBACK
    END-IF
    MOVE "BEGIN" TO CEN-OP
    MOVE CL-REQUEST TO CEN-REQUEST
    MOVE "LOAN.REPAY" TO CEN-OPERATION
    MOVE CL-OPERATOR TO CEN-OPERATOR
    MOVE CL-CORR TO CEN-CORR
    CALL "BCRENV" USING BK-CR-ENV
    IF CEN-HIT = "Y"
        MOVE CEN-ENTITY TO CL-TXN-ID
        MOVE "00" TO CL-RC
        MOVE CEN-MSG TO CL-MSG
        GOBACK
    END-IF
    IF CEN-RC NOT = "00"
        MOVE CEN-RC TO CL-RC
        MOVE CEN-MSG TO CL-MSG
        GOBACK
    END-IF
    PERFORM DO-WORK
    PERFORM FINISH
    GOBACK.

DO-WORK.
    PERFORM LOAD-LOAN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CL-AMOUNT <= 0
        MOVE "20" TO CL-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    IF LN-STATUS = "CLO" OR LN-STATUS = "CAN" OR LN-STATUS = "SET"
        MOVE "20" TO CL-RC
        MOVE "LOAN NOT REPAYABLE" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE LN-ALLOC-ORDER TO WS-ORD
    IF WS-ORD = SPACES
        MOVE "20" TO CL-RC
        MOVE "ALLOCATION ORDER UNDEFINED" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CL-AMOUNT TO WS-REMAIN
    MOVE LN-OUTSTANDING TO WS-OUT-LEFT
    MOVE 0 TO CL-FEES
    MOVE 0 TO CL-INTEREST
    MOVE 0 TO CL-PRINCIPAL
    MOVE 0 TO WS-N-PLAN
    PERFORM PLAN-ALLOCATE
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    COMPUTE CL-EXCESS = WS-REMAIN
    IF CL-EXCESS < 0
        MOVE 0 TO CL-EXCESS
    END-IF
    COMPUTE WS-TAKE = CL-FEES + CL-INTEREST + CL-PRINCIPAL
    IF WS-TAKE <= 0
        MOVE "20" TO CL-RC
        MOVE "NOTHING TO ALLOCATE" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM RUN-TXN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM APPLY-PLAN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM EXPOSE-PLAN
    MOVE "APPLY-PAY" TO CL-OP
    MOVE LN-ID TO CL-LOAN-ID
    MOVE CL-PRINCIPAL TO CL-AMOUNT
    CALL "BLNUPD" USING BK-LN-PARMS
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "REPAY" TO CE-OP
    MOVE LN-FAC-ID TO CE-FAC-ID
    MOVE CL-PRINCIPAL TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    MOVE CL-TXN-ID TO CEN-ENTITY
    MOVE "PA" TO CEN-STATUS
    MOVE CL-MSG TO CEN-MSG
    MOVE CL-RC TO CEN-RC
    MOVE WS-TAKE TO CEN-AMOUNT
    MOVE LN-CURRENCY TO CEN-CURRENCY
    MOVE "LOAN.REPAYMENT" TO CEN-EVT-PREFIX.

FINISH.
    MOVE CL-RC TO CEN-RC
    MOVE "END" TO CEN-OP
    CALL "BCRENV" USING BK-CR-ENV.

LOAD-LOAN.
    MOVE SPACES TO BK-LN-REC
    MOVE CL-LOAN-ID TO LN-ID
    MOVE "GET" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE "23" TO CL-RC
        MOVE "LOAN NOT FOUND" TO CL-MSG
    END-IF.

PLAN-ALLOCATE.
    MOVE "N" TO WS-DONE
    PERFORM VARYING WS-INST FROM 1 BY 1 UNTIL WS-INST > LN-TERM
        IF WS-DONE = "N"
            PERFORM PLAN-ONE
        END-IF
    END-PERFORM.

PLAN-ONE.
    MOVE SPACES TO BK-LN-INST
    MOVE LN-ID TO LI-LOAN-ID
    MOVE WS-INST TO LI-NUMBER
    MOVE "GET" TO NS-OP
    CALL "BLNISTO" USING BK-LN-STO-REQ BK-LN-INST
    IF NS-RC NOT = "00"
        MOVE "Y" TO WS-DONE
        EXIT PARAGRAPH
    END-IF
    IF LI-STATUS = "PA"
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-DUE-FEE = LI-FEES - LI-PAID-FEE
    COMPUTE WS-DUE-INT = LI-INTEREST - LI-PAID-INT
    COMPUTE WS-DUE-PRIN = LI-PRINCIPAL - LI-PAID-PRIN
    MOVE 0 TO WS-TF
    MOVE 0 TO WS-TI
    MOVE 0 TO WS-TP
    PERFORM ALLOCATE-ORDER
    IF WS-TF = 0 AND WS-TI = 0 AND WS-TP = 0
        EXIT PARAGRAPH
    END-IF
    ADD WS-TF TO CL-FEES
    ADD WS-TI TO CL-INTEREST
    ADD WS-TP TO CL-PRINCIPAL
    IF WS-N-PLAN < WS-PLAN-MAX
        ADD 1 TO WS-N-PLAN
        MOVE WS-INST TO WS-P-INST(WS-N-PLAN)
        MOVE WS-TF TO WS-P-FEE(WS-N-PLAN)
        MOVE WS-TI TO WS-P-INT(WS-N-PLAN)
        MOVE WS-TP TO WS-P-PRIN(WS-N-PLAN)
    END-IF
    IF WS-REMAIN <= 0
        MOVE "Y" TO WS-DONE
    END-IF.

ALLOCATE-ORDER.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 16
        IF WS-REMAIN > 0
            PERFORM TAKE-BY-CODE
        END-IF
    END-PERFORM.

TAKE-BY-CODE.
    EVALUATE WS-ORD(WS-I:1)
        WHEN "F" PERFORM TAKE-FEE
        WHEN "I" PERFORM TAKE-INT
        WHEN "P" PERFORM TAKE-PRIN
    END-EVALUATE.

TAKE-FEE.
    IF WS-REMAIN <= 0 OR WS-DUE-FEE <= 0
        EXIT PARAGRAPH
    END-IF
    IF WS-REMAIN < WS-DUE-FEE
        MOVE WS-REMAIN TO WS-TF
    ELSE
        MOVE WS-DUE-FEE TO WS-TF
    END-IF
    SUBTRACT WS-TF FROM WS-REMAIN.

TAKE-INT.
    IF WS-REMAIN <= 0 OR WS-DUE-INT <= 0
        EXIT PARAGRAPH
    END-IF
    IF WS-REMAIN < WS-DUE-INT
        MOVE WS-REMAIN TO WS-TI
    ELSE
        MOVE WS-DUE-INT TO WS-TI
    END-IF
    SUBTRACT WS-TI FROM WS-REMAIN.

TAKE-PRIN.
    IF WS-REMAIN <= 0 OR WS-DUE-PRIN <= 0 OR WS-OUT-LEFT <= 0
        EXIT PARAGRAPH
    END-IF
    IF WS-DUE-PRIN > WS-OUT-LEFT
        MOVE WS-OUT-LEFT TO WS-DUE-PRIN
    END-IF
    IF WS-REMAIN < WS-DUE-PRIN
        MOVE WS-REMAIN TO WS-TP
    ELSE
        MOVE WS-DUE-PRIN TO WS-TP
    END-IF
    SUBTRACT WS-TP FROM WS-REMAIN
    SUBTRACT WS-TP FROM WS-OUT-LEFT.

APPLY-PLAN.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-PLAN
        MOVE SPACES TO BK-LN-INST
        MOVE LN-ID TO LI-LOAN-ID
        MOVE WS-P-INST(WS-I) TO LI-NUMBER
        MOVE "GET" TO NS-OP
        CALL "BLNISTO" USING BK-LN-STO-REQ BK-LN-INST
        IF NS-RC NOT = "00"
            MOVE NS-RC TO CL-RC
            MOVE "INSTALLMENT NOT FOUND" TO CL-MSG
            EXIT PERFORM
        END-IF
        ADD WS-P-FEE(WS-I) TO LI-PAID-FEE
        ADD WS-P-INT(WS-I) TO LI-PAID-INT
        ADD WS-P-PRIN(WS-I) TO LI-PAID-PRIN
        PERFORM SET-STATUS
        MOVE WS-BIZDATE TO LI-UPDATED
        ADD 1 TO LI-VERSION
        MOVE "REWRITE" TO NS-OP
        CALL "BLNISTO" USING BK-LN-STO-REQ BK-LN-INST
        IF NS-RC NOT = "00"
            MOVE NS-RC TO CL-RC
            MOVE NS-MSG TO CL-MSG
            EXIT PERFORM
        END-IF
    END-PERFORM.

SET-STATUS.
    COMPUTE WS-PAID = LI-PAID-FEE + LI-PAID-INT + LI-PAID-PRIN
    IF WS-PAID >= LI-TOTAL
        MOVE "PA" TO LI-STATUS
    ELSE
        IF WS-PAID > 0
            MOVE "PT" TO LI-STATUS
        ELSE
            MOVE "SC" TO LI-STATUS
        END-IF
    END-IF.

EXPOSE-PLAN.
    MOVE WS-N-PLAN TO CL-PLAN-N
    IF CL-PLAN-N > 40
        MOVE 40 TO CL-PLAN-N
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CL-PLAN-N
        MOVE WS-P-INST(WS-I) TO CL-P-INST(WS-I)
        MOVE WS-P-FEE(WS-I) TO CL-P-FEE(WS-I)
        MOVE WS-P-INT(WS-I) TO CL-P-INT(WS-I)
        MOVE WS-P-PRIN(WS-I) TO CL-P-PRIN(WS-I)
    END-PERFORM.

RUN-TXN.
    MOVE "CREATE" TO LFC-OP
    PERFORM DO-TXN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "AUTHORIZE" TO LFC-OP
    PERFORM DO-TXN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "POST" TO LFC-OP
    PERFORM DO-TXN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SETTLE" TO LFC-OP
    PERFORM DO-TXN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE TXR-ID TO CL-TXN-ID
    MOVE "REPAID" TO CL-MSG.

DO-TXN.
    IF LFC-OP = "CREATE"
        CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
        MOVE WS-SEQ TO WS-ID-NUM
        MOVE WS-ID-NUM TO WS-ID-ED
        MOVE SPACES TO WS-TXNREQ
        STRING "TX" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
            INTO WS-TXNREQ
        END-STRING
    ELSE
        MOVE SPACES TO WS-TXNREQ
    END-IF
    MOVE "CREDREPY" TO LFC-TYPE
    MOVE LN-ACCOUNT TO LFC-SRC
    MOVE SPACES TO LFC-DST
    COMPUTE LFC-AMOUNT = CL-FEES + CL-INTEREST + CL-PRINCIPAL
    MOVE LN-CURRENCY TO LFC-CURRENCY
    MOVE "LOAN REPAYMENT" TO LFC-DESCR
    MOVE CL-OPERATOR TO LFC-OPERATOR
    MOVE CL-CORR TO LFC-CORR
    MOVE WS-TXNREQ TO LFC-REQUEST
    MOVE LN-FAC-ID TO LFC-FACILITY
    MOVE CL-PRINCIPAL TO LFC-PRINCIPAL
    MOVE CL-INTEREST TO LFC-INTEREST
    MOVE CL-FEES TO LFC-FEE-AMT
    MOVE LN-ID TO LFC-REF
    MOVE TXR-ID TO LFC-TXN-ID
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    IF TXR-RC NOT = "00"
        MOVE TXR-RC TO CL-RC
        MOVE TXR-MSG TO CL-MSG
    END-IF.
