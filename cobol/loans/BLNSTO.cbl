IDENTIFICATION DIVISION.
PROGRAM-ID. BLNSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT LOAN-FILE ASSIGN TO WS-LOAN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS LN-ID
        FILE STATUS IS WS-LOAN-ST.

DATA DIVISION.
FILE SECTION.
FD LOAN-FILE.
01 LOAN-REC.
   COPY "BLN".

WORKING-STORAGE SECTION.
01 WS-LOAN-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-LOAN-ST PIC X(02).

LINKAGE SECTION.
COPY "BLNSTO".
01 BK-LN-REC.
   COPY "BLN".

PROCEDURE DIVISION USING BK-LN-STO-REQ BK-LN-REC.
    MOVE "00" TO NS-RC
    MOVE SPACES TO NS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-LOAN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/loans.idx"
        DELIMITED SIZE INTO WS-LOAN-PATH
    PERFORM OPEN-STORE
    IF NS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE NS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO NS-RC
            MOVE "UNKNOWN LOAN STORE OP" TO NS-MSG
    END-EVALUATE
    CLOSE LOAN-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O LOAN-FILE
    IF WS-LOAN-ST = "35"
        OPEN OUTPUT LOAN-FILE
        CLOSE LOAN-FILE
        OPEN I-O LOAN-FILE
    END-IF
    IF WS-LOAN-ST NOT = "00"
        MOVE WS-LOAN-ST TO NS-RC
        MOVE "CANNOT OPEN LOAN INDEX" TO NS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-LN-REC TO LOAN-REC
    WRITE LOAN-REC
        INVALID KEY
            MOVE "22" TO NS-RC
            MOVE "LOAN ALREADY EXISTS" TO NS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE LN-ID OF BK-LN-REC TO LN-ID OF LOAN-REC
    READ LOAN-FILE
    IF WS-LOAN-ST = "00"
        MOVE BK-LN-REC TO LOAN-REC
        REWRITE LOAN-REC
    ELSE
        MOVE "23" TO NS-RC
        MOVE "LOAN NOT FOUND" TO NS-MSG
    END-IF.

DO-GET.
    MOVE LN-ID OF BK-LN-REC TO LN-ID OF LOAN-REC
    READ LOAN-FILE
    IF WS-LOAN-ST = "00"
        MOVE LOAN-REC TO BK-LN-REC
        MOVE "00" TO NS-RC
    ELSE
        MOVE "23" TO NS-RC
        MOVE "LOAN NOT FOUND" TO NS-MSG
    END-IF.
