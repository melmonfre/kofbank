IDENTIFICATION DIVISION.
PROGRAM-ID. BLNQ.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT LOAN-FILE ASSIGN TO WS-LOAN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS LN-ID
        FILE STATUS IS WS-LOAN-ST.

DATA DIVISION.
FILE SECTION.
FD LOAN-FILE.
01 LOAN-REC.
   COPY "BLN".

WORKING-STORAGE SECTION.
01 WS-LOAN-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-LOAN-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-ED1 PIC -(15)9.99.
01 WS-ED2 PIC -(15)9.99.
01 WS-ED3 PIC -(15)9.99.
01 WS-ED4 PIC -(15)9.99.
01 WS-ED5 PIC -(15)9.99.
01 WS-ED6 PIC -(15)9.99.
01 WS-ED7 PIC -(15)9.99.

LINKAGE SECTION.
01 LS-OP PIC X(08).
01 LS-ID PIC X(12).
01 BK-LN-REC.
   COPY "BLN".
01 LS-RC PIC X(02).

PROCEDURE DIVISION USING LS-OP LS-ID BK-LN-REC LS-RC.
    MOVE "00" TO LS-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-LOAN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/loans.idx"
        DELIMITED SIZE INTO WS-LOAN-PATH
    OPEN INPUT LOAN-FILE
    IF WS-LOAN-ST NOT = "00"
        MOVE "35" TO LS-RC
        GOBACK
    END-IF
    EVALUATE LS-OP
        WHEN "GET" PERFORM DO-GET
        WHEN "LIST" PERFORM DO-LIST
        WHEN OTHER MOVE "99" TO LS-RC
    END-EVALUATE
    CLOSE LOAN-FILE
    GOBACK.

DO-GET.
    MOVE LS-ID TO LN-ID OF LOAN-REC
    READ LOAN-FILE
    IF WS-LOAN-ST = "00"
        MOVE LOAN-REC TO BK-LN-REC
        PERFORM SHOW-LOAN
    ELSE
        MOVE "23" TO LS-RC
    END-IF.

DO-LIST.
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ LOAN-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM SHOW-LOAN
        END-READ
    END-PERFORM.

SHOW-LOAN.
    MOVE LOAN-REC TO BK-LN-REC
    MOVE LN-PRINCIPAL OF BK-LN-REC TO WS-ED1
    MOVE LN-DISBURSED OF BK-LN-REC TO WS-ED2
    MOVE LN-PRINCIPAL-PAID OF BK-LN-REC TO WS-ED3
    MOVE LN-OUTSTANDING OF BK-LN-REC TO WS-ED4
    MOVE LN-OVERDUE-PRIN OF BK-LN-REC TO WS-ED5
    MOVE LN-PRINCIPAL-WO OF BK-LN-REC TO WS-ED6
    DISPLAY "loan=" FUNCTION TRIM(LN-ID OF BK-LN-REC)
    DISPLAY "status=" FUNCTION TRIM(LN-STATUS OF BK-LN-REC)
    DISPLAY "customer=" FUNCTION TRIM(LN-CUST-ID OF BK-LN-REC)
    DISPLAY "facility=" FUNCTION TRIM(LN-FAC-ID OF BK-LN-REC)
    DISPLAY "product=" FUNCTION TRIM(LN-PRODUCT OF BK-LN-REC)
    DISPLAY "account=" FUNCTION TRIM(LN-ACCOUNT OF BK-LN-REC)
    DISPLAY "currency=" FUNCTION TRIM(LN-CURRENCY OF BK-LN-REC)
    DISPLAY "principal=" WS-ED1
    DISPLAY "disbursed=" WS-ED2
    DISPLAY "principal-paid=" WS-ED3
    DISPLAY "outstanding=" WS-ED4
    DISPLAY "overdue-principal=" WS-ED5
    DISPLAY "written-off=" WS-ED6
    DISPLAY "term=" LN-TERM OF BK-LN-REC
    DISPLAY "rate-bps=" LN-RATE-BPS OF BK-LN-REC
    DISPLAY "amort=" FUNCTION TRIM(LN-AMORT OF BK-LN-REC)
    DISPLAY "freq=" LN-FREQ OF BK-LN-REC
    DISPLAY "first-due=" LN-FIRST-DUE OF BK-LN-REC
    DISPLAY "maturity=" LN-MATURITY OF BK-LN-REC
    DISPLAY "disbursed-date=" LN-DISB-DATE OF BK-LN-REC
    DISPLAY "disbursed-txn=" FUNCTION TRIM(LN-DISB-TXN OF BK-LN-REC)
    DISPLAY "installments=" LN-INSTALLMENTS OF BK-LN-REC
    DISPLAY "version=" LN-VERSION OF BK-LN-REC.
