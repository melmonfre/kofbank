IDENTIFICATION DIVISION.
PROGRAM-ID. BLN.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BLNSTO".
COPY "BCRSTO".
COPY "BCRENVP".
COPY "BCREXP".
COPY "BPRODO".
COPY "BDATP".
01 WS-HOME PIC X(80).
01 WS-ACTION PIC X(12).
01 WS-NEXT PIC X(04).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "LOAN".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-AVAIL PIC S9(15)V99 COMP-3.
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 BK-LN-REC.
   COPY "BLN".
01 BK-CR-FAC.
   COPY "BCRF".

LINKAGE SECTION.
COPY "BLNOP".

PROCEDURE DIVISION USING BK-LN-PARMS.
    MOVE "00" TO CL-RC
    MOVE SPACES TO CL-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CL-RC
        MOVE "CONFIG MISSING" TO CL-MSG
        GOBACK
    END-IF
    MOVE "BEGIN" TO CEN-OP
    MOVE CL-REQUEST TO CEN-REQUEST
    MOVE "LOAN" TO CEN-OPERATION
    MOVE CL-OPERATOR TO CEN-OPERATOR
    MOVE CL-CORR TO CEN-CORR
    CALL "BCRENV" USING BK-CR-ENV
    IF CEN-HIT = "Y"
        MOVE CEN-ENTITY TO CL-LOAN-ID
        MOVE "00" TO CL-RC
        MOVE CEN-MSG TO CL-MSG
        GOBACK
    END-IF
    IF CEN-RC NOT = "00"
        MOVE CEN-RC TO CL-RC
        MOVE CEN-MSG TO CL-MSG
        GOBACK
    END-IF
    PERFORM DO-WORK
    PERFORM FINISH
    GOBACK.

DO-WORK.
    EVALUATE CL-OP
        WHEN "CREATE" PERFORM DO-CREATE
        WHEN "APPROVE" PERFORM DO-ACTION
        WHEN "CONTRACT" PERFORM DO-ACTION
        WHEN "ACTIVATE" PERFORM DO-ACTION
        WHEN "SUSPEND" PERFORM DO-ACTION
        WHEN "RESUME" PERFORM DO-ACTION
        WHEN "DELINQUENT" PERFORM DO-ACTION
        WHEN "DEFAULT" PERFORM DO-ACTION
        WHEN "MATURE" PERFORM DO-ACTION
        WHEN "SETTLE" PERFORM DO-ACTION
        WHEN "CLOSE" PERFORM DO-ACTION
        WHEN "CANCEL" PERFORM DO-ACTION
        WHEN "RESTRUCTURE" PERFORM DO-ACTION
        WHEN OTHER
            MOVE "99" TO CL-RC
            MOVE "UNKNOWN LOAN OP" TO CL-MSG
    END-EVALUATE
    MOVE CL-LOAN-ID TO CEN-ENTITY
    MOVE CL-STATUS TO CEN-STATUS
    MOVE CL-MSG TO CEN-MSG
    MOVE CL-PRINCIPAL TO CEN-AMOUNT
    MOVE "LOAN" TO CEN-EVT-PREFIX.

FINISH.
    MOVE CL-RC TO CEN-RC
    MOVE "END" TO CEN-OP
    CALL "BCRENV" USING BK-CR-ENV.

DO-CREATE.
    IF CL-FAC-ID = SPACES
        MOVE "20" TO CL-RC
        MOVE "FACILITY REQUIRED" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM LOAD-FACILITY
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CRF-STATUS NOT = "ACT"
        MOVE "20" TO CL-RC
        MOVE "CREDIT FACILITY NOT ACTIVE" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM LOAD-PRODUCT
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM RESOLVE-TERMS
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-FACILITY-LIMIT
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-LN-REC
    PERFORM BUILD-ID
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CL-LOAN-ID TO LN-ID
    MOVE CRF-CUST-ID TO LN-CUST-ID
    MOVE CRF-ID TO LN-FAC-ID
    MOVE CRF-PRODUCT TO LN-PRODUCT
    MOVE CRF-ACCOUNT TO LN-ACCOUNT
    MOVE "REQ" TO LN-STATUS
    MOVE CRF-CURRENCY TO LN-CURRENCY
    MOVE CL-PRINCIPAL TO LN-PRINCIPAL
    MOVE 0 TO LN-DISBURSED
    MOVE 0 TO LN-PRINCIPAL-PAID
    MOVE 0 TO LN-PRINCIPAL-WO
    MOVE 0 TO LN-OUTSTANDING
    MOVE 0 TO LN-OVERDUE-PRIN
    MOVE CL-TERM TO LN-TERM
    MOVE CRF-BASIS TO LN-BASIS
    MOVE CRF-RATE-BPS TO LN-RATE-BPS
    MOVE CL-AMORT TO LN-AMORT
    MOVE CL-FREQ TO LN-FREQ
    MOVE PR-ALLOC-ORDER TO LN-ALLOC-ORDER
    MOVE WS-BIZDATE TO LN-CONTRACT-DATE
    MOVE WS-BIZDATE TO LN-EFF-DATE
    MOVE 0 TO LN-FIRST-DUE
    MOVE 0 TO LN-MATURITY
    MOVE 0 TO LN-DISB-DATE
    MOVE SPACES TO LN-DISB-TXN
    MOVE 0 TO LN-INSTALLMENTS
    MOVE SPACES TO LN-REASON
    MOVE WS-BIZDATE TO LN-CREATED
    MOVE WS-BIZDATE TO LN-UPDATED
    MOVE 1 TO LN-VERSION
    MOVE "WRITE" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE NS-RC TO CL-RC
        MOVE NS-MSG TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "REQ" TO CL-STATUS
    MOVE "ORIGINATED" TO CL-MSG.

DO-ACTION.
    MOVE CL-OP TO WS-ACTION
    PERFORM LOAD-LOAN
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF WS-ACTION = "ACTIVATE"
        PERFORM CHECK-ACTIVATE
    END-IF
    IF WS-ACTION = "MATURE" OR WS-ACTION = "SETTLE"
        OR WS-ACTION = "CLOSE"
        PERFORM CHECK-OUTSTANDING
    END-IF
    IF WS-ACTION = "CANCEL" OR WS-ACTION = "DEFAULT"
        OR WS-ACTION = "RESTRUCTURE"
        MOVE CL-REASON TO LN-REASON
    END-IF
    IF CL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    CALL "BLNST" USING LN-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE "20" TO CL-RC
        MOVE WS-STT-MSG TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NEXT TO LN-STATUS
    IF WS-ACTION = "CONTRACT"
        MOVE WS-BIZDATE TO LN-CONTRACT-DATE
        PERFORM SET-MATURITY
    END-IF
    PERFORM SAVE-LOAN
    MOVE WS-ACTION TO CL-MSG.

LOAD-FACILITY.
    MOVE SPACES TO BK-CR-FAC
    MOVE CL-FAC-ID TO CRF-ID
    MOVE "GET" TO CS-OP
    CALL "BCRFSTO" USING BK-CR-STO-REQ BK-CR-FAC
    IF CS-RC NOT = "00"
        MOVE "20" TO CL-RC
        MOVE "CREDIT FACILITY NOT FOUND" TO CL-MSG
    END-IF.

LOAD-PRODUCT.
    CALL "BPRODQ" USING CRF-PRODUCT WS-BIZDATE BK-PROD-OUT
    IF PQ-RC NOT = "00"
        MOVE "20" TO CL-RC
        MOVE "CREDIT PRODUCT NOT FOUND" TO CL-MSG
    END-IF.

RESOLVE-TERMS.
    IF CL-PRINCIPAL <= 0
        MOVE CRF-CONTRACTED TO CL-PRINCIPAL
    END-IF
    IF CL-PRINCIPAL <= 0
        MOVE "20" TO CL-RC
        MOVE "PRINCIPAL REQUIRED" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    IF CL-TERM = 0
        MOVE CRF-TERM TO CL-TERM
    END-IF
    IF CL-TERM = 0
        MOVE "20" TO CL-RC
        MOVE "TERM REQUIRED" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    IF CL-AMORT = SPACES
        MOVE PR-AMORT TO CL-AMORT
    END-IF
    IF CL-AMORT = SPACES
        MOVE "CSPR" TO CL-AMORT
    END-IF
    IF CL-FREQ = 0
        MOVE PR-FREQ TO CL-FREQ
    END-IF
    IF CL-FREQ = 0
        MOVE 1 TO CL-FREQ
    END-IF
    IF CL-AMORT NOT = "CSPR" AND CL-AMORT NOT = "CSPY"
        MOVE "20" TO CL-RC
        MOVE "UNSUPPORTED AMORTIZATION" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    IF CL-FREQ NOT = 1
        MOVE "20" TO CL-RC
        MOVE "UNSUPPORTED PAYMENT FREQUENCY" TO CL-MSG
    END-IF.

CHECK-FACILITY-LIMIT.
    MOVE "GET" TO CE-OP
    MOVE CRF-ID TO CE-FAC-ID
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        MOVE "20" TO CL-RC
        MOVE "FACILITY EXPOSURE NOT FOUND" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-AVAIL = CE-CONTRACTED - CE-PRINCIPAL
    IF WS-AVAIL < 0
        MOVE 0 TO WS-AVAIL
    END-IF
    IF CL-PRINCIPAL > WS-AVAIL
        MOVE "20" TO CL-RC
        MOVE "PRINCIPAL EXCEEDS AVAILABLE CREDIT" TO CL-MSG
    END-IF.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CL-RC
        MOVE "SEQUENCE ERROR" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CL-LOAN-ID
    STRING "N" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CL-LOAN-ID
    END-STRING.

LOAD-LOAN.
    MOVE SPACES TO BK-LN-REC
    MOVE CL-LOAN-ID TO LN-ID
    MOVE "GET" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE "23" TO CL-RC
        MOVE "LOAN NOT FOUND" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE LN-ID TO CL-LOAN-ID
    MOVE LN-STATUS TO CL-STATUS.

CHECK-ACTIVATE.
    IF LN-PRINCIPAL <= 0 OR LN-TERM = 0
        MOVE "20" TO CL-RC
        MOVE "LOAN TERMS INCOMPLETE" TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    IF LN-MATURITY = 0
        MOVE "20" TO CL-RC
        MOVE "LOAN NOT CONTRACTED" TO CL-MSG
    END-IF.

CHECK-OUTSTANDING.
    MOVE "GET" TO CL-OP
    MOVE LN-ID TO CL-LOAN-ID
    CALL "BLNUPD" USING BK-LN-PARMS
    MOVE "00" TO CL-RC
    IF CL-AMOUNT > 0
        MOVE "20" TO CL-RC
        MOVE "OUTSTANDING PRINCIPAL" TO CL-MSG
    END-IF
    MOVE LN-STATUS TO CL-STATUS.

SET-MATURITY.
    IF CL-FIRST-DUE = 0
        MOVE "ADD-MONTHS" TO DAT-OP
        MOVE WS-BIZDATE TO DAT-DATE
        MOVE 1 TO DAT-MONTHS
        CALL "BDAT" USING BK-DAT-PARMS
        MOVE DAT-RESULT TO CL-FIRST-DUE
    END-IF
    MOVE CL-FIRST-DUE TO LN-FIRST-DUE
    MOVE "ADD-MONTHS" TO DAT-OP
    MOVE CL-FIRST-DUE TO DAT-DATE
    COMPUTE DAT-MONTHS = LN-TERM - 1
    CALL "BDAT" USING BK-DAT-PARMS
    MOVE DAT-RESULT TO LN-MATURITY.

SAVE-LOAN.
    MOVE WS-BIZDATE TO LN-UPDATED
    ADD 1 TO LN-VERSION
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE NS-RC TO CL-RC
        MOVE NS-MSG TO CL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE LN-ID TO CL-LOAN-ID
    MOVE LN-STATUS TO CL-STATUS.

COMPUTE-HASH.
    MOVE LN-PRINCIPAL TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(LN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(LN-CUST-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(LN-FAC-ID) DELIMITED SIZE "|" DELIMITED SIZE
        LN-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        LN-VERSION DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO LN-HASH.
