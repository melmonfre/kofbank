IDENTIFICATION DIVISION.
PROGRAM-ID. BLNCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(24).
01 WS-A PIC X(24).
01 WS-B PIC X(24).
01 WS-C PIC X(24).
01 WS-D PIC X(24).
01 WS-E PIC X(24).
01 WS-F PIC X(24).
01 WS-G PIC X(24).
01 WS-H PIC X(24).
01 WS-I PIC X(24).
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT2 PIC S9(15)V99 COMP-3.
01 WS-ACT PIC X(12).
01 WS-NUM PIC 9(04).
01 WS-QOP PIC X(08).
01 WS-QRC PIC X(02).
COPY "BLNOP".
01 WS-LN-REC.
   COPY "BLN".
COPY "BCREXP".

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "create" PERFORM DO-CREATE
        WHEN "approve" PERFORM DO-ACTION
        WHEN "contract" PERFORM DO-ACTION
        WHEN "activate" PERFORM DO-ACTION
        WHEN "suspend" PERFORM DO-ACTION
        WHEN "resume" PERFORM DO-ACTION
        WHEN "delinquent" PERFORM DO-ACTION
        WHEN "default" PERFORM DO-ACTION
        WHEN "mature" PERFORM DO-ACTION
        WHEN "settle" PERFORM DO-ACTION
        WHEN "close" PERFORM DO-ACTION
        WHEN "cancel" PERFORM DO-ACTION
        WHEN "restructure" PERFORM DO-ACTION
        WHEN "schedule" PERFORM DO-SCHEDULE
        WHEN "disburse" PERFORM DO-DISBURSE
        WHEN "repay" PERFORM DO-REPAY
        WHEN "writeoff" PERFORM DO-WRITEOFF
        WHEN "get" PERFORM DO-GET
        WHEN "list" PERFORM DO-LIST
        WHEN "installment.get" PERFORM DO-INST-GET
        WHEN "installment.list" PERFORM DO-INST-LIST
        WHEN "exposure" PERFORM DO-EXPOSURE
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN LOAN OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H WS-I
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H WS-I
    END-UNSTRING.

DO-CREATE.
    MOVE WS-A TO CL-FAC-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CL-PRINCIPAL
    MOVE WS-C TO CL-TERM
    MOVE WS-D TO CL-AMORT
    MOVE WS-E TO CL-FREQ
    MOVE WS-F TO CL-OPERATOR
    MOVE WS-G TO CL-CORR
    MOVE WS-H TO CL-REQUEST
    MOVE "CREATE" TO CL-OP
    CALL "BLN" USING BK-LN-PARMS
    DISPLAY "rc=" CL-RC
    DISPLAY "loan=" FUNCTION TRIM(CL-LOAN-ID)
    DISPLAY "status=" FUNCTION TRIM(CL-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(CL-MSG).

DO-ACTION.
    MOVE WS-A TO CL-LOAN-ID
    MOVE WS-B TO CL-REASON
    MOVE WS-C TO CL-OPERATOR
    MOVE WS-D TO CL-CORR
    MOVE WS-E TO CL-REQUEST
    MOVE FUNCTION UPPER-CASE(WS-OP) TO WS-ACT
    MOVE WS-ACT TO CL-OP
    CALL "BLN" USING BK-LN-PARMS
    DISPLAY "rc=" CL-RC
    DISPLAY "loan=" FUNCTION TRIM(CL-LOAN-ID)
    DISPLAY "status=" FUNCTION TRIM(CL-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(CL-MSG).

DO-SCHEDULE.
    MOVE WS-A TO CL-LOAN-ID
    MOVE "SCHEDULE" TO CL-OP
    CALL "BLNSCH" USING BK-LN-PARMS
    DISPLAY "rc=" CL-RC
    DISPLAY "loan=" FUNCTION TRIM(CL-LOAN-ID)
    DISPLAY "installments=" CL-TERM
    DISPLAY "msg=" FUNCTION TRIM(CL-MSG).

DO-DISBURSE.
    MOVE WS-A TO CL-LOAN-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CL-AMOUNT
    MOVE WS-C TO WS-AMT2
    MOVE WS-AMT2 TO CL-FEE
    MOVE WS-D TO CL-OPERATOR
    MOVE WS-E TO CL-CORR
    MOVE WS-F TO CL-REQUEST
    CALL "BLNDIS" USING BK-LN-PARMS
    DISPLAY "rc=" CL-RC
    DISPLAY "txn=" FUNCTION TRIM(CL-TXN-ID)
    DISPLAY "msg=" FUNCTION TRIM(CL-MSG).

DO-REPAY.
    MOVE WS-A TO CL-LOAN-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CL-AMOUNT
    MOVE WS-C TO CL-OPERATOR
    MOVE WS-D TO CL-CORR
    MOVE WS-E TO CL-REQUEST
    CALL "BLRPAY" USING BK-LN-PARMS
    DISPLAY "rc=" CL-RC
    DISPLAY "txn=" FUNCTION TRIM(CL-TXN-ID)
    DISPLAY "principal=" CL-PRINCIPAL
    DISPLAY "interest=" CL-INTEREST
    DISPLAY "fees=" CL-FEES
    DISPLAY "excess=" CL-EXCESS
    DISPLAY "msg=" FUNCTION TRIM(CL-MSG).

DO-WRITEOFF.
    MOVE WS-A TO CL-LOAN-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CL-AMOUNT
    MOVE WS-C TO CL-REASON
    MOVE WS-D TO CL-OPERATOR
    MOVE WS-E TO CL-CORR
    MOVE WS-F TO CL-REQUEST
    CALL "BLNWOF" USING BK-LN-PARMS
    DISPLAY "rc=" CL-RC
    DISPLAY "txn=" FUNCTION TRIM(CL-TXN-ID)
    DISPLAY "msg=" FUNCTION TRIM(CL-MSG).

DO-GET.
    MOVE "GET" TO WS-QOP
    CALL "BLNQ" USING WS-QOP WS-A WS-LN-REC WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-LIST.
    MOVE "LIST" TO WS-QOP
    MOVE SPACES TO WS-A
    CALL "BLNQ" USING WS-QOP WS-A WS-LN-REC WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-INST-GET.
    MOVE WS-B TO WS-NUM
    MOVE "GET" TO WS-QOP
    CALL "BLNIQ" USING WS-QOP WS-A WS-NUM WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-INST-LIST.
    MOVE 0 TO WS-NUM
    MOVE "LIST" TO WS-QOP
    CALL "BLNIQ" USING WS-QOP WS-A WS-NUM WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-EXPOSURE.
    MOVE "GET" TO WS-QOP
    CALL "BLNQ" USING WS-QOP WS-A WS-LN-REC WS-QRC
    IF WS-QRC NOT = "00"
        DISPLAY "rc=" WS-QRC
        GOBACK
    END-IF
    MOVE "GET" TO WS-QOP
    CALL "BCRXQ" USING WS-QOP LN-FAC-ID WS-QRC
    DISPLAY "rc=" WS-QRC.
