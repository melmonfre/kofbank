IDENTIFICATION DIVISION.
PROGRAM-ID. BOPSCK.

*> Startup safety classifier (GATE 4).  Reads durable state only:
*> lifecycle record, unfinished transactions, journal stage markers,
*> outbound intents, inbound message identities, idempotency entries,
*> advisory locks, open reconciliation exceptions, EOD checkpoints, and
*> the structural integrity of the journal/postings/audit/event chains.
*> It NEVER mutates anything.  The class it returns decides whether
*> accepting work is safe; unknown states are surfaced, not guessed.
*> Classes: CLEAN RECOVERABLE OPERATOR_REQUIRED CORRUPT UNINITIALIZED.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TXN-FILE ASSIGN TO WS-TXN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS TXN-ID OF TXN-REC
        FILE STATUS IS WS-TXN-ST.
    SELECT JST-FILE ASSIGN TO WS-JST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS JST-ID OF JST-REC
        FILE STATUS IS WS-JST-ST.
    SELECT OB-FILE ASSIGN TO WS-OB-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS OB-OPID OF OB-REC
        FILE STATUS IS WS-OB-ST.
    SELECT MI-FILE ASSIGN TO WS-MI-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS MI-MSGID OF MI-REC
        FILE STATUS IS WS-MI-ST.
    SELECT IDM-FILE ASSIGN TO WS-IDM-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS IDM-TXN-ID OF IDM-REC
        FILE STATUS IS WS-IDM-ST.
    SELECT LCK-FILE ASSIGN TO WS-LCK-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS LK-NAME OF LCK-REC
        FILE STATUS IS WS-LCK-ST.
    SELECT EXC-FILE ASSIGN TO WS-EXC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS EXC-ID OF EXC-REC
        FILE STATUS IS WS-EXC-ST.
    SELECT CHK-FILE ASSIGN TO WS-CHK-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS EC-BD OF CHK-REC
        FILE STATUS IS WS-CHK-ST.
    SELECT CHAIN-FILE ASSIGN TO WS-CHAIN-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-CHAIN-ST.
    SELECT LIFE-FILE ASSIGN TO WS-LIFE-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-LIFE-ST.

DATA DIVISION.
FILE SECTION.
FD TXN-FILE.
01 TXN-REC.
   COPY "BTXREC".
FD JST-FILE.
01 JST-REC.
   05 JST-ID PIC X(20).
   05 JST-STATE PIC X(01).
   05 JST-UPDATED PIC 9(14).
FD OB-FILE.
01 OB-REC.
   05 OB-OPID          PIC X(16).
   05 OB-OPKIND        PIC X(12).
   05 OB-OP            PIC X(14).
   05 OB-CHANNEL       PIC X(12).
   05 OB-E2E           PIC X(32).
   05 OB-MSGID         PIC X(32).
   05 OB-AMT           PIC S9(15)V99 COMP-3.
   05 OB-CUR           PIC X(03).
   05 OB-INTERNAL      PIC X(32).
   05 OB-STATE         PIC X(16).
   05 OB-RETRIES       PIC 9(03).
   05 OB-CERTID        PIC X(24).
   05 OB-SIG           PIC X(64).
   05 OB-SIM           PIC X(12).
   05 OB-OUTCOME       PIC X(12).
   05 OB-EXTREF        PIC X(32).
   05 OB-FP            PIC X(16).
   05 OB-ENV           PIC X(16).
   05 OB-REASON        PIC X(60).
   05 OB-OPER          PIC X(12).
   05 OB-CORR          PIC X(24).
   05 OB-CREATED       PIC 9(14).
FD MI-FILE.
01 MI-REC.
   05 MI-MSGID         PIC X(32).
   05 MI-VER           PIC X(05).
   05 MI-MSGNM         PIC X(20).
   05 MI-E2E           PIC X(32).
   05 MI-FP            PIC X(16).
   05 MI-ENV           PIC X(16).
   05 MI-CHANNEL       PIC X(12).
   05 MI-STATE         PIC X(12).
   05 MI-PIXID         PIC X(12).
   05 MI-TXNID         PIC X(12).
   05 MI-JRNID         PIC X(20).
   05 MI-AMT           PIC S9(15)V99 COMP-3.
   05 MI-CUR           PIC X(03).
   05 MI-CREATED       PIC 9(14).
   05 MI-UPDATED       PIC 9(14).
   05 MI-COUNT         PIC 9(03).
FD IDM-FILE.
01 IDM-REC.
   05 IDM-TXN-ID PIC X(24).
   05 IDM-OPERATION PIC X(12).
   05 IDM-STATUS PIC X(01).
   05 IDM-RESULT PIC X(120).
   05 IDM-CREATED PIC 9(14).
   05 IDM-FP PIC X(16).
FD LCK-FILE.
01 LCK-REC.
   05 LK-NAME PIC X(24).
   05 LK-OWNER PIC X(16).
   05 LK-DATE PIC 9(08).
   05 LK-SECS PIC 9(05).
FD EXC-FILE.
01 EXC-REC.
   COPY "BRECE".
FD CHK-FILE.
01 CHK-REC.
   COPY "BKEODC".
FD CHAIN-FILE.
01 CHAIN-LINE PIC X(500).
FD LIFE-FILE.
01 LIFE-LINE PIC X(200).

WORKING-STORAGE SECTION.
01 WS-TXN-PATH PIC X(200).
01 WS-JST-PATH PIC X(200).
01 WS-OB-PATH PIC X(200).
01 WS-MI-PATH PIC X(200).
01 WS-IDM-PATH PIC X(200).
01 WS-LCK-PATH PIC X(200).
01 WS-EXC-PATH PIC X(200).
01 WS-CHK-PATH PIC X(200).
01 WS-CHAIN-PATH PIC X(200).
01 WS-CHAIN-SRC PIC X(40).
01 WS-CHAIN-ST PIC X(02).
01 WS-CHAIN-NAME PIC X(08).
01 WS-CHAIN-PREFIX PIC X(04).
01 WS-CHAIN-LEN PIC 9(04).
01 WS-CHAIN-MIN PIC 9(04).
01 WS-LINE-COUNT PIC 9(06).
01 WS-PIPE-CNT PIC 9(06).
01 WS-LIFE-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-TXN-ST PIC X(02).
01 WS-JST-ST PIC X(02).
01 WS-OB-ST PIC X(02).
01 WS-MI-ST PIC X(02).
01 WS-IDM-ST PIC X(02).
01 WS-LCK-ST PIC X(02).
01 WS-EXC-ST PIC X(02).
01 WS-CHK-ST PIC X(02).
01 WS-LIFE-ST PIC X(02).
01 WS-EOF PIC X(01).
01 OP-LOUD PIC X(01).
01 WS-FIND-CNT PIC 9(03).
01 WS-FIND-I PIC 9(03).
01 WS-FIND-TXT PIC X(120).
01 WS-FIND-TAB.
   05 WS-FIND-ELEM OCCURS 60 TIMES.
      10 WS-FIND PIC X(120).
01 WS-STATE-LINE PIC X(200).
01 WS-TMP-STATE PIC X(18).
01 WS-DUMMY PIC X(60).
01 WS-NOW PIC X(14).
01 WS-TODAY PIC 9(08).
01 WS-NOWSEC PIC 9(05).
01 WS-EXP PIC 9(05).
01 WS-LINE-LEN PIC 9(04).
01 WS-FIELD-CNT PIC 9(04).
01 WS-PIPE PIC X(01) VALUE "|".
01 WS-CLASS-OPER PIC X(01) VALUE "N".
01 WS-CLASS-RECOV PIC X(01) VALUE "N".
01 WS-CLASS-CORR PIC X(01) VALUE "N".

LINKAGE SECTION.
COPY "BKOPSCKP".

PROCEDURE DIVISION USING BK-OPS-PARMS.
    MOVE "00" TO OP-RC
    MOVE SPACES TO OP-MSG
    MOVE "Y" TO OP-LOUD
    MOVE 0 TO WS-FIND-CNT
    IF FUNCTION TRIM(OP-OP) = "CLASSIFYQ"
        MOVE "N" TO OP-LOUD
        MOVE "CLASSIFY" TO OP-OP
    END-IF
    MOVE 0 TO OP-TXN-PEND OP-JRN-STAGE OP-OUTB-OPEN OP-OUTB-UNK
        OP-MSG-UNFIN OP-IDM-STUCK OP-LOCK-STALE OP-REC-OPEN
        OP-EOD-INTERRUPT OP-CORRUPT-LINES
    MOVE "N" TO OP-CORRUPT OP-OPERATOR OP-RECOVER
    MOVE SPACES TO OP-CLASS OP-STATE
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    PERFORM BUILD-PATHS
    PERFORM READ-LIFECYCLE
    EVALUATE FUNCTION TRIM(OP-OP)
        WHEN "CLASSIFY" PERFORM SCAN-ALL
        WHEN "CLASSIFYQ" PERFORM SCAN-ALL
        WHEN "HEALTH" PERFORM SCAN-ALL
        WHEN OTHER
            MOVE "99" TO OP-RC
            MOVE "UNKNOWN OPS OP" TO OP-MSG
            GOBACK
    END-EVALUATE
    PERFORM DECIDE-CLASS
    IF OP-LOUD = "Y"
        IF OP-OP = "HEALTH"
            PERFORM SHOW-HEALTH
        ELSE
            PERFORM SHOW-CLASS
        END-IF
    END-IF
    GOBACK.

BUILD-PATHS.
    STRING FUNCTION TRIM(WS-HOME) "/var/data/txn.idx"
        DELIMITED SIZE INTO WS-TXN-PATH
    END-STRING
    STRING FUNCTION TRIM(WS-HOME) "/var/data/jrst.idx"
        DELIMITED SIZE INTO WS-JST-PATH
    END-STRING
    STRING FUNCTION TRIM(WS-HOME) "/var/data/bndout.idx"
        DELIMITED SIZE INTO WS-OB-PATH
    END-STRING
    STRING FUNCTION TRIM(WS-HOME) "/var/data/bndmsgid.idx"
        DELIMITED SIZE INTO WS-MI-PATH
    END-STRING
    STRING FUNCTION TRIM(WS-HOME) "/var/data/idm.idx"
        DELIMITED SIZE INTO WS-IDM-PATH
    END-STRING
    STRING FUNCTION TRIM(WS-HOME) "/var/data/lock.idx"
        DELIMITED SIZE INTO WS-LCK-PATH
    END-STRING
    STRING FUNCTION TRIM(WS-HOME) "/var/data/recexc.idx"
        DELIMITED SIZE INTO WS-EXC-PATH
    END-STRING
    STRING FUNCTION TRIM(WS-HOME) "/var/data/eodchk.idx"
        DELIMITED SIZE INTO WS-CHK-PATH
    END-STRING
    CONTINUE
    STRING FUNCTION TRIM(WS-HOME) "/var/run/life.dat"
        DELIMITED SIZE INTO WS-LIFE-PATH
    END-STRING.

READ-LIFECYCLE.
    MOVE "STOPPED" TO OP-STATE
    MOVE SPACES TO WS-STATE-LINE
    OPEN INPUT LIFE-FILE
    IF WS-LIFE-ST = "00"
        READ LIFE-FILE
            AT END CONTINUE
            NOT AT END
                MOVE LIFE-LINE TO WS-STATE-LINE
                UNSTRING WS-STATE-LINE DELIMITED BY "|"
                    INTO WS-TMP-STATE WS-DUMMY WS-DUMMY WS-DUMMY
                        WS-DUMMY
                END-UNSTRING
                IF WS-TMP-STATE NOT = SPACES
                    MOVE FUNCTION TRIM(WS-TMP-STATE) TO OP-STATE
                END-IF
        END-READ
    END-IF
    CLOSE LIFE-FILE.

SCAN-ALL.
    PERFORM SCAN-TXN
    PERFORM SCAN-JST
    PERFORM SCAN-OUTBOUND
    PERFORM SCAN-MSGID
    PERFORM SCAN-LOCKS
    PERFORM SCAN-EXCEPTIONS
    PERFORM SCAN-EODCHK
    MOVE "/var/journal/journal.log" TO WS-CHAIN-SRC
    MOVE SPACES TO WS-CHAIN-PREFIX
    MOVE 10 TO WS-CHAIN-MIN
    MOVE "journal" TO WS-CHAIN-NAME
    PERFORM SCAN-CHAIN
    MOVE "/var/journal/postings.log" TO WS-CHAIN-SRC
    MOVE "GLP|" TO WS-CHAIN-PREFIX
    MOVE 7 TO WS-CHAIN-MIN
    MOVE "postings" TO WS-CHAIN-NAME
    PERFORM SCAN-CHAIN
    MOVE "/var/audit/audit.log" TO WS-CHAIN-SRC
    MOVE SPACES TO WS-CHAIN-PREFIX
    MOVE 6 TO WS-CHAIN-MIN
    MOVE "audit" TO WS-CHAIN-NAME
    PERFORM SCAN-CHAIN
    MOVE "/var/journal/events.log" TO WS-CHAIN-SRC
    MOVE "EVT|" TO WS-CHAIN-PREFIX
    MOVE 5 TO WS-CHAIN-MIN
    MOVE "events" TO WS-CHAIN-NAME
    PERFORM SCAN-CHAIN.

SCAN-TXN.
    MOVE "N" TO WS-EOF
    OPEN INPUT TXN-FILE
    IF WS-TXN-ST = "00"
        PERFORM UNTIL WS-EOF = "Y"
            READ TXN-FILE
                AT END MOVE "Y" TO WS-EOF
                NOT AT END
                    IF TXN-STATUS OF TXN-REC = "AU"
                        ADD 1 TO OP-TXN-PEND
                        MOVE "Y" TO OP-RECOVER
                        MOVE SPACES TO WS-FIND-TXT STRING "FINDING|TXN_UNRESOLVED|" DELIMITED SIZE FUNCTION TRIM(TXN-ID OF TXN-REC) DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
                    END-IF
                END-READ
        END-PERFORM
    END-IF
    CLOSE TXN-FILE.

SCAN-JST.
    MOVE "N" TO WS-EOF
    OPEN INPUT JST-FILE
    IF WS-JST-ST = "00"
        PERFORM UNTIL WS-EOF = "Y"
            READ JST-FILE
                AT END MOVE "Y" TO WS-EOF
                NOT AT END
                    IF JST-STATE OF JST-REC = "J" OR
                       JST-STATE OF JST-REC = "B"
                        ADD 1 TO OP-JRN-STAGE
                        MOVE "Y" TO OP-RECOVER
                        MOVE SPACES TO WS-FIND-TXT STRING "FINDING|JRN_STAGED|" DELIMITED SIZE FUNCTION TRIM(JST-ID OF JST-REC) DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
                    END-IF
                END-READ
        END-PERFORM
    END-IF
    CLOSE JST-FILE.

SCAN-OUTBOUND.
    MOVE "N" TO WS-EOF
    OPEN INPUT OB-FILE
    IF WS-OB-ST = "00"
        PERFORM UNTIL WS-EOF = "Y"
            READ OB-FILE
                AT END MOVE "Y" TO WS-EOF
                NOT AT END
                    IF OB-STATE OF OB-REC = "ACKED" OR
                       OB-STATE OF OB-REC = "REJECTED"
                        CONTINUE
                    ELSE 
                        IF OB-STATE OF OB-REC = "UNKNOWN"
                            ADD 1 TO OP-OUTB-UNK
                            MOVE "Y" TO OP-OPERATOR
                            MOVE SPACES TO WS-FIND-TXT STRING "FINDING|OUTB_UNKNOWN|" DELIMITED SIZE FUNCTION TRIM(OB-OPID OF OB-REC) DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
                        ELSE
                            ADD 1 TO OP-OUTB-OPEN
                            MOVE "Y" TO OP-RECOVER
                            MOVE SPACES TO WS-FIND-TXT STRING "FINDING|OUTB_PENDING|" DELIMITED SIZE FUNCTION TRIM(OB-OPID OF OB-REC) DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
                        END-IF
                    END-IF
                END-READ
        END-PERFORM
    END-IF
    CLOSE OB-FILE.

SCAN-MSGID.
    MOVE "N" TO WS-EOF
    OPEN INPUT MI-FILE
    IF WS-MI-ST = "00"
        PERFORM UNTIL WS-EOF = "Y"
            READ MI-FILE
                AT END MOVE "Y" TO WS-EOF
                NOT AT END
                    IF MI-STATE OF MI-REC = "RECEIVED"
                        ADD 1 TO OP-MSG-UNFIN
                        MOVE "Y" TO OP-OPERATOR
                        MOVE SPACES TO WS-FIND-TXT STRING "FINDING|MSG_RECEIVED_UNFIN|" DELIMITED SIZE FUNCTION TRIM(MI-MSGID OF MI-REC) DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
                    END-IF
                END-READ
        END-PERFORM
    END-IF
    CLOSE MI-FILE.

SCAN-LOCKS.
    MOVE "N" TO WS-EOF
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:8) TO WS-TODAY
    COMPUTE WS-NOWSEC = FUNCTION NUMVAL(WS-NOW(9:2)) * 3600
        + FUNCTION NUMVAL(WS-NOW(11:2)) * 60
        + FUNCTION NUMVAL(WS-NOW(13:2))
    OPEN INPUT LCK-FILE
    IF WS-LCK-ST = "00"
        PERFORM UNTIL WS-EOF = "Y"
            READ LCK-FILE
                AT END MOVE "Y" TO WS-EOF
                NOT AT END
                    MOVE LK-SECS OF LCK-REC TO WS-EXP
                    IF LK-DATE OF LCK-REC < WS-TODAY OR
                       WS-EXP < WS-NOWSEC
                        ADD 1 TO OP-LOCK-STALE
                        MOVE SPACES TO WS-FIND-TXT STRING "FINDING|LOCK_STALE|" DELIMITED SIZE FUNCTION TRIM(LK-NAME OF LCK-REC) DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
                    END-IF
                END-READ
        END-PERFORM
    END-IF
    CLOSE LCK-FILE.

SCAN-EXCEPTIONS.
    MOVE "N" TO WS-EOF
    OPEN INPUT EXC-FILE
    IF WS-EXC-ST = "00"
        PERFORM UNTIL WS-EOF = "Y"
            READ EXC-FILE
                AT END MOVE "Y" TO WS-EOF
                NOT AT END
                    IF EXC-STATUS OF EXC-REC = "OPEN"
                        ADD 1 TO OP-REC-OPEN
                        MOVE "Y" TO OP-OPERATOR
                        MOVE SPACES TO WS-FIND-TXT STRING "FINDING|REC_OPEN|" DELIMITED SIZE FUNCTION TRIM(EXC-ID OF EXC-REC) DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
                    END-IF
                END-READ
        END-PERFORM
    END-IF
    CLOSE EXC-FILE.

SCAN-EODCHK.
    MOVE "N" TO WS-EOF
    OPEN INPUT CHK-FILE
    IF WS-CHK-ST = "00"
        PERFORM UNTIL WS-EOF = "Y"
            READ CHK-FILE
                AT END MOVE "Y" TO WS-EOF
                NOT AT END
                    IF EC-ST OF CHK-REC = "RUNNING" OR
                       EC-ST OF CHK-REC = "FAILED"
                        ADD 1 TO OP-EOD-INTERRUPT
                        MOVE "Y" TO OP-RECOVER
                        MOVE SPACES TO WS-FIND-TXT STRING "FINDING|EOD_INTERRUPTED|" DELIMITED SIZE EC-BD OF CHK-REC DELIMITED SIZE " " DELIMITED SIZE FUNCTION TRIM(EC-ST OF CHK-REC) DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
                    END-IF
                END-READ
        END-PERFORM
    END-IF
    CLOSE CHK-FILE.

SCAN-CHAIN.
    MOVE SPACES TO WS-CHAIN-PATH
    STRING FUNCTION TRIM(WS-HOME) DELIMITED SIZE
        WS-CHAIN-SRC DELIMITED SIZE INTO WS-CHAIN-PATH
    END-STRING
    IF WS-CHAIN-PREFIX = SPACES
        MOVE 0 TO WS-CHAIN-LEN
    ELSE
        MOVE 4 TO WS-CHAIN-LEN
    END-IF
    MOVE "N" TO WS-EOF
    MOVE 0 TO WS-LINE-COUNT
    OPEN INPUT CHAIN-FILE
    IF WS-CHAIN-ST = "00"
        PERFORM UNTIL WS-EOF = "Y"
            READ CHAIN-FILE
                AT END MOVE "Y" TO WS-EOF
                NOT AT END
                    ADD 1 TO WS-LINE-COUNT
                    IF WS-CHAIN-LEN > 0
                        IF CHAIN-LINE(1:WS-CHAIN-LEN) NOT =
                           WS-CHAIN-PREFIX(1:4)
                            ADD 1 TO OP-CORRUPT-LINES
                            MOVE "Y" TO OP-CORRUPT
                            MOVE SPACES TO WS-FIND-TXT STRING "FINDING|CHAIN_MALFORMED|" DELIMITED SIZE WS-CHAIN-NAME DELIMITED SIZE ":" DELIMITED SIZE WS-LINE-COUNT DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
                        END-IF
                    END-IF
                    MOVE 0 TO WS-PIPE-CNT
                    INSPECT CHAIN-LINE TALLYING WS-PIPE-CNT
                        FOR ALL "|"
                    IF WS-PIPE-CNT < WS-CHAIN-MIN - 1
                        ADD 1 TO OP-CORRUPT-LINES
                        MOVE "Y" TO OP-CORRUPT
                        MOVE SPACES TO WS-FIND-TXT STRING "FINDING|CHAIN_TRUNCATED|" DELIMITED SIZE WS-CHAIN-NAME DELIMITED SIZE ":" DELIMITED SIZE WS-LINE-COUNT DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
                    END-IF
            END-READ
        END-PERFORM
    ELSE
        IF WS-CHAIN-ST NOT = "35"
            ADD 1 TO OP-CORRUPT-LINES
            MOVE "Y" TO OP-CORRUPT
            MOVE SPACES TO WS-FIND-TXT STRING "FINDING|CHAIN_UNREADABLE|" DELIMITED SIZE WS-CHAIN-NAME DELIMITED SIZE ":" DELIMITED SIZE WS-CHAIN-ST DELIMITED SIZE INTO WS-FIND-TXT END-STRING PERFORM SAY-FINDING
        END-IF
    END-IF
    CLOSE CHAIN-FILE.

SAY-FINDING.
    IF OP-LOUD = "Y" AND WS-FIND-CNT < 60
        ADD 1 TO WS-FIND-CNT
        MOVE WS-FIND-TXT TO WS-FIND OF WS-FIND-ELEM
            (WS-FIND-CNT)
    END-IF.

DECIDE-CLASS.
    IF OP-CORRUPT = "Y"
        MOVE "CORRUPT" TO OP-CLASS
    ELSE
        IF OP-OPERATOR = "Y"
            MOVE "OPERATOR_REQUIRED" TO OP-CLASS
        ELSE
            IF OP-RECOVER = "Y"
                MOVE "RECOVERABLE" TO OP-CLASS
            ELSE
                MOVE "CLEAN" TO OP-CLASS
            END-IF
        END-IF
    END-IF.

SHOW-CLASS.
    PERFORM VARYING WS-FIND-I FROM 1 BY 1
        UNTIL WS-FIND-I > WS-FIND-CNT
        DISPLAY WS-FIND OF WS-FIND-ELEM (WS-FIND-I)
    END-PERFORM
    DISPLAY "class=" FUNCTION TRIM(OP-CLASS)
    DISPLAY "state=" FUNCTION TRIM(OP-STATE)
    DISPLAY "txn-pend=" OP-TXN-PEND
    DISPLAY "jrn-stage=" OP-JRN-STAGE
    DISPLAY "outb-open=" OP-OUTB-OPEN
    DISPLAY "outb-unknown=" OP-OUTB-UNK
    DISPLAY "msg-unfinished=" OP-MSG-UNFIN
    DISPLAY "idm-stuck=" OP-IDM-STUCK
    DISPLAY "lock-stale=" OP-LOCK-STALE
    DISPLAY "rec-open=" OP-REC-OPEN
    DISPLAY "eod-interrupted=" OP-EOD-INTERRUPT
    DISPLAY "corrupt-lines=" OP-CORRUPT-LINES.

SHOW-HEALTH.
    PERFORM VARYING WS-FIND-I FROM 1 BY 1
        UNTIL WS-FIND-I > WS-FIND-CNT
        DISPLAY WS-FIND OF WS-FIND-ELEM (WS-FIND-I)
    END-PERFORM
    IF OP-STATE = "RUNNING"
        DISPLAY "live=ok"
    ELSE
        DISPLAY "live=stale-state"
    END-IF
    IF OP-CLASS = "CLEAN"
        DISPLAY "ready=ok"
    ELSE
        DISPLAY "ready=no class=" FUNCTION TRIM(OP-CLASS)
    END-IF
    IF OP-CORRUPT = "Y"
        DISPLAY "integrity=no"
    ELSE
        DISPLAY "integrity=ok"
    END-IF
    MOVE SPACES TO OP-MSG
    STRING "CLASS=" DELIMITED SIZE FUNCTION TRIM(OP-CLASS)
        DELIMITED SIZE INTO OP-MSG
    END-STRING.
