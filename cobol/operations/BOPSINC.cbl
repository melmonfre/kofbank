IDENTIFICATION DIVISION.
PROGRAM-ID. BOPSINC.

*> Durable incident store (GATE 4): var/data/opsinc.idx.
*> An incident records operator-visible evidence about operational
*> conditions (unfinished recovery, uncorrelated outbound intents,
*> corruption findings, stale locks, ...).  Resolving requires an
*> explicit ACK first and an explicit note; nothing auto-resolves.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT INC-FILE ASSIGN TO WS-INC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS INC-KEY OF INC-REC
        FILE STATUS IS WS-INC-ST.

DATA DIVISION.
FILE SECTION.
FD INC-FILE.
01 INC-REC.
   05 INC-KEY          PIC X(24).
   05 INC-SUMMARY      PIC X(60).
   05 INC-SEV          PIC X(06).
   05 INC-STATE        PIC X(08).
   05 INC-EVIDENCE     PIC X(240).
   05 INC-ACTION       PIC X(80).
   05 INC-CONDITION    PIC X(80).
   05 INC-OPER         PIC X(12).
   05 INC-CORR         PIC X(24).
   05 INC-OPENED       PIC 9(14).
   05 INC-UPDATED      PIC 9(14).

WORKING-STORAGE SECTION.
01 WS-INC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-INC-ST PIC X(02).
01 WS-NOW PIC X(14).
01 WS-EOF PIC X(01).
COPY "BKAUDP".

LINKAGE SECTION.
COPY "BKINCP".

PROCEDURE DIVISION USING BK-INC-PARMS.
    MOVE "00" TO IN-RC
    MOVE SPACES TO IN-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-INC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/opsinc.idx"
        DELIMITED SIZE INTO WS-INC-PATH
    OPEN I-O INC-FILE
    IF WS-INC-ST = "35"
        OPEN OUTPUT INC-FILE
        CLOSE INC-FILE
        OPEN I-O INC-FILE
    END-IF
    IF WS-INC-ST NOT = "00"
        MOVE WS-INC-ST TO IN-RC
        MOVE "CANNOT OPEN INCIDENT STORE" TO IN-MSG
        GOBACK
    END-IF
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    EVALUATE FUNCTION TRIM(IN-OP)
        WHEN "OPEN" PERFORM DO-OPEN
        WHEN "ACK" PERFORM DO-ACK
        WHEN "RESOLVE" PERFORM DO-RESOLVE
        WHEN "SHOW" PERFORM DO-SHOW
        WHEN "LIST" PERFORM DO-LIST
        WHEN OTHER
            MOVE "99" TO IN-RC
            MOVE "UNKNOWN INCIDENT OP" TO IN-MSG
    END-EVALUATE
    CLOSE INC-FILE
    GOBACK.

DO-OPEN.
    IF IN-KEY = SPACES OR IN-SUMMARY = SPACES
        MOVE "20" TO IN-RC
        MOVE "KEY AND SUMMARY REQUIRED" TO IN-MSG
        EXIT PARAGRAPH
    END-IF
    IF IN-EVIDENCE(1:4) = SPACES
        MOVE "20" TO IN-RC
        MOVE "EVIDENCE REQUIRED" TO IN-MSG
        EXIT PARAGRAPH
    END-IF
    IF IN-SEV NOT = "SEV1" AND IN-SEV NOT = "SEV2" AND
       IN-SEV NOT = "SEV3"
        MOVE "20" TO IN-RC
        MOVE "SEVERITY MUST BE SEV1 SEV2 SEV3" TO IN-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE IN-KEY TO INC-KEY OF INC-REC
    READ INC-FILE
        INVALID KEY
            PERFORM WRITE-NEW
        NOT INVALID KEY
            IF INC-STATE OF INC-REC = "RESOLVED"
                MOVE "21" TO IN-RC
                MOVE "INCIDENT RESOLVED OPEN NEW ONE" TO IN-MSG
            ELSE
                MOVE INC-STATE OF INC-REC TO IN-STATE
                MOVE "22" TO IN-RC
                MOVE "INCIDENT ALREADY OPEN" TO IN-MSG
            END-IF
    END-READ.

WRITE-NEW.
    MOVE IN-KEY TO INC-KEY OF INC-REC
    MOVE IN-SUMMARY TO INC-SUMMARY OF INC-REC
    MOVE IN-SEV TO INC-SEV OF INC-REC
    MOVE "OPEN" TO INC-STATE OF INC-REC
    MOVE IN-EVIDENCE TO INC-EVIDENCE OF INC-REC
    MOVE IN-ACTION TO INC-ACTION OF INC-REC
    MOVE IN-RESOLVE TO INC-CONDITION OF INC-REC
    MOVE IN-OPERATOR TO INC-OPER OF INC-REC
    MOVE IN-CORR TO INC-CORR OF INC-REC
    MOVE WS-NOW TO INC-OPENED OF INC-REC
        INC-UPDATED OF INC-REC
    WRITE INC-REC
    MOVE "OPEN" TO IN-STATE
    MOVE "INCIDENT OPENED" TO IN-MSG
    PERFORM AUDIT-INC.

DO-ACK.
    MOVE IN-KEY TO INC-KEY OF INC-REC
    READ INC-FILE
        INVALID KEY
            MOVE "22" TO IN-RC
            MOVE "INCIDENT NOT FOUND" TO IN-MSG
        NOT INVALID KEY
            IF INC-STATE OF INC-REC NOT = "OPEN"
                MOVE "20" TO IN-RC
                MOVE "ONLY OPEN INCIDENTS CAN BE ACKED" TO IN-MSG
            ELSE
                MOVE "ACK" TO INC-STATE OF INC-REC
                MOVE WS-NOW TO INC-UPDATED OF INC-REC
                MOVE IN-OPERATOR TO INC-OPER OF INC-REC
                REWRITE INC-REC
                MOVE "ACK" TO IN-STATE
                MOVE "INCIDENT ACKED" TO IN-MSG
                PERFORM AUDIT-INC
            END-IF
    END-READ.

DO-RESOLVE.
    MOVE IN-KEY TO INC-KEY OF INC-REC
    READ INC-FILE
        INVALID KEY
            MOVE "22" TO IN-RC
            MOVE "INCIDENT NOT FOUND" TO IN-MSG
        NOT INVALID KEY
            IF INC-STATE OF INC-REC = "OPEN"
                MOVE "20" TO IN-RC
                MOVE "ACK BEFORE RESOLVE" TO IN-MSG
            ELSE IF INC-STATE OF INC-REC = "RESOLVED"
                MOVE "22" TO IN-RC
                MOVE "INCIDENT ALREADY RESOLVED" TO IN-MSG
            ELSE
                IF IN-ACTION(1:4) = SPACES
                    MOVE "20" TO IN-RC
                    MOVE "RESOLUTION NOTE REQUIRED" TO IN-MSG
                ELSE
                    MOVE "RESOLVED" TO INC-STATE OF INC-REC
                    MOVE IN-ACTION TO INC-ACTION OF INC-REC
                    MOVE WS-NOW TO INC-UPDATED OF INC-REC
                    MOVE IN-OPERATOR TO INC-OPER OF INC-REC
                    REWRITE INC-REC
                    MOVE "RESOLVED" TO IN-STATE
                    MOVE "INCIDENT RESOLVED" TO IN-MSG
                    PERFORM AUDIT-INC
                END-IF
            END-IF END-IF
    END-READ.

DO-SHOW.
    MOVE IN-KEY TO INC-KEY OF INC-REC
    READ INC-FILE
        INVALID KEY
            MOVE "22" TO IN-RC
            MOVE "INCIDENT NOT FOUND" TO IN-MSG
        NOT INVALID KEY
            MOVE INC-STATE OF INC-REC TO IN-STATE
            MOVE INC-SEV OF INC-REC TO IN-SEV
            MOVE INC-SUMMARY OF INC-REC TO IN-SUMMARY
            MOVE INC-EVIDENCE OF INC-REC TO IN-EVIDENCE
            MOVE "INCIDENT SHOWN" TO IN-MSG
    END-READ.

DO-LIST.
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ INC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF INC-STATE OF INC-REC NOT = "RESOLVED"
                    DISPLAY "INCIDENT " FUNCTION TRIM(INC-KEY
                        OF INC-REC) " " INC-STATE OF INC-REC
                        " " INC-SEV OF INC-REC " "
                        FUNCTION TRIM(INC-SUMMARY OF INC-REC)
                END-IF
        END-READ
    END-PERFORM.

AUDIT-INC.
    MOVE SPACES TO BK-AUD-PARMS
    MOVE IN-OPERATOR TO BK-AUD-OPERATOR
    STRING "INC." DELIMITED SIZE FUNCTION TRIM(IN-OP)
        DELIMITED SIZE INTO BK-AUD-ACTION
    END-STRING
    MOVE "INCIDENT" TO BK-AUD-ENTITY
    MOVE IN-CORR TO BK-AUD-CORR
    MOVE IN-KEY TO BK-AUD-BEFORE
    MOVE IN-STATE TO BK-AUD-AFTER
    MOVE IN-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS.
