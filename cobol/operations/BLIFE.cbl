IDENTIFICATION DIVISION.
PROGRAM-ID. BLIFE.

*> System lifecycle state (GATE 4).  The state file is durable and tiny:
*> var/run/life.dat.  It records ONLY whether operators may start, drain,
*> stop, or resume accepting work.  Financial truth is never stored or
*> derived here.  Transitions are validated; destructive/privileged ones
*> require an explicit reason and are audited.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT LIFE-FILE ASSIGN TO WS-LIFE-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-LIFE-ST.

DATA DIVISION.
FILE SECTION.
FD LIFE-FILE.
01 LIFE-FILE-REC PIC X(200).

WORKING-STORAGE SECTION.
01 WS-LIFE-ST PIC X(02).
01 WS-LIFE-PATH PIC X(200).
01 WS-LIFE-LINE PIC X(200).
01 WS-HOME PIC X(80).
01 WS-STATE PIC X(18).
01 WS-TS PIC X(14).
01 WS-OPER PIC X(12).
01 WS-REASON PIC X(60).
01 WS-GEN PIC 9(05).
01 WS-EXIST PIC X(01).
01 WS-OLD PIC X(18).
01 WS-DIR PIC X(200).
COPY "BKAUDP".
LINKAGE SECTION.
COPY "BKLIFP".

PROCEDURE DIVISION USING BK-LIFE-PARMS.
    MOVE "00" TO LF-RC
    MOVE SPACES TO LF-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-LIFE-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/run/life.dat"
        DELIMITED SIZE INTO WS-LIFE-PATH
    PERFORM LOAD-STATE
    MOVE WS-STATE TO LF-STATE
    EVALUATE FUNCTION TRIM(LF-OP)
        WHEN "GET" CONTINUE
        WHEN "CHECK" PERFORM DO-CHECK
        WHEN "START" PERFORM DO-START
        WHEN "STOP" PERFORM DO-STOP
        WHEN "DRAIN" PERFORM DO-DRAIN
        WHEN "RECOVERY" PERFORM DO-RECOVERY
        WHEN "RECOVERING" PERFORM DO-RECOVERING
        WHEN "RESUME" PERFORM DO-RESUME
        WHEN "MAINTAIN" PERFORM DO-MAINTAIN
        WHEN OTHER
            MOVE "20" TO LF-RC
            MOVE "UNKNOWN LIFECYCLE OP" TO LF-MSG
    END-EVALUATE
    GOBACK.

LOAD-STATE.
    MOVE SPACES TO WS-STATE
    MOVE 0 TO WS-GEN
    MOVE "N" TO WS-EXIST
    OPEN INPUT LIFE-FILE
    IF WS-LIFE-ST = "00"
        READ LIFE-FILE
            AT END CONTINUE
            NOT AT END
                MOVE "Y" TO WS-EXIST
                PERFORM PARSE-LINE
        END-READ
    END-IF
    CLOSE LIFE-FILE.
    IF WS-STATE = SPACES
        MOVE "STOPPED" TO WS-STATE
    END-IF.

PARSE-LINE.
    MOVE LIFE-FILE-REC TO WS-LIFE-LINE
    UNSTRING WS-LIFE-LINE DELIMITED BY "|"
        INTO WS-STATE WS-TS WS-OPER WS-REASON WS-GEN
    END-UNSTRING.

SAVE-STATE.
    MOVE WS-STATE TO WS-OLD
    MOVE FUNCTION TRIM(LF-STATE) TO WS-STATE
    ADD 1 TO WS-GEN
    MOVE FUNCTION CURRENT-DATE TO WS-TS
    MOVE LF-OPERATOR TO WS-OPER
    MOVE LF-REASON TO WS-REASON
    MOVE SPACES TO WS-DIR
    STRING "mkdir -p " DELIMITED SIZE FUNCTION TRIM(WS-HOME)
        "/var/run" DELIMITED SIZE INTO WS-DIR
    END-STRING
    CALL "SYSTEM" USING WS-DIR
    CALL "SYSTEM" USING WS-DIR
    MOVE SPACES TO LIFE-FILE-REC
    OPEN OUTPUT LIFE-FILE
    IF WS-LIFE-ST NOT = "00"
        MOVE "20" TO LF-RC
        MOVE "LIFECYCLE STATE NOT PERSISTED" TO LF-MSG
        GOBACK
    END-IF
    STRING WS-STATE DELIMITED SIZE "|" DELIMITED SIZE
        WS-TS DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(WS-OPER) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(WS-REASON) DELIMITED SIZE "|" DELIMITED SIZE
        WS-GEN DELIMITED SIZE INTO LIFE-FILE-REC
    END-STRING
    WRITE LIFE-FILE-REC END-WRITE
    CLOSE LIFE-FILE.

DO-CHECK.
    IF WS-EXIST NOT = "Y"
        MOVE "22" TO LF-RC
        MOVE "NO LIFECYCLE FILE - LEGACY MODE" TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    IF WS-STATE = "RUNNING"
        EXIT PARAGRAPH
    END-IF
    MOVE "20" TO LF-RC
    MOVE "SYSTEM NOT RUNNING" TO LF-MSG
    IF WS-STATE = "DRAINING"
        IF LF-DOMAIN = "txn" AND LF-CMD = "recover"
            MOVE "00" TO LF-RC
        END-IF
        IF LF-DOMAIN = "bnd"
            MOVE "00" TO LF-RC
        END-IF
    ELSE IF WS-STATE = "RECOVERING" OR
            WS-STATE = "RECOVERY_REQUIRED"
        IF LF-DOMAIN = "txn" OR LF-DOMAIN = "bnd" OR
           LF-DOMAIN = "ledger" OR
           LF-DOMAIN = "reconciliation" OR
           LF-DOMAIN = "batch" OR LF-DOMAIN = "ops"
            MOVE "00" TO LF-RC
        END-IF
    END-IF END-IF.

DO-START.
    IF WS-STATE = "RUNNING" OR WS-STATE = "DRAINING"
        MOVE "22" TO LF-RC
        MOVE "SYSTEM ALREADY ACTIVE" TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    IF WS-STATE = "RECOVERING" OR
       WS-STATE = "RECOVERY_REQUIRED"
        MOVE "20" TO LF-RC
        MOVE "RECOVERY IN PROGRESS USE RESUME" TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "RUNNING" TO LF-STATE
    PERFORM SAVE-STATE
    PERFORM AUDIT-TRANS
    MOVE "SYSTEM STARTED" TO LF-MSG.

DO-STOP.
    IF WS-STATE = "STOPPED"
        MOVE "22" TO LF-RC
        MOVE "SYSTEM ALREADY STOPPED" TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    IF LF-REASON(1:9) NOT = "IMMEDIATE" AND
       LF-REASON(1:8) NOT = "GRACEFUL" AND
       LF-REASON(1:5) NOT = "FORCE"
        MOVE "20" TO LF-RC
        MOVE "STOP REQUIRES REASON IMMEDIATE OR GRACEFUL"
            TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "STOPPED" TO LF-STATE
    PERFORM SAVE-STATE
    PERFORM AUDIT-TRANS
    MOVE "SYSTEM STOPPED" TO LF-MSG.

DO-DRAIN.
    IF WS-STATE NOT = "RUNNING"
        MOVE "20" TO LF-RC
        MOVE "DRAIN ONLY FROM RUNNING" TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "DRAINING" TO LF-STATE
    PERFORM SAVE-STATE
    PERFORM AUDIT-TRANS
    MOVE "SYSTEM DRAINING NEW WORK BLOCKED" TO LF-MSG.

DO-RECOVERY.
    IF WS-STATE = "RECOVERY_REQUIRED" OR WS-STATE = "RECOVERING"
        MOVE "20" TO LF-RC
        MOVE "ALREADY IN RECOVERY" TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "RECOVERY_REQUIRED" TO LF-STATE
    PERFORM SAVE-STATE
    PERFORM AUDIT-TRANS
    MOVE "RECOVERY REQUIRED" TO LF-MSG.

DO-RECOVERING.
    IF WS-STATE NOT = "RECOVERY_REQUIRED" AND
       WS-STATE NOT = "STOPPED"
        MOVE "20" TO LF-RC
        MOVE "RECOVERING ONLY FROM STOPPED OR REQUIRED"
            TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "RECOVERING" TO LF-STATE
    PERFORM SAVE-STATE
    PERFORM AUDIT-TRANS
    MOVE "RECOVERY UNDER WAY" TO LF-MSG.

DO-RESUME.
    IF WS-STATE NOT = "RECOVERING" AND
       WS-STATE NOT = "RECOVERY_REQUIRED"
        MOVE "20" TO LF-RC
        MOVE "RESUME ONLY DURING RECOVERY" TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "RUNNING" TO LF-STATE
    PERFORM SAVE-STATE
    PERFORM AUDIT-TRANS
    MOVE "SYSTEM RESUMED" TO LF-MSG.

DO-MAINTAIN.
    IF WS-STATE = "RUNNING" OR WS-STATE = "DRAINING"
        MOVE "20" TO LF-RC
        MOVE "MAINTENANCE REQUIRES STOPPED SYSTEM" TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    IF WS-STATE NOT = "STOPPED"
        MOVE "20" TO LF-RC
        MOVE "ILLEGAL MAINTENANCE TRANSITION" TO LF-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "MAINTENANCE" TO LF-STATE
    PERFORM SAVE-STATE
    PERFORM AUDIT-TRANS
    MOVE "MAINTENANCE MODE" TO LF-MSG.

AUDIT-TRANS.
    MOVE SPACES TO BK-AUD-PARMS
    MOVE LF-OPERATOR TO BK-AUD-OPERATOR
    MOVE "LIFE.CHANGE" TO BK-AUD-ACTION
    MOVE "SYSTEM" TO BK-AUD-ENTITY
    MOVE LF-CORR TO BK-AUD-CORR
    MOVE WS-OLD TO BK-AUD-BEFORE
    MOVE FUNCTION TRIM(LF-STATE) TO BK-AUD-AFTER
    MOVE LF-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS.
