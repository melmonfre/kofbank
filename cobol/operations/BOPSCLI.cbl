IDENTIFICATION DIVISION.
PROGRAM-ID. BOPSCLI.

*> Operations CLI adapter (GATE 4).  Thin translation from pipe-
*> delimited request lines to the operational programs.  Operator
*> identity is a mandatory field on privileged actions (stop, drain,
*> backup, restore, release, resolve) and is audited; this is NOT an
*> IAM system - production replaces it with RACF/EACF roles.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BKLIFP".
COPY "BKOPSCKP".
COPY "BKBKUPP".
COPY "BKINCP".
COPY "BKCFTP".
COPY "BKLOCKP".
COPY "BKCOP".
COPY "BKCFCP".
COPY "BKEODCP".
01 WS-EOD-DATA.
   COPY "BKEODC".
COPY "BKAUDP".
COPY "BKEVTP".
01 WS-OP PIC X(24).
01 WS-A PIC X(60).
01 WS-B PIC X(60).
01 WS-C PIC X(60).
01 WS-D PIC X(60).
01 WS-E PIC X(200).
01 WS-P2000 PIC X(2000).
01 WS-S64 PIC X(64).
01 WS-RC PIC X(02).
01 WS-MSG PIC X(80).
01 WS-MODE PIC X(06).
01 WS-DAYS PIC 9(04).
01 WS-BD PIC 9(08).

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    MOVE SPACES TO BK-LIFE-PARMS BK-OPS-PARMS BK-BKU-PARMS
        BK-INC-PARMS BK-CRT-PARMS BK-LOCK-PARMS BK-EODCHK-PARM
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E
    END-UNSTRING
    EVALUATE FUNCTION TRIM(WS-OP)
        WHEN "start" PERFORM DO-START
        WHEN "status" PERFORM DO-STATUS
        WHEN "stop" PERFORM DO-STOP
        WHEN "drain" PERFORM DO-DRAIN
        WHEN "recover.begin" PERFORM DO-RECOVER-BEGIN
        WHEN "recover.resume" PERFORM DO-RECOVER-RESUME
        WHEN "maintain" PERFORM DO-MAINTAIN
        WHEN "inspect" PERFORM DO-INSPECT
        WHEN "health" PERFORM DO-HEALTH
        WHEN "backup.create" PERFORM DO-BACKUP-CREATE
        WHEN "backup.verify" PERFORM DO-BACKUP-VERIFY
        WHEN "restore.verify" PERFORM DO-RESTORE-VERIFY
        WHEN "restore.apply" PERFORM DO-RESTORE-APPLY
        WHEN "backup.list" PERFORM DO-BACKUP-LIST
        WHEN "batch.status" PERFORM DO-BATCH-STATUS
        WHEN "batch.list" PERFORM DO-BATCH-LIST
        WHEN "locks.list" PERFORM DO-LOCKS-LIST
        WHEN "locks.release" PERFORM DO-LOCKS-RELEASE
        WHEN "cert.expiring" PERFORM DO-CERT-EXPIRING
        WHEN "config.verify" PERFORM DO-CONFIG
        WHEN "contract" PERFORM DO-CONTRACT
        WHEN "correlate" PERFORM DO-CORRELATE
        WHEN "incident.open" PERFORM DO-INC-OPEN
        WHEN "incident.ack" PERFORM DO-INC-ACK
        WHEN "incident.resolve" PERFORM DO-INC-RESOLVE
        WHEN "incident.show" PERFORM DO-INC-SHOW
        WHEN "incident.list" PERFORM DO-INC-LIST
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN OPS OP"
    END-EVALUATE
    GOBACK.

DO-START.
    MOVE "GET" TO LF-OP
    CALL "BLIFE" USING BK-LIFE-PARMS
    IF LF-STATE = "RUNNING"
        DISPLAY "rc=22"
        DISPLAY "state=RUNNING"
        DISPLAY "msg=SYSTEM ALREADY ACTIVE"
        GOBACK
    END-IF
    MOVE "CLASSIFYQ" TO OP-OP
    CALL "BOPSCK" USING BK-OPS-PARMS
    IF OP-CLASS = "CORRUPT"
        DISPLAY "rc=20"
        DISPLAY "msg=START REFUSED: DURABLE STATE CORRUPT"
        DISPLAY "restore from backup or open incident required"
        GOBACK
    END-IF
    IF OP-CLASS = "CLEAN"
        MOVE "START" TO LF-OP
    ELSE
        MOVE "RECOVERY" TO LF-OP
    END-IF
    MOVE WS-A TO LF-REASON
    MOVE WS-B TO LF-OPERATOR
    MOVE WS-C TO LF-CORR
    CALL "BLIFE" USING BK-LIFE-PARMS
    PERFORM SHOW-LIFE.

DO-STATUS.
    MOVE "GET" TO LF-OP
    CALL "BLIFE" USING BK-LIFE-PARMS
    PERFORM SHOW-LIFE.

DO-STOP.
    MOVE "STOP" TO LF-OP
    MOVE WS-A TO LF-REASON
    MOVE WS-B TO LF-OPERATOR
    MOVE WS-C TO LF-CORR
    CALL "BLIFE" USING BK-LIFE-PARMS
    PERFORM SHOW-LIFE.

DO-DRAIN.
    MOVE "DRAIN" TO LF-OP
    MOVE WS-A TO LF-REASON
    MOVE WS-B TO LF-OPERATOR
    MOVE WS-C TO LF-CORR
    CALL "BLIFE" USING BK-LIFE-PARMS
    PERFORM SHOW-LIFE.

DO-RECOVER-BEGIN.
    MOVE "RECOVERY" TO LF-OP
    MOVE WS-A TO LF-REASON
    MOVE WS-B TO LF-OPERATOR
    CALL "BLIFE" USING BK-LIFE-PARMS
    PERFORM SHOW-LIFE.

DO-RECOVER-RESUME.
    MOVE "RESUME" TO LF-OP
    MOVE WS-A TO LF-OPERATOR
    CALL "BLIFE" USING BK-LIFE-PARMS
    PERFORM SHOW-LIFE.

DO-MAINTAIN.
    MOVE "MAINTAIN" TO LF-OP
    MOVE WS-A TO LF-REASON
    MOVE WS-B TO LF-OPERATOR
    CALL "BLIFE" USING BK-LIFE-PARMS
    PERFORM SHOW-LIFE.

SHOW-LIFE.
    DISPLAY "rc=" LF-RC
    DISPLAY "state=" FUNCTION TRIM(LF-STATE)
    DISPLAY "msg=" FUNCTION TRIM(LF-MSG).

DO-INSPECT.
    MOVE "CLASSIFY" TO OP-OP
    CALL "BOPSCK" USING BK-OPS-PARMS
    DISPLAY "rc=" OP-RC.

DO-HEALTH.
    MOVE "HEALTH" TO OP-OP
    CALL "BOPSCK" USING BK-OPS-PARMS
    DISPLAY "rc=" OP-RC.

DO-BACKUP-CREATE.
    MOVE "GET" TO LF-OP
    CALL "BLIFE" USING BK-LIFE-PARMS
    IF LF-STATE = "STOPPED" OR LF-STATE = "DRAINING" OR
       LF-STATE = "MAINTENANCE"
        MOVE "CREATE" TO KU-OP
        MOVE WS-A TO KU-TAG
        MOVE WS-B TO KU-OPERATOR
        MOVE WS-C TO KU-CORR
        CALL "BOPSBK" USING BK-BKU-PARMS
    ELSE
        MOVE "20" TO KU-RC
        DISPLAY "rc=20"
        DISPLAY "msg=BACKUP REQUIRES STOPPED OR DRAINED SYSTEM"
        GOBACK
    END-IF
    PERFORM SHOW-BKU.

DO-BACKUP-VERIFY.
    MOVE "VERIFY" TO KU-OP
    MOVE WS-A TO KU-TAG
    CALL "BOPSBK" USING BK-BKU-PARMS
    PERFORM SHOW-BKU.

DO-RESTORE-VERIFY.
    MOVE "RESTORE-VERIFY" TO KU-OP
    MOVE WS-A TO KU-TAG
    CALL "BOPSBK" USING BK-BKU-PARMS
    PERFORM SHOW-BKU.

DO-RESTORE-APPLY.
    MOVE "GET" TO LF-OP
    CALL "BLIFE" USING BK-LIFE-PARMS
    IF LF-STATE = "RUNNING"
        MOVE "20" TO KU-RC
        DISPLAY "rc=20"
        DISPLAY "msg=RESTORE REFUSED WHILE RUNNING"
        GOBACK
    END-IF
    MOVE "APPLY" TO KU-OP
    MOVE WS-A TO KU-TAG
    MOVE WS-B TO KU-CONFIRM
    MOVE WS-C TO KU-OPERATOR
    MOVE WS-D TO KU-CORR
    CALL "BOPSBK" USING BK-BKU-PARMS
    PERFORM SHOW-BKU.

DO-BACKUP-LIST.
    MOVE SPACES TO KU-OP
    CALL "BOPSBK" USING BK-BKU-PARMS.

DO-BATCH-STATUS.
    MOVE WS-A TO WS-BD
    MOVE "GET" TO EC-OP
    MOVE WS-BD TO EC-BIZDATE
    CALL "BEODCHK" USING BK-EODCHK-PARM WS-EOD-DATA
    DISPLAY "rc=" EC-RC
    DISPLAY "state=" FUNCTION TRIM(EC-STATE)
    DISPLAY "last=" FUNCTION TRIM(EC-LAST-STAGE).

DO-BATCH-LIST.
    MOVE "LIST" TO EC-OP
    CALL "BEODCHK" USING BK-EODCHK-PARM WS-EOD-DATA.

DO-LOCKS-LIST.
    MOVE "LIST" TO LK-OP
    CALL "BOPSSTALE" USING BK-LOCK-PARMS
    DISPLAY "rc=" LK-RC.

DO-LOCKS-RELEASE.
    MOVE "RELEASE" TO LK-OP
    MOVE WS-A TO LK-NAME-IN
    MOVE WS-B TO LK-REASON
    MOVE WS-C TO LK-OPERATOR
    MOVE WS-D TO LK-CORR
    CALL "BOPSSTALE" USING BK-LOCK-PARMS
    DISPLAY "rc=" LK-RC
    DISPLAY "msg=" FUNCTION TRIM(LK-MSG).

DO-CERT-EXPIRING.
    MOVE "EXPSCAN" TO CT-OP
    IF WS-A = SPACES
        MOVE 30 TO WS-DAYS
    ELSE
        MOVE WS-A TO WS-DAYS
    END-IF
    MOVE WS-DAYS TO CT-DAYS
    CALL "BSEC" USING BK-CRT-PARMS WS-P2000 WS-S64
    DISPLAY "rc=" CT-RC
    DISPLAY "count=" CT-COUNT.

DO-CONTRACT.
    DISPLAY "rc=00"
    DISPLAY "contract=KBCLI-1"
    DISPLAY "core=BANKCLI"
    DISPLAY "transport=request-line/keyvalue"
    GOBACK.

DO-CONFIG.
    MOVE "VERIFY" TO CF-OP
    CALL "BOPSCFG" USING BK-CFG-PARMS
    DISPLAY "rc=" CF-RC
    DISPLAY "msg=" FUNCTION TRIM(CF-MSG).

DO-CORRELATE.
    MOVE WS-A TO CO-ID
    CALL "BOPSCO" USING BK-CO-PARMS
    DISPLAY "rc=" CO-RC
    DISPLAY "hits=" CO-COUNT.

DO-INC-OPEN.
    MOVE "OPEN" TO IN-OP
    MOVE WS-A TO IN-KEY
    MOVE WS-B TO IN-SUMMARY
    MOVE WS-C TO IN-SEV
    MOVE WS-D TO IN-OPERATOR
    MOVE WS-E TO IN-EVIDENCE
    CALL "BOPSINC" USING BK-INC-PARMS
    PERFORM SHOW-INC.

DO-INC-ACK.
    MOVE "ACK" TO IN-OP
    MOVE WS-A TO IN-KEY
    MOVE WS-B TO IN-OPERATOR
    CALL "BOPSINC" USING BK-INC-PARMS
    PERFORM SHOW-INC.

DO-INC-RESOLVE.
    MOVE "RESOLVE" TO IN-OP
    MOVE WS-A TO IN-KEY
    MOVE WS-B TO IN-ACTION
    MOVE WS-C TO IN-OPERATOR
    CALL "BOPSINC" USING BK-INC-PARMS
    PERFORM SHOW-INC.

DO-INC-SHOW.
    MOVE "SHOW" TO IN-OP
    MOVE WS-A TO IN-KEY
    CALL "BOPSINC" USING BK-INC-PARMS
    PERFORM SHOW-INC.

DO-INC-LIST.
    MOVE "LIST" TO IN-OP
    CALL "BOPSINC" USING BK-INC-PARMS
    DISPLAY "rc=" IN-RC.

SHOW-INC.
    DISPLAY "rc=" IN-RC
    DISPLAY "state=" FUNCTION TRIM(IN-STATE)
    DISPLAY "sev=" FUNCTION TRIM(IN-SEV)
    DISPLAY "msg=" FUNCTION TRIM(IN-MSG).

SHOW-BKU.
    DISPLAY "rc=" KU-RC
    DISPLAY "files=" KU-COUNT
    DISPLAY "msg=" FUNCTION TRIM(KU-MSG).
