IDENTIFICATION DIVISION.
PROGRAM-ID. BCUSTS.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CUST-FILE ASSIGN TO WS-CUST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CU-CUST-ID
        FILE STATUS IS WS-CUST-ST.

DATA DIVISION.
FILE SECTION.
FD CUST-FILE.
01 CUST-REC.
   05 CU-CUST-ID PIC X(12).
   05 CU-CUST-TYPE PIC X(01).
   05 CU-CUST-STATUS PIC X(02).
   05 CU-CUST-NAME PIC X(60).
   05 CU-CUST-DOC-TYPE PIC X(04).
   05 CU-CUST-DOC PIC X(20).
   05 CU-CUST-BIRTH PIC 9(08).
   05 CU-CUST-RISK PIC X(02).
   05 CU-CUST-KYC PIC X(02).
   05 CU-CUST-ADDR PIC X(80).
   05 CU-CUST-CREATED PIC 9(08).
   05 CU-CUST-UPDATED PIC 9(08).
   05 CU-CUST-VERSION PIC 9(05).
   05 CU-CUST-HASH PIC X(16).

WORKING-STORAGE SECTION.
01 WS-CUST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CUST-ST PIC X(02).
01 WS-OLD PIC X(02).
01 WS-LK-MODE PIC X(01).
01 WS-LK-CUST PIC X(64) VALUE "WR-CUST".
01 WS-LK-STATUS PIC X(02).
COPY "BKAUDP".
COPY "BKEVTP".
01 WS-EVT-PAYLOAD PIC X(200).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).

LINKAGE SECTION.
01 LS-REQ.
   05 LS-CUST-ID PIC X(12).
   05 LS-NEW-STATUS PIC X(02).
   05 LS-OPERATOR PIC X(12).
   05 LS-CORR PIC X(24).
01 LS-RES.
   05 LS-RC PIC X(02).
   05 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-REQ LS-RES.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CUST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cust.idx"
        DELIMITED SIZE INTO WS-CUST-PATH
    CALL "BCFG" USING WS-CFG
    MOVE "W" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-CUST WS-LK-STATUS
    IF WS-LK-STATUS NOT = "00"
        MOVE WS-LK-STATUS TO LS-RC
        MOVE "CUSTOMER STORE LOCK UNAVAILABLE" TO LS-MSG
        GOBACK
    END-IF
    OPEN I-O CUST-FILE
    IF WS-CUST-ST NOT = "00"
        MOVE "R" TO WS-LK-MODE
        CALL "BWR" USING WS-LK-MODE WS-LK-CUST WS-LK-STATUS
        MOVE "35" TO LS-RC
        MOVE "CUSTOMER FILE MISSING" TO LS-MSG
        GOBACK
    END-IF
    MOVE LS-CUST-ID TO CU-CUST-ID
    READ CUST-FILE
    IF WS-CUST-ST = "00"
        PERFORM APPLY-STATUS
    ELSE
        MOVE "23" TO LS-RC
        MOVE "CUSTOMER NOT FOUND" TO LS-MSG
    END-IF
    CLOSE CUST-FILE
    MOVE "R" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-CUST WS-LK-STATUS
    GOBACK.

APPLY-STATUS.
    MOVE CU-CUST-STATUS TO WS-OLD
    EVALUATE TRUE
        WHEN WS-OLD = "AC" AND (LS-NEW-STATUS = "BL" OR
             LS-NEW-STATUS = "CL")
            CONTINUE
        WHEN WS-OLD = "BL" AND (LS-NEW-STATUS = "AC" OR
             LS-NEW-STATUS = "CL")
            CONTINUE
        WHEN WS-OLD = "CL" AND LS-NEW-STATUS = "AC"
            CONTINUE
        WHEN OTHER
            MOVE "20" TO LS-RC
            MOVE "INVALID STATUS TRANSITION" TO LS-MSG
            EXIT PARAGRAPH
    END-EVALUATE
    MOVE LS-NEW-STATUS TO CU-CUST-STATUS
    MOVE WS-BIZDATE TO CU-CUST-UPDATED
    ADD 1 TO CU-CUST-VERSION
    REWRITE CUST-REC
        INVALID KEY
            MOVE "30" TO LS-RC
            MOVE "REWRITE FAILED" TO LS-MSG
        NOT INVALID KEY
            MOVE "00" TO LS-RC
    END-REWRITE
    IF LS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE LS-OPERATOR TO BK-AUD-OPERATOR
    MOVE "CUST.STATUS" TO BK-AUD-ACTION
    MOVE LS-CUST-ID TO BK-AUD-ENTITY
    MOVE LS-CORR TO BK-AUD-CORR
    MOVE WS-OLD TO BK-AUD-BEFORE
    MOVE LS-NEW-STATUS TO BK-AUD-AFTER
    MOVE "00" TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE SPACES TO WS-EVT-PAYLOAD
    STRING FUNCTION TRIM(LS-CUST-ID) DELIMITED SIZE
        "|" DELIMITED SIZE WS-OLD DELIMITED SIZE
        "|" DELIMITED SIZE LS-NEW-STATUS DELIMITED SIZE
        INTO WS-EVT-PAYLOAD
    END-STRING
    MOVE "CUSTOMER.STATUS.v1" TO BK-EVT-TYPE
    MOVE LS-CUST-ID TO BK-EVT-KEY
    MOVE WS-EVT-PAYLOAD TO BK-EVT-PAYLOAD
    CALL "BEVT" USING BK-EVT-PARMS
    MOVE "STATUS CHANGED" TO LS-MSG.
