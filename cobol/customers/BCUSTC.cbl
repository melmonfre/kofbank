IDENTIFICATION DIVISION.
PROGRAM-ID. BCUSTC.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CUST-FILE ASSIGN TO WS-CUST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CU-CUST-ID
        FILE STATUS IS WS-CUST-ST.
    SELECT DOC-FILE ASSIGN TO WS-DOC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS DC-DOC-KEY
        FILE STATUS IS WS-DOC-ST.

DATA DIVISION.
FILE SECTION.
FD CUST-FILE.
01 CUST-REC.
   05 CU-CUST-ID PIC X(12).
   05 CU-CUST-TYPE PIC X(01).
   05 CU-CUST-STATUS PIC X(02).
   05 CU-CUST-NAME PIC X(60).
   05 CU-CUST-DOC-TYPE PIC X(04).
   05 CU-CUST-DOC PIC X(20).
   05 CU-CUST-BIRTH PIC 9(08).
   05 CU-CUST-RISK PIC X(02).
   05 CU-CUST-KYC PIC X(02).
   05 CU-CUST-ADDR PIC X(80).
   05 CU-CUST-CREATED PIC 9(08).
   05 CU-CUST-UPDATED PIC 9(08).
   05 CU-CUST-VERSION PIC 9(05).
   05 CU-CUST-HASH PIC X(16).
FD DOC-FILE.
01 DOC-REC.
   05 DC-DOC-KEY PIC X(24).
   05 DC-CUST-ID PIC X(12).

WORKING-STORAGE SECTION.
01 WS-CUST-PATH PIC X(200).
01 WS-DOC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CUST-ST PIC X(02).
01 WS-DOC-ST PIC X(02).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CUSTOMER".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
COPY "BDOCP".
01 WS-DOC-CANON PIC X(24).
COPY "BKAUDP".
COPY "BKEVTP".
01 WS-EVT-PAYLOAD PIC X(200).

LINKAGE SECTION.
01 LS-REQ.
   05 LS-CUST-TYPE PIC X(01).
   05 LS-NAME PIC X(60).
   05 LS-DOC-TYPE PIC X(04).
   05 LS-DOC PIC X(20).
   05 LS-BIRTH PIC 9(08).
   05 LS-ADDR PIC X(80).
   05 LS-OPERATOR PIC X(12).
   05 LS-CORR PIC X(24).
01 LS-RESULT.
   05 LS-RES-CUST-ID PIC X(12).
   05 LS-RES-HASH PIC X(16).
   05 LS-RES-STATUS PIC X(02).
   05 LS-RES-MSG PIC X(80).

PROCEDURE DIVISION USING LS-REQ LS-RESULT.
    MOVE SPACES TO LS-RES-CUST-ID
    MOVE SPACES TO LS-RES-HASH
    MOVE "00" TO LS-RES-STATUS
    MOVE SPACES TO LS-RES-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    PERFORM RESOLVE-PATHS
    IF LS-NAME = SPACES OR LS-DOC = SPACES
        MOVE "20" TO LS-RES-STATUS
        MOVE "NAME AND DOC REQUIRED" TO LS-RES-MSG
        GOBACK
    END-IF
    IF LS-CUST-TYPE NOT = "P" AND LS-CUST-TYPE NOT = "J"
        MOVE "20" TO LS-RES-STATUS
        MOVE "INVALID CUSTOMER TYPE" TO LS-RES-MSG
        GOBACK
    END-IF
    CALL "BCFG" USING WS-CFG
    MOVE WS-BIZDATE TO CU-CUST-CREATED
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    STRING "C" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO LS-RES-CUST-ID
    END-STRING
    PERFORM PREPARE-DOC
    PERFORM RESERVE-DOC
    IF LS-RES-STATUS NOT = "00"
        GOBACK
    END-IF
    PERFORM BUILD-RECORD
    PERFORM WRITE-CUSTOMER
    GOBACK.

RESOLVE-PATHS.
    MOVE SPACES TO WS-CUST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cust.idx"
        DELIMITED SIZE INTO WS-CUST-PATH
    MOVE SPACES TO WS-DOC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/custdoc.idx"
        DELIMITED SIZE INTO WS-DOC-PATH.

PREPARE-DOC.
    MOVE SPACES TO WS-DOC-CANON
    IF LS-DOC-TYPE = "CPF" OR LS-DOC-TYPE = "CNPJ"
        MOVE "CANON" TO BD-OP
        MOVE LS-DOC-TYPE TO BD-TYPE
        MOVE LS-DOC TO BD-IN
        CALL "BDOC" USING BK-DOC-PARMS
        IF BD-RC NOT = "00"
            MOVE BD-RC TO LS-RES-STATUS
            MOVE BD-MSG TO LS-RES-MSG
            GOBACK
        END-IF
        MOVE BD-CANON TO WS-DOC-CANON
    ELSE
        MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(LS-DOC))
            TO WS-DOC-CANON
    END-IF.

RESERVE-DOC.
    MOVE SPACES TO DC-DOC-KEY
    STRING LS-DOC-TYPE DELIMITED SIZE WS-DOC-CANON DELIMITED SIZE
        INTO DC-DOC-KEY
    END-STRING
    MOVE LS-RES-CUST-ID TO DC-CUST-ID
    OPEN I-O DOC-FILE
    IF WS-DOC-ST = "35"
        OPEN OUTPUT DOC-FILE
        CLOSE DOC-FILE
        OPEN I-O DOC-FILE
    END-IF
    IF WS-DOC-ST NOT = "00"
        MOVE WS-DOC-ST TO LS-RES-STATUS
        MOVE "CANNOT OPEN DOC INDEX" TO LS-RES-MSG
        GOBACK
    END-IF
    WRITE DOC-REC
        INVALID KEY
            MOVE "22" TO LS-RES-STATUS
            MOVE "DOCUMENT ALREADY REGISTERED" TO LS-RES-MSG
        NOT INVALID KEY
            MOVE "00" TO LS-RES-STATUS
    END-WRITE
    CLOSE DOC-FILE.

BUILD-RECORD.
    MOVE LS-RES-CUST-ID TO CU-CUST-ID
    MOVE LS-CUST-TYPE TO CU-CUST-TYPE
    MOVE "AC" TO CU-CUST-STATUS
    MOVE LS-NAME TO CU-CUST-NAME
    MOVE LS-DOC-TYPE TO CU-CUST-DOC-TYPE
    MOVE LS-DOC TO CU-CUST-DOC
    MOVE LS-BIRTH TO CU-CUST-BIRTH
    MOVE "01" TO CU-CUST-RISK
    MOVE "PE" TO CU-CUST-KYC
    MOVE LS-ADDR TO CU-CUST-ADDR
    MOVE WS-BIZDATE TO CU-CUST-CREATED
    MOVE WS-BIZDATE TO CU-CUST-UPDATED
    MOVE 1 TO CU-CUST-VERSION
    MOVE SPACES TO CU-CUST-HASH
    MOVE SPACES TO WS-HASH-BUF
    STRING CU-CUST-ID DELIMITED SIZE CU-CUST-TYPE DELIMITED SIZE
        CU-CUST-NAME DELIMITED SIZE CU-CUST-DOC-TYPE DELIMITED SIZE
        CU-CUST-DOC DELIMITED SIZE CU-CUST-BIRTH DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO CU-CUST-HASH
    MOVE WS-HASH TO LS-RES-HASH.

WRITE-CUSTOMER.
    OPEN I-O CUST-FILE
    IF WS-CUST-ST = "35"
        OPEN OUTPUT CUST-FILE
        CLOSE CUST-FILE
        OPEN I-O CUST-FILE
    END-IF
    IF WS-CUST-ST NOT = "00"
        MOVE WS-CUST-ST TO LS-RES-STATUS
        MOVE "CANNOT OPEN CUSTOMER INDEX" TO LS-RES-MSG
        GOBACK
    END-IF
    WRITE CUST-REC
        INVALID KEY
            MOVE "22" TO LS-RES-STATUS
            MOVE "CUSTOMER ALREADY EXISTS" TO LS-RES-MSG
    END-WRITE
    CLOSE CUST-FILE
    IF LS-RES-STATUS NOT = "00"
        GOBACK
    END-IF
    MOVE LS-OPERATOR TO BK-AUD-OPERATOR
    MOVE "CUST.CREATE" TO BK-AUD-ACTION
    MOVE LS-RES-CUST-ID TO BK-AUD-ENTITY
    MOVE LS-CORR TO BK-AUD-CORR
    MOVE LS-RES-CUST-ID TO BK-AUD-BEFORE
    MOVE "CREATED" TO BK-AUD-AFTER
    MOVE "00" TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE SPACES TO WS-EVT-PAYLOAD
    STRING FUNCTION TRIM(LS-RES-CUST-ID) DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(LS-NAME) DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(LS-DOC-TYPE) DELIMITED SIZE
        FUNCTION TRIM(LS-DOC) DELIMITED SIZE
        INTO WS-EVT-PAYLOAD
    END-STRING
    MOVE "CUSTOMER.CREATED.v1" TO BK-EVT-TYPE
    MOVE LS-RES-CUST-ID TO BK-EVT-KEY
    MOVE WS-EVT-PAYLOAD TO BK-EVT-PAYLOAD
    CALL "BEVT" USING BK-EVT-PARMS
    MOVE "00" TO LS-RES-STATUS
    MOVE "CREATED" TO LS-RES-MSG.
