IDENTIFICATION DIVISION.
PROGRAM-ID. BCUSTCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(20).
01 WS-A PIC X(60).
01 WS-B PIC X(20).
01 WS-C PIC X(20).
01 WS-D PIC X(20).
01 WS-E PIC X(80).
01 WS-F PIC X(12).
01 WS-G PIC X(24).
01 WS-REQ.
   05 REQ-TYPE PIC X(01).
   05 REQ-NAME PIC X(60).
   05 REQ-DOC-TYPE PIC X(04).
   05 REQ-DOC PIC X(20).
   05 REQ-BIRTH PIC 9(08).
   05 REQ-ADDR PIC X(80).
   05 REQ-OPERATOR PIC X(12).
   05 REQ-CORR PIC X(24).
01 WS-RES.
   05 RES-ID PIC X(12).
   05 RES-HASH PIC X(16).
   05 RES-STATUS PIC X(02).
   05 RES-MSG PIC X(80).
01 WS-URES.
   05 URES-RC PIC X(02).
   05 URES-MSG PIC X(80).
01 WS-SRES.
   05 SRES-RC PIC X(02).
   05 SRES-MSG PIC X(80).
01 WS-UREQ.
   05 UREQ-ID PIC X(12).
   05 UREQ-NAME PIC X(60).
   05 UREQ-ADDR PIC X(80).
   05 UREQ-OPERATOR PIC X(12).
   05 UREQ-CORR PIC X(24).
01 WS-SREQ.
   05 SREQ-ID PIC X(12).
   05 SREQ-STATUS PIC X(02).
   05 SREQ-OPERATOR PIC X(12).
   05 SREQ-CORR PIC X(24).
01 WS-OUT.
   05 OUT-ID PIC X(12).
   05 OUT-TYPE PIC X(01).
   05 OUT-STATUS PIC X(02).
   05 OUT-NAME PIC X(60).
   05 OUT-DOC-TYPE PIC X(04).
   05 OUT-DOC PIC X(20).
   05 OUT-BIRTH PIC 9(08).
   05 OUT-RISK PIC X(02).
   05 OUT-KYC PIC X(02).
   05 OUT-ADDR PIC X(80).
   05 OUT-VERSION PIC 9(05).
   05 OUT-HASH PIC X(16).
   05 OUT-RC PIC X(02).

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "create" PERFORM DO-CREATE
        WHEN "get" PERFORM DO-GET
        WHEN "update" PERFORM DO-UPDATE
        WHEN "status" PERFORM DO-STATUS
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN CUSTOMER OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G
    END-UNSTRING.

DO-CREATE.
    MOVE WS-A(1:1) TO REQ-TYPE
    MOVE WS-B TO REQ-NAME
    MOVE WS-C TO REQ-DOC-TYPE
    MOVE WS-D TO REQ-DOC
    MOVE 0 TO REQ-BIRTH
    IF WS-E(1:1) NUMERIC
        MOVE WS-E TO REQ-BIRTH
    END-IF
    MOVE WS-F TO REQ-OPERATOR
    MOVE WS-G TO REQ-CORR
    CALL "BCUSTC" USING WS-REQ WS-RES
    DISPLAY "rc=" RES-STATUS
    DISPLAY "id=" FUNCTION TRIM(RES-ID)
    DISPLAY "hash=" FUNCTION TRIM(RES-HASH)
    DISPLAY "msg=" FUNCTION TRIM(RES-MSG).

DO-GET.
    CALL "BCUSTQ" USING WS-A WS-OUT
    DISPLAY "rc=" OUT-RC
    IF OUT-RC = "00"
        DISPLAY "id=" FUNCTION TRIM(OUT-ID)
        DISPLAY "name=" FUNCTION TRIM(OUT-NAME)
        DISPLAY "type=" OUT-TYPE
        DISPLAY "status=" OUT-STATUS
        DISPLAY "doc=" FUNCTION TRIM(OUT-DOC-TYPE) FUNCTION TRIM(OUT-DOC)
        DISPLAY "risk=" OUT-RISK
        DISPLAY "kyc=" OUT-KYC
        DISPLAY "version=" OUT-VERSION
        DISPLAY "hash=" FUNCTION TRIM(OUT-HASH)
    END-IF.

DO-UPDATE.
    MOVE WS-A TO UREQ-ID
    MOVE WS-B TO UREQ-NAME
    MOVE WS-C TO UREQ-ADDR
    MOVE WS-D TO UREQ-OPERATOR
    MOVE WS-E TO UREQ-CORR
    CALL "BCUSTU" USING WS-UREQ WS-URES
    DISPLAY "rc=" URES-RC
    DISPLAY "msg=" FUNCTION TRIM(URES-MSG).

DO-STATUS.
    MOVE WS-A TO SREQ-ID
    MOVE WS-B TO SREQ-STATUS
    MOVE WS-C TO SREQ-OPERATOR
    MOVE WS-D TO SREQ-CORR
    CALL "BCUSTS" USING WS-SREQ WS-SRES
    DISPLAY "rc=" SRES-RC
    DISPLAY "msg=" FUNCTION TRIM(SRES-MSG).
