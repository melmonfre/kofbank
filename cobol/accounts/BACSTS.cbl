IDENTIFICATION DIVISION.
PROGRAM-ID. BACSTS.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCT-FILE ASSIGN TO WS-ACCT-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS AC-ACCT-ID
        FILE STATUS IS WS-ACCT-ST.

DATA DIVISION.
FILE SECTION.
FD ACCT-FILE.
01 ACCT-REC.
   05 AC-ACCT-ID PIC X(12).
   05 AC-ACCT-CUST-ID PIC X(12).
   05 AC-ACCT-PRODUCT PIC X(04).
   05 AC-ACCT-CURRENCY PIC X(03).
   05 AC-ACCT-STATUS PIC X(02).
   05 AC-ACCT-OPENED PIC 9(08).
   05 AC-ACCT-CLOSED PIC 9(08).
   05 AC-ACCT-VERSION PIC 9(05).
   05 AC-ACCT-HASH PIC X(16).

WORKING-STORAGE SECTION.
01 WS-ACCT-PATH PIC X(200).
01 WS-HOME PIC X(80).
 01 WS-ACCT-ST PIC X(02).
 01 WS-OLD PIC X(02).
 01 WS-LK-MODE PIC X(01).
 01 WS-LK-ACCT PIC X(64) VALUE "WR-ACCT".
 01 WS-LK-STATUS PIC X(02).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BKAUDP".
COPY "BKEVTP".
01 WS-EVT-PAYLOAD PIC X(200).

LINKAGE SECTION.
01 LS-REQ.
   05 LS-ACCT-ID PIC X(12).
   05 LS-NEW-STATUS PIC X(02).
   05 LS-OPERATOR PIC X(12).
   05 LS-CORR PIC X(24).
01 LS-RES.
   05 LS-RC PIC X(02).
   05 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-REQ LS-RES.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-ACCT-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/acct.idx"
        DELIMITED SIZE INTO WS-ACCT-PATH
    CALL "BCFG" USING WS-CFG
    MOVE "W" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-ACCT WS-LK-STATUS
    IF WS-LK-STATUS NOT = "00"
        MOVE WS-LK-STATUS TO LS-RC
        MOVE "ACCOUNT STORE LOCK UNAVAILABLE" TO LS-MSG
        GOBACK
    END-IF
    OPEN I-O ACCT-FILE
    IF WS-ACCT-ST NOT = "00"
        MOVE "R" TO WS-LK-MODE
        CALL "BWR" USING WS-LK-MODE WS-LK-ACCT WS-LK-STATUS
        MOVE "35" TO LS-RC
        MOVE "ACCOUNT FILE MISSING" TO LS-MSG
        GOBACK
    END-IF
    MOVE LS-ACCT-ID TO AC-ACCT-ID
    READ ACCT-FILE
    IF WS-ACCT-ST = "00"
        PERFORM APPLY-STATUS
    ELSE
        MOVE "23" TO LS-RC
        MOVE "ACCOUNT NOT FOUND" TO LS-MSG
    END-IF
    CLOSE ACCT-FILE
    MOVE "R" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-ACCT WS-LK-STATUS
    GOBACK.

APPLY-STATUS.
    MOVE AC-ACCT-STATUS TO WS-OLD
    EVALUATE TRUE
        WHEN WS-OLD = "AC" AND (LS-NEW-STATUS = "BL" OR
             LS-NEW-STATUS = "CL")
            CONTINUE
        WHEN WS-OLD = "BL" AND (LS-NEW-STATUS = "AC" OR
             LS-NEW-STATUS = "CL")
            CONTINUE
        WHEN WS-OLD = "CL" AND LS-NEW-STATUS = "AC"
            CONTINUE
        WHEN OTHER
            MOVE "20" TO LS-RC
            MOVE "INVALID STATUS TRANSITION" TO LS-MSG
            EXIT PARAGRAPH
    END-EVALUATE
    MOVE LS-NEW-STATUS TO AC-ACCT-STATUS
    IF LS-NEW-STATUS = "CL"
        MOVE WS-BIZDATE TO AC-ACCT-CLOSED
    END-IF
    ADD 1 TO AC-ACCT-VERSION
    REWRITE ACCT-REC
        INVALID KEY
            MOVE "30" TO LS-RC
            MOVE "REWRITE FAILED" TO LS-MSG
        NOT INVALID KEY
            MOVE "00" TO LS-RC
    END-REWRITE
    IF LS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE LS-OPERATOR TO BK-AUD-OPERATOR
    MOVE "ACCT.STATUS" TO BK-AUD-ACTION
    MOVE LS-ACCT-ID TO BK-AUD-ENTITY
    MOVE LS-CORR TO BK-AUD-CORR
    MOVE WS-OLD TO BK-AUD-BEFORE
    MOVE LS-NEW-STATUS TO BK-AUD-AFTER
    MOVE "00" TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE SPACES TO WS-EVT-PAYLOAD
    STRING FUNCTION TRIM(LS-ACCT-ID) DELIMITED SIZE
        "|" DELIMITED SIZE WS-OLD DELIMITED SIZE
        "|" DELIMITED SIZE LS-NEW-STATUS DELIMITED SIZE
        INTO WS-EVT-PAYLOAD
    END-STRING
    IF LS-NEW-STATUS = "BL"
        MOVE "ACCOUNT.BLOCKED.v1" TO BK-EVT-TYPE
    ELSE
        IF LS-NEW-STATUS = "CL"
            MOVE "ACCOUNT.CLOSED.v1" TO BK-EVT-TYPE
        ELSE
            MOVE "ACCOUNT.STATUS.v1" TO BK-EVT-TYPE
        END-IF
    END-IF
    MOVE LS-ACCT-ID TO BK-EVT-KEY
    MOVE WS-EVT-PAYLOAD TO BK-EVT-PAYLOAD
    CALL "BEVT" USING BK-EVT-PARMS
    MOVE "STATUS CHANGED" TO LS-MSG.
