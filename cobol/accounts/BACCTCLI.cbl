IDENTIFICATION DIVISION.
PROGRAM-ID. BACCTCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(20).
01 WS-A PIC X(24).
01 WS-B PIC X(20).
01 WS-C PIC X(20).
01 WS-D PIC X(20).
01 WS-E PIC X(20).
01 WS-F PIC X(12).
01 WS-G PIC X(24).
01 WS-H PIC X(24).
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT-ED PIC -(15)9.99.
01 WS-OPEN-REQ.
   05 OREQ-CUST PIC X(12).
   05 OREQ-PRODUCT PIC X(04).
   05 OREQ-CURRENCY PIC X(03).
   05 OREQ-INITIAL PIC S9(15)V99 COMP-3.
   05 OREQ-OPERATOR PIC X(12).
   05 OREQ-CORR PIC X(24).
   05 OREQ-REQUEST PIC X(24).
01 WS-OPEN-RES.
   05 ORES-ID PIC X(12).
   05 ORES-RC PIC X(02).
   05 ORES-MSG PIC X(80).
01 WS-GET-OUT.
   05 GOUT-ID PIC X(12).
   05 GOUT-CUST PIC X(12).
   05 GOUT-PRODUCT PIC X(04).
   05 GOUT-CURRENCY PIC X(03).
   05 GOUT-STATUS PIC X(02).
   05 GOUT-OPENED PIC 9(08).
   05 GOUT-CLOSED PIC 9(08).
   05 GOUT-VERSION PIC 9(05).
   05 GOUT-HASH PIC X(16).
   05 GOUT-RC PIC X(02).
01 WS-FND-CUST PIC X(12).
01 WS-FND-COUNT PIC 9(06).
01 WS-FND-RC PIC X(02).
01 WS-STS-REQ.
   05 SREQ-ID PIC X(12).
   05 SREQ-STATUS PIC X(02).
   05 SREQ-OPERATOR PIC X(12).
   05 SREQ-CORR PIC X(24).
01 WS-STS-RES.
   05 SRES-RC PIC X(02).
   05 SRES-MSG PIC X(80).

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "open" PERFORM DO-OPEN
        WHEN "get" PERFORM DO-GET
        WHEN "find" PERFORM DO-FIND
        WHEN "status" PERFORM DO-STATUS
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN ACCOUNT OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H
    END-UNSTRING.

DO-OPEN.
    MOVE WS-A TO OREQ-CUST
    MOVE WS-B TO OREQ-PRODUCT
    MOVE WS-C TO OREQ-CURRENCY
    MOVE 0 TO WS-AMT
    IF WS-D NOT = SPACES
        MOVE WS-D TO WS-AMT
    END-IF
    MOVE WS-AMT TO OREQ-INITIAL
    MOVE WS-E TO OREQ-OPERATOR
    MOVE WS-F TO OREQ-CORR
    MOVE WS-G TO OREQ-REQUEST
    CALL "BACOPN" USING WS-OPEN-REQ WS-OPEN-RES
    DISPLAY "rc=" ORES-RC
    DISPLAY "id=" FUNCTION TRIM(ORES-ID)
    DISPLAY "msg=" FUNCTION TRIM(ORES-MSG).

DO-GET.
    CALL "BACQRY" USING WS-A WS-GET-OUT
    DISPLAY "rc=" GOUT-RC
    IF GOUT-RC = "00"
        DISPLAY "id=" FUNCTION TRIM(GOUT-ID)
        DISPLAY "customer=" FUNCTION TRIM(GOUT-CUST)
        DISPLAY "product=" FUNCTION TRIM(GOUT-PRODUCT)
        DISPLAY "currency=" FUNCTION TRIM(GOUT-CURRENCY)
        DISPLAY "status=" GOUT-STATUS
        DISPLAY "opened=" GOUT-OPENED
        DISPLAY "version=" GOUT-VERSION
        DISPLAY "hash=" FUNCTION TRIM(GOUT-HASH)
    END-IF.

DO-FIND.
    MOVE SPACES TO WS-FND-CUST
    MOVE WS-A TO WS-FND-CUST
    CALL "BACLIST" USING WS-FND-CUST WS-FND-COUNT WS-FND-RC.

DO-STATUS.
    MOVE WS-A TO SREQ-ID
    MOVE WS-B TO SREQ-STATUS
    MOVE WS-C TO SREQ-OPERATOR
    MOVE WS-D TO SREQ-CORR
    CALL "BACSTS" USING WS-STS-REQ WS-STS-RES
    DISPLAY "rc=" SRES-RC
    DISPLAY "msg=" FUNCTION TRIM(SRES-MSG).
