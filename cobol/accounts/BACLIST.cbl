IDENTIFICATION DIVISION.
PROGRAM-ID. BACLIST.

*> Read-only inquiry: list account ids owned by a customer.
*> Financial authority stays in the account store; this program
*> never mutates records.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCT-FILE ASSIGN TO WS-ACCT-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS AC-ACCT-ID
        FILE STATUS IS WS-ACCT-ST.

DATA DIVISION.
FILE SECTION.
FD ACCT-FILE.
01 ACCT-REC.
   05 AC-ACCT-ID PIC X(12).
   05 AC-ACCT-CUST-ID PIC X(12).
   05 AC-ACCT-PRODUCT PIC X(04).
   05 AC-ACCT-CURRENCY PIC X(03).
   05 AC-ACCT-STATUS PIC X(02).
   05 AC-ACCT-OPENED PIC 9(08).
   05 AC-ACCT-CLOSED PIC 9(08).
   05 AC-ACCT-VERSION PIC 9(05).
   05 AC-ACCT-HASH PIC X(16).

WORKING-STORAGE SECTION.
01 WS-ACCT-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-ACCT-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-COUNT PIC 9(06).

LINKAGE SECTION.
01 LS-CUST-ID PIC X(12).
01 LS-COUNT PIC 9(06).
01 LS-RC PIC X(02).

PROCEDURE DIVISION USING LS-CUST-ID LS-COUNT LS-RC.
    MOVE "00" TO LS-RC
    MOVE 0 TO LS-COUNT
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-ACCT-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/acct.idx"
        DELIMITED SIZE INTO WS-ACCT-PATH
    OPEN INPUT ACCT-FILE
    IF WS-ACCT-ST NOT = "00"
        MOVE "35" TO LS-RC
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ ACCT-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF AC-ACCT-CUST-ID = LS-CUST-ID
                    ADD 1 TO LS-COUNT
                    DISPLAY "id=" FUNCTION TRIM(AC-ACCT-ID)
                        " status=" AC-ACCT-STATUS
                        " currency=" FUNCTION TRIM(AC-ACCT-CURRENCY)
                        " opened=" AC-ACCT-OPENED
                END-IF
        END-READ
    END-PERFORM
    CLOSE ACCT-FILE
    DISPLAY "rc=" LS-RC
    DISPLAY "count=" LS-COUNT.
