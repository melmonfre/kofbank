IDENTIFICATION DIVISION.
PROGRAM-ID. BACOPN.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCT-FILE ASSIGN TO WS-ACCT-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS AC-ACCT-ID
        FILE STATUS IS WS-ACCT-ST.

DATA DIVISION.
FILE SECTION.
FD ACCT-FILE.
01 ACCT-REC.
   05 AC-ACCT-ID PIC X(12).
   05 AC-ACCT-CUST-ID PIC X(12).
   05 AC-ACCT-PRODUCT PIC X(04).
   05 AC-ACCT-CURRENCY PIC X(03).
   05 AC-ACCT-STATUS PIC X(02).
   05 AC-ACCT-OPENED PIC 9(08).
   05 AC-ACCT-CLOSED PIC 9(08).
   05 AC-ACCT-VERSION PIC 9(05).
   05 AC-ACCT-HASH PIC X(16).

WORKING-STORAGE SECTION.
01 WS-ACCT-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-ACCT-ST PIC X(02).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "ACCOUNT".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-PRD-ST PIC X(02).
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BKJRNP".
COPY "BKPSTT".
COPY "BKIDMP".
COPY "BPRODO".
01 WS-EVT-PAYLOAD PIC X(200).
01 WS-JRN-ID-BUF PIC X(20).
01 WS-IDM-HIT PIC X(01) VALUE "N".
01 WS-CUST-OUT.
   05 WS-CUST-ID-OUT PIC X(12).
   05 WS-CUST-TYPE PIC X(01).
   05 WS-CUST-STATUS PIC X(02).
   05 WS-CUST-NAME PIC X(60).
   05 WS-CUST-DOC-TYPE PIC X(04).
   05 WS-CUST-DOC PIC X(20).
   05 WS-CUST-BIRTH PIC 9(08).
   05 WS-CUST-RISK PIC X(02).
   05 WS-CUST-KYC PIC X(02).
   05 WS-CUST-ADDR PIC X(80).
   05 WS-CUST-VERSION PIC 9(05).
   05 WS-CUST-HASH PIC X(16).
   05 WS-CUST-RC PIC X(02).

LINKAGE SECTION.
01 LS-REQ.
   05 LS-CUST-ID PIC X(12).
   05 LS-PRODUCT PIC X(04).
   05 LS-CURRENCY PIC X(03).
   05 LS-INITIAL PIC S9(15)V99 COMP-3.
   05 LS-OPERATOR PIC X(12).
   05 LS-CORR PIC X(24).
   05 LS-REQUEST PIC X(24).
01 LS-RES.
   05 LS-ACCT-ID PIC X(12).
   05 LS-RC PIC X(02).
   05 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-REQ LS-RES.
    MOVE SPACES TO LS-ACCT-ID
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    PERFORM RESOLVE-PATHS
    PERFORM CHECK-IDEMPOTENCY
    IF WS-IDM-HIT = "Y"
        GOBACK
    END-IF
    IF LS-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM VALIDATE-CUSTOMER
    IF LS-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM VALIDATE-PRODUCT
    IF LS-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-MINIMUM
    IF LS-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CREATE-ACCOUNT
    IF LS-RC NOT = "00"
        GOBACK
    END-IF
    IF LS-INITIAL > 0
        PERFORM POST-INITIAL
    END-IF
    PERFORM FINALIZE
    GOBACK.

RESOLVE-PATHS.
    MOVE SPACES TO WS-ACCT-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/acct.idx"
        DELIMITED SIZE INTO WS-ACCT-PATH
    CONTINUE.

CHECK-IDEMPOTENCY.
    IF LS-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE LS-REQUEST TO BK-IDM-TXN-ID
    MOVE "ACCT.OPEN" TO BK-IDM-OPERATION
    MOVE "B" TO BK-IDM-MODE
    MOVE SPACES TO BK-IDM-RESULT
    CALL "BIDM" USING BK-IDM-PARMS
    IF BK-IDM-STATUS = "22"
        MOVE "G" TO BK-IDM-MODE
        CALL "BIDM" USING BK-IDM-PARMS
        IF BK-IDM-STATUS = "C"
            MOVE BK-IDM-RESULT(1:12) TO LS-ACCT-ID
            MOVE "00" TO LS-RC
            MOVE "IDEMPOTENT REPLAY" TO LS-MSG
            MOVE "Y" TO WS-IDM-HIT
        ELSE
            MOVE "24" TO LS-RC
            MOVE "REQUEST IN PROGRESS" TO LS-MSG
        END-IF
    ELSE
        IF BK-IDM-STATUS NOT = "00"
            MOVE BK-IDM-STATUS TO LS-RC
            MOVE "IDEMPOTENCY STORE ERROR" TO LS-MSG
        END-IF
    END-IF.

VALIDATE-CUSTOMER.
    CALL "BCUSTQ" USING LS-CUST-ID WS-CUST-OUT
    IF WS-CUST-RC NOT = "00"
        MOVE "20" TO LS-RC
        MOVE "CUSTOMER NOT FOUND" TO LS-MSG
        GOBACK
    END-IF
    IF WS-CUST-STATUS NOT = "AC"
        MOVE "20" TO LS-RC
        MOVE "CUSTOMER NOT ACTIVE" TO LS-MSG
    END-IF.

VALIDATE-PRODUCT.
    CALL "BPRDVAL" USING LS-PRODUCT WS-PRD-ST
    IF WS-PRD-ST = "35"
        MOVE "35" TO LS-RC
        MOVE "PRODUCT CONFIG MISSING" TO LS-MSG
        GOBACK
    END-IF
    IF WS-PRD-ST NOT = "00"
        MOVE "20" TO LS-RC
        MOVE "UNKNOWN PRODUCT" TO LS-MSG
    END-IF.

CHECK-MINIMUM.
    CALL "BPRODQ" USING LS-PRODUCT WS-BIZDATE BK-PROD-OUT
    IF PQ-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF LS-INITIAL < PR-MIN-BAL
        MOVE "20" TO LS-RC
        MOVE "BELOW MINIMUM OPENING BALANCE" TO LS-MSG
    END-IF.

CREATE-ACCOUNT.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    STRING "A" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO LS-ACCT-ID
    END-STRING
    MOVE LS-ACCT-ID TO AC-ACCT-ID
    MOVE LS-CUST-ID TO AC-ACCT-CUST-ID
    MOVE LS-PRODUCT TO AC-ACCT-PRODUCT
    MOVE LS-CURRENCY TO AC-ACCT-CURRENCY
    MOVE "AC" TO AC-ACCT-STATUS
    MOVE WS-BIZDATE TO AC-ACCT-OPENED
    MOVE 0 TO AC-ACCT-CLOSED
    MOVE 1 TO AC-ACCT-VERSION
    MOVE SPACES TO WS-HASH-BUF
    STRING AC-ACCT-ID DELIMITED SIZE AC-ACCT-CUST-ID DELIMITED SIZE
        AC-ACCT-PRODUCT DELIMITED SIZE AC-ACCT-CURRENCY DELIMITED SIZE
        AC-ACCT-OPENED DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO AC-ACCT-HASH
    OPEN I-O ACCT-FILE
    IF WS-ACCT-ST = "35"
        OPEN OUTPUT ACCT-FILE
        CLOSE ACCT-FILE
        OPEN I-O ACCT-FILE
    END-IF
    IF WS-ACCT-ST NOT = "00"
        MOVE WS-ACCT-ST TO LS-RC
        MOVE "CANNOT OPEN ACCOUNT INDEX" TO LS-MSG
        GOBACK
    END-IF
    WRITE ACCT-REC
        INVALID KEY
            MOVE "22" TO LS-RC
            MOVE "ACCOUNT ALREADY EXISTS" TO LS-MSG
    END-WRITE
    CLOSE ACCT-FILE.

POST-INITIAL.
    MOVE SPACES TO BK-JRN-ID
    STRING "JRN" DELIMITED SIZE LS-ACCT-ID DELIMITED SIZE
        INTO BK-JRN-ID
    END-STRING
    MOVE LS-CORR TO BK-JRN-TXN-ID
    MOVE "OPENING" TO BK-JRN-TYPE
    MOVE WS-BIZDATE TO BK-JRN-BIZDATE
    MOVE "BATCH" TO BK-JRN-CHANNEL
    MOVE LS-OPERATOR TO BK-JRN-OPERATOR
    MOVE LS-CORR TO BK-JRN-CORR
    MOVE LS-REQUEST TO BK-JRN-REQUEST
    MOVE 2 TO BK-JRN-COUNT
    MOVE "1000" TO BK-PST-GL(1)
    MOVE "D" TO BK-PST-DC(1)
    MOVE LS-INITIAL TO BK-PST-AMOUNT(1)
    MOVE LS-CURRENCY TO BK-PST-CURRENCY(1)
    MOVE SPACES TO BK-PST-ENTITY(1)
    MOVE "INITIAL CASH" TO BK-PST-DESCR(1)
    MOVE WS-BIZDATE TO BK-PST-VALUEDATE(1)
    MOVE "2000" TO BK-PST-GL(2)
    MOVE "C" TO BK-PST-DC(2)
    MOVE LS-INITIAL TO BK-PST-AMOUNT(2)
    MOVE LS-CURRENCY TO BK-PST-CURRENCY(2)
    MOVE LS-ACCT-ID TO BK-PST-ENTITY(2)
    MOVE "INITIAL DEPOSIT" TO BK-PST-DESCR(2)
    MOVE WS-BIZDATE TO BK-PST-VALUEDATE(2)
    CALL "BGLPST" USING BK-JRN-PARMS BK-PST-TABLE
    IF BK-JRN-RC NOT = "00"
        MOVE BK-JRN-RC TO LS-RC
        MOVE BK-JRN-MSG TO LS-MSG
    END-IF.

FINALIZE.
    MOVE LS-OPERATOR TO BK-AUD-OPERATOR
    MOVE "ACCT.OPEN" TO BK-AUD-ACTION
    MOVE LS-ACCT-ID TO BK-AUD-ENTITY
    MOVE LS-CORR TO BK-AUD-CORR
    MOVE LS-CUST-ID TO BK-AUD-BEFORE
    MOVE "OPENED" TO BK-AUD-AFTER
    MOVE LS-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE SPACES TO WS-EVT-PAYLOAD
    STRING FUNCTION TRIM(LS-ACCT-ID) DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(LS-CUST-ID) DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(LS-PRODUCT) DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(LS-CURRENCY) DELIMITED SIZE
        INTO WS-EVT-PAYLOAD
    END-STRING
    MOVE "ACCOUNT.CREATED.v1" TO BK-EVT-TYPE
    MOVE LS-ACCT-ID TO BK-EVT-KEY
    MOVE WS-EVT-PAYLOAD TO BK-EVT-PAYLOAD
    CALL "BEVT" USING BK-EVT-PARMS
    IF LS-REQUEST NOT = SPACES
        MOVE LS-REQUEST TO BK-IDM-TXN-ID
        MOVE LS-ACCT-ID TO BK-IDM-RESULT(1:12)
        MOVE "C" TO BK-IDM-MODE
        CALL "BIDM" USING BK-IDM-PARMS
    END-IF
    IF LS-RC = "00"
        MOVE "OPENED" TO LS-MSG
    END-IF.

