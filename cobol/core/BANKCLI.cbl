IDENTIFICATION DIVISION.
PROGRAM-ID. BANKCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BKLIFP".
01 WS-GATE-RC PIC X(02).
01 WS-LINE PIC X(1000).
01 WS-DOMAIN PIC X(20).
01 WS-CMD PIC X(14).
01 WS-CMD-IN PIC X(14).
01 WS-I2 PIC 9(02).
01 WS-PGM PIC X(08).
01 WS-I PIC 9(04).
01 WS-POS PIC 9(04).

PROCEDURE DIVISION.
    MOVE SPACES TO WS-LINE
    ACCEPT WS-LINE
    IF WS-LINE = SPACES
        DISPLAY "rc=20"
        DISPLAY "msg=EMPTY REQUEST"
        GOBACK
    END-IF
    PERFORM EXTRACT-DOMAIN
    EVALUATE WS-DOMAIN
        WHEN "customer" MOVE "BCUSTCLI" TO WS-PGM
        WHEN "account" MOVE "BACCTCLI" TO WS-PGM
        WHEN "ledger" MOVE "BGLCLI" TO WS-PGM
        WHEN "txn" MOVE "BTXNCLI" TO WS-PGM
        WHEN "payment" MOVE "BPAYCLI" TO WS-PGM
        WHEN "product" MOVE "BPRODCLI" TO WS-PGM
        WHEN "limits" MOVE "BLIMCLI" TO WS-PGM
        WHEN "interest" MOVE "BINTCLI" TO WS-PGM
        WHEN "reconciliation" MOVE "BRECCLI" TO WS-PGM
        WHEN "credit" MOVE "BCRCLI" TO WS-PGM
        WHEN "loan" MOVE "BLNCLI" TO WS-PGM
        WHEN "collections" MOVE "COLCLI" TO WS-PGM
        WHEN "collateral" MOVE "CLTCLI" TO WS-PGM
        WHEN "cards" MOVE "CCRDCLI" TO WS-PGM
        WHEN "clearing" MOVE "CCRCCLI" TO WS-PGM
        WHEN "pix" MOVE "BPXCLI" TO WS-PGM
        WHEN "bnd" MOVE "BBNDCLI" TO WS-PGM
        WHEN "batch" MOVE "BBATCLI" TO WS-PGM
        WHEN "system" MOVE "BOPSCLI" TO WS-PGM
        WHEN "ops" MOVE "BOPSCLI" TO WS-PGM
        WHEN OTHER MOVE SPACES TO WS-PGM
    END-EVALUATE
    IF WS-PGM = SPACES
        DISPLAY "rc=20"
        DISPLAY "msg=UNKNOWN DOMAIN"
        GOBACK
    END-IF
    IF WS-DOMAIN NOT = "system" AND WS-DOMAIN NOT = "ops"
        PERFORM LIFECYCLE-GATE
        IF WS-GATE-RC = "20"
            DISPLAY "rc=20"
            DISPLAY "msg=SYSTEM NOT RUNNING"
            GOBACK
        END-IF
    END-IF
    CALL WS-PGM USING WS-LINE(WS-POS + 1:)
    GOBACK.

LIFECYCLE-GATE.
    MOVE SPACES TO BK-LIFE-PARMS
    MOVE "CHECK" TO LF-OP
    MOVE WS-DOMAIN TO LF-DOMAIN
    MOVE WS-LINE(WS-POS + 1:14) TO WS-CMD-IN
    PERFORM EXTRACT-CMD
    MOVE WS-CMD TO LF-CMD
    CALL "BLIFE" USING BK-LIFE-PARMS
    MOVE LF-RC TO WS-GATE-RC.

EXTRACT-CMD.
    MOVE SPACES TO WS-CMD
    MOVE 0 TO WS-I2
    PERFORM VARYING WS-I FROM 1 BY 1
        UNTIL WS-I > 14 OR WS-CMD-IN (WS-I:1) = "|"
            IF WS-CMD-IN (WS-I:1) = "."
                MOVE WS-I TO WS-I2
            END-IF
            MOVE WS-CMD-IN (WS-I:1) TO WS-CMD (WS-I:1)
    END-PERFORM.

EXTRACT-DOMAIN.
    MOVE SPACES TO WS-DOMAIN
    MOVE 0 TO WS-POS
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 20
        IF WS-LINE(WS-I:1) = "."
            MOVE WS-I TO WS-POS
            EXIT PERFORM
        END-IF
    END-PERFORM
    IF WS-POS > 1
        MOVE WS-LINE(1:WS-POS - 1) TO WS-DOMAIN
    END-IF.
