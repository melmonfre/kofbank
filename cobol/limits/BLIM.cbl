IDENTIFICATION DIVISION.
PROGRAM-ID. BLIM.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CFG-FILE ASSIGN TO WS-CFG-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-CFG-ST.
    SELECT LU-FILE ASSIGN TO WS-LU-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS LU-KEY-GRP
        FILE STATUS IS WS-LU-ST.

DATA DIVISION.
FILE SECTION.
FD CFG-FILE.
01 CFG-LINE PIC X(200).
FD LU-FILE.
01 LU-REC.
   05 LU-KEY-GRP.
      10 LU-SCOPE PIC X(12).
      10 LU-KEY PIC X(20).
      10 LU-PERIOD PIC X(08).
   05 LU-DATE PIC 9(08).
   05 LU-USED PIC S9(15)V99 COMP-3.

WORKING-STORAGE SECTION.
01 WS-CFG-PATH PIC X(200).
01 WS-LU-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CFG-ST PIC X(02).
01 WS-LU-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-FOUND PIC X(01).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST2 PIC X(02).
01 WS-R-SCOPE PIC X(12).
01 WS-R-KEY PIC X(20).
01 WS-R-PERIOD PIC X(08).
01 WS-R-LIMIT-ED PIC X(20).
01 WS-R-LIMIT PIC S9(15)V99 COMP-3.

LINKAGE SECTION.
COPY "BLIMP".

PROCEDURE DIVISION USING BK-LIM-REQ.
    MOVE "00" TO LIM-RC
    MOVE SPACES TO LIM-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    MOVE SPACES TO WS-CFG-PATH
    STRING FUNCTION TRIM(WS-HOME) "/etc/limits.cfg"
        DELIMITED SIZE INTO WS-CFG-PATH
    MOVE SPACES TO WS-LU-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/limuse.idx"
        DELIMITED SIZE INTO WS-LU-PATH
    EVALUATE LIM-OP
        WHEN "CHECK" PERFORM DO-CHECK
        WHEN "CONSUME" PERFORM DO-CONSUME
        WHEN "RELEASE" PERFORM DO-RELEASE
        WHEN OTHER
            MOVE "99" TO LIM-RC
            MOVE "UNKNOWN LIMIT OP" TO LIM-MSG
    END-EVALUATE
    GOBACK.

DO-RELEASE.
    MOVE 0 TO LIM-LIMIT
    PERFORM FIND-RULE
    PERFORM LOAD-USAGE
    SUBTRACT LIM-AMOUNT FROM LIM-USED
    IF LIM-USED < 0
        MOVE 0 TO LIM-USED
    END-IF
    PERFORM SAVE-USAGE
    COMPUTE LIM-AVAILABLE = LIM-LIMIT - LIM-USED
    MOVE "00" TO LIM-RC
    MOVE "RELEASED" TO LIM-MSG.

DO-CHECK.
    MOVE 0 TO LIM-LIMIT
    PERFORM FIND-RULE
    IF WS-FOUND NOT = "Y"
        MOVE "00" TO LIM-RC
        MOVE 0 TO LIM-AVAILABLE
        MOVE "NO LIMIT" TO LIM-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM LOAD-USAGE
    IF LIM-LIMIT = 0
        MOVE LIM-AMOUNT TO LIM-AVAILABLE
        MOVE "00" TO LIM-RC
        MOVE "NO LIMIT" TO LIM-MSG
        EXIT PARAGRAPH
    END-IF
    COMPUTE LIM-AVAILABLE = LIM-LIMIT - LIM-USED
    IF LIM-USED + LIM-AMOUNT > LIM-LIMIT
        MOVE "20" TO LIM-RC
        MOVE "LIMIT EXCEEDED" TO LIM-MSG
    ELSE
        MOVE "00" TO LIM-RC
        MOVE "WITHIN LIMIT" TO LIM-MSG
    END-IF.

DO-CONSUME.
    MOVE 0 TO LIM-LIMIT
    PERFORM FIND-RULE
    IF WS-FOUND NOT = "Y"
        MOVE "00" TO LIM-RC
        MOVE "NO LIMIT" TO LIM-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM LOAD-USAGE
    ADD LIM-AMOUNT TO LIM-USED
    MOVE WS-BIZDATE TO LU-DATE
    MOVE LIM-SCOPE TO LU-SCOPE
    MOVE LIM-KEY TO LU-KEY
    MOVE LIM-PERIOD TO LU-PERIOD
    MOVE LIM-USED TO LU-USED
    PERFORM SAVE-USAGE
    COMPUTE LIM-AVAILABLE = LIM-LIMIT - LIM-USED
    IF LIM-LIMIT > 0 AND LIM-USED > LIM-LIMIT
        MOVE "20" TO LIM-RC
        MOVE "LIMIT EXCEEDED" TO LIM-MSG
    ELSE
        MOVE "00" TO LIM-RC
        MOVE "CONSUMED" TO LIM-MSG
    END-IF.

FIND-RULE.
    MOVE "N" TO WS-FOUND
    OPEN INPUT CFG-FILE
    IF WS-CFG-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CFG-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM CONSIDER-RULE
        END-READ
    END-PERFORM
    CLOSE CFG-FILE.

CONSIDER-RULE.
    IF CFG-LINE = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-R-SCOPE WS-R-KEY WS-R-PERIOD WS-R-LIMIT-ED
    MOVE 0 TO WS-R-LIMIT
    UNSTRING CFG-LINE DELIMITED BY "|"
        INTO WS-R-SCOPE WS-R-KEY WS-R-PERIOD WS-R-LIMIT-ED
    END-UNSTRING
    IF WS-R-LIMIT-ED NOT = SPACES
        MOVE WS-R-LIMIT-ED TO WS-R-LIMIT
    END-IF
    IF WS-R-SCOPE NOT = LIM-SCOPE
        EXIT PARAGRAPH
    END-IF
    IF WS-R-KEY NOT = "*" AND WS-R-KEY NOT = LIM-KEY
        EXIT PARAGRAPH
    END-IF
    IF WS-R-PERIOD NOT = LIM-PERIOD
        EXIT PARAGRAPH
    END-IF
    IF WS-R-LIMIT <= 0
        EXIT PARAGRAPH
    END-IF
    IF WS-FOUND = "Y" AND WS-R-LIMIT >= LIM-LIMIT
        EXIT PARAGRAPH
    END-IF
    MOVE WS-R-LIMIT TO LIM-LIMIT
    MOVE "Y" TO WS-FOUND.

LOAD-USAGE.
    MOVE 0 TO LIM-USED
    OPEN I-O LU-FILE
    IF WS-LU-ST = "35"
        OPEN OUTPUT LU-FILE
        CLOSE LU-FILE
        OPEN I-O LU-FILE
    END-IF
    IF WS-LU-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE LIM-SCOPE TO LU-SCOPE
    MOVE LIM-KEY TO LU-KEY
    MOVE LIM-PERIOD TO LU-PERIOD
    READ LU-FILE
    IF WS-LU-ST = "00"
        MOVE LU-USED TO LIM-USED
    END-IF
    CLOSE LU-FILE.

SAVE-USAGE.
    OPEN I-O LU-FILE
    IF WS-LU-ST = "35"
        OPEN OUTPUT LU-FILE
        CLOSE LU-FILE
        OPEN I-O LU-FILE
    END-IF
    IF WS-LU-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE LIM-SCOPE TO LU-SCOPE
    MOVE LIM-KEY TO LU-KEY
    MOVE LIM-PERIOD TO LU-PERIOD
    READ LU-FILE
    EVALUATE WS-LU-ST
        WHEN "23"
            MOVE WS-BIZDATE TO LU-DATE
            MOVE LIM-USED TO LU-USED
            WRITE LU-REC
        WHEN "00"
            MOVE WS-BIZDATE TO LU-DATE
            MOVE LIM-USED TO LU-USED
            REWRITE LU-REC
        WHEN OTHER
            CONTINUE
    END-EVALUATE
    CLOSE LU-FILE.
