IDENTIFICATION DIVISION.
PROGRAM-ID. BPXCFG.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CFG-FILE ASSIGN TO WS-CFG-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-FILE-ST.

DATA DIVISION.
FILE SECTION.
FD CFG-FILE.
01 CFG-LINE PIC X(200).

WORKING-STORAGE SECTION.
01 WS-CFG-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-FILE-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-KEY PIC X(40).
01 WS-VAL PIC X(60).
01 WS-POS PIC 9(03).
01 WS-AMT-ED PIC -9999999999999.99.
01 WS-NUM PIC 9(08).

LINKAGE SECTION.
COPY "BPXCFG".

PROCEDURE DIVISION USING BK-PX-CFG.
    MOVE "00" TO PC-STATUS
    MOVE "N" TO PC-ENABLED
    MOVE SPACES TO PC-RAIL PC-SELF PC-CURRENCY PC-ADAPTER PC-E2E-ISPB
    MOVE SPACES TO PC-STL-ACCT PC-STL-CASH PC-SIMULATE
    MOVE 0 TO PC-AMOUNT-MAX
    MOVE 0 TO PC-KEY-LIMIT PC-QR-TTL PC-DEV-DAYS PC-MED-DAYS
        PC-STALE-DAYS PC-EXPIRE-DAYS PC-STL-LAG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CFG-PATH
    STRING FUNCTION TRIM(WS-HOME) "/etc/pix.cfg"
        DELIMITED SIZE INTO WS-CFG-PATH
    OPEN INPUT CFG-FILE
    IF WS-FILE-ST NOT = "00"
        MOVE WS-FILE-ST TO PC-STATUS
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CFG-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM PARSE-LINE
        END-READ
    END-PERFORM
    CLOSE CFG-FILE
    GOBACK.

PARSE-LINE.
    IF CFG-LINE = SPACES
        EXIT PARAGRAPH
    END-IF
    IF CFG-LINE(1:1) = "#"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-KEY WS-VAL
    MOVE 0 TO WS-POS
    INSPECT CFG-LINE TALLYING WS-POS FOR ALL "="
    IF WS-POS = 0
        EXIT PARAGRAPH
    END-IF
    UNSTRING CFG-LINE DELIMITED BY "="
        INTO WS-KEY WS-VAL
    END-UNSTRING
    EVALUATE FUNCTION TRIM(WS-KEY)
        WHEN "enabled"
            MOVE WS-VAL(1:1) TO PC-ENABLED
        WHEN "rail"
            MOVE WS-VAL TO PC-RAIL
        WHEN "self-participant"
            MOVE WS-VAL TO PC-SELF
        WHEN "base-currency"
            MOVE WS-VAL TO PC-CURRENCY
        WHEN "adapter"
            MOVE WS-VAL TO PC-ADAPTER
        WHEN "e2e-ispb"
            MOVE WS-VAL TO PC-E2E-ISPB
        WHEN "max-amount"
            MOVE 0 TO PC-AMOUNT-MAX
            MOVE FUNCTION TRIM(WS-VAL) TO WS-AMT-ED
            MOVE WS-AMT-ED TO PC-AMOUNT-MAX
        WHEN "keys-per-account"
            PERFORM TO-NUMBER
            MOVE WS-NUM TO PC-KEY-LIMIT
        WHEN "qr-ttl-minutes"
            PERFORM TO-NUMBER
            MOVE WS-NUM TO PC-QR-TTL
        WHEN "devolution-window-days"
            PERFORM TO-NUMBER
            MOVE WS-NUM TO PC-DEV-DAYS
        WHEN "med-window-days"
            PERFORM TO-NUMBER
            MOVE WS-NUM TO PC-MED-DAYS
        WHEN "stale-days"
            PERFORM TO-NUMBER
            MOVE WS-NUM TO PC-STALE-DAYS
        WHEN "expire-days"
            PERFORM TO-NUMBER
            MOVE WS-NUM TO PC-EXPIRE-DAYS
        WHEN "settlement-lag-days"
            PERFORM TO-NUMBER
            MOVE WS-NUM TO PC-STL-LAG
        WHEN "settlement-account"
            MOVE FUNCTION TRIM(WS-VAL) TO PC-STL-ACCT
        WHEN "settlement-cash-account"
            MOVE FUNCTION TRIM(WS-VAL) TO PC-STL-CASH
        WHEN "simulate"
            MOVE WS-VAL TO PC-SIMULATE
        WHEN OTHER
            CONTINUE
    END-EVALUATE.

TO-NUMBER.
    MOVE 0 TO WS-NUM
    MOVE FUNCTION TRIM(WS-VAL) TO WS-NUM.
