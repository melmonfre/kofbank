        MOVE 0 TO XP-SPLIT-CNT
    ELSE
        MOVE WS-B TO WS-LGS
        PERFORM PARSE-REV-LEGS
        IF XP-RC NOT = "00"
            DISPLAY "rc=20"
            DISPLAY "msg=" FUNCTION TRIM(XP-MSG)
            GOBACK
        END-IF
    END-IF
    IF WS-C NOT = SPACES
        MOVE WS-C TO XP-REQUEST
    END-IF
    IF WS-D NOT = SPACES
