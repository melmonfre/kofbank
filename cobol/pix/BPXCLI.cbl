PARSE-AMOUNT.
    MOVE 0 TO WS-INT
    MOVE 0 TO WS-FRAC
    MOVE 0 TO WS-POS
    MOVE "N" TO WS-BAD
    MOVE "N" TO WS-DOT
    MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-AMT-STR)) TO WS-LEN
    IF WS-LEN = 0
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-COUNT FROM 1 BY 1
        UNTIL WS-COUNT > WS-LEN OR WS-BAD = "Y"
        EVALUATE TRUE
            WHEN WS-AMT-STR(WS-COUNT:1) = "."
                IF WS-DOT = "Y"
                    MOVE "Y" TO WS-BAD
                ELSE
                    MOVE "Y" TO WS-DOT
                END-IF
            WHEN WS-AMT-STR(WS-COUNT:1) >= "0" AND
                 WS-AMT-STR(WS-COUNT:1) <= "9"
                IF WS-DOT = "Y"
                    IF WS-POS < 2
                        ADD 1 TO WS-POS
                        COMPUTE WS-FRAC = WS-FRAC * 10 +
                            (FUNCTION ORD(WS-AMT-STR(WS-COUNT:1)) - 49)
                    ELSE
                        CONTINUE
                    END-IF
                ELSE
                    COMPUTE WS-INT = WS-INT * 10
                    COMPUTE WS-INT = WS-INT +
                        (FUNCTION ORD(WS-AMT-STR(WS-COUNT:1)) - 49)
                END-IF
            WHEN OTHER
                MOVE "Y" TO WS-BAD
        END-EVALUATE
    END-PERFORM
    IF WS-BAD = "Y"
        DISPLAY "rc=20"
        DISPLAY "msg=BAD AMOUNT"
        GOBACK
    END-IF
    EVALUATE WS-POS
        WHEN 0 COMPUTE WS-AMT = WS-INT
        WHEN 1 COMPUTE WS-AMT = WS-INT + WS-FRAC / 10
        WHEN OTHER COMPUTE WS-AMT = WS-INT + WS-FRAC / 100
    END-EVALUATE.

