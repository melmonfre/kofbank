IDENTIFICATION DIVISION.
PROGRAM-ID. BPXCLI.

*> Pix CLI adapter.  Thin translation from pipe-delimited request lines to
*> the Pix domain parameter blocks.  No financial rule lives here.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BPXPP".
COPY "BPXKP".
COPY "BPXQP".
COPY "BPXDP".
COPY "BPXRT".
COPY "BPXSLP".
01 WS-OP PIC X(20).
01 WS-A PIC X(500).
01 WS-B PIC X(60).
01 WS-C PIC X(32).
01 WS-D PIC X(32).
01 WS-E PIC X(32).
01 WS-F PIC X(40).
01 WS-G PIC X(12).
01 WS-H PIC X(24).
01 WS-I PIC X(24).
01 WS-J PIC X(12).
01 WS-K PIC X(12).
01 WS-DATE PIC 9(08).
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT-ED PIC -(15)9.99.
01 WS-AMT-STR PIC X(20).
01 WS-POS PIC 9(03).
01 WS-COUNT PIC 9(03).
01 WS-LEN PIC 9(03).
01 WS-INT PIC S9(15) COMP-3.
01 WS-FRAC PIC 9(02).
01 WS-BAD PIC X(01).
01 WS-DOT PIC X(01).

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE FUNCTION TRIM(WS-OP)
        WHEN "rt.create" PERFORM DO-RT-CREATE
        WHEN "rt.get" PERFORM DO-RT-GET
        WHEN "rt.status" PERFORM DO-RT-STATUS
        WHEN "key.register" PERFORM DO-KEY-REGISTER
        WHEN "key.lookup" PERFORM DO-KEY-LOOKUP
        WHEN "key.get" PERFORM DO-KEY-GET
        WHEN "key.change" PERFORM DO-KEY-CHANGE
        WHEN "key.delete" PERFORM DO-KEY-DELETE
        WHEN "key.status" PERFORM DO-KEY-STATUS
        WHEN "key.list" PERFORM DO-KEY-LIST
        WHEN "key.claim.create" PERFORM DO-CLAIM-CREATE
        WHEN "key.claim.validate" PERFORM DO-CLAIM-VALIDATE
        WHEN "key.claim.apply" PERFORM DO-CLAIM-APPLY
        WHEN "key.claim.cancel" PERFORM DO-CLAIM-CANCEL
        WHEN "key.port.out" PERFORM DO-PORT-OUT
        WHEN "key.port.in" PERFORM DO-PORT-IN
        WHEN "key.sync" PERFORM DO-KEY-SYNC
        WHEN "key.seed" PERFORM DO-KEY-SEED
        WHEN "qr.create" PERFORM DO-QR-CREATE
        WHEN "qr.parse" PERFORM DO-QR-PARSE
        WHEN "qr.read" PERFORM DO-QR-READ
        WHEN "qr.get" PERFORM DO-QR-GET
        WHEN "qr.status" PERFORM DO-QR-STATUS
        WHEN "out.key" PERFORM DO-PIX-OUT-KEY
        WHEN "out.qr" PERFORM DO-PIX-OUT-QR
        WHEN "in" PERFORM DO-PIX-IN
        WHEN "process" PERFORM DO-PIX-PROCESS
        WHEN "confirm" PERFORM DO-PIX-CONFIRM
        WHEN "post" PERFORM DO-PIX-POST
        WHEN "status" PERFORM DO-PIX-STATUS
        WHEN "get" PERFORM DO-PIX-GET
        WHEN "get.e2e" PERFORM DO-PIX-GET-E2E
        WHEN "exception" PERFORM DO-PIX-EXCEPTION
        WHEN "retry" PERFORM DO-PIX-RETRY
        WHEN "devol" PERFORM DO-DEVOL
        WHEN "devol.get" PERFORM DO-DEVOL-GET
        WHEN "cycle.open" PERFORM DO-CYCLE-OPEN
        WHEN "cycle.accrue" PERFORM DO-CYCLE-ACCRUE
        WHEN "cycle.close" PERFORM DO-CYCLE-CLOSE
        WHEN "cycle.calc" PERFORM DO-CYCLE-CALC
        WHEN "cycle.get" PERFORM DO-CYCLE-GET
        WHEN "cycle.list" PERFORM DO-CYCLE-LIST
        WHEN "cycle.submit" PERFORM DO-CYCLE-SUBMIT
        WHEN "cycle.finalize" PERFORM DO-CYCLE-FINALIZE
        WHEN "stl.create" PERFORM DO-STL-CREATE
        WHEN "stl.submit" PERFORM DO-STL-SUBMIT
        WHEN "stl.result" PERFORM DO-STL-RESULT
        WHEN "stl.result.file" PERFORM DO-STL-RESULT-FILE
        WHEN "stl.query" PERFORM DO-STL-QUERY
        WHEN "stl.adjust" PERFORM DO-STL-ADJUST
        WHEN "stl.post" PERFORM DO-STL-POST
        WHEN "stl.get" PERFORM DO-STL-GET
        WHEN "stl.list" PERFORM DO-STL-LIST
        WHEN "pos.get" PERFORM DO-POS-GET
        WHEN "pos.list" PERFORM DO-POS-LIST
        WHEN "pos.rebuild" PERFORM DO-POS-REBUILD
        WHEN "eod" PERFORM DO-PIX-EOD
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN PIX OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H
        WS-I WS-J WS-K
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H WS-I
        WS-J WS-K
    END-UNSTRING.

DO-RT-CREATE.
    MOVE SPACES TO BK-PX-RT-PARMS
    MOVE "PARTICIPANT-CREATE" TO RT-OP
    MOVE WS-A TO RT-ISPB
    MOVE WS-B TO RT-NAME
    MOVE WS-C TO RT-TYPE
    MOVE WS-D TO RT-ROLE
    MOVE WS-E TO RT-SELF-FLAG
    MOVE WS-F TO RT-SETTLE-ACCT
    MOVE WS-G TO RT-OPERATOR
    MOVE WS-H TO RT-CORR
    MOVE WS-I TO RT-REQUEST
    CALL "BPXRT" USING BK-PX-RT-PARMS
    PERFORM SHOW-RT.

DO-RT-GET.
    MOVE SPACES TO BK-PX-RT-PARMS
    MOVE "PARTICIPANT-GET" TO RT-OP
    MOVE WS-A TO RT-PART-ID
    CALL "BPXRT" USING BK-PX-RT-PARMS
    PERFORM SHOW-RT.

DO-RT-STATUS.
    MOVE SPACES TO BK-PX-RT-PARMS
    MOVE "PARTICIPANT-STATUS" TO RT-OP
    MOVE WS-A TO RT-PART-ID
    MOVE WS-B TO RT-STATUS
    MOVE WS-C TO RT-OPERATOR
    MOVE WS-D TO RT-CORR
    MOVE WS-E TO RT-REQUEST
    CALL "BPXRT" USING BK-PX-RT-PARMS
    PERFORM SHOW-RT.

SHOW-RT.
    DISPLAY "rc=" RT-RC
    DISPLAY "id=" FUNCTION TRIM(RT-PART-ID)
    DISPLAY "ispb=" FUNCTION TRIM(RT-ISPB)
    DISPLAY "name=" FUNCTION TRIM(RT-NAME)
    DISPLAY "type=" FUNCTION TRIM(RT-TYPE)
    DISPLAY "role=" FUNCTION TRIM(RT-ROLE)
    DISPLAY "self=" FUNCTION TRIM(RT-SELF-FLAG)
    DISPLAY "settleacct=" FUNCTION TRIM(RT-SETTLE-ACCT)
    DISPLAY "status=" FUNCTION TRIM(RT-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(RT-MSG).

DO-KEY-REGISTER.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT
