    DISPLAY "total=" SP-ALLOC-TOTAL
    DISPLAY "taxtotal=" SP-TAX-TOTAL
    DISPLAY "exttotal=" SP-EXT-TOTAL
    PERFORM VARYING WS-LGI FROM 1 BY 1 UNTIL WS-LGI > SP-CNT
        DISPLAY "leg " WS-LGI ": seq=" SP-PS-SEQ(WS-LGI)
            " role=" FUNCTION TRIM(SP-PS-ROLE(WS-LGI))
            " id=" FUNCTION TRIM(SP-PS-ID(WS-LGI))
            " amt=" SP-PS-AMT(WS-LGI)
            " type=" FUNCTION TRIM(SP-PS-TYPE(WS-LGI))
            " aid=" FUNCTION TRIM(SP-PS-ALLOC-ID(WS-LGI))
