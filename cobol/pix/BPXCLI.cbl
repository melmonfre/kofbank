    DISPLAY "msg=" FUNCTION TRIM(XP-MSG).

PARSE-LEGS.
    MOVE "00" TO XP-RC
    MOVE SPACES TO XP-MSG
    INITIALIZE WS-LEGS
    MOVE 0 TO WS-LGI
    UNSTRING WS-LGS DELIMITED BY ";" INTO WS-LGR(1)
        WS-LGR(2) WS-LGR(3) WS-LGR(4) WS-LGR(5) WS-LGR(6)
        WS-LGR(7) WS-LGR(8) WS-LGR(9) WS-LGR(10) WS-LGR(11)
        WS-LGR(12) WS-LGR(13) WS-LGR(14) WS-LGR(15) WS-LGR(16)
        WS-LGR(17) WS-LGR(18) WS-LGR(19) WS-LGR(20)
        TALLYING WS-LGI
    END-UNSTRING
    IF WS-LGI < 1 OR WS-LGI > 20
        MOVE "20" TO XP-RC
        MOVE "SPLIT LEGS REQUIRE 1 TO 20 ROWS" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-LGI TO XP-SPLIT-CNT
    PERFORM VARYING WS-LGJ FROM 1 BY 1 UNTIL WS-LGJ > WS-LGI
        MOVE SPACES TO WS-P1 WS-P2 WS-P3 WS-P4 WS-P5 WS-P6
            WS-P7 WS-P8
        UNSTRING WS-LGR(WS-LGJ) DELIMITED BY ":"
            INTO WS-P1 WS-P2 WS-P3 WS-P4 WS-P5 WS-P6 WS-P7
                WS-P8
        END-UNSTRING
        IF WS-P1 = SPACES OR WS-P2 = SPACES OR
           WS-P3 = SPACES OR WS-P4 = SPACES
            MOVE "20" TO XP-RC
            MOVE "INCOMPLETE SPLIT LEG" TO XP-MSG
            EXIT PERFORM
        END-IF
        MOVE WS-P3 TO WS-AMT-STR
        PERFORM PARSE-AMOUNT
        MOVE WS-LGJ TO XP-PS-SEQ(WS-LGJ)
        MOVE WS-P1 TO XP-PS-ROLE(WS-LGJ)
        MOVE WS-P2 TO XP-PS-ID(WS-LGJ)
        MOVE WS-AMT TO XP-PS-AMT(WS-LGJ)
        MOVE WS-P4 TO XP-PS-TYPE(WS-LGJ)
        MOVE WS-P5 TO XP-PS-TAXTYPE(WS-LGJ)
        MOVE WS-P6 TO XP-PS-TAXCAT(WS-LGJ)
        MOVE WS-P7 TO XP-PS-DOCREF(WS-LGJ)
        MOVE WS-P8 TO XP-PS-REF(WS-LGJ)
    END-PERFORM.

DO-SPLIT-SHOW.
    MOVE SPACES TO BK-PX-SPL-PARMS
