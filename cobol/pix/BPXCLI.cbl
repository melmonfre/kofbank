IDENTIFICATION DIVISION.
PROGRAM-ID. BPXCLI.

*> Pix CLI adapter.  Thin translation from pipe-delimited request lines to
*> the Pix domain parameter blocks.  No financial rule lives here.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BPXPP".
COPY "BPXKP".
COPY "BPXQP".
COPY "BPXDP".
COPY "BPXRT".
COPY "BPXSLP".
COPY "BPXMCP".
COPY "BPXMBP".
COPY "BPTXP".
01 WS-OP PIC X(20).
01 WS-A PIC X(500).
01 WS-B PIC X(60).
01 WS-C PIC X(32).
01 WS-D PIC X(32).
01 WS-E PIC X(32).
01 WS-F PIC X(40).
01 WS-G PIC X(40).
01 WS-H PIC X(24).
01 WS-I PIC X(24).
01 WS-J PIC X(60).
01 WS-K PIC X(500).
01 WS-L PIC X(32).
01 WS-M PIC X(32).
01 WS-N PIC X(300).
01 WS-LNUM PIC 9(07).
COPY "BKSPLP".
01 WS-LEGS.
   05 WS-LGR OCCURS 20 TIMES PIC X(220).
01 WS-LGS PIC X(400).
01 WS-P1 PIC X(12).
01 WS-P2 PIC X(12).
01 WS-P3 PIC X(20).
01 WS-P4 PIC X(10).
01 WS-P5 PIC X(24).
01 WS-P6 PIC X(08).
01 WS-P7 PIC X(50).
01 WS-P8 PIC X(32).
01 WS-P9 PIC X(20).
01 WS-P10 PIC X(32).
01 WS-LGI PIC 9(02).
01 WS-LGJ PIC 9(02).
01 WS-RGR OCCURS 4 TIMES PIC X(40).
01 WS-RGI PIC 9(02).
01 WS-LK-NAME PIC X(24).
01 WS-LK-OWNER PIC X(16).
01 WS-LK-MODE PIC X(01).
01 WS-LK-ST PIC X(02).
01 WS-DATE PIC 9(08).
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT-ED PIC -(15)9.99.
01 WS-AMT-STR PIC X(20).
01 WS-POS PIC 9(03).
01 WS-COUNT PIC 9(03).
01 WS-LEN PIC 9(03).
01 WS-INT PIC S9(15) COMP-3.
01 WS-FRAC PIC 9(02).
01 WS-BAD PIC X(01).
01 WS-DOT PIC X(01).

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE FUNCTION TRIM(WS-OP)
        WHEN "rt.create" PERFORM DO-RT-CREATE
        WHEN "rt.get" PERFORM DO-RT-GET
        WHEN "rt.status" PERFORM DO-RT-STATUS
        WHEN "key.register" PERFORM DO-KEY-REGISTER
        WHEN "key.lookup" PERFORM DO-KEY-LOOKUP
        WHEN "key.get" PERFORM DO-KEY-GET
        WHEN "key.change" PERFORM DO-KEY-CHANGE
        WHEN "key.delete" PERFORM DO-KEY-DELETE
        WHEN "key.status" PERFORM DO-KEY-STATUS
        WHEN "key.list" PERFORM DO-KEY-LIST
        WHEN "key.claim.create" PERFORM DO-CLAIM-CREATE
        WHEN "key.claim.ack" PERFORM DO-CLAIM-ACK
        WHEN "key.claim.confirm" PERFORM DO-CLAIM-CONFIRM
        WHEN "key.claim.cancel" PERFORM DO-CLAIM-CANCEL
        WHEN "key.claim.complete" PERFORM DO-CLAIM-COMPLETE
        WHEN "key.claim.get" PERFORM DO-CLAIM-GET
        WHEN "key.claim.list" PERFORM DO-CLAIM-LIST
        WHEN "key.sync" PERFORM DO-KEY-SYNC
        WHEN "key.seed" PERFORM DO-KEY-SEED
        WHEN "qr.create" PERFORM DO-QR-CREATE
        WHEN "qr.parse" PERFORM DO-QR-PARSE
        WHEN "qr.read" PERFORM DO-QR-READ
        WHEN "qr.check" PERFORM DO-QR-CHECK
        WHEN "qr.get" PERFORM DO-QR-GET
        WHEN "qr.status" PERFORM DO-QR-STATUS
        WHEN "split.request" PERFORM DO-SPLIT-REQUEST
        WHEN "split.validate" PERFORM DO-SPLIT-VALIDATE
        WHEN "split.show" PERFORM DO-SPLIT-SHOW
        WHEN "split.reverse" PERFORM DO-SPLIT-REVERSE
        WHEN "split.reversals" PERFORM DO-SPLIT-REVERSALS
        WHEN "spi.tax.validate" PERFORM DO-SPI-TAX-VALIDATE
        WHEN "spi.tax.ingest" PERFORM DO-SPI-TAX-INGEST
        WHEN "spi.tax.map" PERFORM DO-SPI-TAX-MAP
        WHEN "spi.tax.response" PERFORM DO-SPI-TAX-RESPONSE
        WHEN "spi.tax.get" PERFORM DO-SPI-TAX-GET
        WHEN "spi.tax.list" PERFORM DO-SPI-TAX-LIST
        WHEN "out.key" PERFORM DO-PIX-OUT-KEY
        WHEN "out.qr" PERFORM DO-PIX-OUT-QR
        WHEN "in" PERFORM DO-PIX-IN
        WHEN "process" PERFORM DO-PIX-PROCESS
        WHEN "confirm" PERFORM DO-PIX-CONFIRM
        WHEN "post" PERFORM DO-PIX-POST
        WHEN "status" PERFORM DO-PIX-STATUS
        WHEN "get" PERFORM DO-PIX-GET
        WHEN "get.e2e" PERFORM DO-PIX-GET-E2E
        WHEN "exception" PERFORM DO-PIX-EXCEPTION
        WHEN "retry" PERFORM DO-PIX-RETRY
        WHEN "devol" PERFORM DO-DEVOL
        WHEN "devol.get" PERFORM DO-DEVOL-GET
        WHEN "cycle.open" PERFORM DO-CYCLE-OPEN
        WHEN "cycle.accrue" PERFORM DO-CYCLE-ACCRUE
        WHEN "cycle.close" PERFORM DO-CYCLE-CLOSE
        WHEN "cycle.calc" PERFORM DO-CYCLE-CALC
        WHEN "cycle.get" PERFORM DO-CYCLE-GET
        WHEN "cycle.list" PERFORM DO-CYCLE-LIST
        WHEN "cycle.submit" PERFORM DO-CYCLE-SUBMIT
        WHEN "cycle.finalize" PERFORM DO-CYCLE-FINALIZE
        WHEN "stl.create" PERFORM DO-STL-CREATE
        WHEN "stl.submit" PERFORM DO-STL-SUBMIT
        WHEN "stl.result" PERFORM DO-STL-RESULT
        WHEN "stl.result.file" PERFORM DO-STL-RESULT-FILE
        WHEN "stl.query" PERFORM DO-STL-QUERY
        WHEN "stl.adjust" PERFORM DO-STL-ADJUST
        WHEN "stl.post" PERFORM DO-STL-POST
        WHEN "stl.get" PERFORM DO-STL-GET
        WHEN "stl.list" PERFORM DO-STL-LIST
        WHEN "pos.get" PERFORM DO-POS-GET
        WHEN "pos.list" PERFORM DO-POS-LIST
        WHEN "pos.rebuild" PERFORM DO-POS-REBUILD
        WHEN "eod" PERFORM DO-PIX-EOD
        WHEN "med.open" PERFORM DO-MED-OPEN
        WHEN "med.validate" PERFORM DO-MED-VALIDATE
        WHEN "med.block" PERFORM DO-MED-BLOCK
        WHEN "med.decide" PERFORM DO-MED-DECIDE
        WHEN "med.execute" PERFORM DO-MED-EXECUTE
        WHEN "med.release" PERFORM DO-MED-RELEASE
        WHEN "med.close" PERFORM DO-MED-CLOSE
        WHEN "med.expire" PERFORM DO-MED-EXPIRE
        WHEN "med.get" PERFORM DO-MED-GET
        WHEN "med.recon" PERFORM DO-MED-RECON
        WHEN "med.list" PERFORM DO-MED-LIST
        WHEN "med.batch.run" PERFORM DO-MED-BATCH-RUN
        WHEN "med.batch.dry" PERFORM DO-MED-BATCH-DRY
        WHEN "med.batch.get" PERFORM DO-MED-BATCH-GET
        WHEN "med.lock" PERFORM DO-MED-LOCK
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN PIX OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H
        WS-I WS-J WS-K WS-L WS-M WS-N
    MOVE 0 TO WS-LNUM
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H WS-I
        WS-J WS-K WS-L WS-M WS-N
    END-UNSTRING.

DO-RT-CREATE.
    MOVE SPACES TO BK-PX-RT-PARMS
    MOVE "PARTICIPANT-CREATE" TO RT-OP
    MOVE WS-A TO RT-ISPB
    MOVE WS-B TO RT-NAME
    MOVE WS-C TO RT-TYPE
    MOVE WS-D TO RT-ROLE
    MOVE WS-E TO RT-SELF-FLAG
    MOVE WS-F TO RT-SETTLE-ACCT
    MOVE WS-G TO RT-OPERATOR
    MOVE WS-H TO RT-CORR
    MOVE WS-I TO RT-REQUEST
    CALL "BPXRT" USING BK-PX-RT-PARMS
    PERFORM SHOW-RT.

DO-RT-GET.
    MOVE SPACES TO BK-PX-RT-PARMS
    MOVE "PARTICIPANT-GET" TO RT-OP
    MOVE WS-A TO RT-PART-ID
    CALL "BPXRT" USING BK-PX-RT-PARMS
    PERFORM SHOW-RT.

DO-RT-STATUS.
    MOVE SPACES TO BK-PX-RT-PARMS
    MOVE "PARTICIPANT-STATUS" TO RT-OP
    MOVE WS-A TO RT-PART-ID
    MOVE WS-B TO RT-STATUS
    MOVE WS-C TO RT-OPERATOR
    MOVE WS-D TO RT-CORR
    MOVE WS-E TO RT-REQUEST
    CALL "BPXRT" USING BK-PX-RT-PARMS
    PERFORM SHOW-RT.

SHOW-RT.
    DISPLAY "rc=" RT-RC
    DISPLAY "id=" FUNCTION TRIM(RT-PART-ID)
    DISPLAY "ispb=" FUNCTION TRIM(RT-ISPB)
    DISPLAY "name=" FUNCTION TRIM(RT-NAME)
    DISPLAY "type=" FUNCTION TRIM(RT-TYPE)
    DISPLAY "role=" FUNCTION TRIM(RT-ROLE)
    DISPLAY "self=" FUNCTION TRIM(RT-SELF-FLAG)
    DISPLAY "settleacct=" FUNCTION TRIM(RT-SETTLE-ACCT)
    DISPLAY "status=" FUNCTION TRIM(RT-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(RT-MSG).

DO-KEY-REGISTER.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT
    MOVE "KEY-REGISTER" TO XK-OP
    MOVE WS-A TO XK-TYPE
    MOVE WS-B TO XK-VALUE
    MOVE WS-C TO XK-ACCT
    MOVE WS-D TO XK-CUST
    MOVE WS-G TO XK-OPERATOR
    MOVE WS-H TO XK-CORR
    MOVE WS-I TO XK-REQUEST
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY.

DO-KEY-LOOKUP.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT
    MOVE "KEY-LOOKUP" TO XK-OP
    MOVE WS-A TO XK-TYPE
    MOVE WS-B TO XK-VALUE
    MOVE WS-C TO XK-OPERATOR
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY.

DO-KEY-GET.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT
    MOVE "KEY-GET" TO XK-OP
    MOVE WS-A TO XK-ID
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY.

DO-KEY-CHANGE.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT
    MOVE "KEY-CHANGE" TO XK-OP
    MOVE WS-A TO XK-ID
    MOVE WS-B TO XK-ACCT
    MOVE WS-C TO XK-REASON
    MOVE WS-D TO XK-OPERATOR
    MOVE WS-E TO XK-CORR
    MOVE WS-F TO XK-REQUEST
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY.

DO-KEY-DELETE.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT
    MOVE "KEY-DELETE" TO XK-OP
    MOVE WS-A TO XK-ID
    MOVE WS-B TO XK-REASON
    MOVE WS-C TO XK-OPERATOR
    MOVE WS-D TO XK-CORR
    MOVE WS-E TO XK-REQUEST
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY.

DO-KEY-STATUS.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT
    MOVE "KEY-STATUS" TO XK-OP
    MOVE WS-A TO XK-ID
    MOVE WS-B TO XK-STATUS
    MOVE WS-C TO XK-REASON
    MOVE WS-D TO XK-OPERATOR
    MOVE WS-E TO XK-CORR
    MOVE WS-F TO XK-REQUEST
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY.

DO-KEY-LIST.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT
    MOVE "KEY-LIST-ACCT" TO XK-OP
    MOVE WS-A TO XK-ACCT
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    DISPLAY "rc=" XK-RC
    DISPLAY "count=" XK-COUNT
    DISPLAY "msg=" FUNCTION TRIM(XK-MSG).

DO-CLAIM-CREATE.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT XK-RESOL-END XK-COMPL-END XK-DICT-VER
    MOVE "KEY-CLAIM-CREATE" TO XK-OP
    MOVE WS-A TO XK-ID
    MOVE WS-B TO XK-CLAIM-TYPE
    MOVE WS-C TO XK-ACCT
    MOVE WS-D TO XK-CUST
    MOVE WS-E TO XK-PART
    MOVE WS-F TO XK-REQUEST
    MOVE WS-G TO XK-OPERATOR
    MOVE WS-H TO XK-CORR
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY
    PERFORM SHOW-CLAIM.

DO-CLAIM-ACK.
    PERFORM PREPARE-CLAIM-OP
    MOVE "KEY-CLAIM-ACK" TO XK-OP
    MOVE WS-C TO XK-PART
    MOVE WS-D TO XK-REASON
    MOVE WS-E TO XK-OPERATOR
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY
    PERFORM SHOW-CLAIM.

DO-CLAIM-CONFIRM.
    PERFORM PREPARE-CLAIM-OP
    MOVE "KEY-CLAIM-CONFIRM" TO XK-OP
    MOVE WS-C TO XK-REASON
    MOVE WS-D TO XK-PART
    MOVE WS-E TO XK-OPERATOR
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY
    PERFORM SHOW-CLAIM.

DO-CLAIM-CANCEL.
    PERFORM PREPARE-CLAIM-OP
    MOVE "KEY-CLAIM-CANCEL" TO XK-OP
    MOVE WS-C TO XK-REASON
    MOVE WS-D TO XK-PART
    MOVE WS-E TO XK-OPERATOR
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY
    PERFORM SHOW-CLAIM.

DO-CLAIM-COMPLETE.
    PERFORM PREPARE-CLAIM-OP
    MOVE "KEY-CLAIM-COMPLETE" TO XK-OP
    MOVE WS-C TO XK-PART
    MOVE WS-D TO XK-OPERATOR
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY
    PERFORM SHOW-CLAIM.

PREPARE-CLAIM-OP.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT XK-RESOL-END XK-COMPL-END XK-DICT-VER
    MOVE WS-A TO XK-ID
    MOVE WS-B TO XK-CLAIM-ID.

DO-CLAIM-GET.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT XK-RESOL-END XK-COMPL-END XK-DICT-VER
    MOVE "KEY-CLAIM-GET" TO XK-OP
    MOVE WS-A TO XK-CLAIM-ID
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY
    PERFORM SHOW-CLAIM.

DO-CLAIM-LIST.
    MOVE SPACES TO BK-PX-DICT-PARMS
    MOVE 0 TO DT-COUNT
    MOVE "CLAIM-LIST" TO DT-OP
    MOVE WS-A TO DT-CLAIM-STATUS
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    DISPLAY "rc=" DT-RC
    DISPLAY "count=" DT-COUNT
    DISPLAY "msg=" FUNCTION TRIM(DT-MSG).

SHOW-CLAIM.
    DISPLAY "claimid=" FUNCTION TRIM(XK-CLAIM-ID)
    DISPLAY "claimtype=" FUNCTION TRIM(XK-CLAIM-TYPE)
    DISPLAY "claim=" FUNCTION TRIM(XK-CLAIM)
    DISPLAY "resolend=" XK-RESOL-END
    DISPLAY "complend=" XK-COMPL-END
    DISPLAY "confirmr=" FUNCTION TRIM(XK-CONFIRM-R)
    DISPLAY "cancelr=" FUNCTION TRIM(XK-CANCEL-R)
    DISPLAY "cancelledby=" FUNCTION TRIM(XK-CANCEL-BY)
    DISPLAY "dictver=" XK-DICT-VER.

DO-KEY-SYNC.
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE 0 TO XK-DATE XK-COUNT XK-DICT-VER
    MOVE "KEY-DICT-SYNC" TO XK-OP
    MOVE WS-A TO XK-ID
    MOVE WS-B TO XK-DICT-VER
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    PERFORM SHOW-KEY.

DO-KEY-SEED.
    MOVE SPACES TO BK-PX-DICT-PARMS
    MOVE "KEY-SEED" TO DT-OP
    MOVE WS-A TO DT-KEY-TYPE
    MOVE WS-B TO DT-KEY-VALUE
    MOVE WS-C TO DT-PART
    MOVE WS-D TO DT-ACCT
    MOVE WS-E TO DT-CUST
    MOVE WS-F TO DT-NAME
    MOVE WS-H TO DT-OPERATOR
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    DISPLAY "rc=" DT-RC
    DISPLAY "keyid=" FUNCTION TRIM(DT-KEY-ID)
    DISPLAY "status=" FUNCTION TRIM(DT-KEY-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(DT-MSG).

DO-QR-CREATE.
    MOVE SPACES TO BK-PX-QR-PARMS
    MOVE 0 TO XQ-AMOUNT XQ-TTL XQ-DATE XQ-EXPIRES-AT XQ-READ-COUNT
    MOVE "QR-CREATE" TO XQ-OP
    MOVE WS-A TO XQ-QR-TYPE
    MOVE WS-B TO XQ-ACCT
    MOVE WS-C TO XQ-KEY-ID
    MOVE WS-D TO XQ-KEY-TYPE
    MOVE WS-E TO XQ-KEY-VALUE
    MOVE WS-F TO WS-AMT-STR
    PERFORM PARSE-AMOUNT
    MOVE WS-AMT TO XQ-AMOUNT
    MOVE WS-G TO XQ-MERCHANT-NAME
    MOVE WS-H TO XQ-CITY
    MOVE WS-I TO XQ-MCC
    MOVE WS-J TO XQ-OPERATOR
    MOVE WS-K TO XQ-CORR
    MOVE WS-M TO WS-LNUM
    MOVE WS-LNUM TO XQ-TTL
    CALL "BPXQR" USING BK-PX-QR-PARMS
    PERFORM SHOW-QR.

DO-QR-PARSE.
    MOVE SPACES TO BK-PX-QR-PARMS
    MOVE 0 TO XQ-AMOUNT XQ-TTL XQ-DATE XQ-EXPIRES-AT XQ-READ-COUNT
    MOVE "QR-PARSE" TO XQ-OP
    MOVE WS-A TO XQ-Payload
    CALL "BPXQR" USING BK-PX-QR-PARMS
    PERFORM SHOW-QR.

DO-QR-CHECK.
    MOVE SPACES TO BK-PX-QR-PARMS
    MOVE 0 TO XQ-AMOUNT XQ-TTL XQ-DATE XQ-EXPIRES-AT XQ-READ-COUNT
    MOVE "QR-CHECK" TO XQ-OP
    MOVE WS-A TO XQ-QR-ID
    MOVE WS-B TO XQ-OPERATOR
    CALL "BPXQR" USING BK-PX-QR-PARMS
    DISPLAY "rc=" XQ-RC
    DISPLAY "status=" FUNCTION TRIM(XQ-STATUS)
    DISPLAY "ttlsec=" XQ-TTL
    DISPLAY "expiresat=" XQ-EXPIRES-AT
    DISPLAY "msg=" FUNCTION TRIM(XQ-MSG).

DO-QR-READ.
    MOVE SPACES TO BK-PX-QR-PARMS
    MOVE 0 TO XQ-AMOUNT XQ-TTL XQ-DATE XQ-EXPIRES-AT XQ-READ-COUNT
    MOVE "QR-READ" TO XQ-OP
    IF WS-A(1:1) = "R"
        MOVE WS-A TO XQ-QR-ID
    ELSE
        MOVE WS-A TO XQ-Payload
    END-IF
    MOVE WS-B TO XQ-OPERATOR
    MOVE WS-C TO XQ-CORR
    CALL "BPXQR" USING BK-PX-QR-PARMS
    PERFORM SHOW-QR.

DO-QR-GET.
    MOVE SPACES TO BK-PX-QR-PARMS
    MOVE 0 TO XQ-AMOUNT XQ-TTL XQ-DATE XQ-EXPIRES-AT XQ-READ-COUNT
    MOVE "QR-GET" TO XQ-OP
    MOVE WS-A TO XQ-QR-ID
    CALL "BPXQR" USING BK-PX-QR-PARMS
    PERFORM SHOW-QR.

DO-QR-STATUS.
    MOVE SPACES TO BK-PX-QR-PARMS
    MOVE 0 TO XQ-AMOUNT XQ-TTL XQ-DATE XQ-EXPIRES-AT XQ-READ-COUNT
    MOVE "QR-STATUS" TO XQ-OP
    MOVE WS-A TO XQ-QR-ID
    MOVE WS-B TO XQ-STATUS
    MOVE WS-C TO XQ-PIX-ID
    MOVE WS-D TO XQ-OPERATOR
    MOVE WS-E TO XQ-CORR
    MOVE WS-F TO XQ-REQUEST
    CALL "BPXQR" USING BK-PX-QR-PARMS
    PERFORM SHOW-QR.

DO-PIX-OUT-KEY.
    PERFORM PIX-OUT-BASE
    MOVE "KEY" TO XP-MODALITY
    MOVE WS-A TO XP-KEY-ID
    CALL "BPXPR" USING BK-PX-PARMS
    PERFORM SHOW-PIX.

DO-PIX-OUT-QR.
    MOVE SPACES TO BK-PX-QR-PARMS
    MOVE 0 TO XQ-AMOUNT XQ-TTL XQ-DATE XQ-EXPIRES-AT XQ-READ-COUNT
    MOVE "QR-GET" TO XQ-OP
    MOVE WS-A TO XQ-QR-ID
    CALL "BPXQR" USING BK-PX-QR-PARMS
    IF XQ-RC NOT = "00"
        DISPLAY "rc=" XQ-RC
        DISPLAY "msg=" FUNCTION TRIM(XQ-MSG)
        GOBACK
    END-IF
    PERFORM PIX-OUT-BASE
    MOVE "QR-" TO XP-MODALITY
    STRING "QR-" DELIMITED SIZE FUNCTION TRIM(XQ-QR-TYPE)
        DELIMITED SIZE INTO XP-MODALITY
    END-STRING
    MOVE XQ-QR-ID TO XP-QR-ID
    CALL "BPXPR" USING BK-PX-PARMS
    PERFORM SHOW-PIX.

PIX-OUT-BASE.
    MOVE SPACES TO BK-PX-PARMS
    MOVE 0 TO XP-AMOUNT XP-FEE-AMT XP-BLOCK-AMT XP-DATE XP-COUNT
    MOVE "PROD" TO XP-ENV
    MOVE "PIX-REQUEST" TO XP-OP
    MOVE "OUT" TO XP-DIRECTION
    MOVE WS-B TO WS-AMT-STR
    PERFORM PARSE-AMOUNT
    MOVE WS-AMT TO XP-AMOUNT
    MOVE WS-C TO XP-PAYER-ACCT
    MOVE WS-F TO XP-DESCR
    MOVE WS-G TO XP-OPERATOR
    MOVE WS-H TO XP-CORR
    MOVE WS-I TO XP-REQUEST
    MOVE WS-J TO XP-SIM
    MOVE WS-K TO XP-AUTO
    MOVE WS-L TO XP-SPLIT
    MOVE "BRL" TO XP-CURRENCY.

DO-PIX-IN.
    MOVE SPACES TO BK-PX-PARMS
    MOVE 0 TO XP-AMOUNT XP-FEE-AMT XP-BLOCK-AMT XP-DATE XP-COUNT
    MOVE "PIX-REQUEST" TO XP-OP
    MOVE "PROD" TO XP-ENV
    MOVE "IN" TO XP-DIRECTION
    MOVE "MANUAL" TO XP-MODALITY
    MOVE WS-A TO WS-AMT-STR
    PERFORM PARSE-AMOUNT
    MOVE WS-AMT TO XP-AMOUNT
    MOVE WS-B TO XP-PAYEE-ACCT
    MOVE WS-C TO XP-PAYER-PART
    MOVE WS-D TO XP-E2E-ID
    MOVE WS-E TO XP-EXT-REF
    MOVE WS-F TO XP-PAYEE-NAME
    MOVE WS-G TO XP-OPERATOR
    MOVE WS-H TO XP-CORR
    MOVE WS-I TO XP-REQUEST
    MOVE WS-J TO XP-SIM
    MOVE WS-K TO XP-AUTO
    MOVE "BRL" TO XP-CURRENCY
    CALL "BPXPR" USING BK-PX-PARMS
    PERFORM SHOW-PIX.

DO-PIX-PROCESS.
    MOVE SPACES TO BK-PX-PARMS
    MOVE 0 TO XP-AMOUNT XP-FEE-AMT XP-BLOCK-AMT XP-DATE XP-COUNT
    MOVE "PIX-PROCESS" TO XP-OP
    MOVE WS-A TO XP-PIX-ID
    MOVE WS-B TO XP-SIM
    MOVE WS-C TO XP-OPERATOR
