    IF XP-SPLIT = "Y"
        DISPLAY "splitcnt=" XP-SPLIT-CNT
        DISPLAY "splittotal=" XP-SPLIT-TOTAL
        PERFORM VARYING WS-LGI FROM 1 BY 1 UNTIL WS-LGI > XP-SPLIT-CNT
