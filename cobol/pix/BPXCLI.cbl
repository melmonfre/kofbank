*> ------------------------------------------------------------------ *
*> SPI Split Tax contract boundary ops (thin CLI adapter for BPXSTX;
*> no financial rule lives here).  Messages are contract objects; the
*> domain stays in the split engine.
*> ------------------------------------------------------------------ *
PREPARE-SPITAX.
    MOVE SPACES TO BK-SPITAX-PARMS
    MOVE WS-A TO XT-VER
    MOVE WS-B TO XT-MSGNM
    MOVE "BRL" TO XT-CURRENCY
    MOVE WS-E TO XT-INITFORM.
    EXIT PARAGRAPH.

SHOW-SPITAX.
    DISPLAY "rc=" XT-RC
    DISPLAY "status=" FUNCTION TRIM(XT-STATUS)
    DISPLAY "msgnm=" FUNCTION TRIM(XT-MSGNM)
    DISPLAY "ver=" FUNCTION TRIM(XT-VER)
    IF XT-CODE NOT = SPACES
        DISPLAY "code=" FUNCTION TRIM(XT-CODE)
        DISPLAY "codesrc=" FUNCTION TRIM(XT-CODESRC)
    END-IF
    DISPLAY "syntax=" XT-SYNTAX
    DISPLAY "taxsum=" XT-TAXSUM
    DISPLAY "pix=" FUNCTION TRIM(XT-PIX-ID)
    DISPLAY "txn=" FUNCTION TRIM(XT-TXN-ID)
    DISPLAY "replay=" FUNCTION TRIM(XT-REPLAY)
    IF XT-ENV NOT = SPACES
        DISPLAY "envelope=" FUNCTION TRIM(XT-ENV)
    END-IF
    DISPLAY "msg=" FUNCTION TRIM(XT-MSG).
    EXIT PARAGRAPH.

DO-SPI-TAX-VALIDATE.
    PERFORM PREPARE-SPITAX
    MOVE "TX-VALIDATE" TO XT-OP
    MOVE WS-C TO XT-E2E-ID
    MOVE WS-D TO XT-GROSS-STR
    MOVE WS-F TO XT-PAYER-DOC
    MOVE WS-G TO XT-RECV-DOC
    MOVE WS-H TO XT-DEBTOR-DOC
    MOVE WS-J TO XT-REFNB
    PERFORM BUILD-ENVELOPE-FROM-ARGS
    PERFORM PARSE-TAX-RECORDS
    IF WS-RGI < 1
        MOVE "N" TO XT-HAS-TAX
    ELSE
        MOVE "Y" TO XT-HAS-TAX
    END-IF
    MOVE WS-RGI TO XT-RCNT
    CALL "BPXSTX" USING BK-SPITAX-PARMS
    PERFORM SHOW-SPITAX.
    EXIT PARAGRAPH.

PARSE-TAX-RECORDS.
    MOVE 0 TO WS-RGI
    PERFORM VARYING WS-LGI FROM 1 BY 1 UNTIL WS-LGI > 4
        MOVE SPACES TO XT-R-TY(WS-LGI) XT-R-CT(WS-LGI)
            XT-R-VSTR(WS-LGI) XT-R-CCY(WS-LGI)
        MOVE 0 TO XT-R-AMT(WS-LGI)
    END-PERFORM
    IF WS-K = SPACES
        EXIT PARAGRAPH
    END-IF
    UNSTRING WS-K DELIMITED BY ";" INTO WS-RGR(1)
        WS-RGR(2) WS-RGR(3) WS-RGR(4) TALLYING WS-RGI
    END-UNSTRING
    PERFORM VARYING WS-LGI FROM 1 BY 1 UNTIL WS-LGI > WS-RGI
        MOVE SPACES TO WS-P1 WS-P2 WS-P3 WS-P4 WS-P5 WS-P6
            WS-P7 WS-P8
        UNSTRING WS-RGR(WS-LGI) DELIMITED BY ":"
            INTO WS-P1 WS-P2 WS-P3 WS-P4 WS-P5 WS-P6 WS-P7
                WS-P8
        END-UNSTRING
        MOVE WS-P1 TO XT-R-TY(WS-LGI)
        MOVE WS-P2 TO XT-R-CT(WS-LGI)
        MOVE WS-P3 TO XT-R-VSTR(WS-LGI)
        MOVE WS-P4 TO XT-R-CCY(WS-LGI)
    END-PERFORM.
    EXIT PARAGRAPH.

DO-SPI-TAX-INGEST.
    PERFORM PREPARE-SPITAX
    MOVE "TX-INGEST" TO XT-OP
    MOVE WS-C TO XT-E2E-ID
    MOVE WS-D TO XT-GROSS-STR
    MOVE WS-F TO XT-PAYER-DOC
    MOVE WS-G TO XT-RECV-DOC
    MOVE WS-H TO XT-DEBTOR-DOC
    PERFORM PARSE-TAX-RECORDS
    IF WS-RGI < 1
        MOVE "N" TO XT-HAS-TAX
    ELSE
        MOVE "Y" TO XT-HAS-TAX
    END-IF
    MOVE WS-RGI TO XT-RCNT
    MOVE WS-J TO XT-REFNB
    MOVE WS-L TO XT-PAYER-ACCT
    MOVE WS-M TO XT-PAYER-CUST
    MOVE SPACES TO WS-P1 WS-P2 WS-P3 WS-P4 WS-P5 WS-P6 WS-P7
        WS-P8 WS-P9 WS-P10
    UNSTRING WS-N DELIMITED BY ","
        INTO WS-P1 WS-P2 WS-P3 WS-P4 WS-P5 WS-P6 WS-P7 WS-P8
            WS-P9 WS-P10
    END-UNSTRING
    MOVE WS-P1 TO XT-RECV-ACCT
    MOVE WS-P2 TO XT-RECV-CUST
    MOVE WS-P3 TO XT-RECV-PART
    MOVE WS-P4 TO XT-PAYER-PART
    MOVE WS-P5 TO XT-TAX-CBS-ACCT
    MOVE WS-P6 TO XT-TAX-CBS-CUST
    MOVE WS-P7 TO XT-TAX-IBS-ACCT
    MOVE WS-P8 TO XT-TAX-IBS-CUST
    MOVE WS-P9 TO XT-OPERATOR
    MOVE WS-P10 TO XT-REQ
    MOVE "SPI SPLIT TAX INGEST" TO XT-DESCR
    PERFORM BUILD-ENVELOPE-FROM-ARGS
    CALL "BPXSTX" USING BK-SPITAX-PARMS
    PERFORM SHOW-SPITAX.
    EXIT PARAGRAPH.

BUILD-ENVELOPE-FROM-ARGS.
    MOVE SPACES TO XT-MSGR-ID XT-CREATTM
    STRING "M" DELIMITED SIZE WS-C(2:8) DELIMITED SIZE
        WS-C(10:12) DELIMITED SIZE WS-C(22:11)
        DELIMITED SIZE INTO XT-MSGR-ID
    END-STRING
    STRING WS-C(10:4) DELIMITED SIZE "-" DELIMITED SIZE
        WS-C(14:2) DELIMITED SIZE "-" DELIMITED SIZE
        WS-C(16:2) DELIMITED SIZE "T" DELIMITED SIZE
        WS-C(18:2) DELIMITED SIZE ":" DELIMITED SIZE
        WS-C(20:2) DELIMITED SIZE ":00.000Z"
        DELIMITED SIZE INTO XT-CREATTM
    END-STRING.
    EXIT PARAGRAPH.

DO-SPI-TAX-MAP.
    MOVE SPACES TO BK-PX-SPL-PARMS
    MOVE "SPL-LIST" TO SP-OP
    MOVE WS-B TO SP-PIX-ID
    CALL "BPXSLV" USING BK-PX-SPL-PARMS
    IF SP-RC NOT = "00"
        DISPLAY "rc=" SP-RC
        DISPLAY "msg=" FUNCTION TRIM(SP-MSG)
        GOBACK
    END-IF
    MOVE SPACES TO BK-SPITAX-PARMS
    MOVE "TX-BUILD" TO XT-OP
    IF WS-A = SPACES
        MOVE "5.13" TO XT-VER
    ELSE
        MOVE WS-A TO XT-VER
    END-IF
    MOVE "pacs.008" TO XT-MSGNM
    MOVE "BRL" TO XT-CURRENCY
    MOVE "MANU" TO XT-INITFORM
    MOVE WS-C TO XT-E2E-ID
    MOVE WS-D TO XT-PAYER-DOC
    MOVE WS-E TO XT-RECV-DOC
    MOVE 0 TO XT-GROSS
    PERFORM VARYING WS-LGI FROM 1 BY 1 UNTIL WS-LGI > SP-CNT
        ADD SP-PS-AMT(WS-LGI) TO XT-GROSS
    END-PERFORM
    IF WS-F NOT = SPACES
        MOVE WS-F TO XT-GROSS-STR
    ELSE
        MOVE XT-GROSS TO WS-AMT
        MOVE WS-AMT TO WS-AMT-ED
        MOVE FUNCTION TRIM(WS-AMT-ED) TO XT-GROSS-STR
    END-IF
    MOVE SPACES TO XT-REFNB
    MOVE 0 TO WS-RGI
    PERFORM VARYING WS-LGI FROM 1 BY 1 UNTIL WS-LGI > SP-CNT
        IF FUNCTION TRIM(SP-PS-ROLE(WS-LGI)) = "TAX" AND
           WS-RGI < 4
            ADD 1 TO WS-RGI
            MOVE SP-PS-TAXTYPE(WS-LGI) TO XT-R-TY(WS-RGI)
            MOVE SP-PS-TAXCAT(WS-LGI) TO XT-R-CT(WS-RGI)
            MOVE SP-PS-AMT(WS-LGI) TO WS-AMT
            MOVE WS-AMT TO WS-AMT-ED
            MOVE FUNCTION TRIM(WS-AMT-ED)
                TO XT-R-VSTR(WS-RGI)
            MOVE "BRL" TO XT-R-CCY(WS-RGI)
            IF XT-REFNB = SPACES AND
               SP-PS-DOCREF(WS-LGI) NOT = SPACES
                MOVE SP-PS-DOCREF(WS-LGI) TO XT-REFNB
            END-IF
        END-IF
    END-PERFORM
    IF WS-RGI = 0
        MOVE "N" TO XT-HAS-TAX
    ELSE
        MOVE "Y" TO XT-HAS-TAX
    END-IF
    MOVE WS-RGI TO XT-RCNT
    PERFORM BUILD-ENVELOPE-FROM-ARGS
    CALL "BPXSTX" USING BK-SPITAX-PARMS
    IF XT-RC = "00"
        MOVE WS-B TO XT-PIX-ID
        MOVE "POSTED" TO XT-STATUS
        PERFORM SHOW-SPITAX
    ELSE
        PERFORM SHOW-SPITAX
    END-IF.
    EXIT PARAGRAPH.

DO-SPI-TAX-RESPONSE.
    MOVE SPACES TO BK-SPITAX-PARMS
    MOVE "TX-RESPONSE" TO XT-OP
    MOVE WS-A TO XT-MSGNM
    IF WS-B = SPACES
        MOVE "5.13" TO XT-VER
    ELSE
        MOVE WS-B TO XT-VER
    END-IF
    MOVE WS-C TO XT-E2E-ID
    MOVE WS-D TO XT-STATUS
    MOVE WS-E TO XT-CODE
    CALL "BPXSTX" USING BK-SPITAX-PARMS
    PERFORM SHOW-SPITAX.
    EXIT PARAGRAPH.

DO-SPI-TAX-GET.
    MOVE SPACES TO BK-SPITAX-PARMS
    MOVE "TX-GETE2E" TO XT-OP
    MOVE WS-A TO XT-E2E-ID
    CALL "BPXSTX" USING BK-SPITAX-PARMS
    IF XT-RC = "00"
        DISPLAY "rc=00"
        DISPLAY "msgnm=" FUNCTION TRIM(XT-MSGNM)
        DISPLAY "ver=" FUNCTION TRIM(XT-VER)
        DISPLAY "e2e=" FUNCTION TRIM(XT-E2E-ID)
        DISPLAY "status=" FUNCTION TRIM(XT-STATUS)
        IF XT-CODE NOT = SPACES
            DISPLAY "code=" FUNCTION TRIM(XT-CODE)
            DISPLAY "codesrc=" FUNCTION TRIM(XT-CODESRC)
        END-IF
        DISPLAY "pix=" FUNCTION TRIM(XT-PIX-ID)
        DISPLAY "txn=" FUNCTION TRIM(XT-TXN-ID)
        DISPLAY "envelope=" FUNCTION TRIM(XT-ENV)
    ELSE
        DISPLAY "rc=" XT-RC
    END-IF
    DISPLAY "msg=" FUNCTION TRIM(XT-MSG).
    EXIT PARAGRAPH.

DO-SPI-TAX-LIST.
    MOVE SPACES TO BK-SPITAX-PARMS
    MOVE "TX-LIST" TO XT-OP
    CALL "BPXSTX" USING BK-SPITAX-PARMS
    DISPLAY "rc=" XT-RC
    DISPLAY "count=" XT-CNT
    IF XT-ENV NOT = SPACES
        DISPLAY "envelopes=" FUNCTION TRIM(XT-ENV)
    END-IF.
