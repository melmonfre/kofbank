    END-IF
    MOVE WS-E TO XP-OPERATOR
    MOVE "PIX SPLIT DEVOLUTION" TO XP-DESCR
    CALL "BPXDEV" USING BK-PX-PARMS
    DISPLAY "rc=" XP-RC
    DISPLAY "devoid=" FUNCTION TRIM(XP-DEV-PIX-ID)
    DISPLAY "amount=" XP-AMOUNT
    DISPLAY "txnid=" FUNCTION TRIM(XP-TXN-ID)
    DISPLAY "jrnid=" FUNCTION TRIM(XP-JRN-ID)
    DISPLAY "devstatus=" FUNCTION TRIM(XP-DEV-STATUS)
    DISPLAY "status=" FUNCTION TRIM(XP-STATUS)
    DISPLAY "replay=" XP-REPLAY
    DISPLAY "msg=" FUNCTION TRIM(XP-MSG).

PARSE-REV-LEGS.
    MOVE "00" TO XP-RC
    MOVE SPACES TO XP-MSG
    INITIALIZE WS-LEGS
    MOVE 0 TO WS-LGI
    UNSTRING WS-LGS DELIMITED BY ";" INTO WS-LGR(1)
        WS-LGR(2) WS-LGR(3) WS-LGR(4) WS-LGR(5) WS-LGR(6)
        WS-LGR(7) WS-LGR(8) WS-LGR(9) WS-LGR(10) WS-LGR(11)
        WS-LGR(12) WS-LGR(13) WS-LGR(14) WS-LGR(15) WS-LGR(16)
        WS-LGR(17) WS-LGR(18) WS-LGR(19) WS-LGR(20)
        TALLYING WS-LGI
    END-UNSTRING
    IF WS-LGI < 1 OR WS-LGI > 20
        MOVE "20" TO XP-RC
        MOVE "REVERSAL LEGS REQUIRE 1 TO 20 ROWS" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-LGI TO XP-SPLIT-CNT
    PERFORM VARYING WS-LGJ FROM 1 BY 1 UNTIL WS-LGJ > WS-LGI
        MOVE SPACES TO WS-P1 WS-P2
        UNSTRING WS-LGR(WS-LGJ) DELIMITED BY ":"
            INTO WS-P1 WS-P2
        END-UNSTRING
        IF WS-P1 = SPACES OR WS-P2 = SPACES
            MOVE "20" TO XP-RC
            MOVE "INCOMPLETE REVERSAL LEG" TO XP-MSG
            EXIT PERFORM
        END-IF
        MOVE WS-P2 TO WS-AMT-STR
        PERFORM PARSE-AMOUNT
        MOVE WS-LGJ TO XP-PS-SEQ(WS-LGJ)
        MOVE WS-P1 TO XP-PS-ORIG(WS-LGJ)
        MOVE WS-AMT TO XP-PS-AMT(WS-LGJ)
    END-PERFORM.

DO-SPLIT-REVERSALS.
