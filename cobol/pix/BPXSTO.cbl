IDENTIFICATION DIVISION.
PROGRAM-ID. BPXSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PX-FILE ASSIGN TO WS-PX-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PX-ID OF PX-REC
        FILE STATUS IS WS-PX-ST.
    SELECT E2E-FILE ASSIGN TO WS-E2E-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PE-E2E OF E2E-REC
        FILE STATUS IS WS-E2E-ST.
    SELECT XREF-FILE ASSIGN TO WS-XREF-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS XR-KEY OF XREF-REC
        FILE STATUS IS WS-XR-ST.

DATA DIVISION.
FILE SECTION.
FD PX-FILE.
01 PX-REC.
   COPY "BPX".
FD E2E-FILE.
01 E2E-REC.
   05 PE-E2E           PIC X(32).
   05 PE-PIX-ID        PIC X(12).
   05 PE-DIRECTION     PIC X(08).
   05 PE-AMOUNT        PIC S9(15)V99 COMP-3.
FD XREF-FILE.
01 XREF-REC.
   05 XR-KEY.
      10 XR-SOURCE      PIC X(08).
      10 XR-SEP1        PIC X(01).
      10 XR-EXT-REF     PIC X(32).
      10 XR-SEP2        PIC X(01).
      10 XR-DIR         PIC X(08).
   05 XR-PIX-ID        PIC X(12).

WORKING-STORAGE SECTION.
01 WS-PX-PATH PIC X(200).
01 WS-E2E-PATH PIC X(200).
01 WS-XREF-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-PX-ST PIC X(02).
01 WS-E2E-ST PIC X(02).
01 WS-XR-ST PIC X(02).
01 WS-XS-SOURCE PIC X(08).
01 WS-XS-REF PIC X(32).
01 WS-XS-DIR PIC X(08).

LINKAGE SECTION.
COPY "BPXSTO".
01 BK-PX-REC.
   COPY "BPX".

PROCEDURE DIVISION USING BK-PX-STO-REQ BK-PX-REC.
    MOVE "00" TO XS-RC
    MOVE SPACES TO XS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-PX-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxpix.idx"
        DELIMITED SIZE INTO WS-PX-PATH
    MOVE SPACES TO WS-E2E-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxe2e.idx"
        DELIMITED SIZE INTO WS-E2E-PATH
    MOVE SPACES TO WS-XREF-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxxref.idx"
        DELIMITED SIZE INTO WS-XREF-PATH
    EVALUATE XS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN "WRITE-E2E" PERFORM DO-WRITE-E2E
        WHEN "GET-E2E" PERFORM DO-GET-E2E
        WHEN "WRITE-XREF" PERFORM DO-WRITE-XREF
        WHEN "GET-XREF" PERFORM DO-GET-XREF
        WHEN OTHER
            MOVE "99" TO XS-RC
            MOVE "UNKNOWN PIX STO OP" TO XS-MSG
    END-EVALUATE
    GOBACK.

DO-WRITE.
    PERFORM OPEN-PX
    IF XS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-REC TO PX-REC
    WRITE PX-REC
        INVALID KEY
            MOVE "22" TO XS-RC
            MOVE "PIX TRANSACTION ALREADY EXISTS" TO XS-MSG
    END-WRITE
    PERFORM CLOSE-PX.

DO-REWRITE.
    PERFORM OPEN-PX
    IF XS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-REC TO PX-REC
    REWRITE PX-REC
        INVALID KEY
            MOVE "23" TO XS-RC
            MOVE "PIX TRANSACTION MISSING" TO XS-MSG
    END-REWRITE
    PERFORM CLOSE-PX.

DO-GET.
    PERFORM OPEN-PX
    IF XS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-REC TO PX-REC
    READ PX-FILE
    EVALUATE WS-PX-ST
        WHEN "00" MOVE PX-REC TO BK-PX-REC
        WHEN "23"
            MOVE "23" TO XS-RC
        WHEN OTHER
            MOVE WS-PX-ST TO XS-RC
            MOVE "PIX STORE READ ERROR" TO XS-MSG
    END-EVALUATE
    IF XS-RC = "23"
        MOVE "PIX TRANSACTION NOT FOUND" TO XS-MSG
    END-IF
    PERFORM CLOSE-PX.

DO-WRITE-E2E.
    PERFORM OPEN-E2E
    IF XS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-REC TO PX-REC
    MOVE PX-E2E-ID OF PX-REC TO PE-E2E
    MOVE PX-ID OF PX-REC TO PE-PIX-ID
    MOVE PX-DIRECTION OF PX-REC TO PE-DIRECTION
    MOVE PX-AMOUNT OF PX-REC TO PE-AMOUNT
    WRITE E2E-REC
        INVALID KEY
            MOVE "22" TO XS-RC
            MOVE "PIX E2E ALREADY REGISTERED" TO XS-MSG
    END-WRITE
    PERFORM CLOSE-E2E.

DO-GET-E2E.
    PERFORM OPEN-E2E
    IF XS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-REC TO PX-REC
    MOVE PX-E2E-ID OF PX-REC TO PE-E2E
    READ E2E-FILE
    EVALUATE WS-E2E-ST
        WHEN "00"
            MOVE PE-PIX-ID TO PX-ID OF BK-PX-REC
            MOVE PE-DIRECTION TO PX-DIRECTION OF BK-PX-REC
            MOVE PE-AMOUNT TO PX-AMOUNT OF BK-PX-REC
        WHEN "23"
            MOVE "23" TO XS-RC
            MOVE "PIX E2E NOT FOUND" TO XS-MSG
        WHEN OTHER
            MOVE WS-E2E-ST TO XS-RC
            MOVE "PIX E2E STORE ERROR" TO XS-MSG
    END-EVALUATE
    PERFORM CLOSE-E2E.

DO-WRITE-XREF.
    PERFORM OPEN-XREF
    IF XS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-REC TO PX-REC
    MOVE "PIX" TO XR-SOURCE
    MOVE PX-EXT-REF OF PX-REC TO XR-EXT-REF
    MOVE "|" TO XR-SEP1
    MOVE "|" TO XR-SEP2
    MOVE PX-DIRECTION OF PX-REC TO XR-DIR
    MOVE PX-ID OF PX-REC TO XR-PIX-ID
    WRITE XREF-REC
        INVALID KEY
            MOVE "22" TO XS-RC
            MOVE "PIX XREF EXISTS" TO XS-MSG
    END-WRITE
    PERFORM CLOSE-XREF.

DO-GET-XREF.
    PERFORM OPEN-XREF
    IF XS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-REC TO PX-REC
    MOVE "PIX" TO XR-SOURCE
    MOVE PX-EXT-REF OF PX-REC TO XR-EXT-REF
    MOVE "|" TO XR-SEP1
    MOVE "|" TO XR-SEP2
    MOVE PX-DIRECTION OF PX-REC TO XR-DIR
    READ XREF-FILE
    EVALUATE WS-XR-ST
        WHEN "00"
            MOVE XR-PIX-ID TO PX-ID OF BK-PX-REC
        WHEN "23"
            MOVE "23" TO XS-RC
            MOVE "PIX XREF NOT FOUND" TO XS-MSG
        WHEN OTHER
            MOVE WS-XR-ST TO XS-RC
            MOVE "PIX XREF STORE ERROR" TO XS-MSG
    END-EVALUATE
    PERFORM CLOSE-XREF.

OPEN-PX.
    OPEN I-O PX-FILE
    IF WS-PX-ST = "35"
        OPEN OUTPUT PX-FILE
        CLOSE PX-FILE
        OPEN I-O PX-FILE
    END-IF
    IF WS-PX-ST NOT = "00"
        MOVE WS-PX-ST TO XS-RC
        MOVE "PIX STORE OPEN ERROR" TO XS-MSG
    END-IF.

CLOSE-PX.
    CLOSE PX-FILE.

OPEN-E2E.
    OPEN I-O E2E-FILE
    IF WS-E2E-ST = "35"
        OPEN OUTPUT E2E-FILE
        CLOSE E2E-FILE
        OPEN I-O E2E-FILE
    END-IF
    IF WS-E2E-ST NOT = "00"
        MOVE WS-E2E-ST TO XS-RC
        MOVE "PIX E2E STORE OPEN ERROR" TO XS-MSG
    END-IF.

CLOSE-E2E.
    CLOSE E2E-FILE.

OPEN-XREF.
    OPEN I-O XREF-FILE
    IF WS-XR-ST = "35"
        OPEN OUTPUT XREF-FILE
        CLOSE XREF-FILE
        OPEN I-O XREF-FILE
    END-IF
    IF WS-XR-ST NOT = "00"
        MOVE WS-XR-ST TO XS-RC
        MOVE "PIX XREF STORE OPEN ERROR" TO XS-MSG
    END-IF.

CLOSE-XREF.
    CLOSE XREF-FILE.
