IDENTIFICATION DIVISION.
PROGRAM-ID. BPXMSTO.

*> Durable MED case store.
*> pxmed.idx   : the case record, keyed by case id.
*> pxmedr.idx  : request-id -> case-id (durable idempotency).
*> pxmedx.idx  : pix|reason -> case-id (duplicate case detection).
*> Every identity survives process/batch restart because it is on disk,
*> never in program memory.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT MED-FILE ASSIGN TO WS-MED-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS MC-CASE-ID OF MED-REC
        FILE STATUS IS WS-MED-ST.
    SELECT REQ-FILE ASSIGN TO WS-REQ-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS RD-REQ-ID
        FILE STATUS IS WS-REQ-ST.
    SELECT PIX-FILE ASSIGN TO WS-PIX-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PX-KEY
        FILE STATUS IS WS-PIX-ST.

DATA DIVISION.
FILE SECTION.
FD MED-FILE.
01 MED-REC.
   COPY "BPXMC".
FD REQ-FILE.
01 REQ-REC.
   05 RD-REQ-ID      PIC X(24).
   05 RD-CASE-ID     PIC X(12).
FD PIX-FILE.
01 PIX-REC.
   05 PX-KEY.
      10 PX-PIXID     PIC X(12).
      10 PX-SEP       PIC X(01).
      10 PX-REASON    PIC X(40).
   05 PX-CASE-ID     PIC X(12).

WORKING-STORAGE SECTION.
01 WS-MED-PATH PIC X(200).
01 WS-REQ-PATH PIC X(200).
01 WS-PIX-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-MED-ST PIC X(02).
01 WS-REQ-ST PIC X(02).
01 WS-PIX-ST PIC X(02).

LINKAGE SECTION.
COPY "BPXMCSTO".
01 BK-MC-REC.
   COPY "BPXMC".

PROCEDURE DIVISION USING BK-MC-STO-REQ BK-MC-REC.
    MOVE "00" TO MC-SO-RC
    MOVE SPACES TO MC-SO-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-MED-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxmed.idx"
        DELIMITED SIZE INTO WS-MED-PATH
    MOVE SPACES TO WS-REQ-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxmedr.idx"
        DELIMITED SIZE INTO WS-REQ-PATH
    MOVE SPACES TO WS-PIX-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxmedx.idx"
        DELIMITED SIZE INTO WS-PIX-PATH
    EVALUATE MC-SO-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN "WRITE-REQ" PERFORM DO-WRITE-REQ
        WHEN "GET-REQ" PERFORM DO-GET-REQ
        WHEN "WRITE-PIX" PERFORM DO-WRITE-PIX
        WHEN "GET-PIX" PERFORM DO-GET-PIX
        WHEN OTHER
            MOVE "99" TO MC-SO-RC
            MOVE "UNKNOWN MED STO OP" TO MC-SO-MSG
    END-EVALUATE
    GOBACK.

DO-WRITE.
    PERFORM OPEN-MED
    IF MC-SO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-MC-REC TO MED-REC
    WRITE MED-REC
        INVALID KEY
            MOVE "22" TO MC-SO-RC
            MOVE "MED CASE ALREADY EXISTS" TO MC-SO-MSG
    END-WRITE
    PERFORM CLOSE-MED.

DO-REWRITE.
    PERFORM OPEN-MED
    IF MC-SO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-MC-REC TO MED-REC
    REWRITE MED-REC
        INVALID KEY
            MOVE "23" TO MC-SO-RC
            MOVE "MED CASE MISSING" TO MC-SO-MSG
    END-REWRITE
    PERFORM CLOSE-MED.

DO-GET.
    PERFORM OPEN-MED
    IF MC-SO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE MC-SO-CASE-ID TO MED-REC
    READ MED-FILE
    EVALUATE WS-MED-ST
        WHEN "00" MOVE MED-REC TO BK-MC-REC
        WHEN "23"
            MOVE "23" TO MC-SO-RC
            MOVE "MED CASE NOT FOUND" TO MC-SO-MSG
        WHEN OTHER
            MOVE WS-MED-ST TO MC-SO-RC
            MOVE "MED STORE READ ERROR" TO MC-SO-MSG
    END-EVALUATE
    PERFORM CLOSE-MED.

DO-WRITE-REQ.
    PERFORM OPEN-REQ
    IF MC-SO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO REQ-REC
    MOVE MC-SO-REQ-ID TO RD-REQ-ID
    MOVE MC-SO-CASE-ID TO RD-CASE-ID
    WRITE REQ-REC
        INVALID KEY
            MOVE "22" TO MC-SO-RC
            MOVE "MED REQUEST ALREADY REGISTERED" TO MC-SO-MSG
    END-WRITE
    PERFORM CLOSE-REQ.

DO-GET-REQ.
    PERFORM OPEN-REQ
    IF MC-SO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE MC-SO-REQ-ID TO RD-REQ-ID
    READ REQ-FILE
    EVALUATE WS-REQ-ST
        WHEN "00" MOVE RD-CASE-ID TO MC-SO-CASE-ID
        WHEN "23"
            MOVE "23" TO MC-SO-RC
            MOVE "MED REQUEST NOT FOUND" TO MC-SO-MSG
        WHEN OTHER
            MOVE WS-REQ-ST TO MC-SO-RC
            MOVE "MED REQUEST STORE ERROR" TO MC-SO-MSG
    END-EVALUATE
    PERFORM CLOSE-REQ.

DO-WRITE-PIX.
    PERFORM OPEN-PIX
    IF MC-SO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO PIX-REC
    MOVE MC-SO-PIXID TO PX-PIXID
    MOVE "|" TO PX-SEP
    MOVE MC-SO-PREASON TO PX-REASON
    MOVE MC-SO-CASE-ID TO PX-CASE-ID
    WRITE PIX-REC
        INVALID KEY
            MOVE "22" TO MC-SO-RC
            MOVE "MED PIX REASON EXISTS" TO MC-SO-MSG
    END-WRITE
    PERFORM CLOSE-PIX.

DO-GET-PIX.
    PERFORM OPEN-PIX
    IF MC-SO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE MC-SO-PIXID TO PX-PIXID
    MOVE "|" TO PX-SEP
    MOVE MC-SO-PREASON TO PX-REASON
    READ PIX-FILE
    EVALUATE WS-PIX-ST
        WHEN "00" MOVE PX-CASE-ID TO MC-SO-CASE-ID
        WHEN "23"
            MOVE "23" TO MC-SO-RC
            MOVE "MED PIX REASON NOT FOUND" TO MC-SO-MSG
        WHEN OTHER
            MOVE WS-PIX-ST TO MC-SO-RC
            MOVE "MED PIX STORE ERROR" TO MC-SO-MSG
    END-EVALUATE
    PERFORM CLOSE-PIX.

OPEN-MED.
    OPEN I-O MED-FILE
    IF WS-MED-ST = "35"
        OPEN OUTPUT MED-FILE
        CLOSE MED-FILE
        OPEN I-O MED-FILE
    END-IF
    IF WS-MED-ST NOT = "00"
        MOVE WS-MED-ST TO MC-SO-RC
        MOVE "MED STORE OPEN ERROR" TO MC-SO-MSG
    END-IF.

CLOSE-MED.
    CLOSE MED-FILE.

OPEN-REQ.
    OPEN I-O REQ-FILE
    IF WS-REQ-ST = "35"
        OPEN OUTPUT REQ-FILE
        CLOSE REQ-FILE
        OPEN I-O REQ-FILE
    END-IF
    IF WS-REQ-ST NOT = "00"
        MOVE WS-REQ-ST TO MC-SO-RC
        MOVE "MED REQUEST STORE OPEN ERROR" TO MC-SO-MSG
    END-IF.

CLOSE-REQ.
    CLOSE REQ-FILE.

OPEN-PIX.
    OPEN I-O PIX-FILE
    IF WS-PIX-ST = "35"
        OPEN OUTPUT PIX-FILE
        CLOSE PIX-FILE
        OPEN I-O PIX-FILE
    END-IF
    IF WS-PIX-ST NOT = "00"
        MOVE WS-PIX-ST TO MC-SO-RC
        MOVE "MED PIX STORE OPEN ERROR" TO MC-SO-MSG
    END-IF.

CLOSE-PIX.
    CLOSE PIX-FILE.
