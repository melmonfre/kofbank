IDENTIFICATION DIVISION.
PROGRAM-ID. BPXKEY.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BPXCFG".
COPY "BPXKS".
COPY "BPXKVP".
COPY "BPXFP".
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BPXDP".
01 BK-PX-KEY.
   COPY "BPXK".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-ACCT-OUT.
   05 AO-ID PIC X(12).
   05 AO-CUST PIC X(12).
   05 AO-PRODUCT PIC X(04).
   05 AO-CURRENCY PIC X(03).
   05 AO-STATUS PIC X(02).
   05 AO-OPENED PIC 9(08).
   05 AO-CLOSED PIC 9(08).
   05 AO-VERSION PIC 9(05).
   05 AO-HASH PIC X(16).
   05 AO-RC PIC X(02).
01 WS-ACCT-OUT2.
   05 A2-ID PIC X(12).
   05 A2-CUST PIC X(12).
   05 A2-PRODUCT PIC X(04).
   05 A2-CURRENCY PIC X(03).
   05 A2-STATUS PIC X(02).
   05 A2-OPENED PIC 9(08).
   05 A2-CLOSED PIC 9(08).
   05 A2-VERSION PIC 9(05).
   05 A2-HASH PIC X(16).
   05 A2-RC PIC X(02).
01 WS-LOCK-NAME PIC X(24).
01 WS-LOCK-OWNER PIC X(16).
01 WS-LOCK-MODE PIC X(01).
01 WS-LOCK-ST PIC X(02).
01 WS-ID-TYPE PIC X(08).
01 WS-ISPB PIC X(08).
01 WS-ID-VAL PIC X(32).
01 WS-ID-RC PIC X(02).
01 WS-NOW PIC X(14).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-FOUND PIC X(01).
01 WS-ACCT-PIC PIC X(12).
01 WS-OLD-ACCT PIC X(12).
01 WS-OLD-TYPE PIC X(10).
01 WS-DICT-PART PIC X(12).
01 WS-DICT-FOUND PIC X(01).
01 WS-EVT-TYPE PIC X(40).
01 WS-AUD-ACTION PIC X(12).
01 WS-EXC-CODE PIC X(12).
01 WS-SEQ-NAME PIC X(20) VALUE "RECEXC".
01 WS-SEQ PIC 9(09).
01 WS-SEQ-ST PIC X(02).
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).

COPY "BRECP".
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
COPY "BPXKP".

PROCEDURE DIVISION USING BK-PX-KEY-PARMS.
    MOVE "00" TO XK-RC
    MOVE SPACES TO XK-MSG
    MOVE "N" TO XK-REPLAY
    CALL "BCFG" USING WS-CFG
    CALL "BPXCFG" USING BK-PX-CFG
    IF PC-STATUS NOT = "00"
        MOVE "20" TO XK-RC
        MOVE "PIX CONFIG MISSING" TO XK-MSG
        GOBACK
    END-IF
    IF PC-ENABLED NOT = "Y"
        MOVE "20" TO XK-RC
        MOVE "PIX NOT ENABLED" TO XK-MSG
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(XK-OP)
        WHEN "KEY-REGISTER" PERFORM DO-REGISTER
        WHEN "KEY-LOOKUP" PERFORM DO-LOOKUP
        WHEN "KEY-GET" PERFORM DO-GET
        WHEN "KEY-DICT-GET" PERFORM DO-DICT-GET
        WHEN "KEY-CHANGE" PERFORM DO-CHANGE
        WHEN "KEY-DELETE" PERFORM DO-DELETE
        WHEN "KEY-STATUS" PERFORM DO-STATUS
        WHEN "KEY-LIST-ACCT" PERFORM DO-LIST
        WHEN "KEY-CLAIM-CREATE" PERFORM DO-CLAIM-CREATE
        WHEN "KEY-CLAIM-ACK" PERFORM DO-CLAIM-ACK
        WHEN "KEY-CLAIM-CONFIRM" PERFORM DO-CLAIM-CONFIRM
        WHEN "KEY-CLAIM-CANCEL" PERFORM DO-CLAIM-CANCEL
        WHEN "KEY-CLAIM-COMPLETE" PERFORM DO-CLAIM-COMPLETE
        WHEN "KEY-CLAIM-GET" PERFORM DO-CLAIM-GET
        WHEN "KEY-DICT-SYNC" PERFORM DO-DICT-SYNC
        WHEN OTHER
            MOVE "99" TO XK-RC
            MOVE "UNKNOWN PIX KEY OP" TO XK-MSG
    END-EVALUATE
    GOBACK.

DO-REGISTER.
    PERFORM CHECK-REGISTER
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "KEY-REGISTER" TO DT-OP OF BK-PX-DICT-PARMS
    MOVE XK-TYPE TO DT-KEY-TYPE OF BK-PX-DICT-PARMS
    MOVE XK-VALUE TO DT-KEY-VALUE OF BK-PX-DICT-PARMS
    MOVE XK-ACCT TO DT-ACCT OF BK-PX-DICT-PARMS
    MOVE XK-CUST TO DT-CUST OF BK-PX-DICT-PARMS
    MOVE XK-PART TO DT-PART OF BK-PX-DICT-PARMS
    MOVE XK-REQUEST TO DT-REQUEST OF BK-PX-DICT-PARMS
    MOVE XK-OPERATOR TO DT-OPERATOR OF BK-PX-DICT-PARMS
    MOVE XK-CORR TO DT-CORR OF BK-PX-DICT-PARMS
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    IF DT-RC NOT = "00"
        MOVE DT-RC TO XK-RC
        MOVE DT-MSG TO XK-MSG
        GOBACK
    END-IF
    MOVE DT-VERIFIED TO XK-VERIFIED
    PERFORM FILL-KEY
    PERFORM STORE-LOCAL
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "ACTIVE" TO XK-STATUS
    MOVE "PIX KEY REGISTERED" TO XK-MSG
    PERFORM EMIT.

DO-DICT-GET.
    MOVE SPACES TO BK-PX-DICT-PARMS
    MOVE "KEY-DICT-GET" TO DT-OP OF BK-PX-DICT-PARMS
    MOVE XK-ID TO DT-KEY-ID OF BK-PX-DICT-PARMS
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    IF DT-RC NOT = "00"
        MOVE DT-RC TO XK-RC
        MOVE DT-MSG TO XK-MSG
        GOBACK
    END-IF
    MOVE DT-KEY-ID OF BK-PX-DICT-PARMS TO XK-ID
    MOVE DT-KEY-TYPE OF BK-PX-DICT-PARMS TO XK-TYPE
    MOVE DT-KEY-HASH OF BK-PX-DICT-PARMS TO XK-HASH
    MOVE DT-KEY-MASK OF BK-PX-DICT-PARMS TO XK-MASK
    MOVE DT-ACCT OF BK-PX-DICT-PARMS TO XK-ACCT
    MOVE DT-CUST OF BK-PX-DICT-PARMS TO XK-CUST
    MOVE DT-PART OF BK-PX-DICT-PARMS TO XK-PART
    MOVE DT-KEY-STATUS OF BK-PX-DICT-PARMS TO XK-STATUS
    MOVE DT-SELF-FLAG OF BK-PX-DICT-PARMS TO XK-SELF
    MOVE "00" TO XK-RC.

DO-LOOKUP.
    MOVE "KEY-LOOKUP" TO DT-OP OF BK-PX-DICT-PARMS
    MOVE XK-TYPE TO DT-KEY-TYPE OF BK-PX-DICT-PARMS
    MOVE XK-VALUE TO DT-KEY-VALUE OF BK-PX-DICT-PARMS
    MOVE XK-OPERATOR TO DT-OPERATOR OF BK-PX-DICT-PARMS
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    IF DT-RC NOT = "00"
        MOVE DT-RC TO XK-RC
        MOVE DT-MSG TO XK-MSG
        GOBACK
    END-IF
    MOVE DT-KEY-ID TO XK-ID
    MOVE DT-KEY-TYPE TO XK-TYPE
    MOVE DT-KEY-MASK TO XK-MASK
    MOVE DT-ACCT TO XK-ACCT
    MOVE DT-CUST TO XK-CUST
    MOVE DT-PART TO XK-PART
    MOVE DT-KEY-STATUS TO XK-STATUS
    MOVE DT-CLAIM-STATUS TO XK-CLAIM
    MOVE DT-CLAIM-ID TO XK-CLAIM-ID
    MOVE DT-VERSION TO XK-DICT-VER
    MOVE DT-FRAUD-FLAG TO XK-FRAUD
    IF DT-SELF-FLAG = "Y"
        MOVE "Y" TO XK-SELF
    ELSE
        MOVE "N" TO XK-SELF
    END-IF
    MOVE "PIX KEY FOUND" TO XK-MSG.

DO-GET.
    MOVE SPACES TO BK-PX-KEY
    MOVE XK-ID TO PK-ID OF BK-PX-KEY
    MOVE "GET" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    IF KS-RC NOT = "00"
        MOVE KS-RC TO XK-RC
        MOVE KS-MSG TO XK-MSG
        GOBACK
    END-IF
    PERFORM FILL-PARMS
    MOVE "PIX KEY" TO XK-MSG.

DO-CHANGE.
    MOVE "KEY-CHANGE" TO DT-OP OF BK-PX-DICT-PARMS
    MOVE XK-ID TO DT-KEY-ID OF BK-PX-DICT-PARMS
    MOVE XK-ACCT TO DT-ACCT OF BK-PX-DICT-PARMS
    MOVE XK-REASON TO DT-REASON OF BK-PX-DICT-PARMS
    MOVE XK-OPERATOR TO DT-OPERATOR OF BK-PX-DICT-PARMS
    MOVE XK-CORR TO DT-CORR OF BK-PX-DICT-PARMS
    MOVE XK-REQUEST TO DT-REQUEST OF BK-PX-DICT-PARMS
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    IF DT-RC NOT = "00"
        MOVE DT-RC TO XK-RC
        MOVE DT-MSG TO XK-MSG
        GOBACK
    END-IF
    MOVE DT-KEY-ID TO XK-ID
    MOVE DT-KEY-TYPE TO XK-TYPE
    MOVE DT-ACCT TO XK-ACCT
    MOVE DT-CUST TO XK-CUST
    MOVE DT-PART TO XK-PART
    MOVE DT-KEY-MASK TO XK-MASK
    MOVE DT-KEY-HASH TO XK-HASH
    PERFORM MOVE-LOCAL
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "ACTIVE" TO XK-STATUS
    MOVE "PIX KEY CHANGED" TO XK-MSG
    PERFORM EMIT.

DO-DELETE.
    MOVE "KEY-DELETE" TO DT-OP OF BK-PX-DICT-PARMS
    MOVE XK-ID TO DT-KEY-ID OF BK-PX-DICT-PARMS
    MOVE XK-REASON TO DT-REASON OF BK-PX-DICT-PARMS
    MOVE XK-OPERATOR TO DT-OPERATOR OF BK-PX-DICT-PARMS
    MOVE XK-CORR TO DT-CORR OF BK-PX-DICT-PARMS
    MOVE XK-REQUEST TO DT-REQUEST OF BK-PX-DICT-PARMS
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    IF DT-RC NOT = "00"
        MOVE DT-RC TO XK-RC
        MOVE DT-MSG TO XK-MSG
        GOBACK
    END-IF
    PERFORM REMOVE-LOCAL
    MOVE "REVOKED" TO XK-STATUS
    MOVE "PIX KEY DELETED" TO XK-MSG
    PERFORM EMIT.

DO-STATUS.
    MOVE SPACES TO BK-PX-KEY
    MOVE XK-ID TO PK-ID OF BK-PX-KEY
    MOVE "GET" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    IF KS-RC NOT = "00"
        MOVE KS-RC TO XK-RC
        MOVE KS-MSG TO XK-MSG
        GOBACK
    END-IF
    PERFORM LOCK-KEY
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(XK-STATUS)
        WHEN "DEACTIVATE"
            IF PK-STATUS OF BK-PX-KEY NOT = "ACTIVE" AND
               PK-STATUS OF BK-PX-KEY NOT = "RESERVED"
                MOVE "20" TO XK-RC
                MOVE "PIX KEY NOT ACTIVE" TO XK-MSG
            ELSE
                MOVE "INACTIVE" TO PK-STATUS OF BK-PX-KEY
                PERFORM TOUCH
            END-IF
        WHEN "ACTIVATE"
            IF PK-STATUS OF BK-PX-KEY NOT = "INACTIVE"
                MOVE "20" TO XK-RC
                MOVE "PIX KEY NOT INACTIVE" TO XK-MSG
            ELSE
                PERFORM CHECK-KEY-FRAUD
                IF XK-RC = "00"
                    MOVE "ACTIVE" TO PK-STATUS OF BK-PX-KEY
                    PERFORM TOUCH
                END-IF
            END-IF
        WHEN OTHER
            MOVE "20" TO XK-RC
            MOVE "UNKNOWN PIX KEY STATUS OP" TO XK-MSG
    END-EVALUATE
    IF XK-RC = "00"
        MOVE "REWRITE" TO KS-OP
        CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
        IF KS-RC NOT = "00"
            MOVE KS-RC TO XK-RC
            MOVE KS-MSG TO XK-MSG
        ELSE
            PERFORM FILL-PARMS
            MOVE "PIX KEY STATUS UPDATED" TO XK-MSG
            PERFORM EMIT
        END-IF
    END-IF
    PERFORM UNLOCK-KEY.

DO-LIST.
    MOVE SPACES TO BK-PX-KEY
    MOVE XK-ACCT TO PK-ACCT OF BK-PX-KEY
    MOVE "COUNT-ACCT" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    IF KS-RC NOT = "00"
        MOVE KS-RC TO XK-RC
        MOVE KS-MSG TO XK-MSG
        GOBACK
    END-IF
    MOVE KS-COUNT TO XK-COUNT
    MOVE "PIX KEY COUNT" TO XK-MSG.

DO-CLAIM-CREATE.
    PERFORM CHECK-CLAIMANT-ACCT
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    MOVE SPACES TO BK-PX-DICT-PARMS
    MOVE "CLAIM-CREATE" TO DT-OP OF BK-PX-DICT-PARMS
    MOVE XK-ID TO DT-KEY-ID OF BK-PX-DICT-PARMS
    MOVE XK-CLAIM-TYPE TO DT-CLAIM-TYPE OF BK-PX-DICT-PARMS
    MOVE XK-ACCT TO DT-ACCT OF BK-PX-DICT-PARMS
    MOVE XK-CUST TO DT-CUST OF BK-PX-DICT-PARMS
    MOVE XK-PART TO DT-PART OF BK-PX-DICT-PARMS
    MOVE XK-REASON TO DT-REASON OF BK-PX-DICT-PARMS
    MOVE XK-OPERATOR TO DT-OPERATOR OF BK-PX-DICT-PARMS
    MOVE XK-REQUEST TO DT-CLAIM-REQ-ID OF BK-PX-DICT-PARMS
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    IF DT-RC NOT = "00"
        MOVE DT-RC TO XK-RC
        MOVE DT-MSG TO XK-MSG
        GOBACK
    END-IF
    PERFORM FILL-CLAIM-PARMS
    PERFORM SYNC-CLAIM-LOCAL
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "PIX CLAIM CREATED" TO XK-MSG
    PERFORM EMIT.

DO-CLAIM-ACK.
    PERFORM CALL-CLAIM-OP
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "PIX CLAIM RECEIVED BY DONOR" TO XK-MSG
    PERFORM EMIT.

DO-CLAIM-CONFIRM.
    PERFORM CALL-CLAIM-OP
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "PIX CLAIM CONFIRMED" TO XK-MSG
    PERFORM EMIT.

DO-CLAIM-CANCEL.
    PERFORM CALL-CLAIM-OP
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "PIX CLAIM CANCELLED" TO XK-MSG
    PERFORM EMIT.

DO-CLAIM-COMPLETE.
    PERFORM CALL-CLAIM-OP
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "PIX CLAIM COMPLETED" TO XK-MSG
    PERFORM EMIT.

DO-CLAIM-GET.
    MOVE SPACES TO BK-PX-DICT-PARMS
    MOVE "CLAIM-GET" TO DT-OP OF BK-PX-DICT-PARMS
    MOVE XK-CLAIM-ID TO DT-CLAIM-ID OF BK-PX-DICT-PARMS
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    IF DT-RC NOT = "00"
        MOVE DT-RC TO XK-RC
        MOVE DT-MSG TO XK-MSG
        GOBACK
    END-IF
    MOVE DT-KEY-ID TO XK-ID
    PERFORM FILL-CLAIM-PARMS
    MOVE "PIX CLAIM" TO XK-MSG.

CALL-CLAIM-OP.
    MOVE SPACES TO BK-PX-DICT-PARMS
    IF XK-OP = "KEY-CLAIM-ACK"
        MOVE "CLAIM-ACK" TO DT-OP OF BK-PX-DICT-PARMS
    ELSE
        IF XK-OP = "KEY-CLAIM-CONFIRM"
            MOVE "CLAIM-CONFIRM" TO DT-OP OF BK-PX-DICT-PARMS
        ELSE
            IF XK-OP = "KEY-CLAIM-CANCEL"
                MOVE "CLAIM-CANCEL" TO DT-OP
                    OF BK-PX-DICT-PARMS
            ELSE
                MOVE "CLAIM-COMPLETE" TO DT-OP
                    OF BK-PX-DICT-PARMS
            END-IF
        END-IF
    END-IF
    MOVE XK-CLAIM-ID TO DT-CLAIM-ID OF BK-PX-DICT-PARMS
    MOVE XK-PART TO DT-PART OF BK-PX-DICT-PARMS
    MOVE XK-REASON TO DT-REASON OF BK-PX-DICT-PARMS
    MOVE XK-OPERATOR TO DT-OPERATOR OF BK-PX-DICT-PARMS
    MOVE XK-REQUEST TO DT-CLAIM-REQ-ID OF BK-PX-DICT-PARMS
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    IF DT-RC NOT = "00"
        MOVE DT-RC TO XK-RC
        MOVE DT-MSG TO XK-MSG
        GOBACK
    END-IF
    MOVE DT-KEY-ID TO XK-ID
    PERFORM FILL-CLAIM-PARMS
    PERFORM SYNC-CLAIM-LOCAL.

CHECK-CLAIMANT-ACCT.
    IF XK-ACCT = SPACES OR XK-CUST = SPACES
        MOVE "20" TO XK-RC
        MOVE "CLAIMANT ACCOUNT AND CUSTOMER REQUIRED" TO XK-MSG
        GOBACK
    END-IF
    CALL "BACQRY" USING XK-ACCT WS-ACCT-OUT
    IF AO-RC NOT = "00"
        MOVE "20" TO XK-RC
        MOVE "CLAIMANT ACCOUNT NOT FOUND" TO XK-MSG
        GOBACK
    END-IF
    IF AO-STATUS NOT = "AC"
        MOVE "20" TO XK-RC
        MOVE "CLAIMANT ACCOUNT NOT ACTIVE" TO XK-MSG
        GOBACK
    END-IF
    IF XK-CUST NOT = AO-CUST OF WS-ACCT-OUT
        MOVE "20" TO XK-RC
        MOVE "CLAIMANT CUSTOMER / ACCOUNT MISMATCH" TO XK-MSG
    END-IF.

FILL-CLAIM-PARMS.
    MOVE DT-CLAIM-ID TO XK-CLAIM-ID
    MOVE DT-CLAIM-STATUS TO XK-CLAIM
    MOVE DT-CLAIM-TYPE TO XK-CLAIM-TYPE
    MOVE DT-RESOL-END TO XK-RESOL-END
    MOVE DT-COMPL-END TO XK-COMPL-END
    MOVE DT-CONFIRM-REASON TO XK-CONFIRM-R
    MOVE DT-CANCEL-REASON TO XK-CANCEL-R
    MOVE DT-CANCELLED-BY TO XK-CANCEL-BY
    MOVE DT-VERSION TO XK-DICT-VER
    MOVE DT-KEY-STATUS TO XK-STATUS
    MOVE DT-ACCT TO XK-ACCT
    MOVE DT-CUST TO XK-CUST
    MOVE DT-PART TO XK-PART
    MOVE DT-REPLAY TO XK-REPLAY.
DO-DICT-SYNC.
    MOVE SPACES TO BK-PX-DICT-PARMS
    MOVE "DICT-SYNC" TO DT-OP OF BK-PX-DICT-PARMS
    MOVE XK-ID TO DT-KEY-ID OF BK-PX-DICT-PARMS
    MOVE XK-DICT-VER TO DT-VERSION OF BK-PX-DICT-PARMS
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    IF DT-RC NOT = "00"
        MOVE DT-RC TO XK-RC
        MOVE DT-MSG TO XK-MSG
        PERFORM SYNC-EMIT
        GOBACK
    END-IF
    PERFORM FILL-CLAIM-PARMS
    IF DT-PART NOT = FUNCTION TRIM(PC-SELF)
        MOVE "00" TO XK-RC
        MOVE "PIX KEY HELD BY OTHER PARTICIPANT" TO XK-MSG
        PERFORM SYNC-EMIT
        GOBACK
    END-IF
    MOVE SPACES TO BK-PX-KEY
    MOVE XK-ID TO PK-ID OF BK-PX-KEY
    MOVE "GET" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    IF KS-RC = "00"
        IF PK-ACCT OF BK-PX-KEY NOT = DT-ACCT OR
           PK-TYPE OF BK-PX-KEY NOT = DT-KEY-TYPE OR
           PK-CUST OF BK-PX-KEY NOT = DT-CUST
            MOVE "21" TO XK-RC
            MOVE "PIX KEY LOCAL/DICT DIVERGENCE" TO XK-MSG
            MOVE "KEY-DIVERGENT" TO WS-EXC-CODE
            PERFORM EMIT-DICT-EXCEPTION
        END-IF
        PERFORM SYNC-CLAIM-LOCAL
    ELSE
        IF KS-RC = "23"
            MOVE "21" TO XK-RC
            MOVE "PIX KEY MISSING LOCALLY" TO XK-MSG
            MOVE "KEY-MISSING" TO WS-EXC-CODE
            PERFORM EMIT-DICT-EXCEPTION
            MOVE "00" TO XK-RC
            MOVE "DICT SYNC EXCEPTION RECORDED" TO XK-MSG
            PERFORM SYNC-EMIT
            GOBACK
        END-IF
        MOVE KS-RC TO XK-RC
        MOVE KS-MSG TO XK-MSG
        PERFORM SYNC-EMIT
        GOBACK
    END-IF
    PERFORM FILL-CLAIM-PARMS
    IF XK-RC = "00"
        MOVE "PIX KEY CONSISTENT WITH DICT" TO XK-MSG
    END-IF
    PERFORM SYNC-EMIT.

SYNC-CLAIM-LOCAL.
    MOVE SPACES TO BK-PX-KEY
    MOVE XK-ID TO PK-ID OF BK-PX-KEY
    MOVE "GET" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    EVALUATE KS-RC
        WHEN "00"
            IF DT-SELF-FLAG = "Y" AND DT-KEY-STATUS = "ACTIVE"
                MOVE DT-CLAIM-STATUS TO PK-CLAIM OF BK-PX-KEY
                MOVE DT-CLAIM-ID TO PK-CLAIM-ID OF BK-PX-KEY
                MOVE DT-VERSION TO PK-DICT-VER OF BK-PX-KEY
                MOVE DT-ACCT TO PK-ACCT OF BK-PX-KEY
                MOVE DT-CUST TO PK-CUST OF BK-PX-KEY
                IF PK-STATUS OF BK-PX-KEY NOT = "INACTIVE"
                    MOVE "ACTIVE" TO PK-STATUS OF BK-PX-KEY
                END-IF
                PERFORM TOUCH
                PERFORM COMPUTE-LOCAL-HASH
                MOVE "REWRITE" TO KS-OP
                CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
                IF KS-RC NOT = "00"
                    MOVE KS-RC TO XK-RC
                    MOVE KS-MSG TO XK-MSG
                END-IF
            ELSE
                PERFORM DROP-LOCAL-MIRROR
            END-IF
        WHEN "23" CONTINUE
        WHEN OTHER
            MOVE KS-RC TO XK-RC
            MOVE KS-MSG TO XK-MSG
    END-EVALUATE.

DROP-LOCAL-MIRROR.
    MOVE "DELETE-REC" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    IF KS-RC NOT = "00" AND KS-RC NOT = "23"
        MOVE KS-RC TO XK-RC
        MOVE KS-MSG TO XK-MSG
    END-IF.

EMIT-DICT-EXCEPTION.
    MOVE SPACES TO BK-EXC-REC
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    STRING "E" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO EXC-ID OF BK-EXC-REC
    END-STRING
    IF XK-REQUEST NOT = SPACES
        MOVE XK-REQUEST(1:20) TO EXC-RUN-ID OF BK-EXC-REC
    ELSE
        MOVE XK-CORR(1:20) TO EXC-RUN-ID OF BK-EXC-REC
    END-IF
    MOVE "PIXDICT" TO EXC-TYPE OF BK-EXC-REC
    MOVE WS-EXC-CODE TO EXC-CODE OF BK-EXC-REC
    MOVE "OPEN" TO EXC-STATUS OF BK-EXC-REC
    MOVE XK-ID TO EXC-KEY OF BK-EXC-REC
    MOVE XK-CLAIM-ID TO EXC-SRC-REF OF BK-EXC-REC
    MOVE WS-BIZDATE TO EXC-BIZDATE OF BK-EXC-REC
    MOVE "LOCAL/DICT DIVERGENCE AT SYNC" TO EXC-REASON
        OF BK-EXC-REC
    MOVE SPACES TO EXC-RESOLUTION OF BK-EXC-REC
    STRING "local=" DELIMITED SIZE
        FUNCTION TRIM(PK-ACCT OF BK-PX-KEY) DELIMITED SIZE "/dict="
        DELIMITED SIZE FUNCTION TRIM(DT-ACCT) DELIMITED SIZE
        INTO EXC-RESOLUTION OF BK-EXC-REC
    END-STRING
    IF XK-OPERATOR NOT = SPACES
        MOVE XK-OPERATOR TO EXC-OPERATOR OF BK-EXC-REC
    ELSE
        MOVE "DICTSYNC" TO EXC-OPERATOR OF BK-EXC-REC
    END-IF
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO EXC-CREATED OF BK-EXC-REC
    MOVE WS-NOW(1:14) TO EXC-UPDATED OF BK-EXC-REC
    MOVE SPACES TO BK-REC-PARMS
    MOVE "WRITE" TO RP-OP
    CALL "BRECESO" USING BK-REC-PARMS BK-EXC-REC.

SYNC-EMIT.
    MOVE XK-OPERATOR TO BK-AUD-OPERATOR
    MOVE "KEY-SYNC" TO WS-AUD-ACTION
    MOVE XK-ID TO BK-AUD-ENTITY
    MOVE XK-CORR TO BK-AUD-CORR
    MOVE XK-STATUS TO BK-AUD-AFTER
    MOVE XK-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE "PIX.KEY.DICT-SYNC.v1" TO BK-EVT-TYPE
    MOVE XK-ID TO BK-EVT-KEY
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(XK-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XK-CLAIM) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XK-STATUS) DELIMITED SIZE "|" DELIMITED SIZE
        XK-DICT-VER DELIMITED SIZE INTO BK-EVT-PAYLOAD
    END-STRING
    CALL "BEVT" USING BK-EVT-PARMS.

CHECK-REGISTER.
    MOVE SPACES TO BK-PX-KEY
    IF XK-PART = SPACES
        MOVE PC-SELF TO XK-PART
    END-IF
    IF XK-TYPE = SPACES OR XK-VALUE = SPACES
        MOVE "20" TO XK-RC
        MOVE "PIX KEY TYPE AND VALUE REQUIRED" TO XK-MSG
        GOBACK
    END-IF
    IF XK-ACCT = SPACES
        MOVE "20" TO XK-RC
        MOVE "PIX KEY REQUIRES ACCOUNT" TO XK-MSG
        GOBACK
    END-IF
    CALL "BACQRY" USING XK-ACCT WS-ACCT-OUT
    IF AO-RC NOT = "00"
        MOVE "20" TO XK-RC
        MOVE "PIX KEY ACCOUNT NOT FOUND" TO XK-MSG
        GOBACK
    END-IF
    IF AO-STATUS NOT = "AC"
        MOVE "20" TO XK-RC
        MOVE "PIX KEY ACCOUNT NOT ACTIVE" TO XK-MSG
        GOBACK
    END-IF
    IF XK-CUST = SPACES
        MOVE AO-CUST OF WS-ACCT-OUT TO XK-CUST
    END-IF
    IF XK-CUST NOT = AO-CUST OF WS-ACCT-OUT
        MOVE "20" TO XK-RC
        MOVE "PIX KEY CUSTOMER / ACCOUNT MISMATCH" TO XK-MSG
        GOBACK
    END-IF
    MOVE XK-ACCT TO PK-ACCT OF BK-PX-KEY
    MOVE "COUNT-ACCT" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    IF KS-RC NOT = "00" AND KS-RC NOT = "23"
        MOVE KS-RC TO XK-RC
        MOVE KS-MSG TO XK-MSG
        GOBACK
    END-IF
    MOVE "00" TO KS-RC
    IF KS-COUNT >= PC-KEY-LIMIT
        MOVE "20" TO XK-RC
        MOVE "PIX KEY LIMIT PER ACCOUNT REACHED" TO XK-MSG
        GOBACK
    END-IF.

STORE-LOCAL.
    MOVE SPACES TO BK-PX-KEY
    PERFORM FILL-LOCAL-BASIC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO PK-CREATED OF BK-PX-KEY
    MOVE WS-NOW(1:14) TO PK-UPDATED OF BK-PX-KEY
    MOVE 1 TO PK-VERSION OF BK-PX-KEY
    PERFORM COMPUTE-LOCAL-HASH
    MOVE "WRITE" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    IF KS-RC NOT = "00"
        MOVE KS-RC TO XK-RC
        MOVE KS-MSG TO XK-MSG
    END-IF.

MOVE-LOCAL.
    PERFORM LOAD-LOCAL
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    IF WS-FOUND = "Y"
        MOVE "DELETE-REC" TO KS-OP
        CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
        IF KS-RC NOT = "00"
            MOVE KS-RC TO XK-RC
            MOVE KS-MSG TO XK-MSG
            GOBACK
        END-IF
    END-IF
    PERFORM STORE-LOCAL.

TOUCH-LOCAL.
    PERFORM LOAD-LOCAL
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    IF WS-FOUND NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE XK-CLAIM TO PK-CLAIM OF BK-PX-KEY
    IF XK-STATUS NOT = SPACES
        MOVE XK-STATUS TO PK-STATUS OF BK-PX-KEY
    END-IF
    IF XK-PART NOT = SPACES
        MOVE XK-PART TO PK-PART OF BK-PX-KEY
    END-IF
    PERFORM TOUCH
    PERFORM COMPUTE-LOCAL-HASH
    MOVE "REWRITE" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    IF KS-RC NOT = "00"
        MOVE KS-RC TO XK-RC
        MOVE KS-MSG TO XK-MSG
    END-IF.

REMOVE-LOCAL.
    PERFORM LOAD-LOCAL
    IF XK-RC NOT = "00"
        GOBACK
    END-IF
    IF WS-FOUND NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE "DELETE-REC" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    IF KS-RC NOT = "00" AND KS-RC NOT = "23"
        MOVE KS-RC TO XK-RC
        MOVE KS-MSG TO XK-MSG
    END-IF.

LOAD-LOCAL.
    MOVE SPACES TO BK-PX-KEY
    MOVE XK-ID TO PK-ID OF BK-PX-KEY
    MOVE "N" TO WS-FOUND
    MOVE "00" TO XK-RC
    IF XK-ID = SPACES
        MOVE "20" TO XK-RC
        MOVE "PIX KEY ID REQUIRED" TO XK-MSG
        GOBACK
    END-IF
    MOVE "GET" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    EVALUATE KS-RC
        WHEN "00" MOVE "Y" TO WS-FOUND
        WHEN "23" CONTINUE
        WHEN OTHER
            MOVE KS-RC TO XK-RC
            MOVE KS-MSG TO XK-MSG
    END-EVALUATE.

FILL-LOCAL-BASIC.
    MOVE XK-ID TO PK-ID OF BK-PX-KEY
    MOVE XK-TYPE TO PK-TYPE OF BK-PX-KEY
    MOVE XK-HASH TO PK-VALUE-HASH OF BK-PX-KEY
    MOVE XK-MASK TO PK-MASK OF BK-PX-KEY
    MOVE XK-CUST TO PK-CUST OF BK-PX-KEY
    MOVE XK-ACCT TO PK-ACCT OF BK-PX-KEY
    MOVE XK-PART TO PK-PART OF BK-PX-KEY
    MOVE XK-CLAIM TO PK-CLAIM OF BK-PX-KEY
    MOVE XK-CLAIM-ID TO PK-CLAIM-ID OF BK-PX-KEY
    MOVE XK-DICT-VER TO PK-DICT-VER OF BK-PX-KEY
    MOVE "N" TO PK-FRAUD OF BK-PX-KEY
    IF XK-STATUS = SPACES
        MOVE "ACTIVE" TO PK-STATUS OF BK-PX-KEY
    ELSE
        MOVE XK-STATUS TO PK-STATUS OF BK-PX-KEY
    END-IF
    IF DT-SELF-FLAG = "Y"
        MOVE "Y" TO PK-SELF OF BK-PX-KEY
    ELSE
        IF XK-PART = FUNCTION TRIM(PC-SELF)
            MOVE "Y" TO PK-SELF OF BK-PX-KEY
        ELSE
            MOVE "N" TO PK-SELF OF BK-PX-KEY
        END-IF
    END-IF
    MOVE WS-BIZDATE TO PK-BIZDATE OF BK-PX-KEY
    MOVE WS-BIZDATE TO PK-ACTIVE-DATE OF BK-PX-KEY
    MOVE 0 TO PK-END-DATE OF BK-PX-KEY.

COMPUTE-LOCAL-HASH.
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(PK-ID OF BK-PX-KEY) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(PK-TYPE OF BK-PX-KEY)
        DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PK-VALUE-HASH OF BK-PX-KEY) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(PK-ACCT OF BK-PX-KEY)
        DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PK-STATUS OF BK-PX-KEY) DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO PK-HASH OF BK-PX-KEY.

FILL-KEY.
    MOVE DT-KEY-ID TO XK-ID
    MOVE DT-KEY-TYPE TO XK-TYPE
    MOVE DT-KEY-HASH TO XK-HASH
    MOVE DT-KEY-MASK TO XK-MASK
    MOVE DT-ACCT TO XK-ACCT
    MOVE DT-CUST TO XK-CUST
    MOVE DT-PART TO XK-PART.

FILL-PARMS.
    MOVE PK-ID OF BK-PX-KEY TO XK-ID
    MOVE PK-TYPE OF BK-PX-KEY TO XK-TYPE
    MOVE PK-VALUE-HASH OF BK-PX-KEY TO XK-HASH
    MOVE PK-MASK OF BK-PX-KEY TO XK-MASK
    MOVE PK-CUST OF BK-PX-KEY TO XK-CUST
    MOVE PK-ACCT OF BK-PX-KEY TO XK-ACCT
    MOVE PK-PART OF BK-PX-KEY TO XK-PART
    MOVE PK-SELF OF BK-PX-KEY TO XK-SELF
    MOVE PK-STATUS OF BK-PX-KEY TO XK-STATUS
    MOVE PK-CLAIM OF BK-PX-KEY TO XK-CLAIM
    MOVE PK-CLAIM-ID OF BK-PX-KEY TO XK-CLAIM-ID
    MOVE PK-DICT-VER OF BK-PX-KEY TO XK-DICT-VER
    MOVE PK-FRAUD OF BK-PX-KEY TO XK-FRAUD.

TOUCH.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO PK-UPDATED OF BK-PX-KEY
    ADD 1 TO PK-VERSION OF BK-PX-KEY.

CHECK-KEY-FRAUD.
    MOVE SPACES TO BK-PX-FRD-PARMS
    MOVE "FRAUD-CHECK" TO FP-OP
    MOVE "KEY" TO FP-TARGET-TYPE
    MOVE PK-ID OF BK-PX-KEY TO FP-TARGET-KEY
    MOVE "KEY" TO FP-DIRECTION
    CALL "BPXFR" USING BK-PX-FRD-PARMS
    IF FP-RC NOT = "00"
        MOVE FP-RC TO XK-RC
        MOVE FP-MSG TO XK-MSG
    END-IF.

LOCK-KEY.
    MOVE SPACES TO WS-LOCK-NAME
    STRING "PIXKEY-" DELIMITED SIZE FUNCTION TRIM(XK-ID)
        DELIMITED SIZE INTO WS-LOCK-NAME
    END-STRING
    MOVE FUNCTION TRIM(XK-OPERATOR) TO WS-LOCK-OWNER
    MOVE "A" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST
    IF WS-LOCK-ST NOT = "00"
        MOVE "24" TO XK-RC
        MOVE "PIX KEY LOCKED" TO XK-MSG
    END-IF.

UNLOCK-KEY.
    MOVE "R" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST.

EMIT.
    EVALUATE FUNCTION TRIM(XK-OP)
        WHEN "KEY-REGISTER"
            MOVE "KEY-REG" TO WS-AUD-ACTION
            MOVE "PIX.KEY.REGISTERED.v1" TO WS-EVT-TYPE
        WHEN "KEY-CHANGE"
            MOVE "KEY-CHG" TO WS-AUD-ACTION
            MOVE "PIX.KEY.CHANGED.v1" TO WS-EVT-TYPE
        WHEN "KEY-STATUS"
            MOVE "KEY-STS" TO WS-AUD-ACTION
            MOVE "PIX.KEY.STATUS.v1" TO WS-EVT-TYPE
        WHEN "KEY-CLAIM-CREATE"
            MOVE "KEY-CLM-CRT" TO WS-AUD-ACTION
            MOVE "PIX.KEY.CLAIM.v1" TO WS-EVT-TYPE
        WHEN "KEY-CLAIM-ACK"
            MOVE "KEY-CLM-ACK" TO WS-AUD-ACTION
            MOVE "PIX.KEY.CLAIM.v1" TO WS-EVT-TYPE
        WHEN "KEY-CLAIM-CONFIRM"
            MOVE "KEY-CLM-CFM" TO WS-AUD-ACTION
            MOVE "PIX.KEY.CLAIM.v1" TO WS-EVT-TYPE
        WHEN "KEY-CLAIM-CANCEL"
            MOVE "KEY-CLM-CNL" TO WS-AUD-ACTION
            MOVE "PIX.KEY.CLAIM.v1" TO WS-EVT-TYPE
        WHEN "KEY-CLAIM-COMPLETE"
            MOVE "KEY-CLM-CMP" TO WS-AUD-ACTION
            IF XK-CLAIM-TYPE = "PORTABILITY"
                MOVE "PIX.KEY.PORTABILITY.v1" TO WS-EVT-TYPE
            ELSE
                MOVE "PIX.KEY.CLAIM.v1" TO WS-EVT-TYPE
            END-IF
        WHEN OTHER
            MOVE "KEY" TO WS-AUD-ACTION
            MOVE "PIX.KEY.CHANGED.v1" TO WS-EVT-TYPE
    END-EVALUATE
    MOVE XK-OPERATOR TO BK-AUD-OPERATOR
    MOVE WS-AUD-ACTION TO BK-AUD-ACTION
    MOVE XK-ID TO BK-AUD-ENTITY
    MOVE XK-CORR TO BK-AUD-CORR
    MOVE XK-STATUS TO BK-AUD-AFTER
    MOVE XK-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE WS-EVT-TYPE TO BK-EVT-TYPE
    MOVE XK-ID TO BK-EVT-KEY
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(XK-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XK-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XK-STATUS) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XK-ACCT) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XK-CLAIM-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XK-CLAIM) DELIMITED SIZE
        INTO BK-EVT-PAYLOAD
    END-STRING
    CALL "BEVT" USING BK-EVT-PARMS.
