IDENTIFICATION DIVISION.
PROGRAM-ID. BPXMED.

*> MED (Mecanismo Especial de Devolucao) case engine.
*> A MED case is a durable operational/regulatory workflow anchored to an
*> immutable original Pix.  The case itself NEVER moves money: it records
*> claim, eligibility, a funds reservation and a decision.  Only when an
*> approved decision is executed does the engine delegate to the existing
*> Pix devolution program (BPXDEV), which runs the real transaction through
*> the transaction lifecycle, ledger, settlement and reconciliation.
*> Idempotency and duplicate detection are durable (store-backed), so retries,
*> restarts and concurrent requests never create a second case or a second
*> financial return for the same underlying event.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT SCAN-FILE ASSIGN TO WS-SCAN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS MC-CASE-ID OF SCAN-REC
        FILE STATUS IS WS-SCAN-ST.

DATA DIVISION.
FILE SECTION.
FD SCAN-FILE.
01 SCAN-REC.
   COPY "BPXMC".

WORKING-STORAGE SECTION.
   COPY "BPXCFG".
   COPY "BPXSTO".
   COPY "BPXMCSTO".
   COPY "BPXMHSP".
   COPY "BPXFP".
   COPY "BDATP".
   COPY "BKAUDP".
   COPY "BKEVTP".
01 BK-PX-MC-REC.
   COPY "BPXMC".
01 BK-PX-REC.
   COPY "BPX".
COPY "BPXPP".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).
01 WS-SCAN-PATH PIC X(200).
01 WS-SCAN-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-ORIG.
   05 WS-ORIG-ID          PIC X(12).
   05 WS-ORIG-DIR         PIC X(08).
   05 WS-ORIG-STATUS      PIC X(12).
   05 WS-ORIG-DEV-STATUS  PIC X(12).
   05 WS-ORIG-AMOUNT      PIC S9(15)V99 COMP-3.
   05 WS-ORIG-BLOCK-AMT   PIC S9(15)V99 COMP-3.
   05 WS-ORIG-CURRENCY    PIC X(03).
   05 WS-ORIG-TXN-ID      PIC X(12).
   05 WS-ORIG-JRN-ID      PIC X(20).
   05 WS-ORIG-E2E         PIC X(32).
   05 WS-ORIG-PAYER-ACCT  PIC X(12).
   05 WS-ORIG-PAYER-CUST  PIC X(12).
   05 WS-ORIG-PAYER-PART  PIC X(12).
   05 WS-ORIG-PAYEE-ACCT  PIC X(12).
   05 WS-ORIG-PAYEE-CUST  PIC X(12).
   05 WS-ORIG-PAYEE-PART  PIC X(12).
   05 WS-ORIG-MED-CASE    PIC X(12).
   05 WS-ORIG-MED-STATUS  PIC X(12).
01 WS-BAL-OUT.
   05 BO-LEDGER PIC S9(15)V99 COMP-3.
   05 BO-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BO-BLOCKED PIC S9(15)V99 COMP-3.
   05 BO-CURRENCY PIC X(03).
   05 BO-UPDATED PIC 9(08).
   05 BO-SEQ PIC 9(12).
   05 BO-RC PIC X(02).
01 WS-BAL-ACCT PIC X(12).
01 WS-ID-TYPE PIC X(08).
01 WS-ID-ISPB PIC X(08).
01 WS-ID-VAL PIC X(32).
01 WS-ID-RC PIC X(02).
01 WS-NOW PIC X(14).
01 WS-CASE-ID PIC X(12).
01 WS-CASE-STATUS PIC X(12).
01 WS-REJ PIC X(40).
01 WS-BLOCK-TARGET PIC X(12).
COPY "BKSPLP".
01 WS-SPI PIC 9(02).
01 WS-SPLIT-LEG-REMAIN PIC S9(15)V99 COMP-3.
01 WS-CASE-AMT PIC S9(15)V99 COMP-3.
01 WS-BLOCK-MSG PIC X(80).
01 WS-BLOCK-SKIP PIC X(01).
01 WS-EVT PIC X(16).
01 WS-NXT PIC X(12).
01 WS-STM-RC PIC X(02).
01 WS-STM-MSG PIC X(80).
01 WS-SO-RC PIC X(02).
01 WS-HLD-RC PIC X(02).
01 WS-DEV-RC PIC X(02).
01 WS-DEVOL-ID PIC X(12).
01 WS-RETURNED PIC S9(15)V99 COMP-3.
01 WS-REMAIN-ORIG PIC S9(15)V99 COMP-3.
01 WS-AVAILABLE PIC S9(15)V99 COMP-3.
01 WS-ELIGIBLE PIC S9(15)V99 COMP-3.
01 WS-DEC-AMT PIC S9(15)V99 COMP-3.
01 WS-FRAUD PIC X(01).
01 WS-LOCK-NAME PIC X(24).
01 WS-LOCK-OWNER PIC X(16).
01 WS-LOCK-MODE PIC X(01).
01 WS-LOCK-ST PIC X(02).
01 WS-DEADLINE PIC 9(08).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-HASH-BUF PIC X(600).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-EVT-TYPE PIC X(40).

LINKAGE SECTION.
   COPY "BPXMCP".

PROCEDURE DIVISION USING BK-MC-PARMS.
    MOVE "00" TO MP-RC
    MOVE SPACES TO MP-MSG
    MOVE "N" TO MP-REPLAY
    MOVE 0 TO MP-COUNT
    CALL "BCFG" USING WS-CFG
    CALL "BPXCFG" USING BK-PX-CFG
    IF PC-STATUS NOT = "00" OR PC-ENABLED NOT = "Y"
        MOVE "20" TO MP-RC
        MOVE "PIX UNAVAILABLE" TO MP-MSG
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(MP-OP)
        WHEN "MED-OPEN" PERFORM DO-OPEN
        WHEN "MED-VALIDATE" PERFORM DO-VALIDATE
        WHEN "MED-BLOCK" PERFORM DO-BLOCK
        WHEN "MED-DECIDE" PERFORM DO-DECIDE
        WHEN "MED-EXECUTE" PERFORM DO-EXECUTE
        WHEN "MED-RELEASE" PERFORM DO-RELEASE
        WHEN "MED-CLOSE" PERFORM DO-CLOSE
        WHEN "MED-EXPIRE" PERFORM DO-EXPIRE
        WHEN "MED-GET" PERFORM DO-GET
        WHEN "MED-RECON" PERFORM DO-SET-RECON
        WHEN "MED-LIST" PERFORM DO-LIST
        WHEN OTHER
            MOVE "99" TO MP-RC
            MOVE "UNKNOWN MED OP" TO MP-MSG
    END-EVALUATE
    GOBACK.

OPEN-CASE-LOCK.
    IF MP-REQ-CASE-ID NOT = SPACES
        MOVE SPACES TO WS-LOCK-NAME
        STRING "MED-" DELIMITED SIZE FUNCTION TRIM(MP-REQ-CASE-ID)
            DELIMITED SIZE INTO WS-LOCK-NAME
        END-STRING
    ELSE
        MOVE SPACES TO WS-LOCK-NAME
        STRING "MEDO-" DELIMITED SIZE FUNCTION TRIM(MP-ORIG-PIX-ID)
            DELIMITED SIZE INTO WS-LOCK-NAME
        END-STRING
    END-IF
    MOVE FUNCTION TRIM(MP-OPERATOR) TO WS-LOCK-OWNER
    MOVE "A" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST
    IF WS-LOCK-ST NOT = "00"
        MOVE "24" TO MP-RC
        MOVE "MED CASE LOCKED" TO MP-MSG
    END-IF.

CLOSE-CASE-LOCK.
    MOVE "R" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST.

DO-OPEN.
    PERFORM OPEN-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM OPEN-IDEMPOTENCY
    IF MP-RC NOT = "00"
        PERFORM CLOSE-CASE-LOCK
        GOBACK
    END-IF
    IF MP-REPLAY = "Y"
        PERFORM CLOSE-CASE-LOCK
        PERFORM EXPOSE-CASE
        GOBACK
    END-IF
    PERFORM OPEN-BUILD
    IF MP-RC = "00"
        PERFORM STORE-CASE-NEW
    END-IF
    IF MP-RC = "00"
        PERFORM LINK-ORIGINAL
        PERFORM EMIT-CASE
    END-IF
    PERFORM CLOSE-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM EXPOSE-CASE
    MOVE "MED CASE OPENED" TO MP-MSG.

OPEN-IDEMPOTENCY.
    IF MP-REQ-ID = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-MC-STO-REQ
    MOVE "GET-REQ" TO MC-SO-OP
    MOVE MP-REQ-ID TO MC-SO-REQ-ID
    CALL "BPXMSTO" USING BK-MC-STO-REQ BK-PX-MC-REC
    IF MC-SO-RC = "00"
        MOVE MC-SO-CASE-ID TO MP-REQ-CASE-ID
        MOVE "Y" TO MP-REPLAY
        PERFORM LOAD-CASE
        IF MP-RC = "00"
            MOVE "MED CASE REPLAY" TO MP-MSG
        END-IF
        EXIT PARAGRAPH
    END-IF
    IF MC-SO-RC NOT = "23"
        MOVE MC-SO-RC TO MP-RC
        MOVE "MED IDEMPOTENCY STORE ERROR" TO MP-MSG
    END-IF.

OPEN-BUILD.
    MOVE SPACES TO BK-PX-MC-REC
    PERFORM LOAD-ORIGINAL
    IF MP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM OPEN-DUPLICATE-CHECK
    IF MP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM OPEN-FRAUD-DETECT
    PERFORM BUILD-CASE-ID
    IF MP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-MC-REC
    MOVE WS-CASE-ID TO MC-CASE-ID OF BK-PX-MC-REC
    MOVE MP-ORIG-PIX-ID TO MC-ORIG-PIX-ID OF BK-PX-MC-REC
    MOVE WS-ORIG-E2E TO MC-E2E-ID OF BK-PX-MC-REC
    MOVE WS-ORIG-TXN-ID TO MC-ORIG-TXN-ID OF BK-PX-MC-REC
    MOVE WS-ORIG-JRN-ID TO MC-ORIG-JRN-ID OF BK-PX-MC-REC
    MOVE WS-ORIG-DIR TO MC-ORIG-DIR OF BK-PX-MC-REC
    MOVE WS-ORIG-PAYER-ACCT TO MC-PAYER-ACCT OF BK-PX-MC-REC
    MOVE WS-ORIG-PAYER-CUST TO MC-PAYER-CUST OF BK-PX-MC-REC
    MOVE WS-ORIG-PAYER-PART TO MC-PAYER-PART OF BK-PX-MC-REC
    MOVE WS-ORIG-PAYEE-ACCT TO MC-PAYEE-ACCT OF BK-PX-MC-REC
    MOVE WS-ORIG-PAYEE-CUST TO MC-PAYEE-CUST OF BK-PX-MC-REC
    MOVE WS-ORIG-PAYEE-PART TO MC-PAYEE-PART OF BK-PX-MC-REC
    IF MP-CLAIMANT = SPACES
        MOVE WS-ORIG-PAYER-CUST TO MC-CLAIMANT OF BK-PX-MC-REC
        MOVE "PAYER" TO MC-CLAIMANT-TYPE OF BK-PX-MC-REC
    ELSE
        MOVE MP-CLAIMANT TO MC-CLAIMANT OF BK-PX-MC-REC
        IF MP-CLAIMANT-TYPE = SPACES
            MOVE "PAYER" TO MC-CLAIMANT-TYPE OF BK-PX-MC-REC
        ELSE
            MOVE MP-CLAIMANT-TYPE TO MC-CLAIMANT-TYPE OF BK-PX-MC-REC
        END-IF
    END-IF
    MOVE WS-ORIG-AMOUNT TO MC-ORIG-AMOUNT OF BK-PX-MC-REC
    MOVE MP-CLAIMED-AMT TO MC-CLAIMED-AMT OF BK-PX-MC-REC
    MOVE WS-ORIG-CURRENCY TO MC-CURRENCY OF BK-PX-MC-REC
    MOVE WS-ORIG-AMOUNT TO MC-ELIGIBLE-AMT OF BK-PX-MC-REC
    MOVE MP-REASON TO MC-REASON OF BK-PX-MC-REC
    MOVE WS-FRAUD TO MC-FRAUD-FLAG OF BK-PX-MC-REC
    MOVE MP-FRAUD-SOURCE TO MC-FRAUD-SOURCE OF BK-PX-MC-REC
    MOVE MP-FRAUD-REF TO MC-FRAUD-REF OF BK-PX-MC-REC
    MOVE MP-CHANNEL TO MC-CHANNEL OF BK-PX-MC-REC
    MOVE "OPEN" TO MC-STATUS OF BK-PX-MC-REC
    MOVE "NONE" TO MC-DECISION OF BK-PX-MC-REC
    MOVE "NONE" TO MC-RECON-STATUS OF BK-PX-MC-REC
    MOVE 0 TO MC-BLOCKED-AMT OF BK-PX-MC-REC
    MOVE 0 TO MC-AVAILABLE OF BK-PX-MC-REC
    MOVE 0 TO MC-DECISION-AMT OF BK-PX-MC-REC
    MOVE 0 TO MC-RETURNED-AMT OF BK-PX-MC-REC
    MOVE 0 TO MC-REMAIN-AMT OF BK-PX-MC-REC
    MOVE WS-BIZDATE TO MC-BIZDATE OF BK-PX-MC-REC
    PERFORM COMPUTE-DEADLINE
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO MC-CREATED OF BK-PX-MC-REC
    MOVE WS-NOW(1:14) TO MC-UPDATED OF BK-PX-MC-REC
    MOVE 1 TO MC-VERSION OF BK-PX-MC-REC
    MOVE MP-OPERATOR TO MC-OPERATOR OF BK-PX-MC-REC
    MOVE MP-CORR TO MC-CORR OF BK-PX-MC-REC
    MOVE MP-REQ-ID TO MC-REQUEST OF BK-PX-MC-REC
    MOVE MP-REQ-ID TO MC-IDEM-KEY OF BK-PX-MC-REC
    PERFORM COMPUTE-HASH.

OPEN-DUPLICATE-CHECK.
    MOVE SPACES TO BK-MC-STO-REQ
    MOVE "GET-PIX" TO MC-SO-OP
    MOVE MP-ORIG-PIX-ID TO MC-SO-PIXID
    MOVE MP-REASON TO MC-SO-PREASON
    CALL "BPXMSTO" USING BK-MC-STO-REQ BK-PX-MC-REC
    IF MC-SO-RC = "00"
        MOVE "22" TO MP-RC
        MOVE "MED CASE ALREADY EXISTS FOR PIX" TO MP-MSG
    ELSE
        MOVE "00" TO MP-RC
    END-IF.

OPEN-FRAUD-DETECT.
    MOVE "N" TO WS-FRAUD
    IF MP-FRAUD-FLAG = "Y"
        MOVE "Y" TO WS-FRAUD
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-FRD-PARMS
    MOVE "FRAUD-CHECK" TO FP-OP
    MOVE "IN" TO FP-DIRECTION
    MOVE "ACCOUNT" TO FP-TARGET-TYPE
    IF WS-ORIG-DIR = "IN"
        MOVE WS-ORIG-PAYEE-ACCT TO FP-TARGET-KEY
    ELSE
        MOVE WS-ORIG-PAYER-ACCT TO FP-TARGET-KEY
    END-IF
    CALL "BPXFR" USING BK-PX-FRD-PARMS
    IF FP-RC NOT = "00"
        MOVE "Y" TO WS-FRAUD
    END-IF.

BUILD-CASE-ID.
    MOVE "MED" TO WS-ID-TYPE
    MOVE PC-E2E-ISPB TO WS-ID-ISPB
    CALL "BPXID" USING WS-ID-TYPE WS-ID-ISPB WS-ID-VAL WS-ID-RC
    IF WS-ID-RC NOT = "00"
        MOVE "20" TO MP-RC
        MOVE "MED SEQUENCE ERROR" TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-ID-VAL(1:12) TO WS-CASE-ID
    MOVE WS-CASE-ID TO MP-REQ-CASE-ID.

LOAD-ORIGINAL.
    MOVE SPACES TO BK-PX-REC
    MOVE MP-ORIG-PIX-ID TO PX-ID OF BK-PX-REC
    MOVE "GET" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC NOT = "00"
        MOVE "20" TO MP-RC
        MOVE "ORIGINAL PIX NOT FOUND" TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM COPY-ORIG-FROM
    PERFORM CHECK-ORIG-ELIGIBLE
    PERFORM CHECK-CLAIM.

COPY-ORIG-FROM.
    MOVE PX-ID OF BK-PX-REC TO WS-ORIG-ID
    MOVE PX-DIRECTION OF BK-PX-REC TO WS-ORIG-DIR
    MOVE PX-STATUS OF BK-PX-REC TO WS-ORIG-STATUS
    MOVE PX-DEV-STATUS OF BK-PX-REC TO WS-ORIG-DEV-STATUS
    MOVE PX-AMOUNT OF BK-PX-REC TO WS-ORIG-AMOUNT
    MOVE PX-BLOCK-AMT OF BK-PX-REC TO WS-ORIG-BLOCK-AMT
    MOVE PX-CURRENCY OF BK-PX-REC TO WS-ORIG-CURRENCY
    MOVE PX-TXN-ID OF BK-PX-REC TO WS-ORIG-TXN-ID
    MOVE PX-JRN-ID OF BK-PX-REC TO WS-ORIG-JRN-ID
    MOVE PX-E2E-ID OF BK-PX-REC TO WS-ORIG-E2E
    MOVE PX-PAYER-ACCT OF BK-PX-REC TO WS-ORIG-PAYER-ACCT
    MOVE PX-PAYER-CUST OF BK-PX-REC TO WS-ORIG-PAYER-CUST
    MOVE PX-PAYER-PART OF BK-PX-REC TO WS-ORIG-PAYER-PART
    MOVE PX-PAYEE-ACCT OF BK-PX-REC TO WS-ORIG-PAYEE-ACCT
    MOVE PX-PAYEE-CUST OF BK-PX-REC TO WS-ORIG-PAYEE-CUST
    MOVE PX-PAYEE-PART OF BK-PX-REC TO WS-ORIG-PAYEE-PART
    MOVE PX-MED-CASE OF BK-PX-REC TO WS-ORIG-MED-CASE
    MOVE PX-MED-STATUS OF BK-PX-REC TO WS-ORIG-MED-STATUS.

CHECK-ORIG-ELIGIBLE.
    IF WS-ORIG-STATUS NOT = "POSTED" AND
       WS-ORIG-STATUS NOT = "SETTLED" AND
       WS-ORIG-STATUS NOT = "RECONCILED" AND
       WS-ORIG-STATUS NOT = "DEVOLVED"
        MOVE "20" TO MP-RC
        MOVE "PIX NOT ELIGIBLE FOR MED" TO MP-MSG
        EXIT PARAGRAPH
    END-IF.

CHECK-CLAIM.
    COMPUTE WS-REMAIN-ORIG = WS-ORIG-AMOUNT - WS-ORIG-BLOCK-AMT
    IF WS-REMAIN-ORIG <= 0
        MOVE "20" TO MP-RC
        MOVE "PIX FULLY DEVOLVED" TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    IF MP-CLAIMED-AMT <= 0
        MOVE WS-ORIG-AMOUNT TO MP-CLAIMED-AMT
    END-IF
    IF MP-CLAIMED-AMT > WS-ORIG-AMOUNT
        MOVE "20" TO MP-RC
        MOVE "CLAIMED ABOVE ORIGINAL AMOUNT" TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    IF MP-CURRENCY = SPACES
        MOVE WS-ORIG-CURRENCY TO MP-CURRENCY
    END-IF
    IF MP-CURRENCY NOT = WS-ORIG-CURRENCY
        MOVE "20" TO MP-RC
        MOVE "CLAIM CURRENCY MISMATCH" TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    IF MP-REASON = SPACES
        MOVE "20" TO MP-RC
        MOVE "MED REASON REQUIRED" TO MP-MSG
        EXIT PARAGRAPH
    END-IF.

COMPUTE-REMAIN.
    COMPUTE WS-REMAIN-ORIG = WS-ORIG-AMOUNT - WS-ORIG-BLOCK-AMT.

STORE-CASE-NEW.
    MOVE SPACES TO BK-MC-STO-REQ
    MOVE "WRITE" TO MC-SO-OP
    CALL "BPXMSTO" USING BK-MC-STO-REQ BK-PX-MC-REC
    IF MC-SO-RC = "22"
        MOVE "22" TO MP-RC
        MOVE "MED CASE DUPLICATE" TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    IF MC-SO-RC NOT = "00"
        MOVE MC-SO-RC TO MP-RC
        MOVE "MED CASE STORE ERROR" TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    IF MP-REQ-ID NOT = SPACES
        MOVE SPACES TO BK-MC-STO-REQ
        MOVE "WRITE-REQ" TO MC-SO-OP
        MOVE MP-REQ-ID TO MC-SO-REQ-ID
        MOVE WS-CASE-ID TO MC-SO-CASE-ID
        CALL "BPXMSTO" USING BK-MC-STO-REQ BK-PX-MC-REC
        IF MC-SO-RC = "22"
            MOVE "22" TO MP-RC
            MOVE "MED REQUEST ALREADY OPENED" TO MP-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    MOVE SPACES TO BK-MC-STO-REQ
    MOVE "WRITE-PIX" TO MC-SO-OP
    MOVE MP-ORIG-PIX-ID TO MC-SO-PIXID
    MOVE MP-REASON TO MC-SO-PREASON
    MOVE WS-CASE-ID TO MC-SO-CASE-ID
    CALL "BPXMSTO" USING BK-MC-STO-REQ BK-PX-MC-REC
    MOVE "00" TO MP-RC.

LINK-ORIGINAL.
    MOVE WS-CASE-ID TO PX-MED-CASE OF BK-PX-REC
    MOVE "OPEN" TO PX-MED-STATUS OF BK-PX-REC
    PERFORM TOUCH-ORIGINAL
    MOVE "REWRITE" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC NOT = "00"
        MOVE XS-RC TO MP-RC
        MOVE "MED LINK ORIGINAL ERROR" TO MP-MSG
    END-IF.

TOUCH-ORIGINAL.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO PX-UPDATED OF BK-PX-REC
    ADD 1 TO PX-VERSION OF BK-PX-REC.

COMPUTE-DEADLINE.
    MOVE 0 TO WS-DEADLINE
    IF PC-MED-DAYS = 0
        MOVE 0 TO MC-DEADLINE OF BK-PX-MC-REC
        EXIT PARAGRAPH
    END-IF
    MOVE "ADD-DAYS" TO DAT-OP
    MOVE WS-BIZDATE TO DAT-DATE
    MOVE PC-MED-DAYS TO DAT-DAYS
    CALL "BDAT" USING BK-DAT-PARMS
    IF DAT-RC = "00"
        MOVE DAT-RESULT TO WS-DEADLINE
    ELSE
        MOVE WS-BIZDATE TO WS-DEADLINE
    END-IF
    MOVE WS-DEADLINE TO MC-DEADLINE OF BK-PX-MC-REC.

DO-VALIDATE.
    PERFORM OPEN-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CASE
    IF MP-RC = "00"
        PERFORM RELOAD-ORIGINAL
        PERFORM COMPUTE-REMAIN
        PERFORM ENSURE-ANALYSIS
        PERFORM RUN-ELIGIBILITY
    END-IF
    IF MP-RC = "00"
        PERFORM TOUCH-CASE
        PERFORM STORE-CASE
        PERFORM EMIT-CASE
    END-IF
    PERFORM CLOSE-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM EXPOSE-CASE.

ENSURE-ANALYSIS.
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    IF WS-CASE-STATUS = "OPEN"
        MOVE "ANALYZE" TO WS-EVT
        CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT WS-STM-RC
            WS-STM-MSG
        IF WS-STM-RC NOT = "00"
            MOVE WS-STM-RC TO MP-RC
            MOVE WS-STM-MSG TO MP-MSG
            EXIT PARAGRAPH
        END-IF
        MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
        MOVE WS-NXT TO WS-CASE-STATUS
    END-IF
    IF WS-CASE-STATUS NOT = "IN-ANALYSIS"
        MOVE "20" TO MP-RC
        STRING "MED CASE NOT ANALYSABLE FROM " DELIMITED SIZE
            WS-CASE-STATUS DELIMITED SIZE INTO MP-MSG
        END-STRING
    END-IF.

RUN-ELIGIBILITY.
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    MOVE "INELIGIBLE" TO WS-REJ
    EVALUATE TRUE
        WHEN MC-FRAUD-FLAG OF BK-PX-MC-REC NOT = "Y"
            MOVE "NO FRAUD INDICATION" TO WS-REJ
        WHEN WS-REMAIN-ORIG <= 0
            MOVE "PIX FULLY DEVOLVED" TO WS-REJ
        WHEN MC-CURRENCY OF BK-PX-MC-REC NOT = WS-ORIG-CURRENCY
            MOVE "CURRENCY MISMATCH" TO WS-REJ
        WHEN OTHER
            MOVE "ELIGIBLE" TO WS-REJ
    END-EVALUATE
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    IF WS-REJ = "ELIGIBLE"
        MOVE "ELIGIBLE" TO WS-EVT
    ELSE
        MOVE "INELIGIBLE" TO WS-EVT
    END-IF
    CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC NOT = "00"
        MOVE WS-STM-RC TO MP-RC
        MOVE WS-STM-MSG TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
    IF WS-REJ = "ELIGIBLE"
        MOVE WS-REMAIN-ORIG TO MC-ELIGIBLE-AMT OF BK-PX-MC-REC
        MOVE "MED CASE ELIGIBLE" TO MP-MSG
    ELSE
        MOVE WS-REJ TO MC-DEC-REASON OF BK-PX-MC-REC
        STRING "MED CASE INELIGIBLE: " DELIMITED SIZE
            WS-REJ DELIMITED SIZE INTO MP-MSG
        END-STRING
    END-IF.

DO-BLOCK.
    PERFORM OPEN-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CASE
    IF MP-RC = "00"
        PERFORM RELOAD-ORIGINAL
        PERFORM BLOCK-PREPARE
    END-IF
    IF MP-RC = "00" AND WS-BLOCK-SKIP NOT = "Y"
        PERFORM BLOCK-FUNDS
    END-IF
    PERFORM CLOSE-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    IF MP-RC = "00"
        PERFORM TOUCH-CASE
        PERFORM STORE-CASE
        PERFORM EMIT-CASE
    END-IF
    IF MP-RC NOT = "00"
        PERFORM CLOSE-CASE-LOCK
        GOBACK
    END-IF
    PERFORM EXPOSE-CASE.

BLOCK-PREPARE.
    MOVE "N" TO WS-BLOCK-SKIP
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    EVALUATE WS-CASE-STATUS
        WHEN "BLOCKED"
        WHEN "DEVOL-PEND"
        WHEN "DEVOLVED"
        WHEN "PART-DEVOLV"
        WHEN "DEVOLV-UNK"
            MOVE "MED CASE ALREADY BLOCKED" TO MP-MSG
            MOVE "Y" TO WS-BLOCK-SKIP
        WHEN "BLOCK-PEND"
            CONTINUE
        WHEN OTHER
            PERFORM COMPUTE-REMAIN
            PERFORM ENSURE-ANALYSIS
            IF MP-RC = "00"
                PERFORM RUN-ELIGIBILITY
            END-IF
    END-EVALUATE.

BLOCK-COMMIT.
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    MOVE "BLOCKED" TO WS-EVT
    CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC = "00"
        MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
    ELSE
        MOVE WS-STM-RC TO MP-RC
        MOVE WS-STM-MSG TO MP-MSG
    END-IF.

BLOCK-FUNDS.
    MOVE 0 TO WS-SPLIT-LEG-REMAIN
    PERFORM DETERMINE-BLOCK-TARGET
    COMPUTE WS-REMAIN-ORIG = WS-ORIG-AMOUNT - WS-ORIG-BLOCK-AMT
    MOVE 0 TO WS-AVAILABLE
    IF WS-BLOCK-TARGET NOT = SPACES
        CALL "BGLBAL" USING WS-BLOCK-TARGET WS-BAL-OUT
        IF BO-RC = "00"
            MOVE BO-AVAILABLE TO WS-AVAILABLE
        END-IF
    END-IF
    MOVE WS-AVAILABLE TO MC-AVAILABLE OF BK-PX-MC-REC
    MOVE MC-CLAIMED-AMT OF BK-PX-MC-REC TO WS-CASE-AMT
    IF WS-CASE-AMT > WS-REMAIN-ORIG
        MOVE WS-REMAIN-ORIG TO WS-CASE-AMT
    END-IF
    IF WS-SPLIT-LEG-REMAIN > 0 AND
       WS-CASE-AMT > WS-SPLIT-LEG-REMAIN
        MOVE WS-SPLIT-LEG-REMAIN TO WS-CASE-AMT
    END-IF
    IF WS-BLOCK-TARGET = SPACES
        MOVE WS-CASE-AMT TO MC-ELIGIBLE-AMT OF BK-PX-MC-REC
        MOVE 0 TO MC-BLOCKED-AMT OF BK-PX-MC-REC
        MOVE "MED NOTHING TO BLOCK" TO WS-BLOCK-MSG
        PERFORM MARK-BLOCKED
        EXIT PARAGRAPH
    END-IF
    IF WS-CASE-AMT <= WS-AVAILABLE
        MOVE WS-CASE-AMT TO MC-ELIGIBLE-AMT OF BK-PX-MC-REC
    ELSE
        MOVE WS-AVAILABLE TO MC-ELIGIBLE-AMT OF BK-PX-MC-REC
    END-IF
    COMPUTE MC-REMAIN-AMT OF BK-PX-MC-REC =
        WS-CASE-AMT - MC-ELIGIBLE-AMT OF BK-PX-MC-REC
    IF MC-ELIGIBLE-AMT OF BK-PX-MC-REC <= 0
        MOVE 0 TO MC-BLOCKED-AMT OF BK-PX-MC-REC
        MOVE "MED NO FUNDS TO BLOCK" TO WS-BLOCK-MSG
        PERFORM MARK-BLOCKED
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-MH-PARMS
    MOVE "HOLD-CREATE" TO HL-OP
    MOVE WS-BLOCK-TARGET TO HL-ACCT
    MOVE MC-CURRENCY OF BK-PX-MC-REC TO HL-CURRENCY
    MOVE MC-ELIGIBLE-AMT OF BK-PX-MC-REC TO HL-AMOUNT
    MOVE MC-ORIG-PIX-ID OF BK-PX-MC-REC TO HL-ORIG-PIX-ID
    MOVE MC-CASE-ID OF BK-PX-MC-REC TO HL-MED-CASE-ID
    MOVE MC-OPERATOR OF BK-PX-MC-REC TO HL-OPERATOR
    CALL "BPXMHLD" USING BK-MH-PARMS
    MOVE HL-RC TO WS-HLD-RC
    IF WS-HLD-RC = "00"
        MOVE HL-HOLD-ID TO MC-HOLD-ID OF BK-PX-MC-REC
        MOVE HL-AMOUNT TO MC-BLOCKED-AMT OF BK-PX-MC-REC
        MOVE "MED HOLD CREATED" TO WS-BLOCK-MSG
        PERFORM MARK-BLOCKED
    ELSE
        MOVE WS-HLD-RC TO MP-RC
        MOVE HL-MSG TO MP-MSG
    END-IF.

MARK-BLOCKED.
    MOVE "BLOCKED" TO WS-EVT
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC = "00"
        MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
        MOVE WS-BLOCK-MSG TO MP-MSG
    ELSE
        MOVE WS-STM-RC TO MP-RC
        MOVE WS-STM-MSG TO MP-MSG
    END-IF.

DO-DECIDE.
    PERFORM OPEN-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CASE
    IF MP-RC = "00"
        PERFORM RELOAD-ORIGINAL
        PERFORM COMPUTE-REMAIN
        PERFORM DECIDE-APPLY
    END-IF
    IF MP-RC = "00"
        PERFORM TOUCH-CASE
        PERFORM STORE-CASE
        PERFORM EMIT-CASE
    END-IF
    PERFORM CLOSE-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM EXPOSE-CASE.

DECIDE-TRANSITION.
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    MOVE "DECIDE" TO WS-EVT
    CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC = "00"
        MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
    END-IF.

DECIDE-APPLY.
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    MOVE 0 TO WS-DEC-AMT
    EVALUATE FUNCTION TRIM(MP-DECISION)
        WHEN "APPROVE"
            MOVE MC-ELIGIBLE-AMT OF BK-PX-MC-REC TO WS-DEC-AMT
            MOVE "APPROVE" TO WS-EVT
        WHEN "PARTIAL"
            MOVE MP-DECISION-AMT TO WS-DEC-AMT
            MOVE "PARTIAL" TO WS-EVT
        WHEN "REJECT"
            MOVE 0 TO WS-DEC-AMT
            MOVE "REJECT" TO WS-EVT
        WHEN OTHER
            MOVE "20" TO MP-RC
            MOVE "MED DECISION REQUIRED" TO MP-MSG
            EXIT PARAGRAPH
    END-EVALUATE
    IF MP-RC = "00" AND MP-DECISION NOT = "REJECT"
        IF WS-DEC-AMT <= 0
            MOVE "20" TO MP-RC
            MOVE "DECISION AMOUNT REQUIRED" TO MP-MSG
            EXIT PARAGRAPH
        END-IF
        IF WS-DEC-AMT > MC-ELIGIBLE-AMT OF BK-PX-MC-REC
            MOVE "20" TO MP-RC
            MOVE "DECISION ABOVE ELIGIBLE AMOUNT" TO MP-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    IF MP-RC = "00"
        CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT WS-STM-RC
            WS-STM-MSG
        IF WS-STM-RC NOT = "00"
            MOVE WS-STM-RC TO MP-RC
            MOVE WS-STM-MSG TO MP-MSG
            EXIT PARAGRAPH
        END-IF
        MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
        MOVE MP-DECISION TO MC-DECISION OF BK-PX-MC-REC
        MOVE WS-DEC-AMT TO MC-DECISION-AMT OF BK-PX-MC-REC
        MOVE MP-DEC-REASON TO MC-DEC-REASON OF BK-PX-MC-REC
        MOVE MP-OPERATOR TO MC-DEC-BY OF BK-PX-MC-REC
        MOVE WS-BIZDATE TO MC-DEC-DATE OF BK-PX-MC-REC
        MOVE "MED DECISION RECORDED" TO MP-MSG
    END-IF.

DO-EXECUTE.
    PERFORM OPEN-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CASE
    IF MP-RC = "00"
        PERFORM RELOAD-ORIGINAL
        PERFORM EXECUTE-OR-RECOVER
    END-IF
    IF MP-RC = "00" OR MP-RC = "24"
        PERFORM TOUCH-CASE
        PERFORM STORE-CASE
        PERFORM EMIT-CASE
    END-IF
    PERFORM CLOSE-CASE-LOCK
    IF MP-RC = "00" OR MP-RC = "24"
        PERFORM EXPOSE-CASE
    END-IF.

EXECUTE-OR-RECOVER.
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    EVALUATE TRUE
        WHEN WS-CASE-STATUS = "DEVOLVED"
            MOVE "MED CASE ALREADY DEVOLVED" TO MP-MSG
            MOVE "Y" TO MP-REPLAY
        WHEN WS-CASE-STATUS = "PART-DEVOLV"
            MOVE "MED CASE ALREADY PART DEVOLVED" TO MP-MSG
            MOVE "Y" TO MP-REPLAY
        WHEN WS-CASE-STATUS = "APPROVED" OR
             WS-CASE-STATUS = "PART-APPROV"
            PERFORM START-DEVOLUTION
        WHEN WS-CASE-STATUS = "DEVOLV-UNK"
            PERFORM RECOVER-DEVOLUTION
        WHEN WS-CASE-STATUS = "DEVOL-PEND"
            IF MC-DEVOL-PIX-ID OF BK-PX-MC-REC NOT = SPACES
                PERFORM RECOVER-DEVOLUTION
            ELSE
                PERFORM RUN-DEVOLUTION
            END-IF
        WHEN OTHER
            MOVE "20" TO MP-RC
            MOVE "MED CASE NOT READY TO EXECUTE" TO MP-MSG
    END-EVALUATE.

START-DEVOLUTION.
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    MOVE "DEVOLVE" TO WS-EVT
    CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC NOT = "00"
        MOVE WS-STM-RC TO MP-RC
        MOVE WS-STM-MSG TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
    PERFORM TOUCH-CASE
    PERFORM STORE-CASE
    PERFORM CONSUME-HOLD
    IF MP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM RUN-DEVOLUTION.

RECOVER-DEVOLUTION.
    MOVE SPACES TO BK-PX-PARMS
    MOVE 0 TO XP-AMOUNT XP-FEE-AMT XP-BLOCK-AMT XP-DATE XP-COUNT
    MOVE "PIX-RETRY" TO XP-OP
    MOVE MC-DEVOL-PIX-ID OF BK-PX-MC-REC TO XP-PIX-ID
    IF MP-SIM NOT = SPACES
        MOVE MP-SIM TO XP-SIM
    END-IF
    CALL "BPXPR" USING BK-PX-PARMS
    MOVE "PIX-GET" TO XP-OP
    CALL "BPXPR" USING BK-PX-PARMS
    MOVE XP-PIX-ID TO WS-DEVOL-ID
    IF XP-POST-STATUS = "POSTED"
        PERFORM FINALIZE-DEVOL
        IF MP-RC = "00"
            PERFORM APPLY-DEVOL-SUCCESS
        END-IF
    ELSE
        MOVE "24" TO MP-RC
        MOVE "MED DEVOLUTION STILL PENDING" TO MP-MSG
    END-IF.

FINALIZE-DEVOL.
    MOVE SPACES TO BK-PX-PARMS
    MOVE 0 TO XP-AMOUNT XP-FEE-AMT XP-BLOCK-AMT XP-DATE XP-COUNT
    MOVE "PIX-DEVOL-FINALIZE" TO XP-OP
    MOVE MC-ORIG-PIX-ID OF BK-PX-MC-REC TO XP-ORIG-PIX-ID
    MOVE MC-DEVOL-PIX-ID OF BK-PX-MC-REC TO XP-DEV-PIX-ID
    MOVE "PROD" TO XP-ENV
    MOVE MC-OPERATOR OF BK-PX-MC-REC TO XP-OPERATOR
    MOVE MC-CORR OF BK-PX-MC-REC TO XP-CORR
    CALL "BPXDEV" USING BK-PX-PARMS
    IF XP-RC NOT = "00"
        MOVE XP-RC TO MP-RC
        MOVE XP-MSG TO MP-MSG
    END-IF.

RUN-DEVOLUTION.
    MOVE SPACES TO BK-PX-STO-REQ
    MOVE SPACES TO BK-PX-REC
    MOVE MC-ORIG-PIX-ID OF BK-PX-MC-REC TO PX-ID OF BK-PX-REC
    MOVE "GET" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    MOVE SPACES TO BK-PX-PARMS
    MOVE 0 TO XP-AMOUNT XP-FEE-AMT XP-BLOCK-AMT XP-DATE XP-COUNT
    MOVE "PIX-DEVOL-REQUEST" TO XP-OP
    IF XS-RC = "00" AND PX-SPLIT-FLAG OF BK-PX-REC = "Y"
        MOVE "Y" TO XP-SPLIT
    END-IF
    MOVE MC-ORIG-PIX-ID OF BK-PX-MC-REC TO XP-ORIG-PIX-ID
    MOVE MC-DECISION-AMT OF BK-PX-MC-REC TO XP-AMOUNT
    MOVE MC-CURRENCY OF BK-PX-MC-REC TO XP-CURRENCY
    MOVE "PROD" TO XP-ENV
    IF MP-SIM NOT = SPACES
        MOVE MP-SIM TO XP-SIM
    END-IF
    MOVE MC-CASE-ID OF BK-PX-MC-REC TO XP-MED-CASE
    MOVE "MED DEVOLUCAO" TO XP-REASON
    MOVE MC-OPERATOR OF BK-PX-MC-REC TO XP-OPERATOR
    MOVE MC-CORR OF BK-PX-MC-REC TO XP-CORR
    MOVE MC-CASE-ID OF BK-PX-MC-REC TO XP-REQUEST
    CALL "BPXDEV" USING BK-PX-PARMS
    MOVE XP-RC TO WS-DEV-RC
    MOVE XP-DEV-PIX-ID TO WS-DEVOL-ID
    EVALUATE TRUE
        WHEN XP-RC = "00" AND XP-POST-STATUS = "POSTED"
            PERFORM APPLY-DEVOL-SUCCESS
        WHEN XP-RC = "24" OR XP-STATUS = "TIMEOUT"
            MOVE WS-DEVOL-ID TO MC-DEVOL-PIX-ID OF BK-PX-MC-REC
            MOVE "UNK" TO WS-EVT
            MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
            CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT
                WS-STM-RC WS-STM-MSG
            IF WS-STM-RC = "00"
                MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
            END-IF
            MOVE "24" TO MP-RC
            MOVE "MED DEVOLUTION OUTCOME UNKNOWN" TO MP-MSG
        WHEN OTHER
            MOVE WS-DEV-RC TO MP-RC
            MOVE XP-MSG TO MP-MSG
    END-EVALUATE.

APPLY-DEVOL-SUCCESS.
    MOVE XP-AMOUNT TO WS-RETURNED
    MOVE WS-DEVOL-ID TO MC-DEVOL-PIX-ID OF BK-PX-MC-REC
    MOVE XP-TXN-ID TO MC-DEVOL-TXN-ID OF BK-PX-MC-REC
    MOVE XP-JRN-ID TO MC-DEVOL-JRN-ID OF BK-PX-MC-REC
    MOVE XP-EXT-REF TO MC-STL-REF OF BK-PX-MC-REC
    ADD WS-RETURNED TO MC-RETURNED-AMT OF BK-PX-MC-REC
    COMPUTE MC-REMAIN-AMT OF BK-PX-MC-REC =
        MC-ORIG-AMOUNT OF BK-PX-MC-REC
        - (WS-ORIG-BLOCK-AMT + WS-RETURNED)
    IF MC-REMAIN-AMT OF BK-PX-MC-REC < 0
        MOVE 0 TO MC-REMAIN-AMT OF BK-PX-MC-REC
    END-IF
    MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
    IF WS-CASE-STATUS = "DEVOLV-UNK"
        IF MC-RETURNED-AMT OF BK-PX-MC-REC >=
           MC-DECISION-AMT OF BK-PX-MC-REC
            MOVE "RESOLVE-DEV" TO WS-EVT
        ELSE
            MOVE "RESOLVE-PART" TO WS-EVT
        END-IF
    ELSE
        IF MC-RETURNED-AMT OF BK-PX-MC-REC >=
           MC-DECISION-AMT OF BK-PX-MC-REC
            MOVE "SUCCEED" TO WS-EVT
        ELSE
            MOVE "PARTDEVOL" TO WS-EVT
        END-IF
    END-IF
    CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC = "00"
        MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
    ELSE
        MOVE WS-STM-RC TO MP-RC
        MOVE WS-STM-MSG TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "00" TO MP-RC
    MOVE "MED DEVOLUTION EXECUTED" TO MP-MSG.

CONSUME-HOLD.
    IF MC-HOLD-ID OF BK-PX-MC-REC = SPACES
        MOVE 0 TO MC-BLOCKED-AMT OF BK-PX-MC-REC
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-MH-PARMS
    MOVE "HOLD-CONSUME" TO HL-OP
    MOVE MC-HOLD-ID OF BK-PX-MC-REC TO HL-HOLD-ID
    CALL "BPXMHLD" USING BK-MH-PARMS
    IF HL-RC = "00"
        MOVE 0 TO MC-BLOCKED-AMT OF BK-PX-MC-REC
    ELSE
        MOVE HL-RC TO MP-RC
        MOVE HL-MSG TO MP-MSG
    END-IF.

DO-RELEASE.
    PERFORM OPEN-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CASE
    IF MP-RC = "00"
        PERFORM RELEASE-HOLD
    END-IF
    IF MP-RC = "00"
        PERFORM TOUCH-CASE
        PERFORM STORE-CASE
        PERFORM EMIT-CASE
    END-IF
    PERFORM CLOSE-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM EXPOSE-CASE.

RELEASE-HOLD.
    IF MC-HOLD-ID OF BK-PX-MC-REC = SPACES
        MOVE 0 TO MC-BLOCKED-AMT OF BK-PX-MC-REC
        MOVE "MED NOTHING TO RELEASE" TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-MH-PARMS
    MOVE "HOLD-RELEASE" TO HL-OP
    MOVE MC-HOLD-ID OF BK-PX-MC-REC TO HL-HOLD-ID
    CALL "BPXMHLD" USING BK-MH-PARMS
    IF HL-RC = "00"
        MOVE 0 TO MC-BLOCKED-AMT OF BK-PX-MC-REC
        MOVE SPACES TO MC-HOLD-ID OF BK-PX-MC-REC
        MOVE "MED HOLD RELEASED" TO MP-MSG
    ELSE
        MOVE HL-RC TO MP-RC
        MOVE HL-MSG TO MP-MSG
    END-IF.

DO-CLOSE.
    PERFORM OPEN-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CASE
    IF MP-RC = "00"
        PERFORM LINK-ORIGINAL-CLOSE
        MOVE "CLOSE" TO WS-EVT
        MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
        CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT WS-STM-RC
            WS-STM-MSG
        IF WS-STM-RC NOT = "00"
            MOVE WS-STM-RC TO MP-RC
            MOVE WS-STM-MSG TO MP-MSG
        ELSE
            MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
            PERFORM TOUCH-CASE
            PERFORM STORE-CASE
            PERFORM EMIT-CASE
            MOVE "MED CASE CLOSED" TO MP-MSG
        END-IF
    END-IF
    PERFORM CLOSE-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM EXPOSE-CASE.

LINK-ORIGINAL-CLOSE.
    PERFORM RELOAD-ORIGINAL
    IF MP-RC = "00"
        MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
        IF WS-CASE-STATUS = "DEVOLVED" OR
           WS-CASE-STATUS = "PART-DEVOLV"
            MOVE "RESOLVED" TO PX-MED-STATUS OF BK-PX-REC
        ELSE
            MOVE "CLOSED" TO PX-MED-STATUS OF BK-PX-REC
        END-IF
        MOVE MP-REQ-CASE-ID TO PX-MED-CASE OF BK-PX-REC
        PERFORM TOUCH-ORIGINAL
        MOVE "REWRITE" TO XS-OP
        CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
        IF XS-RC NOT = "00"
            MOVE XS-RC TO MP-RC
            MOVE "MED CLOSE LINK ERROR" TO MP-MSG
        END-IF
    END-IF.

DO-EXPIRE.
    PERFORM OPEN-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CASE
    IF MP-RC = "00"
        IF MC-DEADLINE OF BK-PX-MC-REC = 0 OR
           WS-BIZDATE < MC-DEADLINE OF BK-PX-MC-REC
            MOVE "MED CASE NOT EXPIRED" TO MP-MSG
        ELSE
            MOVE "EXPIRE" TO WS-EVT
            MOVE MC-STATUS OF BK-PX-MC-REC TO WS-CASE-STATUS
            CALL "BPXMEM" USING WS-CASE-STATUS WS-EVT WS-NXT
                WS-STM-RC WS-STM-MSG
            IF WS-STM-RC = "00"
                MOVE WS-NXT TO MC-STATUS OF BK-PX-MC-REC
                IF MC-HOLD-ID OF BK-PX-MC-REC NOT = SPACES
                    PERFORM RELEASE-HOLD
                END-IF
                PERFORM TOUCH-CASE
                PERFORM STORE-CASE
                PERFORM EMIT-CASE
                MOVE "MED CASE EXPIRED" TO MP-MSG
            ELSE
                MOVE WS-STM-RC TO MP-RC
                MOVE WS-STM-MSG TO MP-MSG
            END-IF
        END-IF
    END-IF
    PERFORM CLOSE-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM EXPOSE-CASE.

DO-GET.
    PERFORM LOAD-CASE
    IF MP-RC = "00"
        MOVE "MED CASE" TO MP-MSG
    END-IF
    PERFORM EXPOSE-CASE.

DO-SET-RECON.
    PERFORM OPEN-CASE-LOCK
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CASE
    IF MP-RC = "00"
        MOVE MP-RECON-STATUS TO MC-RECON-STATUS OF BK-PX-MC-REC
        PERFORM TOUCH-CASE
        PERFORM STORE-CASE
        PERFORM EMIT-CASE
        MOVE "MED RECON STATUS SET" TO MP-MSG
    END-IF
    PERFORM CLOSE-CASE-LOCK
    IF MP-RC = "00"
        PERFORM EXPOSE-CASE
    END-IF.

DO-LIST.
    PERFORM OPEN-SCAN
    IF MP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    MOVE 0 TO MP-COUNT
    PERFORM UNTIL WS-EOF = "Y"
        READ SCAN-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM SHOW-ONE-CASE
        END-READ
    END-PERFORM
    CLOSE SCAN-FILE
    MOVE "MED CASES" TO MP-MSG.

SHOW-ONE-CASE.
    IF MP-STATUS NOT = SPACES AND
       MP-STATUS NOT = MC-STATUS OF SCAN-REC
        EXIT PARAGRAPH
    END-IF
    IF MP-ORIG-PIX-ID NOT = SPACES AND
       MP-ORIG-PIX-ID NOT = MC-ORIG-PIX-ID OF SCAN-REC
        EXIT PARAGRAPH
    END-IF
    IF MP-CLAIMANT NOT = SPACES AND
       MP-CLAIMANT NOT = MC-CLAIMANT OF SCAN-REC
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO MP-COUNT
    MOVE MC-CLAIMED-AMT OF SCAN-REC TO WS-AMT-ED
    DISPLAY "medcase=" FUNCTION TRIM(MC-CASE-ID OF SCAN-REC)
    DISPLAY "pix=" FUNCTION TRIM(MC-ORIG-PIX-ID OF SCAN-REC)
    DISPLAY "status=" FUNCTION TRIM(MC-STATUS OF SCAN-REC)
    DISPLAY "decision=" FUNCTION TRIM(MC-DECISION OF SCAN-REC)
    DISPLAY "recon=" FUNCTION TRIM(MC-RECON-STATUS OF SCAN-REC)
    DISPLAY "claimed=" WS-AMT-ED
    MOVE MC-RETURNED-AMT OF SCAN-REC TO WS-AMT-ED
    DISPLAY "returned=" WS-AMT-ED
    DISPLAY "devol=" FUNCTION TRIM(MC-DEVOL-PIX-ID OF SCAN-REC).

RELOAD-ORIGINAL.
    MOVE SPACES TO BK-PX-REC
    MOVE MC-ORIG-PIX-ID OF BK-PX-MC-REC TO PX-ID OF BK-PX-REC
    MOVE "GET" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC NOT = "00"
        MOVE XS-RC TO MP-RC
        MOVE "ORIGINAL PIX NOT FOUND" TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM COPY-ORIG-FROM.

LOAD-CASE.
    IF MP-REQ-CASE-ID NOT = SPACES
        MOVE MP-REQ-CASE-ID TO WS-CASE-ID
    END-IF
    IF WS-CASE-ID = SPACES
        MOVE "20" TO MP-RC
        MOVE "MED CASE ID REQUIRED" TO MP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-MC-REC
    MOVE SPACES TO BK-MC-STO-REQ
    MOVE "GET" TO MC-SO-OP
    MOVE WS-CASE-ID TO MC-SO-CASE-ID
    CALL "BPXMSTO" USING BK-MC-STO-REQ BK-PX-MC-REC
    IF MC-SO-RC NOT = "00"
        MOVE MC-SO-RC TO MP-RC
        MOVE MC-SO-MSG TO MP-MSG
    END-IF.

TOUCH-CASE.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO MC-UPDATED OF BK-PX-MC-REC
    ADD 1 TO MC-VERSION OF BK-PX-MC-REC
    PERFORM COMPUTE-HASH.

STORE-CASE.
    MOVE SPACES TO BK-MC-STO-REQ
    MOVE "REWRITE" TO MC-SO-OP
    CALL "BPXMSTO" USING BK-MC-STO-REQ BK-PX-MC-REC
    IF MC-SO-RC NOT = "00"
        MOVE MC-SO-RC TO MP-RC
        MOVE "MED CASE STORE ERROR" TO MP-MSG
    END-IF.

COMPUTE-HASH.
    MOVE MC-CLAIMED-AMT OF BK-PX-MC-REC TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(MC-CASE-ID OF BK-PX-MC-REC) DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(MC-ORIG-PIX-ID
        OF BK-PX-MC-REC) DELIMITED SIZE "|" DELIMITED SIZE WS-AMT-ED
        DELIMITED SIZE "|" DELIMITED SIZE MC-STATUS OF BK-PX-MC-REC
        DELIMITED SIZE INTO WS-HASH-BUF
    END-STRING
    MOVE 600 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO MC-HASH OF BK-PX-MC-REC.

EXPOSE-CASE.
    MOVE MC-CASE-ID OF BK-PX-MC-REC TO MP-REQ-CASE-ID
    MOVE MC-ORIG-PIX-ID OF BK-PX-MC-REC TO MP-ORIG-PIX-ID
    MOVE MC-E2E-ID OF BK-PX-MC-REC TO MP-E2E-ID
    MOVE MC-STATUS OF BK-PX-MC-REC TO MP-CASE-STATUS
    MOVE MC-DECISION OF BK-PX-MC-REC TO MP-DECISION
    MOVE MC-CLAIMANT OF BK-PX-MC-REC TO MP-CLAIMANT
    MOVE MC-RECON-STATUS OF BK-PX-MC-REC TO MP-RECON-STATUS
    MOVE MC-DEVOL-PIX-ID OF BK-PX-MC-REC TO MP-DEVOL-PIX-ID
    MOVE MC-DEVOL-TXN-ID OF BK-PX-MC-REC TO MP-DEVOL-TXN-ID
    MOVE MC-DEVOL-JRN-ID OF BK-PX-MC-REC TO MP-DEVOL-JRN-ID
    MOVE MC-STL-REF OF BK-PX-MC-REC TO MP-STL-REF
    MOVE MC-HOLD-ID OF BK-PX-MC-REC TO MP-HOLD-ID
    MOVE MC-DEADLINE OF BK-PX-MC-REC TO MP-DEADLINE
    MOVE MC-ORIG-AMOUNT OF BK-PX-MC-REC TO MP-ORIG-AMOUNT
    MOVE MC-CLAIMED-AMT OF BK-PX-MC-REC TO MP-CLAIMED-AMT
    MOVE MC-AVAILABLE OF BK-PX-MC-REC TO MP-AVAILABLE
    MOVE MC-BLOCKED-AMT OF BK-PX-MC-REC TO MP-BLOCKED-AMT
    MOVE MC-ELIGIBLE-AMT OF BK-PX-MC-REC TO MP-ELIGIBLE-AMT
    MOVE MC-DECISION-AMT OF BK-PX-MC-REC TO MP-DECISION-AMT
    MOVE MC-RETURNED-AMT OF BK-PX-MC-REC TO MP-RETURNED-AMT
    MOVE MC-REMAIN-AMT OF BK-PX-MC-REC TO MP-REMAIN-AMT
    MOVE MC-FRAUD-FLAG OF BK-PX-MC-REC TO MP-FRAUD-FLAG.

EMIT-CASE.
    MOVE MC-OPERATOR OF BK-PX-MC-REC TO BK-AUD-OPERATOR
    MOVE "PIX.MED" TO BK-AUD-ACTION
    MOVE MC-CASE-ID OF BK-PX-MC-REC TO BK-AUD-ENTITY
    MOVE MC-CORR OF BK-PX-MC-REC TO BK-AUD-CORR
    MOVE MC-ORIG-PIX-ID OF BK-PX-MC-REC TO BK-AUD-BEFORE
    MOVE MC-STATUS OF BK-PX-MC-REC TO BK-AUD-AFTER
    MOVE MP-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE "PIX.MED.v1" TO WS-EVT-TYPE
    MOVE MC-CASE-ID OF BK-PX-MC-REC TO BK-EVT-KEY
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(MC-CASE-ID OF BK-PX-MC-REC) DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(MC-STATUS OF BK-PX-MC-REC)
        DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(MC-DEVOL-PIX-ID OF BK-PX-MC-REC) DELIMITED SIZE
        INTO BK-EVT-PAYLOAD
    END-STRING
    CALL "BEVT" USING BK-EVT-PARMS.

DETERMINE-BLOCK-TARGET.
    MOVE SPACES TO WS-BLOCK-TARGET
    IF PX-SPLIT-FLAG OF BK-PX-REC = "Y"
        PERFORM DETERMINE-SPLIT-BLOCK-TARGET
        EXIT PARAGRAPH
    END-IF
    EVALUATE WS-ORIG-DIR
        WHEN "IN"
            IF WS-ORIG-PAYEE-PART = PC-SELF
                MOVE WS-ORIG-PAYEE-ACCT TO WS-BLOCK-TARGET
            END-IF
        WHEN "OUT"
            IF WS-ORIG-PAYEE-PART = PC-SELF AND
               WS-ORIG-PAYEE-ACCT NOT = SPACES
                MOVE WS-ORIG-PAYEE-ACCT TO WS-BLOCK-TARGET
            END-IF
        WHEN OTHER
            CONTINUE
    END-EVALUATE.

DETERMINE-SPLIT-BLOCK-TARGET.
    MOVE SPACES TO BK-PX-SPL-PARMS
    MOVE 0 TO WS-SPLIT-LEG-REMAIN
    MOVE "SPL-LIST" TO SP-OP
    MOVE MC-ORIG-PIX-ID OF BK-PX-MC-REC TO SP-PIX-ID
    CALL "BPXSLV" USING BK-PX-SPL-PARMS
    IF SP-RC = "00"
        PERFORM VARYING WS-SPI FROM 1 BY 1 UNTIL WS-SPI >
            SP-CNT
            IF SP-PS-REMAIN(WS-SPI) > 0 AND
               WS-BLOCK-TARGET = SPACES AND
               SP-PS-ROLE(WS-SPI) = "CUSTOMER"
                MOVE SP-PS-ID(WS-SPI) TO WS-BLOCK-TARGET
                MOVE SP-PS-REMAIN(WS-SPI) TO WS-SPLIT-LEG-REMAIN
            END-IF
        END-PERFORM
    END-IF.

OPEN-SCAN.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-SCAN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxmed.idx"
        DELIMITED SIZE INTO WS-SCAN-PATH
    OPEN INPUT SCAN-FILE
    IF WS-SCAN-ST = "35"
        OPEN OUTPUT SCAN-FILE
        CLOSE SCAN-FILE
        OPEN INPUT SCAN-FILE
    END-IF
    IF WS-SCAN-ST NOT = "00"
        MOVE WS-SCAN-ST TO MP-RC
        MOVE "MED STORE UNAVAILABLE" TO MP-MSG
    END-IF.
