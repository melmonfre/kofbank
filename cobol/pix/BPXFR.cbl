IDENTIFICATION DIVISION.
PROGRAM-ID. BPXFR.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT FR-FILE ASSIGN TO WS-FR-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PF-KEY OF FR-REC
        FILE STATUS IS WS-FR-ST.

DATA DIVISION.
FILE SECTION.
FD FR-FILE.
01 FR-REC.
   COPY "BPXF".

WORKING-STORAGE SECTION.
01 WS-FR-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-FR-ST PIC X(02).
01 WS-FOUND PIC X(01).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-NOW PIC X(14).
COPY "BKAUDP".
COPY "BKEVTP".

LINKAGE SECTION.
COPY "BPXFP".

PROCEDURE DIVISION USING BK-PX-FRD-PARMS.
    MOVE "00" TO FP-RC
    MOVE SPACES TO FP-MSG
    CALL "BCFG" USING WS-CFG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-FR-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxfraud.idx"
        DELIMITED SIZE INTO WS-FR-PATH
    OPEN I-O FR-FILE
    IF WS-FR-ST = "35"
        OPEN OUTPUT FR-FILE
        CLOSE FR-FILE
        OPEN I-O FR-FILE
    END-IF
    IF WS-FR-ST NOT = "00"
        MOVE WS-FR-ST TO FP-RC
        MOVE "FRAUD STORE OPEN ERROR" TO FP-MSG
        GOBACK
    END-IF
    PERFORM LOAD-OR-NEW
    IF FP-RC NOT = "00"
        CLOSE FR-FILE
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(FP-OP)
        WHEN "FRAUD-MARK" PERFORM DO-MARK
        WHEN "FRAUD-RELEASE" PERFORM DO-RELEASE
        WHEN "FRAUD-CHECK" PERFORM DO-CHECK
        WHEN "FRAUD-GET" PERFORM DO-GET
        WHEN "FRAUD-KEY-RESTRICTED" PERFORM DO-KEY-RESTRICTED
        WHEN OTHER
            MOVE "99" TO FP-RC
            MOVE "UNKNOWN FRAUD OP" TO FP-MSG
    END-EVALUATE
    CLOSE FR-FILE
    GOBACK.

BUILD-KEY.
    MOVE FP-TARGET-TYPE TO PF-TARGET-TYPE OF FR-REC
    MOVE "|" TO PF-SEP OF FR-REC
    MOVE FP-TARGET-KEY TO PF-TARGET-KEY OF FR-REC.

LOAD-OR-NEW.
    PERFORM BUILD-KEY
    MOVE "N" TO WS-FOUND
    READ FR-FILE
    EVALUATE WS-FR-ST
        WHEN "00" MOVE "Y" TO WS-FOUND
        WHEN "23" MOVE "N" TO WS-FOUND
        WHEN OTHER
            MOVE WS-FR-ST TO FP-RC
            MOVE "FRAUD STORE READ ERROR" TO FP-MSG
    END-EVALUATE.

DO-MARK.
    IF WS-FOUND = "N"
        MOVE "N" TO PF-FLAG-SEND OF FR-REC
        MOVE "N" TO PF-FLAG-RECV OF FR-REC
        MOVE "N" TO PF-FLAG-KEY OF FR-REC
        MOVE 1 TO PF-VERSION OF FR-REC
        MOVE WS-BIZDATE TO PF-BIZDATE OF FR-REC
    ELSE
        ADD 1 TO PF-VERSION OF FR-REC
    END-IF
    IF FP-FLAG-SEND = "Y" OR FP-FLAG-SEND = "N"
        MOVE FP-FLAG-SEND TO PF-FLAG-SEND OF FR-REC
    END-IF
    IF FP-FLAG-RECV = "Y" OR FP-FLAG-RECV = "N"
        MOVE FP-FLAG-RECV TO PF-FLAG-RECV OF FR-REC
    END-IF
    IF FP-FLAG-KEY = "Y" OR FP-FLAG-KEY = "N"
        MOVE FP-FLAG-KEY TO PF-FLAG-KEY OF FR-REC
    END-IF
    MOVE FP-SOURCE TO PF-SOURCE OF FR-REC
    MOVE FP-REF TO PF-REF OF FR-REC
    MOVE FP-REASON TO PF-REASON OF FR-REC
    MOVE "ACTIVE" TO PF-STATUS OF FR-REC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO PF-UPDATED OF FR-REC
    IF WS-FOUND = "N"
        MOVE WS-NOW(1:14) TO PF-CREATED OF FR-REC
        WRITE FR-REC
            INVALID KEY MOVE "22" TO FP-RC
        END-WRITE
    ELSE
        REWRITE FR-REC
            INVALID KEY MOVE "23" TO FP-RC
        END-REWRITE
    END-IF
    IF FP-RC NOT = "00"
        MOVE "FRAUD MARK STORE ERROR" TO FP-MSG
        PERFORM EXIT-FR
    END-IF
    MOVE "ACTIVE" TO FP-STATUS
    MOVE "FRAUD MARK APPLIED" TO FP-MSG
    PERFORM EMIT.

DO-RELEASE.
    IF WS-FOUND = "N"
        MOVE "20" TO FP-RC
        MOVE "FRAUD MARK NOT FOUND" TO FP-MSG
        PERFORM EXIT-FR
    END-IF
    MOVE "N" TO PF-FLAG-SEND OF FR-REC
    MOVE "N" TO PF-FLAG-RECV OF FR-REC
    MOVE "N" TO PF-FLAG-KEY OF FR-REC
    MOVE "RELEASED" TO PF-STATUS OF FR-REC
    ADD 1 TO PF-VERSION OF FR-REC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO PF-UPDATED OF FR-REC
    REWRITE FR-REC
        INVALID KEY MOVE "23" TO FP-RC
    END-REWRITE
    IF FP-RC NOT = "00"
        MOVE "FRAUD RELEASE STORE ERROR" TO FP-MSG
        PERFORM EXIT-FR
    END-IF
    MOVE "RELEASED" TO FP-STATUS
    MOVE "FRAUD MARK RELEASED" TO FP-MSG
    PERFORM EMIT.

DO-CHECK.
    IF WS-FOUND = "N"
        MOVE "NOT RESTRICTED" TO FP-MSG
        PERFORM EXIT-FR
    END-IF
    PERFORM FILL-PARMS
    IF PF-STATUS OF FR-REC NOT = "ACTIVE"
        MOVE "NOT RESTRICTED" TO FP-MSG
        PERFORM EXIT-FR
    END-IF
    IF FP-DIRECTION = "OUT" AND PF-FLAG-SEND OF FR-REC = "Y"
        MOVE "20" TO FP-RC
        MOVE "PIX SEND RESTRICTED BY FRAUD MARK" TO FP-MSG
    END-IF
    IF FP-DIRECTION = "IN" AND PF-FLAG-RECV OF FR-REC = "Y"
        MOVE "20" TO FP-RC
        MOVE "PIX RECEIVE RESTRICTED BY FRAUD MARK" TO FP-MSG
    END-IF
    IF FP-DIRECTION = "KEY" AND PF-FLAG-KEY OF FR-REC = "Y"
        MOVE "20" TO FP-RC
        MOVE "PIX KEY RESTRICTED BY FRAUD MARK" TO FP-MSG
    END-IF.

DO-KEY-RESTRICTED.
    IF WS-FOUND = "N"
        MOVE "N" TO FP-FLAG-KEY
        PERFORM EXIT-FR
    END-IF
    IF PF-STATUS OF FR-REC = "ACTIVE" AND
       PF-FLAG-KEY OF FR-REC = "Y"
        MOVE "Y" TO FP-FLAG-KEY
    ELSE
        MOVE "N" TO FP-FLAG-KEY
    END-IF.

DO-GET.
    IF WS-FOUND = "N"
        MOVE "23" TO FP-RC
        MOVE "FRAUD MARK NOT FOUND" TO FP-MSG
        PERFORM EXIT-FR
    END-IF
    PERFORM FILL-PARMS
    MOVE "FRAUD MARK" TO FP-MSG.

FILL-PARMS.
    MOVE PF-FLAG-SEND OF FR-REC TO FP-FLAG-SEND
    MOVE PF-FLAG-RECV OF FR-REC TO FP-FLAG-RECV
    MOVE PF-FLAG-KEY OF FR-REC TO FP-FLAG-KEY
    MOVE PF-SOURCE OF FR-REC TO FP-SOURCE
    MOVE PF-REF OF FR-REC TO FP-REF
    MOVE PF-STATUS OF FR-REC TO FP-STATUS.

EMIT.
    MOVE FP-OPERATOR TO BK-AUD-OPERATOR
    MOVE FP-OP(1:12) TO BK-AUD-ACTION
    MOVE FP-TARGET-KEY TO BK-AUD-ENTITY
    MOVE FP-CORR TO BK-AUD-CORR
    MOVE FP-STATUS TO BK-AUD-AFTER
    MOVE FP-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE "PIX.FRAUD.MARK.v1" TO BK-EVT-TYPE
    MOVE FP-TARGET-KEY TO BK-EVT-KEY
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(FP-TARGET-TYPE) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(FP-STATUS) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(FP-SOURCE) DELIMITED SIZE
        INTO BK-EVT-PAYLOAD
    CALL "BEVT" USING BK-EVT-PARMS.

EXIT-FR.
    CLOSE FR-FILE
    GOBACK.
