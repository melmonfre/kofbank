IDENTIFICATION DIVISION.
PROGRAM-ID. BPXKV.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CAND PIC X(60).
01 WS-DIGITS PIC X(60).
01 WS-ND PIC 9(02).
01 WS-DIGIT-COUNT PIC 9(03).
01 WS-WEIGHT-BASE PIC 9(03).
01 WS-I PIC 9(03).
01 WS-J PIC 9(03).
01 WS-LEN PIC 9(03).
01 WS-CH PIC X(01).
01 WS-AT PIC 9(03).
01 WS-DOT PIC 9(03).
01 WS-W PIC 9(02).
01 WS-PROD PIC 9(06).
01 WS-ACCUM PIC 9(07).
01 WS-REMAINDER PIC 9(02).
01 WS-DV PIC 9(02).
01 WS-REPEAT PIC X(01).
01 WS-MASK PIC X(30).
01 WS-TAIL PIC X(4).
01 WS-HASH-BUF PIC X(200).
01 WS-HASH-LEN PIC 9(04).

LINKAGE SECTION.
COPY "BPXKVP".

PROCEDURE DIVISION USING BK-PX-KEY-VAL.
    MOVE "00" TO KV-RC
    MOVE SPACES TO KV-MSG KV-NORM KV-MASK
    PERFORM CANONICALIZE
    IF KV-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(KV-TYPE)
        WHEN "CPF" PERFORM CHECK-CPF
        WHEN "CNPJ" PERFORM CHECK-CNPJ
        WHEN "EMAIL" PERFORM CHECK-EMAIL
        WHEN "PHONE" PERFORM CHECK-PHONE
        WHEN "RANDOM" PERFORM CHECK-RANDOM
        WHEN OTHER
            MOVE "20" TO KV-RC
            MOVE "UNKNOWN PIX KEY TYPE" TO KV-MSG
    END-EVALUATE
    IF KV-RC = "00"
        PERFORM BUILD-MASK
        PERFORM BUILD-HASH
    END-IF
    GOBACK.

CANONICALIZE.
    MOVE FUNCTION TRIM(KV-VALUE) TO WS-CAND
    MOVE SPACES TO KV-NORM WS-DIGITS
    MOVE 0 TO WS-ND
    IF KV-TYPE = "EMAIL" OR KV-TYPE = "RANDOM"
        MOVE WS-CAND TO KV-NORM
    ELSE
        PERFORM VARYING WS-I FROM 1 BY 1
            UNTIL WS-I > FUNCTION LENGTH(WS-CAND)
            IF WS-CAND(WS-I:1) >= "0" AND
               WS-CAND(WS-I:1) <= "9"
                ADD 1 TO WS-ND
                MOVE WS-CAND(WS-I:1) TO WS-DIGITS(WS-ND:1)
            END-IF
        END-PERFORM
        MOVE WS-DIGITS(1:WS-ND) TO KV-NORM
    END-IF
    IF KV-TYPE = "EMAIL"
        MOVE FUNCTION LOWER-CASE(FUNCTION TRIM(KV-NORM)) TO KV-NORM
    END-IF
    IF FUNCTION TRIM(KV-NORM) = SPACES
        MOVE "20" TO KV-RC
        MOVE "PIX KEY VALUE EMPTY" TO KV-MSG
    END-IF
    IF FUNCTION LENGTH(FUNCTION TRIM(KV-NORM)) > 60
        MOVE "20" TO KV-RC
        MOVE "PIX KEY VALUE TOO LONG" TO KV-MSG
    END-IF.

DOC-LENGTH.
    MOVE FUNCTION LENGTH(FUNCTION TRIM(KV-NORM)) TO WS-LEN.

CHECK-CPF.
    PERFORM DOC-LENGTH
    IF WS-LEN NOT = 11
        MOVE "20" TO KV-RC
        MOVE "INVALID CPF LENGTH" TO KV-MSG
        GOBACK
    END-IF
    PERFORM CHECK-REPEATED
    IF KV-RC NOT = "00"
        GOBACK
    END-IF
    MOVE 9 TO WS-DIGIT-COUNT
    MOVE 10 TO WS-WEIGHT-BASE
    PERFORM CPF-DIGIT
    IF WS-DV NOT = FUNCTION NUMVAL(KV-NORM(10:1))
        MOVE "20" TO KV-RC
        MOVE "INVALID CPF CHECK DIGIT" TO KV-MSG
        GOBACK
    END-IF
    MOVE 10 TO WS-DIGIT-COUNT
    MOVE 11 TO WS-WEIGHT-BASE
    PERFORM CPF-DIGIT
    IF WS-DV NOT = FUNCTION NUMVAL(KV-NORM(11:1))
        MOVE "20" TO KV-RC
        MOVE "INVALID CPF CHECK DIGIT" TO KV-MSG
    END-IF.

CPF-DIGIT.
    MOVE 0 TO WS-ACCUM
    PERFORM VARYING WS-I FROM 1 BY 1
        UNTIL WS-I > WS-DIGIT-COUNT
        COMPUTE WS-W = WS-WEIGHT-BASE + 1 - WS-I
        MULTIPLY FUNCTION NUMVAL(KV-NORM(WS-I:1)) BY WS-W
            GIVING WS-PROD
        ADD WS-PROD TO WS-ACCUM
    END-PERFORM
    COMPUTE WS-REMAINDER = FUNCTION MOD(WS-ACCUM 11)
    IF WS-REMAINDER < 2
        MOVE 0 TO WS-DV
    ELSE
        COMPUTE WS-DV = 11 - WS-REMAINDER
    END-IF.

CHECK-CNPJ.
    PERFORM DOC-LENGTH
    IF WS-LEN NOT = 14
        MOVE "20" TO KV-RC
        MOVE "INVALID CNPJ LENGTH" TO KV-MSG
        GOBACK
    END-IF
    PERFORM CHECK-REPEATED
    IF KV-RC NOT = "00"
        GOBACK
    END-IF
    MOVE 12 TO WS-DIGIT-COUNT
    PERFORM CNPJ-DIGIT
    IF WS-DV NOT = FUNCTION NUMVAL(KV-NORM(13:1))
        MOVE "20" TO KV-RC
        MOVE "INVALID CNPJ CHECK DIGIT" TO KV-MSG
        GOBACK
    END-IF
    MOVE 13 TO WS-DIGIT-COUNT
    PERFORM CNPJ-DIGIT
    IF WS-DV NOT = FUNCTION NUMVAL(KV-NORM(14:1))
        MOVE "20" TO KV-RC
        MOVE "INVALID CNPJ CHECK DIGIT" TO KV-MSG
    END-IF.

CNPJ-DIGIT.
    MOVE 0 TO WS-ACCUM
    MOVE 0 TO WS-W
    PERFORM VARYING WS-I FROM WS-DIGIT-COUNT BY -1
        UNTIL WS-I < 1
        IF WS-W = 0 OR WS-W = 9
            MOVE 2 TO WS-W
        ELSE
            ADD 1 TO WS-W
        END-IF
        MULTIPLY FUNCTION NUMVAL(KV-NORM(WS-I:1)) BY WS-W
            GIVING WS-PROD
        ADD WS-PROD TO WS-ACCUM
    END-PERFORM
    COMPUTE WS-REMAINDER = FUNCTION MOD(WS-ACCUM 11)
    IF WS-REMAINDER < 2
        MOVE 0 TO WS-DV
    ELSE
        COMPUTE WS-DV = 11 - WS-REMAINDER
    END-IF.

CHECK-REPEATED.
    PERFORM DOC-LENGTH
    MOVE KV-NORM(1:1) TO WS-CH
    MOVE "Y" TO WS-REPEAT
    PERFORM VARYING WS-I FROM 2 BY 1 UNTIL WS-I > WS-LEN
        IF KV-NORM(WS-I:1) NOT = WS-CH
            MOVE "N" TO WS-REPEAT
        END-IF
    END-PERFORM
    IF WS-REPEAT = "Y"
        MOVE "20" TO KV-RC
        MOVE "INVALID REPEATED DIGITS" TO KV-MSG
    END-IF.

CHECK-EMAIL.
    PERFORM DOC-LENGTH
    MOVE 0 TO WS-AT WS-DOT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-LEN
        IF KV-NORM(WS-I:1) = "@"
            IF WS-AT NOT = 0
                MOVE "20" TO KV-RC
                MOVE "INVALID EMAIL KEY" TO KV-MSG
                GOBACK
            END-IF
            MOVE WS-I TO WS-AT
        END-IF
        IF WS-AT > 0 AND KV-NORM(WS-I:1) = "."
            MOVE WS-I TO WS-DOT
        END-IF
    END-PERFORM
    IF WS-AT < 2
        MOVE "20" TO KV-RC
        MOVE "INVALID EMAIL KEY" TO KV-MSG
        GOBACK
    END-IF
    IF WS-DOT = 0 OR WS-DOT < WS-AT + 2 OR WS-DOT > WS-LEN - 2
        MOVE "20" TO KV-RC
        MOVE "INVALID EMAIL DOMAIN" TO KV-MSG
        GOBACK
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-LEN
        MOVE KV-NORM(WS-I:1) TO WS-CH
        IF WS-CH >= "a" AND WS-CH <= "z"
            CONTINUE
        ELSE
            IF WS-CH >= "0" AND WS-CH <= "9"
                CONTINUE
            ELSE
                IF WS-CH = "@" OR WS-CH = "." OR WS-CH = "-" OR
                   WS-CH = "_" OR WS-CH = "+"
                    CONTINUE
                ELSE
                    MOVE "20" TO KV-RC
                    MOVE "INVALID EMAIL CHARACTER" TO KV-MSG
                    GOBACK
                END-IF
            END-IF
        END-IF
    END-PERFORM.

CHECK-PHONE.
    PERFORM DOC-LENGTH
    IF WS-LEN < 12 OR WS-LEN > 13
        MOVE "20" TO KV-RC
        MOVE "INVALID PHONE KEY LENGTH" TO KV-MSG
        GOBACK
    END-IF
    IF FUNCTION NUMVAL(KV-NORM(1:2)) < 11
        MOVE "20" TO KV-RC
        MOVE "INVALID PHONE COUNTRY CODE" TO KV-MSG
        GOBACK
    END-IF
    IF FUNCTION NUMVAL(KV-NORM(3:2)) < 11
        MOVE "20" TO KV-RC
        MOVE "INVALID PHONE AREA CODE" TO KV-MSG
    END-IF.

CHECK-RANDOM.
    PERFORM DOC-LENGTH
    IF WS-LEN NOT = 32
        MOVE "20" TO KV-RC
        MOVE "INVALID RANDOM KEY LENGTH" TO KV-MSG
        GOBACK
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-LEN
        MOVE KV-NORM(WS-I:1) TO WS-CH
        IF WS-CH >= "a" AND WS-CH <= "z"
            CONTINUE
        ELSE
            IF WS-CH >= "A" AND WS-CH <= "Z"
                CONTINUE
            ELSE
                IF WS-CH >= "0" AND WS-CH <= "9"
                    CONTINUE
                ELSE
                    MOVE "20" TO KV-RC
                    MOVE "INVALID RANDOM KEY CHARACTER" TO KV-MSG
                    GOBACK
                END-IF
            END-IF
        END-IF
    END-PERFORM.

BUILD-MASK.
    MOVE SPACES TO WS-MASK KV-MASK
    PERFORM DOC-LENGTH
    EVALUATE FUNCTION TRIM(KV-TYPE)
        WHEN "CPF"
            STRING "***." DELIMITED SIZE KV-NORM(4:3) DELIMITED SIZE
                ".***-***" DELIMITED SIZE INTO WS-MASK
            END-STRING
        WHEN "CNPJ"
            STRING "***." DELIMITED SIZE KV-NORM(4:3) DELIMITED SIZE
                ".***/****-" DELIMITED SIZE
                KV-NORM(13:2) DELIMITED SIZE INTO WS-MASK
            END-STRING
        WHEN "EMAIL"
            IF WS-AT > 3
                STRING KV-NORM(1:2) DELIMITED SIZE "***@"
                    DELIMITED SIZE
                    KV-NORM(WS-AT + 1:) DELIMITED SIZE
                    INTO WS-MASK
                END-STRING
            ELSE
                STRING "**@***" DELIMITED SIZE INTO WS-MASK
                END-STRING
            END-IF
        WHEN OTHER
            IF WS-LEN > 4
                COMPUTE WS-J = WS-LEN - 3
                MOVE KV-NORM(WS-J:4) TO WS-TAIL
                STRING "****" DELIMITED SIZE WS-TAIL DELIMITED SIZE
                    INTO WS-MASK
                END-STRING
            ELSE
                MOVE "****" TO WS-MASK
            END-IF
    END-EVALUATE
    MOVE WS-MASK TO KV-MASK.

BUILD-HASH.
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(KV-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(KV-NORM) DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 200 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN KV-HASH.
