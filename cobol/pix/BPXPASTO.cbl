IDENTIFICATION DIVISION.
PROGRAM-ID. BPXPASTO.

*> Durable allocation store.  One indexed file keyed by allocation id,
*> one deterministic (pix-id, seq) index keyed for ordered replay.
*> Positions are derived from the SEQ index, never from file order.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT AL-FILE ASSIGN TO WS-AL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS AL-ALLOC-ID OF AL-REC
        FILE STATUS IS WS-AL-ST.
    SELECT AK-FILE ASSIGN TO WS-AK-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS AK-KEY OF AK-REC
        FILE STATUS IS WS-AK-ST.

DATA DIVISION.
FILE SECTION.
FD AL-FILE.
01 AL-REC.
   COPY "BPXPA".
FD AK-FILE.
01 AK-REC.
   05 AK-KEY           PIC X(14).
   05 AK-PIX-ID        PIC X(12).
   05 AK-SEQ           PIC 9(02).
   05 AK-ALLOC-ID      PIC X(12).

WORKING-STORAGE SECTION.
01 WS-AL-PATH PIC X(200).
01 WS-AK-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-AL-ST PIC X(02).
01 WS-AK-ST PIC X(02).
01 WS-AK-KEY PIC X(14).
01 WS-SEQ-C PIC X(01).
01 WS-EOF PIC X(01).
01 WS-I PIC 9(02).

LINKAGE SECTION.
COPY "BPXPAP".
01 BK-PX-ALLOC-REC.
   COPY "BPXPA".

PROCEDURE DIVISION USING BK-PX-ALLOC-STO-REQ BK-PX-ALLOC-REC
    BK-PX-ALLOC-TBL.
    MOVE "00" TO WA-RC
    MOVE SPACES TO WA-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-AL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxalloc.idx"
        DELIMITED SIZE INTO WS-AL-PATH
    MOVE SPACES TO WS-AK-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxallk.idx"
        DELIMITED SIZE INTO WS-AK-PATH
    EVALUATE FUNCTION TRIM(WA-OP)
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN "GET-SEQ" PERFORM DO-GET-SEQ
        WHEN "LIST-BY-PIX" PERFORM DO-LIST-BY-PIX
        WHEN OTHER
            MOVE "99" TO WA-RC
            MOVE "UNKNOWN ALLOC STO OP" TO WA-MSG
    END-EVALUATE
    GOBACK.

BUILD-SEQ-CHAR.
    IF WA-SEQ >= 1 AND WA-SEQ <= 26
        COMPUTE WS-I = FUNCTION ORD("A") - 1 + WA-SEQ
        MOVE FUNCTION CHAR(WS-I) TO WS-SEQ-C
    ELSE
        MOVE "?" TO WS-SEQ-C
    END-IF.

DO-WRITE.
    PERFORM OPEN-AL-I-O
    IF WA-RC NOT = "00"
        GOBACK
    END-IF
    MOVE BK-PX-ALLOC-REC TO AL-REC
    WRITE AL-REC
        INVALID KEY
            MOVE "22" TO WA-RC
            MOVE "ALLOC ALREADY EXISTS" TO WA-MSG
        NOT INVALID KEY
            CONTINUE
    END-WRITE
    CLOSE AL-FILE
    IF WA-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM OPEN-AK-I-O
    IF WA-RC NOT = "00"
        GOBACK
    END-IF
    MOVE AL-PIX-ID OF BK-PX-ALLOC-REC TO AK-PIX-ID
    MOVE AL-SEQ OF BK-PX-ALLOC-REC TO AK-SEQ
    MOVE AL-ALLOC-ID OF BK-PX-ALLOC-REC TO AK-ALLOC-ID
    PERFORM BUILD-SEQ-CHAR
    STRING AK-PIX-ID DELIMITED SIZE WS-SEQ-C DELIMITED SIZE
        INTO WS-AK-KEY
    END-STRING
    MOVE WS-AK-KEY TO AK-KEY
    WRITE AK-REC
        INVALID KEY
            MOVE "22" TO WA-RC
            MOVE "ALLOC SEQ ALREADY EXISTS" TO WA-MSG
        NOT INVALID KEY
            CONTINUE
    END-WRITE
    CLOSE AK-FILE.

DO-REWRITE.
    PERFORM OPEN-AL-I-O
    IF WA-RC NOT = "00"
        GOBACK
    END-IF
    MOVE AL-ALLOC-ID OF BK-PX-ALLOC-REC TO AL-ALLOC-ID
        OF AL-REC
    READ AL-FILE
        INVALID KEY
            MOVE "23" TO WA-RC
            MOVE "ALLOC NOT FOUND" TO WA-MSG
    END-READ
    IF WA-RC NOT = "00"
        CLOSE AL-FILE
        GOBACK
    END-IF
    MOVE BK-PX-ALLOC-REC TO AL-REC
    REWRITE AL-REC
        INVALID KEY
            MOVE "23" TO WA-RC
            MOVE "ALLOC NOT FOUND" TO WA-MSG
        NOT INVALID KEY
            CONTINUE
    END-REWRITE
    CLOSE AL-FILE.

DO-GET.
    PERFORM OPEN-AL-INPUT
    IF WA-RC NOT = "00"
        GOBACK
    END-IF
    MOVE WA-ALLOC-ID TO AL-ALLOC-ID OF AL-REC
    READ AL-FILE
        INVALID KEY
            MOVE "23" TO WA-RC
            MOVE "ALLOC NOT FOUND" TO WA-MSG
        NOT INVALID KEY
            MOVE AL-REC TO BK-PX-ALLOC-REC
    END-READ
    CLOSE AL-FILE.

DO-GET-SEQ.
    PERFORM BUILD-SEQ-CHAR
    STRING WA-PIX-ID DELIMITED SIZE WS-SEQ-C DELIMITED SIZE
        INTO WS-AK-KEY
    END-STRING
    PERFORM OPEN-AK-INPUT
    IF WA-RC NOT = "00"
        GOBACK
    END-IF
    MOVE WS-AK-KEY TO AK-KEY
    READ AK-FILE
        INVALID KEY
            MOVE "23" TO WA-RC
            MOVE "ALLOC SEQ NOT FOUND" TO WA-MSG
        NOT INVALID KEY
            MOVE AK-ALLOC-ID TO AL-ALLOC-ID
                OF BK-PX-ALLOC-REC
            MOVE AK-ALLOC-ID TO WA-ALLOC-ID
    END-READ
    CLOSE AK-FILE
    IF WA-RC = "00"
        PERFORM DO-GET
    END-IF.

DO-LIST-BY-PIX.
    MOVE 0 TO PXA-CNT
    PERFORM OPEN-AL-INPUT
    IF WA-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ AL-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF AL-PIX-ID OF AL-REC = WA-PIX-ID
                    ADD 1 TO PXA-CNT
                    IF PXA-CNT <= 20
                        PERFORM FILL-ROW
                    END-IF
                END-IF
        END-READ
    END-PERFORM
    CLOSE AL-FILE
    IF WA-RC = "00" AND PXA-CNT > 20
        MOVE "20" TO WA-RC
        MOVE "ALLOC LIST OVERFLOW" TO WA-MSG
    END-IF.

FILL-ROW.
    MOVE AL-SEQ OF AL-REC TO PXA-SEQ(PXA-CNT)
    MOVE AL-ALLOC-ID OF AL-REC TO PXA-ALLOC-ID(PXA-CNT)
    MOVE AL-DEST-ROLE OF AL-REC TO PXA-DEST-ROLE(PXA-CNT)
    EVALUATE FUNCTION TRIM(AL-DEST-ROLE OF AL-REC)
        WHEN "PARTICIPANT"
            MOVE AL-DEST-PART OF AL-REC TO PXA-DEST-ID(PXA-CNT)
        WHEN OTHER
            MOVE AL-DEST-ACCT OF AL-REC TO PXA-DEST-ID(PXA-CNT)
    END-EVALUATE
    MOVE AL-DEST-CUST OF AL-REC TO PXA-DEST-CUST(PXA-CNT)
    MOVE AL-DEST-DOC-TYPE OF AL-REC TO PXA-DEST-DOC-TYPE(PXA-CNT)
    MOVE AL-DEST-DOC OF AL-REC TO PXA-DEST-DOC(PXA-CNT)
    MOVE AL-DEST-NAME OF AL-REC TO PXA-DEST-NAME(PXA-CNT)
    MOVE AL-AMOUNT OF AL-REC TO PXA-AMOUNT(PXA-CNT)
    MOVE AL-TYPE OF AL-REC TO PXA-TYPE(PXA-CNT)
    MOVE AL-REF OF AL-REC TO PXA-REF(PXA-CNT)
    MOVE AL-DOC-REF OF AL-REC TO PXA-DOC-REF(PXA-CNT)
    MOVE AL-TAX-TYPE OF AL-REC TO PXA-TAX-TYPE(PXA-CNT)
    MOVE AL-TAX-CAT OF AL-REC TO PXA-TAX-CAT(PXA-CNT)
    MOVE AL-STATUS OF AL-REC TO PXA-STATUS(PXA-CNT)
    MOVE AL-ORIG-ALLOC-ID OF AL-REC TO PXA-ORIG-ALLOC-ID(PXA-CNT)
    MOVE AL-TXN-ID OF AL-REC TO PXA-TXN-ID(PXA-CNT)
    MOVE AL-JRN-ID OF AL-REC TO PXA-JRN-ID(PXA-CNT).

OPEN-AL-I-O.
    OPEN I-O AL-FILE
    IF WS-AL-ST = "35" OR WS-AL-ST = "05" OR WS-AL-ST = "46"
        OPEN OUTPUT AL-FILE
        CLOSE AL-FILE
        OPEN I-O AL-FILE
    END-IF
    IF WS-AL-ST NOT = "00"
        MOVE "30" TO WA-RC
        MOVE "ALLOC STORE UNAVAILABLE" TO WA-MSG
    END-IF.

OPEN-AL-INPUT.
    OPEN INPUT AL-FILE
    IF WS-AL-ST = "00"
        EXIT PARAGRAPH
    END-IF
    IF WS-AL-ST = "35" OR WS-AL-ST = "05" OR WS-AL-ST = "46"
        MOVE "23" TO WA-RC
        MOVE "ALLOC STORE EMPTY" TO WA-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "30" TO WA-RC
    MOVE "ALLOC STORE UNAVAILABLE" TO WA-MSG.

OPEN-AK-I-O.
    OPEN I-O AK-FILE
    IF WS-AK-ST = "35" OR WS-AK-ST = "05" OR WS-AK-ST = "46"
        OPEN OUTPUT AK-FILE
        CLOSE AK-FILE
        OPEN I-O AK-FILE
    END-IF
    IF WS-AK-ST NOT = "00"
        MOVE "30" TO WA-RC
        MOVE "ALLOC KEY STORE UNAVAILABLE" TO WA-MSG
    END-IF.

OPEN-AK-INPUT.
    OPEN INPUT AK-FILE
    IF WS-AK-ST = "00"
        EXIT PARAGRAPH
    END-IF
    IF WS-AK-ST = "35" OR WS-AK-ST = "05" OR WS-AK-ST = "46"
        MOVE "23" TO WA-RC
        MOVE "ALLOC KEY STORE EMPTY" TO WA-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "30" TO WA-RC
    MOVE "ALLOC KEY STORE UNAVAILABLE" TO WA-MSG.
