IDENTIFICATION DIVISION.
PROGRAM-ID. BPXKSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PK-FILE ASSIGN TO WS-PK-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PK-ID OF PK-REC
        FILE STATUS IS WS-PK-ST.
    SELECT PH-FILE ASSIGN TO WS-PH-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PH-HASH OF PH-REC
        FILE STATUS IS WS-PH-ST.
    SELECT PA-FILE ASSIGN TO WS-PA-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PA-KEY OF PA-REC
        FILE STATUS IS WS-PA-ST.
    SELECT PC-FILE ASSIGN TO WS-PC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PC-KEY OF PC-REC
        FILE STATUS IS WS-PC-ST.

DATA DIVISION.
FILE SECTION.
FD PK-FILE.
01 PK-REC.
   COPY "BPXK".
FD PH-FILE.
01 PH-REC.
   05 PH-HASH          PIC X(16).
   05 PH-KEY-ID        PIC X(12).
   05 PH-PART          PIC X(12).
   05 PH-STATUS        PIC X(12).
FD PA-FILE.
01 PA-REC.
   05 PA-KEY.
      10 PA-ACCT       PIC X(12).
      10 PA-TYPE       PIC X(10).
   05 PA-KEY-ID        PIC X(12).
   05 PA-HASH          PIC X(16).
FD PC-FILE.
01 PC-REC.
   05 PC-KEY.
      10 PC-CUST       PIC X(12).
      10 PC-HASH       PIC X(16).
   05 PC-KEY-ID        PIC X(12).

WORKING-STORAGE SECTION.
01 WS-PK-PATH PIC X(200).
01 WS-PH-PATH PIC X(200).
01 WS-PA-PATH PIC X(200).
01 WS-PC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-PK-ST PIC X(02).
01 WS-PH-ST PIC X(02).
01 WS-PA-ST PIC X(02).
01 WS-PC-ST PIC X(02).

LINKAGE SECTION.
COPY "BPXKS".
01 BK-PX-KEY.
   COPY "BPXK".

PROCEDURE DIVISION USING BK-PX-KEY-STO-REQ BK-PX-KEY.
    MOVE "00" TO KS-RC
    MOVE SPACES TO KS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    PERFORM RESOLVE-PATHS
    EVALUATE KS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN "GET-HASH" PERFORM DO-GET-HASH
        WHEN "UPDATE-HASH" PERFORM DO-UPDATE-HASH
        WHEN "GET-ACCT" PERFORM DO-GET-ACCT
        WHEN "COUNT-ACCT" PERFORM DO-COUNT-ACCT
        WHEN "DELETE-REC" PERFORM DO-DELETE
        WHEN OTHER
            MOVE "99" TO KS-RC
            MOVE "UNKNOWN PIX KEY STO OP" TO KS-MSG
    END-EVALUATE
    GOBACK.

RESOLVE-PATHS.
    MOVE SPACES TO WS-PK-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxkey.idx"
        DELIMITED SIZE INTO WS-PK-PATH
    MOVE SPACES TO WS-PH-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxkeyh.idx"
        DELIMITED SIZE INTO WS-PH-PATH
    MOVE SPACES TO WS-PA-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxkeya.idx"
        DELIMITED SIZE INTO WS-PA-PATH
    MOVE SPACES TO WS-PC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxkeyc.idx"
        DELIMITED SIZE INTO WS-PC-PATH.

DO-WRITE.
    PERFORM OPEN-PK
    IF KS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-KEY TO PK-REC
    WRITE PK-REC
        INVALID KEY
            MOVE "22" TO KS-RC
            MOVE "PIX KEY ALREADY EXISTS" TO KS-MSG
    END-WRITE
    PERFORM CLOSE-PK
    IF KS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM OPEN-PH
    MOVE PK-VALUE-HASH OF BK-PX-KEY TO PH-HASH
    MOVE PK-ID OF BK-PX-KEY TO PH-KEY-ID
    MOVE PK-PART OF BK-PX-KEY TO PH-PART
    MOVE PK-STATUS OF BK-PX-KEY TO PH-STATUS
    WRITE PH-REC
        INVALID KEY
            MOVE "22" TO KS-RC
            MOVE "PIX KEY ALREADY REGISTERED" TO KS-MSG
    END-WRITE
    PERFORM CLOSE-PH
    IF KS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM OPEN-PA
    MOVE PK-ACCT OF BK-PX-KEY TO PA-ACCT
    MOVE PK-TYPE OF BK-PX-KEY TO PA-TYPE
    MOVE PK-ID OF BK-PX-KEY TO PA-KEY-ID
    MOVE PK-VALUE-HASH OF BK-PX-KEY TO PA-HASH
    WRITE PA-REC
        INVALID KEY
            MOVE "22" TO KS-RC
            MOVE "KEY TYPE ALREADY USED ON ACCOUNT" TO KS-MSG
    END-WRITE
    PERFORM CLOSE-PA
    IF KS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM OPEN-PC
    MOVE PK-CUST OF BK-PX-KEY TO PC-CUST
    MOVE PK-VALUE-HASH OF BK-PX-KEY TO PC-HASH
    MOVE PK-ID OF BK-PX-KEY TO PC-KEY-ID
    WRITE PC-REC
        INVALID KEY
            MOVE "22" TO KS-RC
            MOVE "PIX KEY ALREADY OWNED BY CUSTOMER" TO KS-MSG
    END-WRITE
    PERFORM CLOSE-PC.

DO-UPDATE-HASH.
    PERFORM OPEN-PH
    MOVE PK-VALUE-HASH OF BK-PX-KEY TO PH-HASH
    READ PH-FILE
    IF WS-PH-ST = "00"
        MOVE PK-ID OF BK-PX-KEY TO PH-KEY-ID
        MOVE PK-PART OF BK-PX-KEY TO PH-PART
        MOVE PK-STATUS OF BK-PX-KEY TO PH-STATUS
        REWRITE PH-REC
    END-IF
    PERFORM CLOSE-PH.

DO-REWRITE.
    PERFORM OPEN-PK
    IF KS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-KEY TO PK-REC
    REWRITE PK-REC
        INVALID KEY
            MOVE "23" TO KS-RC
            MOVE "PIX KEY MISSING" TO KS-MSG
    END-REWRITE
    PERFORM CLOSE-PK
    IF KS-RC = "00"
        PERFORM DO-UPDATE-HASH
    END-IF.

DO-GET.
    PERFORM OPEN-PK
    IF KS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE PK-ID OF BK-PX-KEY TO PK-ID OF PK-REC
    READ PK-FILE
    EVALUATE WS-PK-ST
        WHEN "00" MOVE PK-REC TO BK-PX-KEY
        WHEN "23"
            MOVE "23" TO KS-RC
            MOVE "PIX KEY NOT FOUND" TO KS-MSG
        WHEN OTHER
            MOVE WS-PK-ST TO KS-RC
            MOVE "PIX KEY STORE ERROR" TO KS-MSG
    END-EVALUATE
    PERFORM CLOSE-PK.

DO-GET-HASH.
    PERFORM OPEN-PH
    IF KS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE PK-VALUE-HASH OF BK-PX-KEY TO PH-HASH
    READ PH-FILE
    EVALUATE WS-PH-ST
        WHEN "00"
            MOVE PH-KEY-ID TO PK-ID OF BK-PX-KEY
            MOVE PH-PART TO PK-PART OF BK-PX-KEY
            MOVE PH-STATUS TO PK-STATUS OF BK-PX-KEY
        WHEN "23"
            MOVE "23" TO KS-RC
            MOVE "PIX KEY NOT IN DICT" TO KS-MSG
        WHEN OTHER
            MOVE WS-PH-ST TO KS-RC
            MOVE "PIX KEY HASH STORE ERROR" TO KS-MSG
    END-EVALUATE
    PERFORM CLOSE-PH.

DO-GET-ACCT.
    PERFORM OPEN-PA
    IF KS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE PK-ACCT OF BK-PX-KEY TO PA-ACCT
    MOVE PK-TYPE OF BK-PX-KEY TO PA-TYPE
    READ PA-FILE
    EVALUATE WS-PA-ST
        WHEN "00"
            MOVE PA-KEY-ID TO PK-ID OF BK-PX-KEY
            MOVE PA-HASH TO PK-VALUE-HASH OF BK-PX-KEY
        WHEN "23"
            MOVE "23" TO KS-RC
            MOVE "PIX KEY NOT FOUND ON ACCOUNT" TO KS-MSG
        WHEN OTHER
            MOVE WS-PA-ST TO KS-RC
            MOVE "PIX KEY ACCOUNT STORE ERROR" TO KS-MSG
    END-EVALUATE
    PERFORM CLOSE-PA.

DO-COUNT-ACCT.
    PERFORM OPEN-PA
    IF KS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE 0 TO KS-COUNT
    MOVE PK-ACCT OF BK-PX-KEY TO PA-ACCT
    MOVE SPACES TO PA-TYPE
    READ PA-FILE NEXT
        INVALID KEY MOVE "00" TO WS-PA-ST
    END-READ
    PERFORM UNTIL WS-PA-ST NOT = "00"
        IF PA-ACCT = PK-ACCT OF BK-PX-KEY
            ADD 1 TO KS-COUNT
        END-IF
        READ PA-FILE NEXT
            INVALID KEY MOVE "00" TO WS-PA-ST
        END-READ
    END-PERFORM
    MOVE "00" TO KS-RC
    PERFORM CLOSE-PA.

DO-DELETE.
    PERFORM OPEN-PK
    MOVE PK-ID OF BK-PX-KEY TO PK-ID OF PK-REC
    READ PK-FILE
    IF WS-PK-ST = "00"
        DELETE PK-FILE
    ELSE
        MOVE "23" TO KS-RC
        MOVE "PIX KEY NOT FOUND" TO KS-MSG
    END-IF
    PERFORM CLOSE-PK
    IF KS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM OPEN-PH
    MOVE PK-VALUE-HASH OF BK-PX-KEY TO PH-HASH
    READ PH-FILE
    IF WS-PH-ST = "00"
        DELETE PH-FILE
    END-IF
    PERFORM CLOSE-PH
    PERFORM OPEN-PA
    MOVE PK-ACCT OF BK-PX-KEY TO PA-ACCT
    MOVE PK-TYPE OF BK-PX-KEY TO PA-TYPE
    READ PA-FILE
    IF WS-PA-ST = "00"
        DELETE PA-FILE
    END-IF
    PERFORM CLOSE-PA
    PERFORM OPEN-PC
    MOVE PK-CUST OF BK-PX-KEY TO PC-CUST
    MOVE PK-VALUE-HASH OF BK-PX-KEY TO PC-HASH
    READ PC-FILE
    IF WS-PC-ST = "00"
        DELETE PC-FILE
    END-IF
    PERFORM CLOSE-PC
    MOVE "PIX KEY DELETED" TO KS-MSG.

OPEN-PK.
    OPEN I-O PK-FILE
    IF WS-PK-ST = "35"
        OPEN OUTPUT PK-FILE
        CLOSE PK-FILE
        OPEN I-O PK-FILE
    END-IF
    IF WS-PK-ST NOT = "00"
        MOVE WS-PK-ST TO KS-RC
        MOVE "PIX KEY STORE OPEN ERROR" TO KS-MSG
    END-IF.

CLOSE-PK.
    CLOSE PK-FILE.

OPEN-PH.
    OPEN I-O PH-FILE
    IF WS-PH-ST = "35"
        OPEN OUTPUT PH-FILE
        CLOSE PH-FILE
        OPEN I-O PH-FILE
    END-IF
    IF WS-PH-ST NOT = "00"
        MOVE WS-PH-ST TO KS-RC
        MOVE "PIX KEY DICT STORE OPEN ERROR" TO KS-MSG
    END-IF.

CLOSE-PH.
    CLOSE PH-FILE.

OPEN-PA.
    OPEN I-O PA-FILE
    IF WS-PA-ST = "35"
        OPEN OUTPUT PA-FILE
        CLOSE PA-FILE
        OPEN I-O PA-FILE
    END-IF
    IF WS-PA-ST NOT = "00"
        MOVE WS-PA-ST TO KS-RC
        MOVE "PIX KEY ACCOUNT STORE OPEN ERROR" TO KS-MSG
    END-IF.

CLOSE-PA.
    CLOSE PA-FILE.

OPEN-PC.
    OPEN I-O PC-FILE
    IF WS-PC-ST = "35"
        OPEN OUTPUT PC-FILE
        CLOSE PC-FILE
        OPEN I-O PC-FILE
    END-IF
    IF WS-PC-ST NOT = "00"
        MOVE WS-PC-ST TO KS-RC
        MOVE "PIX KEY OWNER STORE OPEN ERROR" TO KS-MSG
    END-IF.

CLOSE-PC.
    CLOSE PC-FILE.
