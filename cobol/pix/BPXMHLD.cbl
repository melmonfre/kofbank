IDENTIFICATION DIVISION.
PROGRAM-ID. BPXMHLD.

*> MED funds hold manager.  A hold is a temporary reservation of the
*> receiving account funds; it is NOT a ledger debit.  Availability is
*> maintained through the reusable BGLBLK primitive (available = ledger -
*> blocked), so no second balance is introduced.  One active hold per MED
*> case is enforced durably by scanning the hold store, so a repeated block
*> request replays instead of double-reserving.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT HOLD-FILE ASSIGN TO WS-H-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS MH-HOLD-ID OF HOLD-REC
        FILE STATUS IS WS-H-ST.

DATA DIVISION.
FILE SECTION.
FD HOLD-FILE.
01 HOLD-REC.
   COPY "BPXMH".

WORKING-STORAGE SECTION.
01 WS-H-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-H-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20).
01 WS-NOW PIC X(14).
01 WS-FOUND PIC X(01).
01 WS-DELTA PIC S9(15)V99 COMP-3.
01 WS-BLOCKED PIC S9(15)V99 COMP-3.
01 WS-AVAILABLE PIC S9(15)V99 COMP-3.
01 WS-LEDGER PIC S9(15)V99 COMP-3.
01 WS-BLK-RC PIC X(02).
01 WS-BLK-MSG PIC X(80).
01 BK-MH-REC.
   COPY "BPXMH".

LINKAGE SECTION.
COPY "BPXMHSP".

PROCEDURE DIVISION USING BK-MH-PARMS.
    MOVE "00" TO HL-RC
    MOVE SPACES TO HL-MSG
    MOVE "N" TO HL-REPLAY
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-H-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxmedh.idx"
        DELIMITED SIZE INTO WS-H-PATH
    EVALUATE FUNCTION TRIM(HL-OP)
        WHEN "HOLD-CREATE" PERFORM DO-CREATE
        WHEN "HOLD-INCREASE" PERFORM DO-INCREASE
        WHEN "HOLD-RELEASE" PERFORM DO-RELEASE
        WHEN "HOLD-CONSUME" PERFORM DO-CONSUME
        WHEN "HOLD-GET" PERFORM DO-GET
        WHEN "HOLD-ACTIVE" PERFORM DO-ACTIVE
        WHEN OTHER
            MOVE "99" TO HL-RC
            MOVE "UNKNOWN MED HOLD OP" TO HL-MSG
    END-EVALUATE
    GOBACK.

DO-CREATE.
    IF HL-MED-CASE-ID = SPACES
        MOVE "20" TO HL-RC
        MOVE "MED CASE REQUIRED FOR HOLD" TO HL-MSG
        GOBACK
    END-IF
    IF HL-AMOUNT <= 0
        MOVE "20" TO HL-RC
        MOVE "HOLD AMOUNT REQUIRED" TO HL-MSG
        GOBACK
    END-IF
    PERFORM FIND-ACTIVE-BY-CASE
    IF WS-FOUND = "Y"
        MOVE "Y" TO HL-REPLAY
        MOVE "MED HOLD EXISTS" TO HL-MSG
        EXIT PARAGRAPH
    END-IF
    CALL "BGLBLK" USING HL-ACCT HL-CURRENCY HL-AMOUNT
        WS-BLOCKED WS-AVAILABLE WS-LEDGER WS-BLK-RC WS-BLK-MSG
    IF WS-BLK-RC NOT = "00"
        MOVE WS-BLK-RC TO HL-RC
        MOVE WS-BLK-MSG TO HL-MSG
        GOBACK
    END-IF
    MOVE "MED-HOLD" TO WS-SEQ-NAME
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO HL-RC
        MOVE "MED HOLD SEQUENCE ERROR" TO HL-MSG
        GOBACK
    END-IF
    MOVE SPACES TO HL-HOLD-ID
    STRING "HLD" DELIMITED SIZE WS-SEQ DELIMITED SIZE INTO HL-HOLD-ID
    END-STRING
    PERFORM OPEN-HOLD
    IF HL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE SPACES TO HOLD-REC
    MOVE HL-HOLD-ID TO MH-HOLD-ID OF HOLD-REC
    MOVE HL-ACCT TO MH-ACCT OF HOLD-REC
    MOVE HL-CURRENCY TO MH-CURRENCY OF HOLD-REC
    MOVE HL-AMOUNT TO MH-AMOUNT OF HOLD-REC
    MOVE HL-ORIG-PIX-ID TO MH-ORIG-PIX-ID OF HOLD-REC
    MOVE HL-MED-CASE-ID TO MH-MED-CASE-ID OF HOLD-REC
    MOVE "ACTIVE" TO MH-STATUS OF HOLD-REC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:8) TO MH-BIZDATE OF HOLD-REC
    MOVE WS-NOW(1:14) TO MH-CREATED OF HOLD-REC
    MOVE WS-NOW(1:14) TO MH-UPDATED OF HOLD-REC
    MOVE 1 TO MH-VERSION OF HOLD-REC
    WRITE HOLD-REC
        INVALID KEY MOVE "22" TO HL-RC
    END-WRITE
    CLOSE HOLD-FILE
    MOVE WS-AVAILABLE TO HL-AVAIL-OUT
    MOVE WS-AVAILABLE TO HL-ACTIVE-TOTAL
    MOVE "MED HOLD CREATED" TO HL-MSG.

DO-INCREASE.
    PERFORM LOAD-HOLD
    IF HL-RC NOT = "00"
        GOBACK
    END-IF
    IF MH-STATUS OF BK-MH-REC NOT = "ACTIVE"
        MOVE "20" TO HL-RC
        MOVE "HOLD NOT ACTIVE" TO HL-MSG
        GOBACK
    END-IF
    CALL "BGLBLK" USING MH-ACCT OF BK-MH-REC MH-CURRENCY OF BK-MH-REC
        HL-ADJUST WS-BLOCKED WS-AVAILABLE WS-LEDGER WS-BLK-RC WS-BLK-MSG
    IF WS-BLK-RC NOT = "00"
        MOVE WS-BLK-RC TO HL-RC
        MOVE WS-BLK-MSG TO HL-MSG
        GOBACK
    END-IF
    ADD HL-ADJUST TO MH-AMOUNT OF BK-MH-REC
    MOVE WS-AVAILABLE TO HL-AVAIL-OUT
    PERFORM SAVE-HOLD.

DO-RELEASE.
    PERFORM LOAD-HOLD
    IF HL-RC NOT = "00"
        GOBACK
    END-IF
    IF MH-STATUS OF BK-MH-REC NOT = "ACTIVE"
        MOVE "MED HOLD ALREADY SETTLED" TO HL-MSG
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-DELTA = 0 - MH-AMOUNT OF BK-MH-REC
    CALL "BGLBLK" USING MH-ACCT OF BK-MH-REC MH-CURRENCY OF BK-MH-REC
        WS-DELTA WS-BLOCKED WS-AVAILABLE WS-LEDGER WS-BLK-RC WS-BLK-MSG
    IF WS-BLK-RC NOT = "00"
        MOVE WS-BLK-RC TO HL-RC
        MOVE WS-BLK-MSG TO HL-MSG
        GOBACK
    END-IF
    MOVE "RELEASED" TO MH-STATUS OF BK-MH-REC
    MOVE WS-AVAILABLE TO HL-AVAIL-OUT
    PERFORM SAVE-HOLD
    MOVE "MED HOLD RELEASED" TO HL-MSG.

DO-CONSUME.
    PERFORM LOAD-HOLD
    IF HL-RC NOT = "00"
        GOBACK
    END-IF
    IF MH-STATUS OF BK-MH-REC NOT = "ACTIVE"
        MOVE "MED HOLD ALREADY SETTLED" TO HL-MSG
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-DELTA = 0 - MH-AMOUNT OF BK-MH-REC
    CALL "BGLBLK" USING MH-ACCT OF BK-MH-REC MH-CURRENCY OF BK-MH-REC
        WS-DELTA WS-BLOCKED WS-AVAILABLE WS-LEDGER WS-BLK-RC WS-BLK-MSG
    IF WS-BLK-RC NOT = "00"
        MOVE WS-BLK-RC TO HL-RC
        MOVE WS-BLK-MSG TO HL-MSG
        GOBACK
    END-IF
    MOVE "CONSUMED" TO MH-STATUS OF BK-MH-REC
    MOVE WS-AVAILABLE TO HL-AVAIL-OUT
    PERFORM SAVE-HOLD
    MOVE "MED HOLD CONSUMED" TO HL-MSG.

DO-GET.
    PERFORM LOAD-HOLD
    IF HL-RC = "00"
        MOVE MH-ACCT OF BK-MH-REC TO HL-ACCT
        MOVE MH-CURRENCY OF BK-MH-REC TO HL-CURRENCY
        MOVE MH-AMOUNT OF BK-MH-REC TO HL-AMOUNT
        MOVE MH-STATUS OF BK-MH-REC TO HL-STATUS
        MOVE MH-MED-CASE-ID OF BK-MH-REC TO HL-MED-CASE-ID
        MOVE "MED HOLD" TO HL-MSG
    END-IF.

DO-ACTIVE.
    MOVE 0 TO HL-ACTIVE-TOTAL
    MOVE 0 TO HL-ACTIVE-COUNT
    PERFORM OPEN-HOLD-INPUT
    IF HL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ HOLD-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM SUM-ACTIVE
        END-READ
    END-PERFORM
    CLOSE HOLD-FILE
    MOVE "MED ACTIVE HOLDS" TO HL-MSG.

SUM-ACTIVE.
    IF HL-ACCT NOT = SPACES AND MH-ACCT OF HOLD-REC NOT = HL-ACCT
        EXIT PARAGRAPH
    END-IF
    IF MH-STATUS OF HOLD-REC = "ACTIVE"
        ADD MH-AMOUNT OF HOLD-REC TO HL-ACTIVE-TOTAL
        ADD 1 TO HL-ACTIVE-COUNT
    END-IF.

FIND-ACTIVE-BY-CASE.
    MOVE "N" TO WS-FOUND
    MOVE 0 TO HL-ACTIVE-TOTAL
    MOVE 0 TO HL-AVAIL-OUT
    PERFORM OPEN-HOLD-INPUT
    IF HL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ HOLD-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM CHECK-CASE-HOLD
        END-READ
    END-PERFORM
    CLOSE HOLD-FILE.

CHECK-CASE-HOLD.
    IF MH-MED-CASE-ID OF HOLD-REC = HL-MED-CASE-ID AND
       MH-STATUS OF HOLD-REC = "ACTIVE"
        MOVE "Y" TO WS-FOUND
        MOVE MH-HOLD-ID OF HOLD-REC TO HL-HOLD-ID
        MOVE MH-ACCT OF HOLD-REC TO HL-ACCT
        MOVE MH-CURRENCY OF HOLD-REC TO HL-CURRENCY
        MOVE MH-AMOUNT OF HOLD-REC TO HL-AMOUNT
        MOVE MH-STATUS OF HOLD-REC TO HL-STATUS
    END-IF.

LOAD-HOLD.
    MOVE SPACES TO BK-MH-REC
    MOVE SPACES TO HOLD-REC
    MOVE HL-HOLD-ID TO MH-HOLD-ID OF HOLD-REC
    PERFORM OPEN-HOLD
    IF HL-RC NOT = "00"
        GOBACK
    END-IF
    READ HOLD-FILE
    EVALUATE WS-H-ST
        WHEN "00" MOVE HOLD-REC TO BK-MH-REC
        WHEN "23"
            MOVE "23" TO HL-RC
            MOVE "MED HOLD NOT FOUND" TO HL-MSG
        WHEN OTHER
            MOVE WS-H-ST TO HL-RC
            MOVE "MED HOLD STORE READ ERROR" TO HL-MSG
    END-EVALUATE
    CLOSE HOLD-FILE.

SAVE-HOLD.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO MH-UPDATED OF BK-MH-REC
    ADD 1 TO MH-VERSION OF BK-MH-REC
    MOVE BK-MH-REC TO HOLD-REC
    PERFORM OPEN-HOLD
    IF HL-RC NOT = "00"
        GOBACK
    END-IF
    REWRITE HOLD-REC
        INVALID KEY MOVE "23" TO HL-RC
    END-REWRITE
    CLOSE HOLD-FILE.

OPEN-HOLD.
    OPEN I-O HOLD-FILE
    IF WS-H-ST = "35"
        OPEN OUTPUT HOLD-FILE
        CLOSE HOLD-FILE
        OPEN I-O HOLD-FILE
    END-IF
    IF WS-H-ST NOT = "00"
        MOVE WS-H-ST TO HL-RC
        MOVE "MED HOLD STORE OPEN ERROR" TO HL-MSG
    END-IF.

OPEN-HOLD-INPUT.
    OPEN INPUT HOLD-FILE
    IF WS-H-ST = "35"
        OPEN OUTPUT HOLD-FILE
        CLOSE HOLD-FILE
        OPEN INPUT HOLD-FILE
    END-IF
    IF WS-H-ST NOT = "00"
        MOVE WS-H-ST TO HL-RC
        MOVE "MED HOLD STORE INPUT ERROR" TO HL-MSG
    END-IF.
