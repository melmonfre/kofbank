IDENTIFICATION DIVISION.
PROGRAM-ID. BPXSLSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CYC-FILE ASSIGN TO WS-CYC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CY-CYCLE-ID OF CYC-REC
        FILE STATUS IS WS-CYC-ST.
    SELECT STL-FILE ASSIGN TO WS-STL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS SR-STL-ID OF STL-REC
        FILE STATUS IS WS-STL-ST.
    SELECT XST-FILE ASSIGN TO WS-XST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS XS-KEY OF XST-REC
        FILE STATUS IS WS-XST-ST.
    SELECT POS-FILE ASSIGN TO WS-POS-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PO-KEY OF POS-REC
        FILE STATUS IS WS-POS-ST.
    SELECT OBX-FILE ASSIGN TO WS-OBX-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS OX-KEY OF OBX-REC
        FILE STATUS IS WS-OBX-ST.

DATA DIVISION.
FILE SECTION.
FD CYC-FILE.
01 CYC-REC.
   COPY "BPXCY".
FD STL-FILE.
01 STL-REC.
   COPY "BPXSTLR".
FD XST-FILE.
01 XST-REC.
   05 XS-KEY.
      10 XS-SOURCE     PIC X(08).
      10 XS-SEP1       PIC X(01).
      10 XS-EXT-REF    PIC X(32).
   05 XS-STL-ID        PIC X(12).
   05 XS-CYCLE-ID      PIC X(20).
   05 XS-AMOUNT        PIC S9(15)V99 COMP-3.
   05 XS-STATUS        PIC X(16).
   05 XS-RESULT-REF    PIC X(32).
   05 XS-DATE          PIC 9(08).
   05 XS-TS            PIC 9(14).
FD POS-FILE.
01 POS-REC.
   COPY "BPXPO".
FD OBX-FILE.
01 OBX-REC.
   05 OX-KEY.
      10 OX-CYCLE-ID   PIC X(20).
      10 OX-PARTICIPANT PIC X(12).
      10 OX-SIDE       PIC X(10).
   05 OX-STL-ID        PIC X(12).

WORKING-STORAGE SECTION.
01 WS-HOME PIC X(80).
01 WS-CYC-PATH PIC X(200).
01 WS-STL-PATH PIC X(200).
01 WS-XST-PATH PIC X(200).
01 WS-POS-PATH PIC X(200).
01 WS-CYC-ST PIC X(02).
01 WS-STL-ST PIC X(02).
01 WS-XST-ST PIC X(02).
01 WS-POS-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-AMT-ED PIC -9999999999999.99.
01 WS-OBX-ST PIC X(02).
01 WS-OBX-PATH PIC X(200).
01 WS-N-PARTIES PIC 9(03).
01 WS-I PIC 9(03).
01 WS-FOUND PIC X(01).
01 WS-PARTY-TABLE.
   05 WS-PARTY-ID OCCURS 50 TIMES PIC X(12).

LINKAGE SECTION.
COPY "BPXSSO".
01 BK-PX-CY-REC.
   COPY "BPXCY".
01 BK-PX-ST-REC.
   COPY "BPXSTLR".
01 BK-PX-PO-REC.
   COPY "BPXPO".

PROCEDURE DIVISION USING BK-PX-SS-STO-REQ BK-PX-CY-REC
                         BK-PX-ST-REC BK-PX-PO-REC.
    MOVE "00" TO SS-RC
    MOVE SPACES TO SS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    PERFORM BUILD-PATHS
    EVALUATE SS-OP
        WHEN "CYC-WRITE" PERFORM DO-CYC-WRITE
        WHEN "CYC-UPDATE" PERFORM DO-CYC-UPDATE
        WHEN "CYC-GET" PERFORM DO-CYC-GET
        WHEN "STL-WRITE" PERFORM DO-STL-WRITE
        WHEN "STL-UPDATE" PERFORM DO-STL-UPDATE
        WHEN "STL-GET" PERFORM DO-STL-GET
        WHEN "XST-WRITE" PERFORM DO-XST-WRITE
        WHEN "XST-GET" PERFORM DO-XST-GET
        WHEN "XST-UPDATE" PERFORM DO-XST-UPDATE
        WHEN "POS-WRITE" PERFORM DO-POS-WRITE
        WHEN "POS-UPDATE" PERFORM DO-POS-UPDATE
        WHEN "POS-GET" PERFORM DO-POS-GET
        WHEN "STL-SUM" PERFORM DO-STL-SUM
        WHEN "STL-COUNT" PERFORM DO-STL-COUNT
        WHEN "CYC-LIST" PERFORM DO-CYC-LIST
        WHEN "OBL-WRITE" PERFORM DO-OBL-WRITE
        WHEN "OBL-GET" PERFORM DO-OBL-GET
        WHEN OTHER
            MOVE "99" TO SS-RC
            MOVE "UNKNOWN SLSTO OP" TO SS-MSG
    END-EVALUATE
    GOBACK.

BUILD-PATHS.
    MOVE SPACES TO WS-CYC-PATH WS-STL-PATH WS-XST-PATH WS-POS-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxcyc.idx"
        DELIMITED SIZE INTO WS-CYC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxstl.idx"
        DELIMITED SIZE INTO WS-STL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxstlx.idx"
        DELIMITED SIZE INTO WS-XST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxpos.idx"
        DELIMITED SIZE INTO WS-POS-PATH.
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxobx.idx"
        DELIMITED SIZE INTO WS-OBX-PATH.

DO-CYC-WRITE.
    PERFORM OPEN-CYC
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE BK-PX-CY-REC TO CYC-REC
    WRITE CYC-REC
        INVALID KEY
            MOVE "22" TO SS-RC
            MOVE "CYCLE ALREADY EXISTS" TO SS-MSG
    END-WRITE
    PERFORM CLOSE-CYC.

DO-CYC-UPDATE.
    PERFORM OPEN-CYC
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE BK-PX-CY-REC TO CYC-REC
    REWRITE CYC-REC
        INVALID KEY
            MOVE "23" TO SS-RC
            MOVE "CYCLE NOT FOUND" TO SS-MSG
    END-REWRITE
    PERFORM CLOSE-CYC.

DO-CYC-GET.
    PERFORM OPEN-CYC
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE SS-CYCLE-ID TO CY-CYCLE-ID OF CYC-REC
    READ CYC-FILE
    EVALUATE WS-CYC-ST
        WHEN "00" MOVE CYC-REC TO BK-PX-CY-REC
        WHEN "23"
            MOVE "23" TO SS-RC
            MOVE "CYCLE NOT FOUND" TO SS-MSG
        WHEN OTHER
            MOVE WS-CYC-ST TO SS-RC
            MOVE "CYCLE READ ERROR" TO SS-MSG
    END-EVALUATE
    PERFORM CLOSE-CYC.

DO-STL-WRITE.
    PERFORM OPEN-STL
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE BK-PX-ST-REC TO STL-REC
    WRITE STL-REC
        INVALID KEY
            MOVE "22" TO SS-RC
            MOVE "SETTLEMENT ALREADY EXISTS" TO SS-MSG
    END-WRITE
    PERFORM CLOSE-STL.

DO-STL-UPDATE.
    PERFORM OPEN-STL
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE BK-PX-ST-REC TO STL-REC
    REWRITE STL-REC
        INVALID KEY
            MOVE "23" TO SS-RC
            MOVE "SETTLEMENT NOT FOUND" TO SS-MSG
    END-REWRITE
    PERFORM CLOSE-STL.

DO-STL-GET.
    PERFORM OPEN-STL
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE SS-STL-ID TO SR-STL-ID OF STL-REC
    READ STL-FILE
    EVALUATE WS-STL-ST
        WHEN "00" MOVE STL-REC TO BK-PX-ST-REC
        WHEN "23"
            MOVE "23" TO SS-RC
            MOVE "SETTLEMENT NOT FOUND" TO SS-MSG
        WHEN OTHER
            MOVE WS-STL-ST TO SS-RC
            MOVE "SETTLEMENT READ ERROR" TO SS-MSG
    END-EVALUATE
    PERFORM CLOSE-STL.

DO-XST-WRITE.
    PERFORM OPEN-XST
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE "SPI" TO XS-SOURCE OF XST-REC
    MOVE "|" TO XS-SEP1 OF XST-REC
    MOVE SR-EXTERNAL-REF OF BK-PX-ST-REC TO XS-EXT-REF OF XST-REC
    MOVE SR-STL-ID OF BK-PX-ST-REC TO XS-STL-ID OF XST-REC
    MOVE SR-CYCLE-ID OF BK-PX-ST-REC TO XS-CYCLE-ID OF XST-REC
    MOVE SR-NET-AMT OF BK-PX-ST-REC TO XS-AMOUNT OF XST-REC
    MOVE SR-STATUS OF BK-PX-ST-REC TO XS-STATUS OF XST-REC
    MOVE SR-RESULT-REF OF BK-PX-ST-REC TO XS-RESULT-REF OF XST-REC
    MOVE SR-SETTLE-DATE OF BK-PX-ST-REC TO XS-DATE OF XST-REC
    MOVE SR-UPDATED OF BK-PX-ST-REC TO XS-TS OF XST-REC
    WRITE XST-REC
        INVALID KEY
            MOVE "22" TO SS-RC
            MOVE "SETTLEMENT EXT REF EXISTS" TO SS-MSG
    END-WRITE
    PERFORM CLOSE-XST.

DO-XST-UPDATE.
    PERFORM OPEN-XST
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE "SPI" TO XS-SOURCE OF XST-REC
    MOVE "|" TO XS-SEP1 OF XST-REC
    MOVE SR-EXTERNAL-REF OF BK-PX-ST-REC TO XS-EXT-REF OF XST-REC
    MOVE SR-STL-ID OF BK-PX-ST-REC TO XS-STL-ID OF XST-REC
    MOVE SR-CYCLE-ID OF BK-PX-ST-REC TO XS-CYCLE-ID OF XST-REC
    IF SR-SETTLED-AMT OF BK-PX-ST-REC NOT = 0
        MOVE SR-SETTLED-AMT OF BK-PX-ST-REC TO XS-AMOUNT OF XST-REC
    ELSE
        MOVE SR-NET-AMT OF BK-PX-ST-REC TO XS-AMOUNT OF XST-REC
    END-IF
    MOVE SR-STATUS OF BK-PX-ST-REC TO XS-STATUS OF XST-REC
    MOVE SR-RESULT-REF OF BK-PX-ST-REC TO XS-RESULT-REF OF XST-REC
    MOVE SR-SETTLE-DATE OF BK-PX-ST-REC TO XS-DATE OF XST-REC
    MOVE SR-UPDATED OF BK-PX-ST-REC TO XS-TS OF XST-REC
    REWRITE XST-REC
        INVALID KEY
            MOVE "23" TO SS-RC
            MOVE "SETTLEMENT EXT REF MISSING" TO SS-MSG
    END-REWRITE
    PERFORM CLOSE-XST.

DO-XST-GET.
    PERFORM OPEN-XST
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE "SPI" TO XS-SOURCE OF XST-REC
    MOVE "|" TO XS-SEP1 OF XST-REC
    MOVE SR-EXTERNAL-REF OF BK-PX-ST-REC TO XS-EXT-REF OF XST-REC
    READ XST-FILE
    EVALUATE WS-XST-ST
        WHEN "00"
            MOVE XS-STL-ID OF XST-REC TO SR-STL-ID OF BK-PX-ST-REC
            MOVE XS-CYCLE-ID OF XST-REC TO SR-CYCLE-ID OF BK-PX-ST-REC
            MOVE XS-AMOUNT OF XST-REC TO SR-NET-AMT OF BK-PX-ST-REC
            MOVE XS-STATUS OF XST-REC TO SR-STATUS OF BK-PX-ST-REC
            MOVE XS-RESULT-REF OF XST-REC TO SR-RESULT-REF OF BK-PX-ST-REC
        WHEN "23"
            MOVE "23" TO SS-RC
            MOVE "SETTLEMENT EXT REF NOT FOUND" TO SS-MSG
        WHEN OTHER
            MOVE WS-XST-ST TO SS-RC
            MOVE "SETTLEMENT EXT REF READ ERROR" TO SS-MSG
    END-EVALUATE
    PERFORM CLOSE-XST.

DO-POS-WRITE.
    PERFORM OPEN-POS
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE BK-PX-PO-REC TO POS-REC
    WRITE POS-REC
        INVALID KEY
            MOVE "22" TO SS-RC
            MOVE "POSITION ALREADY EXISTS" TO SS-MSG
    END-WRITE
    PERFORM CLOSE-POS.

DO-POS-UPDATE.
    PERFORM OPEN-POS
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE BK-PX-PO-REC TO POS-REC
    REWRITE POS-REC
        INVALID KEY
            MOVE "23" TO SS-RC
            MOVE "POSITION NOT FOUND" TO SS-MSG
    END-REWRITE
    PERFORM CLOSE-POS.

DO-POS-GET.
    PERFORM OPEN-POS
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE SS-POS-KEY TO PO-KEY OF POS-REC
    READ POS-FILE
    EVALUATE WS-POS-ST
        WHEN "00" MOVE POS-REC TO BK-PX-PO-REC
        WHEN "23"
            MOVE "23" TO SS-RC
            MOVE "POSITION NOT FOUND" TO SS-MSG
        WHEN OTHER
            MOVE WS-POS-ST TO SS-RC
            MOVE "POSITION READ ERROR" TO SS-MSG
    END-EVALUATE
    PERFORM CLOSE-POS.

OPEN-CYC.
    OPEN I-O CYC-FILE
    IF WS-CYC-ST = "35"
        OPEN OUTPUT CYC-FILE
        CLOSE CYC-FILE
        OPEN I-O CYC-FILE
    END-IF
    IF WS-CYC-ST NOT = "00"
        MOVE WS-CYC-ST TO SS-RC
        MOVE "CYCLE STORE OPEN ERROR" TO SS-MSG
    END-IF.

CLOSE-CYC.
    CLOSE CYC-FILE.

OPEN-STL.
    OPEN I-O STL-FILE
    IF WS-STL-ST = "35"
        OPEN OUTPUT STL-FILE
        CLOSE STL-FILE
        OPEN I-O STL-FILE
    END-IF
    IF WS-STL-ST NOT = "00"
        MOVE WS-STL-ST TO SS-RC
        MOVE "SETTLEMENT STORE OPEN ERROR" TO SS-MSG
    END-IF.

CLOSE-STL.
    CLOSE STL-FILE.

OPEN-XST.
    OPEN I-O XST-FILE
    IF WS-XST-ST = "35"
        OPEN OUTPUT XST-FILE
        CLOSE XST-FILE
        OPEN I-O XST-FILE
    END-IF
    IF WS-XST-ST NOT = "00"
        MOVE WS-XST-ST TO SS-RC
        MOVE "SETTLEMENT XREF OPEN ERROR" TO SS-MSG
    END-IF.

CLOSE-XST.
    CLOSE XST-FILE.

OPEN-POS.
    OPEN I-O POS-FILE
    IF WS-POS-ST = "35"
        OPEN OUTPUT POS-FILE
        CLOSE POS-FILE
        OPEN I-O POS-FILE
    END-IF
    IF WS-POS-ST NOT = "00"
        MOVE WS-POS-ST TO SS-RC
        MOVE "POSITION STORE OPEN ERROR" TO SS-MSG
    END-IF.

CLOSE-POS.
    CLOSE POS-FILE.

DO-OBL-WRITE.
    PERFORM OPEN-OBX
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE SS-XREF-CYCLE TO OX-CYCLE-ID OF OBX-REC
    MOVE SS-XREF-PART TO OX-PARTICIPANT OF OBX-REC
    MOVE SS-XREF-SIDE TO OX-SIDE OF OBX-REC
    MOVE SS-STL-ID TO OX-STL-ID OF OBX-REC
    WRITE OBX-REC
        INVALID KEY
            MOVE "22" TO SS-RC
            MOVE "OBLIGATION LINK EXISTS" TO SS-MSG
    END-WRITE
    PERFORM CLOSE-OBX.

DO-OBL-GET.
    PERFORM OPEN-OBX
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE SS-XREF-CYCLE TO OX-CYCLE-ID OF OBX-REC
    MOVE SS-XREF-PART TO OX-PARTICIPANT OF OBX-REC
    MOVE SS-XREF-SIDE TO OX-SIDE OF OBX-REC
    READ OBX-FILE
    EVALUATE WS-OBX-ST
        WHEN "00"
            MOVE OX-STL-ID OF OBX-REC TO SS-STL-ID
        WHEN "23"
            MOVE "23" TO SS-RC
            MOVE "OBLIGATION LINK NOT FOUND" TO SS-MSG
        WHEN OTHER
            MOVE WS-OBX-ST TO SS-RC
            MOVE "OBLIGATION LINK READ ERROR" TO SS-MSG
    END-EVALUATE
    PERFORM CLOSE-OBX.

OPEN-OBX.
    OPEN I-O OBX-FILE
    IF WS-OBX-ST = "35"
        OPEN OUTPUT OBX-FILE
        CLOSE OBX-FILE
        OPEN I-O OBX-FILE
    END-IF
    IF WS-OBX-ST NOT = "00"
        MOVE WS-OBX-ST TO SS-RC
        MOVE "OBLIGATION XREF OPEN ERROR" TO SS-MSG
    END-IF.

CLOSE-OBX.
    CLOSE OBX-FILE.

DO-STL-SUM.
    MOVE "00" TO SS-RC
    MOVE 0 TO SS-GROSS-PAY SS-GROSS-RCV SS-ADJ-AMT SS-NET-AMT
    MOVE 0 TO SS-PARTY-COUNT SS-OBL-PAY SS-OBL-RCV SS-ITEM-COUNT
    MOVE "N" TO SS-ANY
    MOVE 0 TO WS-N-PARTIES
    PERFORM OPEN-STL
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ STL-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM SUM-ROW
        END-READ
    END-PERFORM
    PERFORM CLOSE-STL
    COMPUTE SS-NET-AMT = SS-GROSS-RCV - SS-GROSS-PAY
    IF SS-ANY = "Y"
        MOVE "00" TO SS-RC
    ELSE
        MOVE "23" TO SS-RC
        MOVE "NO OBLIGATIONS IN CYCLE" TO SS-MSG
    END-IF.

SUM-ROW.
    IF SR-CYCLE-ID OF STL-REC NOT = SS-CYCLE-ID
        EXIT PARAGRAPH
    END-IF
    IF SR-STATUS OF STL-REC = "CANCELLED"
        EXIT PARAGRAPH
    END-IF
    MOVE "Y" TO SS-ANY
    PERFORM COUNT-DISTINCT-PARTY
    ADD SR-ITEM-COUNT OF STL-REC TO SS-ITEM-COUNT
    ADD SR-ADJ-AMT OF STL-REC TO SS-ADJ-AMT
    IF SR-SIDE OF STL-REC = "PAYABLE"
        ADD SR-NET-AMT OF STL-REC TO SS-GROSS-PAY
        ADD 1 TO SS-OBL-PAY
    ELSE
        ADD SR-NET-AMT OF STL-REC TO SS-GROSS-RCV
        ADD 1 TO SS-OBL-RCV
    END-IF.

DO-CYC-LIST.
    MOVE 0 TO SS-PARTY-COUNT
    MOVE "N" TO WS-EOF
    PERFORM OPEN-CYC
    IF SS-RC NOT = "00"
        IF SS-RC = "35"
            MOVE "00" TO SS-RC
            DISPLAY "rc=00"
            DISPLAY "cycles=0"
            MOVE "00" TO SS-RC
        END-IF
        EXIT PARAGRAPH
    END-IF
    PERFORM UNTIL WS-EOF = "Y"
        READ CYC-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM SHOW-CYC-ROW
        END-READ
    END-PERFORM
    PERFORM CLOSE-CYC
    DISPLAY "rc=00"
    DISPLAY "cycles=" SS-PARTY-COUNT.

SHOW-CYC-ROW.
    ADD 1 TO SS-PARTY-COUNT
    MOVE CY-NET-AMT OF CYC-REC TO WS-AMT-ED
    DISPLAY "cycle=" FUNCTION TRIM(CY-CYCLE-ID OF CYC-REC)
    DISPLAY "bizdate=" CY-BIZDATE OF CYC-REC
    DISPLAY "settledate=" CY-SETTLE-DATE OF CYC-REC
    DISPLAY "status=" FUNCTION TRIM(CY-STATUS OF CYC-REC)
    DISPLAY "currency=" CY-CURRENCY OF CYC-REC
    DISPLAY "gross-pay=" WS-AMT-ED
    MOVE CY-GROSS-RCV OF CYC-REC TO WS-AMT-ED
    DISPLAY "gross-rcv=" WS-AMT-ED
    MOVE CY-NET-AMT OF CYC-REC TO WS-AMT-ED
    DISPLAY "net=" WS-AMT-ED
    DISPLAY "side=" FUNCTION TRIM(CY-NET-SIDE OF CYC-REC)
    DISPLAY "settlement=" FUNCTION TRIM(CY-SETTLE-ID OF CYC-REC)
    DISPLAY "recon=" FUNCTION TRIM(CY-RECON-STATUS OF CYC-REC).

COUNT-DISTINCT-PARTY.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-PARTIES
        IF WS-PARTY-ID(WS-I) = SR-PARTICIPANT OF STL-REC
            MOVE "Y" TO WS-FOUND
            EXIT PERFORM
        END-IF
    END-PERFORM
    IF WS-FOUND = "N"
        ADD 1 TO SS-PARTY-COUNT
        IF WS-N-PARTIES < 50
            ADD 1 TO WS-N-PARTIES
            MOVE SR-PARTICIPANT OF STL-REC TO WS-PARTY-ID(WS-N-PARTIES)
        END-IF
    END-IF.

DO-STL-COUNT.
    MOVE "00" TO SS-RC
    MOVE 0 TO SS-C-PENDING SS-C-SUBMITTED SS-C-UNKNOWN
        SS-C-SETTLED SS-C-REJECTED SS-C-RECON SS-PARTY-COUNT
    MOVE 0 TO SS-SETTLED-AMT SS-NET-AMT
    PERFORM OPEN-STL
    IF SS-RC NOT = "00" EXIT PARAGRAPH END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ STL-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM COUNT-ROW
        END-READ
    END-PERFORM
    PERFORM CLOSE-STL.

COUNT-ROW.
    IF SR-CYCLE-ID OF STL-REC NOT = SS-CYCLE-ID
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO SS-PARTY-COUNT
    ADD SR-NET-AMT OF STL-REC TO SS-NET-AMT
    EVALUATE SR-STATUS OF STL-REC
        WHEN "PENDING" ADD 1 TO SS-C-PENDING
        WHEN "SUBMIT-FAILED" ADD 1 TO SS-C-PENDING
        WHEN "SUBMITTED" ADD 1 TO SS-C-SUBMITTED
        WHEN "UNKNOWN" ADD 1 TO SS-C-UNKNOWN
        WHEN "SETTLED"
            ADD 1 TO SS-C-SETTLED
            ADD SR-SETTLED-AMT OF STL-REC TO SS-SETTLED-AMT
        WHEN "RECONCILED"
            ADD 1 TO SS-C-SETTLED
            ADD 1 TO SS-C-RECON
            ADD SR-SETTLED-AMT OF STL-REC TO SS-SETTLED-AMT
        WHEN "REJECTED" ADD 1 TO SS-C-REJECTED
        WHEN "EXCEPTION" ADD 1 TO SS-C-REJECTED
        WHEN OTHER CONTINUE
    END-EVALUATE.
