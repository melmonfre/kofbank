IDENTIFICATION DIVISION.
PROGRAM-ID. BPXRTSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RT-FILE ASSIGN TO WS-RT-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PP-ID OF RT-REC
        FILE STATUS IS WS-RT-ST.
    SELECT ISPB-FILE ASSIGN TO WS-ISPB-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PI-ISPB OF ISPB-REC
        FILE STATUS IS WS-ISP-ST.

DATA DIVISION.
FILE SECTION.
FD RT-FILE.
01 RT-REC.
   COPY "BPXP".
FD ISPB-FILE.
01 ISPB-REC.
   05 PI-ISPB          PIC X(08).
   05 PI-PART-ID       PIC X(12).

WORKING-STORAGE SECTION.
01 WS-RT-PATH PIC X(200).
01 WS-ISPB-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-RT-ST PIC X(02).
01 WS-ISP-ST PIC X(02).

LINKAGE SECTION.
COPY "BPXSTS".
01 BK-PX-PART.
   COPY "BPXP".

PROCEDURE DIVISION USING BK-PX-RT-STO-REQ BK-PX-PART.
    MOVE "00" TO PT-RC
    MOVE SPACES TO PT-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-RT-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxpart.idx"
        DELIMITED SIZE INTO WS-RT-PATH
    MOVE SPACES TO WS-ISPB-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxpartp.idx"
        DELIMITED SIZE INTO WS-ISPB-PATH
    EVALUATE PT-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN "GET-ISPB" PERFORM DO-GET-ISPB
        WHEN OTHER
            MOVE "99" TO PT-RC
            MOVE "UNKNOWN PARTICIPANT STO OP" TO PT-MSG
    END-EVALUATE
    GOBACK.

DO-WRITE.
    PERFORM OPEN-RT
    IF PT-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-PART TO RT-REC
    WRITE RT-REC
        INVALID KEY
            MOVE "22" TO PT-RC
            MOVE "PARTICIPANT ALREADY EXISTS" TO PT-MSG
    END-WRITE
    IF PT-RC = "00"
        MOVE PP-ISPB OF BK-PX-PART TO PI-ISPB
        MOVE PP-ID OF BK-PX-PART TO PI-PART-ID
        PERFORM OPEN-ISPB
        WRITE ISPB-REC
            INVALID KEY
                MOVE "22" TO PT-RC
                MOVE "PARTICIPANT ISPB ALREADY EXISTS" TO PT-MSG
        END-WRITE
        CLOSE ISPB-FILE
    END-IF
    PERFORM CLOSE-RT.

DO-REWRITE.
    PERFORM OPEN-RT
    IF PT-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-PART TO RT-REC
    REWRITE RT-REC
        INVALID KEY
            MOVE "23" TO PT-RC
            MOVE "PARTICIPANT MISSING" TO PT-MSG
    END-REWRITE
    PERFORM CLOSE-RT.

DO-GET.
    PERFORM OPEN-RT
    IF PT-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE PP-ID OF BK-PX-PART TO PP-ID OF RT-REC
    READ RT-FILE
    EVALUATE WS-RT-ST
        WHEN "00" MOVE RT-REC TO BK-PX-PART
        WHEN "23"
            MOVE "23" TO PT-RC
            MOVE "PARTICIPANT NOT FOUND" TO PT-MSG
        WHEN OTHER
            MOVE WS-RT-ST TO PT-RC
            MOVE "PARTICIPANT STORE ERROR" TO PT-MSG
    END-EVALUATE
    PERFORM CLOSE-RT.

DO-GET-ISPB.
    PERFORM OPEN-ISPB
    MOVE PP-ISPB OF BK-PX-PART TO PI-ISPB
    READ ISPB-FILE
    EVALUATE WS-ISP-ST
        WHEN "00"
            MOVE PI-PART-ID TO PP-ID OF BK-PX-PART
        WHEN "23"
            MOVE "23" TO PT-RC
            MOVE "PARTICIPANT ISPB NOT FOUND" TO PT-MSG
        WHEN OTHER
            MOVE WS-ISP-ST TO PT-RC
            MOVE "PARTICIPANT ISPB STORE ERROR" TO PT-MSG
    END-EVALUATE
    CLOSE ISPB-FILE.

OPEN-RT.
    OPEN I-O RT-FILE
    IF WS-RT-ST = "35"
        OPEN OUTPUT RT-FILE
        CLOSE RT-FILE
        OPEN I-O RT-FILE
    END-IF
    IF WS-RT-ST NOT = "00"
        MOVE WS-RT-ST TO PT-RC
        MOVE "PARTICIPANT STORE OPEN ERROR" TO PT-MSG
    END-IF.

CLOSE-RT.
    CLOSE RT-FILE.

OPEN-ISPB.
    OPEN I-O ISPB-FILE
    IF WS-ISP-ST = "35"
        OPEN OUTPUT ISPB-FILE
        CLOSE ISPB-FILE
        OPEN I-O ISPB-FILE
    END-IF
    IF WS-ISP-ST NOT = "00"
        MOVE WS-ISP-ST TO PT-RC
    END-IF.
