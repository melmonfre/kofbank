IDENTIFICATION DIVISION.
PROGRAM-ID. BPXSTL.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT STL-FILE ASSIGN TO WS-STL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS SR-STL-ID OF STL-REC
        FILE STATUS IS WS-STL-ST.
    SELECT POS-FILE ASSIGN TO WS-POS-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PO-KEY OF POS-REC
        FILE STATUS IS WS-POS-ST.
    SELECT PX-FILE ASSIGN TO WS-PX-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PX-ID OF PX-REC
        FILE STATUS IS WS-PX-ST.
    SELECT EXT-FILE ASSIGN TO WS-EXT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-EXT-ST.

DATA DIVISION.
FILE SECTION.
FD STL-FILE.
01 STL-REC.
   COPY "BPXSTLR".
FD POS-FILE.
01 POS-REC.
   COPY "BPXPO".
FD PX-FILE.
01 PX-REC.
   COPY "BPX".
FD EXT-FILE.
01 EXT-LINE PIC X(200).

WORKING-STORAGE SECTION.
   COPY "BPXCFG".
   COPY "BDATP".
   COPY "BPXSSO".
   COPY "BKIDMP".
   COPY "BKAUDP".
   COPY "BKEVTP".
   COPY "BPXSP".
   COPY "BKJRNP".
   COPY "BKPSTT".
   COPY "BPXSTO".
01 WS-CYCLE-REC.
   COPY "BPXCY".
01 WS-POS-REC.
   COPY "BPXPO".
01 WS-POS-PROBE.
   COPY "BPXPO".
01 WS-SLOT PIC S9(03) VALUE 0.
01 WS-SUBMIT-REQUEST PIC X(24).
01 WS-ADJ-RC PIC X(02).
01 WS-OBL-TOTAL PIC 9(07).
01 WS-CYC-LOCK-NAME PIC X(30).
01 WS-STL-LOCK-NAME PIC X(30).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).
01 WS-STL-PATH PIC X(200).
01 WS-EXT-PATH PIC X(200).
01 WS-STL-ST PIC X(02).
01 WS-PX-PATH PIC X(200).
01 WS-PX-ST PIC X(02).
01 WS-CY-STATUS PIC X(16).
01 WS-ID-TYPE PIC X(08).
01 WS-ID-ISPB PIC X(08).
01 WS-ID-VAL PIC X(32).
01 WS-ID-RC PIC X(02).
01 WS-EXT-ST PIC X(02).
01 WS-POS-PATH PIC X(200).
01 WS-POS-ST PIC X(02).
01 WS-NOW PIC 9(14).
01 WS-LOCK-NAME PIC X(24).
01 WS-LOCK-OWNER PIC X(16).
01 WS-LOCK-MODE PIC X(01).
01 WS-LOCK-ST PIC X(02).
01 WS-OPNAME PIC X(12).
01 WS-EOF PIC X(01).
01 WS-EXIST PIC X(01).
01 WS-CUR-STATUS PIC X(16).
01 WS-EVT PIC X(20).
01 WS-NXT PIC X(16).
01 WS-STM-RC PIC X(02).
01 WS-STM-MSG PIC X(80).
01 WS-NET PIC S9(15)V99 COMP-3.
01 WS-BEFORE-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT-ED PIC -(15)9.99.
01 WS-AFTER PIC X(120).
01 WS-ROWS PIC 9(07).
01 WS-ROW-FAIL PIC 9(07).
01 WS-RESULT PIC X(12).
01 WS-EXT-REF PIC X(32).
01 WS-ROW-REF PIC X(32).
01 WS-ROW-STATUS PIC X(16).
01 WS-ROW-AMT-STR PIC X(30).
01 WS-ROW-CUR PIC X(03).
01 WS-ROW-REASON PIC X(40).
01 WS-FLAG PIC X(01).
01 WS-I PIC 9(02).
01 WS-K PIC 9(03).
01 WS-KEYS PIC 9(03).
01 WS-POS-TABLE.
   05 WS-PT OCCURS 50 TIMES.
      10 WS-PT-PART   PIC X(12).
      10 WS-PT-CUR    PIC X(03).
      10 WS-PT-PAY    PIC S9(15)V99 COMP-3.
      10 WS-PT-RCV    PIC S9(15)V99 COMP-3.
      10 WS-PT-SPENT  PIC S9(15)V99 COMP-3.
      10 WS-PT-RECV   PIC S9(15)V99 COMP-3.
      10 WS-PT-ADJ    PIC S9(15)V99 COMP-3.
      10 WS-PT-PENDN  PIC 9(07).
      10 WS-PT-SETTN  PIC 9(07).
      10 WS-PT-LAST   PIC 9(08).

LINKAGE SECTION.
   COPY "BPXSLP".

PROCEDURE DIVISION USING BK-PX-STL-PARMS.
    MOVE "00" TO SL-RC
    MOVE SPACES TO SL-MSG
    MOVE "N" TO SL-REPLAY
    MOVE SL-OPERATOR TO WS-LOCK-OWNER
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE "20" TO SL-RC
        MOVE "BUSINESS DATE UNAVAILABLE" TO SL-MSG
        GOBACK
    END-IF
    CALL "BPXCFG" USING BK-PX-CFG
    IF PC-STATUS NOT = "00"
        MOVE "20" TO SL-RC
        MOVE "PIX CONFIG MISSING" TO SL-MSG
        GOBACK
    END-IF
    IF PC-STL-ACCT = SPACES
        MOVE "7000" TO PC-STL-ACCT
    END-IF
    IF PC-STL-CASH = SPACES
        MOVE "1000" TO PC-STL-CASH
    END-IF
    EVALUATE FUNCTION TRIM(SL-OP)
        WHEN "STL-CREATE" PERFORM DO-STL-CREATE
        WHEN "STL-SUBMIT" PERFORM DO-STL-SUBMIT
        WHEN "STL-RESULT" PERFORM DO-STL-RESULT
        WHEN "STL-RESULT-FILE" PERFORM DO-STL-RESULT-FILE
        WHEN "STL-QUERY" PERFORM DO-STL-QUERY
        WHEN "STL-ADJUST" PERFORM DO-STL-ADJUST
        WHEN "STL-POST" PERFORM DO-STL-POST
        WHEN "STL-GET" PERFORM DO-STL-GET
        WHEN "STL-LIST" PERFORM DO-STL-LIST
        WHEN "CYCLE-SUBMIT" PERFORM DO-CYCLE-SUBMIT
        WHEN "CYCLE-FINALIZE" PERFORM DO-CYCLE-FINALIZE
        WHEN "POSITION-GET" PERFORM DO-POSITION-GET
        WHEN "POSITION-REBUILD" PERFORM DO-POSITION-REBUILD
        WHEN "POSITION-LIST" PERFORM DO-POSITION-LIST
        WHEN OTHER
            MOVE "99" TO SL-RC
            MOVE "UNKNOWN PIX SETTLEMENT OP" TO SL-MSG
    END-EVALUATE
    GOBACK.

BUILD-PATHS.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-STL-PATH WS-EXT-PATH WS-PX-PATH WS-POS-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxstl.idx" DELIMITED
        SIZE INTO WS-STL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxpix.idx" DELIMITED
        SIZE INTO WS-PX-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxpos.idx" DELIMITED
        SIZE INTO WS-POS-PATH.

DO-STL-CREATE.
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00" GOBACK END-IF
    PERFORM STL-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM FIND-OBLIGATION
    IF SL-RC = "00" AND WS-EXIST = "N"
        PERFORM WRITE-OBLIGATION
    END-IF
    IF SL-RC = "00"
        PERFORM READ-OBLIGATION
    END-IF
    IF SL-RC = "00"
        PERFORM EXPOSE-OBLIGATION
        PERFORM REBUILD-POSITION
    END-IF
    PERFORM STL-UNLOCK
    PERFORM END-REQUEST.

FIND-OBLIGATION.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "OBL-GET" TO SS-OP
    MOVE SL-CYCLE-ID TO SS-XREF-CYCLE
    MOVE SL-PARTICIPANT TO SS-XREF-PART
    MOVE SL-SIDE TO SS-XREF-SIDE
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    MOVE "N" TO WS-EXIST
    MOVE "00" TO SL-RC
    IF SS-RC = "00"
        MOVE "Y" TO WS-EXIST
        MOVE SS-STL-ID TO SL-STL-ID
        MOVE "Y" TO SL-REPLAY
        MOVE "SETTLEMENT REPLAYED" TO SL-MSG
    ELSE
        IF SS-RC NOT = "23"
            MOVE SS-RC TO SL-RC
            MOVE SS-MSG TO SL-MSG
        ELSE
            MOVE "00" TO SL-RC
        END-IF
    END-IF.

WRITE-OBLIGATION.
    MOVE SPACES TO SL-STL-ID
    MOVE "STL" TO WS-ID-TYPE
    MOVE PC-E2E-ISPB TO WS-ID-ISPB
    CALL "BPXID" USING WS-ID-TYPE WS-ID-ISPB WS-ID-VAL WS-ID-RC
    MOVE WS-ID-VAL(1:12) TO SL-STL-ID
    IF WS-ID-RC NOT = "00"
        MOVE "20" TO SL-RC
        MOVE "SETTLEMENT ID ERROR" TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM FILL-OBLIGATION
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "STL-WRITE" TO SS-OP
    MOVE SL-STL-ID TO SS-STL-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    IF SS-RC NOT = "00" AND SS-RC NOT = "22"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "OBL-WRITE" TO SS-OP
    MOVE SL-CYCLE-ID TO SS-XREF-CYCLE
    MOVE SL-PARTICIPANT TO SS-XREF-PART
    MOVE SL-SIDE TO SS-XREF-SIDE
    MOVE SL-STL-ID TO SS-STL-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    IF SS-RC NOT = "00" AND SS-RC NOT = "22"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "00" TO SL-RC
    MOVE "SETTLEMENT OBLIGATION CREATED" TO SL-MSG
    PERFORM EMIT-STL.

FILL-OBLIGATION.
    MOVE SPACES TO STL-REC
    MOVE SL-STL-ID TO SR-STL-ID
    MOVE SL-CYCLE-ID TO SR-CYCLE-ID
    MOVE SL-PARTICIPANT TO SR-PARTICIPANT
    MOVE SL-BATCH TO SR-BATCH
    MOVE SL-SIDE TO SR-SIDE
    IF SL-CURRENCY = SPACES
        MOVE PC-CURRENCY TO SR-CURRENCY
    ELSE
        MOVE SL-CURRENCY TO SR-CURRENCY
    END-IF
    PERFORM CYCLE-FETCH
    IF SR-BATCH = SPACES
        MOVE SR-STL-ID TO SR-BATCH
    END-IF
    MOVE SL-BIZDATE TO SR-BIZDATE
    MOVE CY-SETTLE-DATE OF WS-CYCLE-REC TO SR-SETTLE-DATE
    MOVE "PENDING" TO SR-STATUS
    MOVE "NONE" TO SR-POST-STATUS
    MOVE "PENDING" TO SR-RECON-STATUS
    MOVE SL-GROSS-AMT TO SR-GROSS-AMT
    MOVE SL-FEE-AMT TO SR-FEE-AMT
    MOVE 0 TO SR-ADJ-AMT
    COMPUTE SR-NET-AMT = SL-GROSS-AMT - SL-FEE-AMT
    MOVE SL-ITEM-COUNT TO SR-ITEM-COUNT
    MOVE 0 TO SR-ATTEMPTS SR-SETTLED-AMT
    MOVE 1 TO SR-VERSION
    MOVE SL-OPERATOR TO SR-OPERATOR
    MOVE SL-CORR TO SR-CORR
    MOVE SL-REASON TO SR-REASON
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW TO SR-CREATED SR-UPDATED
    MOVE 0 TO SR-SETTLED SR-RECONCILED
    MOVE SPACES TO SR-EXTERNAL-REF SR-RESULT-REF SR-JRN-ID.

CYCLE-FETCH.
    IF SL-CYCLE-ID = SPACES
        MOVE 0 TO CY-SETTLE-DATE OF WS-CYCLE-REC
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "CYC-GET" TO SS-OP
    MOVE SL-CYCLE-ID TO SS-CYCLE-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    IF SS-RC NOT = "00"
        MOVE 0 TO CY-SETTLE-DATE OF WS-CYCLE-REC
        MOVE "00" TO SS-RC
    END-IF
    MOVE "00" TO SL-RC.

READ-OBLIGATION.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "STL-GET" TO SS-OP
    MOVE SL-STL-ID TO SS-STL-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    MOVE SS-RC TO SL-RC
    IF SS-RC NOT = "00"
        MOVE SS-MSG TO SL-MSG
    END-IF.

WRITE-STORE-OBLIGATION.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW TO SR-UPDATED
    ADD 1 TO SR-VERSION
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "STL-UPDATE" TO SS-OP
    MOVE SR-STL-ID TO SS-STL-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    IF SS-RC NOT = "00"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
    END-IF.

EXPOSE-OBLIGATION.
    MOVE SR-STL-ID TO SL-STL-ID
    MOVE SR-CYCLE-ID TO SL-CYCLE-ID
    MOVE SR-PARTICIPANT TO SL-PARTICIPANT
    MOVE SR-BATCH TO SL-BATCH
    MOVE SR-BIZDATE TO SL-BIZDATE
    MOVE SR-SETTLE-DATE TO SL-SETTLE-DATE
    MOVE SR-CURRENCY TO SL-CURRENCY
    MOVE SR-SIDE TO SL-SIDE
    MOVE SR-GROSS-AMT TO SL-GROSS-AMT
    MOVE SR-ADJ-AMT TO SL-ADJ-AMT
    MOVE SR-FEE-AMT TO SL-FEE-AMT
    MOVE SR-NET-AMT TO SL-NET-AMT
    MOVE SR-SETTLED-AMT TO SL-SETTLED-AMT
    MOVE SR-STATUS TO SL-STL-STATUS
    MOVE SR-EXTERNAL-REF TO SL-EXTERNAL-REF
    MOVE SR-RESULT-REF TO SL-RESULT-REF
    MOVE SR-POST-STATUS TO SL-POST-STATUS
    MOVE SR-RECON-STATUS TO SL-RECON-STATUS
    MOVE SR-JRN-ID TO SL-JRN-ID
    MOVE SR-ITEM-COUNT TO SL-ITEM-COUNT
    MOVE SR-ATTEMPTS TO SL-ATTEMPTS.

DO-STL-SUBMIT.
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00" GOBACK END-IF
    PERFORM STL-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM READ-OBLIGATION
    IF SL-RC = "00"
        IF SR-STATUS NOT = "PENDING" AND
           SR-STATUS NOT = "SUBMIT-FAILED"
            MOVE "Y" TO SL-REPLAY
            MOVE "SETTLEMENT NOT SUBMITTABLE" TO SL-MSG
            PERFORM EXPOSE-OBLIGATION
            PERFORM STL-UNLOCK
            PERFORM END-REQUEST
            GOBACK
        END-IF
        PERFORM SPI-SUBMIT
        PERFORM APPLY-OUTCOME
        IF SL-RC = "00"
            PERFORM WRITE-STORE-OBLIGATION
        END-IF
        IF SL-RC = "00"
            PERFORM EXPOSE-OBLIGATION
            PERFORM EMIT-STL
        END-IF
    END-IF
    PERFORM STL-UNLOCK
    PERFORM END-REQUEST.

SPI-SUBMIT.
    MOVE SPACES TO BK-PX-SPI-PARMS
    MOVE PC-ADAPTER TO SI-ADAPTER
    MOVE "STL-SUBMIT" TO SI-OP
    MOVE SR-STL-ID TO SI-E2E-ID
    MOVE SR-NET-AMT TO SI-AMOUNT
    MOVE SR-CURRENCY TO SI-CURRENCY
    IF SR-SIDE = "PAYABLE"
        MOVE PC-SELF TO SI-PAYER-PART
        MOVE SR-PARTICIPANT TO SI-PAYEE-PART
    ELSE
        MOVE SR-PARTICIPANT TO SI-PAYER-PART
        MOVE PC-SELF TO SI-PAYEE-PART
    END-IF
    IF SL-SIM NOT = SPACES
        MOVE SL-SIM TO SI-SIM
    ELSE
        MOVE PC-SIMULATE TO SI-SIM
    END-IF
    CALL "BPXSPI" USING BK-PX-SPI-PARMS
    MOVE FUNCTION TRIM(SI-RESULT) TO WS-RESULT
    MOVE SI-EXT-REF TO WS-EXT-REF.

APPLY-OUTCOME.
    MOVE SR-STATUS TO WS-CUR-STATUS
    EVALUATE FUNCTION TRIM(WS-RESULT)
        WHEN "ACCEPTED"
            MOVE "SUBMIT" TO WS-EVT
        WHEN "SUBMITTED"
            MOVE "SUBMIT" TO WS-EVT
        WHEN "SETTLED"
            MOVE "SETTLE" TO WS-EVT
        WHEN "TIMEOUT"
            MOVE "UNKNOWN" TO WS-EVT
        WHEN "UNKNOWN"
            MOVE "UNKNOWN" TO WS-EVT
        WHEN "REJECTED"
            MOVE "SUBMIT-FAIL" TO WS-EVT
        WHEN "FAILED"
            MOVE "SUBMIT-FAIL" TO WS-EVT
        WHEN OTHER
            MOVE "UNKNOWN" TO WS-EVT
    END-EVALUATE
    CALL "BPXSRM" USING WS-CUR-STATUS WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC NOT = "00"
        MOVE WS-STM-RC TO SL-RC
        MOVE WS-STM-MSG TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NXT TO SR-STATUS
    ADD 1 TO SR-ATTEMPTS
    IF WS-EXT-REF NOT = SPACES
        MOVE WS-EXT-REF TO SR-EXTERNAL-REF
        PERFORM LINK-EXTERNAL
    END-IF
    IF SR-STATUS = "SETTLED"
        IF SI-AMOUNT NOT = 0
            MOVE SI-AMOUNT TO SR-SETTLED-AMT
        ELSE
            MOVE SR-NET-AMT TO SR-SETTLED-AMT
        END-IF
        MOVE FUNCTION CURRENT-DATE TO WS-NOW
        MOVE WS-NOW TO SR-SETTLED
    END-IF.

LINK-EXTERNAL.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "XST-WRITE" TO SS-OP
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    IF SS-RC = "22"
        MOVE SPACES TO BK-PX-SS-STO-REQ
        MOVE "XST-UPDATE" TO SS-OP
        CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
            STL-REC WS-POS-REC
    END-IF
    IF SS-RC NOT = "00"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
    ELSE
        MOVE "00" TO SL-RC
    END-IF.

DO-STL-RESULT.
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00" GOBACK END-IF
    IF SL-STL-ID = SPACES
        PERFORM RESOLVE-BY-EXTERNAL
        IF SL-RC NOT = "00"
            PERFORM END-REQUEST
            GOBACK
        END-IF
    END-IF
    PERFORM STL-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM READ-OBLIGATION
    IF SL-RC = "00"
        PERFORM CLASSIFY-RESULT
        IF SL-RC = "00"
            PERFORM APPLY-RESULT
        END-IF
        IF SL-RC = "00"
            PERFORM WRITE-STORE-OBLIGATION
        END-IF
        IF SL-RC = "00"
            PERFORM EXPOSE-OBLIGATION
            PERFORM REBUILD-POSITION
            PERFORM EMIT-STL
            MOVE "SETTLEMENT RESULT APPLIED" TO SL-MSG
        END-IF
    END-IF
    PERFORM STL-UNLOCK
    PERFORM END-REQUEST.

RESOLVE-BY-EXTERNAL.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "XST-GET" TO SS-OP
    MOVE SL-EXTERNAL-REF TO SR-EXTERNAL-REF OF STL-REC
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    IF SS-RC = "00"
        MOVE SR-STL-ID OF STL-REC TO SL-STL-ID
        MOVE "00" TO SL-RC
    ELSE
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
    END-IF.

CLASSIFY-RESULT.
    IF SL-SIM NOT = SPACES
        MOVE SL-SIM TO WS-RESULT
    ELSE
        MOVE SR-STATUS TO WS-CUR-STATUS
        MOVE SPACES TO BK-PX-SPI-PARMS
        MOVE PC-ADAPTER TO SI-ADAPTER
        MOVE "STL-QUERY" TO SI-OP
        MOVE SR-STL-ID TO SI-E2E-ID
        MOVE SR-EXTERNAL-REF TO SI-EXT-REF
        MOVE SR-NET-AMT TO SI-AMOUNT
        MOVE SR-CURRENCY TO SI-CURRENCY
        MOVE SR-PARTICIPANT TO SI-PAYEE-PART
        CALL "BPXSPI" USING BK-PX-SPI-PARMS
        MOVE FUNCTION TRIM(SI-RESULT) TO WS-RESULT
    END-IF
    MOVE "00" TO SL-RC.

APPLY-RESULT.
    MOVE SR-STATUS TO WS-CUR-STATUS
    EVALUATE FUNCTION TRIM(WS-RESULT)
        WHEN "SETTLED"
            MOVE "SETTLE" TO WS-EVT
        WHEN "SUCCESS"
            MOVE "SETTLE" TO WS-EVT
        WHEN "CONFIRMED"
            MOVE "SETTLE" TO WS-EVT
        WHEN "REJECTED"
            MOVE "REJECT" TO WS-EVT
        WHEN "FAILED"
            MOVE "REJECT" TO WS-EVT
        WHEN "TIMEOUT"
            MOVE "UNKNOWN" TO WS-EVT
        WHEN "UNKNOWN"
            MOVE "UNKNOWN" TO WS-EVT
        WHEN "DUPLICATE"
            MOVE "Y" TO SL-REPLAY
            MOVE SPACES TO WS-EVT
        WHEN "SUBMITTED"
            MOVE SPACES TO WS-EVT
            MOVE "SETTLEMENT STILL IN FLIGHT" TO SL-MSG
        WHEN OTHER
            MOVE "UNKNOWN" TO WS-EVT
    END-EVALUATE
    IF WS-EVT = SPACES
        EXIT PARAGRAPH
    END-IF
    CALL "BPXSRM" USING WS-CUR-STATUS WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC NOT = "00"
        MOVE WS-STM-RC TO SL-RC
        MOVE WS-STM-MSG TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NXT TO SR-STATUS
    IF SR-STATUS = "SETTLED"
        IF SL-SETTLED-AMT NOT = 0
            MOVE SL-SETTLED-AMT TO SR-SETTLED-AMT
        ELSE
            MOVE SR-NET-AMT TO SR-SETTLED-AMT
        END-IF
        MOVE FUNCTION CURRENT-DATE TO WS-NOW
        MOVE WS-NOW TO SR-SETTLED
    END-IF
    IF SL-EXTERNAL-REF NOT = SPACES
        MOVE SL-EXTERNAL-REF TO SR-EXTERNAL-REF
    END-IF
    IF SL-RESULT-REF NOT = SPACES
        MOVE SL-RESULT-REF TO SR-RESULT-REF
    END-IF
    IF SL-REASON NOT = SPACES
        MOVE SL-REASON TO SR-REASON
    END-IF
    IF SR-EXTERNAL-REF NOT = SPACES
        PERFORM LINK-EXTERNAL
        IF SL-RC NOT = "00"
            EXIT PARAGRAPH
        END-IF
    END-IF.

DO-STL-RESULT-FILE.
    IF SL-FILE = SPACES
        MOVE "20" TO SL-RC
        MOVE "SETTLEMENT RESULT FILE REQUIRED" TO SL-MSG
        GOBACK
    END-IF
    PERFORM OPEN-EXT-IN
    IF SL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE 0 TO WS-ROWS WS-ROW-FAIL
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ EXT-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM APPLY-RESULT-ROW
        END-READ
    END-PERFORM
    CLOSE EXT-FILE
    MOVE WS-ROWS TO SL-ITEM-COUNT
    IF WS-ROW-FAIL > 0
        MOVE "20" TO SL-RC
        MOVE "SETTLEMENT RESULT FILE INCOMPLETE" TO SL-MSG
    ELSE
        MOVE "SETTLEMENT RESULTS PROCESSED" TO SL-MSG
    END-IF.

APPLY-RESULT-ROW.
    IF EXT-LINE = SPACES OR EXT-LINE(1:1) = "#"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-ROW-REF WS-ROW-STATUS WS-ROW-AMT-STR
        WS-ROW-CUR WS-ROW-REASON
    MOVE 0 TO SL-BIZDATE
    MOVE 0 TO SL-GROSS-AMT
    UNSTRING EXT-LINE DELIMITED BY "|"
        INTO WS-ROW-REF WS-ROW-STATUS WS-ROW-AMT-STR WS-ROW-CUR
            SL-BIZDATE WS-ROW-REASON
    END-UNSTRING
    IF WS-ROW-AMT-STR NOT = SPACES
        MOVE FUNCTION TRIM(WS-ROW-AMT-STR) TO SL-GROSS-AMT
    END-IF
    IF WS-ROW-REF = SPACES OR WS-ROW-STATUS = SPACES
        ADD 1 TO WS-ROW-FAIL
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO SL-STL-ID
    MOVE WS-ROW-REF TO SL-EXTERNAL-REF
    MOVE WS-ROW-STATUS TO SL-SIM
    MOVE WS-ROW-CUR TO SL-CURRENCY
    MOVE WS-ROW-REASON TO SL-REASON
    MOVE WS-ROW-REF TO SL-RESULT-REF
    MOVE SL-GROSS-AMT TO SL-SETTLED-AMT
    PERFORM DO-STL-RESULT
    ADD 1 TO WS-ROWS
    IF SL-RC NOT = "00"
        ADD 1 TO WS-ROW-FAIL
    END-IF
    MOVE SPACES TO SL-EXTERNAL-REF SL-SIM SL-REASON
    MOVE 0 TO SL-SETTLED-AMT SL-GROSS-AMT.

DO-STL-QUERY.
    MOVE SPACES TO BK-PX-SPI-PARMS
    MOVE PC-ADAPTER TO SI-ADAPTER
    MOVE "STL-QUERY" TO SI-OP
    MOVE SR-STL-ID TO SI-E2E-ID
    IF SL-STL-ID NOT = SPACES
        MOVE SL-STL-ID TO SI-E2E-ID
    END-IF
    IF SL-EXTERNAL-REF NOT = SPACES
        MOVE SL-EXTERNAL-REF TO SI-EXT-REF
    END-IF
    IF SL-SIM NOT = SPACES
        MOVE SL-SIM TO SI-SIM
    END-IF
    CALL "BPXSPI" USING BK-PX-SPI-PARMS
    MOVE FUNCTION TRIM(SI-RESULT) TO WS-RESULT
    MOVE SI-EXT-REF TO WS-EXT-REF
    MOVE SL-STL-ID TO SR-STL-ID OF STL-REC
    MOVE SI-RC TO SL-RC.

DO-STL-ADJUST.
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00"
        IF SL-REPLAY = "Y"
            MOVE SL-RC TO WS-ADJ-RC
            PERFORM READ-OBLIGATION
            IF SL-RC = "00"
                PERFORM EXPOSE-OBLIGATION
            END-IF
            MOVE WS-ADJ-RC TO SL-RC
        END-IF
        GOBACK
    END-IF
    PERFORM STL-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM READ-OBLIGATION
    IF SL-RC = "00"
        IF SR-STATUS NOT = "PENDING" AND
           SR-STATUS NOT = "SUBMIT-FAILED"
            MOVE "20" TO SL-RC
            MOVE "OBLIGATION NOT ADJUSTABLE" TO SL-MSG
        ELSE
            PERFORM APPLY-ADJUSTMENT
        END-IF
        IF SL-RC = "00"
            PERFORM WRITE-STORE-OBLIGATION
        END-IF
        IF SL-RC = "00"
            PERFORM EXPOSE-OBLIGATION
            PERFORM REBUILD-POSITION
            MOVE "SETTLEMENT ADJUSTED" TO SL-MSG
            PERFORM EMIT-STL
        END-IF
    END-IF
    PERFORM STL-UNLOCK
    PERFORM END-REQUEST.

APPLY-ADJUSTMENT.
    MOVE SR-NET-AMT TO WS-NET
    MOVE SL-ADJ-AMT TO WS-AMT
    IF WS-AMT = 0
        MOVE "20" TO SL-RC
        MOVE "ADJUSTMENT AMOUNT REQUIRED" TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    ADD WS-AMT TO SR-ADJ-AMT OF STL-REC
    COMPUTE SR-NET-AMT = SR-GROSS-AMT - SR-ADJ-AMT
    IF SR-NET-AMT < 0
        MOVE WS-NET TO SR-GROSS-AMT
        MOVE WS-NET TO SR-NET-AMT
        MOVE "20" TO SL-RC
        MOVE "ADJUSTMENT WOULD REVERSE OBLIGATION" TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    IF SL-REASON NOT = SPACES
        MOVE SL-REASON TO SR-REASON
    END-IF.


DO-STL-POST.
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00" GOBACK END-IF
    PERFORM STL-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM READ-OBLIGATION
    IF SL-RC = "00"
        IF SR-STATUS NOT = "SETTLED" AND
           SR-STATUS NOT = "RECONCILED"
            MOVE "20" TO SL-RC
            MOVE "SETTLEMENT NOT SETTLED" TO SL-MSG
        ELSE
            IF SR-POST-STATUS = "POSTED"
                MOVE "Y" TO SL-REPLAY
                MOVE "22" TO SL-RC
                MOVE "SETTLEMENT ALREADY POSTED" TO SL-MSG
            ELSE
                PERFORM BUILD-SETTLE-POSTING
            END-IF
        END-IF
        IF SL-RC = "00"
            PERFORM WRITE-STORE-OBLIGATION
        END-IF
        IF SL-RC = "00" OR SL-RC = "22"
            PERFORM EXPOSE-OBLIGATION
            PERFORM EMIT-STL
        END-IF
    END-IF
    PERFORM STL-UNLOCK
    PERFORM END-REQUEST.

BUILD-SETTLE-POSTING.
    MOVE SR-SETTLED-AMT TO WS-NET
    IF WS-NET = 0
        MOVE SR-NET-AMT TO WS-NET
    END-IF
    IF WS-NET = 0
        MOVE "NOT-REQUIRED" TO SR-POST-STATUS
        MOVE SPACES TO SR-JRN-ID
        MOVE "ZERO SETTLEMENT NOT POSTED" TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-JRN-PARMS BK-PST-TABLE
    STRING "STL" DELIMITED SIZE FUNCTION TRIM(SR-STL-ID)
        DELIMITED SIZE "-P" DELIMITED SIZE
        INTO BK-JRN-ID
    END-STRING
    MOVE SR-STL-ID TO BK-JRN-TXN-ID
    IF SR-SIDE = "PAYABLE"
        MOVE "SETTLPAY" TO BK-JRN-TYPE
    ELSE
        MOVE "SETTRCV" TO BK-JRN-TYPE
    END-IF
    MOVE SR-SETTLE-DATE TO BK-JRN-BIZDATE
    MOVE "PIX" TO BK-JRN-CHANNEL
    MOVE SL-OPERATOR TO BK-JRN-OPERATOR
    MOVE SL-CORR TO BK-JRN-CORR
    MOVE SR-STL-ID TO BK-JRN-REQUEST
    MOVE 2 TO BK-JRN-COUNT
    IF SR-SIDE = "PAYABLE"
        MOVE PC-STL-ACCT TO BK-PST-GL(1)
        MOVE "D" TO BK-PST-DC(1)
        MOVE SR-PARTICIPANT TO BK-PST-ENTITY(1)
        MOVE PC-STL-CASH TO BK-PST-GL(2)
        MOVE "C" TO BK-PST-DC(2)
        MOVE PC-SELF TO BK-PST-ENTITY(2)
    ELSE
        MOVE PC-STL-CASH TO BK-PST-GL(1)
        MOVE "D" TO BK-PST-DC(1)
        MOVE PC-SELF TO BK-PST-ENTITY(1)
        MOVE PC-STL-ACCT TO BK-PST-GL(2)
        MOVE "C" TO BK-PST-DC(2)
        MOVE SR-PARTICIPANT TO BK-PST-ENTITY(2)
    END-IF
    MOVE WS-NET TO BK-PST-AMOUNT(1)
    MOVE WS-NET TO BK-PST-AMOUNT(2)
    MOVE SR-CURRENCY TO BK-PST-CURRENCY(1)
    MOVE SR-CURRENCY TO BK-PST-CURRENCY(2)
    MOVE "PIX SETTLEMENT" TO BK-PST-DESCR(1)
    MOVE "PIX SETTLEMENT" TO BK-PST-DESCR(2)
    MOVE SR-SETTLE-DATE TO BK-PST-VALUEDATE(1)
    MOVE SR-SETTLE-DATE TO BK-PST-VALUEDATE(2)
    CALL "BGLPST" USING BK-JRN-PARMS BK-PST-TABLE
    IF BK-JRN-RC NOT = "00"
        MOVE BK-JRN-RC TO SL-RC
        MOVE BK-JRN-MSG TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "POSTED" TO SR-POST-STATUS
    MOVE BK-JRN-ID TO SR-JRN-ID
    MOVE "SETTLEMENT POSTED" TO SL-MSG.

DO-STL-LIST.
    PERFORM OPEN-STL-INPUT
    IF SL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE 0 TO WS-ROWS
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ STL-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM SHOW-STL-ROW
        END-READ
    END-PERFORM
    CLOSE STL-FILE
    DISPLAY "rc=00"
    DISPLAY "settlements=" WS-ROWS.

SHOW-STL-ROW.
    IF SL-CYCLE-ID NOT = SPACES AND
       SR-CYCLE-ID NOT = SL-CYCLE-ID
        EXIT PARAGRAPH
    END-IF
    IF SL-PARTICIPANT NOT = SPACES AND
       SR-PARTICIPANT NOT = SL-PARTICIPANT
        EXIT PARAGRAPH
    END-IF
    IF SL-STL-STATUS NOT = SPACES AND
       SR-STATUS NOT = SL-STL-STATUS
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-ROWS
    MOVE SR-NET-AMT TO WS-AMT-ED
    DISPLAY "settlement=" FUNCTION TRIM(SR-STL-ID)
    DISPLAY "cycle=" FUNCTION TRIM(SR-CYCLE-ID)
    DISPLAY "participant=" FUNCTION TRIM(SR-PARTICIPANT)
    DISPLAY "side=" FUNCTION TRIM(SR-SIDE)
    DISPLAY "amount=" WS-AMT-ED
    DISPLAY "settled=" SR-SETTLED-AMT
    DISPLAY "currency=" SR-CURRENCY
    DISPLAY "status=" FUNCTION TRIM(SR-STATUS)
    DISPLAY "post=" FUNCTION TRIM(SR-POST-STATUS)
    DISPLAY "recon=" FUNCTION TRIM(SR-RECON-STATUS)
    DISPLAY "extref=" FUNCTION TRIM(SR-EXTERNAL-REF)
    DISPLAY "journal=" FUNCTION TRIM(SR-JRN-ID).

DO-CYCLE-SUBMIT.
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00" GOBACK END-IF
    PERFORM CYCLE-FETCH-RECORD
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    IF SL-CYCLE-STATUS NOT = "CALCULATED" AND
       SL-CYCLE-STATUS NOT = "SUBMIT-FAILED" AND
       SL-CYCLE-STATUS NOT = "SUBMITTED" AND
       SL-CYCLE-STATUS NOT = "UNKNOWN"
        MOVE "20" TO SL-RC
        MOVE "CYCLE NOT SUBMITTABLE" TO SL-MSG
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM CYCLE-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    MOVE SL-REQUEST TO WS-SUBMIT-REQUEST
    MOVE "SUBMIT" TO WS-EVT
    MOVE SL-CYCLE-STATUS TO WS-CY-STATUS
    CALL "BPXCYM" USING WS-CY-STATUS WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC NOT = "00"
        MOVE WS-STM-RC TO SL-RC
        MOVE WS-STM-MSG TO SL-MSG
        PERFORM CYCLE-UNLOCK
        PERFORM END-REQUEST
        GOBACK
    END-IF
    MOVE WS-NXT TO CY-STATUS OF WS-CYCLE-REC
    MOVE SL-OPERATOR TO CY-OPERATOR
    MOVE SL-CORR TO CY-CORR
    PERFORM CYCLE-STORE
    PERFORM CYCLE-UNLOCK
    MOVE 0 TO WS-ROWS WS-ROW-FAIL
    PERFORM OPEN-STL-INPUT
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ STL-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM SUBMIT-ROW
        END-READ
    END-PERFORM
    CLOSE STL-FILE
    MOVE WS-SUBMIT-REQUEST TO SL-REQUEST
    IF WS-ROW-FAIL > 0
        PERFORM CYCLE-LOCK
        MOVE "SUBMIT-FAILED" TO CY-STATUS OF WS-CYCLE-REC
        PERFORM CYCLE-STORE
        PERFORM CYCLE-UNLOCK
        MOVE "20" TO SL-RC
        MOVE "CYCLE SUBMISSION INCOMPLETE" TO SL-MSG
    ELSE
        PERFORM CYCLE-LOCK
        IF WS-ROWS = 0
            MOVE "SETTLED" TO CY-STATUS OF WS-CYCLE-REC
            MOVE FUNCTION CURRENT-DATE TO WS-NOW
            MOVE WS-NOW TO CY-SETTLED
            MOVE "NOT-REQUIRED" TO CY-POST-STATUS
            MOVE "MATCHED" TO CY-RECON-STATUS
        END-IF
        PERFORM CYCLE-STORE
        PERFORM CYCLE-UNLOCK
        MOVE WS-ROWS TO SL-PARTY-COUNT
        MOVE "00" TO SL-RC
        MOVE "CYCLE SUBMITTED" TO SL-MSG
        PERFORM CYCLE-FETCH-RECORD
    END-IF
    PERFORM END-REQUEST.

SUBMIT-ROW.
    IF SR-CYCLE-ID NOT = SL-CYCLE-ID
        EXIT PARAGRAPH
    END-IF
    IF SR-STATUS NOT = "PENDING" AND
       SR-STATUS NOT = "SUBMIT-FAILED" AND
       SR-STATUS NOT = "SUBMITTED"
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-ROWS
    MOVE SR-STL-ID TO SL-STL-ID
    MOVE SPACES TO SL-REQUEST
    PERFORM DO-STL-SUBMIT-ONE
    MOVE WS-SUBMIT-REQUEST TO SL-REQUEST
    IF SL-RC NOT = "00"
        ADD 1 TO WS-ROW-FAIL
    END-IF
    MOVE "00" TO SL-RC.

DO-STL-SUBMIT-ONE.
    PERFORM STL-LOCK
    IF SL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM READ-OBLIGATION
    IF SL-RC = "00"
        IF SR-STATUS = "SUBMITTED" OR SR-STATUS = "UNKNOWN" OR
           SR-STATUS = "SETTLED" OR SR-STATUS = "RECONCILED"
            MOVE "Y" TO SL-REPLAY
        ELSE
            PERFORM SPI-SUBMIT
            PERFORM APPLY-OUTCOME
            IF SL-RC = "00"
                PERFORM WRITE-STORE-OBLIGATION
            END-IF
            IF SL-RC = "00"
                PERFORM EMIT-STL
            END-IF
        END-IF
    END-IF
    PERFORM STL-UNLOCK.

CYCLE-LOCK.
    MOVE SPACES TO WS-LOCK-NAME
    IF SL-CYCLE-ID NOT = SPACES
        STRING "CYCF-" DELIMITED SIZE
            FUNCTION TRIM(SL-CYCLE-ID) DELIMITED SIZE
            INTO WS-LOCK-NAME
        END-STRING
    ELSE
        STRING "CYCF-" DELIMITED SIZE SL-BIZDATE DELIMITED SIZE
            SL-CURRENCY DELIMITED SIZE INTO WS-LOCK-NAME
        END-STRING
    END-IF
    MOVE WS-LOCK-NAME TO WS-CYC-LOCK-NAME
    MOVE "A" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST
    IF WS-LOCK-ST NOT = "00"
        MOVE "24" TO SL-RC
        MOVE "SETTLEMENT CYCLE LOCKED" TO SL-MSG
    END-IF.

CYCLE-UNLOCK.
    MOVE WS-CYC-LOCK-NAME TO WS-LOCK-NAME
    MOVE "R" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST.

BEGIN-REQUEST.
    MOVE "00" TO SL-RC
    IF SL-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE FUNCTION TRIM(SL-OP) TO WS-OPNAME
    MOVE SL-REQUEST TO BK-IDM-TXN-ID
    MOVE WS-OPNAME TO BK-IDM-OPERATION
    MOVE SPACES TO BK-IDM-RESULT
    MOVE "B" TO BK-IDM-MODE
    CALL "BIDM" USING BK-IDM-PARMS
    EVALUATE BK-IDM-STATUS
        WHEN "00" CONTINUE
        WHEN "22"
            MOVE "G" TO BK-IDM-MODE
            CALL "BIDM" USING BK-IDM-PARMS
            IF BK-IDM-STATUS = "C"
                MOVE "Y" TO SL-REPLAY
                MOVE "22" TO SL-RC
                MOVE "SETTLEMENT REQUEST ALREADY PROCESSED"
                    TO SL-MSG
            ELSE
                MOVE "24" TO SL-RC
                MOVE "SETTLEMENT REQUEST IN PROGRESS" TO SL-MSG
            END-IF
        WHEN OTHER
            MOVE BK-IDM-STATUS TO SL-RC
            MOVE "SETTLEMENT IDEMPOTENCY STORE ERROR" TO SL-MSG
    END-EVALUATE.

END-REQUEST.
    IF SL-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE FUNCTION TRIM(SL-OP) TO WS-OPNAME
    MOVE SL-REQUEST TO BK-IDM-TXN-ID
    MOVE WS-OPNAME TO BK-IDM-OPERATION
    IF SL-RC = "00" OR SL-RC = "22"
        MOVE "C" TO BK-IDM-MODE
        IF SL-STL-ID = SPACES
            MOVE SL-CYCLE-ID TO BK-IDM-RESULT
        ELSE
            MOVE SL-STL-ID TO BK-IDM-RESULT
        END-IF
    ELSE
        MOVE "F" TO BK-IDM-MODE
        MOVE SPACES TO BK-IDM-RESULT
    END-IF
    CALL "BIDM" USING BK-IDM-PARMS.

EMIT-STL.
    MOVE SL-OPERATOR TO BK-AUD-OPERATOR
    MOVE "PIX.SETTLE" TO BK-AUD-ACTION
    MOVE SL-STL-ID TO BK-AUD-ENTITY
    MOVE SL-CORR TO BK-AUD-CORR
    MOVE SR-NET-AMT TO WS-AMT-ED
    MOVE SPACES TO BK-AUD-BEFORE
    STRING FUNCTION TRIM(SR-CYCLE-ID) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(SR-PARTICIPANT)
        DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(WS-CUR-STATUS) DELIMITED SIZE
        INTO BK-AUD-BEFORE
    END-STRING
    MOVE SPACES TO WS-AFTER
    STRING FUNCTION TRIM(SR-STATUS) DELIMITED SIZE "|"
        DELIMITED SIZE WS-AMT-ED DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(SR-EXTERNAL-REF)
        DELIMITED SIZE INTO WS-AFTER
    END-STRING
    MOVE WS-AFTER TO BK-AUD-AFTER
    MOVE SL-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE "PIX.SETTLE.v1" TO BK-EVT-TYPE
    MOVE SL-STL-ID TO BK-EVT-KEY
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(SR-STATUS) DELIMITED SIZE "|"
        DELIMITED SIZE WS-AMT-ED DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(SR-SIDE)
        DELIMITED SIZE INTO BK-EVT-PAYLOAD
    END-STRING
    MOVE SL-RC TO BK-EVT-STATUS
    CALL "BEVT" USING BK-EVT-PARMS.

EMIT-CYCLE.
    MOVE SL-OPERATOR TO BK-AUD-OPERATOR
    MOVE "PIX.CYCLE" TO BK-AUD-ACTION
    MOVE SL-CYCLE-ID TO BK-AUD-ENTITY
    MOVE SL-CORR TO BK-AUD-CORR
    MOVE CY-NET-AMT OF WS-CYCLE-REC TO WS-AMT-ED
    MOVE SPACES TO BK-AUD-BEFORE
    STRING FUNCTION TRIM(CY-STATUS OF WS-CYCLE-REC)
        DELIMITED SIZE INTO BK-AUD-BEFORE
    END-STRING
    MOVE SPACES TO WS-AFTER
    STRING FUNCTION TRIM(SL-CYCLE-STATUS) DELIMITED SIZE "|"
        DELIMITED SIZE WS-AMT-ED DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(SL-SIDE)
        DELIMITED SIZE INTO WS-AFTER
    END-STRING
    MOVE WS-AFTER TO BK-AUD-AFTER
    MOVE SL-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE "PIX.CYCLE.v1" TO BK-EVT-TYPE
    MOVE SL-CYCLE-ID TO BK-EVT-KEY
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(SL-CYCLE-STATUS) DELIMITED SIZE "|"
        DELIMITED SIZE WS-AMT-ED DELIMITED SIZE
        INTO BK-EVT-PAYLOAD
    END-STRING
    MOVE SL-RC TO BK-EVT-STATUS
    CALL "BEVT" USING BK-EVT-PARMS.

CYCLE-FETCH-RECORD.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "CYC-GET" TO SS-OP
    MOVE SL-CYCLE-ID TO SS-CYCLE-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    IF SS-RC NOT = "00"
        MOVE SS-RC TO SL-RC
        IF SS-RC = "23"
            MOVE "CYCLE NOT FOUND" TO SL-MSG
        ELSE
            MOVE SS-MSG TO SL-MSG
        END-IF
    ELSE
        MOVE "00" TO SL-RC
        PERFORM EXPOSE-CYCLE
    END-IF.

CYCLE-STORE.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE CY-CYCLE-ID OF WS-CYCLE-REC TO SS-CYCLE-ID
    MOVE "CYC-UPDATE" TO SS-OP
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    MOVE SS-RC TO SL-RC
    IF SS-RC NOT = "00"
        MOVE SS-MSG TO SL-MSG
    END-IF.

EXPOSE-CYCLE.
    MOVE CY-CYCLE-ID OF WS-CYCLE-REC TO SL-CYCLE-ID
    MOVE CY-BIZDATE OF WS-CYCLE-REC TO SL-BIZDATE
    MOVE CY-SETTLE-DATE OF WS-CYCLE-REC TO SL-SETTLE-DATE
    MOVE CY-STATUS OF WS-CYCLE-REC TO SL-CYCLE-STATUS
    MOVE CY-CURRENCY OF WS-CYCLE-REC TO SL-CURRENCY
    MOVE CY-TXN-COUNT OF WS-CYCLE-REC TO SL-TXN-COUNT
    MOVE CY-PAY-COUNT OF WS-CYCLE-REC TO SL-PAY-COUNT
    MOVE CY-RCV-COUNT OF WS-CYCLE-REC TO SL-RCV-COUNT
    MOVE CY-PARTY-COUNT OF WS-CYCLE-REC TO SL-PARTY-COUNT
    MOVE CY-GROSS-PAY OF WS-CYCLE-REC TO SL-GROSS-AMT
    MOVE CY-GROSS-RCV OF WS-CYCLE-REC TO SL-GROSS-RCV
    MOVE CY-NET-AMT OF WS-CYCLE-REC TO SL-NET-AMT
    MOVE CY-NET-SIDE OF WS-CYCLE-REC TO SL-SIDE
    MOVE CY-EXTERNAL-REF OF WS-CYCLE-REC TO SL-EXTERNAL-REF
    MOVE CY-POST-STATUS OF WS-CYCLE-REC TO SL-POST-STATUS
    MOVE CY-RECON-STATUS OF WS-CYCLE-REC TO SL-RECON-STATUS
    MOVE CY-JRN-ID OF WS-CYCLE-REC TO SL-JRN-ID
    MOVE CY-RUN-ID OF WS-CYCLE-REC TO SL-RUN-ID
    ADD CY-OBL-PAY OF WS-CYCLE-REC TO CY-OBL-RCV OF WS-CYCLE-REC
        GIVING WS-OBL-TOTAL
    MOVE WS-OBL-TOTAL TO SL-ITEM-COUNT.

DO-STL-GET.
    IF SL-STL-ID = SPACES
        MOVE "20" TO SL-RC
        MOVE "SETTLEMENT ID REQUIRED" TO SL-MSG
        GOBACK
    END-IF
    PERFORM READ-OBLIGATION
    IF SL-RC = "00"
        PERFORM EXPOSE-OBLIGATION
        MOVE "PIX SETTLEMENT OBLIGATION" TO SL-MSG
    END-IF.

DO-CYCLE-FINALIZE.
    MOVE 0 TO SL-POS-NET
    IF SL-CYCLE-ID = SPACES
        MOVE "20" TO SL-RC
        MOVE "CYCLE ID REQUIRED" TO SL-MSG
        GOBACK
    END-IF
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00" GOBACK END-IF
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "STL-COUNT" TO SS-OP
    MOVE SL-CYCLE-ID TO SS-CYCLE-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    IF SS-RC NOT = "00"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
        PERFORM END-REQUEST
        GOBACK
    END-IF
    MOVE SS-C-PENDING TO SL-PAY-COUNT
    MOVE SS-C-SUBMITTED TO SL-RCV-COUNT
    IF SS-C-PENDING > 0 OR SS-C-SUBMITTED > 0 OR SS-C-UNKNOWN > 0
        PERFORM CYCLE-FETCH-RECORD
        MOVE "21" TO SL-RC
        MOVE "CYCLE NOT READY" TO SL-MSG
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM CYCLE-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM CYCLE-FETCH-RECORD
    IF SL-RC = "00"
        IF SL-CYCLE-STATUS = "RECONCILED" OR
           SL-CYCLE-STATUS = "SETTLED"
            MOVE "Y" TO SL-REPLAY
            MOVE "22" TO SL-RC
            MOVE "CYCLE ALREADY FINALIZED" TO SL-MSG
        ELSE
            MOVE "SETTLE" TO WS-EVT
            MOVE SL-CYCLE-STATUS TO WS-CY-STATUS
            CALL "BPXCYM" USING WS-CY-STATUS WS-EVT WS-NXT
                WS-STM-RC WS-STM-MSG
            IF WS-STM-RC NOT = "00"
                MOVE WS-STM-RC TO SL-RC
                MOVE WS-STM-MSG TO SL-MSG
            ELSE
                MOVE WS-NXT TO CY-STATUS OF WS-CYCLE-REC
                MOVE FUNCTION CURRENT-DATE TO WS-NOW
                MOVE WS-NOW TO CY-SETTLED OF WS-CYCLE-REC
                MOVE "BALANCED" TO CY-POST-STATUS OF WS-CYCLE-REC
                MOVE "PENDING" TO CY-RECON-STATUS OF WS-CYCLE-REC
                PERFORM CYCLE-STORE
                MOVE "CYCLE FINALIZED" TO SL-MSG
            END-IF
        END-IF
        IF SL-RC = "00" OR SL-RC = "22"
            PERFORM EXPOSE-CYCLE
            PERFORM EMIT-CYCLE
            PERFORM WRITE-CYCLE-PX
        END-IF
    END-IF
    PERFORM CYCLE-UNLOCK
    PERFORM END-REQUEST.

WRITE-CYCLE-PX.
    MOVE "N" TO WS-FLAG
    IF CY-STATUS OF WS-CYCLE-REC NOT = "RECONCILED" AND
       CY-STATUS OF WS-CYCLE-REC NOT = "SETTLED"
        MOVE "Y" TO WS-FLAG
    END-IF
    IF WS-FLAG = "Y"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-PATHS
    OPEN I-O PX-FILE
    IF WS-PX-ST NOT = "00"
        MOVE "00" TO SL-RC
        CLOSE PX-FILE
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PX-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM MARK-PX-SETTLED
        END-READ
    END-PERFORM
    CLOSE PX-FILE.

MARK-PX-SETTLED.
    IF PX-SETTLE-BATCH OF PX-REC NOT =
       CY-CYCLE-ID OF WS-CYCLE-REC(1:12)
        EXIT PARAGRAPH
    END-IF
    IF PX-SETTLE-STATUS OF PX-REC NOT = "ACCUMULATED"
        EXIT PARAGRAPH
    END-IF
    MOVE "SETTLED" TO PX-SETTLE-STATUS OF PX-REC
    MOVE CY-SETTLE-DATE OF WS-CYCLE-REC TO PX-SETTLE-DATE OF PX-REC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW TO PX-UPDATED OF PX-REC
    ADD 1 TO PX-VERSION OF PX-REC
    MOVE SPACES TO BK-PX-STO-REQ
    MOVE "REWRITE" TO XS-OP
    MOVE PX-ID OF PX-REC TO XS-PIX-ID
    CALL "BPXSTO" USING BK-PX-STO-REQ PX-REC.

DO-POSITION-GET.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "POS-GET" TO SS-OP
    MOVE SL-PARTICIPANT TO SS-POS-PART
    MOVE "|" TO SS-POS-SEP
    MOVE SL-CURRENCY TO SS-POS-CUR
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    MOVE SS-RC TO SL-RC
    IF SS-RC = "00"
        PERFORM EXPOSE-POSITION
        MOVE "PIX CLEARING POSITION" TO SL-MSG
    ELSE
        MOVE SS-MSG TO SL-MSG
    END-IF.

EXPOSE-POSITION.
    MOVE PO-PARTICIPANT OF WS-POS-REC TO SL-PARTICIPANT
    MOVE PO-CURRENCY OF WS-POS-REC TO SL-CURRENCY
    MOVE PO-PAYABLE OF WS-POS-REC TO SL-POS-PAYABLE
    MOVE PO-RECEIVABLE OF WS-POS-REC TO SL-POS-RECEIVABLE
    MOVE PO-SETTLED-PAY OF WS-POS-REC TO SL-POS-SPENT
    MOVE PO-SETTLED-RCV OF WS-POS-REC TO SL-POS-RECEIVED
    MOVE PO-ADJ-AMT OF WS-POS-REC TO SL-ADJ-AMT
    MOVE PO-PENDING-COUNT OF WS-POS-REC TO SL-POS-PENDING
    MOVE PO-SETTLED-COUNT OF WS-POS-REC TO SL-ITEM-COUNT
    COMPUTE SL-POS-NET = PO-RECEIVABLE OF WS-POS-REC -
        PO-PAYABLE OF WS-POS-REC.

DO-POSITION-REBUILD.
    PERFORM REBUILD-POSITION
    IF SL-RC = "00"
        MOVE "POSITIONS REBUILT" TO SL-MSG
    END-IF.

DO-POSITION-LIST.
    PERFORM BUILD-PATHS
    OPEN INPUT POS-FILE
    IF WS-POS-ST = "35"
        MOVE "00" TO WS-POS-ST
        CLOSE POS-FILE
        DISPLAY "rc=00"
        DISPLAY "positions=0000000"
        GOBACK
    END-IF
    IF WS-POS-ST NOT = "00"
        MOVE "20" TO SL-RC
        MOVE "POSITION STORE UNAVAILABLE" TO SL-MSG
        GOBACK
    END-IF
    MOVE 0 TO WS-ROWS
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ POS-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM SHOW-POS-ROW
        END-READ
    END-PERFORM
    CLOSE POS-FILE
    DISPLAY "rc=00"
    DISPLAY "positions=" WS-ROWS.

SHOW-POS-ROW.
    IF SL-PARTICIPANT NOT = SPACES AND
       PO-PARTICIPANT OF POS-REC NOT = SL-PARTICIPANT
        EXIT PARAGRAPH
    END-IF
    IF SL-CURRENCY NOT = SPACES AND
       PO-CURRENCY OF POS-REC NOT = SL-CURRENCY
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-ROWS
    MOVE PO-PAYABLE OF POS-REC TO WS-AMT-ED
    DISPLAY "participant=" FUNCTION TRIM(PO-PARTICIPANT OF POS-REC)
    DISPLAY "currency=" FUNCTION TRIM(PO-CURRENCY OF POS-REC)
    DISPLAY "payable=" WS-AMT-ED
    MOVE PO-RECEIVABLE OF POS-REC TO WS-AMT-ED
    DISPLAY "receivable=" WS-AMT-ED
    MOVE PO-SETTLED-PAY OF POS-REC TO WS-AMT-ED
    DISPLAY "settledpay=" WS-AMT-ED
    MOVE PO-SETTLED-RCV OF POS-REC TO WS-AMT-ED
    DISPLAY "settledrcv=" WS-AMT-ED
    MOVE PO-ADJ-AMT OF POS-REC TO WS-AMT-ED
    DISPLAY "adjust=" WS-AMT-ED
    DISPLAY "pending=" PO-PENDING-COUNT OF POS-REC
    DISPLAY "settledcount=" PO-SETTLED-COUNT OF POS-REC.

OPEN-STL-INPUT.
    PERFORM BUILD-PATHS
    OPEN INPUT STL-FILE
    IF WS-STL-ST = "35"
        MOVE "00" TO WS-STL-ST
        CLOSE STL-FILE
        MOVE "00" TO SL-RC
        EXIT PARAGRAPH
    END-IF
    IF WS-STL-ST NOT = "00"
        MOVE "20" TO SL-RC
        MOVE "SETTLEMENT STORE UNAVAILABLE" TO SL-MSG
    END-IF.

OPEN-EXT-IN.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-EXT-PATH
    IF SL-FILE(1:1) = "/"
        MOVE FUNCTION TRIM(SL-FILE) TO WS-EXT-PATH
    ELSE
        STRING FUNCTION TRIM(WS-HOME) "/" DELIMITED SIZE
            FUNCTION TRIM(SL-FILE) DELIMITED SIZE
            INTO WS-EXT-PATH
        END-STRING
    END-IF
    OPEN INPUT EXT-FILE
    IF WS-EXT-ST NOT = "00"
        MOVE "35" TO SL-RC
        MOVE "SETTLEMENT RESULT FILE MISSING" TO SL-MSG
    END-IF.

REBUILD-POSITION.
    MOVE 0 TO WS-KEYS
    PERFORM CLEAR-POSITION-TABLE
    PERFORM OPEN-STL-INPUT
    IF SL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ STL-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ACCUMULATE-POSITION-ROW
        END-READ
    END-PERFORM
    CLOSE STL-FILE
    PERFORM FLUSH-POSITION-TABLE.

CLEAR-POSITION-TABLE.
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 50
        MOVE SPACES TO WS-PT-PART(WS-K)
        MOVE SPACES TO WS-PT-CUR(WS-K)
        MOVE 0 TO WS-PT-PAY(WS-K) WS-PT-RCV(WS-K)
            WS-PT-SPENT(WS-K) WS-PT-RECV(WS-K) WS-PT-ADJ(WS-K)
            WS-PT-PENDN(WS-K) WS-PT-SETTN(WS-K) WS-PT-LAST(WS-K)
    END-PERFORM.

ACCUMULATE-POSITION-ROW.
    IF SL-PARTICIPANT NOT = SPACES AND
       SR-PARTICIPANT NOT = SL-PARTICIPANT
        EXIT PARAGRAPH
    END-IF
    IF SL-CURRENCY NOT = SPACES AND SR-CURRENCY NOT = SL-CURRENCY
        EXIT PARAGRAPH
    END-IF
    PERFORM FIND-POSITION-SLOT
    IF SL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF SR-STATUS = "SETTLED" OR SR-STATUS = "RECONCILED"
        IF SR-SIDE = "PAYABLE"
            ADD SR-SETTLED-AMT TO WS-PT-SPENT(WS-K)
        ELSE
            ADD SR-SETTLED-AMT TO WS-PT-RECV(WS-K)
        END-IF
        ADD 1 TO WS-PT-SETTN(WS-K)
    ELSE
        IF SR-STATUS NOT = "REJECTED" AND
           SR-STATUS NOT = "CANCELLED"
            IF SR-SIDE = "PAYABLE"
                ADD SR-NET-AMT TO WS-PT-PAY(WS-K)
            ELSE
                ADD SR-NET-AMT TO WS-PT-RCV(WS-K)
            END-IF
            ADD 1 TO WS-PT-PENDN(WS-K)
        END-IF
    END-IF
    ADD SR-ADJ-AMT TO WS-PT-ADJ(WS-K)
    IF SR-SETTLE-DATE > WS-PT-LAST(WS-K)
        MOVE SR-SETTLE-DATE TO WS-PT-LAST(WS-K)
    END-IF.

FIND-POSITION-SLOT.
    MOVE 0 TO WS-SLOT
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > 50 OR
                             WS-SLOT > 0
        IF WS-PT-PART(WS-K) = SR-PARTICIPANT AND
           WS-PT-CUR(WS-K) = SR-CURRENCY
            MOVE WS-K TO WS-SLOT
        END-IF
    END-PERFORM
    IF WS-SLOT > 0
        MOVE WS-SLOT TO WS-K
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-KEYS
    MOVE WS-KEYS TO WS-K
    IF WS-K > 50
        MOVE "20" TO SL-RC
        MOVE "TOO MANY CLEARING POSITIONS" TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SR-PARTICIPANT TO WS-PT-PART(WS-K)
    MOVE SR-CURRENCY TO WS-PT-CUR(WS-K).

FLUSH-POSITION-TABLE.
    IF SL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-KEYS
        MOVE WS-PT-PART(WS-I) TO SL-PARTICIPANT
        MOVE WS-PT-CUR(WS-I) TO SL-CURRENCY
        PERFORM WRITE-ONE-POSITION
    END-PERFORM.

WRITE-ONE-POSITION.
    MOVE SPACES TO WS-POS-REC
    MOVE SL-PARTICIPANT TO PO-PARTICIPANT OF WS-POS-REC
    MOVE "|" TO PO-SEP OF WS-POS-REC
    MOVE SL-CURRENCY TO PO-CURRENCY OF WS-POS-REC
    MOVE WS-PT-PAY(WS-I) TO PO-PAYABLE OF WS-POS-REC
    MOVE WS-PT-RCV(WS-I) TO PO-RECEIVABLE OF WS-POS-REC
    MOVE WS-PT-SPENT(WS-I) TO PO-SETTLED-PAY OF WS-POS-REC
    MOVE WS-PT-RECV(WS-I) TO PO-SETTLED-RCV OF WS-POS-REC
    MOVE WS-PT-ADJ(WS-I) TO PO-ADJ-AMT OF WS-POS-REC
    MOVE WS-PT-PENDN(WS-I) TO PO-PENDING-COUNT OF WS-POS-REC
    MOVE WS-PT-SETTN(WS-I) TO PO-SETTLED-COUNT OF WS-POS-REC
    MOVE WS-PT-LAST(WS-I) TO PO-LAST-DATE OF WS-POS-REC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW TO PO-UPDATED OF WS-POS-REC
    PERFORM STORE-POSITION.

STORE-POSITION.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE SL-PARTICIPANT TO SS-POS-PART
    MOVE "|" TO SS-POS-SEP
    MOVE SL-CURRENCY TO SS-POS-CUR
    MOVE "POS-GET" TO SS-OP
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-PROBE
    MOVE "00" TO SL-RC
    IF SS-RC = "00"
        MOVE "POS-UPDATE" TO WS-OPNAME
        MOVE PO-VERSION OF WS-POS-PROBE TO PO-VERSION
            OF WS-POS-REC
        ADD 1 TO PO-VERSION OF WS-POS-REC
    ELSE
        IF SS-RC = "23"
            MOVE "POS-WRITE" TO WS-OPNAME
            MOVE 1 TO PO-VERSION OF WS-POS-REC
        ELSE
            MOVE SS-RC TO SL-RC
            MOVE SS-MSG TO SL-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE WS-OPNAME TO SS-OP
    MOVE SL-PARTICIPANT TO SS-POS-PART
    MOVE "|" TO SS-POS-SEP
    MOVE SL-CURRENCY TO SS-POS-CUR
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        STL-REC WS-POS-REC
    IF SS-RC NOT = "00"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
    END-IF.

STL-LOCK.
    MOVE SPACES TO WS-LOCK-NAME
    STRING "STL-" DELIMITED SIZE FUNCTION TRIM(SL-STL-ID)
        DELIMITED SIZE INTO WS-LOCK-NAME
    END-STRING
    MOVE WS-LOCK-NAME TO WS-STL-LOCK-NAME
    MOVE "A" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST
    IF WS-LOCK-ST NOT = "00"
        MOVE "24" TO SL-RC
        MOVE "SETTLEMENT LOCKED" TO SL-MSG
    END-IF.

STL-UNLOCK.
    MOVE WS-STL-LOCK-NAME TO WS-LOCK-NAME
    MOVE "R" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST.
