IDENTIFICATION DIVISION.
PROGRAM-ID. BPXSTM.

DATA DIVISION.
WORKING-STORAGE SECTION.

LINKAGE SECTION.
01 LS-CUR PIC X(12).
01 LS-EVT PIC X(16).
01 LS-NXT PIC X(12).
01 LS-RC PIC X(02).
01 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-CUR LS-EVT LS-NXT LS-RC LS-MSG.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    MOVE SPACES TO LS-NXT
    EVALUATE TRUE
        WHEN LS-EVT = "VALIDATE"
            IF LS-CUR = "REQUESTED" OR LS-CUR = "RECEIVED"
                MOVE "VALIDATED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "REJECT"
            IF LS-CUR = "REQUESTED" OR LS-CUR = "RECEIVED" OR
               LS-CUR = "VALIDATED"
                MOVE "REJECTED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "AUTHORIZE"
            IF LS-CUR = "VALIDATED" MOVE "AUTHORIZED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "START"
            IF LS-CUR = "AUTHORIZED" MOVE "PROCESSING" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "SUBMIT"
            IF LS-CUR = "PROCESSING" MOVE "SUBMITTED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "ACCEPT"
            IF LS-CUR = "SUBMITTED" OR LS-CUR = "VALIDATED"
                MOVE "ACCEPTED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "FAIL"
            IF LS-CUR = "PROCESSING" OR LS-CUR = "SUBMITTED"
                MOVE "FAILED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "TIMEOUT"
            IF LS-CUR = "PROCESSING" OR LS-CUR = "SUBMITTED"
                MOVE "TIMEOUT" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "RETURN"
            EVALUATE TRUE
                WHEN LS-CUR = "ACCEPTED" OR LS-CUR = "POSTED"
                    MOVE "RETURNED" TO LS-NXT
                WHEN LS-CUR = "SETTLED" OR LS-CUR = "RECONCILED"
                    MOVE "20" TO LS-RC
                    MOVE "USE PIX DEVOLUTION" TO LS-MSG
                WHEN OTHER
                    PERFORM SET-INVALID
            END-EVALUATE
        WHEN LS-EVT = "CANCEL"
            EVALUATE TRUE
                WHEN LS-CUR = "REQUESTED" OR LS-CUR = "VALIDATED" OR
                     LS-CUR = "AUTHORIZED" OR LS-CUR = "PROCESSING"
                    MOVE "CANCELLED" TO LS-NXT
                WHEN LS-CUR = "POSTED" OR LS-CUR = "SETTLED" OR
                     LS-CUR = "RECONCILED" OR LS-CUR = "POST-PENDING"
                    MOVE "20" TO LS-RC
                    MOVE "USE PIX DEVOLUTION" TO LS-MSG
                WHEN OTHER
                    PERFORM SET-INVALID
            END-EVALUATE
        WHEN LS-EVT = "EXPIRE"
            IF LS-CUR = "REQUESTED" OR LS-CUR = "RECEIVED" OR
               LS-CUR = "VALIDATED" OR LS-CUR = "AUTHORIZED" OR
               LS-CUR = "PROCESSING" OR LS-CUR = "SUBMITTED"
                MOVE "EXPIRED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "POST-PENDING"
            IF LS-CUR = "ACCEPTED" MOVE "POST-PENDING" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "POST"
            IF LS-CUR = "POST-PENDING" MOVE "POSTED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "POST-FAIL"
            IF LS-CUR = "POST-PENDING" MOVE "POST-FAILED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "RETRY"
            EVALUATE TRUE
                WHEN LS-CUR = "POST-FAILED"
                    MOVE "POST-PENDING" TO LS-NXT
                WHEN LS-CUR = "FAILED" OR LS-CUR = "TIMEOUT"
                    MOVE "PROCESSING" TO LS-NXT
                WHEN LS-CUR = "EXCEPTION"
                    MOVE "VALIDATED" TO LS-NXT
                WHEN OTHER
                    PERFORM SET-INVALID
            END-EVALUATE
        WHEN LS-EVT = "BATCH"
            IF LS-CUR = "POSTED" MOVE "SETTLE-PEND" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "SETTLE"
            IF LS-CUR = "SETTLE-PEND" MOVE "SETTLED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "RECON"
            IF LS-CUR = "SETTLED" MOVE "RECONCILED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "DEVOLVE"
            IF LS-CUR = "POSTED" OR LS-CUR = "SETTLED" OR
               LS-CUR = "RECONCILED" OR LS-CUR = "DEVOLVED"
                MOVE "DEVOLVED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "EXCEPTION"
            IF LS-CUR = "REQUESTED" OR LS-CUR = "RECEIVED" OR
               LS-CUR = "VALIDATED" OR LS-CUR = "AUTHORIZED" OR
               LS-CUR = "PROCESSING" OR LS-CUR = "SUBMITTED" OR
               LS-CUR = "ACCEPTED" OR LS-CUR = "POST-PENDING" OR
               LS-CUR = "TIMEOUT" OR LS-CUR = "FAILED"
                MOVE "EXCEPTION" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN OTHER
            PERFORM SET-INVALID
    END-EVALUATE.
    IF LS-RC = "00" AND LS-NXT = SPACES
        PERFORM SET-INVALID
    END-IF
    GOBACK.

SET-INVALID.
    MOVE "20" TO LS-RC
    STRING "INVALID PIX TRANSITION " DELIMITED SIZE
        FUNCTION TRIM(LS-CUR) DELIMITED SIZE " + " DELIMITED SIZE
        FUNCTION TRIM(LS-EVT) DELIMITED SIZE
        INTO LS-MSG
    END-STRING.
