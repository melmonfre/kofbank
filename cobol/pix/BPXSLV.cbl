IDENTIFICATION DIVISION.
PROGRAM-ID. BPXSLV.

*> Split allocation service: validation, durable creation, state
*> marking and listing for one Pix payment decomposition.
*>
*> The engine never calculates amounts or taxes: it validates the
*> decomposition supplied by the authorized initiator and enforces
*> the financial invariants:
*>     gross > 0
*>     every allocation amount > 0
*>     sum(allocations) == gross      (no residual, no creation)
*>     destinations resolvable and active
*>     tax metadata well formed (type, category, document reference)
*>
*> Rows are ordered by SEQ; identity is the durable ALLOC id, never
*> the array position.  A reversal (future domain) is expressed by a
*> new allocation row with an AL-ORIG-ALLOC-ID pointer; original
*> financial history is never rewritten.

ENVIRONMENT DIVISION.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BPXRT".
COPY "BPXCFG".
COPY "BDOCP".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-ACCT-OUT.
   05 AO-ID PIC X(12).
   05 AO-CUST PIC X(12).
   05 AO-PRODUCT PIC X(04).
   05 AO-CURRENCY PIC X(03).
   05 AO-STATUS PIC X(02).
   05 AO-OPENED PIC 9(08).
   05 AO-CLOSED PIC 9(08).
   05 AO-VERSION PIC 9(05).
   05 AO-HASH PIC X(16).
   05 AO-RC PIC X(02).
01 WS-I PIC 9(02).
01 WS-J PIC 9(02).
01 WS-M PIC 9(02).
01 WS-SW-SEQ PIC 9(02).
01 WS-T-SEQ   PIC 9(02).
01 WS-T-ROLE  PIC X(12).
01 WS-T-ID    PIC X(12).
01 WS-T-CUST  PIC X(12).
01 WS-T-DTYPE PIC X(04).
01 WS-T-DOC   PIC X(20).
01 WS-T-NAME  PIC X(60).
01 WS-T-AMT   PIC S9(15)V99 COMP-3.
01 WS-T-TYPE  PIC X(10).
01 WS-T-REF   PIC X(32).
01 WS-T-DREF  PIC X(50).
01 WS-T-TTYPE PIC X(10).
01 WS-T-TCAT  PIC X(08).
01 WS-T-AID   PIC X(12).
01 WS-T-ST    PIC X(12).
01 WS-T-ORIG  PIC X(12).
01 WS-T-TXN   PIC X(12).
01 WS-T-JRN   PIC X(20).
01 WS-SEQ-SEEN.
   05 WS-SEEN OCCURS 20 TIMES PIC X(01).
01 WS-TOTAL PIC S9(15)V99 COMP-3.
01 WS-TAX PIC S9(15)V99 COMP-3.
01 WS-EXT PIC S9(15)V99 COMP-3.
01 WS-DOC-CANON PIC X(20).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-HASH-BUF PIC X(200).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-ID-TYPE PIC X(08).
01 WS-ID-ISPB PIC X(08).
01 WS-ID-VAL PIC X(32).
01 WS-ID-RC PIC X(02).
01 WS-NOW PIC 9(14).
01 WS-SAME PIC X(01).

COPY "BPXPAP".
COPY "BPXRVP".
01 BK-PX-ALLOC-REC.
   COPY "BPXPA".
01 BK-PX-RV-PARMS.
   COPY "BPXRV".
01 WS-RV-HDR.
   COPY "BPXRV".
01 WS-LK-NAME PIC X(24).
01 WS-LK-OWNER PIC X(16).
01 WS-LK-MODE PIC X(01).
01 WS-LK-ST PIC X(02).
01 WS-RV-REMAIN PIC S9(15)V99 COMP-3.
01 WS-RV-REVSUM PIC S9(15)V99 COMP-3.
01 WS-RV-FORIG PIC X(12).
01 WS-RV-DUP PIC S9(15)V99 COMP-3.
01 WS-Q PIC 9(02).
01 WS-K PIC 9(02).
01 WS-RV-TOTAL PIC S9(15)V99 COMP-3.

01 WS-ORIG-FOUND PIC X(01).
01 WS-HIT PIC 9(02).
01 WS-REQ-CNT PIC 9(02).

LINKAGE SECTION.
COPY "BKSPLP".

PROCEDURE DIVISION USING BK-PX-SPL-PARMS.
    MOVE "00" TO SP-RC
    MOVE SPACES TO SP-MSG
    MOVE "N" TO SP-REPLAY
    CALL "BCFG" USING WS-CFG
    CALL "BPXCFG" USING BK-PX-CFG
    IF PC-STATUS NOT = "00" OR PC-ENABLED NOT = "Y"
        MOVE "20" TO SP-RC
        MOVE "PIX SPLIT UNAVAILABLE" TO SP-MSG
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(SP-OP)
        WHEN "SPL-VALIDATE" PERFORM DO-VALIDATE
        WHEN "SPL-CREATE" PERFORM DO-CREATE
        WHEN "SPL-MARK" PERFORM DO-MARK
        WHEN "SPL-LIST" PERFORM DO-LIST
        WHEN "SPL-GET" PERFORM DO-GET-ONE
        WHEN "SPL-REV-CREATE" PERFORM DO-REV-CREATE
        WHEN "SPL-REV-MARK" PERFORM DO-REV-MARK
        WHEN "SPL-REV-GET" PERFORM DO-REV-GET
        WHEN "SPL-REV-LIST" PERFORM DO-REV-LIST
        WHEN OTHER
            MOVE "99" TO SP-RC
            MOVE "UNKNOWN SPLIT OP" TO SP-MSG
    END-EVALUATE
    GOBACK.

DO-VALIDATE.
    PERFORM VALIDATE-STRUCTURE
    IF SP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM VALIDATE-SEQUENCE
    IF SP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM VALIDATE-AMOUNTS
    IF SP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM VALIDATE-DESTINATIONS
    IF SP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM VALIDATE-TAX-METADATA
    IF SP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM COMPUTE-TOTALS.

DO-CREATE.
    MOVE SP-CNT TO WS-M
    PERFORM DO-LIST-FETCH
    IF SP-RC = "00"
        PERFORM CHECK-EXISTING-MATCH
        IF SP-RC NOT = "00"
            GOBACK
        END-IF
        PERFORM COMPUTE-TOTALS
        MOVE "Y" TO SP-REPLAY
        MOVE "PIX SPLIT ALREADY CREATED" TO SP-MSG
        GOBACK
    END-IF
    IF SP-RC NOT = "23"
        GOBACK
    END-IF
    MOVE WS-M TO SP-CNT
    MOVE "00" TO SP-RC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-M
        MOVE SPACES TO WS-ID-TYPE WS-ID-ISPB WS-ID-VAL
        MOVE "SPL" TO WS-ID-TYPE
        MOVE PC-E2E-ISPB TO WS-ID-ISPB
        CALL "BPXID" USING WS-ID-TYPE WS-ID-ISPB WS-ID-VAL
            WS-ID-RC
        IF WS-ID-RC NOT = "00"
            MOVE "20" TO SP-RC
            MOVE "PIX SPLIT ALLOC ID ERROR" TO SP-MSG
            GOBACK
        END-IF
        MOVE WS-ID-VAL(1:12) TO SP-PS-ALLOC-ID(WS-I)
        PERFORM WRITE-ONE-ALLOCATION
        IF SP-RC NOT = "00"
            GOBACK
        END-IF
    END-PERFORM
    PERFORM COMPUTE-TOTALS
    MOVE "PIX SPLIT ALLOCATIONS CREATED" TO SP-MSG.

WRITE-ONE-ALLOCATION.
    MOVE SPACES TO BK-PX-ALLOC-REC
    MOVE SP-PS-ALLOC-ID(WS-I) TO AL-ALLOC-ID
        OF BK-PX-ALLOC-REC
    MOVE SP-PIX-ID TO AL-PIX-ID OF BK-PX-ALLOC-REC
    MOVE SP-PS-SEQ(WS-I) TO AL-SEQ OF BK-PX-ALLOC-REC
    MOVE SP-PS-ROLE(WS-I) TO AL-DEST-ROLE OF BK-PX-ALLOC-REC
    EVALUATE FUNCTION TRIM(SP-PS-ROLE(WS-I))
        WHEN "PARTICIPANT"
            MOVE SP-PS-ID(WS-I) TO AL-DEST-PART
                OF BK-PX-ALLOC-REC
        WHEN OTHER
            MOVE SP-PS-ID(WS-I) TO AL-DEST-ACCT
                OF BK-PX-ALLOC-REC
    END-EVALUATE
    MOVE SP-PS-CUST(WS-I) TO AL-DEST-CUST OF BK-PX-ALLOC-REC
    MOVE SP-PS-DOC-TYPE(WS-I) TO AL-DEST-DOC-TYPE
        OF BK-PX-ALLOC-REC
    MOVE SP-PS-DOC(WS-I) TO AL-DEST-DOC OF BK-PX-ALLOC-REC
    MOVE SP-PS-NAME(WS-I) TO AL-DEST-NAME OF BK-PX-ALLOC-REC
    MOVE SP-PS-AMT(WS-I) TO AL-AMOUNT OF BK-PX-ALLOC-REC
    MOVE SP-CURRENCY TO AL-CURRENCY OF BK-PX-ALLOC-REC
    MOVE SP-PS-TYPE(WS-I) TO AL-TYPE OF BK-PX-ALLOC-REC
    MOVE SP-PS-REF(WS-I) TO AL-REF OF BK-PX-ALLOC-REC
    MOVE SP-PS-DOCREF(WS-I) TO AL-DOC-REF OF BK-PX-ALLOC-REC
    MOVE SP-PS-TAXTYPE(WS-I) TO AL-TAX-TYPE OF BK-PX-ALLOC-REC
    MOVE SP-PS-TAXCAT(WS-I) TO AL-TAX-CAT OF BK-PX-ALLOC-REC
    MOVE "CREATED" TO AL-STATUS OF BK-PX-ALLOC-REC
    MOVE SP-BIZDATE TO AL-BIZDATE OF BK-PX-ALLOC-REC
    MOVE WS-NOW TO AL-CREATED OF BK-PX-ALLOC-REC
    MOVE WS-NOW TO AL-UPDATED OF BK-PX-ALLOC-REC
    MOVE 1 TO AL-VERSION OF BK-PX-ALLOC-REC
    PERFORM COMPUTE-ALLOC-HASH
    MOVE SP-OPERATOR TO AL-OPERATOR OF BK-PX-ALLOC-REC
    MOVE SP-CORR TO AL-CORR OF BK-PX-ALLOC-REC
    MOVE SP-REQUEST TO AL-REQUEST OF BK-PX-ALLOC-REC
    MOVE SPACES TO BK-PX-ALLOC-STO-REQ
    MOVE "WRITE" TO WA-OP
    MOVE AL-PIX-ID OF BK-PX-ALLOC-REC TO WA-PIX-ID
    MOVE AL-SEQ OF BK-PX-ALLOC-REC TO WA-SEQ
    MOVE AL-ALLOC-ID OF BK-PX-ALLOC-REC TO WA-ALLOC-ID
    CALL "BPXPASTO" USING BK-PX-ALLOC-STO-REQ BK-PX-ALLOC-REC
        BK-PX-ALLOC-TBL
    IF WA-RC NOT = "00"
        MOVE WA-RC TO SP-RC
        MOVE WA-MSG TO SP-MSG
    END-IF.

DO-MARK.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        MOVE SPACES TO BK-PX-ALLOC-STO-REQ
        MOVE "GET-SEQ" TO WA-OP
        MOVE SP-PIX-ID TO WA-PIX-ID
        MOVE SP-PS-SEQ(WS-I) TO WA-SEQ
        CALL "BPXPASTO" USING BK-PX-ALLOC-STO-REQ
            BK-PX-ALLOC-REC BK-PX-ALLOC-TBL
        IF WA-RC NOT = "00"
            MOVE "20" TO SP-RC
            MOVE "PIX SPLIT ALLOC MISSING FOR MARK" TO SP-MSG
            GOBACK
        END-IF
        EVALUATE FUNCTION TRIM(SP-STATUS)
            WHEN "VALIDATED"
                IF AL-STATUS OF BK-PX-ALLOC-REC NOT = "CREATED"
                    AND AL-STATUS OF BK-PX-ALLOC-REC
                        NOT = "VALIDATED"
                    MOVE "20" TO SP-RC
                    MOVE "PIX SPLIT ALLOC STATE CONFLICT"
                        TO SP-MSG
                    GOBACK
                END-IF
                MOVE "VALIDATED" TO AL-STATUS
                    OF BK-PX-ALLOC-REC
            WHEN "POSTED"
                IF AL-STATUS OF BK-PX-ALLOC-REC NOT = "VALIDATED"
                    AND AL-STATUS OF BK-PX-ALLOC-REC NOT = "CREATED"
                    AND AL-STATUS OF BK-PX-ALLOC-REC NOT = "POSTED"
                    MOVE "20" TO SP-RC
                    MOVE "PIX SPLIT ALLOC STATE CONFLICT"
                        TO SP-MSG
                    GOBACK
                END-IF
                MOVE "POSTED" TO AL-STATUS OF BK-PX-ALLOC-REC
                MOVE SP-TXN-ID TO AL-TXN-ID OF BK-PX-ALLOC-REC
                MOVE SP-JRN-ID TO AL-JRN-ID OF BK-PX-ALLOC-REC
            WHEN OTHER
                MOVE "20" TO SP-RC
                MOVE "UNKNOWN ALLOC MARK STATUS" TO SP-MSG
                GOBACK
        END-EVALUATE
        MOVE WS-NOW TO AL-UPDATED OF BK-PX-ALLOC-REC
        ADD 1 TO AL-VERSION OF BK-PX-ALLOC-REC
        PERFORM COMPUTE-ALLOC-HASH
        MOVE SPACES TO BK-PX-ALLOC-STO-REQ
        MOVE "REWRITE" TO WA-OP
        MOVE AL-ALLOC-ID OF BK-PX-ALLOC-REC TO WA-ALLOC-ID
        CALL "BPXPASTO" USING BK-PX-ALLOC-STO-REQ
            BK-PX-ALLOC-REC BK-PX-ALLOC-TBL
        IF WA-RC NOT = "00"
            MOVE WA-RC TO SP-RC
            MOVE WA-MSG TO SP-MSG
            GOBACK
        END-IF
    END-PERFORM.

DO-LIST.
    PERFORM DO-LIST-FETCH
    IF SP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM SORT-BY-SEQ
    PERFORM COMPUTE-TOTALS
    MOVE SP-ALLOC-TOTAL TO SP-GROSS
    PERFORM FILL-REMAINS.

DO-LIST-FETCH.
    MOVE SPACES TO BK-PX-ALLOC-STO-REQ
    MOVE "LIST-BY-PIX" TO WA-OP
    MOVE SP-PIX-ID TO WA-PIX-ID
CALL "BPXPASTO" USING BK-PX-ALLOC-STO-REQ BK-PX-ALLOC-REC
        BK-PX-ALLOC-TBL
MOVE "00" TO SP-RC
    IF WA-RC = "23"
        MOVE "23" TO SP-RC
        MOVE "PIX SPLIT ALLOCATIONS NOT FOUND" TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    IF WA-RC NOT = "00"
        MOVE WA-RC TO SP-RC
        MOVE WA-MSG TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    IF PXA-CNT = 0
        MOVE "23" TO SP-RC
        MOVE "PIX SPLIT ALLOCATIONS NOT FOUND" TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE PXA-CNT TO SP-CNT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        PERFORM COPY-PXA-TO-SP
    END-PERFORM.

COPY-PXA-TO-SP.
    MOVE PXA-SEQ(WS-I) TO SP-PS-SEQ(WS-I)
    MOVE PXA-ALLOC-ID(WS-I) TO SP-PS-ALLOC-ID(WS-I)
    MOVE PXA-DEST-ROLE(WS-I) TO SP-PS-ROLE(WS-I)
    MOVE PXA-DEST-ID(WS-I) TO SP-PS-ID(WS-I)
    MOVE PXA-DEST-CUST(WS-I) TO SP-PS-CUST(WS-I)
    MOVE PXA-DEST-DOC-TYPE(WS-I) TO SP-PS-DOC-TYPE(WS-I)
    MOVE PXA-DEST-DOC(WS-I) TO SP-PS-DOC(WS-I)
    MOVE PXA-DEST-NAME(WS-I) TO SP-PS-NAME(WS-I)
    MOVE PXA-AMOUNT(WS-I) TO SP-PS-AMT(WS-I)
    MOVE PXA-TYPE(WS-I) TO SP-PS-TYPE(WS-I)
    MOVE PXA-REF(WS-I) TO SP-PS-REF(WS-I)
    MOVE PXA-DOC-REF(WS-I) TO SP-PS-DOCREF(WS-I)
    MOVE PXA-TAX-TYPE(WS-I) TO SP-PS-TAXTYPE(WS-I)
    MOVE PXA-TAX-CAT(WS-I) TO SP-PS-TAXCAT(WS-I)
    MOVE PXA-STATUS(WS-I) TO SP-PS-STATUS(WS-I)
    MOVE PXA-ORIG-ALLOC-ID(WS-I) TO SP-PS-ORIG(WS-I)
    MOVE PXA-TXN-ID(WS-I) TO SP-PS-TXN-ID(WS-I)
    MOVE PXA-JRN-ID(WS-I) TO SP-PS-JRN-ID(WS-I).

SORT-BY-SEQ.
    COMPUTE WS-M = SP-CNT - 1
    PERFORM VARYING WS-M FROM WS-M BY -1 UNTIL WS-M < 1
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-M
            IF SP-PS-SEQ(WS-J) > SP-PS-SEQ(WS-J + 1)
                PERFORM SWAP-ROWS
            END-IF
        END-PERFORM
    END-PERFORM.

SWAP-ROWS.
    MOVE SP-PS-SEQ(WS-J) TO WS-T-SEQ
    MOVE SP-PS-SEQ(WS-J + 1) TO SP-PS-SEQ(WS-J)
    MOVE WS-T-SEQ TO SP-PS-SEQ(WS-J + 1)
    MOVE SP-PS-ROLE(WS-J) TO WS-T-ROLE
    MOVE SP-PS-ROLE(WS-J + 1) TO SP-PS-ROLE(WS-J)
    MOVE WS-T-ROLE TO SP-PS-ROLE(WS-J + 1)
    MOVE SP-PS-ID(WS-J) TO WS-T-ID
    MOVE SP-PS-ID(WS-J + 1) TO SP-PS-ID(WS-J)
    MOVE WS-T-ID TO SP-PS-ID(WS-J + 1)
    MOVE SP-PS-CUST(WS-J) TO WS-T-CUST
    MOVE SP-PS-CUST(WS-J + 1) TO SP-PS-CUST(WS-J)
    MOVE WS-T-CUST TO SP-PS-CUST(WS-J + 1)
    MOVE SP-PS-DOC-TYPE(WS-J) TO WS-T-DTYPE
    MOVE SP-PS-DOC-TYPE(WS-J + 1) TO SP-PS-DOC-TYPE(WS-J)
    MOVE WS-T-DTYPE TO SP-PS-DOC-TYPE(WS-J + 1)
    MOVE SP-PS-DOC(WS-J) TO WS-T-DOC
    MOVE SP-PS-DOC(WS-J + 1) TO SP-PS-DOC(WS-J)
    MOVE WS-T-DOC TO SP-PS-DOC(WS-J + 1)
    MOVE SP-PS-NAME(WS-J) TO WS-T-NAME
    MOVE SP-PS-NAME(WS-J + 1) TO SP-PS-NAME(WS-J)
    MOVE WS-T-NAME TO SP-PS-NAME(WS-J + 1)
    MOVE SP-PS-AMT(WS-J) TO WS-T-AMT
    MOVE SP-PS-AMT(WS-J + 1) TO SP-PS-AMT(WS-J)
    MOVE WS-T-AMT TO SP-PS-AMT(WS-J + 1)
    MOVE SP-PS-TYPE(WS-J) TO WS-T-TYPE
    MOVE SP-PS-TYPE(WS-J + 1) TO SP-PS-TYPE(WS-J)
    MOVE WS-T-TYPE TO SP-PS-TYPE(WS-J + 1)
    MOVE SP-PS-REF(WS-J) TO WS-T-REF
    MOVE SP-PS-REF(WS-J + 1) TO SP-PS-REF(WS-J)
    MOVE WS-T-REF TO SP-PS-REF(WS-J + 1)
    MOVE SP-PS-DOCREF(WS-J) TO WS-T-DREF
    MOVE SP-PS-DOCREF(WS-J + 1) TO SP-PS-DOCREF(WS-J)
    MOVE WS-T-DREF TO SP-PS-DOCREF(WS-J + 1)
    MOVE SP-PS-TAXTYPE(WS-J) TO WS-T-TTYPE
    MOVE SP-PS-TAXTYPE(WS-J + 1) TO SP-PS-TAXTYPE(WS-J)
    MOVE WS-T-TTYPE TO SP-PS-TAXTYPE(WS-J + 1)
    MOVE SP-PS-TAXCAT(WS-J) TO WS-T-TCAT
    MOVE SP-PS-TAXCAT(WS-J + 1) TO SP-PS-TAXCAT(WS-J)
    MOVE WS-T-TCAT TO SP-PS-TAXCAT(WS-J + 1)
    MOVE SP-PS-ALLOC-ID(WS-J) TO WS-T-AID
    MOVE SP-PS-ALLOC-ID(WS-J + 1) TO SP-PS-ALLOC-ID(WS-J)
    MOVE WS-T-AID TO SP-PS-ALLOC-ID(WS-J + 1)
    MOVE SP-PS-STATUS(WS-J) TO WS-T-ST
    MOVE SP-PS-STATUS(WS-J + 1) TO SP-PS-STATUS(WS-J)
    MOVE WS-T-ST TO SP-PS-STATUS(WS-J + 1)
    MOVE SP-PS-ORIG(WS-J) TO WS-T-ORIG
    MOVE SP-PS-ORIG(WS-J + 1) TO SP-PS-ORIG(WS-J)
    MOVE WS-T-ORIG TO SP-PS-ORIG(WS-J + 1)
    MOVE SP-PS-TXN-ID(WS-J) TO WS-T-TXN
    MOVE SP-PS-TXN-ID(WS-J + 1) TO SP-PS-TXN-ID(WS-J)
    MOVE WS-T-TXN TO SP-PS-TXN-ID(WS-J + 1)
    MOVE SP-PS-JRN-ID(WS-J) TO WS-T-JRN
    MOVE SP-PS-JRN-ID(WS-J + 1) TO SP-PS-JRN-ID(WS-J)
    MOVE WS-T-JRN TO SP-PS-JRN-ID(WS-J + 1).

DO-GET-ONE.
    MOVE SPACES TO BK-PX-ALLOC-STO-REQ
    MOVE "GET-SEQ" TO WA-OP
    MOVE SP-PIX-ID TO WA-PIX-ID
    MOVE SP-SEQ TO WA-SEQ
    CALL "BPXPASTO" USING BK-PX-ALLOC-STO-REQ BK-PX-ALLOC-REC
        BK-PX-ALLOC-TBL
    IF WA-RC NOT = "00"
        MOVE WA-RC TO SP-RC
        MOVE "PIX SPLIT ALLOCATION NOT FOUND" TO SP-MSG
        GOBACK
    END-IF
    MOVE 1 TO WS-I
    MOVE WA-SEQ TO SP-PS-SEQ(1)
    PERFORM COPY-REC-TO-SP
    MOVE 1 TO SP-CNT
    MOVE SP-PS-AMT(1) TO SP-ALLOC-TOTAL.

COPY-REC-TO-SP.
    MOVE AL-ALLOC-ID OF BK-PX-ALLOC-REC TO SP-PS-ALLOC-ID(WS-I)
    MOVE AL-DEST-ROLE OF BK-PX-ALLOC-REC TO SP-PS-ROLE(WS-I)
    EVALUATE FUNCTION TRIM(AL-DEST-ROLE OF BK-PX-ALLOC-REC)
        WHEN "PARTICIPANT"
            MOVE AL-DEST-PART OF BK-PX-ALLOC-REC TO SP-PS-ID(WS-I)
        WHEN OTHER
            MOVE AL-DEST-ACCT OF BK-PX-ALLOC-REC TO SP-PS-ID(WS-I)
    END-EVALUATE
    MOVE AL-DEST-CUST OF BK-PX-ALLOC-REC TO SP-PS-CUST(WS-I)
    MOVE AL-DEST-DOC-TYPE OF BK-PX-ALLOC-REC
        TO SP-PS-DOC-TYPE(WS-I)
    MOVE AL-DEST-DOC OF BK-PX-ALLOC-REC TO SP-PS-DOC(WS-I)
    MOVE AL-DEST-NAME OF BK-PX-ALLOC-REC TO SP-PS-NAME(WS-I)
    MOVE AL-AMOUNT OF BK-PX-ALLOC-REC TO SP-PS-AMT(WS-I)
    MOVE AL-TYPE OF BK-PX-ALLOC-REC TO SP-PS-TYPE(WS-I)
    MOVE AL-REF OF BK-PX-ALLOC-REC TO SP-PS-REF(WS-I)
    MOVE AL-DOC-REF OF BK-PX-ALLOC-REC TO SP-PS-DOCREF(WS-I)
    MOVE AL-TAX-TYPE OF BK-PX-ALLOC-REC TO SP-PS-TAXTYPE(WS-I)
    MOVE AL-TAX-CAT OF BK-PX-ALLOC-REC TO SP-PS-TAXCAT(WS-I)
    MOVE AL-STATUS OF BK-PX-ALLOC-REC TO SP-PS-STATUS(WS-I)
    MOVE AL-ORIG-ALLOC-ID OF BK-PX-ALLOC-REC TO SP-PS-ORIG(WS-I)
    MOVE AL-TXN-ID OF BK-PX-ALLOC-REC TO SP-PS-TXN-ID(WS-I)
    MOVE AL-JRN-ID OF BK-PX-ALLOC-REC TO SP-PS-JRN-ID(WS-I).

COMPUTE-TOTALS.
    MOVE 0 TO WS-TOTAL WS-TAX WS-EXT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        ADD SP-PS-AMT(WS-I) TO WS-TOTAL
        IF SP-PS-TYPE(WS-I) = "TAX"
            ADD SP-PS-AMT(WS-I) TO WS-TAX
        END-IF
        IF SP-PS-ROLE(WS-I)(1:11) = "PARTICIPANT" AND
           SP-PS-ID(WS-I) NOT = PC-SELF
            ADD SP-PS-AMT(WS-I) TO WS-EXT
        END-IF
    END-PERFORM
    MOVE WS-TOTAL TO SP-ALLOC-TOTAL
    MOVE WS-TAX TO SP-TAX-TOTAL
    MOVE WS-EXT TO SP-EXT-TOTAL.

VALIDATE-STRUCTURE.
    IF SP-CNT < 1 OR SP-CNT > 20
        MOVE "20" TO SP-RC
        MOVE "PIX SPLIT REQUIRES 1 TO 20 ALLOCATIONS" TO SP-MSG
        GOBACK
    END-IF
    IF SP-GROSS <= 0
        MOVE "20" TO SP-RC
        MOVE "PIX SPLIT GROSS MUST BE POSITIVE" TO SP-MSG
        GOBACK
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        IF FUNCTION TRIM(SP-PS-ROLE(WS-I)) NOT = "CUSTOMER" AND
           FUNCTION TRIM(SP-PS-ROLE(WS-I)) NOT = "MERCHANT" AND
           FUNCTION TRIM(SP-PS-ROLE(WS-I)) NOT = "PARTICIPANT" AND
           FUNCTION TRIM(SP-PS-ROLE(WS-I)) NOT = "TAX"
            MOVE "20" TO SP-RC
            MOVE "UNSUPPORTED ALLOCATION ROLE" TO SP-MSG
            GOBACK
        END-IF
        IF FUNCTION TRIM(SP-PS-TYPE(WS-I)) NOT = "MAIN" AND
           FUNCTION TRIM(SP-PS-TYPE(WS-I)) NOT = "TAX"
            MOVE "20" TO SP-RC
            MOVE "UNSUPPORTED ALLOCATION TYPE" TO SP-MSG
            GOBACK
        END-IF
        IF SP-PS-ID(WS-I) = SPACES
            MOVE "20" TO SP-RC
            MOVE "ALLOCATION DESTINATION REQUIRED" TO SP-MSG
            GOBACK
        END-IF
    END-PERFORM.

VALIDATE-SEQUENCE.
    INITIALIZE WS-SEQ-SEEN
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        IF SP-PS-SEQ(WS-I) < 1 OR SP-PS-SEQ(WS-I) > 20
            MOVE "20" TO SP-RC
            MOVE "INVALID ALLOCATION SEQUENCE" TO SP-MSG
            GOBACK
        END-IF
        IF WS-SEEN(SP-PS-SEQ(WS-I)) = "Y"
            MOVE "20" TO SP-RC
            MOVE "DUPLICATE ALLOCATION SEQUENCE" TO SP-MSG
            GOBACK
        END-IF
        MOVE "Y" TO WS-SEEN(SP-PS-SEQ(WS-I))
    END-PERFORM
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        IF WS-SEEN(WS-I) NOT = "Y"
            MOVE "20" TO SP-RC
            MOVE "ALLOCATION SEQUENCE NOT CONTIGUOUS" TO SP-MSG
            GOBACK
        END-IF
    END-PERFORM
    PERFORM CHECK-UNIQUE-ALLOC-IDS.

CHECK-UNIQUE-ALLOC-IDS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        IF SP-PS-ALLOC-ID(WS-I) = SPACES
            EXIT PARAGRAPH
        END-IF
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > SP-CNT
            IF WS-J NOT = WS-I AND
               SP-PS-ALLOC-ID(WS-I) = SP-PS-ALLOC-ID(WS-J)
                MOVE "20" TO SP-RC
                MOVE "DUPLICATE ALLOCATION ID" TO SP-MSG
                GOBACK
            END-IF
        END-PERFORM
    END-PERFORM.

VALIDATE-AMOUNTS.
    MOVE 0 TO WS-TOTAL
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        IF SP-PS-AMT(WS-I) <= 0
            MOVE "20" TO SP-RC
            MOVE "ALLOCATION AMOUNT MUST BE POSITIVE" TO SP-MSG
            GOBACK
        END-IF
        ADD SP-PS-AMT(WS-I) TO WS-TOTAL
    END-PERFORM
    IF WS-TOTAL NOT = SP-GROSS
        MOVE "20" TO SP-RC
        MOVE "PIX SPLIT ALLOCATION SUM != GROSS" TO SP-MSG
    END-IF.

VALIDATE-DESTINATIONS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        EVALUATE FUNCTION TRIM(SP-PS-ROLE(WS-I))
            WHEN "PARTICIPANT"
                MOVE SPACES TO BK-PX-RT-PARMS
                MOVE "PARTICIPANT-GET" TO RT-OP
                MOVE SP-PS-ID(WS-I) TO RT-PART-ID
                CALL "BPXRT" USING BK-PX-RT-PARMS
                IF RT-RC NOT = "00" OR RT-STATUS NOT = "ACTIVE"
                    MOVE "20" TO SP-RC
                    MOVE "ALLOCATION PARTICIPANT NOT ACTIVE"
                        TO SP-MSG
                    GOBACK
                END-IF
            WHEN "TAX"
                CALL "BACQRY" USING SP-PS-ID(WS-I) WS-ACCT-OUT
                IF AO-RC NOT = "00"
                    MOVE SPACES TO BK-PX-RT-PARMS
                    MOVE "PARTICIPANT-GET" TO RT-OP
                    MOVE SP-PS-ID(WS-I) TO RT-PART-ID
                    CALL "BPXRT" USING BK-PX-RT-PARMS
                    IF RT-RC NOT = "00"
                        MOVE "20" TO SP-RC
                        MOVE "TAX DEST NOT RESOLVABLE"
                            TO SP-MSG
                        GOBACK
                    END-IF
                    MOVE SPACES TO WS-ACCT-OUT
                END-IF
            WHEN OTHER
                CALL "BACQRY" USING SP-PS-ID(WS-I) WS-ACCT-OUT
                IF AO-RC NOT = "00"
                    MOVE "20" TO SP-RC
                    MOVE "ALLOCATION ACCOUNT NOT FOUND"
                        TO SP-MSG
                    GOBACK
                END-IF
                IF AO-STATUS NOT = "AC"
                    MOVE "20" TO SP-RC
                    MOVE "ALLOCATION ACCOUNT NOT ACTIVE"
                        TO SP-MSG
                    GOBACK
                END-IF
                IF AO-CURRENCY NOT = SP-CURRENCY
                    MOVE "20" TO SP-RC
                    MOVE "ALLOCATION CURRENCY MISMATCH"
                        TO SP-MSG
                    GOBACK
                END-IF
                MOVE AO-CUST TO SP-PS-CUST(WS-I)
        END-EVALUATE
        IF SP-PS-DOC(WS-I) NOT = SPACES
            PERFORM CANON-DOC
            IF SP-RC NOT = "00"
                GOBACK
            END-IF
        END-IF
    END-PERFORM.

CANON-DOC.
    MOVE SPACES TO WS-DOC-CANON
    MOVE "CANON" TO BD-OP OF BK-DOC-PARMS
    IF FUNCTION TRIM(SP-PS-DOC-TYPE(WS-I)) = SPACES
        MOVE "CNPJ" TO BD-TYPE OF BK-DOC-PARMS
    ELSE
        MOVE SP-PS-DOC-TYPE(WS-I) TO BD-TYPE OF BK-DOC-PARMS
    END-IF
    MOVE SP-PS-DOC(WS-I) TO BD-IN OF BK-DOC-PARMS
    CALL "BDOC" USING BK-DOC-PARMS
    IF BD-RC NOT = "00"
        MOVE "20" TO SP-RC
        MOVE BD-MSG TO SP-MSG
        GOBACK
    END-IF
    MOVE BD-CANON(1:20) TO SP-PS-DOC(WS-I).

VALIDATE-TAX-METADATA.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        IF FUNCTION TRIM(SP-PS-ROLE(WS-I)) = "TAX" AND
           FUNCTION TRIM(SP-PS-TYPE(WS-I)) NOT = "TAX"
            MOVE "20" TO SP-RC
            MOVE "INVALID TAX ALLOCATION" TO SP-MSG
            GOBACK
        END-IF
        IF FUNCTION TRIM(SP-PS-TYPE(WS-I)) = "TAX"
            IF SP-PS-TAXTYPE(WS-I) = SPACES
                MOVE "20" TO SP-RC
                MOVE "TAX TYPE REQUIRED" TO SP-MSG
                GOBACK
            END-IF
            IF SP-PS-TAXCAT(WS-I) = SPACES
                MOVE "20" TO SP-RC
                MOVE "TAX CATEGORY REQUIRED" TO SP-MSG
                GOBACK
            END-IF
            IF SP-PS-DOCREF(WS-I) = SPACES
                MOVE "20" TO SP-RC
                MOVE "TAX DOCUMENT REFERENCE REQUIRED" TO SP-MSG
                GOBACK
            END-IF
            IF SP-PS-DOC(WS-I) NOT = SPACES AND
               SP-PS-DOC-TYPE(WS-I) = SPACES
                MOVE "20" TO SP-RC
                MOVE "TAX DOCUMENT TYPE REQUIRED" TO SP-MSG
                GOBACK
            END-IF
        ELSE
            IF SP-PS-TAXTYPE(WS-I) NOT = SPACES OR
               SP-PS-TAXCAT(WS-I) NOT = SPACES OR
               SP-PS-DOCREF(WS-I) NOT = SPACES
                MOVE "20" TO SP-RC
                MOVE "TAX METADATA ON NON-TAX ALLOCATION"
                    TO SP-MSG
                GOBACK
            END-IF
        END-IF
    END-PERFORM.

CHECK-EXISTING-MATCH.
    IF WS-M NOT = PXA-CNT
        MOVE "20" TO SP-RC
        MOVE "PIX SPLIT REPLAY MISMATCH" TO SP-MSG
        GOBACK
    END-IF
    MOVE "Y" TO WS-SAME
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        MOVE SPACES TO BK-PX-ALLOC-STO-REQ
        MOVE "GET-SEQ" TO WA-OP
        MOVE SP-PIX-ID TO WA-PIX-ID
        MOVE SP-PS-SEQ(WS-I) TO WA-SEQ
        CALL "BPXPASTO" USING BK-PX-ALLOC-STO-REQ
            BK-PX-ALLOC-REC BK-PX-ALLOC-TBL
        IF WA-RC NOT = "00"
            MOVE "N" TO WS-SAME
        ELSE
            IF AL-AMOUNT OF BK-PX-ALLOC-REC NOT =
               SP-PS-AMT(WS-I) OR
               FUNCTION TRIM(AL-DEST-ROLE OF BK-PX-ALLOC-REC)
               NOT = FUNCTION TRIM(SP-PS-ROLE(WS-I)) OR
               AL-SEQ OF BK-PX-ALLOC-REC NOT = SP-PS-SEQ(WS-I)
                MOVE "N" TO WS-SAME
            END-IF
        END-IF
    END-PERFORM
    IF WS-SAME NOT = "Y"
        MOVE "20" TO SP-RC
        MOVE "PIX SPLIT REPLAY MISMATCH" TO SP-MSG
        GOBACK
    END-IF.

COMPUTE-ALLOC-HASH.
    MOVE SPACES TO WS-HASH-BUF
    MOVE AL-AMOUNT OF BK-PX-ALLOC-REC TO WS-AMT-ED
    STRING AL-PIX-ID OF BK-PX-ALLOC-REC DELIMITED SIZE "|"
        DELIMITED SIZE AL-SEQ OF BK-PX-ALLOC-REC DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(AL-DEST-ROLE
        OF BK-PX-ALLOC-REC) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(AL-ALLOC-ID OF BK-PX-ALLOC-REC)
        DELIMITED SIZE "|" DELIMITED SIZE WS-AMT-ED
        DELIMITED SIZE "|" DELIMITED SIZE FUNCTION TRIM(AL-TYPE
        OF BK-PX-ALLOC-REC) DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 200 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO AL-HASH OF BK-PX-ALLOC-REC.
DO-REV-CREATE.
    PERFORM LOCK-ORIG-PIX
    IF SP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM PROBE-EXISTING-REVERSAL
    IF SP-REPLAY = "Y"
        PERFORM UNLOCK-ORIG-PIX
        GOBACK
    END-IF
    IF SP-RC NOT = "00"
        PERFORM UNLOCK-ORIG-PIX
        GOBACK
    END-IF
    PERFORM VALIDATE-REVERSAL-STRUCTURE
    IF SP-RC NOT = "00"
        PERFORM UNLOCK-ORIG-PIX
        GOBACK
    END-IF
    PERFORM FETCH-ORIGINAL-ALLOCATIONS
    IF SP-RC NOT = "00"
        PERFORM UNLOCK-ORIG-PIX
        GOBACK
    END-IF
    PERFORM BUILD-REVERSAL-HEADER
    IF SP-RC = "00"
        PERFORM WRITE-REVERSAL-HEADER
    END-IF
    PERFORM UNLOCK-ORIG-PIX
    IF SP-RC NOT = "00"
        GOBACK
    END-IF.

LOCK-ORIG-PIX.
    MOVE SPACES TO WS-LK-NAME
    STRING "PIXREV-" DELIMITED SIZE FUNCTION TRIM(SP-PIX-ID)
        DELIMITED SIZE INTO WS-LK-NAME
    END-STRING
    IF FUNCTION TRIM(SP-OPERATOR) = SPACES
        MOVE "SYSTEM" TO WS-LK-OWNER
    ELSE
        MOVE FUNCTION TRIM(SP-OPERATOR) TO WS-LK-OWNER
    END-IF
    MOVE "A" TO WS-LK-MODE
    CALL "BLCK" USING WS-LK-NAME WS-LK-OWNER WS-LK-MODE WS-LK-ST
    IF WS-LK-ST NOT = "00"
        MOVE "24" TO SP-RC
        MOVE "PIX REVERSAL LOCKED" TO SP-MSG
    END-IF.

UNLOCK-ORIG-PIX.
    MOVE "R" TO WS-LK-MODE
    CALL "BLCK" USING WS-LK-NAME WS-LK-OWNER WS-LK-MODE WS-LK-ST.

PROBE-EXISTING-REVERSAL.
    MOVE SPACES TO BK-PX-RV-STO-REQ
    MOVE "GET-REQ" TO RVQ-OP
    MOVE SP-PIX-ID TO RVQ-ORIG-PIX-ID
    MOVE SP-REQ-ID TO RVQ-REQUEST
    CALL "BPXRVS" USING BK-PX-RV-STO-REQ BK-PX-RV-PARMS
        BK-PX-RV-LIST
    IF RVQ-RC = "23"
        MOVE "00" TO SP-RC
        MOVE SPACES TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    IF RVQ-RC NOT = "00"
        MOVE RVQ-RC TO SP-RC
        MOVE RVQ-MSG TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    IF RV-STATUS OF BK-PX-RV-PARMS = "FAILED"
        MOVE "24" TO SP-RC
        MOVE "SPLIT REVERSAL FAILED; RETRY NEW REQUEST" TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    IF RV-STATUS OF BK-PX-RV-PARMS = "POSTED"
        MOVE "Y" TO SP-REPLAY
        MOVE BK-PX-RV-PARMS TO WS-RV-HDR
        PERFORM COPY-HEADER-TO-SP
        MOVE "00" TO SP-RC
        MOVE "SPLIT REVERSAL ALREADY APPLIED" TO SP-MSG
    ELSE
        MOVE "24" TO SP-RC
        MOVE "SPLIT REVERSAL REQUEST IN PROGRESS" TO SP-MSG
    END-IF.

VALIDATE-REVERSAL-STRUCTURE.
    MOVE "00" TO SP-RC
    MOVE SPACES TO SP-MSG
    IF SP-CNT < 1 OR SP-CNT > 20
        MOVE "20" TO SP-RC
        MOVE "INVALID REVERSAL LEG COUNT" TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    IF SP-PIX-ID = SPACES
        MOVE "20" TO SP-RC
        MOVE "ORIG PIX ID REQUIRED" TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    IF SP-REQ-ID = SPACES
        MOVE "20" TO SP-RC
        MOVE "REVERSAL REQUEST ID REQUIRED" TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE 0 TO WS-TOTAL
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        IF SP-PS-ORIG(WS-I) = SPACES
            MOVE "20" TO SP-RC
            MOVE "REVERSAL ORIGINAL ALLOC REQUIRED" TO SP-MSG
            EXIT PARAGRAPH
        END-IF
        IF SP-PS-AMT(WS-I) <= 0
            MOVE "20" TO SP-RC
            MOVE "REVERSAL AMOUNT MUST BE POSITIVE" TO SP-MSG
            EXIT PARAGRAPH
        END-IF
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > SP-CNT
            IF WS-J NOT = WS-I AND
               SP-PS-ORIG(WS-J) = SP-PS-ORIG(WS-I)
                MOVE "20" TO SP-RC
                MOVE "DUPLICATE ORIGINAL ALLOC IN REVERSAL"
                    TO SP-MSG
                EXIT PARAGRAPH
            END-IF
        END-PERFORM
        IF SP-RC NOT = "00"
            EXIT PARAGRAPH
        END-IF
        ADD SP-PS-AMT(WS-I) TO WS-TOTAL
    END-PERFORM.

FETCH-ORIGINAL-ALLOCATIONS.
    MOVE SPACES TO BK-PX-ALLOC-STO-REQ
    MOVE "LIST-BY-PIX" TO WA-OP
    MOVE SP-PIX-ID TO WA-PIX-ID
    CALL "BPXPASTO" USING BK-PX-ALLOC-STO-REQ BK-PX-ALLOC-REC
        BK-PX-ALLOC-TBL
    IF WA-RC NOT = "00"
        MOVE WA-RC TO SP-RC
        MOVE WA-MSG TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    IF PXA-CNT = 0
        MOVE "23" TO SP-RC
        MOVE "PIX SPLIT NOT FOUND" TO SP-MSG
        EXIT PARAGRAPH
    END-IF.

BUILD-REVERSAL-HEADER.
    MOVE SPACES TO WS-RV-HDR
    IF SP-DEVID NOT = SPACES
        MOVE SP-DEVID TO RV-REV-ID OF WS-RV-HDR
    ELSE
        MOVE "REVW" TO WS-ID-TYPE
        MOVE SPACES TO WS-ID-ISPB
        CALL "BPXID" USING WS-ID-TYPE WS-ID-ISPB WS-ID-VAL
            WS-ID-RC
        IF WS-ID-RC NOT = "00"
            MOVE "20" TO SP-RC
            MOVE "REVERSAL ID ERROR" TO SP-MSG
            EXIT PARAGRAPH
        END-IF
        MOVE WS-ID-VAL TO RV-REV-ID OF WS-RV-HDR
    END-IF
    MOVE SP-PIX-ID TO RV-ORIG-PIX-ID OF WS-RV-HDR
    MOVE SP-ORIG-TXN-ID TO RV-ORIG-TXN-ID OF WS-RV-HDR
    MOVE SP-ORIG-JRN-ID TO RV-ORIG-JRN-ID OF WS-RV-HDR
    MOVE SP-REQ-ID TO RV-REQUEST OF WS-RV-HDR
    IF SP-CURRENCY = SPACES
        MOVE WS-CURRENCY TO RV-CURRENCY OF WS-RV-HDR
    ELSE
        MOVE SP-CURRENCY TO RV-CURRENCY OF WS-RV-HDR
    END-IF
    MOVE "RESERVED" TO RV-STATUS OF WS-RV-HDR
    MOVE SP-GROSS TO RV-ORIG-GROSS OF WS-RV-HDR
    MOVE 0 TO RV-GROSS OF WS-RV-HDR
    MOVE SP-CNT TO RV-CNT OF WS-RV-HDR
    MOVE SP-BIZDATE TO RV-BIZDATE OF WS-RV-HDR
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW TO RV-CREATED OF WS-RV-HDR
    MOVE WS-NOW TO RV-UPDATED OF WS-RV-HDR
    MOVE 1 TO RV-VERSION OF WS-RV-HDR
    MOVE SP-OPERATOR TO RV-OPERATOR OF WS-RV-HDR
    MOVE SP-CORR TO RV-CORR OF WS-RV-HDR
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        MOVE SP-PS-ORIG(WS-I) TO WS-RV-FORIG
        MOVE "N" TO WS-ORIG-FOUND
        PERFORM VARYING WS-Q FROM 1 BY 1 UNTIL WS-Q > PXA-CNT
            IF PXA-ALLOC-ID(WS-Q) = WS-RV-FORIG
                MOVE "Y" TO WS-ORIG-FOUND
                MOVE WS-Q TO WS-HIT
                IF PXA-STATUS(WS-Q) NOT = "POSTED" AND
                   PXA-STATUS(WS-Q) NOT = "SETTLED" AND
                   PXA-STATUS(WS-Q) NOT = "RECONCILED"
                    MOVE "20" TO SP-RC
                    MOVE "SPLIT LEG NOT POSTED YET" TO SP-MSG
                    EXIT PARAGRAPH
                END-IF
                PERFORM CHECK-REVERSAL-REMAIN
                IF SP-RC NOT = "00"
                    EXIT PARAGRAPH
                END-IF
                MOVE WS-RV-FORIG TO RV-PS-ORIG OF WS-RV-HDR(WS-I)
                MOVE PXA-DEST-ROLE(WS-HIT) TO RV-PS-ROLE OF WS-RV-HDR(WS-I)
                MOVE PXA-DEST-ID(WS-HIT) TO RV-PS-ACCT OF WS-RV-HDR(WS-I)
                MOVE PXA-TYPE(WS-HIT) TO RV-PS-TYPE OF WS-RV-HDR(WS-I)
                MOVE PXA-REF(WS-HIT) TO RV-PS-REF OF WS-RV-HDR(WS-I)
                MOVE PXA-DOC-REF(WS-HIT) TO RV-PS-DOCREF OF WS-RV-HDR(WS-I)
                MOVE PXA-TAX-TYPE(WS-HIT) TO RV-PS-TAXTYPE OF WS-RV-HDR(WS-I)
                MOVE PXA-TAX-CAT(WS-HIT) TO RV-PS-TAXCAT OF WS-RV-HDR(WS-I)
            END-IF
        END-PERFORM
        IF WS-ORIG-FOUND NOT = "Y"
            MOVE "20" TO SP-RC
            MOVE "SPLIT LEG NOT FOUND" TO SP-MSG
            EXIT PARAGRAPH
        END-IF
        MOVE WS-I TO RV-PS-SEQ OF WS-RV-HDR(WS-I)
        MOVE SP-PS-AMT(WS-I) TO RV-PS-AMT OF WS-RV-HDR(WS-I)
        MOVE SPACES TO WS-ID-VAL
        MOVE "SPL" TO WS-ID-TYPE
        CALL "BPXID" USING WS-ID-TYPE WS-ID-ISPB WS-ID-VAL
            WS-ID-RC
        IF WS-ID-RC NOT = "00"
            MOVE "20" TO SP-RC
            MOVE "REVERSAL LEG ID ERROR" TO SP-MSG
            EXIT PARAGRAPH
        END-IF
        MOVE WS-ID-VAL TO RV-PS-ALLOC-ID OF WS-RV-HDR(WS-I)
        MOVE "RESERVED" TO RV-PS-STATUS OF WS-RV-HDR(WS-I)
        ADD SP-PS-AMT(WS-I) TO RV-GROSS OF WS-RV-HDR
    END-PERFORM
    IF SP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF.

CHECK-REVERSAL-REMAIN.
    MOVE 0 TO WS-RV-REVSUM
    PERFORM LIST-HEADERS-BY-PIX
    IF SP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > RVL-CNT
        PERFORM GET-HEADER-BY-REV-ID
        IF SP-RC NOT = "00"
            EXIT PARAGRAPH
        END-IF
        PERFORM VARYING WS-Q FROM 1 BY 1
            UNTIL WS-Q > RV-CNT OF BK-PX-RV-PARMS
            IF RV-PS-ORIG OF BK-PX-RV-PARMS(WS-Q) =
               WS-RV-FORIG AND
               RV-PS-STATUS OF BK-PX-RV-PARMS(WS-Q) NOT =
               "FAILED"
                ADD RV-PS-AMT OF BK-PX-RV-PARMS(WS-Q) TO
                    WS-RV-REVSUM
            END-IF
        END-PERFORM
    END-PERFORM
    MOVE SP-PS-AMT(WS-I) TO WS-RV-DUP
    ADD WS-RV-REVSUM TO WS-RV-DUP
    PERFORM VARYING WS-Q FROM 1 BY 1 UNTIL WS-Q > PXA-CNT
        IF PXA-ALLOC-ID(WS-Q) = WS-RV-FORIG
            IF WS-RV-DUP > PXA-AMOUNT(WS-Q)
                MOVE "20" TO SP-RC
                MOVE "REVERSAL EXCEEDS REMAINING LEG AMOUNT"
                    TO SP-MSG
            END-IF
        END-IF
    END-PERFORM.

LIST-HEADERS-BY-PIX.
    MOVE SPACES TO BK-PX-RV-STO-REQ
    MOVE "LIST-BY-PIX" TO RVQ-OP
    MOVE SP-PIX-ID TO RVQ-ORIG-PIX-ID
    CALL "BPXRVS" USING BK-PX-RV-STO-REQ BK-PX-RV-PARMS
        BK-PX-RV-LIST
    IF RVQ-RC = "23"
        MOVE 0 TO RVL-CNT
        MOVE "00" TO SP-RC
    ELSE
        MOVE RVQ-RC TO SP-RC
    END-IF.

GET-HEADER-BY-REV-ID.
    MOVE SPACES TO BK-PX-RV-STO-REQ
    MOVE "GET" TO RVQ-OP
    MOVE RVL-REV-ID(WS-J) TO RVQ-REV-ID
    CALL "BPXRVS" USING BK-PX-RV-STO-REQ BK-PX-RV-PARMS
        BK-PX-RV-LIST
    IF RVQ-RC NOT = "00"
        MOVE RVQ-RC TO SP-RC
    END-IF.

WRITE-REVERSAL-HEADER.
    PERFORM COMPUTE-REV-HASH
    MOVE SPACES TO BK-PX-RV-STO-REQ
    MOVE "WRITE" TO RVQ-OP
    MOVE RV-REV-ID OF WS-RV-HDR TO RVQ-REV-ID
    CALL "BPXRVS" USING BK-PX-RV-STO-REQ WS-RV-HDR BK-PX-RV-LIST
    IF RVQ-RC NOT = "00"
        MOVE RVQ-RC TO SP-RC
        MOVE RVQ-MSG TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-RV-HDR TO BK-PX-RV-PARMS
    PERFORM COPY-HEADER-TO-SP.

COMPUTE-REV-HASH.
    MOVE RV-GROSS OF WS-RV-HDR TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(RV-REV-ID OF WS-RV-HDR) DELIMITED SIZE
        "|" DELIMITED SIZE
        FUNCTION TRIM(RV-ORIG-PIX-ID OF WS-RV-HDR)
        DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(RV-REQUEST OF WS-RV-HDR) DELIMITED SIZE
        "|" DELIMITED SIZE WS-AMT-ED DELIMITED SIZE "|"
        DELIMITED SIZE RV-STATUS OF WS-RV-HDR DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 200 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO RV-HASH OF WS-RV-HDR.

COPY-HEADER-TO-SP.
    MOVE RV-REV-ID OF BK-PX-RV-PARMS TO SP-REV-ID
    MOVE RV-ORIG-PIX-ID OF BK-PX-RV-PARMS TO SP-PIX-ID
    MOVE RV-REQUEST OF BK-PX-RV-PARMS TO SP-REQ-ID
    MOVE RV-STATUS OF BK-PX-RV-PARMS TO SP-STATUS
    MOVE RV-GROSS OF BK-PX-RV-PARMS TO SP-GROSS
    MOVE RV-GROSS OF BK-PX-RV-PARMS TO SP-REVERSED-TOTAL
    MOVE RV-CNT OF BK-PX-RV-PARMS TO SP-R-CNT
    MOVE RV-TXN-ID OF BK-PX-RV-PARMS TO SP-TXN-ID
    MOVE RV-JRN-ID OF BK-PX-RV-PARMS TO SP-JRN-ID
    PERFORM VARYING WS-I FROM 1 BY 1
        UNTIL WS-I > RV-CNT OF BK-PX-RV-PARMS
        MOVE RV-PS-SEQ OF BK-PX-RV-PARMS(WS-I) TO
            SP-RS-SEQ(WS-I)
        MOVE RV-PS-ORIG OF BK-PX-RV-PARMS(WS-I) TO
            SP-RS-ORIG(WS-I)
        MOVE RV-PS-ROLE OF BK-PX-RV-PARMS(WS-I) TO
            SP-RS-ROLE(WS-I)
        MOVE RV-PS-ACCT OF BK-PX-RV-PARMS(WS-I) TO
            SP-RS-ACCT(WS-I)
        MOVE RV-PS-AMT OF BK-PX-RV-PARMS(WS-I) TO
            SP-RS-AMT(WS-I)
        MOVE RV-PS-TYPE OF BK-PX-RV-PARMS(WS-I) TO
            SP-RS-TYPE(WS-I)
        MOVE RV-PS-ALLOC-ID OF BK-PX-RV-PARMS(WS-I) TO
            SP-RS-ALLOC-ID(WS-I)
        MOVE RV-PS-STATUS OF BK-PX-RV-PARMS(WS-I) TO
            SP-RS-STATUS(WS-I)
        MOVE RV-PS-TXN-ID OF BK-PX-RV-PARMS(WS-I) TO
            SP-RS-TXN-ID(WS-I)
        MOVE RV-PS-JRN-ID OF BK-PX-RV-PARMS(WS-I) TO
            SP-RS-JRN-ID(WS-I)
    END-PERFORM.

DO-REV-MARK.
    PERFORM LOCK-ORIG-PIX
    IF SP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM GET-REVERSAL-HEADER
    IF SP-RC = "00"
        PERFORM APPLY-REVERSAL-MARK
        IF SP-RC = "00"
            PERFORM COMPUTE-REV-HASH
            MOVE SPACES TO BK-PX-RV-STO-REQ
            MOVE "REWRITE" TO RVQ-OP
            MOVE RV-REV-ID OF WS-RV-HDR TO RVQ-REV-ID
            CALL "BPXRVS" USING BK-PX-RV-STO-REQ WS-RV-HDR
                BK-PX-RV-LIST
            IF RVQ-RC NOT = "00"
                MOVE RVQ-RC TO SP-RC
                MOVE RVQ-MSG TO SP-MSG
            ELSE
                MOVE WS-RV-HDR TO BK-PX-RV-PARMS
                PERFORM COPY-HEADER-TO-SP
            END-IF
        END-IF
    END-IF
    PERFORM UNLOCK-ORIG-PIX.

GET-REVERSAL-HEADER.
    IF SP-REV-ID = SPACES
        MOVE "20" TO SP-RC
        MOVE "REVERSAL ID REQUIRED" TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-RV-STO-REQ
    MOVE "GET" TO RVQ-OP
    MOVE SP-REV-ID TO RVQ-REV-ID
    CALL "BPXRVS" USING BK-PX-RV-STO-REQ BK-PX-RV-PARMS
        BK-PX-RV-LIST
    IF RVQ-RC NOT = "00"
        MOVE RVQ-RC TO SP-RC
        MOVE "SPLIT REVERSAL NOT FOUND" TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-RV-PARMS TO WS-RV-HDR.

APPLY-REVERSAL-MARK.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    EVALUATE FUNCTION TRIM(SP-STATUS)
        WHEN "POSTED"
            IF RV-STATUS OF WS-RV-HDR = "POSTED"
                IF RV-TXN-ID OF WS-RV-HDR = SP-TXN-ID AND
                   RV-JRN-ID OF WS-RV-HDR = SP-JRN-ID
                    MOVE "00" TO SP-RC
                    MOVE "SPLIT REVERSAL REPLAY" TO SP-MSG
                    EXIT PARAGRAPH
                END-IF
                MOVE "20" TO SP-RC
                MOVE "SPLIT REVERSAL STATE CONFLICT" TO SP-MSG
                EXIT PARAGRAPH
            END-IF
            IF RV-STATUS OF WS-RV-HDR = "FAILED"
                MOVE "20" TO SP-RC
                MOVE "SPLIT REVERSAL FAILED CANNOT POST"
                    TO SP-MSG
                EXIT PARAGRAPH
            END-IF
            MOVE "POSTED" TO RV-STATUS OF WS-RV-HDR
            MOVE SP-TXN-ID TO RV-TXN-ID OF WS-RV-HDR
            MOVE SP-JRN-ID TO RV-JRN-ID OF WS-RV-HDR
            PERFORM VARYING WS-I FROM 1 BY 1
                UNTIL WS-I > RV-CNT OF WS-RV-HDR
                MOVE "POSTED" TO RV-PS-STATUS OF WS-RV-HDR
                    (WS-I)
                MOVE SP-TXN-ID TO RV-PS-TXN-ID
                    OF WS-RV-HDR(WS-I)
                MOVE SP-JRN-ID TO RV-PS-JRN-ID
                    OF WS-RV-HDR(WS-I)
            END-PERFORM
        WHEN "FAILED"
            IF RV-STATUS OF WS-RV-HDR = "POSTED"
                MOVE "20" TO SP-RC
                MOVE "POSTED REVERSAL CANNOT FAIL" TO SP-MSG
                EXIT PARAGRAPH
            END-IF
            IF RV-STATUS OF WS-RV-HDR = "FAILED"
                EXIT PARAGRAPH
            END-IF
            MOVE "FAILED" TO RV-STATUS OF WS-RV-HDR
            PERFORM VARYING WS-I FROM 1 BY 1
                UNTIL WS-I > RV-CNT OF WS-RV-HDR
                MOVE "FAILED" TO RV-PS-STATUS
                    OF WS-RV-HDR(WS-I)
            END-PERFORM
        WHEN OTHER
            MOVE "20" TO SP-RC
            MOVE "UNKNOWN REVERSAL MARK STATUS" TO SP-MSG
            EXIT PARAGRAPH
    END-EVALUATE
    MOVE WS-NOW TO RV-UPDATED OF WS-RV-HDR
    ADD 1 TO RV-VERSION OF WS-RV-HDR.

DO-REV-LIST.
    MOVE SPACES TO BK-PX-RV-STO-REQ
    MOVE "LIST-BY-PIX" TO RVQ-OP
    MOVE SP-PIX-ID TO RVQ-ORIG-PIX-ID
    CALL "BPXRVS" USING BK-PX-RV-STO-REQ BK-PX-RV-PARMS
        BK-PX-RV-LIST
    MOVE RVQ-RC TO SP-RC
    IF RVQ-RC NOT = "00"
        MOVE RVQ-MSG TO SP-MSG
        MOVE 0 TO SP-R-CNT
        EXIT PARAGRAPH
    END-IF
    MOVE RVL-CNT TO SP-R-CNT
    MOVE RVQ-DEVOLVED TO SP-DEVOLVED
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > RVL-CNT
        MOVE RVL-REV-ID(WS-I) TO SP-RS-SEQ(WS-I)
        MOVE RVL-STATUS(WS-I) TO SP-RS-STATUS(WS-I)
        MOVE RVL-TXN-ID(WS-I) TO SP-RS-TXN-ID(WS-I)
        MOVE RVL-JRN-ID(WS-I) TO SP-RS-JRN-ID(WS-I)
        MOVE RVL-REQUEST(WS-I) TO SP-RS-ORIG(WS-I)
        MOVE RVL-GROSS(WS-I) TO SP-RS-AMT(WS-I)
    END-PERFORM.

DO-REV-GET.
    IF SP-REV-ID = SPACES AND SP-REQ-ID = SPACES
        MOVE "20" TO SP-RC
        MOVE "REVERSAL ID OR REQUEST REQUIRED" TO SP-MSG
        GOBACK
    END-IF
    MOVE SPACES TO BK-PX-RV-STO-REQ
    IF SP-REV-ID NOT = SPACES
        MOVE "GET" TO RVQ-OP
        MOVE SP-REV-ID TO RVQ-REV-ID
        CALL "BPXRVS" USING BK-PX-RV-STO-REQ BK-PX-RV-PARMS
            BK-PX-RV-LIST
    ELSE
        MOVE "GET-REQ" TO RVQ-OP
        MOVE SP-PIX-ID TO RVQ-ORIG-PIX-ID
        MOVE SP-REQ-ID TO RVQ-REQUEST
        CALL "BPXRVS" USING BK-PX-RV-STO-REQ BK-PX-RV-PARMS
            BK-PX-RV-LIST
    END-IF
    IF RVQ-RC NOT = "00"
        MOVE RVQ-RC TO SP-RC
        MOVE "SPLIT REVERSAL NOT FOUND" TO SP-MSG
        GOBACK
    END-IF
    PERFORM COPY-HEADER-TO-SP
    PERFORM LIST-HEADERS-BY-PIX
    IF SP-RC NOT = "00"
        MOVE "00" TO SP-RC
    END-IF
    MOVE RV-ORIG-GROSS OF BK-PX-RV-PARMS TO SP-GROSS
    MOVE RVQ-DEVOLVED TO SP-REVERSED-TOTAL
    MOVE SP-REVERSED-TOTAL TO SP-DEVOLVED
    COMPUTE SP-REMAIN = RV-ORIG-GROSS OF BK-PX-RV-PARMS -
        SP-REVERSED-TOTAL
    IF SP-REMAIN < 0
        MOVE 0 TO SP-REMAIN
    END-IF
    MOVE "00" TO SP-RC
    MOVE "SPLIT REVERSAL" TO SP-MSG.

FILL-REMAINS.
    MOVE "00" TO SP-RC
    PERFORM LIST-HEADERS-BY-PIX
    IF SP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        MOVE 0 TO SP-PS-REMAIN(WS-I)
    END-PERFORM
    MOVE 0 TO WS-RV-TOTAL
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > RVL-CNT
        PERFORM GET-HEADER-BY-REV-ID
        IF SP-RC NOT = "00"
            EXIT PARAGRAPH
        END-IF
        IF RV-STATUS OF BK-PX-RV-PARMS NOT = "FAILED"
            ADD RV-GROSS OF BK-PX-RV-PARMS TO WS-RV-TOTAL
            PERFORM VARYING WS-K FROM 1 BY 1
                UNTIL WS-K > RV-CNT OF BK-PX-RV-PARMS
                IF RV-PS-STATUS OF BK-PX-RV-PARMS(WS-K) NOT =
                "FAILED"
                    MOVE RV-PS-ORIG OF BK-PX-RV-PARMS(WS-K) TO
                        WS-RV-FORIG
                    PERFORM VARYING WS-Q FROM 1 BY 1
                        UNTIL WS-Q > SP-CNT
                        IF SP-PS-ALLOC-ID(WS-Q) =
                        WS-RV-FORIG
                            ADD RV-PS-AMT
                                OF BK-PX-RV-PARMS(WS-K) TO
                                SP-PS-REMAIN(WS-Q)
                        END-IF
                    END-PERFORM
                END-IF
            END-PERFORM
        END-IF
    END-PERFORM
    IF SP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-RV-TOTAL TO SP-REVERSED-TOTAL
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SP-CNT
        COMPUTE SP-PS-REMAIN(WS-I) = SP-PS-AMT(WS-I) -
            SP-PS-REMAIN(WS-I)
    END-PERFORM
    MOVE SP-REVERSED-TOTAL TO SP-DEVOLVED
    COMPUTE SP-REMAIN = SP-GROSS - SP-REVERSED-TOTAL
    IF SP-REMAIN < 0
        MOVE 0 TO SP-REMAIN
    END-IF.
