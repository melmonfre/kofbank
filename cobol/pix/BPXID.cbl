E2E-ID.
    MOVE "PIX-E2E" TO WS-SEQ-NAME
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO LS-RC
        GOBACK
    END-IF
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO LS-VALUE(9:14)
    MOVE WS-SEQ TO WS-NUM
    MOVE WS-NUM TO WS-ED10
    MOVE LS-ISPB TO LS-VALUE(1:8)
    MOVE WS-ED10 TO LS-VALUE(23:10).

TXID-ID.
    MOVE "PIX-TXID" TO WS-SEQ-NAME
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO LS-RC
        GOBACK
    END-IF
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO LS-VALUE(9:14)
    MOVE WS-SEQ TO WS-NUM
    MOVE WS-NUM TO WS-ED10
    MOVE LS-ISPB TO LS-VALUE(1:8)
    MOVE WS-ED10 TO LS-VALUE(23:10).
