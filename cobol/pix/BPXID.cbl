    END-IF
    MOVE WS-SEQ TO WS-NUM
    MOVE WS-NUM TO WS-ED11
    STRING "R" DELIMITED SIZE WS-ED11 DELIMITED SIZE
        INTO LS-VALUE
    END-STRING.

