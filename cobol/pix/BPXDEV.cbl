IDENTIFICATION DIVISION.
PROGRAM-ID. BPXDEV.

*> Pix devolution (including MED-driven refunds).
*> A devolution is a NEW Pix transaction moving money in the opposite
*> direction of the original; the financial effect still goes through the
*> transaction lifecycle, so the ledger stays the only monetary authority.
*> The window is an institution-side operating rule read from etc/pix.cfg
*> (devolution-window-days); the authoritative definition belongs to the
*> Pix Regulation Book and SPI rules and must be revalidated before use.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BPXCFG".
COPY "BPXSTO".
COPY "BDATP".
COPY "BKAUDP".
COPY "BKEVTP".
01 BK-PX-REC.
   COPY "BPX".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-ORIG.
   05 WS-ORIG-ID          PIC X(12).
   05 WS-ORIG-DIRECTION   PIC X(08).
   05 WS-ORIG-ENV         PIC X(08).
   05 WS-ORIG-STATUS      PIC X(12).
   05 WS-ORIG-DEV-STATUS  PIC X(12).
   05 WS-ORIG-DEV-PIX-ID  PIC X(12).
   05 WS-ORIG-AMOUNT      PIC S9(15)V99 COMP-3.
   05 WS-ORIG-CURRENCY    PIC X(03).
   05 WS-ORIG-BLOCK-AMT   PIC S9(15)V99 COMP-3.
   05 WS-ORIG-PAYER-ACCT  PIC X(12).
   05 WS-ORIG-PAYER-CUST  PIC X(12).
   05 WS-ORIG-PAYER-PART  PIC X(12).
   05 WS-ORIG-PAYEE-ACCT  PIC X(12).
   05 WS-ORIG-PAYEE-CUST  PIC X(12).
   05 WS-ORIG-PAYEE-PART  PIC X(12).
   05 WS-ORIG-POST-DATE   PIC 9(08).
   05 WS-ORIG-VERSION     PIC 9(05).
   05 WS-ORIG-CREATED     PIC 9(14).
   05 WS-ORIG-UPDATED     PIC 9(14).
   05 WS-ORIG-LOCAL      PIC X(01).
01 WS-ID-TYPE PIC X(08).
01 WS-ID-ISPB PIC 9(08).
01 WS-ID-VAL PIC X(32).
01 WS-ID-RC PIC X(02).
COPY "BPXPP" REPLACING
            BK-PX-PARMS BY WS-DEV-PARMS,
            XP-OP BY XD-OP,
            XP-PIX-ID BY XD-PIX-ID,
            XP-ORIG-PIX-ID BY XD-ORIG-PIX-ID,
            XP-DIRECTION BY XD-DIRECTION,
            XP-MODALITY BY XD-MODALITY,
            XP-ENV BY XD-ENV,
            XP-E2E-ID BY XD-E2E-ID,
            XP-EXT-REF BY XD-EXT-REF,
            XP-KEY-ID BY XD-KEY-ID,
            XP-KEY-TYPE BY XD-KEY-TYPE,
            XP-KEY-VALUE BY XD-KEY-VALUE,
            XP-KEY-MASK BY XD-KEY-MASK,
            XP-QR-ID BY XD-QR-ID,
            XP-MED-CASE BY XD-MED-CASE,
            XP-PAYER-PART BY XD-PAYER-PART,
            XP-PAYEE-PART BY XD-PAYEE-PART,
            XP-PAYER-ACCT BY XD-PAYER-ACCT,
            XP-PAYER-CUST BY XD-PAYER-CUST,
            XP-PAYEE-ACCT BY XD-PAYEE-ACCT,
            XP-PAYEE-CUST BY XD-PAYEE-CUST,
            XP-PAYEE-NAME BY XD-PAYEE-NAME,
            XP-MERCHANT-ID BY XD-MERCHANT-ID,
            XP-MERCHANT-NAME BY XD-MERCHANT-NAME,
            XP-MCC BY XD-MCC,
            XP-AMOUNT BY XD-AMOUNT,
            XP-CURRENCY BY XD-CURRENCY,
            XP-FEE-AMT BY XD-FEE-AMT,
            XP-BLOCK-AMT BY XD-BLOCK-AMT,
            XP-STATUS BY XD-STATUS,
            XP-EVENT BY XD-EVENT,
            XP-POST-STATUS BY XD-POST-STATUS,
            XP-SETTLE-STATUS BY XD-SETTLE-STATUS,
            XP-RECON-STATUS BY XD-RECON-STATUS,
            XP-DEV-STATUS BY XD-DEV-STATUS,
            XP-MED-STATUS BY XD-MED-STATUS,
            XP-TXN-ID BY XD-TXN-ID,
            XP-JRN-ID BY XD-JRN-ID,
            XP-SETTLE-BATCH BY XD-SETTLE-BATCH,
            XP-CHANNEL BY XD-CHANNEL,
            XP-SIM BY XD-SIM,
            XP-ALLOW-FREE BY XD-ALLOW-FREE,
            XP-FORCE BY XD-FORCE,
            XP-AUTO BY XD-AUTO,
            XP-COUNT BY XD-COUNT,
            XP-HASH BY XD-HASH,
            XP-REPLAY BY XD-REPLAY,
            XP-DEV-PIX-ID BY XD-DEV-PIX-ID,
            XP-DATE BY XD-DATE,
            XP-DESCR BY XD-DESCR,
            XP-REASON BY XD-REASON,
            XP-OPERATOR BY XD-OPERATOR,
            XP-CORR BY XD-CORR,
            XP-REQUEST BY XD-REQUEST,
            XP-RC BY XD-RC,
            XP-MSG BY XD-MSG,
            XP-SPLIT BY XD-SPLIT,
            XP-SPLIT-CNT BY XD-SPLIT-CNT,
            XP-SPLIT-TOTAL BY XD-SPLIT-TOTAL,
            XP-SPLIT-TAX BY XD-SPLIT-TAX,
            XP-SPLIT-EXT BY XD-SPLIT-EXT,
            XP-S-ROW BY XD-S-ROW,
            XP-PS-SEQ BY XD-PS-SEQ,
            XP-PS-ROLE BY XD-PS-ROLE,
            XP-PS-ID BY XD-PS-ID,
            XP-PS-DOC-TYPE BY XD-PS-DOC-TYPE,
            XP-PS-DOC BY XD-PS-DOC,
            XP-PS-NAME BY XD-PS-NAME,
            XP-PS-AMT BY XD-PS-AMT,
            XP-PS-TYPE BY XD-PS-TYPE,
            XP-PS-REF BY XD-PS-REF,
            XP-PS-DOCREF BY XD-PS-DOCREF,
            XP-PS-TAXTYPE BY XD-PS-TAXTYPE,
            XP-PS-TAXCAT BY XD-PS-TAXCAT,
            XP-PS-CUST BY XD-PS-CUST,
            XP-PS-ALLOC-ID BY XD-PS-ALLOC-ID,
            XP-PS-STATUS BY XD-PS-STATUS,
            XP-PS-ORIG BY XD-PS-ORIG,
            XP-PS-TXN-ID BY XD-PS-TXN-ID,
            XP-PS-JRN-ID BY XD-PS-JRN-ID.
01 WS-NOW PIC X(14).
01 WS-DEADLINE PIC 9(08).
01 WS-DEVOLVED PIC S9(15)V99 COMP-3.
01 WS-REMAIN PIC S9(15)V99 COMP-3.
01 WS-DEVOL-ID PIC X(12).
01 WS-NEW-DIR PIC X(08).
01 WS-EVT PIC X(16).
01 WS-NXT PIC X(12).
01 WS-STM-RC PIC X(02).
01 WS-STM-MSG PIC X(80).
01 WS-HASH-BUF PIC X(600).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-LOCK-NAME PIC X(24).
01 WS-LOCK-OWNER PIC X(16).
01 WS-LOCK-MODE PIC X(01).
01 WS-LOCK-ST PIC X(02).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-EVT-TYPE PIC X(40).
COPY "BKSPLP".
COPY "BTXNLFC".
COPY "BTXNRESP".
01 WS-SPLIT-FLAG PIC X(01) VALUE "N".
01 WS-ORIG-SPLIT-CNT PIC 9(02).
01 WS-FULL PIC X(01).
01 WS-DEVOLVED-BEF PIC S9(15)V99 COMP-3.
01 WS-REMAIN-BEF PIC S9(15)V99 COMP-3.
01 WS-REVERSAL-REMAIN PIC S9(15)V99 COMP-3.
01 WS-REV-CNT PIC 9(02).
01 WS-REQ-CNT PIC 9(02).
01 WS-SPI PIC 9(02).
01 WS-SUM-REVERSAL PIC S9(15)V99 COMP-3.
01 WS-REQ-ID PIC X(24).
01 WS-ORIG-TXN PIC X(12).
01 WS-ORIG-JRN PIC X(20).
01 WS-AB-ORIG PIC X(12) OCCURS 20 TIMES.
01 WS-AB-AMT PIC S9(15)V99 COMP-3 OCCURS 20 TIMES.
01 WS-FULL-OP PIC X(12).

LINKAGE SECTION.
COPY "BPXPP".

PROCEDURE DIVISION USING BK-PX-PARMS.
    MOVE "00" TO XP-RC
    MOVE SPACES TO XP-MSG
    MOVE "N" TO XP-REPLAY
    CALL "BCFG" USING WS-CFG
    CALL "BPXCFG" USING BK-PX-CFG
    IF PC-STATUS NOT = "00" OR PC-ENABLED NOT = "Y"
        MOVE "20" TO XP-RC
        MOVE "PIX UNAVAILABLE" TO XP-MSG
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(XP-OP)
        WHEN "PIX-DEVOL-REQUEST" PERFORM DO-DEVOLUTION
        WHEN "PIX-DEVOL-GET" PERFORM DO-GET-DEVOLVED
        WHEN "PIX-DEVOL-FINALIZE" PERFORM DO-FINALIZE
        WHEN OTHER
            MOVE "99" TO XP-RC
            MOVE "UNKNOWN PIX DEVOLUTION OP" TO XP-MSG
    END-EVALUATE
    GOBACK.

DO-DEVOLUTION.
    PERFORM LOCK-ORIG
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-ORIG
    IF XP-RC = "00"
        PERFORM CHECK-ORIG-STATE
    END-IF
    IF XP-RC = "00"
        PERFORM CHECK-WINDOW
    END-IF
    IF XP-RC = "00" AND WS-SPLIT-FLAG NOT = "Y"
        PERFORM CHECK-AMOUNT
    END-IF
    IF XP-RC = "00" AND WS-SPLIT-FLAG = "Y"
        PERFORM SPLIT-REVERSAL-ORCHESTRATION
    ELSE IF XP-RC = "00"
        PERFORM BUILD-DEVOL-PARMS
        PERFORM RUN-DEVOL
    END-IF
    END-IF
    IF XP-RC = "00" AND XP-POST-STATUS = "POSTED"
        IF WS-SPLIT-FLAG = "Y"
            PERFORM FINALIZE-SPLIT-REVERSAL
        ELSE
            PERFORM UPDATE-ORIG
        END-IF
        PERFORM EMIT-DEVOL
    END-IF.
    PERFORM UNLOCK-ORIG
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE XP-DEV-PIX-ID TO XP-PIX-ID.

DO-FINALIZE.
    IF XP-DEV-PIX-ID = SPACES
        MOVE "20" TO XP-RC
        MOVE "DEVOLUTION ID REQUIRED" TO XP-MSG
        GOBACK
    END-IF
    IF XP-DEV-PIX-ID(1:1) = "W"
        PERFORM DO-FINALIZE-REVERSAL
        GOBACK
    END-IF
    PERFORM LOCK-ORIG
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-ORIG
    IF XP-RC = "00"
        PERFORM CHECK-ORIG-STATE
    END-IF
    IF XP-RC = "00"
        MOVE WS-ORIG-BLOCK-AMT TO WS-DEVOLVED
        IF WS-ORIG-DEV-PIX-ID = XP-DEV-PIX-ID
            MOVE "00" TO XP-RC
            MOVE "DEVOLUTION ALREADY APPLIED" TO XP-MSG
        ELSE
            PERFORM QUERY-DEVOL
        END-IF
    END-IF
    IF XP-RC = "00" AND WS-DEVOL-ID NOT = SPACES
        MOVE WS-DEVOL-ID TO XP-PIX-ID
        PERFORM UPDATE-ORIG
        IF XP-RC = "00"
            MOVE WS-ORIG-DEV-STATUS TO XP-DEV-STATUS
            PERFORM EMIT-DEVOL
        END-IF
    END-IF
    PERFORM UNLOCK-ORIG
    IF XP-RC = "00" AND WS-DEVOL-ID = SPACES
        MOVE XP-DEV-PIX-ID TO XP-PIX-ID
    END-IF
    GOBACK.

QUERY-DEVOL.
    MOVE SPACES TO WS-DEV-PARMS
    MOVE 0 TO XD-AMOUNT XD-FEE-AMT XD-BLOCK-AMT XD-DATE XD-COUNT
    MOVE "PIX-GET" TO XD-OP
    MOVE XP-DEV-PIX-ID TO XD-PIX-ID
    CALL "BPXPR" USING WS-DEV-PARMS
    IF XD-RC NOT = "00"
        MOVE XD-RC TO XP-RC
        MOVE "DEVOLUTION PIX NOT FOUND" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XD-ORIG-PIX-ID NOT = XP-ORIG-PIX-ID
        MOVE "20" TO XP-RC
        MOVE "DEVOLUTION PIX LINK MISMATCH" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XD-POST-STATUS NOT = "POSTED"
        MOVE "24" TO XP-RC
        MOVE "DEVOLUTION NOT POSTED YET" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE XD-PIX-ID TO WS-DEVOL-ID
    MOVE XD-AMOUNT TO XP-AMOUNT.

CHECK-ORIG-STATE.
    MOVE PX-TXN-ID OF BK-PX-REC TO WS-ORIG-TXN
    MOVE PX-JRN-ID OF BK-PX-REC TO WS-ORIG-JRN
    IF WS-ORIG-STATUS NOT = "POSTED" AND
       WS-ORIG-STATUS NOT = "SETTLED" AND
       WS-ORIG-STATUS NOT = "RECONCILED" AND
       WS-ORIG-STATUS NOT = "DEVOLVED"
        MOVE "20" TO XP-RC
        MOVE "PIX NOT ELIGIBLE FOR DEVOLUTION" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF WS-ORIG-DEV-STATUS = "FULL"
        MOVE "20" TO XP-RC
        MOVE "PIX ALREADY DEVOLVED" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF PX-SPLIT-FLAG OF BK-PX-REC = "Y"
        MOVE "Y" TO WS-SPLIT-FLAG
        MOVE PX-SPLIT-CNT OF BK-PX-REC TO WS-ORIG-SPLIT-CNT
        IF XP-SPLIT NOT = "Y"
            MOVE "20" TO XP-RC
            MOVE "SPLIT PIX REQUIRES EXPLICIT LEG REVERSAL"
                TO XP-MSG
        END-IF
    ELSE
        IF XP-SPLIT = "Y"
            MOVE "20" TO XP-RC
            MOVE "PIX IS NOT SPLIT" TO XP-MSG
        END-IF
    END-IF.

CHECK-WINDOW.
    IF PC-DEV-DAYS = 0
        EXIT PARAGRAPH
    END-IF
    MOVE WS-ORIG-POST-DATE TO DAT-DATE
    MOVE PC-DEV-DAYS TO DAT-DAYS
    MOVE "ADD-DAYS" TO DAT-OP
    CALL "BDAT" USING BK-DAT-PARMS
    IF DAT-RC = "00"
        MOVE DAT-RESULT TO WS-DEADLINE
    ELSE
        MOVE WS-ORIG-POST-DATE TO WS-DEADLINE
    END-IF
    IF WS-BIZDATE > WS-DEADLINE
        MOVE "20" TO XP-RC
        MOVE "DEVOLUTION WINDOW CLOSED" TO XP-MSG
        EXIT PARAGRAPH
    END-IF.

CHECK-AMOUNT.
    MOVE WS-ORIG-BLOCK-AMT TO WS-DEVOLVED
    IF XP-AMOUNT <= 0
        MOVE "20" TO XP-RC
        MOVE "DEVOLUTION AMOUNT REQUIRED" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-REMAIN = WS-ORIG-AMOUNT - WS-DEVOLVED
    IF WS-REMAIN <= 0
        MOVE "20" TO XP-RC
        MOVE "PIX FULLY DEVOLVED" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XP-AMOUNT > WS-REMAIN
        MOVE "20" TO XP-RC
        MOVE "DEVOLUTION EXCEEDS ORIGINAL AMOUNT" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XP-CURRENCY = SPACES
        MOVE WS-ORIG-CURRENCY TO XP-CURRENCY
    END-IF
    IF XP-CURRENCY NOT = WS-ORIG-CURRENCY
        MOVE "20" TO XP-RC
        MOVE "DEVOLUTION CURRENCY MISMATCH" TO XP-MSG
        EXIT PARAGRAPH
    END-IF.

BUILD-DEVOL-PARMS.
    MOVE SPACES TO WS-DEV-PARMS
    MOVE 0 TO XD-AMOUNT XD-FEE-AMT XD-BLOCK-AMT XD-DATE XD-COUNT
    MOVE "PIX-REQUEST" TO XD-OP
    MOVE "MANUAL" TO XD-MODALITY
    EVALUATE TRUE
        WHEN WS-ORIG-DIRECTION = "OUT" AND WS-ORIG-LOCAL = "Y"
            MOVE "OUT" TO XD-DIRECTION
            MOVE WS-ORIG-PAYEE-ACCT TO XD-PAYER-ACCT
            MOVE WS-ORIG-PAYEE-CUST TO XD-PAYER-CUST
            MOVE WS-ORIG-PAYER-ACCT TO XD-PAYEE-ACCT
            MOVE WS-ORIG-PAYER-CUST TO XD-PAYEE-CUST
            MOVE PC-SELF TO XD-PAYER-PART
            MOVE PC-SELF TO XD-PAYEE-PART
        WHEN WS-ORIG-DIRECTION = "OUT"
            MOVE "IN" TO XD-DIRECTION
            MOVE WS-ORIG-PAYER-ACCT TO XD-PAYEE-ACCT
            MOVE WS-ORIG-PAYER-CUST TO XD-PAYEE-CUST
            MOVE WS-ORIG-PAYEE-PART TO XD-PAYER-PART
            MOVE PC-SELF TO XD-PAYEE-PART
        WHEN OTHER
            MOVE "OUT" TO XD-DIRECTION
            MOVE WS-ORIG-PAYEE-ACCT TO XD-PAYER-ACCT
            MOVE WS-ORIG-PAYEE-CUST TO XD-PAYER-CUST
            MOVE WS-ORIG-PAYER-PART TO XD-PAYEE-PART
            MOVE PC-SELF TO XD-PAYER-PART
    END-EVALUATE
    MOVE XP-AMOUNT TO XD-AMOUNT
    MOVE XP-CURRENCY TO XD-CURRENCY
    MOVE WS-ORIG-ID TO XD-ORIG-PIX-ID
    IF XP-ENV = SPACES
        MOVE WS-ORIG-ENV TO XD-ENV
    ELSE
        MOVE XP-ENV TO XD-ENV
    END-IF
    IF XP-DESCR = SPACES
        MOVE "PIX DEVOLUCAO" TO XD-DESCR
    ELSE
        MOVE XP-DESCR TO XD-DESCR
    END-IF
    MOVE XP-REASON TO XD-REASON
    MOVE XP-OPERATOR TO XD-OPERATOR
    MOVE XP-CORR TO XD-CORR
    MOVE XP-REQUEST TO XD-REQUEST
    MOVE XP-SIM TO XD-SIM
    IF XD-DIRECTION = "IN" AND XD-E2E-ID = SPACES
        MOVE "PIX" TO WS-ID-TYPE
        MOVE PC-E2E-ISPB TO WS-ID-ISPB
        CALL "BPXID" USING WS-ID-TYPE WS-ID-ISPB WS-ID-VAL
            WS-ID-RC
        IF WS-ID-RC NOT = "00"
            MOVE "20" TO XP-RC
            MOVE "DEVOLUTION E2E ERROR" TO XP-MSG
            GOBACK
        END-IF
        MOVE WS-ID-VAL TO XD-E2E-ID
    END-IF.

SPLIT-REVERSAL-ORCHESTRATION.
    PERFORM RESOLVE-REVERSAL-REQUEST-ID
    MOVE 0 TO WS-REV-CNT
    IF XP-SPLIT-CNT > 0
        PERFORM VARYING WS-SPI FROM 1 BY 1 UNTIL WS-SPI >
            XP-SPLIT-CNT
            MOVE XP-PS-ORIG(WS-SPI) TO WS-AB-ORIG(WS-SPI)
            MOVE XP-PS-AMT(WS-SPI) TO WS-AB-AMT(WS-SPI)
        END-PERFORM
        MOVE XP-SPLIT-CNT TO WS-REV-CNT
    ELSE
        PERFORM AUTO-BUILD-REMAINING-LEGS
        IF SP-RC NOT = "00"
            MOVE SP-RC TO XP-RC
            MOVE SP-MSG TO XP-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    MOVE SPACES TO BK-PX-SPL-PARMS
    MOVE "SPL-REV-CREATE" TO SP-OP
    MOVE WS-ORIG-ID TO SP-PIX-ID
    MOVE WS-ORIG-TXN TO SP-ORIG-TXN-ID
    MOVE WS-ORIG-JRN TO SP-ORIG-JRN-ID
    MOVE WS-ORIG-AMOUNT TO SP-GROSS
    MOVE XP-CURRENCY TO SP-CURRENCY
    MOVE XP-OPERATOR TO SP-OPERATOR
    MOVE XP-CORR TO SP-CORR
    MOVE WS-REQ-ID TO SP-REQ-ID
    IF XP-DEV-PIX-ID NOT = SPACES
        MOVE XP-DEV-PIX-ID TO SP-DEVID
    ELSE
        MOVE WS-DEVOL-ID TO SP-DEVID
    END-IF
    MOVE WS-REV-CNT TO SP-CNT
    PERFORM VARYING WS-SPI FROM 1 BY 1 UNTIL WS-SPI >
        WS-REV-CNT
        MOVE WS-AB-ORIG(WS-SPI) TO SP-PS-ORIG(WS-SPI)
        MOVE WS-AB-AMT(WS-SPI) TO SP-PS-AMT(WS-SPI)
    END-PERFORM
    CALL "BPXSLV" USING BK-PX-SPL-PARMS
    IF SP-RC NOT = "00"
        MOVE SP-RC TO XP-RC
        MOVE SP-MSG TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SP-REV-ID TO XP-DEV-PIX-ID
    MOVE SP-REV-ID TO WS-DEVOL-ID
    IF SP-REPLAY = "Y"
        MOVE "Y" TO XP-REPLAY
        MOVE SP-GROSS TO XP-AMOUNT
        MOVE SP-TXN-ID TO XP-TXN-ID
        MOVE SP-JRN-ID TO XP-JRN-ID
        MOVE "POSTED" TO XP-POST-STATUS
        MOVE "DEVOLUTION REPLAY" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM PREPARE-REVERSAL-LEGS
    IF SP-RC NOT = "00"
        PERFORM MARK-REVERSAL-FAILED
        MOVE SP-RC TO XP-RC
        MOVE SP-MSG TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM POST-REVERSAL-TRANSACTION
    IF SP-RC NOT = "00"
        MOVE SP-RC TO XP-RC
        MOVE SP-MSG TO XP-MSG
        PERFORM MARK-REVERSAL-FAILED
        EXIT PARAGRAPH
    END-IF
    PERFORM MARK-REVERSAL-POSTED
    IF SP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF.

AUTO-BUILD-REMAINING-LEGS.
    MOVE SPACES TO BK-PX-SPL-PARMS
    MOVE "SPL-LIST" TO SP-OP
    MOVE WS-ORIG-ID TO SP-PIX-ID
    CALL "BPXSLV" USING BK-PX-SPL-PARMS
    IF SP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SP-CNT TO WS-REV-CNT
    IF XP-AMOUNT > 0
        MOVE XP-AMOUNT TO WS-SUM-REVERSAL
    ELSE
        MOVE SP-REMAIN TO WS-SUM-REVERSAL
    END-IF
    MOVE 0 TO WS-REQ-CNT
    PERFORM VARYING WS-SPI FROM 1 BY 1 UNTIL WS-SPI >
        WS-REV-CNT
        IF SP-PS-REMAIN(WS-SPI) > 0 AND WS-SUM-REVERSAL > 0
            ADD 1 TO WS-REQ-CNT
            MOVE SP-PS-ALLOC-ID(WS-SPI) TO
                WS-AB-ORIG(WS-REQ-CNT)
            IF SP-PS-REMAIN(WS-SPI) <= WS-SUM-REVERSAL
                MOVE SP-PS-REMAIN(WS-SPI) TO
                    WS-AB-AMT(WS-REQ-CNT)
                SUBTRACT SP-PS-REMAIN(WS-SPI) FROM
                    WS-SUM-REVERSAL
            ELSE
                MOVE WS-SUM-REVERSAL TO WS-AB-AMT(WS-REQ-CNT)
                MOVE 0 TO WS-SUM-REVERSAL
            END-IF
        END-IF
    END-PERFORM
    IF WS-REQ-CNT = 0
        MOVE "20" TO SP-RC
        MOVE "PIX FULLY DEVOLVED" TO SP-MSG
    END-IF
    MOVE WS-REQ-CNT TO WS-REV-CNT.

RESOLVE-REVERSAL-REQUEST-ID.
    IF XP-REQUEST NOT = SPACES
        MOVE XP-REQUEST TO WS-REQ-ID
        EXIT PARAGRAPH
    END-IF
    IF XP-E2E-ID NOT = SPACES
        MOVE XP-E2E-ID TO WS-REQ-ID
        EXIT PARAGRAPH
    END-IF
    MOVE WS-ORIG-BLOCK-AMT TO WS-AMT-ED
    MOVE SPACES TO WS-REQ-ID
    STRING "DEV" DELIMITED SIZE
        FUNCTION TRIM(XP-ORIG-PIX-ID) DELIMITED SIZE "-"
        DELIMITED SIZE WS-AMT-ED DELIMITED SIZE
        INTO WS-REQ-ID
    END-STRING.

PREPARE-REVERSAL-LEGS.
    MOVE "00" TO SP-RC
    MOVE SPACES TO BK-TXN-LFC-REQ
    MOVE SPACES TO BK-TXN-RES
    MOVE 0 TO WS-SUM-REVERSAL
    PERFORM VARYING WS-SPI FROM 1 BY 1 UNTIL WS-SPI > SP-R-CNT
        MOVE WS-SPI TO LFC-PS-SEQ(WS-SPI)
        MOVE SP-RS-ROLE(WS-SPI) TO LFC-PS-ROLE(WS-SPI)
        MOVE SP-RS-ACCT(WS-SPI) TO LFC-PS-DEST(WS-SPI)
        MOVE SP-RS-AMT(WS-SPI) TO LFC-PS-AMT(WS-SPI)
        MOVE SP-RS-TYPE(WS-SPI) TO LFC-PS-TYPE(WS-SPI)
        ADD SP-RS-AMT(WS-SPI) TO WS-SUM-REVERSAL
    END-PERFORM
    IF WS-SUM-REVERSAL <= 0
        MOVE "20" TO SP-RC
        MOVE "EMPTY REVERSAL" TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SP-REV-ID TO LFC-REV-ID
    MOVE SP-R-CNT TO LFC-SPLIT-CNT
    MOVE WS-ORIG-TXN TO LFC-TXN-ID
    MOVE WS-SUM-REVERSAL TO LFC-AMOUNT
    MOVE WS-ORIG-CURRENCY TO LFC-CURRENCY
    IF XP-DESCR = SPACES
        MOVE "PIX SPLIT DEVOLUTION" TO LFC-DESCR
    ELSE
        MOVE XP-DESCR TO LFC-DESCR
    END-IF
    MOVE XP-OPERATOR TO LFC-OPERATOR
    MOVE XP-CORR TO LFC-CORR
    MOVE WS-REQ-ID TO LFC-REQUEST
    MOVE XP-REASON TO LFC-REASON
    COMPUTE WS-REMAIN-BEF = WS-ORIG-AMOUNT - WS-DEVOLVED
    IF WS-SUM-REVERSAL >= WS-REMAIN-BEF
        MOVE "REVERSE" TO WS-FULL-OP
        MOVE "Y" TO WS-FULL
    ELSE
        MOVE "RETURN" TO WS-FULL-OP
        MOVE "N" TO WS-FULL
    END-IF
    MOVE WS-FULL-OP TO LFC-OP.

POST-REVERSAL-TRANSACTION.
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    IF TXR-RC NOT = "00"
        MOVE TXR-RC TO SP-RC
        MOVE TXR-MSG TO SP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE TXR-ID TO SP-TXN-ID
    MOVE TXR-JRN-ID TO SP-JRN-ID
    MOVE "00" TO SP-RC.

MARK-REVERSAL-POSTED.
    MOVE SPACES TO BK-PX-SPL-PARMS
    MOVE "SPL-REV-MARK" TO SP-OP
    MOVE XP-DEV-PIX-ID TO SP-REV-ID
    MOVE "POSTED" TO SP-STATUS
    MOVE TXR-ID TO SP-TXN-ID
    MOVE TXR-JRN-ID TO SP-JRN-ID
    CALL "BPXSLV" USING BK-PX-SPL-PARMS
    IF SP-RC NOT = "00"
        MOVE SP-RC TO XP-RC
        MOVE SP-MSG TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SUM-REVERSAL TO XP-AMOUNT
    MOVE TXR-ID TO XP-TXN-ID
    MOVE TXR-JRN-ID TO XP-JRN-ID
    MOVE "POSTED" TO XP-POST-STATUS.

MARK-REVERSAL-FAILED.
    MOVE SPACES TO BK-PX-SPL-PARMS
    MOVE "SPL-REV-MARK" TO SP-OP
    MOVE XP-DEV-PIX-ID TO SP-REV-ID
    MOVE "FAILED" TO SP-STATUS
    CALL "BPXSLV" USING BK-PX-SPL-PARMS
    CONTINUE.

FINALIZE-SPLIT-REVERSAL.
    PERFORM LOAD-ORIG
    IF XP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-SPL-PARMS
    MOVE "SPL-LIST" TO SP-OP
    MOVE WS-ORIG-ID TO SP-PIX-ID
    CALL "BPXSLV" USING BK-PX-SPL-PARMS
    IF SP-RC NOT = "00"
        MOVE SP-RC TO XP-RC
        MOVE SP-MSG TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SP-DEVOLVED TO WS-DEVOLVED
    MOVE SP-DEVOLVED TO PX-BLOCK-AMT OF BK-PX-REC
    IF SP-REMAIN <= 0
        MOVE "FULL" TO WS-ORIG-DEV-STATUS
    ELSE
        MOVE "PARTIAL" TO WS-ORIG-DEV-STATUS
    END-IF
    MOVE WS-ORIG-DEV-STATUS TO PX-DEV-STATUS OF BK-PX-REC
    MOVE WS-DEVOL-ID TO PX-DEV-PIX-ID OF BK-PX-REC
    MOVE WS-DEVOL-ID TO XP-DEV-PIX-ID
    PERFORM TOUCH-ORIG
    PERFORM STORE-ORIG
    IF XP-RC = "00" AND WS-ORIG-DEV-STATUS = "FULL"
        MOVE "DEVOLVE" TO WS-EVT
        CALL "BPXSTM" USING PX-STATUS OF BK-PX-REC WS-EVT
            WS-NXT WS-STM-RC WS-STM-MSG
        IF WS-STM-RC = "00"
            MOVE WS-NXT TO PX-STATUS OF BK-PX-REC
            PERFORM TOUCH-ORIG
            PERFORM STORE-ORIG
        END-IF
        MOVE "00" TO XP-RC
    END-IF
    MOVE WS-ORIG-DEV-STATUS TO XP-DEV-STATUS.

DO-FINALIZE-REVERSAL.
    PERFORM LOCK-ORIG
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE SPACES TO BK-PX-SPL-PARMS
    MOVE "SPL-REV-GET" TO SP-OP
    MOVE XP-DEV-PIX-ID TO SP-REV-ID
    CALL "BPXSLV" USING BK-PX-SPL-PARMS
    IF SP-RC NOT = "00"
        MOVE SP-RC TO XP-RC
        MOVE "SPLIT REVERSAL NOT FOUND" TO XP-MSG
        PERFORM UNLOCK-ORIG
        GOBACK
    END-IF
    IF SP-STATUS NOT = "POSTED"
        MOVE "24" TO XP-RC
        MOVE "SPLIT REVERSAL NOT POSTED YET" TO XP-MSG
        PERFORM UNLOCK-ORIG
        GOBACK
    END-IF
    MOVE SP-REV-ID TO WS-DEVOL-ID
    MOVE SP-GROSS TO XP-AMOUNT
    PERFORM FINALIZE-SPLIT-REVERSAL
    PERFORM UNLOCK-ORIG
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE SP-REV-ID TO XP-DEV-PIX-ID
    MOVE SP-REV-ID TO XP-PIX-ID.

DO-GET-REVERSAL.
    MOVE SPACES TO BK-PX-SPL-PARMS
    MOVE "SPL-REV-GET" TO SP-OP
    MOVE XP-PIX-ID TO SP-REV-ID
    CALL "BPXSLV" USING BK-PX-SPL-PARMS
    IF SP-RC NOT = "00"
        MOVE SP-RC TO XP-RC
        MOVE "SPLIT REVERSAL NOT FOUND" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SP-REV-ID TO XP-DEV-PIX-ID
    MOVE SP-DEVOLVED TO XP-BLOCK-AMT
    IF SP-REMAIN <= 0
        MOVE "FULL" TO XP-DEV-STATUS
    ELSE
        MOVE "PARTIAL" TO XP-DEV-STATUS
    END-IF
    MOVE SP-STATUS TO XP-STATUS
    MOVE "PIX SPLIT DEVOLUTION STATE" TO XP-MSG.

RUN-DEVOL.
    CALL "BPXPR" USING WS-DEV-PARMS
    MOVE XD-RC TO XP-RC
    MOVE XD-MSG TO XP-MSG
    MOVE XD-PIX-ID TO WS-DEVOL-ID
    IF XD-PIX-ID NOT = SPACES
        MOVE XD-PIX-ID TO XP-DEV-PIX-ID
    END-IF
    IF XP-RC = "00"
        MOVE XD-PIX-ID TO XP-DEV-PIX-ID
        MOVE XD-STATUS TO XP-STATUS
        MOVE XD-POST-STATUS TO XP-POST-STATUS
        MOVE XD-AMOUNT TO XP-AMOUNT
    END-IF.

UPDATE-ORIG.
    IF WS-SPLIT-FLAG = "Y"
        EXIT PARAGRAPH
    END-IF
    ADD XP-AMOUNT TO WS-DEVOLVED
    MOVE WS-DEVOLVED TO PX-BLOCK-AMT OF BK-PX-REC
    MOVE WS-DEVOL-ID TO PX-DEV-PIX-ID OF BK-PX-REC
    IF WS-DEVOLVED >= WS-ORIG-AMOUNT
        MOVE "FULL" TO WS-ORIG-DEV-STATUS
    ELSE
        MOVE "PARTIAL" TO WS-ORIG-DEV-STATUS
    END-IF
    MOVE WS-ORIG-DEV-STATUS TO PX-DEV-STATUS OF BK-PX-REC
    PERFORM TOUCH-ORIG
    PERFORM STORE-ORIG
    IF XP-RC = "00" AND WS-ORIG-DEV-STATUS = "FULL"
        MOVE "DEVOLVE" TO WS-EVT
        CALL "BPXSTM" USING PX-STATUS OF BK-PX-REC WS-EVT WS-NXT
            WS-STM-RC WS-STM-MSG
        IF WS-STM-RC = "00"
            MOVE WS-NXT TO PX-STATUS OF BK-PX-REC
            PERFORM TOUCH-ORIG
            PERFORM STORE-ORIG
        END-IF
        MOVE "00" TO XP-RC
    END-IF.

LOAD-ORIG.
    MOVE SPACES TO BK-PX-REC
    MOVE XP-ORIG-PIX-ID TO PX-ID OF BK-PX-REC
    MOVE "GET" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC NOT = "00"
        MOVE XS-RC TO XP-RC
        MOVE XS-MSG TO XP-MSG
        GOBACK
    END-IF
    PERFORM COPY-ORIG-FROM.

COPY-ORIG-FROM.
    MOVE PX-ID OF BK-PX-REC TO WS-ORIG-ID
    MOVE PX-DIRECTION OF BK-PX-REC TO WS-ORIG-DIRECTION
    MOVE PX-ENV OF BK-PX-REC TO WS-ORIG-ENV
    MOVE PX-STATUS OF BK-PX-REC TO WS-ORIG-STATUS
    MOVE PX-DEV-STATUS OF BK-PX-REC TO WS-ORIG-DEV-STATUS
    MOVE PX-DEV-PIX-ID OF BK-PX-REC TO WS-ORIG-DEV-PIX-ID
    MOVE PX-AMOUNT OF BK-PX-REC TO WS-ORIG-AMOUNT
    MOVE PX-CURRENCY OF BK-PX-REC TO WS-ORIG-CURRENCY
    MOVE PX-BLOCK-AMT OF BK-PX-REC TO WS-ORIG-BLOCK-AMT
    MOVE PX-PAYER-ACCT OF BK-PX-REC TO WS-ORIG-PAYER-ACCT
    MOVE PX-PAYER-CUST OF BK-PX-REC TO WS-ORIG-PAYER-CUST
    MOVE PX-PAYER-PART OF BK-PX-REC TO WS-ORIG-PAYER-PART
    MOVE PX-PAYEE-ACCT OF BK-PX-REC TO WS-ORIG-PAYEE-ACCT
    MOVE PX-PAYEE-CUST OF BK-PX-REC TO WS-ORIG-PAYEE-CUST
    MOVE PX-PAYEE-PART OF BK-PX-REC TO WS-ORIG-PAYEE-PART
    MOVE PX-POST-DATE OF BK-PX-REC TO WS-ORIG-POST-DATE
    MOVE "N" TO WS-ORIG-LOCAL
    IF PX-DIRECTION OF BK-PX-REC = "OUT" AND
       PX-PAYEE-PART OF BK-PX-REC = FUNCTION TRIM(PC-SELF) AND
       PX-PAYEE-ACCT OF BK-PX-REC NOT = SPACES
        MOVE "Y" TO WS-ORIG-LOCAL
    END-IF
    MOVE PX-VERSION OF BK-PX-REC TO WS-ORIG-VERSION
    MOVE PX-CREATED OF BK-PX-REC TO WS-ORIG-CREATED
    MOVE PX-UPDATED OF BK-PX-REC TO WS-ORIG-UPDATED.

STORE-ORIG.
    MOVE "REWRITE" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC NOT = "00"
        MOVE XS-RC TO XP-RC
        MOVE XS-MSG TO XP-MSG
    END-IF.

TOUCH-ORIG.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO PX-UPDATED OF BK-PX-REC
    ADD 1 TO PX-VERSION OF BK-PX-REC
    MOVE PX-AMOUNT OF BK-PX-REC TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(PX-ID OF BK-PX-REC) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(PX-E2E-ID OF BK-PX-REC)
        DELIMITED SIZE "|" DELIMITED SIZE PX-DIRECTION OF BK-PX-REC
        DELIMITED SIZE "|" DELIMITED SIZE WS-AMT-ED DELIMITED SIZE
        "|" DELIMITED SIZE PX-STATUS OF BK-PX-REC DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 600 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO PX-HASH OF BK-PX-REC.

DO-GET-DEVOLVED.
    IF XP-PIX-ID(1:1) = "W"
        PERFORM DO-GET-REVERSAL
        GOBACK
    END-IF
    MOVE SPACES TO BK-PX-REC
    MOVE XP-PIX-ID TO PX-ID OF BK-PX-REC
    MOVE "GET" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC NOT = "00"
        MOVE XS-RC TO XP-RC
        MOVE XS-MSG TO XP-MSG
        GOBACK
    END-IF
    MOVE PX-DEV-PIX-ID OF BK-PX-REC TO XP-DEV-PIX-ID
    MOVE PX-BLOCK-AMT OF BK-PX-REC TO XP-BLOCK-AMT
    MOVE PX-DEV-STATUS OF BK-PX-REC TO XP-DEV-STATUS
    MOVE PX-ORIG-PIX-ID OF BK-PX-REC TO XP-ORIG-PIX-ID
    MOVE "PIX DEVOLUTION STATE" TO XP-MSG.

LOCK-ORIG.
    MOVE SPACES TO WS-LOCK-NAME
    STRING "PIXDEV-" DELIMITED SIZE FUNCTION TRIM(XP-ORIG-PIX-ID)
        DELIMITED SIZE INTO WS-LOCK-NAME
    END-STRING
    MOVE FUNCTION TRIM(XP-OPERATOR) TO WS-LOCK-OWNER
    MOVE "A" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST
    IF WS-LOCK-ST NOT = "00"
        MOVE "24" TO XP-RC
        MOVE "PIX DEVOLUTION LOCKED" TO XP-MSG
    END-IF.

UNLOCK-ORIG.
    IF XP-ORIG-PIX-ID = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE "R" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST.

EMIT-DEVOL.
    MOVE XP-OPERATOR TO BK-AUD-OPERATOR
    MOVE "PIX.DEVOLUTION" TO BK-AUD-ACTION
    MOVE WS-DEVOL-ID TO BK-AUD-ENTITY
    MOVE XP-CORR TO BK-AUD-CORR
    MOVE XP-ORIG-PIX-ID TO BK-AUD-BEFORE
    MOVE XP-PIX-ID TO BK-AUD-AFTER
    MOVE XP-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE "PIX.DEVOLUTION.v1" TO WS-EVT-TYPE
    MOVE WS-DEVOL-ID TO BK-EVT-KEY
    MOVE XP-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(XP-PIX-ID) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(XP-ORIG-PIX-ID)
        DELIMITED SIZE "|" DELIMITED SIZE WS-AMT-ED
        DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XP-DEV-STATUS) DELIMITED SIZE
        INTO BK-EVT-PAYLOAD
    END-STRING
    CALL "BEVT" USING BK-EVT-PARMS.
