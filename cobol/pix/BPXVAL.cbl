IDENTIFICATION DIVISION.
PROGRAM-ID. BPXVAL.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BPXCFG".
COPY "BPXRT".
COPY "BPXKP".
COPY "BPXQP".
COPY "BPXFP".
COPY "BLIMP".
01 WS-ACCT-OUT.
   05 AO-ID PIC X(12).
   05 AO-CUST PIC X(12).
   05 AO-PRODUCT PIC X(04).
   05 AO-CURRENCY PIC X(03).
   05 AO-STATUS PIC X(02).
   05 AO-OPENED PIC 9(08).
   05 AO-CLOSED PIC 9(08).
   05 AO-VERSION PIC 9(05).
   05 AO-HASH PIC X(16).
   05 AO-RC PIC X(02).
01 WS-CUST-OUT.
   05 CO-ID PIC X(12).
   05 CO-TYPE PIC X(01).
   05 CO-STATUS PIC X(02).
   05 CO-NAME PIC X(60).
   05 CO-DOC-TYPE PIC X(04).
   05 CO-DOC PIC X(20).
   05 CO-BIRTH PIC 9(08).
   05 CO-RISK PIC X(02).
   05 CO-KYC PIC X(02).
   05 CO-ADDR PIC X(80).
   05 CO-CREATED PIC 9(08).
   05 CO-UPDATED PIC 9(08).
   05 CO-VERSION PIC 9(05).
   05 CO-HASH PIC X(16).
   05 CO-RC PIC X(02).
01 WS-BAL-OUT.
   05 BO-LEDGER PIC S9(15)V99 COMP-3.
   05 BO-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BO-BLOCKED PIC S9(15)V99 COMP-3.
   05 BO-CURRENCY PIC X(03).
   05 BO-UPDATED PIC 9(08).
   05 BO-SEQ PIC 9(12).
   05 BO-RC PIC X(02).
01 WS-RAIL-ACTIVE PIC X(01).
01 WS-RAIL-RC PIC X(02).
01 WS-PART-ID PIC X(12).
01 WS-ROLE PIC X(12).
01 WS-ACCT PIC X(12).
01 WS-ACCT-CUST PIC X(12).
01 WS-I PIC 9(02).
01 WS-SPL-TOT PIC S9(15)V99 COMP-3.

LINKAGE SECTION.
COPY "BPXPP".

PROCEDURE DIVISION USING BK-PX-PARMS.
    MOVE "00" TO XP-RC
    MOVE SPACES TO XP-MSG
    CALL "BPXCFG" USING BK-PX-CFG
    IF PC-STATUS NOT = "00"
        MOVE "20" TO XP-RC
        MOVE "PIX CONFIG MISSING" TO XP-MSG
        GOBACK
    END-IF
    IF PC-ENABLED NOT = "Y"
        MOVE "20" TO XP-RC
        MOVE "PIX NOT ENABLED" TO XP-MSG
        GOBACK
    END-IF
    CALL "BPAYRAIL" USING PC-RAIL WS-RAIL-ACTIVE WS-RAIL-RC
    IF WS-RAIL-ACTIVE NOT = "Y"
        MOVE "20" TO XP-RC
        MOVE "PIX RAIL NOT ACTIVE" TO XP-MSG
        GOBACK
    END-IF
    IF XP-ENV NOT = "PROD" AND XP-ENV NOT = "TEST"
        MOVE "20" TO XP-RC
        MOVE "UNKNOWN PIX ENVIRONMENT" TO XP-MSG
        GOBACK
    END-IF
    IF XP-AMOUNT <= 0
        MOVE "20" TO XP-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO XP-MSG
        GOBACK
    END-IF
    IF XP-AMOUNT > PC-AMOUNT-MAX
        MOVE "20" TO XP-RC
        MOVE "AMOUNT ABOVE PIX CONFIGURED MAXIMUM" TO XP-MSG
        GOBACK
    END-IF
    IF PC-CURRENCY NOT = SPACES AND XP-CURRENCY NOT = PC-CURRENCY
        MOVE "20" TO XP-RC
        MOVE "PIX CURRENCY NOT SUPPORTED" TO XP-MSG
        GOBACK
    END-IF
    IF XP-FEE-AMT < 0
        MOVE "20" TO XP-RC
        MOVE "FEE MUST NOT BE NEGATIVE" TO XP-MSG
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(XP-DIRECTION)
        WHEN "OUT" PERFORM VALIDATE-OUT
        WHEN "IN" PERFORM VALIDATE-IN
        WHEN OTHER
            MOVE "20" TO XP-RC
            MOVE "UNKNOWN PIX DIRECTION" TO XP-MSG
            GOBACK
    END-EVALUATE
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-FRAUD-RESTRICTION
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-LIMITS
    GOBACK.

VALIDATE-OUT.
    IF XP-SPLIT = "Y"
        PERFORM V-SPLIT-OUT
        IF XP-RC NOT = "00"
            GOBACK
        END-IF
        MOVE XP-PAYER-ACCT TO WS-ACCT
        PERFORM CHECK-PAYER-ACCOUNT
        IF XP-RC NOT = "00"
            GOBACK
        END-IF
        PERFORM CHECK-PAYER-PARTICIPANT
        IF XP-RC NOT = "00"
            GOBACK
        END-IF
        PERFORM CHECK-PIX-FUNDS
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(XP-MODALITY)
        WHEN "MANUAL" PERFORM V-MANUAL-OUT
        WHEN "KEY" PERFORM V-KEY-OUT
        WHEN "QR-STATIC" PERFORM V-QR-OUT
        WHEN "QR-DYNAMIC" PERFORM V-QR-OUT
        WHEN "QR-COMPOSED" PERFORM V-QR-OUT
        WHEN OTHER
            MOVE "20" TO XP-RC
            MOVE "UNKNOWN PIX MODALITY" TO XP-MSG
            GOBACK
    END-EVALUATE
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE XP-PAYER-ACCT TO WS-ACCT
    PERFORM CHECK-PAYER-ACCOUNT
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-PAYER-PARTICIPANT
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-PAYEE-PARTICIPANT
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-SELF-TRANSFER
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-PIX-FUNDS.

VALIDATE-IN.
    IF XP-PAYEE-PART = SPACES
        MOVE PC-SELF TO XP-PAYEE-PART
    END-IF
    IF XP-PAYER-PART = SPACES
        MOVE "20" TO XP-RC
        MOVE "SENDER PARTICIPANT REQUIRED" TO XP-MSG
        GOBACK
    END-IF
    IF XP-E2E-ID = SPACES
        MOVE "20" TO XP-RC
        MOVE "END TO END ID REQUIRED" TO XP-MSG
        GOBACK
    END-IF
    IF XP-PAYEE-PART = SPACES
        MOVE "20" TO XP-RC
        MOVE "RECEIVER PARTICIPANT REQUIRED" TO XP-MSG
        GOBACK
    END-IF
    IF XP-PAYEE-PART NOT = PC-SELF
        MOVE "20" TO XP-RC
        MOVE "PIX NOT ADDRESSED TO THIS PARTICIPANT" TO XP-MSG
        GOBACK
    END-IF
    IF XP-PAYEE-ACCT = SPACES AND XP-KEY-ID = SPACES
        MOVE "20" TO XP-RC
        MOVE "RECEIVER ACCOUNT OR KEY REQUIRED" TO XP-MSG
        GOBACK
    END-IF
    PERFORM RESOLVE-INBOUND-ACCOUNT
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE XP-PAYEE-ACCT TO WS-ACCT
    PERFORM CHECK-PAYEE-ACCOUNT
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    IF XP-PAYER-PART NOT = SPACES
        MOVE XP-PAYER-PART TO WS-PART-ID
        MOVE "SEND" TO WS-ROLE
        PERFORM QUERY-PARTICIPANT
        CALL "BPXRT" USING BK-PX-RT-PARMS
        IF RT-RC NOT = "00"
            MOVE "20" TO XP-RC
            MOVE "SENDER PARTICIPANT NOT ACTIVE" TO XP-MSG
        END-IF
    END-IF.

V-MANUAL-OUT.
    IF XP-PAYEE-PART = SPACES
        MOVE "20" TO XP-RC
        MOVE "RECEIVER PARTICIPANT REQUIRED" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XP-KEY-ID NOT = SPACES OR XP-QR-ID NOT = SPACES
        MOVE "20" TO XP-RC
        MOVE "MANUAL PIX MUST NOT CARRY KEY OR QR" TO XP-MSG
    END-IF.

V-KEY-OUT.
    IF XP-KEY-ID = SPACES
        MOVE "20" TO XP-RC
        MOVE "PIX KEY REQUIRED" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE "KEY-GET" TO XK-OP
    MOVE XP-KEY-ID TO XK-ID
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    IF XK-RC NOT = "00"
        MOVE SPACES TO BK-PX-KEY-PARMS
        MOVE "KEY-DICT-GET" TO XK-OP
        MOVE XP-KEY-ID TO XK-ID
        CALL "BPXKEY" USING BK-PX-KEY-PARMS
        IF XK-RC NOT = "00"
            MOVE "20" TO XP-RC
            MOVE "PIX KEY NOT FOUND" TO XP-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    IF XK-STATUS NOT = "ACTIVE"
        MOVE "20" TO XP-RC
        MOVE "PIX KEY NOT ACTIVE" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XP-KEY-TYPE = SPACES
        MOVE XK-TYPE TO XP-KEY-TYPE
    END-IF
    IF XP-KEY-MASK = SPACES
        MOVE XK-MASK TO XP-KEY-MASK
    END-IF
    IF XK-PART NOT = SPACES
        IF XP-PAYEE-PART = SPACES
            MOVE XK-PART TO XP-PAYEE-PART
        ELSE
            IF XP-PAYEE-PART NOT = XK-PART
                MOVE "20" TO XP-RC
                MOVE "PIX KEY PARTICIPANT MISMATCH" TO XP-MSG
                EXIT PARAGRAPH
            END-IF
        END-IF
    END-IF
    IF XK-SELF = "Y"
        IF XP-PAYEE-ACCT = SPACES
            MOVE XK-ACCT TO XP-PAYEE-ACCT
        END-IF
        IF XP-PAYEE-CUST = SPACES
            MOVE XK-CUST TO XP-PAYEE-CUST
        END-IF
    END-IF.

V-QR-OUT.
    IF XP-QR-ID = SPACES
        MOVE "20" TO XP-RC
        MOVE "PIX QR REQUIRED" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-QR-PARMS
    MOVE "QR-CHECK" TO XQ-OP
    MOVE XP-QR-ID TO XQ-QR-ID
    CALL "BPXQR" USING BK-PX-QR-PARMS
    IF XQ-RC = "23"
        MOVE "20" TO XP-RC
        MOVE "PIX QR NOT FOUND" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XQ-RC NOT = "00"
        MOVE "20" TO XP-RC
        IF XQ-MSG = "PIX QR EXPIRED"
            MOVE "PIX QR EXPIRED" TO XP-MSG
        ELSE
            MOVE "PIX QR NOT AVAILABLE" TO XP-MSG
        END-IF
        EXIT PARAGRAPH
    END-IF
    IF XQ-STATUS NOT = "PUBLISHED" AND XQ-STATUS NOT = "READ"
        MOVE "20" TO XP-RC
        MOVE "PIX QR NOT AVAILABLE" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XQ-AMOUNT > 0 AND XP-AMOUNT NOT = XQ-AMOUNT
        MOVE "20" TO XP-RC
        MOVE "PIX QR AMOUNT MISMATCH" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XQ-AMOUNT = 0 AND XP-ALLOW-FREE NOT = "Y"
        MOVE "20" TO XP-RC
        MOVE "OPEN AMOUNT QR NOT ALLOWED" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XQ-CURRENCY NOT = SPACES AND XQ-CURRENCY NOT = XP-CURRENCY
        MOVE "20" TO XP-RC
        MOVE "PIX QR CURRENCY MISMATCH" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XP-PAYEE-PART = SPACES
        MOVE XQ-PART TO XP-PAYEE-PART
    END-IF
    IF XP-PAYEE-ACCT = SPACES AND XQ-ACCT NOT = SPACES
        MOVE XQ-ACCT TO XP-PAYEE-ACCT
    END-IF
    IF XP-PAYEE-CUST = SPACES AND XQ-CUST NOT = SPACES
        MOVE XQ-CUST TO XP-PAYEE-CUST
    END-IF
    IF XP-PAYEE-NAME = SPACES AND XQ-PAYEE-NAME NOT = SPACES
        MOVE XQ-PAYEE-NAME TO XP-PAYEE-NAME
    END-IF
    IF XP-MERCHANT-ID = SPACES
        MOVE XQ-MERCHANT-ID TO XP-MERCHANT-ID
    END-IF
    IF XP-MERCHANT-NAME = SPACES
        MOVE XQ-MERCHANT-NAME TO XP-MERCHANT-NAME
    END-IF
    IF XP-MCC = SPACES
        MOVE XQ-MCC TO XP-MCC
    END-IF.

CHECK-PAYER-ACCOUNT.
    CALL "BACQRY" USING WS-ACCT WS-ACCT-OUT
    IF AO-RC NOT = "00"
        MOVE "20" TO XP-RC
        MOVE "PAYER ACCOUNT NOT FOUND" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF AO-STATUS NOT = "AC"
        MOVE "20" TO XP-RC
        MOVE "PAYER ACCOUNT NOT ACTIVE" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF AO-CURRENCY NOT = XP-CURRENCY
        MOVE "20" TO XP-RC
        MOVE "PAYER ACCOUNT CURRENCY MISMATCH" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE AO-CUST TO XP-PAYER-CUST.

CHECK-PAYEE-ACCOUNT.
    CALL "BACQRY" USING WS-ACCT WS-ACCT-OUT
    IF AO-RC NOT = "00"
        MOVE "20" TO XP-RC
        MOVE "RECEIVER ACCOUNT NOT FOUND" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF AO-STATUS NOT = "AC"
        MOVE "20" TO XP-RC
        MOVE "RECEIVER ACCOUNT NOT ACTIVE" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF AO-CURRENCY NOT = XP-CURRENCY
        MOVE "20" TO XP-RC
        MOVE "RECEIVER ACCOUNT CURRENCY MISMATCH" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE AO-CUST TO XP-PAYEE-CUST.

CHECK-PAYER-PARTICIPANT.
    IF XP-PAYER-PART = SPACES
        MOVE PC-SELF TO XP-PAYER-PART
    END-IF
    MOVE XP-PAYER-PART TO WS-PART-ID
    MOVE "SEND" TO WS-ROLE
    PERFORM QUERY-PARTICIPANT
    CALL "BPXRT" USING BK-PX-RT-PARMS
    IF RT-RC NOT = "00"
        MOVE "20" TO XP-RC
        MOVE RT-MSG TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF RT-SELF-FLAG NOT = "Y"
        MOVE "20" TO XP-RC
        MOVE "PIX PAYER PARTICIPANT IS NOT THIS INSTITUTION"
            TO XP-MSG
    END-IF.

SPLIT-ACCT-CHECKS.
    IF AO-RC NOT = "00"
        MOVE "20" TO XP-RC
        MOVE "ALLOCATION ACCOUNT NOT FOUND" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF AO-STATUS NOT = "AC"
        MOVE "20" TO XP-RC
        MOVE "ALLOCATION ACCOUNT NOT ACTIVE" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF AO-CURRENCY NOT = XP-CURRENCY
        MOVE "20" TO XP-RC
        MOVE "ALLOCATION CURRENCY MISMATCH" TO XP-MSG
    END-IF.

V-SPLIT-OUT.
    IF XP-SPLIT-CNT < 1 OR XP-SPLIT-CNT > 20
        MOVE "20" TO XP-RC
        MOVE "SPLIT REQUIRES 1 TO 20 ALLOCATIONS" TO XP-MSG
        GOBACK
    END-IF
    IF XP-KEY-ID NOT = SPACES OR XP-QR-ID NOT = SPACES
        MOVE "20" TO XP-RC
        MOVE "SPLIT PAYEE MUST BE THE ALLOCATION TABLE"
            TO XP-MSG
        GOBACK
    END-IF
    MOVE 0 TO WS-SPL-TOT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > XP-SPLIT-CNT
        IF XP-PS-SEQ(WS-I) NOT = WS-I
            MOVE "20" TO XP-RC
            MOVE "SPLIT ALLOCATION SEQ NOT CONTIGUOUS"
                TO XP-MSG
            GOBACK
        END-IF
        IF FUNCTION TRIM(XP-PS-ROLE(WS-I)) NOT = "CUSTOMER" AND
           FUNCTION TRIM(XP-PS-ROLE(WS-I)) NOT = "MERCHANT" AND
           FUNCTION TRIM(XP-PS-ROLE(WS-I)) NOT = "PARTICIPANT" AND
           FUNCTION TRIM(XP-PS-ROLE(WS-I)) NOT = "TAX"
            MOVE "20" TO XP-RC
            MOVE "UNSUPPORTED ALLOCATION ROLE" TO XP-MSG
            GOBACK
        END-IF
        IF FUNCTION TRIM(XP-PS-TYPE(WS-I)) NOT = "MAIN" AND
           FUNCTION TRIM(XP-PS-TYPE(WS-I)) NOT = "TAX"
            MOVE "20" TO XP-RC
            MOVE "UNSUPPORTED ALLOCATION TYPE" TO XP-MSG
            GOBACK
        END-IF
        IF XP-PS-ID(WS-I) = SPACES
            MOVE "20" TO XP-RC
            MOVE "ALLOCATION DESTINATION REQUIRED" TO XP-MSG
            GOBACK
        END-IF
        IF XP-PS-AMT(WS-I) <= 0
            MOVE "20" TO XP-RC
            MOVE "ALLOCATION AMOUNT MUST BE POSITIVE" TO XP-MSG
            GOBACK
        END-IF
        IF FUNCTION TRIM(XP-PS-TYPE(WS-I)) = "TAX"
            IF XP-PS-TAXTYPE(WS-I) = SPACES OR
               XP-PS-TAXCAT(WS-I) = SPACES OR
               XP-PS-DOCREF(WS-I) = SPACES
                MOVE "20" TO XP-RC
                MOVE "TAX ALLOCATION METADATA INCOMPLETE"
                    TO XP-MSG
                GOBACK
            END-IF
        ELSE
            IF XP-PS-TAXTYPE(WS-I) NOT = SPACES OR
               XP-PS-TAXCAT(WS-I) NOT = SPACES OR
               XP-PS-DOCREF(WS-I) NOT = SPACES
                MOVE "20" TO XP-RC
                MOVE "TAX METADATA ON NON-TAX ALLOCATION"
                    TO XP-MSG
                GOBACK
            END-IF
        END-IF
        EVALUATE FUNCTION TRIM(XP-PS-ROLE(WS-I))
            WHEN "PARTICIPANT"
                MOVE XP-PS-ID(WS-I) TO WS-PART-ID
                MOVE "RECEIVE" TO WS-ROLE
                PERFORM QUERY-PARTICIPANT
                CALL "BPXRT" USING BK-PX-RT-PARMS
                IF RT-RC NOT = "00"
                    MOVE "20" TO XP-RC
                    MOVE RT-MSG TO XP-MSG
                    GOBACK
                END-IF
            WHEN "TAX"
                CALL "BACQRY" USING XP-PS-ID(WS-I) WS-ACCT-OUT
                IF AO-RC NOT = "00"
                    MOVE XP-PS-ID(WS-I) TO WS-PART-ID
                    MOVE "RECEIVE" TO WS-ROLE
                    PERFORM QUERY-PARTICIPANT
                    CALL "BPXRT" USING BK-PX-RT-PARMS
                    IF RT-RC NOT = "00"
                        MOVE "20" TO XP-RC
                        MOVE "TAX DEST NOT RESOLVABLE"
                            TO XP-MSG
                        GOBACK
                    END-IF
                ELSE
                    PERFORM SPLIT-ACCT-CHECKS
                    IF XP-RC NOT = "00"
                        GOBACK
                    END-IF
                END-IF
            WHEN OTHER
                CALL "BACQRY" USING XP-PS-ID(WS-I) WS-ACCT-OUT
                PERFORM SPLIT-ACCT-CHECKS
                IF XP-RC NOT = "00"
                    GOBACK
                END-IF
        END-EVALUATE
        ADD XP-PS-AMT(WS-I) TO WS-SPL-TOT
    END-PERFORM
    IF WS-SPL-TOT NOT = XP-AMOUNT
        MOVE "20" TO XP-RC
        MOVE "PIX SPLIT ALLOCATION SUM != GROSS" TO XP-MSG
        GOBACK
    END-IF
    MOVE WS-SPL-TOT TO XP-SPLIT-TOTAL.

CHECK-PAYEE-PARTICIPANT.
    IF XP-PAYEE-PART = SPACES
        MOVE "20" TO XP-RC
        MOVE "RECEIVER PARTICIPANT REQUIRED" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE XP-PAYEE-PART TO WS-PART-ID
    MOVE "RECEIVE" TO WS-ROLE
    PERFORM QUERY-PARTICIPANT
    CALL "BPXRT" USING BK-PX-RT-PARMS
    IF RT-RC NOT = "00"
        MOVE "20" TO XP-RC
        MOVE RT-MSG TO XP-MSG
        EXIT PARAGRAPH
    END-IF.

CHECK-SELF-TRANSFER.
    IF XP-DIRECTION = "OUT" AND XP-PAYER-PART = XP-PAYEE-PART AND
       XP-PAYEE-ACCT NOT = SPACES AND
       XP-PAYEE-ACCT = XP-PAYER-ACCT
        MOVE "20" TO XP-RC
        MOVE "PIX SOURCE AND DESTINATION MUST DIFFER" TO XP-MSG
    END-IF.

CHECK-PIX-FUNDS.
    CALL "BGLBAL" USING WS-ACCT WS-BAL-OUT
    IF BO-RC NOT = "00"
        MOVE "20" TO XP-RC
        MOVE "PAYER BALANCE NOT FOUND" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF BO-AVAILABLE < XP-AMOUNT
        MOVE "20" TO XP-RC
        MOVE "INSUFFICIENT FUNDS" TO XP-MSG
    END-IF.

RESOLVE-INBOUND-ACCOUNT.
    IF XP-PAYEE-ACCT NOT = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE "KEY-GET" TO XK-OP
    MOVE XP-KEY-ID TO XK-ID
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    IF XK-RC NOT = "00"
        MOVE "20" TO XP-RC
        MOVE "PIX KEY NOT FOUND" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XK-STATUS NOT = "ACTIVE"
        MOVE "20" TO XP-RC
        MOVE "PIX KEY NOT ACTIVE" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XK-SELF NOT = "Y"
        MOVE "20" TO XP-RC
        MOVE "PIX KEY NOT OWNED BY THIS INSTITUTION" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    IF XK-ACCT = SPACES
        MOVE "20" TO XP-RC
        MOVE "PIX KEY HAS NO ACCOUNT" TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE XK-ACCT TO XP-PAYEE-ACCT
    IF XP-PAYEE-CUST = SPACES
        MOVE XK-CUST TO XP-PAYEE-CUST
    END-IF
    IF XP-KEY-TYPE = SPACES
        MOVE XK-TYPE TO XP-KEY-TYPE
    END-IF
    IF XP-KEY-MASK = SPACES
        MOVE XK-MASK TO XP-KEY-MASK
    END-IF.

QUERY-PARTICIPANT.
    MOVE SPACES TO BK-PX-RT-PARMS
    MOVE "PARTICIPANT-CHECK" TO RT-OP
    MOVE WS-PART-ID TO RT-PART-ID
    MOVE WS-ROLE TO RT-ROLE.

CHECK-FRAUD-RESTRICTION.
    MOVE SPACES TO BK-PX-FRD-PARMS
    MOVE "FRAUD-CHECK" TO FP-OP
    IF XP-DIRECTION = "OUT"
        MOVE "OUT" TO FP-DIRECTION
        MOVE XP-PAYER-ACCT TO FP-TARGET-KEY
        MOVE "ACCOUNT" TO FP-TARGET-TYPE
    ELSE
        MOVE "IN" TO FP-DIRECTION
        MOVE XP-PAYEE-ACCT TO FP-TARGET-KEY
        MOVE "ACCOUNT" TO FP-TARGET-TYPE
    END-IF
    CALL "BPXFR" USING BK-PX-FRD-PARMS
    IF FP-RC NOT = "00"
        MOVE "20" TO XP-RC
        MOVE FP-MSG TO XP-MSG
    END-IF.

CHECK-LIMITS.
    MOVE SPACES TO BK-LIM-REQ
    MOVE "ACCOUNT" TO LIM-SCOPE
    IF XP-DIRECTION = "OUT"
        MOVE XP-PAYER-ACCT TO LIM-KEY
    ELSE
        MOVE XP-PAYEE-ACCT TO LIM-KEY
    END-IF
    MOVE "DAILY" TO LIM-PERIOD
    MOVE XP-AMOUNT TO LIM-AMOUNT
    MOVE XP-CURRENCY TO LIM-CURRENCY
    MOVE "CHECK" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ
    IF LIM-RC NOT = "00"
        MOVE "20" TO XP-RC
        MOVE LIM-MSG TO XP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-LIM-REQ
    MOVE "CHANNEL" TO LIM-SCOPE
    MOVE "PIX" TO LIM-KEY
    MOVE "DAILY" TO LIM-PERIOD
    MOVE XP-AMOUNT TO LIM-AMOUNT
    MOVE XP-CURRENCY TO LIM-CURRENCY
    MOVE "CHECK" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ
