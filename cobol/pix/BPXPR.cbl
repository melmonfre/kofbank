IDENTIFICATION DIVISION.
PROGRAM-ID. BPXPR.

*> Pix payment orchestration.  Financial effects are produced only through
*> the existing transaction lifecycle (BTXNLFC -> BTXNPOST -> BGLPST).
*> This program owns Pix state, idempotency and correlation only.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BPXCFG".
COPY "BPXSTO".
COPY "BPXSP".
COPY "BLIMP".
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BKIDMP".
COPY "BPXQP".
COPY "BDATP".
01 BK-PX-REC.
   COPY "BPX".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-ACCT-OUT.
   05 AO-ID PIC X(12).
   05 AO-CUST PIC X(12).
   05 AO-PRODUCT PIC X(04).
   05 AO-CURRENCY PIC X(03).
   05 AO-STATUS PIC X(02).
   05 AO-OPENED PIC 9(08).
   05 AO-CLOSED PIC 9(08).
   05 AO-VERSION PIC 9(05).
   05 AO-HASH PIC X(16).
   05 AO-RC PIC X(02).
01 WS-ACCT-OUT2.
   05 A2-ID PIC X(12).
   05 A2-CUST PIC X(12).
   05 A2-PRODUCT PIC X(04).
   05 A2-CURRENCY PIC X(03).
   05 A2-STATUS PIC X(02).
   05 A2-OPENED PIC 9(08).
   05 A2-CLOSED PIC 9(08).
   05 A2-VERSION PIC 9(05).
   05 A2-HASH PIC X(16).
   05 A2-RC PIC X(02).
01 WS-LOCK-NAME PIC X(24).
01 WS-LOCK-OWNER PIC X(16).
01 WS-LOCK-MODE PIC X(01).
01 WS-LOCK-ST PIC X(02).
01 WS-ID-TYPE PIC X(08).
01 WS-ISPB PIC X(08).
01 WS-ID-VAL PIC X(32).
01 WS-ID-RC PIC X(02).
01 WS-NOW PIC X(14).
01 WS-LOADED PIC X(01).
01 WS-CUR-STATUS PIC X(12).
01 WS-EVT PIC X(16).
01 WS-NXT PIC X(12).
01 WS-STM-RC PIC X(02).
01 WS-STM-MSG PIC X(80).
01 WS-HASH-BUF PIC X(600).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-AUD-ACTION PIC X(12).
01 WS-EVT-TYPE PIC X(40).
01 WS-IDM-KEY PIC X(24).
01 WS-IDM-MODE PIC X(01).
01 WS-OPNAME PIC X(12).
01 WS-LOCAL-RECEIVER PIC X(01).
01 WS-EXT-RC PIC X(02).
01 WS-EXTERNAL-OK PIC X(01).
01 WS-TXN-TYPE PIC X(08).
01 WS-LFC-REQ PIC X(24).
01 WS-POST-RC PIC X(02).
01 WS-POST-MSG PIC X(80).
01 WS-TXN-KEEP PIC X(12).
01 WS-SIM PIC X(12).
COPY "BTXNLFC".
COPY "BTXNRESP".
01 WS-BLK.
   05 BLK-ACCT PIC X(12).
   05 BLK-AMOUNT PIC S9(15)V99 COMP-3.
   05 BLK-CURRENCY PIC X(03).
   05 BLK-REASON PIC X(40).
   05 BLK-OPERATOR PIC X(12).
   05 BLK-CORR PIC X(24).
   05 BLK-RC PIC X(02).
   05 BLK-MSG PIC X(80).

LINKAGE SECTION.
COPY "BPXPP".

PROCEDURE DIVISION USING BK-PX-PARMS.
    MOVE "00" TO XP-RC
    MOVE SPACES TO XP-MSG
    MOVE "N" TO XP-REPLAY
    MOVE "N" TO WS-LOADED
    CALL "BCFG" USING WS-CFG
    CALL "BPXCFG" USING BK-PX-CFG
    IF PC-STATUS NOT = "00"
        MOVE "20" TO XP-RC
        MOVE "PIX CONFIG MISSING" TO XP-MSG
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(XP-OP)
        WHEN "PIX-REQUEST" PERFORM DO-REQUEST
        WHEN "PIX-PROCESS" PERFORM DO-PROCESS
        WHEN "PIX-CONFIRM" PERFORM DO-CONFIRM
        WHEN "PIX-POST" PERFORM DO-POST-LEG
        WHEN "PIX-RETRY" PERFORM DO-RETRY
        WHEN "PIX-STATUS" PERFORM DO-STATUS
        WHEN "PIX-GET" PERFORM DO-GET
        WHEN "PIX-GET-E2E" PERFORM DO-GET-E2E
        WHEN "PIX-EXCEPTION" PERFORM DO-EXCEPTION
        WHEN OTHER
            MOVE "99" TO XP-RC
            MOVE "UNKNOWN PIX OP" TO XP-MSG
    END-EVALUATE
    GOBACK.

DO-REQUEST.
    IF XP-DATE IS NOT NUMERIC OR XP-DATE = 0
        MOVE WS-BIZDATE TO XP-DATE
    END-IF
    PERFORM CHECK-IDEMPOTENCY
    IF XP-RC NOT = "00" OR XP-REPLAY = "Y"
        GOBACK
    END-IF
    CALL "BPXVAL" USING BK-PX-PARMS
    IF XP-RC NOT = "00"
        PERFORM MARK-FAIL
        GOBACK
    END-IF
    PERFORM BUILD-PIX-ID
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM INIT-RECORD
    PERFORM WRITE-RECORD
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "VALIDATED" TO XP-STATUS
    PERFORM APPLY-STATUS
    IF XP-RC = "00"
        PERFORM PERSIST-RECORD
    END-IF
    IF XP-RC = "00" AND XP-AUTO NOT = "N"
        PERFORM DO-PROCESS
    END-IF
    IF XP-RC = "00"
        PERFORM MARK-COMPLETE
    END-IF.

DO-PROCESS.
    PERFORM LOAD-PIX
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    IF PX-STATUS OF BK-PX-REC = "PROCESSING" OR
       PX-STATUS OF BK-PX-REC = "SUBMITTED" OR
       PX-STATUS OF BK-PX-REC = "ACCEPTED"
        MOVE "Y" TO XP-REPLAY
        PERFORM EXPOSE
        MOVE "PIX ALREADY PROCESSED" TO XP-MSG
        GOBACK
    END-IF
    IF PX-STATUS OF BK-PX-REC NOT = "VALIDATED" AND
       PX-STATUS OF BK-PX-REC NOT = "AUTHORIZED" AND
       PX-STATUS OF BK-PX-REC NOT = "RECEIVED"
        MOVE "20" TO XP-RC
        MOVE "PIX NOT READY FOR PROCESSING" TO XP-MSG
        GOBACK
    END-IF
    IF PX-DIRECTION OF BK-PX-REC = "OUT"
        MOVE "AUTHORIZED" TO XP-STATUS
        PERFORM APPLY-STATUS
        IF XP-RC = "00"
            PERFORM PERSIST-RECORD
        END-IF
        IF XP-RC = "00"
            MOVE "PROCESSING" TO XP-STATUS
            PERFORM APPLY-STATUS
            IF XP-RC = "00"
                PERFORM PERSIST-RECORD
            END-IF
        END-IF
    END-IF
    IF XP-RC = "00"
        PERFORM CONSUME-LIMITS
    END-IF
    IF XP-RC = "00" AND PX-DIRECTION OF BK-PX-REC = "IN"
        PERFORM DO-CONFIRM
    END-IF
    IF XP-RC = "00" AND PX-DIRECTION OF BK-PX-REC = "OUT"
        PERFORM SUBMIT-EXTERNAL
    END-IF
    IF XP-RC = "00" AND PX-DIRECTION OF BK-PX-REC = "OUT" AND
       WS-EXTERNAL-OK = "Y"
        PERFORM DO-CONFIRM
    ELSE
        IF XP-RC = "00"
            IF PX-DIRECTION OF BK-PX-REC = "OUT"
                PERFORM EXPOSE
                MOVE "PIX AWAITING EXTERNAL OUTCOME" TO XP-MSG
            END-IF
        ELSE
            PERFORM MARK-FAIL
        END-IF
    END-IF.

DO-RETRY.
    PERFORM LOAD-PIX
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    IF PX-STATUS OF BK-PX-REC NOT = "TIMEOUT" AND
       PX-STATUS OF BK-PX-REC NOT = "FAILED" AND
       PX-STATUS OF BK-PX-REC NOT = "POST-FAILED" AND
       PX-STATUS OF BK-PX-REC NOT = "EXCEPTION"
        MOVE "20" TO XP-RC
        MOVE "PIX NOT RETRYABLE" TO XP-MSG
        PERFORM EXPOSE
        GOBACK
    END-IF
    MOVE "RETRY" TO XP-EVENT
    EVALUATE FUNCTION TRIM(PX-STATUS OF BK-PX-REC)
        WHEN "POST-FAILED"
            MOVE "POST-PENDING" TO XP-STATUS
        WHEN "EXCEPTION"
            MOVE "VALIDATED" TO XP-STATUS
        WHEN OTHER
            MOVE "PROCESSING" TO XP-STATUS
    END-EVALUATE
    PERFORM APPLY-STATUS
    MOVE SPACES TO XP-EVENT
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM PERSIST-RECORD
    IF XP-STATUS = "POST-PENDING"
        PERFORM DO-POST-LEG
        GOBACK
    END-IF
    IF XP-STATUS NOT = "PROCESSING"
        PERFORM EXPOSE
        MOVE "PIX RETRY REQUIRES NEXT STEP" TO XP-MSG
        GOBACK
    END-IF
    IF PX-DIRECTION OF BK-PX-REC = "IN"
        PERFORM DO-CONFIRM
        GOBACK
    END-IF
    PERFORM SUBMIT-EXTERNAL
    IF XP-RC = "00" AND WS-EXTERNAL-OK = "Y"
        PERFORM DO-CONFIRM
    END-IF.

SUBMIT-EXTERNAL.
    MOVE SPACES TO BK-PX-SPI-PARMS
    MOVE "SUBMIT" TO SI-OP
    MOVE PC-ADAPTER TO SI-ADAPTER
    IF XP-SIM NOT = SPACES
        MOVE XP-SIM TO SI-SIM
    ELSE
        MOVE PC-SIMULATE TO SI-SIM
    END-IF
    MOVE PX-E2E-ID OF BK-PX-REC TO SI-E2E-ID
    MOVE PX-AMOUNT OF BK-PX-REC TO SI-AMOUNT
    MOVE PX-CURRENCY OF BK-PX-REC TO SI-CURRENCY
    MOVE PX-PAYER-PART OF BK-PX-REC TO SI-PAYER-PART
    MOVE PX-PAYEE-PART OF BK-PX-REC TO SI-PAYEE-PART
    CALL "BPXSPI" USING BK-PX-SPI-PARMS
    MOVE SI-EXT-REF TO XP-EXT-REF
    MOVE SI-EXT-REF TO PX-EXT-REF OF BK-PX-REC
    MOVE "N" TO WS-EXTERNAL-OK
    MOVE "00" TO WS-EXT-RC
    EVALUATE FUNCTION TRIM(SI-RESULT)
        WHEN "ACCEPTED"
            MOVE "SUBMITTED" TO XP-STATUS
            PERFORM APPLY-STATUS
            IF XP-RC = "00"
                MOVE "Y" TO WS-EXTERNAL-OK
            END-IF
        WHEN "TIMEOUT"
            MOVE "TIMEOUT" TO XP-STATUS
            PERFORM APPLY-STATUS
            MOVE "24" TO WS-EXT-RC
            MOVE "SPI OUTCOME UNKNOWN" TO XP-MSG
        WHEN "REJECTED"
            MOVE "REJECTED" TO XP-STATUS
            PERFORM APPLY-STATUS
            MOVE "20" TO WS-EXT-RC
            MOVE "SPI REJECTED PAYMENT" TO XP-MSG
        WHEN "FAILED"
            MOVE "FAILED" TO XP-STATUS
            PERFORM APPLY-STATUS
            MOVE "20" TO WS-EXT-RC
            MOVE "SPI PROCESSING FAILURE" TO XP-MSG
        WHEN OTHER
            MOVE "FAILED" TO XP-STATUS
            PERFORM APPLY-STATUS
            MOVE "20" TO WS-EXT-RC
            MOVE "UNDETERMINED SPI RESULT" TO XP-MSG
    END-EVALUATE
    IF XP-RC NOT = "22"
        PERFORM PERSIST-RECORD
    END-IF
    IF XP-RC = "00" AND WS-EXT-RC NOT = "00"
        MOVE WS-EXT-RC TO XP-RC
    END-IF.

DO-CONFIRM.
    PERFORM LOAD-PIX
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    IF PX-STATUS OF BK-PX-REC = "RECONCILED" OR
       PX-STATUS OF BK-PX-REC = "SETTLED" OR
       PX-STATUS OF BK-PX-REC = "POSTED"
        MOVE "Y" TO XP-REPLAY
        PERFORM EXPOSE
        MOVE "PIX ALREADY CONFIRMED" TO XP-MSG
        GOBACK
    END-IF
    IF XP-EXT-REF NOT = SPACES
        MOVE XP-EXT-REF TO PX-EXT-REF OF BK-PX-REC
    END-IF
    MOVE "ACCEPTED" TO XP-STATUS
    PERFORM APPLY-STATUS
    IF XP-RC = "00"
        MOVE PX-EXT-REF OF BK-PX-REC TO XP-EXT-REF
        MOVE WS-BIZDATE TO PX-ACCEPT-DATE OF BK-PX-REC
        PERFORM PERSIST-RECORD
    END-IF
    IF XP-RC = "00"
        PERFORM DO-POST-LEG
    END-IF.

DO-POST-LEG.
    PERFORM LOAD-PIX
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    IF PX-POST-STATUS OF BK-PX-REC = "POSTED"
        MOVE "Y" TO XP-REPLAY
        PERFORM EXPOSE
        MOVE "PIX POSTING REPLAY" TO XP-MSG
        GOBACK
    END-IF
    IF PX-POST-STATUS OF BK-PX-REC = "REVERSED"
        MOVE "20" TO XP-RC
        MOVE "PIX POSTING REVERSED" TO XP-MSG
        GOBACK
    END-IF
    IF PX-STATUS OF BK-PX-REC NOT = "ACCEPTED"
        MOVE "20" TO XP-RC
        MOVE "PIX NOT ACCEPTED FOR POSTING" TO XP-MSG
        GOBACK
    END-IF
    MOVE "POST-PENDING" TO XP-STATUS
    PERFORM APPLY-STATUS
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM PERSIST-RECORD
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM FINANCIAL-POST
    MOVE XP-RC TO WS-POST-RC
    MOVE XP-MSG TO WS-POST-MSG
    MOVE "00" TO XP-RC
    IF WS-POST-RC = "00"
        MOVE "POSTED" TO XP-STATUS
        MOVE "POSTED" TO XP-POST-STATUS
        MOVE "POSTED" TO PX-POST-STATUS OF BK-PX-REC
        MOVE WS-BIZDATE TO PX-POST-DATE OF BK-PX-REC
    ELSE
        MOVE "POST-FAILED" TO XP-STATUS
        MOVE "FAILED" TO XP-POST-STATUS
        MOVE "FAILED" TO PX-POST-STATUS OF BK-PX-REC
    END-IF
    PERFORM APPLY-STATUS
    PERFORM PERSIST-RECORD
    IF WS-POST-RC NOT = "00"
        MOVE WS-POST-RC TO XP-RC
        MOVE WS-POST-MSG TO XP-MSG
        PERFORM EXPOSE
        GOBACK
    END-IF
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM RELEASE-QR
    PERFORM EXPOSE
    MOVE "PIX POSTED" TO XP-MSG.

FINANCIAL-POST.
    MOVE SPACES TO BK-TXN-LFC-REQ
    EVALUATE PX-DIRECTION OF BK-PX-REC
        WHEN "OUT"
            IF WS-LOCAL-RECEIVER = "Y"
                MOVE "TRANSFER" TO WS-TXN-TYPE
            ELSE
                MOVE "PIXOUT" TO WS-TXN-TYPE
            END-IF
            MOVE PX-PAYER-ACCT OF BK-PX-REC TO LFC-SRC
            IF WS-LOCAL-RECEIVER = "Y"
                IF PX-PAYEE-ACCT OF BK-PX-REC = SPACES
                    MOVE "20" TO XP-RC
                    MOVE "LOCAL PIX REQUIRES RECEIVER ACCOUNT"
                        TO XP-MSG
                    GOBACK
                END-IF
                MOVE PX-PAYEE-ACCT OF BK-PX-REC TO LFC-DST
            ELSE
                MOVE PX-PAYEE-PART OF BK-PX-REC TO LFC-DST
            END-IF
        WHEN "IN"
            MOVE "PIXIN" TO WS-TXN-TYPE
            MOVE PX-PAYEE-ACCT OF BK-PX-REC TO LFC-DST
            MOVE PX-PAYER-PART OF BK-PX-REC TO LFC-SRC
    END-EVALUATE
    MOVE WS-TXN-TYPE TO LFC-TYPE
    MOVE PX-AMOUNT OF BK-PX-REC TO LFC-AMOUNT
    MOVE PX-CURRENCY OF BK-PX-REC TO LFC-CURRENCY
    MOVE PX-DESCR OF BK-PX-REC TO LFC-DESCR
    MOVE PX-OPERATOR OF BK-PX-REC TO LFC-OPERATOR
    MOVE PX-CORR OF BK-PX-REC TO LFC-CORR
    MOVE PX-ID OF BK-PX-REC TO LFC-REF
    MOVE "PIX" TO LFC-ORIGIN
    MOVE SPACES TO LFC-FACILITY
    MOVE 0 TO LFC-PRINCIPAL
    MOVE 0 TO LFC-INTEREST
    MOVE 0 TO LFC-FEE-AMT
    MOVE "CREATE" TO LFC-OP
    PERFORM DO-LFC-STEP
    IF XP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE TXR-ID TO PX-TXN-ID OF BK-PX-REC
    MOVE "AUTHORIZE" TO LFC-OP
    PERFORM DO-LFC-STEP
    IF XP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "POST" TO LFC-OP
    PERFORM DO-LFC-STEP
    IF XP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SETTLE" TO LFC-OP
    PERFORM DO-LFC-STEP
    IF XP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE TXR-ID TO PX-TXN-ID OF BK-PX-REC
    MOVE TXR-JRN-ID TO PX-JRN-ID OF BK-PX-REC.

DO-LFC-STEP.
    IF LFC-OP = "CREATE"
        MOVE SPACES TO LFC-TXN-ID
    ELSE
        MOVE WS-TXN-KEEP TO LFC-TXN-ID
    END-IF
    MOVE SPACES TO WS-LFC-REQ
    MOVE PX-ID OF BK-PX-REC TO WS-LFC-REQ
    EVALUATE LFC-OP
        WHEN "CREATE" MOVE "C" TO WS-LFC-REQ(13:1)
        WHEN "AUTHORIZE" MOVE "A" TO WS-LFC-REQ(13:1)
        WHEN "POST" MOVE "P" TO WS-LFC-REQ(13:1)
        WHEN "SETTLE" MOVE "S" TO WS-LFC-REQ(13:1)
    END-EVALUATE
    MOVE WS-LFC-REQ TO LFC-REQUEST
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    IF TXR-RC = "00"
        MOVE TXR-ID TO WS-TXN-KEEP
    ELSE
        MOVE TXR-RC TO XP-RC
        MOVE TXR-MSG TO XP-MSG
    END-IF.

DO-STATUS.
    PERFORM LOAD-PIX
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM APPLY-STATUS
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM PERSIST-RECORD
    IF XP-RC = "00"
        PERFORM EXPOSE
        MOVE "PIX STATUS UPDATED" TO XP-MSG
    END-IF.

DO-EXCEPTION.
    PERFORM LOAD-PIX
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "EXCEPTION" TO XP-STATUS
    PERFORM APPLY-STATUS
    IF XP-RC = "00"
        PERFORM PERSIST-RECORD
    END-IF.

DO-GET.
    PERFORM LOAD-PIX
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM EXPOSE
    MOVE "PIX TRANSACTION" TO XP-MSG.

DO-GET-E2E.
    MOVE SPACES TO BK-PX-REC
    MOVE XP-E2E-ID TO PX-E2E-ID OF BK-PX-REC
    MOVE "GET-E2E" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC NOT = "00"
        MOVE XS-RC TO XP-RC
        MOVE XS-MSG TO XP-MSG
        GOBACK
    END-IF
    MOVE PX-ID OF BK-PX-REC TO XP-PIX-ID
    MOVE "00" TO XP-RC
    PERFORM LOAD-PIX
    IF XP-RC = "00"
        PERFORM EXPOSE
        MOVE "PIX TRANSACTION" TO XP-MSG
    END-IF.

CHECK-IDEMPOTENCY.
    MOVE "PIX-REQUEST" TO WS-OPNAME
    IF XP-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE XP-REQUEST TO BK-IDM-TXN-ID
    MOVE WS-OPNAME TO BK-IDM-OPERATION
    MOVE "B" TO BK-IDM-MODE
    MOVE SPACES TO BK-IDM-RESULT
    CALL "BIDM" USING BK-IDM-PARMS
    IF BK-IDM-STATUS = "22"
        MOVE "G" TO BK-IDM-MODE
        CALL "BIDM" USING BK-IDM-PARMS
        EVALUATE BK-IDM-STATUS
            WHEN "C"
                MOVE BK-IDM-RESULT(1:12) TO XP-PIX-ID
                PERFORM LOAD-PIX-BY-ID
                IF XP-RC = "00"
                    MOVE "Y" TO XP-REPLAY
                    PERFORM EXPOSE
                    MOVE "PIX REPLAY" TO XP-MSG
                END-IF
            WHEN "F"
                CONTINUE
            WHEN OTHER
                MOVE "24" TO XP-RC
                MOVE "PIX REQUEST IN PROGRESS" TO XP-MSG
        END-EVALUATE
    ELSE
        IF BK-IDM-STATUS NOT = "00"
            MOVE BK-IDM-STATUS TO XP-RC
            MOVE "PIX IDEMPOTENCY STORE ERROR" TO XP-MSG
        END-IF
    END-IF.

MAP-STATUS-TO-EVENT.
    MOVE SPACES TO WS-EVT
    EVALUATE FUNCTION TRIM(XP-STATUS)
        WHEN "VALIDATED" MOVE "VALIDATE" TO WS-EVT
        WHEN "AUTHORIZED" MOVE "AUTHORIZE" TO WS-EVT
        WHEN "PROCESSING" MOVE "START" TO WS-EVT
        WHEN "SUBMITTED" MOVE "SUBMIT" TO WS-EVT
        WHEN "ACCEPTED" MOVE "ACCEPT" TO WS-EVT
        WHEN "REJECTED" MOVE "REJECT" TO WS-EVT
        WHEN "FAILED" MOVE "FAIL" TO WS-EVT
        WHEN "TIMEOUT" MOVE "TIMEOUT" TO WS-EVT
        WHEN "CANCELLED" MOVE "CANCEL" TO WS-EVT
        WHEN "EXPIRED" MOVE "EXPIRE" TO WS-EVT
        WHEN "RETURNED" MOVE "RETURN" TO WS-EVT
        WHEN "POST-PENDING" MOVE "POST-PENDING" TO WS-EVT
        WHEN "POSTED" MOVE "POST" TO WS-EVT
        WHEN "POST-FAILED" MOVE "POST-FAIL" TO WS-EVT
        WHEN "SETTLE-PEND" MOVE "BATCH" TO WS-EVT
        WHEN "SETTLED" MOVE "SETTLE" TO WS-EVT
        WHEN "RECONCILED" MOVE "RECON" TO WS-EVT
        WHEN "DEVOLVED" MOVE "DEVOLVE" TO WS-EVT
        WHEN "EXCEPTION" MOVE "EXCEPTION" TO WS-EVT
        WHEN OTHER
            MOVE "20" TO XP-RC
            MOVE "UNKNOWN PIX STATUS" TO XP-MSG
    END-EVALUATE.

MARK-COMPLETE.
    IF XP-REQUEST = SPACES OR XP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE XP-REQUEST TO BK-IDM-TXN-ID
    MOVE WS-OPNAME TO BK-IDM-OPERATION
    MOVE SPACES TO BK-IDM-RESULT
    MOVE XP-PIX-ID TO BK-IDM-RESULT(1:12)
    MOVE XP-STATUS TO BK-IDM-RESULT(13:12)
    MOVE XP-MSG TO BK-IDM-RESULT(31:50)
    MOVE "C" TO BK-IDM-MODE
    CALL "BIDM" USING BK-IDM-PARMS.

MARK-FAIL.
    IF XP-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE XP-REQUEST TO BK-IDM-TXN-ID
    MOVE "PIX-REQUEST" TO BK-IDM-OPERATION
    MOVE XP-MSG TO BK-IDM-RESULT
    MOVE "F" TO BK-IDM-MODE
    CALL "BIDM" USING BK-IDM-PARMS.

BUILD-PIX-ID.
    MOVE "PIX" TO WS-ID-TYPE
    MOVE PC-E2E-ISPB TO WS-ISPB
    CALL "BPXID" USING WS-ID-TYPE WS-ISPB WS-ID-VAL WS-ID-RC
    IF WS-ID-RC NOT = "00"
        MOVE "20" TO XP-RC
        MOVE "PIX SEQUENCE ERROR" TO XP-MSG
        GOBACK
    END-IF
    MOVE WS-ID-VAL(1:12) TO XP-PIX-ID
    IF XP-DIRECTION = "OUT"
        CALL "BPXID" USING WS-ID-TYPE WS-ISPB WS-ID-VAL WS-ID-RC
        MOVE WS-ID-VAL TO XP-E2E-ID
    END-IF.

INIT-RECORD.
    MOVE SPACES TO BK-PX-REC
    MOVE XP-PIX-ID TO PX-ID OF BK-PX-REC
    MOVE XP-DIRECTION TO PX-DIRECTION OF BK-PX-REC
    MOVE XP-MODALITY TO PX-MODALITY OF BK-PX-REC
    MOVE XP-ENV TO PX-ENV OF BK-PX-REC
    MOVE XP-E2E-ID TO PX-E2E-ID OF BK-PX-REC
    MOVE XP-EXT-REF TO PX-EXT-REF OF BK-PX-REC
    MOVE XP-KEY-ID TO PX-KEY-ID OF BK-PX-REC
    MOVE XP-KEY-TYPE TO PX-KEY-TYPE OF BK-PX-REC
    MOVE XP-KEY-MASK TO PX-KEY-MASK OF BK-PX-REC
    MOVE XP-QR-ID TO PX-QR-ID OF BK-PX-REC
    MOVE XP-ORIG-PIX-ID TO PX-ORIG-PIX-ID OF BK-PX-REC
    MOVE XP-MED-CASE TO PX-MED-CASE OF BK-PX-REC
    MOVE XP-PAYER-PART TO PX-PAYER-PART OF BK-PX-REC
    MOVE XP-PAYEE-PART TO PX-PAYEE-PART OF BK-PX-REC
    MOVE XP-PAYER-ACCT TO PX-PAYER-ACCT OF BK-PX-REC
    MOVE XP-PAYER-CUST TO PX-PAYER-CUST OF BK-PX-REC
    MOVE XP-PAYEE-ACCT TO PX-PAYEE-ACCT OF BK-PX-REC
    MOVE XP-PAYEE-CUST TO PX-PAYEE-CUST OF BK-PX-REC
    MOVE XP-PAYEE-NAME TO PX-PAYEE-NAME OF BK-PX-REC
    MOVE XP-MERCHANT-ID TO PX-MERCHANT-ID OF BK-PX-REC
    MOVE XP-MERCHANT-NAME TO PX-MERCHANT-NAME OF BK-PX-REC
    MOVE XP-MCC TO PX-MCC OF BK-PX-REC
    MOVE XP-AMOUNT TO PX-AMOUNT OF BK-PX-REC
    MOVE XP-CURRENCY TO PX-CURRENCY OF BK-PX-REC
    MOVE XP-FEE-AMT TO PX-FEE-AMT OF BK-PX-REC
    MOVE XP-BLOCK-AMT TO PX-BLOCK-AMT OF BK-PX-REC
    MOVE XP-CHANNEL TO PX-CHANNEL OF BK-PX-REC
    MOVE XP-DESCR TO PX-DESCR OF BK-PX-REC
    MOVE XP-REASON TO PX-REASON OF BK-PX-REC
    MOVE XP-OPERATOR TO PX-OPERATOR OF BK-PX-REC
    MOVE XP-CORR TO PX-CORR OF BK-PX-REC
    MOVE XP-REQUEST TO PX-REQUEST OF BK-PX-REC
    MOVE WS-BIZDATE TO PX-BIZDATE OF BK-PX-REC
    MOVE "ADD-DAYS" TO DAT-OP
    MOVE WS-BIZDATE TO DAT-DATE
    MOVE PC-EXPIRE-DAYS TO DAT-DAYS
    CALL "BDAT" USING BK-DAT-PARMS
    IF DAT-RC = "00"
        MOVE DAT-RESULT TO PX-EXPIRE-DATE OF BK-PX-REC
    ELSE
        MOVE WS-BIZDATE TO PX-EXPIRE-DATE OF BK-PX-REC
    END-IF
    MOVE "RECEIVED" TO PX-STATUS OF BK-PX-REC
    IF XP-DIRECTION = "OUT"
        MOVE "REQUESTED" TO PX-STATUS OF BK-PX-REC
    END-IF
    MOVE 0 TO PX-ACCEPT-DATE OF BK-PX-REC
    MOVE 0 TO PX-POST-DATE OF BK-PX-REC
    MOVE 0 TO PX-SETTLE-DATE OF BK-PX-REC
    MOVE 0 TO PX-RECON-DATE OF BK-PX-REC
    MOVE "NONE" TO PX-POST-STATUS OF BK-PX-REC
    MOVE "PENDING" TO PX-SETTLE-STATUS OF BK-PX-REC
    MOVE "PENDING" TO PX-RECON-STATUS OF BK-PX-REC
    MOVE "NONE" TO PX-DEV-STATUS OF BK-PX-REC
    MOVE "NONE" TO PX-MED-STATUS OF BK-PX-REC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO PX-CREATED OF BK-PX-REC
    MOVE WS-NOW(1:14) TO PX-UPDATED OF BK-PX-REC
    MOVE 1 TO PX-VERSION OF BK-PX-REC
    PERFORM DETECT-LOCAL-RECEIVER
    PERFORM COMPUTE-HASH.

WRITE-RECORD.
    MOVE "WRITE" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC = "22"
        MOVE "22" TO XP-RC
        MOVE "PIX DUPLICATE INTERNAL ID" TO XP-MSG
        GOBACK
    END-IF
    IF XS-RC NOT = "00"
        MOVE XS-RC TO XP-RC
        MOVE XS-MSG TO XP-MSG
        GOBACK
    END-IF
    MOVE "WRITE-E2E" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC = "22"
        MOVE "GET-E2E" TO XS-OP
        CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
        IF XS-RC = "00"
            MOVE PX-ID OF BK-PX-REC TO XP-PIX-ID
            MOVE "22" TO XP-RC
            MOVE "DUPLICATE END TO END ID" TO XP-MSG
            GOBACK
        END-IF
        MOVE "20" TO XP-RC
        MOVE "PIX E2E REGISTRATION FAILED" TO XP-MSG
        GOBACK
    END-IF
    IF XS-RC NOT = "00"
        MOVE XS-RC TO XP-RC
        MOVE XS-MSG TO XP-MSG
        GOBACK
    END-IF.

PERSIST-RECORD.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO PX-UPDATED OF BK-PX-REC
    ADD 1 TO PX-VERSION OF BK-PX-REC
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC NOT = "00"
        MOVE XS-RC TO XP-RC
        MOVE XS-MSG TO XP-MSG
        GOBACK
    END-IF
    PERFORM EMIT-STATE.

LOAD-PIX.
    PERFORM LOAD-PIX-BY-ID
    IF XP-RC = "00"
        MOVE "Y" TO WS-LOADED
    END-IF.

LOAD-PIX-BY-ID.
    MOVE SPACES TO BK-PX-REC
    MOVE XP-PIX-ID TO PX-ID OF BK-PX-REC
    MOVE "GET" TO XS-OP
    CALL "BPXSTO" USING BK-PX-STO-REQ BK-PX-REC
    IF XS-RC NOT = "00"
        MOVE XS-RC TO XP-RC
        MOVE XS-MSG TO XP-MSG
    END-IF.

APPLY-STATUS.
    MOVE PX-STATUS OF BK-PX-REC TO WS-CUR-STATUS
    IF XP-EVENT NOT = SPACES
        MOVE XP-EVENT TO WS-EVT
    ELSE
        PERFORM MAP-STATUS-TO-EVENT
    END-IF
    IF XP-RC NOT = "00"
        GOBACK
    END-IF
    CALL "BPXSTM" USING WS-CUR-STATUS WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC NOT = "00"
        MOVE WS-STM-RC TO XP-RC
        MOVE WS-STM-MSG TO XP-MSG
        GOBACK
    END-IF
    MOVE WS-NXT TO PX-STATUS OF BK-PX-REC
    MOVE WS-NXT TO XP-STATUS.

DETECT-LOCAL-RECEIVER.
    MOVE "N" TO WS-LOCAL-RECEIVER
    IF PX-DIRECTION OF BK-PX-REC = "OUT" AND
       PX-PAYEE-PART OF BK-PX-REC = PC-SELF AND
       PX-PAYEE-ACCT OF BK-PX-REC NOT = SPACES
        CALL "BACQRY" USING PX-PAYEE-ACCT OF BK-PX-REC
            WS-ACCT-OUT2
        IF A2-RC = "00" AND A2-STATUS = "AC"
            MOVE "Y" TO WS-LOCAL-RECEIVER
        END-IF
    END-IF.

CONSUME-LIMITS.
    MOVE SPACES TO BK-LIM-REQ
    MOVE "ACCOUNT" TO LIM-SCOPE
    IF PX-DIRECTION OF BK-PX-REC = "OUT"
        MOVE PX-PAYER-ACCT OF BK-PX-REC TO LIM-KEY
    ELSE
        MOVE PX-PAYEE-ACCT OF BK-PX-REC TO LIM-KEY
    END-IF
    MOVE "DAILY" TO LIM-PERIOD
    MOVE PX-AMOUNT OF BK-PX-REC TO LIM-AMOUNT
    MOVE PX-CURRENCY OF BK-PX-REC TO LIM-CURRENCY
    MOVE "CONSUME" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ
    IF LIM-RC NOT = "00"
        MOVE LIM-RC TO XP-RC
        MOVE LIM-MSG TO XP-MSG
        GOBACK
    END-IF
    MOVE SPACES TO BK-LIM-REQ
    MOVE "CHANNEL" TO LIM-SCOPE
    MOVE "PIX" TO LIM-KEY
    MOVE "DAILY" TO LIM-PERIOD
    MOVE PX-AMOUNT OF BK-PX-REC TO LIM-AMOUNT
    MOVE PX-CURRENCY OF BK-PX-REC TO LIM-CURRENCY
    MOVE "CONSUME" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ
    IF LIM-RC NOT = "00"
        MOVE SPACES TO BK-LIM-REQ
        MOVE "ACCOUNT" TO LIM-SCOPE
        IF PX-DIRECTION OF BK-PX-REC = "OUT"
            MOVE PX-PAYER-ACCT OF BK-PX-REC TO LIM-KEY
        ELSE
            MOVE PX-PAYEE-ACCT OF BK-PX-REC TO LIM-KEY
        END-IF
        MOVE "DAILY" TO LIM-PERIOD
        MOVE PX-AMOUNT OF BK-PX-REC TO LIM-AMOUNT
        MOVE PX-CURRENCY OF BK-PX-REC TO LIM-CURRENCY
        MOVE "RELEASE" TO LIM-OP
        CALL "BLIM" USING BK-LIM-REQ
        MOVE LIM-RC TO XP-RC
        MOVE LIM-MSG TO XP-MSG
    END-IF.

RELEASE-QR.
    IF PX-MODALITY OF BK-PX-REC(1:2) NOT = "QR" OR
       PX-QR-ID OF BK-PX-REC = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-QR-PARMS
    MOVE "QR-STATUS" TO XQ-OP
    MOVE PX-QR-ID OF BK-PX-REC TO XQ-QR-ID
    MOVE "PAID" TO XQ-STATUS
    MOVE PX-ID OF BK-PX-REC TO XQ-PIX-ID
    MOVE PX-OPERATOR OF BK-PX-REC TO XQ-OPERATOR
    CALL "BPXQR" USING BK-PX-QR-PARMS.

COMPUTE-HASH.
    MOVE PX-AMOUNT OF BK-PX-REC TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(PX-ID OF BK-PX-REC) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(PX-E2E-ID OF BK-PX-REC)
        DELIMITED SIZE "|" DELIMITED SIZE PX-DIRECTION OF BK-PX-REC
        DELIMITED SIZE "|" DELIMITED SIZE WS-AMT-ED DELIMITED SIZE
        "|" DELIMITED SIZE PX-STATUS OF BK-PX-REC DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 600 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO PX-HASH OF BK-PX-REC.

EXPOSE.
    MOVE PX-ID OF BK-PX-REC TO XP-PIX-ID
    MOVE PX-DIRECTION OF BK-PX-REC TO XP-DIRECTION
    MOVE PX-MODALITY OF BK-PX-REC TO XP-MODALITY
    MOVE PX-ENV OF BK-PX-REC TO XP-ENV
    MOVE PX-E2E-ID OF BK-PX-REC TO XP-E2E-ID
    MOVE PX-EXT-REF OF BK-PX-REC TO XP-EXT-REF
    MOVE PX-STATUS OF BK-PX-REC TO XP-STATUS
    MOVE PX-POST-STATUS OF BK-PX-REC TO XP-POST-STATUS
    MOVE PX-SETTLE-STATUS OF BK-PX-REC TO XP-SETTLE-STATUS
    MOVE PX-RECON-STATUS OF BK-PX-REC TO XP-RECON-STATUS
    MOVE PX-DEV-STATUS OF BK-PX-REC TO XP-DEV-STATUS
    MOVE PX-BLOCK-AMT OF BK-PX-REC TO XP-BLOCK-AMT
    MOVE PX-MED-STATUS OF BK-PX-REC TO XP-MED-STATUS
    MOVE PX-TXN-ID OF BK-PX-REC TO XP-TXN-ID
    MOVE PX-JRN-ID OF BK-PX-REC TO XP-JRN-ID
    MOVE PX-SETTLE-BATCH OF BK-PX-REC TO XP-SETTLE-BATCH
    MOVE PX-AMOUNT OF BK-PX-REC TO XP-AMOUNT
    MOVE PX-CURRENCY OF BK-PX-REC TO XP-CURRENCY
    MOVE PX-PAYER-PART OF BK-PX-REC TO XP-PAYER-PART
    MOVE PX-PAYEE-PART OF BK-PX-REC TO XP-PAYEE-PART
    MOVE PX-PAYER-ACCT OF BK-PX-REC TO XP-PAYER-ACCT
    MOVE PX-PAYER-CUST OF BK-PX-REC TO XP-PAYER-CUST
    MOVE PX-PAYEE-ACCT OF BK-PX-REC TO XP-PAYEE-ACCT
    MOVE PX-PAYEE-CUST OF BK-PX-REC TO XP-PAYEE-CUST
    MOVE PX-QR-ID OF BK-PX-REC TO XP-QR-ID
    MOVE PX-KEY-ID OF BK-PX-REC TO XP-KEY-ID
    MOVE PX-ORIG-PIX-ID OF BK-PX-REC TO XP-ORIG-PIX-ID
    MOVE PX-DEV-PIX-ID OF BK-PX-REC TO XP-DEV-PIX-ID
    MOVE PX-MED-CASE OF BK-PX-REC TO XP-MED-CASE
    MOVE PX-REASON OF BK-PX-REC TO XP-REASON
    MOVE PX-BIZDATE OF BK-PX-REC TO XP-DATE
    MOVE PX-VERSION OF BK-PX-REC TO XP-COUNT
    MOVE PX-HASH OF BK-PX-REC TO XP-HASH.

EMIT-STATE.
    EVALUATE PX-STATUS OF BK-PX-REC
        WHEN "REJECTED" MOVE "PIX.REJECTED.v1" TO WS-EVT-TYPE
        WHEN "CANCELLED" MOVE "PIX.CANCELLED.v1" TO WS-EVT-TYPE
        WHEN "EXPIRED" MOVE "PIX.EXPIRED.v1" TO WS-EVT-TYPE
        WHEN "TIMEOUT" MOVE "PIX.TIMEOUT.v1" TO WS-EVT-TYPE
        WHEN "FAILED" MOVE "PIX.FAILED.v1" TO WS-EVT-TYPE
        WHEN "RETURNED" MOVE "PIX.RETURNED.v1" TO WS-EVT-TYPE
        WHEN "DEVOLVED" MOVE "PIX.DEVOLVED.v1" TO WS-EVT-TYPE
        WHEN "SETTLED" MOVE "PIX.SETTLED.v1" TO WS-EVT-TYPE
        WHEN "RECONCILED" MOVE "PIX.RECONCILED.v1" TO WS-EVT-TYPE
        WHEN "POSTED" MOVE "PIX.POSTED.v1" TO WS-EVT-TYPE
        WHEN OTHER MOVE "PIX.STATUS.v1" TO WS-EVT-TYPE
    END-EVALUATE
    MOVE PX-OPERATOR TO BK-AUD-OPERATOR
    MOVE "PIX.STATUS" TO BK-AUD-ACTION
    MOVE PX-ID OF BK-PX-REC TO BK-AUD-ENTITY
    MOVE PX-CORR OF BK-PX-REC TO BK-AUD-CORR
    MOVE WS-CUR-STATUS TO BK-AUD-BEFORE
    MOVE PX-STATUS OF BK-PX-REC TO BK-AUD-AFTER
    MOVE XP-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE WS-EVT-TYPE TO BK-EVT-TYPE
    MOVE PX-ID OF BK-PX-REC TO BK-EVT-KEY
    MOVE PX-AMOUNT OF BK-PX-REC TO WS-AMT-ED
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(PX-ID OF BK-PX-REC) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(WS-CUR-STATUS) DELIMITED SIZE
        "|" DELIMITED SIZE
        FUNCTION TRIM(PX-STATUS OF BK-PX-REC) DELIMITED SIZE "|"
        DELIMITED SIZE WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PX-E2E-ID OF BK-PX-REC) DELIMITED SIZE
        INTO BK-EVT-PAYLOAD
    END-STRING
    CALL "BEVT" USING BK-EVT-PARMS.
