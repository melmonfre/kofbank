IDENTIFICATION DIVISION.
PROGRAM-ID. BPXQSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT QR-FILE ASSIGN TO WS-QR-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS QR-ID OF QR-REC
        FILE STATUS IS WS-QR-ST.
    SELECT TX-FILE ASSIGN TO WS-TX-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS QT-TXID OF TX-REC
        FILE STATUS IS WS-QT-ST.

DATA DIVISION.
FILE SECTION.
FD QR-FILE.
01 QR-REC.
   COPY "BPXQ".
FD TX-FILE.
01 TX-REC.
   05 QT-TXID          PIC X(32).
   05 QT-QR-ID         PIC X(12).

WORKING-STORAGE SECTION.
01 WS-QR-PATH PIC X(200).
01 WS-TX-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-QR-ST PIC X(02).
01 WS-QT-ST PIC X(02).

LINKAGE SECTION.
COPY "BPXQS".
01 BK-PX-QR-REC.
   COPY "BPXQ".

PROCEDURE DIVISION USING BK-PX-QR-STO-REQ BK-PX-QR-REC.
    MOVE "00" TO QS-RC
    MOVE SPACES TO QS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-QR-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxqr.idx"
        DELIMITED SIZE INTO WS-QR-PATH
    MOVE SPACES TO WS-TX-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxqrtx.idx"
        DELIMITED SIZE INTO WS-TX-PATH
    EVALUATE QS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN "GET-TXID" PERFORM DO-GET-TXID
        WHEN OTHER
            MOVE "99" TO QS-RC
            MOVE "UNKNOWN PIX QR STO OP" TO QS-MSG
    END-EVALUATE
    GOBACK.

DO-WRITE.
    PERFORM OPEN-QR
    IF QS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-QR-REC TO QR-REC
    WRITE QR-REC
        INVALID KEY
            MOVE "22" TO QS-RC
            MOVE "PIX QR ALREADY EXISTS" TO QS-MSG
    END-WRITE
    PERFORM CLOSE-QR
    IF QS-RC NOT = "00" OR QR-TXID OF BK-PX-QR-REC = SPACES
        EXIT PARAGRAPH
    END-IF
    PERFORM OPEN-TX
    MOVE QR-TXID OF BK-PX-QR-REC TO QT-TXID
    MOVE QR-ID OF BK-PX-QR-REC TO QT-QR-ID
    WRITE TX-REC
        INVALID KEY
            MOVE "22" TO QS-RC
            MOVE "PIX QR TXID ALREADY EXISTS" TO QS-MSG
    END-WRITE
    PERFORM CLOSE-TX.

DO-REWRITE.
    PERFORM OPEN-QR
    IF QS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-PX-QR-REC TO QR-REC
    REWRITE QR-REC
        INVALID KEY
            MOVE "23" TO QS-RC
            MOVE "PIX QR MISSING" TO QS-MSG
    END-REWRITE
    PERFORM CLOSE-QR.

DO-GET.
    PERFORM OPEN-QR
    IF QS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE QR-ID OF BK-PX-QR-REC TO QR-ID OF QR-REC
    READ QR-FILE
    EVALUATE WS-QR-ST
        WHEN "00" MOVE QR-REC TO BK-PX-QR-REC
        WHEN "23"
            MOVE "23" TO QS-RC
            MOVE "PIX QR NOT FOUND" TO QS-MSG
        WHEN OTHER
            MOVE WS-QR-ST TO QS-RC
            MOVE "PIX QR STORE ERROR" TO QS-MSG
    END-EVALUATE
    PERFORM CLOSE-QR.

DO-GET-TXID.
    PERFORM OPEN-TX
    IF QS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE QR-TXID OF BK-PX-QR-REC TO QT-TXID
    READ TX-FILE
    EVALUATE WS-QT-ST
        WHEN "00"
            MOVE QT-QR-ID TO QR-ID OF BK-PX-QR-REC
        WHEN "23"
            MOVE "23" TO QS-RC
            MOVE "PIX QR TXID NOT FOUND" TO QS-MSG
        WHEN OTHER
            MOVE WS-QT-ST TO QS-RC
            MOVE "PIX QR TXID STORE ERROR" TO QS-MSG
    END-EVALUATE
    PERFORM CLOSE-TX.

OPEN-QR.
    OPEN I-O QR-FILE
    IF WS-QR-ST = "35"
        OPEN OUTPUT QR-FILE
        CLOSE QR-FILE
        OPEN I-O QR-FILE
    END-IF
    IF WS-QR-ST NOT = "00"
        MOVE WS-QR-ST TO QS-RC
        MOVE "PIX QR STORE OPEN ERROR" TO QS-MSG
    END-IF.

CLOSE-QR.
    CLOSE QR-FILE.

OPEN-TX.
    OPEN I-O TX-FILE
    IF WS-QT-ST = "35"
        OPEN OUTPUT TX-FILE
        CLOSE TX-FILE
        OPEN I-O TX-FILE
    END-IF
    IF WS-QT-ST NOT = "00"
        MOVE WS-QT-ST TO QS-RC
        MOVE "PIX QR TXID STORE OPEN ERROR" TO QS-MSG
    END-IF.

CLOSE-TX.
    CLOSE TX-FILE.
