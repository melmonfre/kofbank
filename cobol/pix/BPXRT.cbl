IDENTIFICATION DIVISION.
PROGRAM-ID. BPXRT.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-NOW PIC X(14).
01 WS-PART.
   COPY "BPXP".
01 WS-ID-TYPE PIC X(08).
01 WS-ISPB PIC X(08).
01 WS-ID-VAL PIC X(32).
01 WS-ID-RC PIC X(02).
01 WS-ACCT-OUT.
   05 AO-ID PIC X(12).
   05 AO-CUST PIC X(12).
   05 AO-PRODUCT PIC X(04).
   05 AO-CURRENCY PIC X(03).
   05 AO-STATUS PIC X(02).
   05 AO-OPENED PIC 9(08).
   05 AO-CLOSED PIC 9(08).
   05 AO-VERSION PIC 9(05).
   05 AO-HASH PIC X(16).
   05 AO-RC PIC X(02).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-ACT PIC X(12).
01 WS-HASH PIC X(16).
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BPXSTS".

LINKAGE SECTION.
COPY "BPXRT".

PROCEDURE DIVISION USING BK-PX-RT-PARMS.
    MOVE "00" TO RT-RC
    MOVE SPACES TO RT-MSG
    MOVE SPACES TO WS-PART
    CALL "BCFG" USING WS-CFG
    EVALUATE FUNCTION TRIM(RT-OP)
        WHEN "PARTICIPANT-CREATE" PERFORM DO-CREATE
        WHEN "PARTICIPANT-GET" PERFORM DO-GET
        WHEN "PARTICIPANT-STATUS" PERFORM DO-STATUS
        WHEN "PARTICIPANT-CHECK" PERFORM DO-CHECK
        WHEN OTHER
            MOVE "99" TO RT-RC
            MOVE "UNKNOWN PARTICIPANT OP" TO RT-MSG
    END-EVALUATE
    GOBACK.

DO-CREATE.
    PERFORM VALIDATE-CREATE
    IF RT-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "PART" TO WS-ID-TYPE
    MOVE SPACES TO WS-ISPB
    CALL "BPXID" USING WS-ID-TYPE WS-ISPB WS-ID-VAL WS-ID-RC
    IF WS-ID-RC NOT = "00"
        MOVE "20" TO RT-RC
        MOVE "PARTICIPANT SEQUENCE ERROR" TO RT-MSG
        GOBACK
    END-IF
    MOVE WS-ID-VAL(1:12) TO PP-ID OF WS-PART
    MOVE RT-ISPB TO PP-ISPB OF WS-PART
    MOVE RT-NAME TO PP-NAME OF WS-PART
    MOVE RT-TYPE TO PP-TYPE OF WS-PART
    MOVE RT-ROLE TO PP-ROLE OF WS-PART
    MOVE RT-SELF-FLAG TO PP-SELF-FLAG OF WS-PART
    MOVE RT-SETTLE-ACCT TO PP-SETTLE-ACCT OF WS-PART
    MOVE "ACTIVE" TO PP-STATUS OF WS-PART
    MOVE WS-BIZDATE TO PP-BIZDATE OF WS-PART
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO PP-CREATED OF WS-PART
    MOVE WS-NOW(1:14) TO PP-UPDATED OF WS-PART
    MOVE 1 TO PP-VERSION OF WS-PART
    PERFORM COMPUTE-HASH
    MOVE "WRITE" TO PT-OP OF BK-PX-RT-STO-REQ
    CALL "BPXRTSTO" USING BK-PX-RT-STO-REQ WS-PART
    IF PT-RC NOT = "00"
        MOVE PT-RC TO RT-RC
        MOVE PT-MSG TO RT-MSG
        GOBACK
    END-IF
    MOVE PP-ID OF WS-PART TO RT-PART-ID
    MOVE "ACTIVE" TO RT-STATUS
    MOVE "PARTICIPANT CREATED" TO RT-MSG
    PERFORM EMIT.

DO-GET.
    MOVE "GET" TO PT-OP OF BK-PX-RT-STO-REQ
    MOVE RT-PART-ID TO PP-ID OF WS-PART
    CALL "BPXRTSTO" USING BK-PX-RT-STO-REQ WS-PART
    IF PT-RC NOT = "00"
        MOVE PT-RC TO RT-RC
        MOVE PT-MSG TO RT-MSG
        GOBACK
    END-IF
    PERFORM FILL-PART
    MOVE "PIX PARTICIPANT" TO RT-MSG.

DO-STATUS.
    MOVE "GET" TO PT-OP OF BK-PX-RT-STO-REQ
    MOVE RT-PART-ID TO PP-ID OF WS-PART
    CALL "BPXRTSTO" USING BK-PX-RT-STO-REQ WS-PART
    IF PT-RC NOT = "00"
        MOVE PT-RC TO RT-RC
        MOVE PT-MSG TO RT-MSG
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(RT-STATUS)
        WHEN "ACTIVE" CONTINUE
        WHEN "SUSPENDED" CONTINUE
        WHEN "CLOSED" CONTINUE
        WHEN OTHER
            MOVE "20" TO RT-RC
            MOVE "UNKNOWN PARTICIPANT STATUS" TO RT-MSG
            GOBACK
    END-EVALUATE
    IF PP-STATUS OF WS-PART = "CLOSED"
        MOVE "20" TO RT-RC
        MOVE "PARTICIPANT CLOSED" TO RT-MSG
        GOBACK
    END-IF
    MOVE RT-STATUS TO PP-STATUS OF WS-PART
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO PP-UPDATED OF WS-PART
    ADD 1 TO PP-VERSION OF WS-PART
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO PT-OP OF BK-PX-RT-STO-REQ
    CALL "BPXRTSTO" USING BK-PX-RT-STO-REQ WS-PART
    IF PT-RC NOT = "00"
        MOVE PT-RC TO RT-RC
        MOVE PT-MSG TO RT-MSG
        GOBACK
    END-IF
    PERFORM FILL-PART
    MOVE "PARTICIPANT STATUS UPDATED" TO RT-MSG
    PERFORM EMIT.

DO-CHECK.
    MOVE "GET" TO PT-OP OF BK-PX-RT-STO-REQ
    MOVE RT-PART-ID TO PP-ID OF WS-PART
    CALL "BPXRTSTO" USING BK-PX-RT-STO-REQ WS-PART
    IF PT-RC NOT = "00"
        MOVE "20" TO RT-RC
        MOVE "PARTICIPANT NOT FOUND" TO RT-MSG
        GOBACK
    END-IF
    IF PP-STATUS OF WS-PART NOT = "ACTIVE"
        MOVE "20" TO RT-RC
        MOVE "PARTICIPANT NOT ACTIVE" TO RT-MSG
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(RT-ROLE)
        WHEN "SEND"
            IF PP-TYPE OF WS-PART NOT = "DEBIT" AND
               PP-TYPE OF WS-PART NOT = "DEBITS"
                MOVE "20" TO RT-RC
                MOVE "PARTICIPANT CANNOT SEND PIX" TO RT-MSG
            END-IF
        WHEN "RECEIVE"
            IF PP-TYPE OF WS-PART NOT = "CREDIT" AND
               PP-TYPE OF WS-PART NOT = "DEBITS"
                MOVE "20" TO RT-RC
                MOVE "PARTICIPANT CANNOT RECEIVE PIX" TO RT-MSG
            END-IF
        WHEN OTHER
            CONTINUE
    END-EVALUATE
    IF RT-RC = "00"
        PERFORM FILL-PART
        MOVE "PARTICIPANT OK" TO RT-MSG
    END-IF.

VALIDATE-CREATE.
    IF RT-ISPB NOT = SPACES
        IF FUNCTION LENGTH(FUNCTION TRIM(RT-ISPB)) NOT = 8
            MOVE "20" TO RT-RC
            MOVE "ISPB MUST HAVE 8 DIGITS" TO RT-MSG
        END-IF
        PERFORM CHECK-ISPB
    END-IF
    IF RT-TYPE NOT = "DEBIT" AND RT-TYPE NOT = "CREDIT" AND
       RT-TYPE NOT = "DEBITS"
        MOVE "20" TO RT-RC
        MOVE "UNKNOWN PARTICIPANT TYPE" TO RT-MSG
    END-IF
    IF RT-ROLE NOT = "DPI" AND RT-ROLE NOT = "DPI-D" AND
       RT-ROLE NOT = "INDI" AND RT-ROLE NOT = "SUBA"
        MOVE "20" TO RT-RC
        MOVE "UNKNOWN PARTICIPANT ROLE" TO RT-MSG
    END-IF
    IF RT-SELF-FLAG NOT = "Y" AND RT-SELF-FLAG NOT = "N"
        MOVE "20" TO RT-RC
        MOVE "SELF FLAG MUST BE Y OR N" TO RT-MSG
    END-IF
    IF RT-SETTLE-ACCT NOT = SPACES
        CALL "BACQRY" USING RT-SETTLE-ACCT WS-ACCT-OUT
        IF AO-RC NOT = "00"
            MOVE "20" TO RT-RC
            MOVE "SETTLEMENT ACCOUNT NOT FOUND" TO RT-MSG
        END-IF
    END-IF.

CHECK-ISPB.
    MOVE "GET-ISPB" TO PT-OP OF BK-PX-RT-STO-REQ
    MOVE RT-ISPB TO PP-ISPB OF WS-PART
    CALL "BPXRTSTO" USING BK-PX-RT-STO-REQ WS-PART
    IF PT-RC = "00"
        MOVE "20" TO RT-RC
        MOVE "PARTICIPANT ISPB ALREADY EXISTS" TO RT-MSG
    END-IF
    MOVE "00" TO PT-RC
    MOVE SPACES TO PT-MSG.

FILL-PART.
    MOVE PP-ID OF WS-PART TO RT-PART-ID
    MOVE PP-ISPB OF WS-PART TO RT-ISPB
    MOVE PP-NAME OF WS-PART TO RT-NAME
    MOVE PP-TYPE OF WS-PART TO RT-TYPE
    MOVE PP-ROLE OF WS-PART TO RT-ROLE
    MOVE PP-SELF-FLAG OF WS-PART TO RT-SELF-FLAG
    MOVE PP-SETTLE-ACCT OF WS-PART TO RT-SETTLE-ACCT
    MOVE PP-STATUS OF WS-PART TO RT-STATUS.

COMPUTE-HASH.
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(PP-ID OF WS-PART) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(PP-ISPB OF WS-PART)
        DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PP-TYPE OF WS-PART) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(PP-ROLE OF WS-PART)
        DELIMITED SIZE "|" DELIMITED SIZE
        PP-STATUS OF WS-PART DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO PP-HASH OF WS-PART.

EMIT.
    MOVE RT-OPERATOR TO BK-AUD-OPERATOR
    MOVE RT-OP(1:12) TO BK-AUD-ACTION
    MOVE RT-PART-ID TO BK-AUD-ENTITY
    MOVE RT-CORR TO BK-AUD-CORR
    MOVE RT-STATUS TO BK-AUD-AFTER
    MOVE RT-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(RT-PART-ID) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(RT-STATUS) DELIMITED SIZE
        INTO BK-EVT-PAYLOAD
    MOVE "PIX.PARTICIPANT.CREATED.v1" TO BK-EVT-TYPE
    MOVE RT-PART-ID TO BK-EVT-KEY
    CALL "BEVT" USING BK-EVT-PARMS.
