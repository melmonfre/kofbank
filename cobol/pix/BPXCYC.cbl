IDENTIFICATION DIVISION.
PROGRAM-ID. BPXCYC.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PX-FILE ASSIGN TO WS-PX-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PX-ID OF PX-REC
        FILE STATUS IS WS-PX-ST.

DATA DIVISION.
FILE SECTION.
FD PX-FILE.
01 PX-REC.
   COPY "BPX".

WORKING-STORAGE SECTION.
   COPY "BPXCFG".
   COPY "BDATP".
   COPY "BPXSSO".
   COPY "BKIDMP".
   COPY "BKAUDP".
   COPY "BKEVTP".
   COPY "BPXSTO".
01 WS-CYCLE-REC.
   COPY "BPXCY".
01 WS-STL-REC.
   COPY "BPXSTLR".
01 WS-POS-REC.
   COPY "BPXPO".
01 WS-CYC-LOCK-NAME PIC X(30).
01 WS-STL-LOCK-NAME PIC X(30).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-PX-PATH PIC X(200).

01 WS-HOME PIC X(80).
01 WS-PX-ST PIC X(02).

01 WS-NOW PIC 9(14).
01 WS-LOCK-NAME PIC X(24).
01 WS-LOCK-OWNER PIC X(16).
01 WS-LOCK-MODE PIC X(01).
01 WS-LOCK-ST PIC X(02).
01 WS-OPNAME PIC X(12).
01 WS-EOF PIC X(01).
01 WS-MATCH PIC X(01).
01 WS-SKIP PIC X(01).
01 WS-CYCLE-NEW PIC X(01).
01 WS-OBL-NEW PIC X(01).
01 WS-ANY-OBL PIC X(01).
01 WS-SENDER PIC X(12).
01 WS-RECEIVER PIC X(12).
01 WS-STL-AMT PIC S9(15)V99 COMP-3.
01 WS-OBL-ID PIC X(12).
01 WS-OBL-TOTAL PIC 9(07).
01 WS-SETTLE-DATE PIC 9(08).
01 WS-CY-STATUS PIC X(16).
01 WS-ID-TYPE PIC X(08).
01 WS-ID-ISPB PIC X(08).
01 WS-ID-VAL PIC X(32).
01 WS-ID-RC PIC X(02).
01 WS-EVT PIC X(20).
01 WS-NXT PIC X(16).
01 WS-STM-RC PIC X(02).
01 WS-STM-MSG PIC X(80).
01 WS-AMT-ED PIC -9999999999999.99.
01 WS-AMT-ED2 PIC -9999999999999.99.
01 WS-FLAG PIC X(01).
01 WS-AFTER PIC X(120).

LINKAGE SECTION.
   COPY "BPXSLP".

PROCEDURE DIVISION USING BK-PX-STL-PARMS.
    MOVE "00" TO SL-RC
    MOVE SPACES TO SL-MSG
    MOVE "N" TO SL-REPLAY
    MOVE SL-OPERATOR TO WS-LOCK-OWNER
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE "20" TO SL-RC
        MOVE "BUSINESS DATE UNAVAILABLE" TO SL-MSG
        GOBACK
    END-IF
    CALL "BPXCFG" USING BK-PX-CFG
    IF PC-STATUS NOT = "00"
        MOVE "20" TO SL-RC
        MOVE "PIX CONFIG MISSING" TO SL-MSG
        GOBACK
    END-IF
    IF PC-STL-ACCT = SPACES
        MOVE "7000" TO PC-STL-ACCT
    END-IF
    EVALUATE FUNCTION TRIM(SL-OP)
        WHEN "CYCLE-OPEN" PERFORM DO-CYCLE-OPEN
        WHEN "ACCRUE" PERFORM DO-ACCRUE
        WHEN "CYCLE-CLOSE" PERFORM DO-CYCLE-CLOSE
        WHEN "CYCLE-CALCULATE" PERFORM DO-CYCLE-CALCULATE
        WHEN "CYCLE-GET" PERFORM DO-CYCLE-GET
        WHEN "CYCLE-LIST" PERFORM DO-CYCLE-LIST
        WHEN OTHER
            MOVE "99" TO SL-RC
            MOVE "UNKNOWN PIX CYCLE OP" TO SL-MSG
    END-EVALUATE
    GOBACK.

DO-CYCLE-OPEN.
    PERFORM NORMALIZE-HEAD
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CYCLE-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM FETCH-CYCLE
    IF SL-RC = "00"
        MOVE "Y" TO SL-REPLAY
        MOVE "CYCLE ALREADY OPEN" TO SL-MSG
        PERFORM CYCLE-UNLOCK
        PERFORM END-REQUEST
        GOBACK
    END-IF
    IF SL-RC NOT = "23"
        PERFORM CYCLE-UNLOCK
        PERFORM END-REQUEST
        GOBACK
    END-IF
    MOVE "00" TO SL-RC
    PERFORM BUILD-CYCLE
    MOVE "CYC-WRITE" TO SS-OP
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        WS-STL-REC WS-POS-REC
    IF SS-RC = "22"
        MOVE "00" TO SL-RC
        MOVE "Y" TO SL-REPLAY
        PERFORM FETCH-CYCLE
    ELSE
        IF SS-RC NOT = "00"
            MOVE SS-RC TO SL-RC
            MOVE SS-MSG TO SL-MSG
        ELSE
            MOVE "CYCLE OPENED" TO SL-MSG
            PERFORM EXPOSE-CYCLE
            PERFORM EMIT-CYCLE
        END-IF
    END-IF
    PERFORM CYCLE-UNLOCK
    PERFORM END-REQUEST.

NORMALIZE-HEAD.
    IF SL-BIZDATE IS NOT NUMERIC OR SL-BIZDATE = 0
        MOVE WS-BIZDATE TO SL-BIZDATE
    END-IF
    IF SL-CURRENCY = SPACES
        MOVE PC-CURRENCY TO SL-CURRENCY
    END-IF
    MOVE SPACES TO SL-CYCLE-ID
    STRING "CYC" DELIMITED SIZE SL-BIZDATE DELIMITED SIZE
        SL-CURRENCY DELIMITED SIZE PC-E2E-ISPB DELIMITED SIZE
        INTO SL-CYCLE-ID
    END-STRING.

BUILD-CYCLE.
    MOVE SPACES TO WS-CYCLE-REC
    MOVE SL-CYCLE-ID TO CY-CYCLE-ID
    MOVE SL-BIZDATE TO CY-BIZDATE
    PERFORM SETTLE-DATE-FOR
    MOVE "OPEN" TO CY-STATUS
    MOVE SL-CURRENCY TO CY-CURRENCY
    MOVE 0 TO CY-TXN-COUNT CY-PAY-COUNT CY-RCV-COUNT
        CY-PARTY-COUNT CY-OBL-PAY CY-OBL-RCV
    MOVE 0 TO CY-GROSS-PAY CY-GROSS-RCV CY-ADJ-AMT CY-NET-AMT
    MOVE SPACES TO CY-NET-SIDE CY-SETTLE-ID CY-EXTERNAL-REF
        CY-JRN-ID CY-RUN-ID
    MOVE "NONE" TO CY-POST-STATUS
    MOVE "PENDING" TO CY-RECON-STATUS
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW TO CY-OPENED
    MOVE 0 TO CY-CLOSED CY-SETTLED CY-RECONCILED
    MOVE 1 TO CY-VERSION
    MOVE WS-NOW TO CY-CREATED CY-UPDATED
    MOVE SL-OPERATOR TO CY-OPERATOR
    MOVE SL-CORR TO CY-CORR
    MOVE SL-REQUEST TO CY-REQUEST.

SETTLE-DATE-FOR.
    MOVE 0 TO DAT-DAYS
    MOVE PC-STL-LAG TO DAT-DAYS
    MOVE "ADD-DAYS" TO DAT-OP
    MOVE SL-BIZDATE TO DAT-DATE
    CALL "BDAT" USING BK-DAT-PARMS
    IF DAT-RC = "00"
        MOVE DAT-RESULT TO CY-SETTLE-DATE
        MOVE DAT-RESULT TO SL-SETTLE-DATE
    ELSE
        MOVE SL-BIZDATE TO CY-SETTLE-DATE
        MOVE SL-BIZDATE TO SL-SETTLE-DATE
    END-IF.

FETCH-CYCLE.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "CYC-GET" TO SS-OP
    MOVE SL-CYCLE-ID TO SS-CYCLE-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        WS-STL-REC WS-POS-REC
    MOVE SS-RC TO SL-RC
    MOVE SPACES TO SL-MSG
    IF SS-RC = "00"
        PERFORM EXPOSE-CYCLE
    END-IF.

STORE-CYCLE.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW TO CY-UPDATED
    ADD 1 TO CY-VERSION
    MOVE SL-CORR TO CY-CORR
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "CYC-UPDATE" TO SS-OP
    MOVE CY-CYCLE-ID TO SS-CYCLE-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        WS-STL-REC WS-POS-REC
    IF SS-RC NOT = "00"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
    END-IF.

EXPOSE-CYCLE.
    MOVE CY-CYCLE-ID TO SL-CYCLE-ID
    MOVE CY-BIZDATE TO SL-BIZDATE
    MOVE CY-SETTLE-DATE TO SL-SETTLE-DATE
    MOVE CY-STATUS TO SL-CYCLE-STATUS
    MOVE CY-CURRENCY TO SL-CURRENCY
    MOVE CY-TXN-COUNT TO SL-TXN-COUNT
    MOVE CY-PAY-COUNT TO SL-PAY-COUNT
    MOVE CY-RCV-COUNT TO SL-RCV-COUNT
    MOVE CY-PARTY-COUNT TO SL-PARTY-COUNT
    MOVE CY-GROSS-PAY TO SL-GROSS-AMT
    MOVE CY-GROSS-RCV TO SL-GROSS-RCV
    MOVE CY-NET-AMT TO SL-NET-AMT
    MOVE CY-NET-SIDE TO SL-SIDE
    MOVE CY-SETTLE-ID TO SL-STL-ID
    MOVE CY-EXTERNAL-REF TO SL-EXTERNAL-REF
    MOVE CY-POST-STATUS TO SL-POST-STATUS
    MOVE CY-RECON-STATUS TO SL-RECON-STATUS
    MOVE CY-JRN-ID TO SL-JRN-ID
    MOVE CY-RUN-ID TO SL-RUN-ID
    ADD CY-OBL-PAY TO CY-OBL-RCV GIVING WS-OBL-TOTAL
    MOVE WS-OBL-TOTAL TO SL-ITEM-COUNT.

DO-ACCRUE.
    PERFORM NORMALIZE-HEAD
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CYCLE-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM FETCH-CYCLE
    IF SL-RC = "23"
        MOVE "00" TO SL-RC
        PERFORM BUILD-CYCLE
        MOVE "CYC-WRITE" TO SS-OP
        CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
            WS-STL-REC WS-POS-REC
        IF SS-RC NOT = "00" AND SS-RC NOT = "22"
            MOVE SS-RC TO SL-RC
            MOVE SS-MSG TO SL-MSG
        END-IF
        MOVE "00" TO SL-RC
        PERFORM FETCH-CYCLE
    END-IF
    IF SL-RC = "00"
        IF SL-CYCLE-STATUS NOT = "OPEN" AND
           SL-CYCLE-STATUS NOT = "ACCUMULATING"
            MOVE "20" TO SL-RC
            MOVE "CYCLE NOT ACCUMULATING" TO SL-MSG
        END-IF
    END-IF
    IF SL-RC = "00"
        MOVE "N" TO WS-CYCLE-NEW
        PERFORM SCAN-AND-ACCUMULATE
        IF SL-RC = "00" AND WS-CYCLE-NEW = "Y"
            MOVE CY-STATUS TO WS-CY-STATUS
            MOVE "ACCRUE" TO WS-EVT
            CALL "BPXCYM" USING WS-CY-STATUS WS-EVT WS-NXT
                WS-STM-RC WS-STM-MSG
            IF WS-STM-RC = "00"
                MOVE WS-NXT TO CY-STATUS
            END-IF
            PERFORM STORE-CYCLE
        END-IF
        IF SL-RC = "00"
            MOVE CY-STATUS TO SL-CYCLE-STATUS
            MOVE "PIX SETTLEMENT ACCUMULATED" TO SL-MSG
            PERFORM EXPOSE-CYCLE
            PERFORM EMIT-CYCLE
        END-IF
    END-IF
    PERFORM CYCLE-UNLOCK
    PERFORM END-REQUEST.

SCAN-AND-ACCUMULATE.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-PX-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxpix.idx"
        DELIMITED SIZE INTO WS-PX-PATH
    OPEN I-O PX-FILE
    IF WS-PX-ST = "35"
        MOVE "00" TO SL-RC
        CLOSE PX-FILE
        EXIT PARAGRAPH
    END-IF
    IF WS-PX-ST NOT = "00"
        MOVE "20" TO SL-RC
        MOVE "PIX STORE UNAVAILABLE FOR ACCRUAL" TO SL-MSG
        CLOSE PX-FILE
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PX-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM EVALUATE-PX
        END-READ
    END-PERFORM
    CLOSE PX-FILE.

EVALUATE-PX.
    MOVE "N" TO WS-MATCH
    IF PX-ENV OF PX-REC NOT = "PROD"
        EXIT PARAGRAPH
    END-IF
    IF PX-POST-STATUS OF PX-REC NOT = "POSTED"
        EXIT PARAGRAPH
    END-IF
    IF PX-SETTLE-STATUS OF PX-REC NOT = "PENDING"
        EXIT PARAGRAPH
    END-IF
    IF PX-STATUS OF PX-REC = "DEVOLVED"
        PERFORM MARK-LOCAL
        EXIT PARAGRAPH
    END-IF
    PERFORM NET-OF-DEVOLUTION
    IF WS-STL-AMT <= 0
        PERFORM MARK-LOCAL
        EXIT PARAGRAPH
    END-IF
    IF PX-CURRENCY OF PX-REC NOT = CY-CURRENCY
        EXIT PARAGRAPH
    END-IF
    PERFORM ELIGIBLE-DATE
    IF WS-SKIP = "Y"
        EXIT PARAGRAPH
    END-IF
    EVALUATE PX-DIRECTION OF PX-REC
        WHEN "OUT"
            MOVE PX-PAYEE-PART OF PX-REC TO WS-RECEIVER
            IF WS-RECEIVER = PC-SELF OR WS-RECEIVER = SPACES
                PERFORM MARK-LOCAL
                EXIT PARAGRAPH
            END-IF
            MOVE "PAYABLE" TO SL-SIDE
            MOVE WS-RECEIVER TO SL-PARTICIPANT
            MOVE "Y" TO WS-MATCH
        WHEN "IN"
            MOVE PX-PAYER-PART OF PX-REC TO WS-SENDER
            IF WS-SENDER = PC-SELF OR WS-SENDER = SPACES
                PERFORM MARK-LOCAL
                EXIT PARAGRAPH
            END-IF
            MOVE "RECEIVABLE" TO SL-SIDE
            MOVE WS-SENDER TO SL-PARTICIPANT
            MOVE "Y" TO WS-MATCH
        WHEN OTHER
            CONTINUE
    END-EVALUATE
    IF WS-MATCH NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    PERFORM TOUCH-OBLIGATION
    IF SL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF SL-SIDE = "PAYABLE"
        ADD 1 TO CY-PAY-COUNT
        ADD WS-STL-AMT TO CY-GROSS-PAY
    ELSE
        ADD 1 TO CY-RCV-COUNT
        ADD WS-STL-AMT TO CY-GROSS-RCV
    END-IF
    ADD 1 TO CY-TXN-COUNT
    MOVE "Y" TO WS-CYCLE-NEW
    PERFORM MARK-ACCUMULATED.

ELIGIBLE-DATE.
    MOVE "N" TO WS-SKIP
    IF PX-POST-DATE OF PX-REC = 0
        MOVE "Y" TO WS-SKIP
        EXIT PARAGRAPH
    END-IF
    MOVE 0 TO DAT-DAYS
    MOVE PC-STL-LAG TO DAT-DAYS
    MOVE "ADD-DAYS" TO DAT-OP
    MOVE PX-POST-DATE OF PX-REC TO DAT-DATE
    CALL "BDAT" USING BK-DAT-PARMS
    IF DAT-RC = "00"
        MOVE DAT-RESULT TO WS-SETTLE-DATE
    ELSE
        MOVE PX-POST-DATE OF PX-REC TO WS-SETTLE-DATE
    END-IF
    IF WS-SETTLE-DATE NOT = CY-SETTLE-DATE
        MOVE "Y" TO WS-SKIP
    END-IF.

TOUCH-OBLIGATION.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "OBL-GET" TO SS-OP
    MOVE CY-CYCLE-ID TO SS-XREF-CYCLE
    MOVE SL-PARTICIPANT TO SS-XREF-PART
    MOVE SL-SIDE TO SS-XREF-SIDE
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        WS-STL-REC WS-POS-REC
    MOVE SS-STL-ID TO WS-OBL-ID
    MOVE "N" TO WS-OBL-NEW
    IF SS-RC = "23"
        MOVE "Y" TO WS-OBL-NEW
        MOVE "00" TO SL-RC
        PERFORM OBLIGATION-ID
        IF SL-RC NOT = "00"
            EXIT PARAGRAPH
        END-IF
        PERFORM NEW-OBLIGATION
        IF SL-RC NOT = "00"
            EXIT PARAGRAPH
        END-IF
    ELSE
        IF SS-RC NOT = "00"
            MOVE SS-RC TO SL-RC
            MOVE SS-MSG TO SL-MSG
            EXIT PARAGRAPH
        END-IF
        PERFORM LOAD-OBLIGATION
        IF SL-RC NOT = "00"
            EXIT PARAGRAPH
        END-IF
    END-IF
    PERFORM ADD-TO-OBLIGATION.

NEW-OBLIGATION.
    MOVE SPACES TO WS-STL-REC
    MOVE SL-STL-ID TO SR-STL-ID
    MOVE CY-CYCLE-ID TO SR-CYCLE-ID
    MOVE SL-PARTICIPANT TO SR-PARTICIPANT
    MOVE SL-SIDE TO SR-SIDE
    MOVE CY-CURRENCY TO SR-CURRENCY
    MOVE CY-BIZDATE TO SR-BIZDATE
    MOVE CY-SETTLE-DATE TO SR-SETTLE-DATE
    MOVE "PENDING" TO SR-STATUS
    MOVE "NONE" TO SR-POST-STATUS
    MOVE "PENDING" TO SR-RECON-STATUS
    MOVE 0 TO SR-GROSS-AMT SR-ADJ-AMT SR-FEE-AMT SR-NET-AMT
    MOVE 0 TO SR-ITEM-COUNT SR-ATTEMPTS SR-SETTLED-AMT
    MOVE 1 TO SR-VERSION
    MOVE SL-OPERATOR TO SR-OPERATOR
    MOVE SL-CORR TO SR-CORR
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW TO SR-CREATED SR-UPDATED
    MOVE WS-NOW TO SR-UPDATED
    MOVE SPACES TO SR-EXTERNAL-REF SR-RESULT-REF SR-JRN-ID
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "STL-WRITE" TO SS-OP
    MOVE SL-STL-ID TO SS-STL-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        WS-STL-REC WS-POS-REC
    IF SS-RC NOT = "00" AND SS-RC NOT = "22"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "OBL-WRITE" TO SS-OP
    MOVE CY-CYCLE-ID TO SS-XREF-CYCLE
    MOVE SL-PARTICIPANT TO SS-XREF-PART
    MOVE SL-SIDE TO SS-XREF-SIDE
    MOVE SL-STL-ID TO SS-STL-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        WS-STL-REC WS-POS-REC
    IF SS-RC NOT = "00" AND SS-RC NOT = "22"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
    END-IF.

LOAD-OBLIGATION.
    MOVE WS-OBL-ID TO SL-STL-ID
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "STL-GET" TO SS-OP
    MOVE WS-OBL-ID TO SS-STL-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        WS-STL-REC WS-POS-REC
    IF SS-RC NOT = "00"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
    END-IF.

ADD-TO-OBLIGATION.
    IF SR-STATUS OF WS-STL-REC NOT = "PENDING"
        MOVE "20" TO SL-RC
        MOVE "OBLIGATION NOT ACCUMULATING" TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    ADD WS-STL-AMT TO SR-GROSS-AMT OF WS-STL-REC
    ADD PX-FEE-AMT OF PX-REC TO SR-FEE-AMT OF WS-STL-REC
    ADD 1 TO SR-ITEM-COUNT OF WS-STL-REC
    MOVE SR-GROSS-AMT OF WS-STL-REC TO SR-NET-AMT OF WS-STL-REC
    SUBTRACT SR-ADJ-AMT OF WS-STL-REC
        FROM SR-NET-AMT OF WS-STL-REC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW TO SR-UPDATED OF WS-STL-REC
    ADD 1 TO SR-VERSION OF WS-STL-REC
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "STL-UPDATE" TO SS-OP
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        WS-STL-REC WS-POS-REC
    IF SS-RC NOT = "00"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
    END-IF.

OBLIGATION-ID.
    MOVE SPACES TO SL-STL-ID
    MOVE "STL" TO WS-ID-TYPE
    MOVE PC-E2E-ISPB TO WS-ID-ISPB
    CALL "BPXID" USING WS-ID-TYPE WS-ID-ISPB WS-ID-VAL WS-ID-RC
    MOVE WS-ID-VAL(1:12) TO SL-STL-ID
    MOVE WS-ID-RC TO SL-RC
    IF SL-RC NOT = "00"
        MOVE "SETTLEMENT ID ERROR" TO SL-MSG
    END-IF.

NET-OF-DEVOLUTION.
    MOVE PX-AMOUNT OF PX-REC TO WS-STL-AMT
    IF PX-BLOCK-AMT OF PX-REC > 0
        SUBTRACT PX-BLOCK-AMT OF PX-REC FROM WS-STL-AMT
    END-IF.

MARK-ACCUMULATED.
    MOVE "ACCUMULATED" TO PX-SETTLE-STATUS OF PX-REC
    MOVE CY-CYCLE-ID(1:12) TO PX-SETTLE-BATCH OF PX-REC
    MOVE CY-SETTLE-DATE TO PX-SETTLE-DATE OF PX-REC
    PERFORM WRITE-PX-RECORD.

MARK-LOCAL.
    MOVE "NOT-APPLICABLE" TO PX-SETTLE-STATUS OF PX-REC
    PERFORM WRITE-PX-RECORD.

WRITE-PX-RECORD.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW TO PX-UPDATED OF PX-REC
    ADD 1 TO PX-VERSION OF PX-REC
    MOVE SL-OPERATOR TO PX-OPERATOR OF PX-REC
    MOVE SPACES TO BK-PX-STO-REQ
    MOVE "REWRITE" TO XS-OP
    MOVE PX-ID OF PX-REC TO XS-PIX-ID
    CALL "BPXSTO" USING BK-PX-STO-REQ PX-REC
    IF XS-RC NOT = "00"
        MOVE XS-RC TO SL-RC
        MOVE XS-MSG TO SL-MSG
    END-IF.

DO-CYCLE-CLOSE.
    IF SL-CYCLE-ID = SPACES
        PERFORM NORMALIZE-HEAD
    END-IF
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CYCLE-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM FETCH-CYCLE
    IF SL-RC = "00"
        IF SL-CYCLE-STATUS = "CLOSED" OR
           SL-CYCLE-STATUS = "CALCULATED" OR
           SL-CYCLE-STATUS = "SUBMITTED" OR
           SL-CYCLE-STATUS = "SETTLED" OR
           SL-CYCLE-STATUS = "RECONCILED"
            MOVE "Y" TO SL-REPLAY
            MOVE "CYCLE ALREADY CLOSED" TO SL-MSG
            PERFORM CYCLE-UNLOCK
            PERFORM END-REQUEST
            GOBACK
        END-IF
        MOVE SL-CYCLE-STATUS TO WS-CY-STATUS
        MOVE "CLOSE" TO WS-EVT
        CALL "BPXCYM" USING WS-CY-STATUS WS-EVT WS-NXT WS-STM-RC
            WS-STM-MSG
        IF WS-STM-RC NOT = "00"
            MOVE WS-STM-RC TO SL-RC
            MOVE WS-STM-MSG TO SL-MSG
        ELSE
            MOVE WS-NXT TO CY-STATUS
            MOVE FUNCTION CURRENT-DATE TO WS-NOW
            MOVE WS-NOW TO CY-CLOSED
            IF SL-RUN-ID NOT = SPACES
                MOVE SL-RUN-ID TO CY-RUN-ID
            END-IF
            PERFORM STORE-CYCLE
            IF SL-RC = "00"
                MOVE "CYCLE CLOSED" TO SL-MSG
                PERFORM EXPOSE-CYCLE
                PERFORM EMIT-CYCLE
            END-IF
        END-IF
    END-IF
    PERFORM CYCLE-UNLOCK
    PERFORM END-REQUEST.

DO-CYCLE-CALCULATE.
    IF SL-CYCLE-ID = SPACES
        PERFORM NORMALIZE-HEAD
    END-IF
    PERFORM BEGIN-REQUEST
    IF SL-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CYCLE-LOCK
    IF SL-RC NOT = "00"
        PERFORM END-REQUEST
        GOBACK
    END-IF
    PERFORM FETCH-CYCLE
    IF SL-RC = "00"
        IF SL-CYCLE-STATUS = "CALCULATED"
            MOVE "Y" TO SL-REPLAY
            MOVE "CYCLE ALREADY CALCULATED" TO SL-MSG
            PERFORM CYCLE-UNLOCK
            PERFORM END-REQUEST
            GOBACK
        END-IF
        MOVE SL-CYCLE-STATUS TO WS-CY-STATUS
        MOVE "CALCULATE" TO WS-EVT
        CALL "BPXCYM" USING WS-CY-STATUS WS-EVT WS-NXT WS-STM-RC
            WS-STM-MSG
        IF WS-STM-RC NOT = "00"
            MOVE WS-STM-RC TO SL-RC
            MOVE WS-STM-MSG TO SL-MSG
        ELSE
            PERFORM SUM-OBLIGATIONS
            IF SL-RC NOT = "00"
                MOVE "CALC-FAILED" TO CY-STATUS
                PERFORM STORE-CYCLE
                MOVE "20" TO SL-RC
                MOVE "CYCLE CALCULATION FAILED" TO SL-MSG
            ELSE
                MOVE WS-NXT TO CY-STATUS
                PERFORM STORE-CYCLE
                IF SL-RC = "00"
                    MOVE "CYCLE CALCULATED" TO SL-MSG
                    PERFORM EMIT-CYCLE
                END-IF
            END-IF
        END-IF
        IF SL-RC = "00"
            PERFORM EXPOSE-CYCLE
        END-IF
    END-IF
    PERFORM CYCLE-UNLOCK
    PERFORM END-REQUEST.

SUM-OBLIGATIONS.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "STL-SUM" TO SS-OP
    MOVE CY-CYCLE-ID TO SS-CYCLE-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        WS-STL-REC WS-POS-REC
    IF SS-RC = "23"
        MOVE 0 TO SS-GROSS-PAY SS-GROSS-RCV SS-ADJ-AMT
        MOVE 0 TO SS-PARTY-COUNT SS-OBL-PAY SS-OBL-RCV
        MOVE "00" TO SS-RC
    END-IF
    IF SS-RC NOT = "00"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SS-GROSS-PAY TO CY-GROSS-PAY
    MOVE SS-GROSS-RCV TO CY-GROSS-RCV
    MOVE SS-ADJ-AMT TO CY-ADJ-AMT
    MOVE SS-PARTY-COUNT TO CY-PARTY-COUNT
    MOVE SS-OBL-PAY TO CY-OBL-PAY
    MOVE SS-OBL-RCV TO CY-OBL-RCV
    PERFORM NET-CYCLE.

NET-CYCLE.
    COMPUTE CY-NET-AMT = CY-GROSS-RCV - CY-GROSS-PAY
    EVALUATE TRUE
        WHEN CY-NET-AMT > 0
            MOVE "RECEIVABLE" TO CY-NET-SIDE
        WHEN CY-NET-AMT < 0
            MOVE "PAYABLE" TO CY-NET-SIDE
            MULTIPLY -1 BY CY-NET-AMT
        WHEN OTHER
            MOVE "ZERO" TO CY-NET-SIDE
            MOVE 0 TO CY-NET-AMT
    END-EVALUATE.

DO-CYCLE-GET.
    IF SL-CYCLE-ID = SPACES
        PERFORM NORMALIZE-HEAD
    END-IF
    PERFORM FETCH-CYCLE
    IF SL-RC = "00"
        MOVE "PIX SETTLEMENT CYCLE" TO SL-MSG
    END-IF.

DO-CYCLE-LIST.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "CYC-LIST" TO SS-OP
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ WS-CYCLE-REC
        WS-STL-REC WS-POS-REC
    IF SS-RC NOT = "00"
        MOVE SS-RC TO SL-RC
        MOVE SS-MSG TO SL-MSG
        DISPLAY "rc=" SL-RC
        DISPLAY "msg=" FUNCTION TRIM(SL-MSG)
    END-IF.

CYCLE-LOCK.
    MOVE SPACES TO WS-LOCK-NAME
    IF SL-BIZDATE NOT = 0
        STRING "CYC-" DELIMITED SIZE SL-BIZDATE DELIMITED SIZE
            SL-CURRENCY DELIMITED SIZE INTO WS-LOCK-NAME
            END-STRING
    ELSE
        STRING "CYC-" DELIMITED SIZE FUNCTION TRIM(SL-CYCLE-ID)
            DELIMITED SIZE INTO WS-LOCK-NAME
        END-STRING
    END-IF
    MOVE WS-LOCK-NAME TO WS-CYC-LOCK-NAME
    MOVE "A" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST
    IF WS-LOCK-ST NOT = "00"
        MOVE "24" TO SL-RC
        MOVE "SETTLEMENT CYCLE LOCKED" TO SL-MSG
    END-IF.

CYCLE-UNLOCK.
    MOVE WS-CYC-LOCK-NAME TO WS-LOCK-NAME
    MOVE "R" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST.

BEGIN-REQUEST.
    MOVE "00" TO SL-RC
    IF SL-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE FUNCTION TRIM(SL-OP) TO WS-OPNAME
    MOVE SL-REQUEST TO BK-IDM-TXN-ID
    MOVE WS-OPNAME TO BK-IDM-OPERATION
    MOVE SPACES TO BK-IDM-RESULT
    MOVE "B" TO BK-IDM-MODE
    CALL "BIDM" USING BK-IDM-PARMS
    EVALUATE BK-IDM-STATUS
        WHEN "00" CONTINUE
        WHEN "22"
            MOVE "G" TO BK-IDM-MODE
            CALL "BIDM" USING BK-IDM-PARMS
            IF BK-IDM-STATUS = "C"
                MOVE "Y" TO SL-REPLAY
                MOVE "22" TO SL-RC
                MOVE "CYCLE REQUEST ALREADY PROCESSED"
                    TO SL-MSG
            ELSE
                MOVE "24" TO SL-RC
                MOVE "CYCLE REQUEST IN PROGRESS" TO SL-MSG
            END-IF
        WHEN OTHER
            MOVE BK-IDM-STATUS TO SL-RC
            MOVE "CYCLE IDEMPOTENCY STORE ERROR" TO SL-MSG
    END-EVALUATE.

END-REQUEST.
    IF SL-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE FUNCTION TRIM(SL-OP) TO WS-OPNAME
    MOVE SL-REQUEST TO BK-IDM-TXN-ID
    MOVE WS-OPNAME TO BK-IDM-OPERATION
    IF SL-RC = "00" OR SL-RC = "22"
        MOVE "C" TO BK-IDM-MODE
        MOVE SL-CYCLE-ID TO BK-IDM-RESULT
    ELSE
        MOVE "F" TO BK-IDM-MODE
        MOVE SPACES TO BK-IDM-RESULT
    END-IF
    CALL "BIDM" USING BK-IDM-PARMS.

EMIT-CYCLE.
    MOVE SL-OPERATOR TO BK-AUD-OPERATOR
    MOVE "PIX.CYCLE" TO BK-AUD-ACTION
    MOVE SL-CYCLE-ID TO BK-AUD-ENTITY
    MOVE SL-CORR TO BK-AUD-CORR
    MOVE CY-GROSS-PAY TO WS-AMT-ED
    MOVE CY-GROSS-RCV TO WS-AMT-ED2
    MOVE SPACES TO WS-AFTER
    STRING FUNCTION TRIM(SL-CYCLE-STATUS) DELIMITED SIZE "|"
        DELIMITED SIZE WS-AMT-ED DELIMITED SIZE "|"
        DELIMITED SIZE WS-AMT-ED2 DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(SL-CURRENCY)
        DELIMITED SIZE INTO WS-AFTER
    END-STRING
    MOVE SPACES TO BK-AUD-BEFORE
    STRING FUNCTION TRIM(CY-NET-SIDE) DELIMITED SIZE "|"
        DELIMITED SIZE SL-TXN-COUNT DELIMITED SIZE
        INTO BK-AUD-BEFORE
    END-STRING
    MOVE WS-AFTER TO BK-AUD-AFTER
    MOVE SL-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE "PIX.CYCLE.v1" TO BK-EVT-TYPE
    MOVE SL-CYCLE-ID TO BK-EVT-KEY
    MOVE CY-NET-AMT TO WS-AMT-ED
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(SL-CYCLE-STATUS) DELIMITED SIZE "|"
        DELIMITED SIZE WS-AMT-ED DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(CY-NET-SIDE)
        DELIMITED SIZE INTO BK-EVT-PAYLOAD
    END-STRING
    MOVE SL-RC TO BK-EVT-STATUS
    CALL "BEVT" USING BK-EVT-PARMS.
