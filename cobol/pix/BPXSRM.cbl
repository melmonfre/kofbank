IDENTIFICATION DIVISION.
PROGRAM-ID. BPXSRM.

DATA DIVISION.
WORKING-STORAGE SECTION.

LINKAGE SECTION.
01 LS-CUR PIC X(16).
01 LS-EVT PIC X(20).
01 LS-NXT PIC X(16).
01 LS-RC PIC X(02).
01 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-CUR LS-EVT LS-NXT LS-RC LS-MSG.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG LS-NXT
    EVALUATE TRUE
        WHEN LS-EVT = "SUBMIT"
            IF LS-CUR = "PENDING" OR LS-CUR = "SUBMIT-FAILED"
                MOVE "SUBMITTED" TO LS-NXT
            ELSE PERFORM SR-INVALID
        WHEN LS-EVT = "SUBMIT-FAIL"
            IF LS-CUR = "PENDING"
                MOVE "SUBMIT-FAILED" TO LS-NXT
            ELSE PERFORM SR-INVALID
        WHEN LS-EVT = "SETTLE"
            IF LS-CUR = "SUBMITTED" OR LS-CUR = "UNKNOWN"
                MOVE "SETTLED" TO LS-NXT
            ELSE PERFORM SR-INVALID
        WHEN LS-EVT = "REJECT"
            IF LS-CUR = "SUBMITTED" OR LS-CUR = "UNKNOWN"
                MOVE "REJECTED" TO LS-NXT
            ELSE PERFORM SR-INVALID
        WHEN LS-EVT = "UNKNOWN"
            IF LS-CUR = "SUBMITTED"
                MOVE "UNKNOWN" TO LS-NXT
            ELSE PERFORM SR-INVALID
        WHEN LS-EVT = "RECONCILE"
            IF LS-CUR = "SETTLED" OR LS-CUR = "RECONCILED" OR
               LS-CUR = "EXCEPTION"
                MOVE "RECONCILED" TO LS-NXT
            ELSE PERFORM SR-INVALID
        WHEN LS-EVT = "EXCEPTION"
            IF LS-CUR = "SETTLED" OR LS-CUR = "RECONCILED" OR
               LS-CUR = "PENDING" OR LS-CUR = "UNKNOWN" OR
               LS-CUR = "SUBMITTED"
                MOVE "EXCEPTION" TO LS-NXT
            ELSE PERFORM SR-INVALID
        WHEN LS-EVT = "ADJUST"
            IF LS-CUR = "PENDING" OR LS-CUR = "CALCULATING"
                MOVE "PENDING" TO LS-NXT
            ELSE PERFORM SR-INVALID
        WHEN LS-EVT = "CANCEL"
            IF LS-CUR = "PENDING" OR LS-CUR = "SUBMIT-FAILED"
                MOVE "CANCELLED" TO LS-NXT
            ELSE PERFORM SR-INVALID
        WHEN OTHER
            MOVE "99" TO LS-RC
            MOVE "UNKNOWN SETTLEMENT EVENT" TO LS-MSG
    END-EVALUATE
    IF LS-RC = "00" AND LS-NXT = SPACES
        PERFORM SR-INVALID
    END-IF
    GOBACK.

SR-INVALID.
    MOVE "20" TO LS-RC
    STRING "SETTLEMENT STATE " DELIMITED SIZE LS-CUR DELIMITED SIZE
        " REJECTS EVENT " DELIMITED SIZE LS-EVT DELIMITED SIZE
        INTO LS-MSG
    END-STRING
    MOVE LS-CUR TO LS-NXT.
