IDENTIFICATION DIVISION.
PROGRAM-ID. BPXQR.

*> Pix QR Code domain: lifecycle and receiver binding.
*> Payload grammar and CRC handling live in BPXEMV only.
*> The clear-text key is transient: it is required to render a payload and
*> is never written to the QR record, audit trail or events.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BPXCFG".
COPY "BPXQS".
COPY "BPXEMVP".
COPY "BPXKP".
COPY "BPXKVP".
COPY "BPXKS".
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BDATP".
COPY "BCLKP".
01 BK-PX-QR-REC.
   COPY "BPXQ".
01 BK-PX-KEY.
   COPY "BPXK".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-NOW PIC X(14).
01 WS-ID-TYPE PIC X(08).
01 WS-ISPB PIC X(08).
01 WS-ID-VAL PIC X(32).
01 WS-QR-ID-VAL PIC X(12).
01 WS-INT2 PIC 9(06).
01 WS-HM-A PIC 9(04).
01 WS-HM-B PIC 9(04).
01 WS-TTL PIC 9(06).
01 WS-ID-RC PIC X(02).
01 WS-HASH-BUF PIC X(600).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-AMT-STR PIC X(16).
01 WS-DOT PIC 9(03).
01 WS-INT PIC 9(13).
01 WS-FRAC PIC 9(02).
01 WS-FRAC-N PIC 9(01).
01 WS-ALEN PIC 9(03).
01 WS-PROBE PIC 9(01).
01 WS-CENTS PIC S9(15)V99 COMP-3.
01 WS-I PIC 9(03).
01 WS-EVT PIC X(16).
01 WS-NXT PIC X(12).
01 WS-LOCK-NAME PIC X(24).
01 WS-LOCK-OWNER PIC X(16).
01 WS-LOCK-MODE PIC X(01).
01 WS-LOCK-ST PIC X(02).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-ACCT-OUT.
   05 AO-ID PIC X(12).
   05 AO-CUST PIC X(12).
   05 AO-PRODUCT PIC X(04).
   05 AO-CURRENCY PIC X(03).
   05 AO-STATUS PIC X(02).
   05 AO-OPENED PIC 9(08).
   05 AO-CLOSED PIC 9(08).
   05 AO-VERSION PIC 9(05).
   05 AO-HASH PIC X(16).
   05 AO-RC PIC X(02).

LINKAGE SECTION.
COPY "BPXQP".

PROCEDURE DIVISION USING BK-PX-QR-PARMS.
    MOVE "00" TO XQ-RC
    MOVE SPACES TO XQ-MSG
    MOVE "N" TO XQ-REPLAY
    IF XQ-EXPIRES-AT IS NOT NUMERIC
        MOVE 0 TO XQ-EXPIRES-AT
    END-IF
    IF XQ-TTL IS NOT NUMERIC
        MOVE 0 TO XQ-TTL
    END-IF
    CALL "BCFG" USING WS-CFG
    CALL "BPXCFG" USING BK-PX-CFG
    IF PC-STATUS NOT = "00" OR PC-ENABLED NOT = "Y"
        MOVE "20" TO XQ-RC
        MOVE "PIX QR UNAVAILABLE" TO XQ-MSG
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(XQ-OP)
        WHEN "QR-CREATE" PERFORM DO-CREATE
        WHEN "QR-PARSE" PERFORM DO-PARSE
        WHEN "QR-READ" PERFORM DO-READ
        WHEN "QR-GET" PERFORM DO-GET
        WHEN "QR-CHECK" PERFORM DO-CHECK
        WHEN "QR-STATUS" PERFORM DO-STATUS
        WHEN OTHER
            MOVE "99" TO XQ-RC
            MOVE "UNKNOWN PIX QR OP" TO XQ-MSG
    END-EVALUATE
    MOVE SPACES TO XQ-KEY-VALUE
    GOBACK.

DO-CREATE.
    PERFORM VALIDATE-CREATE
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    CALL "BPXID" USING WS-ID-TYPE WS-ISPB WS-ID-VAL WS-ID-RC
    IF WS-ID-RC NOT = "00"
        MOVE "20" TO XQ-RC
        MOVE "PIX QR SEQUENCE ERROR" TO XQ-MSG
        GOBACK
    END-IF
    MOVE WS-ID-VAL(1:12) TO WS-QR-ID-VAL
    IF XQ-QR-TYPE = "DYNAMIC"
        PERFORM BUILD-TXID
        IF XQ-RC NOT = "00"
            GOBACK
        END-IF
    END-IF
    PERFORM BUILD-PAYLOAD
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    MOVE SPACES TO BK-PX-QR-REC
    MOVE WS-QR-ID-VAL TO QR-ID OF BK-PX-QR-REC
    PERFORM FILL-RECORD-BASIC
    MOVE "CREATED" TO QR-STATUS OF BK-PX-QR-REC
    MOVE "PUBLISH" TO WS-EVT
    PERFORM APPLY-STATUS
    IF XQ-RC = "00"
        MOVE WS-NXT TO QR-STATUS OF BK-PX-QR-REC
    ELSE
        MOVE "20" TO XQ-RC
        MOVE "PIX QR PUBLISH FAILED" TO XQ-MSG
        GOBACK
    END-IF
    MOVE "NOW" TO CLK-OP OF BK-CLK-PARMS
    CALL "BCLK" USING BK-CLK-PARMS
    IF CLK-RC NOT = "00"
        MOVE "20" TO XQ-RC
        MOVE "PIX QR CLOCK ERROR" TO XQ-MSG
        GOBACK
    END-IF
    MOVE CLK-OUT TO WS-NOW
    MOVE WS-NOW TO QR-CREATED OF BK-PX-QR-REC
    MOVE WS-NOW TO QR-UPDATED OF BK-PX-QR-REC
    PERFORM BUILD-EXPIRATION
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    MOVE 1 TO QR-VERSION OF BK-PX-QR-REC
    PERFORM COMPUTE-HASH
    MOVE "WRITE" TO QS-OP
    CALL "BPXQSTO" USING BK-PX-QR-STO-REQ BK-PX-QR-REC
    IF QS-RC NOT = "00"
        MOVE QS-RC TO XQ-RC
        MOVE QS-MSG TO XQ-MSG
        GOBACK
    END-IF
    MOVE QR-ID OF BK-PX-QR-REC TO XQ-QR-ID
    PERFORM FILL-PARMS
    MOVE "PIX QR CREATED" TO XQ-MSG
    PERFORM EMIT.

DO-PARSE.
    PERFORM RUN-EMV-PARSE
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CLASSIFY
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM RESOLVE-PARSED-KEY
    MOVE "PIX QR PARSED" TO XQ-MSG.

DO-READ.
    IF XQ-Payload NOT = SPACES
        PERFORM RUN-EMV-PARSE
        IF XQ-RC NOT = "00"
            GOBACK
        END-IF
        PERFORM CLASSIFY
        IF XQ-RC NOT = "00"
            GOBACK
        END-IF
        PERFORM LOCATE-BY-TXID
    ELSE
        PERFORM LOCATE-BY-ID
    END-IF
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-EXPIRY
    IF XQ-RC NOT = "00"
        IF XQ-RC = "20" AND XQ-MSG = "PIX QR EXPIRED" AND
           QR-STATUS OF BK-PX-QR-REC NOT = "EXPIRED"
            PERFORM LAZY-EXPIRE
        END-IF
        GOBACK
    END-IF
    IF QR-STATUS OF BK-PX-QR-REC = "PAID" OR
       QR-STATUS OF BK-PX-QR-REC = "CANCELLED"
        MOVE "20" TO XQ-RC
        MOVE "PIX QR NOT AVAILABLE" TO XQ-MSG
        GOBACK
    END-IF
    MOVE "READ" TO WS-EVT
    IF QR-READ-COUNT OF BK-PX-QR-REC > 0
        MOVE "REUSE" TO WS-EVT
    END-IF
    PERFORM APPLY-STATUS
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    MOVE WS-NXT TO QR-STATUS OF BK-PX-QR-REC
    ADD 1 TO QR-READ-COUNT OF BK-PX-QR-REC
    PERFORM CLOCK-NOW
    MOVE WS-NOW(1:14) TO QR-UPDATED OF BK-PX-QR-REC
    ADD 1 TO QR-VERSION OF BK-PX-QR-REC
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO QS-OP
    CALL "BPXQSTO" USING BK-PX-QR-STO-REQ BK-PX-QR-REC
    IF QS-RC NOT = "00"
        MOVE QS-RC TO XQ-RC
        MOVE QS-MSG TO XQ-MSG
        GOBACK
    END-IF
    PERFORM FILL-PARMS
    MOVE "PIX QR READ" TO XQ-MSG
    PERFORM EMIT.

DO-CHECK.
    PERFORM LOCK-QR
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOCATE-BY-ID
    IF XQ-RC NOT = "00"
        PERFORM UNLOCK-QR
        GOBACK
    END-IF
    PERFORM EVAL-EXPIRY
    PERFORM FILL-PARMS
    PERFORM UNLOCK-QR
    IF XQ-RC = "00"
        MOVE "PIX QR ACTIVE" TO XQ-MSG
    END-IF.

DO-GET.
    PERFORM LOCATE-BY-ID
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM FILL-PARMS
    MOVE "PIX QR" TO XQ-MSG.

DO-STATUS.
    MOVE FUNCTION TRIM(XQ-STATUS) TO WS-EVT
    IF WS-EVT = "PAID" AND XQ-PIX-ID NOT = SPACES
        MOVE "PAID" TO WS-EVT
    END-IF
    PERFORM LOCK-QR
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOCATE-BY-ID
    IF XQ-RC NOT = "00"
        PERFORM UNLOCK-QR
        GOBACK
    END-IF
    IF WS-EVT = "PAID"
        PERFORM CHECK-EXPIRY
        IF XQ-RC NOT = "00"
            IF XQ-MSG = "PIX QR EXPIRED" AND
               QR-STATUS OF BK-PX-QR-REC NOT = "EXPIRED"
                PERFORM LAZY-EXPIRE
            END-IF
            PERFORM UNLOCK-QR
            GOBACK
        END-IF
    END-IF
    PERFORM APPLY-STATUS
    IF XQ-RC = "00"
        MOVE WS-NXT TO QR-STATUS OF BK-PX-QR-REC
        IF XQ-PIX-ID NOT = SPACES
            MOVE XQ-PIX-ID TO QR-PIX-ID OF BK-PX-QR-REC
        END-IF
        PERFORM CLOCK-NOW
        MOVE WS-NOW(1:14) TO QR-UPDATED OF BK-PX-QR-REC
        ADD 1 TO QR-VERSION OF BK-PX-QR-REC
        PERFORM COMPUTE-HASH
        MOVE "REWRITE" TO QS-OP
        CALL "BPXQSTO" USING BK-PX-QR-STO-REQ BK-PX-QR-REC
        IF QS-RC NOT = "00"
            MOVE QS-RC TO XQ-RC
            MOVE QS-MSG TO XQ-MSG
        ELSE
            MOVE WS-NXT TO XQ-STATUS
            PERFORM FILL-PARMS
            MOVE "PIX QR STATUS UPDATED" TO XQ-MSG
            PERFORM EMIT
        END-IF
    END-IF
    PERFORM UNLOCK-QR.

VALIDATE-CREATE.
    MOVE "QRID" TO WS-ID-TYPE
    MOVE SPACES TO WS-ISPB
    IF XQ-QR-TYPE NOT = "STATIC" AND XQ-QR-TYPE NOT = "DYNAMIC"
       AND XQ-QR-TYPE NOT = "COMPOSED"
        MOVE "20" TO XQ-RC
        MOVE "UNKNOWN PIX QR TYPE" TO XQ-MSG
        GOBACK
    END-IF
    IF XQ-KEY-VALUE = SPACES
        MOVE "20" TO XQ-RC
        MOVE "PIX QR REQUIRES KEY VALUE FOR PAYLOAD" TO XQ-MSG
        GOBACK
    END-IF
    IF XQ-ACCT = SPACES AND XQ-KEY-ID = SPACES
        MOVE "20" TO XQ-RC
        MOVE "PIX QR REQUIRES ACCOUNT OR KEY" TO XQ-MSG
        GOBACK
    END-IF
    IF XQ-MERCHANT-NAME = SPACES OR XQ-CITY = SPACES
        MOVE "20" TO XQ-RC
        MOVE "PIX QR REQUIRES MERCHANT NAME AND CITY" TO XQ-MSG
        GOBACK
    END-IF
    IF XQ-MCC = SPACES
        MOVE "20" TO XQ-RC
        MOVE "PIX QR REQUIRES MCC" TO XQ-MSG
        GOBACK
    END-IF
    IF XQ-ENV = SPACES
        MOVE "PROD" TO XQ-ENV
    END-IF
    IF XQ-GUID = SPACES
        MOVE "br.gov.bcb.pix" TO XQ-GUID
    END-IF
    IF XQ-COUNTRY = SPACES
        MOVE "BR" TO XQ-COUNTRY
    END-IF
    IF XQ-CURRENCY = SPACES
        MOVE PC-CURRENCY TO XQ-CURRENCY
    END-IF
    IF XQ-AMOUNT < 0
        MOVE "20" TO XQ-RC
        MOVE "PIX QR AMOUNT MUST NOT BE NEGATIVE" TO XQ-MSG
        GOBACK
    END-IF
    IF XQ-QR-TYPE = "COMPOSED" AND XQ-URL = SPACES
        MOVE "20" TO XQ-RC
        MOVE "COMPOSED PIX QR REQUIRES DYNAMIC URL" TO XQ-MSG
        GOBACK
    END-IF
    PERFORM RESOLVE-KEY
    IF XQ-RC NOT = "00"
        GOBACK
    END-IF
    CALL "BACQRY" USING XQ-ACCT WS-ACCT-OUT
    IF AO-RC NOT = "00"
        MOVE "20" TO XQ-RC
        MOVE "PIX QR ACCOUNT NOT FOUND" TO XQ-MSG
        GOBACK
    END-IF
    IF AO-STATUS NOT = "AC"
        MOVE "20" TO XQ-RC
        MOVE "PIX QR ACCOUNT NOT ACTIVE" TO XQ-MSG
        GOBACK
    END-IF
    IF XQ-CUST = SPACES
        MOVE AO-CUST TO XQ-CUST
    END-IF.

RESOLVE-KEY.
    IF XQ-KEY-ID = SPACES
        IF XQ-KEY-VALUE = SPACES
            MOVE "20" TO XQ-RC
            MOVE "PIX QR REQUIRES KEY OR KEY ID" TO XQ-MSG
            GOBACK
        END-IF
        MOVE SPACES TO BK-PX-KEY-VAL
        IF XQ-KEY-TYPE = SPACES
            MOVE "EMAIL" TO KV-TYPE
        ELSE
            MOVE XQ-KEY-TYPE TO KV-TYPE
        END-IF
        MOVE XQ-KEY-VALUE TO KV-VALUE
        CALL "BPXKV" USING BK-PX-KEY-VAL
        IF KV-RC NOT = "00"
            MOVE KV-RC TO XQ-RC
            MOVE KV-MSG TO XQ-MSG
            GOBACK
        END-IF
        MOVE KV-HASH TO XQ-KEY-HASH
        MOVE KV-MASK TO XQ-KEY-MASK
        MOVE "EMAIL" TO XQ-KEY-TYPE
        GOBACK
    END-IF
    MOVE SPACES TO BK-PX-KEY-PARMS
    MOVE "KEY-GET" TO XK-OP
    MOVE XQ-KEY-ID TO XK-ID
    CALL "BPXKEY" USING BK-PX-KEY-PARMS
    IF XK-RC NOT = "00"
        MOVE "20" TO XQ-RC
        MOVE "PIX KEY NOT FOUND FOR QR" TO XQ-MSG
        GOBACK
    END-IF
    IF XK-STATUS NOT = "ACTIVE"
        MOVE "20" TO XQ-RC
        MOVE "PIX KEY NOT ACTIVE FOR QR" TO XQ-MSG
        GOBACK
    END-IF
    IF XQ-ACCT = SPACES
        MOVE XK-ACCT TO XQ-ACCT
    END-IF
    IF XQ-CUST = SPACES
        MOVE XK-CUST TO XQ-CUST
    END-IF
    IF XQ-PART = SPACES
        MOVE XK-PART TO XQ-PART
    END-IF
    MOVE XK-TYPE TO XQ-KEY-TYPE
    MOVE XK-MASK TO XQ-KEY-MASK
    MOVE XK-HASH TO XQ-KEY-HASH
    IF XQ-KEY-VALUE NOT = SPACES
        PERFORM VERIFY-KEY-VALUE
        IF XQ-RC NOT = "00"
            GOBACK
        END-IF
    END-IF.

VERIFY-KEY-VALUE.
    MOVE SPACES TO BK-PX-KEY-VAL
    IF XQ-KEY-TYPE = SPACES
        MOVE XK-TYPE TO KV-TYPE
    ELSE
        MOVE XQ-KEY-TYPE TO KV-TYPE
    END-IF
    MOVE XQ-KEY-VALUE TO KV-VALUE
    CALL "BPXKV" USING BK-PX-KEY-VAL
    IF KV-RC NOT = "00"
        MOVE KV-RC TO XQ-RC
        MOVE KV-MSG TO XQ-MSG
        GOBACK
    END-IF
    IF KV-HASH NOT = XK-HASH
        MOVE "20" TO XQ-RC
        MOVE "PIX KEY VALUE DOES NOT MATCH KEY" TO XQ-MSG
        GOBACK
    END-IF
    MOVE KV-TYPE TO XQ-KEY-TYPE
    MOVE KV-MASK TO XQ-KEY-MASK
    MOVE KV-HASH TO XQ-KEY-HASH.

BUILD-TXID.
    MOVE "TXID" TO WS-ID-TYPE
    MOVE PC-E2E-ISPB TO WS-ISPB
    CALL "BPXID" USING WS-ID-TYPE WS-ISPB WS-ID-VAL WS-ID-RC
    IF WS-ID-RC NOT = "00"
        MOVE "20" TO XQ-RC
        MOVE "PIX TXID SEQUENCE ERROR" TO XQ-MSG
        GOBACK
    END-IF
    MOVE WS-ID-VAL TO XQ-TXID.

BUILD-PAYLOAD.
    MOVE SPACES TO BK-PX-EMV
    MOVE "BUILD" TO EM-MODE
    MOVE XQ-GUID TO EM-GUID
    MOVE XQ-KEY-VALUE TO EM-KEY
    MOVE XQ-MCC TO EM-MCC
    MOVE XQ-CURRENCY TO EM-CURRENCY
    MOVE XQ-COUNTRY TO EM-COUNTRY
    MOVE XQ-MERCHANT-NAME TO EM-NAME
    MOVE XQ-CITY TO EM-CITY
    IF XQ-QR-TYPE = "DYNAMIC"
        MOVE XQ-TXID TO EM-ADDL-TXID
    END-IF
    IF XQ-QR-TYPE = "COMPOSED"
        MOVE XQ-URL TO EM-MAI
    END-IF
    IF XQ-AMOUNT > 0
        MOVE XQ-AMOUNT TO WS-AMT-ED
        MOVE FUNCTION TRIM(WS-AMT-ED) TO EM-AMOUNT
    END-IF
    CALL "BPXEMV" USING BK-PX-EMV
    IF EM-RC NOT = "00"
        MOVE EM-RC TO XQ-RC
        MOVE EM-MSG TO XQ-MSG
        GOBACK
    END-IF
    MOVE EM-OUT TO XQ-Payload
    MOVE EM-CRC-CALC TO XQ-CRC.

FILL-RECORD-BASIC.
    MOVE XQ-QR-TYPE TO QR-TYPE OF BK-PX-QR-REC
    MOVE XQ-ENV TO QR-ENV OF BK-PX-QR-REC
    MOVE XQ-PART TO QR-PART OF BK-PX-QR-REC
    MOVE XQ-ACCT TO QR-ACCT OF BK-PX-QR-REC
    MOVE XQ-CUST TO QR-CUST OF BK-PX-QR-REC
    MOVE XQ-PAYEE-NAME TO QR-PAYEE-NAME OF BK-PX-QR-REC
    MOVE XQ-MERCHANT-ID TO QR-MERCHANT-ID OF BK-PX-QR-REC
    MOVE XQ-MERCHANT-NAME TO QR-MERCHANT-NAME OF BK-PX-QR-REC
    MOVE XQ-CITY TO QR-CITY OF BK-PX-QR-REC
    MOVE XQ-MCC TO QR-MCC OF BK-PX-QR-REC
    MOVE XQ-COUNTRY TO QR-COUNTRY OF BK-PX-QR-REC
    MOVE XQ-CURRENCY TO QR-CURRENCY OF BK-PX-QR-REC
    MOVE XQ-AMOUNT TO QR-AMOUNT OF BK-PX-QR-REC
    MOVE XQ-TXID TO QR-TXID OF BK-PX-QR-REC
    MOVE XQ-KEY-ID TO QR-KEY-ID OF BK-PX-QR-REC
    MOVE XQ-KEY-TYPE TO QR-KEY-TYPE OF BK-PX-QR-REC
    MOVE XQ-KEY-MASK TO QR-KEY-MASK OF BK-PX-QR-REC
    MOVE XQ-KEY-HASH TO QR-KEY-HASH OF BK-PX-QR-REC
    MOVE XQ-GUID TO QR-GUID OF BK-PX-QR-REC
    MOVE XQ-MAI TO QR-MAI OF BK-PX-QR-REC
    MOVE XQ-URL TO QR-URL OF BK-PX-QR-REC
    MOVE XQ-Payload TO QR-Payload OF BK-PX-QR-REC
    MOVE XQ-CRC TO QR-CRC OF BK-PX-QR-REC
    MOVE WS-BIZDATE TO QR-CREATE-DATE OF BK-PX-QR-REC
    MOVE 0 TO QR-TTL OF BK-PX-QR-REC
    MOVE 0 TO QR-EXPIRES-AT OF BK-PX-QR-REC
    MOVE 0 TO QR-READ-COUNT OF BK-PX-QR-REC
    MOVE WS-BIZDATE TO QR-BIZDATE OF BK-PX-QR-REC.

RUN-EMV-PARSE.
    MOVE SPACES TO BK-PX-EMV
    MOVE "PARSE" TO EM-MODE
    MOVE XQ-Payload TO EM-IN
    CALL "BPXEMV" USING BK-PX-EMV
    IF EM-RC NOT = "00"
        MOVE EM-RC TO XQ-RC
        MOVE EM-MSG TO XQ-MSG
        GOBACK
    END-IF
    MOVE EM-GUID TO XQ-GUID
    MOVE EM-MAI TO XQ-MAI
    MOVE EM-KEY TO XQ-KEY-VALUE
    MOVE EM-MCC TO XQ-MCC
    MOVE EM-CURRENCY TO XQ-CURRENCY
    MOVE EM-COUNTRY TO XQ-COUNTRY
    MOVE EM-NAME TO XQ-MERCHANT-NAME
    MOVE EM-CITY TO XQ-CITY
    MOVE EM-ADDL-TXID TO XQ-TXID
    IF XQ-TXID = SPACES
        MOVE EM-TXID TO XQ-TXID
    END-IF
    MOVE EM-CRC TO XQ-CRC
    PERFORM AMOUNT-FROM-EMV.

AMOUNT-FROM-EMV.
    MOVE FUNCTION TRIM(EM-AMOUNT) TO WS-AMT-STR
    MOVE 0 TO XQ-AMOUNT
    MOVE 0 TO WS-CENTS
    MOVE 0 TO WS-FRAC
    MOVE 0 TO WS-DOT
    MOVE 0 TO WS-FRAC-N
    MOVE FUNCTION LENGTH(FUNCTION TRIM(WS-AMT-STR)) TO WS-ALEN
    IF WS-ALEN = 0
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-ALEN
        IF WS-AMT-STR(WS-I:1) = "."
            IF WS-DOT = 1
                MOVE 0 TO WS-ALEN
            ELSE
                MOVE 1 TO WS-DOT
            END-IF
        ELSE
            IF WS-AMT-STR(WS-I:1) >= "0" AND
               WS-AMT-STR(WS-I:1) <= "9"
                IF WS-DOT = 0
                    COMPUTE WS-CENTS = WS-CENTS * 10 +
                        (FUNCTION ORD(WS-AMT-STR(WS-I:1)) - 49)
                ELSE
                    IF WS-FRAC-N < 2
                        ADD 1 TO WS-FRAC-N
                        COMPUTE WS-FRAC = WS-FRAC * 10 +
                            (FUNCTION ORD(WS-AMT-STR(WS-I:1)) - 49)
                    END-IF
                END-IF
            ELSE
                MOVE 0 TO WS-ALEN
            END-IF
        END-IF
    END-PERFORM
    IF WS-ALEN = 0
        MOVE 0 TO XQ-AMOUNT
        EXIT PARAGRAPH
    END-IF
    IF WS-FRAC-N = 1
        MULTIPLY WS-FRAC BY 10 GIVING WS-FRAC
    END-IF
    COMPUTE XQ-AMOUNT = WS-CENTS + WS-FRAC / 100.

CLASSIFY.
    IF XQ-GUID NOT = "br.gov.bcb.pix"
        MOVE "20" TO XQ-RC
        MOVE "UNSUPPORTED PIX GUI" TO XQ-MSG
        EXIT PARAGRAPH
    END-IF
    IF XQ-CURRENCY NOT = SPACES AND
       XQ-CURRENCY NOT = PC-CURRENCY
        MOVE "20" TO XQ-RC
        MOVE "PIX QR CURRENCY NOT SUPPORTED" TO XQ-MSG
        EXIT PARAGRAPH
    END-IF
    IF XQ-COUNTRY NOT = SPACES AND XQ-COUNTRY NOT = "BR"
        MOVE "20" TO XQ-RC
        MOVE "PIX QR COUNTRY NOT SUPPORTED" TO XQ-MSG
        EXIT PARAGRAPH
    END-IF
    IF XQ-KEY-VALUE = SPACES
        MOVE "20" TO XQ-RC
        MOVE "PIX QR WITHOUT KEY" TO XQ-MSG
        EXIT PARAGRAPH
    END-IF
    IF XQ-QR-TYPE = SPACES
        IF XQ-TXID = SPACES
            MOVE "STATIC" TO XQ-QR-TYPE
        ELSE
            MOVE "DYNAMIC" TO XQ-QR-TYPE
        END-IF
    END-IF.

RESOLVE-PARSED-KEY.
    MOVE SPACES TO BK-PX-KEY-VAL
    IF XQ-KEY-TYPE NOT = SPACES
        MOVE XQ-KEY-TYPE TO KV-TYPE
        MOVE XQ-KEY-VALUE TO KV-VALUE
        CALL "BPXKV" USING BK-PX-KEY-VAL
    ELSE
        PERFORM VARYING WS-I FROM 1 BY 1
            UNTIL WS-I > 5 OR KV-RC = "00"
            MOVE SPACES TO BK-PX-KEY-VAL
            PERFORM CANDIDATE-TYPE
            MOVE XQ-KEY-VALUE TO KV-VALUE
            CALL "BPXKV" USING BK-PX-KEY-VAL
        END-PERFORM
    END-IF
    IF KV-RC = "00"
        MOVE KV-HASH TO XQ-KEY-HASH
        MOVE KV-MASK TO XQ-KEY-MASK
        MOVE KV-TYPE TO XQ-KEY-TYPE
        PERFORM FIND-KEY-BY-HASH
    END-IF
    MOVE "00" TO XQ-RC
    MOVE SPACES TO XQ-MSG.

CANDIDATE-TYPE.
    EVALUATE WS-I
        WHEN 1 MOVE "EMAIL" TO KV-TYPE
        WHEN 2 MOVE "CPF" TO KV-TYPE
        WHEN 3 MOVE "CNPJ" TO KV-TYPE
        WHEN 4 MOVE "PHONE" TO KV-TYPE
        WHEN 5 MOVE "RANDOM" TO KV-TYPE
    END-EVALUATE.

FIND-KEY-BY-HASH.
    MOVE SPACES TO BK-PX-KEY
    MOVE XQ-KEY-HASH TO PK-VALUE-HASH OF BK-PX-KEY
    MOVE "GET-HASH" TO KS-OP
    CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
    IF KS-RC = "00"
        MOVE PK-ID OF BK-PX-KEY TO XQ-KEY-ID
        MOVE "GET" TO KS-OP
        CALL "BPXKSTO" USING BK-PX-KEY-STO-REQ BK-PX-KEY
        MOVE PK-PART OF BK-PX-KEY TO XQ-PART
        MOVE PK-ACCT OF BK-PX-KEY TO XQ-ACCT
        MOVE PK-CUST OF BK-PX-KEY TO XQ-CUST
    END-IF
    MOVE "00" TO KS-RC
    MOVE SPACES TO KS-MSG.

BUILD-EXPIRATION.
    IF XQ-QR-TYPE NOT = "DYNAMIC"
        MOVE 0 TO QR-TTL OF BK-PX-QR-REC
        MOVE 0 TO QR-EXPIRES-AT OF BK-PX-QR-REC
        EXIT PARAGRAPH
    END-IF
    IF XQ-TTL > 0
        MOVE XQ-TTL TO WS-TTL
    ELSE
        MOVE PC-QR-EXP-DEF TO WS-TTL
    END-IF
    IF WS-TTL <= 0
        MOVE "20" TO XQ-RC
        MOVE "QR EXPIRATION NOT CONFIGURED" TO XQ-MSG
        GOBACK
    END-IF
    MOVE WS-TTL TO QR-TTL OF BK-PX-QR-REC
    MOVE QR-CREATED OF BK-PX-QR-REC TO CLK-BASE OF BK-CLK-PARMS
    MOVE WS-TTL TO CLK-SECONDS OF BK-CLK-PARMS
    MOVE "ADD-SECONDS" TO CLK-OP OF BK-CLK-PARMS
    CALL "BCLK" USING BK-CLK-PARMS
    IF CLK-RC NOT = "00"
        MOVE "20" TO XQ-RC
        MOVE "PIX QR CLOCK ERROR" TO XQ-MSG
        GOBACK
    END-IF
    MOVE CLK-OUT TO QR-EXPIRES-AT OF BK-PX-QR-REC
    MOVE CLK-OUT TO XQ-EXPIRES-AT.

CHECK-EXPIRY.
    PERFORM EVAL-EXPIRY.

EVAL-EXPIRY.
    IF QR-TYPE OF BK-PX-QR-REC NOT = "DYNAMIC"
        EXIT PARAGRAPH
    END-IF
    IF QR-STATUS OF BK-PX-QR-REC = "PAID" OR
       QR-STATUS OF BK-PX-QR-REC = "CANCELLED" OR
       QR-STATUS OF BK-PX-QR-REC = "EXPIRED"
        EXIT PARAGRAPH
    END-IF
    IF QR-EXPIRES-AT OF BK-PX-QR-REC = 0
        MOVE "20" TO XQ-RC
        MOVE "PIX QR MISSING EXPIRATION INSTANT" TO XQ-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "NOW" TO CLK-OP OF BK-CLK-PARMS
    CALL "BCLK" USING BK-CLK-PARMS
    IF CLK-RC NOT = "00"
        MOVE "20" TO XQ-RC
        MOVE "PIX QR CLOCK ERROR" TO XQ-MSG
        EXIT PARAGRAPH
    END-IF
    IF CLK-OUT >= QR-EXPIRES-AT OF BK-PX-QR-REC
        MOVE "20" TO XQ-RC
        MOVE "PIX QR EXPIRED" TO XQ-MSG
    END-IF.

LAZY-EXPIRE.
    MOVE "EXPIRE" TO WS-EVT
    MOVE "00" TO XQ-RC
    PERFORM APPLY-STATUS
    IF XQ-RC = "00"
        MOVE WS-NXT TO QR-STATUS OF BK-PX-QR-REC
        PERFORM PERSIST-STATUS
    END-IF
    MOVE "20" TO XQ-RC
    MOVE "PIX QR EXPIRED" TO XQ-MSG.

APPLY-STATUS.
    MOVE SPACES TO WS-NXT
    EVALUATE TRUE
        WHEN WS-EVT = "PUBLISH"
            IF QR-STATUS OF BK-PX-QR-REC = "CREATED"
                MOVE "PUBLISHED" TO WS-NXT
            ELSE
                PERFORM SET-QR-INVALID
            END-IF
        WHEN WS-EVT = "READ"
            IF QR-STATUS OF BK-PX-QR-REC = "PUBLISHED"
                MOVE "READ" TO WS-NXT
            ELSE
                PERFORM SET-QR-INVALID
            END-IF
        WHEN WS-EVT = "REUSE"
            IF QR-STATUS OF BK-PX-QR-REC = "READ"
                MOVE "READ" TO WS-NXT
            ELSE
                PERFORM SET-QR-INVALID
            END-IF
        WHEN WS-EVT = "PAID"
            IF QR-STATUS OF BK-PX-QR-REC = "PUBLISHED" OR
               QR-STATUS OF BK-PX-QR-REC = "READ" OR
               QR-STATUS OF BK-PX-QR-REC = "PAID"
                MOVE "PAID" TO WS-NXT
            ELSE
                PERFORM SET-QR-INVALID
            END-IF
        WHEN WS-EVT = "CANCEL"
            IF QR-STATUS OF BK-PX-QR-REC = "CREATED" OR
               QR-STATUS OF BK-PX-QR-REC = "PUBLISHED" OR
               QR-STATUS OF BK-PX-QR-REC = "READ"
                MOVE "CANCELLED" TO WS-NXT
            ELSE
                PERFORM SET-QR-INVALID
            END-IF
        WHEN WS-EVT = "EXPIRE"
            IF QR-STATUS OF BK-PX-QR-REC = "CREATED" OR
               QR-STATUS OF BK-PX-QR-REC = "PUBLISHED" OR
               QR-STATUS OF BK-PX-QR-REC = "READ"
                MOVE "EXPIRED" TO WS-NXT
            ELSE
                PERFORM SET-QR-INVALID
            END-IF
        WHEN OTHER
            PERFORM SET-QR-INVALID
    END-EVALUATE.

SET-QR-INVALID.
    MOVE "20" TO XQ-RC
    STRING "INVALID PIX QR TRANSITION " DELIMITED SIZE
        FUNCTION TRIM(QR-STATUS OF BK-PX-QR-REC) DELIMITED SIZE
        " + " DELIMITED SIZE FUNCTION TRIM(WS-EVT) DELIMITED SIZE
        INTO XQ-MSG
    END-STRING.

LOCATE-BY-ID.
    MOVE SPACES TO BK-PX-QR-REC
    MOVE XQ-QR-ID TO QR-ID OF BK-PX-QR-REC
    IF QR-ID OF BK-PX-QR-REC = SPACES
        MOVE "20" TO XQ-RC
        MOVE "PIX QR ID REQUIRED" TO XQ-MSG
        GOBACK
    END-IF
    MOVE "GET" TO QS-OP
    CALL "BPXQSTO" USING BK-PX-QR-STO-REQ BK-PX-QR-REC
    IF QS-RC NOT = "00"
        MOVE QS-RC TO XQ-RC
        MOVE QS-MSG TO XQ-MSG
    END-IF.

LOCATE-BY-TXID.
    MOVE SPACES TO BK-PX-QR-REC
    IF XQ-TXID = SPACES
        MOVE "20" TO XQ-RC
        MOVE "PIX QR WITHOUT TRANSACTION IDENTIFIER" TO XQ-MSG
        GOBACK
    END-IF
    MOVE XQ-TXID TO QR-TXID OF BK-PX-QR-REC
    MOVE "GET-TXID" TO QS-OP
    CALL "BPXQSTO" USING BK-PX-QR-STO-REQ BK-PX-QR-REC
    IF QS-RC NOT = "00"
        MOVE "20" TO XQ-RC
        MOVE "PIX QR NOT ISSUED BY THIS INSTITUTION" TO XQ-MSG
        GOBACK
    END-IF
    MOVE "GET" TO QS-OP
    CALL "BPXQSTO" USING BK-PX-QR-STO-REQ BK-PX-QR-REC
    IF QS-RC NOT = "00"
        MOVE QS-RC TO XQ-RC
        MOVE QS-MSG TO XQ-MSG
    END-IF.

PERSIST-STATUS.
    PERFORM CLOCK-NOW
    MOVE WS-NOW(1:14) TO QR-UPDATED OF BK-PX-QR-REC
    ADD 1 TO QR-VERSION OF BK-PX-QR-REC
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO QS-OP
    CALL "BPXQSTO" USING BK-PX-QR-STO-REQ BK-PX-QR-REC.

COMPUTE-HASH.
    MOVE QR-AMOUNT OF BK-PX-QR-REC TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(QR-ID OF BK-PX-QR-REC) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(QR-TYPE OF BK-PX-QR-REC)
        DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(QR-STATUS OF BK-PX-QR-REC) DELIMITED SIZE "|"
        DELIMITED SIZE FUNCTION TRIM(QR-TXID OF BK-PX-QR-REC)
        DELIMITED SIZE "|" DELIMITED SIZE WS-AMT-ED DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 600 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO QR-HASH OF BK-PX-QR-REC.

FILL-PARMS.
    MOVE QR-ID OF BK-PX-QR-REC TO XQ-QR-ID
    MOVE QR-TYPE OF BK-PX-QR-REC TO XQ-QR-TYPE
    MOVE QR-ENV OF BK-PX-QR-REC TO XQ-ENV
    MOVE QR-PART OF BK-PX-QR-REC TO XQ-PART
    MOVE QR-ACCT OF BK-PX-QR-REC TO XQ-ACCT
    MOVE QR-CUST OF BK-PX-QR-REC TO XQ-CUST
    MOVE QR-PAYEE-NAME OF BK-PX-QR-REC TO XQ-PAYEE-NAME
    MOVE QR-MERCHANT-ID OF BK-PX-QR-REC TO XQ-MERCHANT-ID
    MOVE QR-MERCHANT-NAME OF BK-PX-QR-REC TO XQ-MERCHANT-NAME
    MOVE QR-CITY OF BK-PX-QR-REC TO XQ-CITY
    MOVE QR-MCC OF BK-PX-QR-REC TO XQ-MCC
    MOVE QR-COUNTRY OF BK-PX-QR-REC TO XQ-COUNTRY
    MOVE QR-CURRENCY OF BK-PX-QR-REC TO XQ-CURRENCY
    MOVE QR-AMOUNT OF BK-PX-QR-REC TO XQ-AMOUNT
    MOVE QR-TXID OF BK-PX-QR-REC TO XQ-TXID
    MOVE QR-KEY-ID OF BK-PX-QR-REC TO XQ-KEY-ID
    MOVE QR-KEY-TYPE OF BK-PX-QR-REC TO XQ-KEY-TYPE
    MOVE QR-KEY-MASK OF BK-PX-QR-REC TO XQ-KEY-MASK
    MOVE QR-KEY-HASH OF BK-PX-QR-REC TO XQ-KEY-HASH
    MOVE QR-GUID OF BK-PX-QR-REC TO XQ-GUID
    MOVE QR-MAI OF BK-PX-QR-REC TO XQ-MAI
    MOVE QR-URL OF BK-PX-QR-REC TO XQ-URL
    MOVE QR-Payload OF BK-PX-QR-REC TO XQ-Payload
    MOVE QR-CRC OF BK-PX-QR-REC TO XQ-CRC
    MOVE QR-STATUS OF BK-PX-QR-REC TO XQ-STATUS
    MOVE QR-PIX-ID OF BK-PX-QR-REC TO XQ-PIX-ID
    MOVE QR-READ-COUNT OF BK-PX-QR-REC TO XQ-READ-COUNT
    MOVE QR-CREATE-DATE OF BK-PX-QR-REC TO XQ-CREATE-DATE
    MOVE QR-TTL OF BK-PX-QR-REC TO XQ-TTL
    MOVE QR-EXPIRES-AT OF BK-PX-QR-REC TO XQ-EXPIRES-AT.

CLOCK-NOW.
    MOVE "NOW" TO CLK-OP OF BK-CLK-PARMS
    CALL "BCLK" USING BK-CLK-PARMS
    IF CLK-RC NOT = "00"
        MOVE SPACES TO WS-NOW
    ELSE
        MOVE CLK-OUT TO WS-NOW
    END-IF.

LOCK-QR.
    MOVE SPACES TO WS-LOCK-NAME
    STRING "PIXQR-" DELIMITED SIZE FUNCTION TRIM(XQ-QR-ID)
        DELIMITED SIZE INTO WS-LOCK-NAME
    END-STRING
    MOVE FUNCTION TRIM(XQ-OPERATOR) TO WS-LOCK-OWNER
    MOVE "A" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST
    IF WS-LOCK-ST NOT = "00"
        MOVE "24" TO XQ-RC
        MOVE "PIX QR LOCKED" TO XQ-MSG
    END-IF.

UNLOCK-QR.
    MOVE "R" TO WS-LOCK-MODE
    CALL "BLCK" USING WS-LOCK-NAME WS-LOCK-OWNER WS-LOCK-MODE
        WS-LOCK-ST.

EMIT.
    MOVE XQ-OPERATOR TO BK-AUD-OPERATOR
    MOVE XQ-OP(1:12) TO BK-AUD-ACTION
    MOVE XQ-QR-ID TO BK-AUD-ENTITY
    MOVE XQ-CORR TO BK-AUD-CORR
    MOVE XQ-STATUS TO BK-AUD-AFTER
    MOVE XQ-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE "PIX.QR.CREATED.v1" TO BK-EVT-TYPE
    IF XQ-OP = "QR-STATUS" OR XQ-OP = "QR-READ"
        MOVE "PIX.QR.STATUS.v1" TO BK-EVT-TYPE
    END-IF
    MOVE XQ-QR-ID TO BK-EVT-KEY
    MOVE SPACES TO BK-EVT-PAYLOAD
    STRING FUNCTION TRIM(XQ-QR-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XQ-QR-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XQ-STATUS) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(XQ-ACCT) DELIMITED SIZE
        INTO BK-EVT-PAYLOAD
    END-STRING
    CALL "BEVT" USING BK-EVT-PARMS.
