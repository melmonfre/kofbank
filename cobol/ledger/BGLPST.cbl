IDENTIFICATION DIVISION.
PROGRAM-ID. BGLPST.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT GL-FILE ASSIGN TO WS-GL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS GL-CODE
        FILE STATUS IS WS-GL-ST.
    SELECT BAL-FILE ASSIGN TO WS-BAL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS BAL-ACCT-ID
        FILE STATUS IS WS-BAL-ST.
    SELECT PST-FILE ASSIGN TO WS-PST-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-PST-ST.
    SELECT JST-FILE ASSIGN TO WS-JST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS JST-ID
        FILE STATUS IS WS-JST-ST.

DATA DIVISION.
FILE SECTION.
FD GL-FILE.
01 GL-REC.
   05 GL-CODE PIC X(10).
   05 GL-NAME PIC X(40).
   05 GL-TYPE PIC X(01).
   05 GL-STATUS PIC X(01).
FD BAL-FILE.
01 BAL-REC.
   05 BAL-ACCT-ID PIC X(12).
   05 BAL-LEDGER PIC S9(15)V99 COMP-3.
   05 BAL-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BAL-BLOCKED PIC S9(15)V99 COMP-3.
   05 BAL-CURRENCY PIC X(03).
   05 BAL-UPDATED PIC 9(08).
   05 BAL-SEQ PIC 9(12).
FD PST-FILE.
01 PST-LINE PIC X(300).
FD JST-FILE.
01 JST-REC.
   05 JST-ID PIC X(20).
   05 JST-STATE PIC X(01).
   05 JST-UPDATED PIC 9(14).

WORKING-STORAGE SECTION.
01 WS-GL-PATH PIC X(200).
01 WS-BAL-PATH PIC X(200).
01 WS-PST-PATH PIC X(200).
01 WS-JST-PATH PIC X(200).
01 WS-NOW PIC X(14).
01 WS-HOME PIC X(80).
01 WS-GL-ST PIC X(02).
01 WS-BAL-ST PIC X(02).
01 WS-PST-ST PIC X(02).
01 WS-JST-ST PIC X(02).
01 WS-I PIC 9(04).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-DELTA PIC S9(15)V99 COMP-3.
01 WS-TOT-DR PIC S9(15)V99 COMP-3.
01 WS-TOT-CR PIC S9(15)V99 COMP-3.
01 WS-CRASH PIC X(12).
01 WS-STAGE PIC X(01).
01 WS-LK-MODE PIC X(01).
01 WS-LK-LEDGER PIC X(64) VALUE "WR-LEDGER".
01 WS-LK-STATUS PIC X(02).

LINKAGE SECTION.
COPY "BKJRNP".
COPY "BKPSTT".

PROCEDURE DIVISION USING BK-JRN-PARMS BK-PST-TABLE.
    MOVE "00" TO BK-JRN-RC
    MOVE SPACES TO BK-JRN-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    ACCEPT WS-CRASH FROM ENVIRONMENT "KOF_CRASH"
    PERFORM RESOLVE-PATHS
    PERFORM VALIDATE-POSTINGS
    IF BK-JRN-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM VALIDATE-BALANCE
    IF BK-JRN-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-DUPLICATE
    IF BK-JRN-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "W" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-LEDGER WS-LK-STATUS
    CALL "BJRN" USING BK-JRN-PARMS BK-PST-TABLE
    MOVE "R" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-LEDGER WS-LK-STATUS
    IF BK-JRN-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "J" TO WS-STAGE
    PERFORM MARK-STAGE
    IF WS-CRASH = "AFTER-JRN"
        MOVE "90" TO BK-JRN-RC
        MOVE "SIMULATED CRASH AFTER JOURNAL" TO BK-JRN-MSG
        GOBACK
    END-IF
    PERFORM POST-BALANCES
    MOVE "B" TO WS-STAGE
    PERFORM MARK-STAGE
    IF WS-CRASH = "AFTER-BAL"
        MOVE "90" TO BK-JRN-RC
        MOVE "SIMULATED CRASH AFTER BALANCES" TO BK-JRN-MSG
        GOBACK
    END-IF
    PERFORM APPEND-POSTINGS
    MOVE "P" TO WS-STAGE
    PERFORM MARK-STAGE
    IF WS-CRASH = "AFTER-PST"
        MOVE "90" TO BK-JRN-RC
        MOVE "SIMULATED CRASH AFTER POSTINGS" TO BK-JRN-MSG
        GOBACK
    END-IF
    GOBACK.

CHECK-DUPLICATE.
    MOVE "G" TO BK-JRN-MODE
    CALL "BJRN" USING BK-JRN-PARMS BK-PST-TABLE
    MOVE "W" TO BK-JRN-MODE
    IF BK-JRN-F-FOUND > 0
        MOVE "22" TO BK-JRN-RC
        MOVE "JOURNAL ALREADY WRITTEN" TO BK-JRN-MSG
    END-IF.

RESOLVE-PATHS.
    MOVE SPACES TO WS-GL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/gl.idx"
        DELIMITED SIZE INTO WS-GL-PATH
    MOVE SPACES TO WS-BAL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/acctbal.idx"
        DELIMITED SIZE INTO WS-BAL-PATH
    MOVE SPACES TO WS-PST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/postings.log"
        DELIMITED SIZE INTO WS-PST-PATH
    MOVE SPACES TO WS-JST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/jrst.idx"
        DELIMITED SIZE INTO WS-JST-PATH.

VALIDATE-POSTINGS.
    IF BK-JRN-COUNT = 0 OR BK-JRN-COUNT > 50
        MOVE "20" TO BK-JRN-RC
        MOVE "INVALID POSTING COUNT" TO BK-JRN-MSG
        GOBACK
    END-IF
    OPEN INPUT GL-FILE
    IF WS-GL-ST NOT = "00"
        MOVE "35" TO BK-JRN-RC
        MOVE "CHART OF ACCOUNTS MISSING" TO BK-JRN-MSG
        GOBACK
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BK-JRN-COUNT
        MOVE BK-PST-GL(WS-I) TO GL-CODE
        READ GL-FILE
        IF WS-GL-ST NOT = "00"
            MOVE "20" TO BK-JRN-RC
            MOVE "UNKNOWN GL ACCOUNT" TO BK-JRN-MSG
        END-IF
        IF BK-PST-DC(WS-I) NOT = "D" AND BK-PST-DC(WS-I) NOT = "C"
            MOVE "20" TO BK-JRN-RC
            MOVE "INVALID DEBIT CREDIT" TO BK-JRN-MSG
        END-IF
        IF BK-PST-AMOUNT(WS-I) <= 0
            MOVE "20" TO BK-JRN-RC
            MOVE "AMOUNT MUST BE POSITIVE" TO BK-JRN-MSG
        END-IF
    END-PERFORM
    CLOSE GL-FILE.

VALIDATE-BALANCE.
    MOVE 0 TO WS-TOT-DR
    MOVE 0 TO WS-TOT-CR
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BK-JRN-COUNT
        IF BK-PST-DC(WS-I) = "D"
            ADD BK-PST-AMOUNT(WS-I) TO WS-TOT-DR
        ELSE
            ADD BK-PST-AMOUNT(WS-I) TO WS-TOT-CR
        END-IF
    END-PERFORM
    IF WS-TOT-DR NOT = WS-TOT-CR
        MOVE "20" TO BK-JRN-RC
        MOVE "DEBIT CREDIT MISMATCH" TO BK-JRN-MSG
    END-IF.

MARK-STAGE.
    MOVE "W" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-LEDGER WS-LK-STATUS
    MOVE SPACES TO JST-ID
    MOVE BK-JRN-ID TO JST-ID
    MOVE WS-STAGE TO JST-STATE
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO JST-UPDATED
    OPEN I-O JST-FILE
    IF WS-JST-ST = "35"
        OPEN OUTPUT JST-FILE
        CLOSE JST-FILE
        OPEN I-O JST-FILE
    END-IF
    IF WS-JST-ST NOT = "00"
        MOVE "R" TO WS-LK-MODE
        CALL "BWR" USING WS-LK-MODE WS-LK-LEDGER WS-LK-STATUS
        EXIT PARAGRAPH
    END-IF
    DELETE JST-FILE
    WRITE JST-REC
        INVALID KEY CONTINUE
    END-WRITE
    CLOSE JST-FILE
    MOVE "R" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-LEDGER WS-LK-STATUS.

POST-BALANCES.
    MOVE "W" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-LEDGER WS-LK-STATUS
    OPEN I-O BAL-FILE
    IF WS-BAL-ST = "35"
        OPEN OUTPUT BAL-FILE
        CLOSE BAL-FILE
        OPEN I-O BAL-FILE
    END-IF
    IF WS-BAL-ST NOT = "00"
        MOVE "R" TO WS-LK-MODE
        CALL "BWR" USING WS-LK-MODE WS-LK-LEDGER WS-LK-STATUS
        EXIT PARAGRAPH
    END-IF
    OPEN INPUT GL-FILE
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BK-JRN-COUNT
        IF BK-PST-ENTITY(WS-I) NOT = SPACES
            PERFORM UPDATE-ONE-BALANCE
        END-IF
    END-PERFORM
    CLOSE GL-FILE
    CLOSE BAL-FILE
    MOVE "R" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-LEDGER WS-LK-STATUS.

UPDATE-ONE-BALANCE.
    MOVE BK-PST-ENTITY(WS-I) TO BAL-ACCT-ID
    MOVE BK-PST-AMOUNT(WS-I) TO WS-DELTA
    MOVE BK-PST-GL(WS-I) TO GL-CODE
    READ GL-FILE
    IF WS-GL-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF GL-TYPE = "A" AND BK-PST-DC(WS-I) = "C"
        MULTIPLY -1 BY WS-DELTA
    END-IF
    IF GL-TYPE = "L" AND BK-PST-DC(WS-I) = "D"
        MULTIPLY -1 BY WS-DELTA
    END-IF
    READ BAL-FILE
    EVALUATE WS-BAL-ST
        WHEN "23"
            MOVE 0 TO BAL-LEDGER
            MOVE 0 TO BAL-AVAILABLE
            MOVE 0 TO BAL-BLOCKED
            MOVE 0 TO BAL-SEQ
            MOVE BK-PST-CURRENCY(WS-I) TO BAL-CURRENCY
            ADD WS-DELTA TO BAL-LEDGER
            COMPUTE BAL-AVAILABLE = BAL-LEDGER - BAL-BLOCKED
            MOVE BK-JRN-BIZDATE TO BAL-UPDATED
            ADD 1 TO BAL-SEQ
            WRITE BAL-REC
        WHEN "00"
            ADD WS-DELTA TO BAL-LEDGER
            COMPUTE BAL-AVAILABLE = BAL-LEDGER - BAL-BLOCKED
            MOVE BK-JRN-BIZDATE TO BAL-UPDATED
            ADD 1 TO BAL-SEQ
            REWRITE BAL-REC
        WHEN OTHER
            CONTINUE
    END-EVALUATE.

APPEND-POSTINGS.
    MOVE "W" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-LEDGER WS-LK-STATUS
    OPEN EXTEND PST-FILE
    IF WS-PST-ST = "35"
        OPEN OUTPUT PST-FILE
    END-IF
    IF WS-PST-ST NOT = "00"
        MOVE "R" TO WS-LK-MODE
        CALL "BWR" USING WS-LK-MODE WS-LK-LEDGER WS-LK-STATUS
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BK-JRN-COUNT
        MOVE SPACES TO PST-LINE
        MOVE BK-PST-AMOUNT(WS-I) TO WS-AMT-ED
        STRING "GLP|" DELIMITED SIZE
            FUNCTION TRIM(BK-PST-GL(WS-I)) DELIMITED SIZE "|" DELIMITED SIZE
            BK-PST-DC(WS-I) DELIMITED SIZE "|" DELIMITED SIZE
            WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
            FUNCTION TRIM(BK-PST-ENTITY(WS-I)) DELIMITED SIZE "|" DELIMITED SIZE
            FUNCTION TRIM(BK-PST-CURRENCY(WS-I)) DELIMITED SIZE "|" DELIMITED SIZE
            FUNCTION TRIM(BK-JRN-ID) DELIMITED SIZE "|" DELIMITED SIZE
            BK-JRN-BIZDATE DELIMITED SIZE
            INTO PST-LINE
        END-STRING
        WRITE PST-LINE
    END-PERFORM
    CLOSE PST-FILE.
