IDENTIFICATION DIVISION.
PROGRAM-ID. BGLCHT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CHT-FILE ASSIGN TO WS-CHT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-CHT-ST.
    SELECT GL-FILE ASSIGN TO WS-GL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS GL-CODE
        FILE STATUS IS WS-GL-ST.

DATA DIVISION.
FILE SECTION.
FD CHT-FILE.
01 CHT-LINE PIC X(120).
FD GL-FILE.
01 GL-REC.
   05 GL-CODE PIC X(10).
   05 GL-NAME PIC X(40).
   05 GL-TYPE PIC X(01).
   05 GL-STATUS PIC X(01).

WORKING-STORAGE SECTION.
01 WS-CHT-PATH PIC X(200).
01 WS-GL-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CHT-ST PIC X(02).
01 WS-GL-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-CODE PIC X(10).
01 WS-NAME PIC X(40).
01 WS-TYPE PIC X(01).

LINKAGE SECTION.
01 LS-COUNT PIC 9(04).
01 LS-STATUS PIC X(02).

PROCEDURE DIVISION USING LS-COUNT LS-STATUS.
    MOVE 0 TO LS-COUNT
    MOVE "00" TO LS-STATUS
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CHT-PATH
    STRING FUNCTION TRIM(WS-HOME) "/etc/chart.cfg"
        DELIMITED SIZE INTO WS-CHT-PATH
    MOVE SPACES TO WS-GL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/gl.idx"
        DELIMITED SIZE INTO WS-GL-PATH
    OPEN INPUT CHT-FILE
    IF WS-CHT-ST NOT = "00"
        MOVE "35" TO LS-STATUS
        GOBACK
    END-IF
    OPEN I-O GL-FILE
    IF WS-GL-ST = "35"
        OPEN OUTPUT GL-FILE
        CLOSE GL-FILE
        OPEN I-O GL-FILE
    END-IF
    IF WS-GL-ST NOT = "00"
        MOVE WS-GL-ST TO LS-STATUS
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CHT-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM LOAD-ACCOUNT
        END-READ
    END-PERFORM
    CLOSE CHT-FILE
    CLOSE GL-FILE
    GOBACK.

LOAD-ACCOUNT.
    IF CHT-LINE = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-CODE WS-NAME WS-TYPE
    UNSTRING CHT-LINE DELIMITED BY "|"
        INTO WS-CODE WS-NAME WS-TYPE
    END-UNSTRING
    MOVE WS-CODE TO GL-CODE
    MOVE WS-NAME TO GL-NAME
    MOVE WS-TYPE TO GL-TYPE
    MOVE "A" TO GL-STATUS
    READ GL-FILE
    EVALUATE WS-GL-ST
        WHEN "23"
            WRITE GL-REC
            ADD 1 TO LS-COUNT
        WHEN "00"
            REWRITE GL-REC
            ADD 1 TO LS-COUNT
        WHEN OTHER
            CONTINUE
    END-EVALUATE.
