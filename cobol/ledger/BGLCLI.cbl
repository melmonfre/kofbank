IDENTIFICATION DIVISION.
PROGRAM-ID. BGLCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(20).
01 WS-A PIC X(24).
01 WS-B PIC X(20).
01 WS-C PIC X(20).
01 WS-COUNT PIC 9(04).
01 WS-RC PIC X(02).
01 WS-BAL-OUT.
   05 BAL-LEDGER PIC S9(15)V99 COMP-3.
   05 BAL-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BAL-BLOCKED PIC S9(15)V99 COMP-3.
   05 BAL-CURRENCY PIC X(03).
   05 BAL-UPDATED PIC 9(08).
   05 BAL-SEQ PIC 9(12).
   05 BAL-RC PIC X(02).
01 WS-MATCHES PIC 9(06).
01 WS-QRC PIC X(02).
01 WS-TB-MSG PIC X(80).
01 WS-LEDGER-ED PIC -(15)9.99.
01 WS-AVAIL-ED PIC -(15)9.99.
01 WS-BLOCKED-ED PIC -(15)9.99.
COPY "BKJRNP".
COPY "BKPSTT".

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "init" PERFORM DO-INIT
        WHEN "balance" PERFORM DO-BALANCE
        WHEN "postings" PERFORM DO-POSTINGS
        WHEN "trial" PERFORM DO-TRIAL
        WHEN "journal" PERFORM DO-JOURNAL
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN LEDGER OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C
    END-UNSTRING.

DO-JOURNAL.
    MOVE SPACES TO BK-JRN-PARMS
    MOVE WS-A TO BK-JRN-ID
    MOVE "G" TO BK-JRN-MODE
    CALL "BJRN" USING BK-JRN-PARMS BK-PST-TABLE
    IF BK-JRN-RC = "00" AND BK-JRN-F-FOUND > 0
        MOVE "00" TO WS-RC
    END-IF
    DISPLAY "rc=" WS-RC
    DISPLAY "found=" BK-JRN-F-FOUND
    DISPLAY "declared=" BK-JRN-F-DECLARED
    DISPLAY "lines=" BK-JRN-F-NCOL
    MOVE BK-JRN-F-DR TO WS-LEDGER-ED
    DISPLAY "debit=" WS-LEDGER-ED
    MOVE BK-JRN-F-CR TO WS-LEDGER-ED
    DISPLAY "credit=" WS-LEDGER-ED
    DISPLAY "hash=" FUNCTION TRIM(BK-JRN-F-HASH).

DO-INIT.
    CALL "BGLCHT" USING WS-COUNT WS-RC
    DISPLAY "rc=" WS-RC
    DISPLAY "accounts=" WS-COUNT.

DO-BALANCE.
    CALL "BGLBAL" USING WS-A WS-BAL-OUT
    DISPLAY "rc=" BAL-RC
    IF BAL-RC = "00"
        MOVE BAL-LEDGER TO WS-LEDGER-ED
        MOVE BAL-AVAILABLE TO WS-AVAIL-ED
        MOVE BAL-BLOCKED TO WS-BLOCKED-ED
        DISPLAY "ledger=" WS-LEDGER-ED
        DISPLAY "available=" WS-AVAIL-ED
        DISPLAY "blocked=" WS-BLOCKED-ED
        DISPLAY "currency=" BAL-CURRENCY
        DISPLAY "seq=" BAL-SEQ
    END-IF.

DO-POSTINGS.
    CALL "BGLQ" USING WS-A WS-MATCHES WS-QRC
    DISPLAY "rc=" WS-QRC
    DISPLAY "matches=" WS-MATCHES.

DO-TRIAL.
    CALL "BGLTB" USING WS-RC WS-TB-MSG
    DISPLAY "rc=" WS-RC
    DISPLAY "msg=" FUNCTION TRIM(WS-TB-MSG).
