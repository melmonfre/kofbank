IDENTIFICATION DIVISION.
PROGRAM-ID. COLPSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PROM-FILE ASSIGN TO WS-PROM-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PM-ID
        FILE STATUS IS WS-PROM-ST.

DATA DIVISION.
FILE SECTION.
FD PROM-FILE.
01 PROM-REC.
   COPY "COLP".

WORKING-STORAGE SECTION.
01 WS-PROM-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-PROM-ST PIC X(02).

LINKAGE SECTION.
COPY "COLSTO".
01 BK-COL-PROMISE.
   COPY "COLP".

PROCEDURE DIVISION USING BK-COL-STO-REQ BK-COL-PROMISE.
    MOVE "00" TO OS-RC
    MOVE SPACES TO OS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-PROM-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/colprom.idx"
        DELIMITED SIZE INTO WS-PROM-PATH
    PERFORM OPEN-STORE
    IF OS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE OS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO OS-RC
            MOVE "UNKNOWN PROMISE STORE OP" TO OS-MSG
    END-EVALUATE
    CLOSE PROM-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O PROM-FILE
    IF WS-PROM-ST = "35"
        OPEN OUTPUT PROM-FILE
        CLOSE PROM-FILE
        OPEN I-O PROM-FILE
    END-IF
    IF WS-PROM-ST NOT = "00"
        MOVE WS-PROM-ST TO OS-RC
        MOVE "CANNOT OPEN PROMISE INDEX" TO OS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-COL-PROMISE TO PROM-REC
    WRITE PROM-REC
        INVALID KEY
            MOVE "22" TO OS-RC
            MOVE "PROMISE ALREADY EXISTS" TO OS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE PM-ID OF BK-COL-PROMISE TO PM-ID OF PROM-REC
    READ PROM-FILE
    IF WS-PROM-ST = "00"
        MOVE BK-COL-PROMISE TO PROM-REC
        REWRITE PROM-REC
    ELSE
        MOVE "23" TO OS-RC
        MOVE "PROMISE NOT FOUND" TO OS-MSG
    END-IF.

DO-GET.
    MOVE PM-ID OF BK-COL-PROMISE TO PM-ID OF PROM-REC
    READ PROM-FILE
    IF WS-PROM-ST = "00"
        MOVE PROM-REC TO BK-COL-PROMISE
        MOVE "00" TO OS-RC
    ELSE
        MOVE "23" TO OS-RC
        MOVE "PROMISE NOT FOUND" TO OS-MSG
    END-IF.
