IDENTIFICATION DIVISION.
PROGRAM-ID. COLPROM.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "COLSTO".
COPY "COLPQ".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "COLPROM".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-I PIC 9(05).
01 WS-BEFORE PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-ACTION PIC X(16).
01 WS-NEXT PIC X(12).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 BK-COL-CASE.
   COPY "COLC".
01 BK-COL-PROMISE.
   COPY "COLP".

LINKAGE SECTION.
COPY "COLOP".

PROCEDURE DIVISION USING BK-COL-PARMS.
    MOVE "00" TO CO-RC
    MOVE SPACES TO CO-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CO-RC
        MOVE "CONFIG MISSING" TO CO-MSG
        GOBACK
    END-IF
    EVALUATE CO-OP
        WHEN "CREATE" PERFORM DO-CREATE
        WHEN "ACCEPT" PERFORM DO-PROM-ACTION
        WHEN "FULFILL" PERFORM DO-PROM-ACTION
        WHEN "BREAK" PERFORM DO-PROM-ACTION
        WHEN "CANCEL" PERFORM DO-PROM-ACTION
        WHEN "EXPIRE" PERFORM DO-PROM-ACTION
        WHEN OTHER
            MOVE "99" TO CO-RC
            MOVE "UNKNOWN PROMISE OP" TO CO-MSG
    END-EVALUATE
    GOBACK.

DO-CREATE.
    PERFORM LOAD-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CC-STATUS = "CLOS" OR CC-STATUS = "CANC"
        MOVE "20" TO CO-RC
        MOVE "CASE CLOSED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF CO-AMOUNT <= 0
        MOVE "20" TO CO-RC
        MOVE "PROMISE AMOUNT REQUIRED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF CO-PROMISE-DATE = 0
        MOVE "20" TO CO-RC
        MOVE "PROMISE DATE REQUIRED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-PROM-ACTIVE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-ID
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-COL-PROMISE
    MOVE CO-PROMISE-ID TO PM-ID
    MOVE CO-CASE-ID TO PM-CASE-ID
    MOVE CC-CUST-ID TO PM-CUST-ID
    MOVE CC-LOAN-ID TO PM-LOAN-ID
    MOVE "PROPOSED" TO PM-STATUS
    MOVE CC-CURRENCY TO PM-CURRENCY
    MOVE CO-AMOUNT TO PM-AMOUNT
    MOVE 0 TO PM-PAID
    MOVE CO-PROMISE-DATE TO PM-PROMISE-DATE
    MOVE WS-BIZDATE TO PM-CREATED-DATE
    MOVE CO-REASON TO PM-REASON
    MOVE CO-OPERATOR TO PM-OPERATOR
    MOVE WS-BIZDATE TO PM-CREATED
    MOVE WS-BIZDATE TO PM-UPDATED
    MOVE 1 TO PM-VERSION
    MOVE "WRITE" TO OS-OP
    CALL "COLPSTO" USING BK-COL-STO-REQ BK-COL-PROMISE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "PROMISE" TO WS-ACTION
    PERFORM UPDATE-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "CREATE" TO WS-ALABEL
    MOVE SPACES TO WS-BEFORE
    MOVE "PROPOSED" TO WS-NEXT
    CALL "COLAUD" USING BK-COL-PARMS CO-PROMISE-ID WS-ALABEL
        WS-BEFORE WS-NEXT
    MOVE CO-PROMISE-ID TO CO-PROMISE-ID
    MOVE "PROPOSED" TO CO-STATUS
    MOVE "PROMISE CREATED" TO CO-MSG.

DO-PROM-ACTION.
    MOVE CO-OP TO WS-ACTION
    PERFORM LOAD-PROMISE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF WS-ACTION = "FULFILL"
        MOVE "20" TO CO-RC
        MOVE "FULFILLMENT REQUIRES RECOVERY POSTING" TO CO-MSG
        GOBACK
    END-IF
    MOVE PM-STATUS TO WS-BEFORE
    MOVE PM-STATUS TO WS-BEFORE
    CALL "COLPST" USING PM-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE WS-STT-RC TO CO-RC
        MOVE WS-STT-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NEXT TO PM-STATUS
    IF WS-ACTION = "BREAK"
        MOVE WS-BIZDATE TO PM-BROKEN-DATE
        IF CO-REASON NOT = SPACES
            MOVE CO-REASON TO PM-REASON
        END-IF
    END-IF
    PERFORM SAVE-PROMISE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    EVALUATE WS-ACTION
        WHEN "CANCEL" MOVE "PROMISE-DONE" TO WS-ACTION
        WHEN "EXPIRE" MOVE "PROMISE-DONE" TO WS-ACTION
        WHEN "BREAK" MOVE "PROMISE-BROKEN" TO WS-ACTION
        WHEN OTHER MOVE SPACES TO WS-ACTION
    END-EVALUATE
    IF WS-ACTION NOT = SPACES
        PERFORM UPDATE-CASE
    END-IF
    MOVE WS-ACTION TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS PM-ID WS-ALABEL
        WS-BEFORE PM-STATUS
    MOVE PM-STATUS TO CO-STATUS
    MOVE "PROMISE UPDATED" TO CO-MSG.

LOAD-CASE.
    MOVE SPACES TO BK-COL-CASE
    MOVE CO-CASE-ID TO CC-ID
    MOVE "GET" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "CASE NOT FOUND" TO CO-MSG
    END-IF.

LOAD-PROMISE.
    MOVE SPACES TO BK-COL-PROMISE
    MOVE CO-PROMISE-ID TO PM-ID
    MOVE "GET" TO OS-OP
    CALL "COLPSTO" USING BK-COL-STO-REQ BK-COL-PROMISE
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "PROMISE NOT FOUND" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE PM-CASE-ID TO CO-CASE-ID.

UPDATE-CASE.
    MOVE PM-CASE-ID TO CC-ID
    MOVE SPACES TO BK-COL-CASE
    MOVE PM-CASE-ID TO CC-ID
    MOVE "GET" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE "CASE NOT FOUND" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF WS-ACTION = "PROMISE"
        MOVE CO-PROMISE-ID TO CC-PROMISE-ID
    END-IF
    CALL "COLST" USING CC-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE WS-STT-RC TO CO-RC
        MOVE WS-STT-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NEXT TO CC-STATUS
    MOVE WS-BIZDATE TO CC-UPDATED
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
    END-IF.

CHECK-PROM-ACTIVE.
    MOVE CO-CASE-ID TO PL-CASE
    MOVE "LIST" TO PL-OP
    CALL "COLPQ" USING BK-COL-PROMLIST
    IF PL-RC NOT = "00"
        MOVE "36" TO CO-RC
        MOVE "PROMISE LIST UNAVAILABLE" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PL-COUNT
        IF PL-STATUS(WS-I) = "PROPOSED"
            OR PL-STATUS(WS-I) = "ACCEPTED"
            MOVE "22" TO CO-RC
            MOVE "ACTIVE PROMISE EXISTS" TO CO-MSG
        END-IF
    END-PERFORM.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CO-RC
        MOVE "SEQUENCE ERROR" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CO-PROMISE-ID
    STRING "M" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CO-PROMISE-ID
    END-STRING.

SAVE-PROMISE.
    MOVE WS-BIZDATE TO PM-UPDATED
    ADD 1 TO PM-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLPSTO" USING BK-COL-STO-REQ BK-COL-PROMISE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
    END-IF.
