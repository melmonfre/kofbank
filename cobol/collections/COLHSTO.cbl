IDENTIFICATION DIVISION.
PROGRAM-ID. COLHSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT HND-FILE ASSIGN TO WS-HND-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS HD-ID
        FILE STATUS IS WS-HND-ST.

DATA DIVISION.
FILE SECTION.
FD HND-FILE.
01 HND-REC.
   COPY "COLH".

WORKING-STORAGE SECTION.
01 WS-HND-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-HND-ST PIC X(02).

LINKAGE SECTION.
COPY "COLSTO".
01 BK-COL-HANDOFF.
   COPY "COLH".

PROCEDURE DIVISION USING BK-COL-STO-REQ BK-COL-HANDOFF.
    MOVE "00" TO OS-RC
    MOVE SPACES TO OS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-HND-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/colhand.idx"
        DELIMITED SIZE INTO WS-HND-PATH
    PERFORM OPEN-STORE
    IF OS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE OS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO OS-RC
            MOVE "UNKNOWN HANDOFF STORE OP" TO OS-MSG
    END-EVALUATE
    CLOSE HND-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O HND-FILE
    IF WS-HND-ST = "35"
        OPEN OUTPUT HND-FILE
        CLOSE HND-FILE
        OPEN I-O HND-FILE
    END-IF
    IF WS-HND-ST NOT = "00"
        MOVE WS-HND-ST TO OS-RC
        MOVE "CANNOT OPEN HANDOFF INDEX" TO OS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-COL-HANDOFF TO HND-REC
    WRITE HND-REC
        INVALID KEY
            MOVE "22" TO OS-RC
            MOVE "HANDOFF ALREADY EXISTS" TO OS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE HD-ID OF BK-COL-HANDOFF TO HD-ID OF HND-REC
    READ HND-FILE
    IF WS-HND-ST = "00"
        MOVE BK-COL-HANDOFF TO HND-REC
        REWRITE HND-REC
    ELSE
        MOVE "23" TO OS-RC
        MOVE "HANDOFF NOT FOUND" TO OS-MSG
    END-IF.

DO-GET.
    MOVE HD-ID OF BK-COL-HANDOFF TO HD-ID OF HND-REC
    READ HND-FILE
    IF WS-HND-ST = "00"
        MOVE HND-REC TO BK-COL-HANDOFF
        MOVE "00" TO OS-RC
    ELSE
        MOVE "23" TO OS-RC
        MOVE "HANDOFF NOT FOUND" TO OS-MSG
    END-IF.
