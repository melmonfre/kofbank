IDENTIFICATION DIVISION.
PROGRAM-ID. COLCFG.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CFG-FILE ASSIGN TO WS-CFG-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-CFG-ST.

DATA DIVISION.
FILE SECTION.
FD CFG-FILE.
01 CFG-LINE PIC X(200).

WORKING-STORAGE SECTION.
01 WS-CFG-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CFG-ST PIC X(02).
01 WS-KEY PIC X(40).
01 WS-VAL PIC X(40).
01 WS-EOF PIC X(01).

LINKAGE SECTION.
COPY "COLCFGP".

PROCEDURE DIVISION USING BK-COL-CFG.
    MOVE 1 TO KF-ELIG-DAYS
    MOVE 1 TO KF-DELINQ-DAYS
    MOVE 30 TO KF-STD-DAYS
    MOVE 90 TO KF-INT-DAYS
    MOVE 180 TO KF-FIN-DAYS
    MOVE 30 TO KF-EXP-DAYS
    MOVE 100 TO KF-PRIORITY-BASE
    MOVE 10 TO KF-PRIORITY-STEP
    MOVE "00" TO KF-STATUS
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CFG-PATH
    STRING FUNCTION TRIM(WS-HOME) "/etc/collections.cfg"
        DELIMITED SIZE INTO WS-CFG-PATH
    OPEN INPUT CFG-FILE
    IF WS-CFG-ST NOT = "00"
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CFG-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM PARSE-LINE
        END-READ
    END-PERFORM
    CLOSE CFG-FILE
    GOBACK.

PARSE-LINE.
    IF CFG-LINE(1:1) = "#" OR CFG-LINE = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-KEY
    MOVE SPACES TO WS-VAL
    UNSTRING CFG-LINE DELIMITED BY "="
        INTO WS-KEY WS-VAL
    END-UNSTRING
    EVALUATE FUNCTION TRIM(WS-KEY)
        WHEN "eligibility-days"
            MOVE WS-VAL TO KF-ELIG-DAYS
        WHEN "delinquency-days"
            MOVE WS-VAL TO KF-DELINQ-DAYS
        WHEN "stage-standard-days"
            MOVE WS-VAL TO KF-STD-DAYS
        WHEN "stage-intensive-days"
            MOVE WS-VAL TO KF-INT-DAYS
        WHEN "stage-final-days"
            MOVE WS-VAL TO KF-FIN-DAYS
        WHEN "promise-expire-days"
            MOVE WS-VAL TO KF-EXP-DAYS
        WHEN "priority-base"
            MOVE WS-VAL TO KF-PRIORITY-BASE
        WHEN "priority-step"
            MOVE WS-VAL TO KF-PRIORITY-STEP
        WHEN OTHER
            CONTINUE
    END-EVALUATE.
