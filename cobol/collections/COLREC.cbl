IDENTIFICATION DIVISION.
PROGRAM-ID. COLREC.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "COLSTO".
COPY "BLNSTO".
COPY "BLNOP".
COPY "COLPQ".
COPY "BKIDMP".
01 WS-HOME PIC X(80).
01 WS-REQ PIC X(24).
01 WS-HIT PIC X(01).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "COLREC".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-ACTION PIC X(16).
01 WS-NEXT PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-BEFORE PIC X(12).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 WS-CAPPED PIC S9(15)V99 COMP-3.
01 WS-REMAIN PIC S9(15)V99 COMP-3.
01 WS-I PIC 9(05).
01 BK-COL-CASE.
   COPY "COLC".
01 BK-COL-RECOVERY.
   COPY "COLRC".

LINKAGE SECTION.
COPY "COLOP".

PROCEDURE DIVISION USING BK-COL-PARMS.
    MOVE "00" TO CO-RC
    MOVE SPACES TO CO-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CO-RC
        MOVE "CONFIG MISSING" TO CO-MSG
        GOBACK
    END-IF
    IF CO-OP NOT = "RECOVER"
        MOVE "99" TO CO-RC
        MOVE "UNKNOWN RECOVERY OP" TO CO-MSG
        GOBACK
    END-IF
    PERFORM BEGIN-RECOVER
    IF WS-HIT = "Y"
        GOBACK
    END-IF
    IF CO-RC NOT = "00"
        PERFORM END-RECOVER
        GOBACK
    END-IF
    PERFORM DO-RECOVER
    PERFORM END-RECOVER
    GOBACK.

BEGIN-RECOVER.
    MOVE "N" TO WS-HIT
    IF CO-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE CO-REQUEST TO BK-IDM-TXN-ID
    MOVE "COLLECTION.RECOVERY" TO BK-IDM-OPERATION
    MOVE "B" TO BK-IDM-MODE
    MOVE SPACES TO BK-IDM-RESULT
    CALL "BIDM" USING BK-IDM-PARMS
    IF BK-IDM-STATUS = "22"
        MOVE "G" TO BK-IDM-MODE
        CALL "BIDM" USING BK-IDM-PARMS
        EVALUATE BK-IDM-STATUS
            WHEN "C"
                MOVE BK-IDM-RESULT(1:12) TO CO-RECOVERY-ID
                MOVE BK-IDM-RESULT(13:12) TO CO-TXN-ID
                MOVE "00" TO CO-RC
                MOVE "RECOVERY REPLAY" TO CO-MSG
                MOVE "Y" TO WS-HIT
            WHEN "F"
                CONTINUE
            WHEN OTHER
                MOVE "24" TO CO-RC
                MOVE "REQUEST IN PROGRESS" TO CO-MSG
                MOVE "Y" TO WS-HIT
        END-EVALUATE
    ELSE
        IF BK-IDM-STATUS NOT = "00"
            MOVE BK-IDM-STATUS TO CO-RC
            MOVE "IDEMPOTENCY STORE ERROR" TO CO-MSG
        END-IF
    END-IF.

END-RECOVER.
    IF CO-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE CO-REQUEST TO BK-IDM-TXN-ID
    MOVE SPACES TO BK-IDM-RESULT
    IF CO-RC = "00"
        MOVE CO-RECOVERY-ID TO BK-IDM-RESULT(1:12)
        MOVE CO-TXN-ID TO BK-IDM-RESULT(13:12)
        MOVE "C" TO BK-IDM-MODE
    ELSE
        MOVE CO-MSG TO BK-IDM-RESULT
        MOVE "F" TO BK-IDM-MODE
    END-IF
    CALL "BIDM" USING BK-IDM-PARMS.

DO-RECOVER.
    PERFORM LOAD-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CC-STATUS = "CLOS" OR CC-STATUS = "CANC" OR CC-STATUS = "REC"
        OR CC-STATUS = "FAIL"
        MOVE "20" TO CO-RC
        MOVE "CASE NOT RECOVERABLE" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF CO-AMOUNT <= 0
        MOVE "20" TO CO-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM CALL-REPAY
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM RECORD-RECOVERY
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    CALL "COLRECU" USING BK-COL-PARMS BK-COL-CASE WS-CAPPED
    PERFORM APPLY-TO-CASE
    MOVE "RECOVER" TO WS-ALABEL
    MOVE SPACES TO WS-BEFORE
    CALL "COLAUD" USING BK-COL-PARMS CO-RECOVERY-ID WS-ALABEL
        WS-BEFORE RV-STATUS
    MOVE CC-STATUS TO CO-STATUS
    MOVE CC-RECOVERED-AMT TO CO-RECOVERED-AMT
    MOVE CC-OVERDUE-AMT TO CO-REMAINING
    MOVE "RECOVERY POSTED" TO CO-MSG.

CALL-REPAY.
    MOVE CC-LOAN-ID TO CL-LOAN-ID
    MOVE CO-AMOUNT TO CL-AMOUNT
    MOVE CO-OPERATOR TO CL-OPERATOR
    MOVE CO-CORR TO CL-CORR
    MOVE SPACES TO CL-REQUEST
    IF CO-REQUEST NOT = SPACES
        MOVE SPACES TO WS-REQ
        STRING "CR" DELIMITED SIZE FUNCTION TRIM(CO-REQUEST)
            DELIMITED SIZE INTO WS-REQ
        END-STRING
        MOVE WS-REQ TO CL-REQUEST
    END-IF
    CALL "BLRPAY" USING BK-LN-PARMS
    IF CL-RC NOT = "00"
        MOVE CL-RC TO CO-RC
        MOVE CL-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CL-TXN-ID TO CO-TXN-ID
    MOVE CL-PRINCIPAL TO CO-PRINCIPAL
    MOVE CL-INTEREST TO CO-INTEREST
    MOVE CL-FEES TO CO-FEES
    MOVE CL-EXCESS TO CO-EXCESS
    IF CO-AMOUNT > CC-OVERDUE-AMT
        MOVE CC-OVERDUE-AMT TO WS-CAPPED
        COMPUTE CO-EXCESS = CO-AMOUNT - CC-OVERDUE-AMT
    ELSE
        MOVE CO-AMOUNT TO WS-CAPPED
        MOVE 0 TO CO-EXCESS
    END-IF.

RECORD-RECOVERY.
    PERFORM BUILD-ID
    MOVE SPACES TO BK-COL-RECOVERY
    MOVE CO-RECOVERY-ID TO RV-ID
    MOVE CC-ID TO RV-CASE-ID
    MOVE CC-LOAN-ID TO RV-LOAN-ID
    MOVE CO-TXN-ID TO RV-TXN-ID
    MOVE "POSTED" TO RV-STATUS
    MOVE CC-CURRENCY TO RV-CURRENCY
    MOVE CO-AMOUNT TO RV-AMOUNT
    MOVE WS-CAPPED TO RV-APPLIED
    MOVE CO-PRINCIPAL TO RV-PRINCIPAL
    MOVE CO-INTEREST TO RV-INTEREST
    MOVE CO-FEES TO RV-FEES
    MOVE WS-BIZDATE TO RV-DATE
    MOVE CO-EXCESS TO RV-EXCESS
    MOVE CO-REASON TO RV-REASON
    MOVE CO-OPERATOR TO RV-OPERATOR
    MOVE WS-BIZDATE TO RV-CREATED
    MOVE WS-BIZDATE TO RV-UPDATED
    MOVE 1 TO RV-VERSION
    MOVE CL-PLAN-N TO RV-PLAN-N
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > CL-PLAN-N
        MOVE CL-P-INST(WS-I) TO RV-P-INST(WS-I)
        MOVE CL-P-FEE(WS-I) TO RV-P-FEE(WS-I)
        MOVE CL-P-INT(WS-I) TO RV-P-INT(WS-I)
        MOVE CL-P-PRIN(WS-I) TO RV-P-PRIN(WS-I)
    END-PERFORM
    MOVE "WRITE" TO OS-OP
    CALL "COLRSTO" USING BK-COL-STO-REQ BK-COL-RECOVERY
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
    END-IF.

APPLY-TO-CASE.
    ADD WS-CAPPED TO CC-RECOVERED-AMT
    COMPUTE WS-REMAIN = CC-OVERDUE-AMT - WS-CAPPED
    IF WS-REMAIN <= 0
        MOVE 0 TO CC-OVERDUE-AMT
        MOVE "RECOVER-FULL" TO WS-ACTION
    ELSE
        MOVE WS-REMAIN TO CC-OVERDUE-AMT
        MOVE "RECOVER-PART" TO WS-ACTION
    END-IF
    CALL "COLST" USING CC-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC = "00"
        MOVE WS-NEXT TO CC-STATUS
    END-IF
    MOVE WS-BIZDATE TO CC-UPDATED
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
    END-IF.

LOAD-CASE.
    MOVE SPACES TO BK-COL-CASE
    MOVE CO-CASE-ID TO CC-ID
    MOVE "GET" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "CASE NOT FOUND" TO CO-MSG
    END-IF.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CO-RC
        MOVE "SEQUENCE ERROR" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CO-RECOVERY-ID
    STRING "R" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CO-RECOVERY-ID
    END-STRING.
