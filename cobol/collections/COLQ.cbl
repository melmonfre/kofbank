IDENTIFICATION DIVISION.
PROGRAM-ID. COLQ.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CASE-FILE ASSIGN TO WS-CASE-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CC-ID
        FILE STATUS IS WS-CASE-ST.

DATA DIVISION.
FILE SECTION.
FD CASE-FILE.
01 CASE-REC.
   COPY "COLC".

WORKING-STORAGE SECTION.
01 WS-CASE-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CASE-ST PIC X(02).
01 WS-EOF PIC X(01).

LINKAGE SECTION.
COPY "COLQ".

PROCEDURE DIVISION USING BK-COL-LIST.
    MOVE "00" TO OL-RC
    MOVE SPACES TO OL-MSG
    MOVE 0 TO OL-COUNT
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CASE-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/colcase.idx"
        DELIMITED SIZE INTO WS-CASE-PATH
    OPEN INPUT CASE-FILE
    IF WS-CASE-ST = "35"
        GOBACK
    END-IF
    IF WS-CASE-ST NOT = "00"
        MOVE "35" TO OL-RC
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CASE-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF OL-COUNT >= 300
                    MOVE "37" TO OL-RC
                    MOVE "CASE LIST LIMIT EXCEEDED" TO OL-MSG
                    MOVE "Y" TO WS-EOF
                ELSE
                    ADD 1 TO OL-COUNT
                    MOVE CC-ID OF CASE-REC TO OL-CASE(OL-COUNT)
                    MOVE CC-LOAN-ID OF CASE-REC TO OL-LOAN(OL-COUNT)
                    MOVE CC-STATUS OF CASE-REC
                        TO OL-STATUS(OL-COUNT)
                END-IF
        END-READ
    END-PERFORM
    CLOSE CASE-FILE
    GOBACK.
