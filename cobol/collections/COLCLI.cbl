IDENTIFICATION DIVISION.
PROGRAM-ID. COLCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(24).
01 WS-A PIC X(24).
01 WS-B PIC X(24).
01 WS-C PIC X(24).
01 WS-D PIC X(24).
01 WS-E PIC X(24).
01 WS-F PIC X(24).
01 WS-G PIC X(24).
01 WS-H PIC X(24).
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT2 PIC S9(15)V99 COMP-3.
01 WS-NUM PIC 9(04).
01 WS-DATE PIC 9(08).
01 WS-QOP PIC X(08).
01 WS-QRC PIC X(02).
01 WS-LKIND PIC X(12).
01 WS-SHKIND PIC X(08).
COPY "COLOP".

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "case.create" PERFORM DO-CASE-CREATE
        WHEN "case.get" PERFORM DO-CASE-GET
        WHEN "case.list" PERFORM DO-CASE-LIST
        WHEN "case.eligible" PERFORM DO-ELIGIBLE
        WHEN "case.snapshot" PERFORM DO-SNAPSHOT
        WHEN "case.activate" PERFORM DO-CASE-ACTION
        WHEN "case.escalate" PERFORM DO-CASE-ACTION
        WHEN "case.close" PERFORM DO-CASE-ACTION
        WHEN "case.cancel" PERFORM DO-CASE-ACTION
        WHEN "case.fail" PERFORM DO-CASE-ACTION
        WHEN "case.reopen" PERFORM DO-CASE-ACTION
        WHEN "case.stage" PERFORM DO-STAGE
        WHEN "action.create" PERFORM DO-ACT-CREATE
        WHEN "action.execute" PERFORM DO-ACT-ACTION
        WHEN "action.cancel" PERFORM DO-ACT-ACTION
        WHEN "action.expire" PERFORM DO-ACT-ACTION
        WHEN "action.fail" PERFORM DO-ACT-ACTION
        WHEN "action.list" PERFORM DO-ACT-LIST
        WHEN "promise.create" PERFORM DO-PROM-CREATE
        WHEN "promise.accept" PERFORM DO-PROM-ACTION
        WHEN "promise.fulfill" PERFORM DO-PROM-ACTION
        WHEN "promise.break" PERFORM DO-PROM-ACTION
        WHEN "promise.cancel" PERFORM DO-PROM-ACTION
        WHEN "promise.expire" PERFORM DO-PROM-ACTION
        WHEN "promise.list" PERFORM DO-PROM-LIST
        WHEN "arrange.create" PERFORM DO-ARR-CREATE
        WHEN "arrange.activate" PERFORM DO-ARR-ACTION
        WHEN "arrange.cancel" PERFORM DO-ARR-ACTION
        WHEN "arrange.break" PERFORM DO-ARR-ACTION
        WHEN "arrange.expire" PERFORM DO-ARR-ACTION
        WHEN "arrange.list" PERFORM DO-ARR-LIST
        WHEN "recovery.post" PERFORM DO-RECOVER
        WHEN "recovery.reverse" PERFORM DO-RECOVER-REV
        WHEN "recovery.list" PERFORM DO-REC-LIST
        WHEN "handoff.create" PERFORM DO-HND-CREATE
        WHEN "handoff.ack" PERFORM DO-HND-ACTION
        WHEN "handoff.return" PERFORM DO-HND-ACTION
        WHEN "handoff.close" PERFORM DO-HND-ACTION
        WHEN "handoff.cancel" PERFORM DO-HND-ACTION
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN COLLECTION OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H
    END-UNSTRING.

DO-CASE-CREATE.
    MOVE WS-A TO CO-LOAN-ID
    MOVE WS-B TO CO-REASON
    MOVE WS-C TO CO-OPERATOR
    MOVE WS-D TO CO-CORR
    MOVE WS-E TO CO-REQUEST
    MOVE "CREATE" TO CO-OP
    CALL "COL" USING BK-COL-PARMS
    PERFORM SHOW-CASE.

DO-CASE-GET.
    MOVE WS-A TO CO-CASE-ID
    MOVE "GET" TO CO-OP
    CALL "COL" USING BK-COL-PARMS
    PERFORM SHOW-CASE.

DO-CASE-LIST.
    MOVE "CASE" TO WS-LKIND
    MOVE SPACES TO CO-CASE-ID
    CALL "COLCLIQ" USING WS-LKIND CO-CASE-ID.

DO-ACT-LIST.
    MOVE "ACTION" TO WS-LKIND
    MOVE WS-A TO CO-CASE-ID
    CALL "COLCLIQ" USING WS-LKIND CO-CASE-ID.

DO-PROM-LIST.
    MOVE "PROMISE" TO WS-LKIND
    MOVE WS-A TO CO-CASE-ID
    CALL "COLCLIQ" USING WS-LKIND CO-CASE-ID.

DO-ARR-LIST.
    MOVE "ARRANGE" TO WS-LKIND
    MOVE WS-A TO CO-CASE-ID
    CALL "COLCLIQ" USING WS-LKIND CO-CASE-ID.

DO-REC-LIST.
    MOVE "RECOVERY" TO WS-LKIND
    MOVE WS-A TO CO-CASE-ID
    CALL "COLCLIQ" USING WS-LKIND CO-CASE-ID.

DO-ELIGIBLE.
    MOVE WS-A TO CO-LOAN-ID
    MOVE "ELIGIBLE" TO CO-OP
    CALL "COL" USING BK-COL-PARMS
    DISPLAY "rc=" CO-RC
    DISPLAY "eligible=" FUNCTION TRIM(CO-STATUS)
    DISPLAY "overdue=" CO-OVERDUE-AMT
    DISPLAY "msg=" FUNCTION TRIM(CO-MSG).

DO-SNAPSHOT.
    MOVE WS-A TO CO-CASE-ID
    MOVE "SNAPSHOT" TO CO-OP
    CALL "COL" USING BK-COL-PARMS
    PERFORM SHOW-CASE.

DO-CASE-ACTION.
    MOVE WS-A TO CO-CASE-ID
    MOVE WS-B TO CO-REASON
    MOVE WS-C TO CO-OPERATOR
    MOVE WS-D TO CO-CORR
    MOVE WS-E TO CO-REQUEST
    MOVE FUNCTION UPPER-CASE(WS-OP(6:12)) TO CO-OP
    CALL "COL" USING BK-COL-PARMS
    PERFORM SHOW-CASE.

DO-STAGE.
    MOVE WS-A TO CO-CASE-ID
    MOVE WS-B TO CO-OPERATOR
    MOVE WS-C TO CO-CORR
    MOVE WS-D TO CO-REQUEST
    MOVE "STAGE" TO CO-OP
    CALL "COL" USING BK-COL-PARMS
    DISPLAY "rc=" CO-RC
    DISPLAY "stage=" FUNCTION TRIM(CO-STAGE)
    DISPLAY "strategy=" FUNCTION TRIM(CO-STRATEGY)
    DISPLAY "priority=" CO-PRIORITY
    DISPLAY "msg=" FUNCTION TRIM(CO-MSG).

DO-ACT-CREATE.
    MOVE WS-A TO CO-CASE-ID
    MOVE WS-B TO CO-ACTION-TYPE
    MOVE WS-C TO CO-REASON
    MOVE WS-D TO CO-OPERATOR
    MOVE WS-E TO CO-CORR
    MOVE WS-F TO CO-REQUEST
    MOVE "CREATE" TO CO-OP
    CALL "COLACT" USING BK-COL-PARMS
    MOVE "ACTION  " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.

DO-ACT-ACTION.
    MOVE WS-A TO CO-ACTION-ID
    MOVE WS-B TO CO-REASON
    MOVE WS-C TO CO-OPERATOR
    MOVE WS-D TO CO-CORR
    MOVE WS-E TO CO-REQUEST
    MOVE FUNCTION UPPER-CASE(WS-OP(8:12)) TO CO-OP
    CALL "COLACT" USING BK-COL-PARMS
    MOVE "ACTION  " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.

DO-PROM-CREATE.
    MOVE WS-A TO CO-CASE-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CO-AMOUNT
    MOVE WS-C TO WS-DATE
    MOVE WS-DATE TO CO-PROMISE-DATE
    MOVE WS-D TO CO-REASON
    MOVE WS-E TO CO-OPERATOR
    MOVE WS-F TO CO-CORR
    MOVE WS-G TO CO-REQUEST
    MOVE "CREATE" TO CO-OP
    CALL "COLPROM" USING BK-COL-PARMS
    MOVE "PROMISE " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.

DO-PROM-ACTION.
    MOVE WS-A TO CO-PROMISE-ID
    MOVE WS-B TO CO-REASON
    MOVE WS-C TO CO-OPERATOR
    MOVE WS-D TO CO-CORR
    MOVE WS-E TO CO-REQUEST
    MOVE FUNCTION UPPER-CASE(WS-OP(9:12)) TO CO-OP
    CALL "COLPROM" USING BK-COL-PARMS
    MOVE "PROMISE " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.

DO-ARR-CREATE.
    MOVE WS-A TO CO-CASE-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CO-AMOUNT
    MOVE WS-C TO WS-NUM
    MOVE WS-NUM TO CO-INSTALLMENTS
    MOVE WS-D TO CO-REASON
    MOVE WS-E TO CO-OPERATOR
    MOVE WS-F TO CO-CORR
    MOVE WS-G TO CO-REQUEST
    MOVE "CREATE" TO CO-OP
    CALL "COLARR" USING BK-COL-PARMS
    MOVE "ARRANGE " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.

DO-ARR-ACTION.
    MOVE WS-A TO CO-ARRANGE-ID
    MOVE WS-B TO CO-REASON
    MOVE WS-C TO CO-OPERATOR
    MOVE WS-D TO CO-CORR
    MOVE WS-E TO CO-REQUEST
    MOVE FUNCTION UPPER-CASE(WS-OP(9:12)) TO CO-OP
    CALL "COLARR" USING BK-COL-PARMS
    MOVE "ARRANGE " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.

DO-RECOVER.
    MOVE WS-A TO CO-CASE-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CO-AMOUNT
    MOVE WS-C TO CO-REASON
    MOVE WS-D TO CO-OPERATOR
    MOVE WS-E TO CO-CORR
    MOVE WS-F TO CO-REQUEST
    MOVE "RECOVER" TO CO-OP
    CALL "COLREC" USING BK-COL-PARMS
    MOVE "RECOVER " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.

DO-RECOVER-REV.
    MOVE WS-A TO CO-RECOVERY-ID
    MOVE WS-B TO CO-OPERATOR
    MOVE WS-C TO CO-CORR
    MOVE WS-D TO CO-REQUEST
    MOVE "REVERSE" TO CO-OP
    CALL "COLRV" USING BK-COL-PARMS
    MOVE "RECOVER " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.

DO-HND-CREATE.
    MOVE WS-A TO CO-CASE-ID
    MOVE WS-B TO CO-REF
    MOVE WS-C TO CO-PROVIDER
    MOVE WS-D TO CO-REASON
    MOVE WS-E TO CO-OPERATOR
    MOVE WS-F TO CO-CORR
    MOVE WS-G TO CO-REQUEST
    MOVE "CREATE" TO CO-OP
    CALL "COLHND" USING BK-COL-PARMS
    MOVE "HANDOFF " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.

DO-HND-ACTION.
    MOVE WS-A TO CO-HANDOFF-ID
    MOVE WS-B TO CO-PROVIDER
    MOVE WS-C TO CO-REF
    MOVE WS-D TO CO-REASON
    MOVE WS-E TO CO-OPERATOR
    MOVE WS-F TO CO-CORR
    MOVE WS-G TO CO-REQUEST
    MOVE FUNCTION UPPER-CASE(WS-OP(9:12)) TO CO-OP
    CALL "COLHND" USING BK-COL-PARMS
    MOVE "HANDOFF " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.

SHOW-CASE.
    MOVE "CASE    " TO WS-SHKIND
    CALL "COLSHW" USING BK-COL-PARMS WS-SHKIND.
