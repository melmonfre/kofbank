IDENTIFICATION DIVISION.
PROGRAM-ID. COLSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CASE-FILE ASSIGN TO WS-CASE-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CC-ID
        FILE STATUS IS WS-CASE-ST.

DATA DIVISION.
FILE SECTION.
FD CASE-FILE.
01 CASE-REC.
   COPY "COLC".

WORKING-STORAGE SECTION.
01 WS-CASE-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CASE-ST PIC X(02).

LINKAGE SECTION.
COPY "COLSTO".
01 BK-COL-CASE.
   COPY "COLC".

PROCEDURE DIVISION USING BK-COL-STO-REQ BK-COL-CASE.
    MOVE "00" TO OS-RC
    MOVE SPACES TO OS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CASE-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/colcase.idx"
        DELIMITED SIZE INTO WS-CASE-PATH
    PERFORM OPEN-STORE
    IF OS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE OS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO OS-RC
            MOVE "UNKNOWN CASE STORE OP" TO OS-MSG
    END-EVALUATE
    CLOSE CASE-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O CASE-FILE
    IF WS-CASE-ST = "35"
        OPEN OUTPUT CASE-FILE
        CLOSE CASE-FILE
        OPEN I-O CASE-FILE
    END-IF
    IF WS-CASE-ST NOT = "00"
        MOVE WS-CASE-ST TO OS-RC
        MOVE "CANNOT OPEN CASE INDEX" TO OS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-COL-CASE TO CASE-REC
    WRITE CASE-REC
        INVALID KEY
            MOVE "22" TO OS-RC
            MOVE "CASE ALREADY EXISTS" TO OS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE CC-ID OF BK-COL-CASE TO CC-ID OF CASE-REC
    READ CASE-FILE
    IF WS-CASE-ST = "00"
        MOVE BK-COL-CASE TO CASE-REC
        REWRITE CASE-REC
    ELSE
        MOVE "23" TO OS-RC
        MOVE "CASE NOT FOUND" TO OS-MSG
    END-IF.

DO-GET.
    MOVE CC-ID OF BK-COL-CASE TO CC-ID OF CASE-REC
    READ CASE-FILE
    IF WS-CASE-ST = "00"
        MOVE CASE-REC TO BK-COL-CASE
        MOVE "00" TO OS-RC
    ELSE
        MOVE "23" TO OS-RC
        MOVE "CASE NOT FOUND" TO OS-MSG
    END-IF.
