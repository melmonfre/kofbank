IDENTIFICATION DIVISION.
PROGRAM-ID. COLHND.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "COLSTO".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "COLHND".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-ACTION PIC X(16).
01 WS-NEXT PIC X(12).
01 WS-BEFORE PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 BK-COL-CASE.
   COPY "COLC".
01 BK-COL-HANDOFF.
   COPY "COLH".

LINKAGE SECTION.
COPY "COLOP".

PROCEDURE DIVISION USING BK-COL-PARMS.
    MOVE "00" TO CO-RC
    MOVE SPACES TO CO-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CO-RC
        MOVE "CONFIG MISSING" TO CO-MSG
        GOBACK
    END-IF
    EVALUATE CO-OP
        WHEN "CREATE" PERFORM DO-CREATE
        WHEN "ACK" PERFORM DO-HND-ACTION
        WHEN "RETURN" PERFORM DO-HND-ACTION
        WHEN "CLOSE" PERFORM DO-HND-ACTION
        WHEN "CANCEL" PERFORM DO-HND-ACTION
        WHEN OTHER
            MOVE "99" TO CO-RC
            MOVE "UNKNOWN HANDOFF OP" TO CO-MSG
    END-EVALUATE
    GOBACK.

DO-CREATE.
    IF CO-REF NOT = "EXTERNAL" AND CO-REF NOT = "LEGAL"
        MOVE "20" TO CO-RC
        MOVE "HANDOFF KIND REQUIRED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM LOAD-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CC-STATUS = "CLOS" OR CC-STATUS = "CANC"
        MOVE "20" TO CO-RC
        MOVE "CASE CLOSED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF CO-REF = "EXTERNAL"
        IF CC-EXTERNAL-REF NOT = SPACES
            MOVE "22" TO CO-RC
            MOVE "EXTERNAL HANDOFF EXISTS" TO CO-MSG
            EXIT PARAGRAPH
        END-IF
    ELSE
        IF CC-LEGAL-REF NOT = SPACES
            MOVE "22" TO CO-RC
            MOVE "LEGAL HANDOFF EXISTS" TO CO-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    PERFORM BUILD-ID
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-COL-HANDOFF
    MOVE CO-HANDOFF-ID TO HD-ID
    MOVE CO-CASE-ID TO HD-CASE-ID
    MOVE CO-REF TO HD-KIND
    MOVE "REQUESTED" TO HD-STATUS
    MOVE CO-PROVIDER TO HD-PROVIDER
    MOVE CC-OVERDUE-AMT TO HD-AMOUNT
    MOVE CO-REASON TO HD-REASON
    MOVE WS-BIZDATE TO HD-REQUESTED
    MOVE CO-OPERATOR TO HD-OPERATOR
    MOVE WS-BIZDATE TO HD-CREATED
    MOVE WS-BIZDATE TO HD-UPDATED
    MOVE 1 TO HD-VERSION
    MOVE "WRITE" TO OS-OP
    CALL "COLHSTO" USING BK-COL-STO-REQ BK-COL-HANDOFF
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF CO-REF = "EXTERNAL"
        MOVE CO-HANDOFF-ID TO CC-EXTERNAL-REF
    ELSE
        MOVE CO-HANDOFF-ID TO CC-LEGAL-REF
    END-IF
    MOVE CO-HANDOFF-ID TO CC-HANDOFF-ID
    MOVE "ESCALATE" TO WS-ACTION
    PERFORM UPDATE-CASE
    MOVE "CREATE" TO WS-ALABEL
    MOVE SPACES TO WS-BEFORE
    MOVE "REQUESTED" TO WS-NEXT
    CALL "COLAUD" USING BK-COL-PARMS CO-HANDOFF-ID WS-ALABEL
        WS-BEFORE WS-NEXT
    MOVE CO-HANDOFF-ID TO CO-HANDOFF-ID
    MOVE "REQUESTED" TO CO-STATUS
    MOVE "HANDOFF CREATED" TO CO-MSG.

DO-HND-ACTION.
    MOVE SPACES TO BK-COL-HANDOFF
    MOVE CO-HANDOFF-ID TO HD-ID
    MOVE "GET" TO OS-OP
    CALL "COLHSTO" USING BK-COL-STO-REQ BK-COL-HANDOFF
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "HANDOFF NOT FOUND" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF HD-STATUS = "CLOSED" OR HD-STATUS = "CANCELLED"
        MOVE "20" TO CO-RC
        MOVE "HANDOFF CLOSED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE HD-STATUS TO WS-BEFORE
    EVALUATE CO-OP
        WHEN "ACK"
            IF HD-STATUS NOT = "REQUESTED"
                PERFORM SET-HND-INVALID
                EXIT PARAGRAPH
            END-IF
            MOVE "ASSIGNED" TO HD-STATUS
            IF CO-PROVIDER NOT = SPACES
                MOVE CO-PROVIDER TO HD-PROVIDER
            END-IF
            IF CO-REF NOT = SPACES
                MOVE CO-REF TO HD-REF
            END-IF
        WHEN "RETURN"
            IF HD-STATUS NOT = "REQUESTED"
                AND HD-STATUS NOT = "ASSIGNED"
                PERFORM SET-HND-INVALID
                EXIT PARAGRAPH
            END-IF
            MOVE "RETURNED" TO HD-STATUS
        WHEN "CLOSE"
            IF HD-STATUS NOT = "RETURNED"
                PERFORM SET-HND-INVALID
                EXIT PARAGRAPH
            END-IF
            MOVE "CLOSED" TO HD-STATUS
        WHEN "CANCEL"
            MOVE "CANCELLED" TO HD-STATUS
    END-EVALUATE
    MOVE WS-BIZDATE TO HD-RETURNED
    IF CO-REASON NOT = SPACES
        MOVE CO-REASON TO HD-RESULT
    END-IF
    MOVE WS-BIZDATE TO HD-UPDATED
    ADD 1 TO HD-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLHSTO" USING BK-COL-STO-REQ BK-COL-HANDOFF
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CO-OP TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS HD-ID WS-ALABEL
        WS-BEFORE HD-STATUS
    MOVE HD-STATUS TO CO-STATUS
    MOVE "HANDOFF UPDATED" TO CO-MSG.

SET-HND-INVALID.
    MOVE "20" TO CO-RC
    MOVE "INVALID HANDOFF TRANSITION" TO CO-MSG.

LOAD-CASE.
    MOVE SPACES TO BK-COL-CASE
    MOVE CO-CASE-ID TO CC-ID
    MOVE "GET" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "CASE NOT FOUND" TO CO-MSG
    END-IF.

UPDATE-CASE.
    MOVE SPACES TO BK-COL-CASE
    MOVE CO-CASE-ID TO CC-ID
    MOVE "GET" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE "CASE NOT FOUND" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CC-STATUS TO WS-BEFORE
    IF CO-REF = "EXTERNAL"
        MOVE CO-HANDOFF-ID TO CC-EXTERNAL-REF
    ELSE
        MOVE CO-HANDOFF-ID TO CC-LEGAL-REF
    END-IF
    MOVE CO-HANDOFF-ID TO CC-HANDOFF-ID
    CALL "COLST" USING CC-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE WS-STT-RC TO CO-RC
        MOVE WS-STT-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NEXT TO CC-STATUS
    MOVE WS-BIZDATE TO CC-UPDATED
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "ESCALATE" TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS CC-ID WS-ALABEL
        WS-BEFORE CC-STATUS.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CO-RC
        MOVE "SEQUENCE ERROR" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CO-HANDOFF-ID
    STRING "H" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CO-HANDOFF-ID
    END-STRING.
