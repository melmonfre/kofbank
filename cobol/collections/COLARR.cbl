IDENTIFICATION DIVISION.
PROGRAM-ID. COLARR.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "COLSTO".
COPY "BDATP".
COPY "COLGQ".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "COLARR".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-ACTION PIC X(16).
01 WS-NEXT PIC X(12).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 WS-MONTHS PIC S9(05).
01 WS-BEFORE PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-I PIC 9(05).
01 BK-COL-CASE.
   COPY "COLC".
01 BK-COL-ARRANGE.
   COPY "COLAG".

LINKAGE SECTION.
COPY "COLOP".

PROCEDURE DIVISION USING BK-COL-PARMS.
    MOVE "00" TO CO-RC
    MOVE SPACES TO CO-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CO-RC
        MOVE "CONFIG MISSING" TO CO-MSG
        GOBACK
    END-IF
    EVALUATE CO-OP
        WHEN "CREATE" PERFORM DO-CREATE
        WHEN "ACTIVATE" PERFORM DO-ARR-ACTION
        WHEN "CANCEL" PERFORM DO-ARR-ACTION
        WHEN "BREAK" PERFORM DO-ARR-ACTION
        WHEN "EXPIRE" PERFORM DO-ARR-ACTION
        WHEN OTHER
            MOVE "99" TO CO-RC
            MOVE "UNKNOWN ARRANGEMENT OP" TO CO-MSG
    END-EVALUATE
    GOBACK.

DO-CREATE.
    PERFORM LOAD-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CC-STATUS = "CLOS" OR CC-STATUS = "CANC"
        MOVE "20" TO CO-RC
        MOVE "CASE CLOSED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF CO-AMOUNT <= 0
        MOVE "20" TO CO-RC
        MOVE "ARRANGEMENT TOTAL REQUIRED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF CO-INSTALLMENTS = 0
        MOVE "20" TO CO-RC
        MOVE "INSTALLMENTS REQUIRED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-ARR-ACTIVE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-ID
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-COL-ARRANGE
    MOVE CO-ARRANGE-ID TO AG-ID
    MOVE CO-CASE-ID TO AG-CASE-ID
    MOVE CC-CUST-ID TO AG-CUST-ID
    MOVE CC-LOAN-ID TO AG-LOAN-ID
    MOVE "PROPOSED" TO AG-STATUS
    MOVE CC-CURRENCY TO AG-CURRENCY
    MOVE CO-AMOUNT TO AG-TOTAL
    MOVE 0 TO AG-PAID
    MOVE CO-INSTALLMENTS TO AG-INSTALLMENTS
    MOVE 0 TO AG-INST-PAID
    MOVE WS-BIZDATE TO AG-START-DATE
    MOVE WS-BIZDATE TO AG-NEXT-DUE
    MOVE "ADD-MONTHS" TO DAT-OP
    MOVE WS-BIZDATE TO DAT-DATE
    MOVE CO-INSTALLMENTS TO DAT-MONTHS
    CALL "BDAT" USING BK-DAT-PARMS
    MOVE DAT-RESULT TO AG-END-DATE
    MOVE CO-REASON TO AG-REASON
    MOVE CO-OPERATOR TO AG-OPERATOR
    MOVE WS-BIZDATE TO AG-CREATED
    MOVE WS-BIZDATE TO AG-UPDATED
    MOVE 1 TO AG-VERSION
    MOVE "WRITE" TO OS-OP
    CALL "COLGSTO" USING BK-COL-STO-REQ BK-COL-ARRANGE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "ARRANGE" TO WS-ACTION
    PERFORM UPDATE-CASE
    MOVE "CREATE" TO WS-ALABEL
    MOVE SPACES TO WS-BEFORE
    MOVE "PROPOSED" TO WS-NEXT
    CALL "COLAUD" USING BK-COL-PARMS CO-ARRANGE-ID WS-ALABEL
        WS-BEFORE WS-NEXT
    MOVE CO-ARRANGE-ID TO CO-ARRANGE-ID
    MOVE "PROPOSED" TO CO-STATUS
    MOVE "ARRANGEMENT CREATED" TO CO-MSG.

CHECK-ARR-ACTIVE.
    MOVE CO-CASE-ID TO GL-CASE
    MOVE "LIST" TO GL-OP
    CALL "COLGQ" USING BK-COL-ARRLIST
    IF GL-RC NOT = "00"
        MOVE "36" TO CO-RC
        MOVE "ARRANGEMENT LIST UNAVAILABLE" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > GL-COUNT
        IF GL-STATUS(WS-I) = "PROPOSED"
            OR GL-STATUS(WS-I) = "ACTIVE"
            OR GL-STATUS(WS-I) = "PARTIALLY"
            MOVE "22" TO CO-RC
            MOVE "ACTIVE ARRANGEMENT EXISTS" TO CO-MSG
        END-IF
    END-PERFORM.

DO-ARR-ACTION.
    MOVE CO-OP TO WS-ACTION
    MOVE SPACES TO BK-COL-ARRANGE
    MOVE CO-ARRANGE-ID TO AG-ID
    MOVE "GET" TO OS-OP
    CALL "COLGSTO" USING BK-COL-STO-REQ BK-COL-ARRANGE
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "ARRANGEMENT NOT FOUND" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    CALL "COLGST" USING AG-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE WS-STT-RC TO CO-RC
        MOVE WS-STT-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE AG-STATUS TO WS-BEFORE
    MOVE WS-NEXT TO AG-STATUS
    MOVE WS-BIZDATE TO AG-UPDATED
    ADD 1 TO AG-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLGSTO" USING BK-COL-STO-REQ BK-COL-ARRANGE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CO-OP TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS AG-ID WS-ALABEL
        WS-BEFORE AG-STATUS
    MOVE AG-STATUS TO CO-STATUS
    MOVE "ARRANGEMENT UPDATED" TO CO-MSG.

LOAD-CASE.
    MOVE SPACES TO BK-COL-CASE
    MOVE CO-CASE-ID TO CC-ID
    MOVE "GET" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "CASE NOT FOUND" TO CO-MSG
    END-IF.

UPDATE-CASE.
    MOVE SPACES TO BK-COL-CASE
    MOVE CO-CASE-ID TO CC-ID
    MOVE "GET" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE "CASE NOT FOUND" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF WS-ACTION = "ARRANGE"
        MOVE CO-ARRANGE-ID TO CC-ARRANGEMENT-ID
    END-IF
    CALL "COLST" USING CC-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE WS-STT-RC TO CO-RC
        MOVE WS-STT-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NEXT TO CC-STATUS
    MOVE WS-BIZDATE TO CC-UPDATED
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
    END-IF.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CO-RC
        MOVE "SEQUENCE ERROR" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CO-ARRANGE-ID
    STRING "G" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CO-ARRANGE-ID
    END-STRING.
