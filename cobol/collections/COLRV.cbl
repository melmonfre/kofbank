IDENTIFICATION DIVISION.
PROGRAM-ID. COLRV.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "COLSTO".
COPY "BLNOP".
COPY "BCREXP".
COPY "BTXNLFC".
COPY "BTXNRESP".
01 WS-HOME PIC X(80).
01 WS-REV-REQ PIC X(24).
01 WS-I PIC 9(04).
01 WS-ACTION PIC X(16).
01 WS-NEXT PIC X(12).
01 WS-BEFORE PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 BK-COL-CASE.
   COPY "COLC".
01 BK-COL-RECOVERY.
   COPY "COLRC".
01 BK-COL-PROMISE.
   COPY "COLP".
01 BK-COL-ARRANGE.
   COPY "COLAG".

LINKAGE SECTION.
COPY "COLOP".

PROCEDURE DIVISION USING BK-COL-PARMS.
    MOVE "00" TO CO-RC
    MOVE SPACES TO CO-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CO-RC
        MOVE "CONFIG MISSING" TO CO-MSG
        GOBACK
    END-IF
    IF CO-OP = "REVERSE" PERFORM DO-REVERSE
    ELSE
        MOVE "99" TO CO-RC
        MOVE "UNKNOWN RECOVERY REVERSAL OP" TO CO-MSG
    END-IF
    GOBACK.

DO-REVERSE.
    PERFORM LOAD-RECOVERY
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF RV-STATUS NOT = "POSTED"
        MOVE "20" TO CO-RC
        MOVE "RECOVERY NOT POSTED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM LOAD-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM REVERSE-TXN
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM RESTORE-LOAN
    PERFORM RESTORE-EXPOSURE
    MOVE CC-STATUS TO WS-BEFORE
    PERFORM MARK-REVERSED
    MOVE WS-BEFORE TO WS-NEXT
    PERFORM REWIND-PROMISE
    PERFORM REWIND-ARRANGEMENT
    PERFORM REOPEN-CASE
    MOVE "REVERSE" TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS RV-ID WS-ALABEL
        WS-BEFORE RV-STATUS
    IF WS-BEFORE NOT = CC-STATUS
        MOVE "REOPEN" TO WS-ALABEL
        CALL "COLAUD" USING BK-COL-PARMS CC-ID WS-ALABEL
            WS-NEXT CC-STATUS
    END-IF
    MOVE RV-ID TO CO-RECOVERY-ID
    MOVE RV-TXN-ID TO CO-TXN-ID
    MOVE CC-STATUS TO CO-STATUS
    MOVE "RECOVERY REVERSED" TO CO-MSG.

REVERSE-TXN.
    MOVE "REVERSE" TO LFC-OP
    MOVE RV-TXN-ID TO LFC-TXN-ID
    MOVE "COLLECTION RECOVERY REVERSAL" TO LFC-DESCR
    MOVE CO-OPERATOR TO LFC-OPERATOR
    MOVE CO-CORR TO LFC-CORR
    MOVE SPACES TO WS-REV-REQ
    STRING "CV" DELIMITED SIZE CO-REQUEST DELIMITED SIZE
        INTO WS-REV-REQ
    END-STRING
    MOVE WS-REV-REQ TO LFC-REQUEST
    MOVE "RECOVERY REVERSAL" TO LFC-REASON
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    IF TXR-RC NOT = "00"
        MOVE TXR-RC TO CO-RC
        MOVE TXR-MSG TO CO-MSG
    END-IF.

RESTORE-LOAN.
    MOVE RV-LOAN-ID TO CL-LOAN-ID
    MOVE RV-PRINCIPAL TO CL-AMOUNT
    MOVE RV-PLAN-N TO CL-PLAN-N
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > RV-PLAN-N
        MOVE RV-P-INST(WS-I) TO CL-P-INST(WS-I)
        MOVE RV-P-FEE(WS-I) TO CL-P-FEE(WS-I)
        MOVE RV-P-INT(WS-I) TO CL-P-INT(WS-I)
        MOVE RV-P-PRIN(WS-I) TO CL-P-PRIN(WS-I)
    END-PERFORM
    MOVE "REVPAY" TO CL-OP
    CALL "BLNUPD" USING BK-LN-PARMS.

RESTORE-EXPOSURE.
    MOVE "REVPAY" TO CE-OP
    MOVE CC-FAC-ID TO CE-FAC-ID
    MOVE RV-PRINCIPAL TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS.

MARK-REVERSED.
    MOVE "REVERSED" TO RV-STATUS
    MOVE WS-BIZDATE TO RV-UPDATED
    ADD 1 TO RV-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLRSTO" USING BK-COL-STO-REQ BK-COL-RECOVERY
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
    END-IF.

REOPEN-CASE.
    SUBTRACT RV-AMOUNT FROM CC-RECOVERED-AMT
    IF CC-RECOVERED-AMT < 0
        MOVE 0 TO CC-RECOVERED-AMT
    END-IF
    ADD RV-AMOUNT TO CC-OVERDUE-AMT
    MOVE "REOPEN" TO WS-ACTION
    CALL "COLST" USING CC-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC = "00"
        MOVE WS-NEXT TO CC-STATUS
    END-IF
    MOVE WS-BIZDATE TO CC-UPDATED
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
    END-IF.

REWIND-PROMISE.
    IF CC-PROMISE-ID = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-COL-PROMISE
    MOVE CC-PROMISE-ID TO PM-ID
    MOVE "GET" TO OS-OP
    CALL "COLPSTO" USING BK-COL-STO-REQ BK-COL-PROMISE
    IF OS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF PM-TXN-REF NOT = RV-TXN-ID
        EXIT PARAGRAPH
    END-IF
    MOVE PM-STATUS TO WS-BEFORE
    SUBTRACT RV-APPLIED FROM PM-PAID
    IF PM-PAID < 0
        MOVE 0 TO PM-PAID
    END-IF
    IF PM-STATUS = "FULFILLED"
        CALL "COLPST" USING PM-STATUS "REOPEN" WS-NEXT
            WS-STT-RC WS-STT-MSG
        IF WS-STT-RC = "00"
            MOVE WS-NEXT TO PM-STATUS
        END-IF
    END-IF
    MOVE SPACES TO PM-TXN-REF
    MOVE WS-BIZDATE TO PM-UPDATED
    ADD 1 TO PM-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLPSTO" USING BK-COL-STO-REQ BK-COL-PROMISE
    MOVE "REOPEN" TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS PM-ID WS-ALABEL
        WS-BEFORE PM-STATUS.

REWIND-ARRANGEMENT.
    IF CC-ARRANGEMENT-ID = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-COL-ARRANGE
    MOVE CC-ARRANGEMENT-ID TO AG-ID
    MOVE "GET" TO OS-OP
    CALL "COLGSTO" USING BK-COL-STO-REQ BK-COL-ARRANGE
    IF OS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF AG-STATUS NOT = "ACTIVE" AND AG-STATUS NOT = "PARTIALLY"
        AND AG-STATUS NOT = "FULFILLED"
        EXIT PARAGRAPH
    END-IF
    MOVE AG-STATUS TO WS-BEFORE
    SUBTRACT RV-APPLIED FROM AG-PAID
    IF AG-PAID < 0
        MOVE 0 TO AG-PAID
    END-IF
    IF AG-PAID >= AG-TOTAL
        MOVE "FULFILLED" TO AG-STATUS
    ELSE
        IF AG-PAID = 0
            MOVE "ACTIVE" TO AG-STATUS
        ELSE
            MOVE "PARTIALLY" TO AG-STATUS
        END-IF
    END-IF
    MOVE WS-BIZDATE TO AG-UPDATED
    ADD 1 TO AG-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLGSTO" USING BK-COL-STO-REQ BK-COL-ARRANGE
    MOVE "REOPEN" TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS AG-ID WS-ALABEL
        WS-BEFORE AG-STATUS.

LOAD-RECOVERY.
    MOVE SPACES TO BK-COL-RECOVERY
    MOVE CO-RECOVERY-ID TO RV-ID
    MOVE "GET" TO OS-OP
    CALL "COLRSTO" USING BK-COL-STO-REQ BK-COL-RECOVERY
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "RECOVERY NOT FOUND" TO CO-MSG
    END-IF.

LOAD-CASE.
    MOVE SPACES TO BK-COL-CASE
    MOVE RV-CASE-ID TO CC-ID
    MOVE "GET" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "CASE NOT FOUND" TO CO-MSG
    END-IF.
