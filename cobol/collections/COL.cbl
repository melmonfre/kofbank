IDENTIFICATION DIVISION.
PROGRAM-ID. COL.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "COLSTO".
COPY "BLNSTO".
01 WS-HOME PIC X(80).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-ACTION PIC X(16).
01 WS-NEXT PIC X(12).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 WS-BEFORE PIC X(12).
01 WS-ALABEL PIC X(12).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "COLCASE".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-DUP PIC X(01).
01 WS-EVAL-OP PIC X(10).
01 WS-I PIC 9(05).
01 BK-COL-CASE.
   COPY "COLC".
01 BK-LN-REC.
   COPY "BLN".

LINKAGE SECTION.
COPY "COLOP".

PROCEDURE DIVISION USING BK-COL-PARMS.
    MOVE "00" TO CO-RC
    MOVE SPACES TO CO-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CO-RC
        MOVE "CONFIG MISSING" TO CO-MSG
        GOBACK
    END-IF
    EVALUATE CO-OP
        WHEN "CREATE" PERFORM DO-CREATE
        WHEN "GET" PERFORM DO-GET
        WHEN "ELIGIBLE" PERFORM DO-ELIGIBLE
        WHEN "SNAPSHOT" PERFORM DO-SNAPSHOT
        WHEN "ACTIVATE" PERFORM DO-ACTION
        WHEN "ESCALATE" PERFORM DO-ACTION
        WHEN "CLOSE" PERFORM DO-ACTION
        WHEN "CANCEL" PERFORM DO-ACTION
        WHEN "FAIL" PERFORM DO-ACTION
        WHEN "REOPEN" PERFORM DO-ACTION
        WHEN "STAGE" PERFORM DO-STAGE
        WHEN OTHER
            MOVE "99" TO CO-RC
            MOVE "UNKNOWN COLLECTION OP" TO CO-MSG
    END-EVALUATE
    GOBACK.

DO-CREATE.
    PERFORM LOAD-LOAN
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "LOAN" TO WS-EVAL-OP
    CALL "COLEVL" USING BK-COL-PARMS BK-COL-CASE WS-EVAL-OP
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CO-STATUS NOT = "Y"
        MOVE "20" TO CO-RC
        MOVE "NO OVERDUE OBLIGATION" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    CALL "COLDUP" USING BK-COL-PARMS WS-DUP
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF WS-DUP = "Y"
        MOVE "22" TO CO-RC
        MOVE "ACTIVE CASE EXISTS" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-ID
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-COL-CASE
    MOVE CO-CASE-ID TO CC-ID
    MOVE LN-CUST-ID TO CC-CUST-ID
    MOVE LN-ID TO CC-LOAN-ID
    MOVE LN-FAC-ID TO CC-FAC-ID
    MOVE LN-ACCOUNT TO CC-ACCOUNT
    MOVE LN-PRODUCT TO CC-PRODUCT
    MOVE LN-CURRENCY TO CC-CURRENCY
    MOVE "OPEN" TO CC-STATUS
    MOVE "NONE" TO CC-STAGE
    MOVE WS-BIZDATE TO CC-OPEN-DATE
    MOVE WS-BIZDATE TO CC-LAST-ACTION
    MOVE WS-BIZDATE TO CC-NEXT-ACTION
    MOVE 0 TO CC-RECOVERED-AMT
    MOVE CO-REASON TO CC-REASON
    MOVE CO-OPERATOR TO CC-OPERATOR
    MOVE WS-BIZDATE TO CC-CREATED
    MOVE WS-BIZDATE TO CC-UPDATED
    MOVE 1 TO CC-VERSION
    MOVE "POLICY" TO WS-EVAL-OP
    CALL "COLEVL" USING BK-COL-PARMS BK-COL-CASE WS-EVAL-OP
    PERFORM SAVE-NEW
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "CREATE" TO WS-ALABEL
    MOVE SPACES TO WS-BEFORE
    CALL "COLAUD" USING BK-COL-PARMS CC-ID WS-ALABEL
        WS-BEFORE CC-STATUS
    MOVE "OPEN" TO CO-STATUS
    PERFORM SHOW-CASE
    MOVE "CASE OPENED" TO CO-MSG.

DO-ELIGIBLE.
    MOVE "LOAN" TO WS-EVAL-OP
    CALL "COLEVL" USING BK-COL-PARMS BK-COL-CASE WS-EVAL-OP
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "ELIGIBILITY EVALUATED" TO CO-MSG.

DO-GET.
    PERFORM LOAD-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM SHOW-CASE.

DO-SNAPSHOT.
    PERFORM LOAD-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CC-STATUS TO WS-BEFORE
    MOVE CC-LOAN-ID TO CO-LOAN-ID
    MOVE "LOAN" TO WS-EVAL-OP
    CALL "COLEVL" USING BK-COL-PARMS BK-COL-CASE WS-EVAL-OP
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CO-OVERDUE-AMT <= 0
        MOVE "RECOVER-FULL" TO WS-ACTION
        CALL "COLST" USING CC-STATUS WS-ACTION WS-NEXT
            WS-STT-RC WS-STT-MSG
        IF WS-STT-RC = "00"
            MOVE WS-NEXT TO CC-STATUS
        END-IF
    END-IF
    PERFORM SAVE-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SNAPSHOT" TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS CC-ID WS-ALABEL
        WS-BEFORE CC-STATUS
    PERFORM SHOW-CASE
    MOVE "SNAPSHOT UPDATED" TO CO-MSG.

DO-ACTION.
    MOVE CO-OP TO WS-ACTION
    PERFORM LOAD-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CC-STATUS TO WS-BEFORE
    IF WS-ACTION = "CLOSE"
        MOVE "CLOSABLE" TO WS-EVAL-OP
        CALL "COLEVL" USING BK-COL-PARMS BK-COL-CASE
            WS-EVAL-OP
        IF CO-RC NOT = "00"
            EXIT PARAGRAPH
        END-IF
    END-IF
    CALL "COLST" USING CC-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE WS-STT-RC TO CO-RC
        MOVE WS-STT-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NEXT TO CC-STATUS
    IF CO-REASON NOT = SPACES
        MOVE CO-REASON TO CC-REASON
    END-IF
    PERFORM SAVE-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-ACTION TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS CC-ID WS-ALABEL
        WS-BEFORE CC-STATUS
    PERFORM SHOW-CASE
    MOVE WS-ACTION TO CO-MSG.

DO-STAGE.
    PERFORM LOAD-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CC-LOAN-ID TO CO-LOAN-ID
    MOVE "LOAN" TO WS-EVAL-OP
    CALL "COLEVL" USING BK-COL-PARMS BK-COL-CASE WS-EVAL-OP
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "POLICY" TO WS-EVAL-OP
    CALL "COLEVL" USING BK-COL-PARMS BK-COL-CASE WS-EVAL-OP
    PERFORM SAVE-CASE
    MOVE CC-STAGE TO CO-STAGE
    MOVE CC-STRATEGY TO CO-STRATEGY
    MOVE CC-PRIORITY TO CO-PRIORITY
    MOVE "STAGE SELECTED" TO CO-MSG.

LOAD-CASE.
    MOVE SPACES TO BK-COL-CASE
    MOVE CO-CASE-ID TO CC-ID
    MOVE "GET" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "CASE NOT FOUND" TO CO-MSG
    END-IF.

LOAD-LOAN.
    MOVE SPACES TO BK-LN-REC
    MOVE CO-LOAN-ID TO LN-ID
    MOVE "GET" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "LOAN NOT FOUND" TO CO-MSG
    END-IF.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CO-RC
        MOVE "SEQUENCE ERROR" TO CO-MSG
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CO-CASE-ID
    STRING "K" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CO-CASE-ID
    END-STRING.

SAVE-NEW.
    MOVE "WRITE" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
    END-IF.

SAVE-CASE.
    MOVE WS-BIZDATE TO CC-UPDATED
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
    END-IF.

SHOW-CASE.
    MOVE CC-ID TO CO-CASE-ID
    MOVE CC-CUST-ID TO CO-CUST-ID
    MOVE CC-LOAN-ID TO CO-LOAN-ID
    MOVE CC-FAC-ID TO CO-FAC-ID
    MOVE CC-STATUS TO CO-STATUS
    MOVE CC-STAGE TO CO-STAGE
    MOVE CC-STRATEGY TO CO-STRATEGY
    MOVE CC-OVERDUE-AMT TO CO-OVERDUE-AMT
    MOVE CC-RECOVERED-AMT TO CO-RECOVERED-AMT
    MOVE CC-DELINQ-DATE TO CO-DUE-DATE
    MOVE CC-PRIORITY TO CO-PRIORITY
    MOVE "00" TO CO-RC.
