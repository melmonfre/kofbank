IDENTIFICATION DIVISION.
PROGRAM-ID. CLOVER.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "COLCFGP".
COPY "BLNSTO".
COPY "BDATP".
01 WS-I PIC 9(05).
01 WS-DUE PIC S9(15)V99 COMP-3.
01 WS-DELINQ PIC 9(08).
01 WS-AGE PIC S9(09).
01 WS-PRIO PIC 9(03).
01 BK-LN-INST.
   COPY "BLNI".

LINKAGE SECTION.
COPY "CLOVER".

PROCEDURE DIVISION USING BK-COL-DELINQ.
    MOVE "00" TO OV-RC
    MOVE SPACES TO OV-MSG
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO OV-RC
        MOVE "CONFIG MISSING" TO OV-MSG
        GOBACK
    END-IF
    CALL "COLCFG" USING BK-COL-CFG
    IF OV-OP = "COMPUTE" OR OV-OP = "ALL"
        PERFORM COMPUTE-OVERDUE
    END-IF
    IF OV-OP = "POLICY" OR OV-OP = "ALL"
        PERFORM COMPUTE-AGE
        PERFORM SELECT-STRATEGY
    END-IF
    GOBACK.

COMPUTE-OVERDUE.
    MOVE 0 TO OV-AMOUNT
    MOVE 0 TO WS-DELINQ
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > OV-TERM
        MOVE SPACES TO BK-LN-INST
        MOVE OV-LOAN-ID TO LI-LOAN-ID
        MOVE WS-I TO LI-NUMBER
        MOVE "GET" TO NS-OP
        CALL "BLNISTO" USING BK-LN-STO-REQ BK-LN-INST
        IF NS-RC NOT = "00"
            EXIT PERFORM
        END-IF
        IF LI-DUE-DATE < WS-BIZDATE
            COMPUTE WS-DUE = LI-TOTAL - LI-PAID-PRIN
                - LI-PAID-INT - LI-PAID-FEE
            IF WS-DUE > 0
                ADD WS-DUE TO OV-AMOUNT
                IF WS-DELINQ = 0 OR LI-DUE-DATE < WS-DELINQ
                    MOVE LI-DUE-DATE TO WS-DELINQ
                END-IF
            END-IF
        END-IF
    END-PERFORM
    IF WS-DELINQ = 0
        MOVE OV-FIRST-DUE TO WS-DELINQ
    END-IF
    MOVE WS-DELINQ TO OV-DELINQ-DATE
    IF OV-LOAN-STATUS = "CLO" OR OV-LOAN-STATUS = "CAN"
        OR OV-LOAN-STATUS = "SET"
        MOVE "N" TO OV-ELIGIBLE
        MOVE 0 TO OV-AMOUNT
        EXIT PARAGRAPH
    END-IF
    IF OV-AMOUNT <= 0
        MOVE "N" TO OV-ELIGIBLE
    ELSE
        PERFORM COMPUTE-AGE
        IF WS-AGE >= KF-ELIG-DAYS
            MOVE "Y" TO OV-ELIGIBLE
        ELSE
            MOVE "N" TO OV-ELIGIBLE
        END-IF
    END-IF.

COMPUTE-AGE.
    MOVE "DIFF-DAYS" TO DAT-OP
    MOVE OV-DELINQ-DATE TO DAT-DATE
    MOVE WS-BIZDATE TO DAT-DATE2
    CALL "BDAT" USING BK-DAT-PARMS
    MOVE DAT-DAYS TO WS-AGE
    IF WS-AGE < 0
        MOVE 0 TO WS-AGE
    END-IF
    MOVE WS-AGE TO OV-AGE.

SELECT-STRATEGY.
    IF WS-AGE < KF-STD-DAYS
        MOVE "EARLY" TO OV-STAGE
        MOVE "EARLY_REMIND" TO OV-STRATEGY
        MOVE 1 TO WS-PRIO
    ELSE
        IF WS-AGE < KF-INT-DAYS
            MOVE "STANDARD" TO OV-STAGE
            MOVE "STANDARD_CONTACT" TO OV-STRATEGY
            MOVE 2 TO WS-PRIO
        ELSE
            IF WS-AGE < KF-FIN-DAYS
                MOVE "INTENSIVE" TO OV-STAGE
                MOVE "INTENSIVE_REQUEST" TO OV-STRATEGY
                MOVE 3 TO WS-PRIO
            ELSE
                MOVE "FINAL" TO OV-STAGE
                MOVE "FINAL_NOTICE" TO OV-STRATEGY
                MOVE 4 TO WS-PRIO
            END-IF
        END-IF
    END-IF
    COMPUTE OV-PRIORITY = KF-PRIORITY-BASE
        + (KF-PRIORITY-STEP * WS-PRIO).
