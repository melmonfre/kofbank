IDENTIFICATION DIVISION.
PROGRAM-ID. COLEVL.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "COLSTO".
COPY "BLNSTO".
COPY "CLOVER".
01 WS-HOME PIC X(80).
01 BK-LN-REC.
   COPY "BLN".
01 BK-COL-PROMISE.
   COPY "COLP".
01 BK-COL-ARRANGE.
   COPY "COLAG".

LINKAGE SECTION.
COPY "COLOP".
01 LS-CASE.
   COPY "COLC".
01 LS-OP PIC X(10).

PROCEDURE DIVISION USING BK-COL-PARMS LS-CASE LS-OP.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CO-RC
        MOVE "CONFIG MISSING" TO CO-MSG
        GOBACK
    END-IF
    EVALUATE LS-OP
        WHEN "LOAN" PERFORM LOAD-EVAL-LOAN
        WHEN "POLICY" PERFORM APPLY-POLICY
        WHEN "CLOSABLE" PERFORM CHECK-CLOSABLE
        WHEN OTHER
            MOVE "99" TO CO-RC
            MOVE "UNKNOWN EVAL OP" TO CO-MSG
    END-EVALUATE
    GOBACK.

LOAD-EVAL-LOAN.
    MOVE SPACES TO BK-LN-REC
    MOVE CO-LOAN-ID TO LN-ID
    MOVE "GET" TO NS-OP
    CALL "BLNSTO" USING BK-LN-STO-REQ BK-LN-REC
    IF NS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "LOAN NOT FOUND" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-COL-DELINQ
    MOVE "ALL" TO OV-OP
    MOVE LN-ID TO OV-LOAN-ID
    MOVE LN-STATUS TO OV-LOAN-STATUS
    MOVE LN-TERM TO OV-TERM
    MOVE LN-FIRST-DUE TO OV-FIRST-DUE
    MOVE LN-CURRENCY TO OV-CURRENCY
    CALL "CLOVER" USING BK-COL-DELINQ
    IF OV-RC NOT = "00"
        MOVE OV-RC TO CO-RC
        MOVE OV-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE OV-ELIGIBLE TO CO-STATUS
    MOVE OV-AGE TO CO-PRIORITY
    MOVE OV-AMOUNT TO CO-OVERDUE-AMT
    MOVE OV-AMOUNT TO CC-OVERDUE-AMT OF LS-CASE
    MOVE OV-DELINQ-DATE TO CC-DELINQ-DATE OF LS-CASE.

APPLY-POLICY.
    MOVE OV-STAGE TO CC-STAGE OF LS-CASE
    MOVE OV-STRATEGY TO CC-STRATEGY OF LS-CASE
    MOVE OV-PRIORITY TO CC-PRIORITY OF LS-CASE
    MOVE WS-BIZDATE TO CC-LAST-ACTION OF LS-CASE.

CHECK-CLOSABLE.
    IF CC-OVERDUE-AMT OF LS-CASE > 0
        MOVE "20" TO CO-RC
        MOVE "CASE HAS OUTSTANDING" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF CC-PROMISE-ID OF LS-CASE NOT = SPACES
        MOVE SPACES TO BK-COL-PROMISE
        MOVE CC-PROMISE-ID OF LS-CASE TO PM-ID
        MOVE "GET" TO OS-OP
        CALL "COLPSTO" USING BK-COL-STO-REQ BK-COL-PROMISE
        IF OS-RC = "00"
            IF PM-STATUS = "PROPOSED" OR PM-STATUS = "ACCEPTED"
                MOVE "20" TO CO-RC
                MOVE "CASE HAS OPEN PROMISE" TO CO-MSG
            END-IF
        END-IF
    END-IF
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CC-ARRANGEMENT-ID OF LS-CASE NOT = SPACES
        MOVE SPACES TO BK-COL-ARRANGE
        MOVE CC-ARRANGEMENT-ID OF LS-CASE TO AG-ID
        MOVE "GET" TO OS-OP
        CALL "COLGSTO" USING BK-COL-STO-REQ BK-COL-ARRANGE
        IF OS-RC = "00"
            IF AG-STATUS = "ACTIVE" OR AG-STATUS = "PARTIALLY"
                MOVE "20" TO CO-RC
                MOVE "CASE HAS ACTIVE ARRANGEMENT" TO CO-MSG
            END-IF
        END-IF
    END-IF.
