IDENTIFICATION DIVISION.
PROGRAM-ID. COLGSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ARR-FILE ASSIGN TO WS-ARR-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS AG-ID
        FILE STATUS IS WS-ARR-ST.

DATA DIVISION.
FILE SECTION.
FD ARR-FILE.
01 ARR-REC.
   COPY "COLAG".

WORKING-STORAGE SECTION.
01 WS-ARR-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-ARR-ST PIC X(02).

LINKAGE SECTION.
COPY "COLSTO".
01 BK-COL-ARRANGE.
   COPY "COLAG".

PROCEDURE DIVISION USING BK-COL-STO-REQ BK-COL-ARRANGE.
    MOVE "00" TO OS-RC
    MOVE SPACES TO OS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-ARR-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/colarr.idx"
        DELIMITED SIZE INTO WS-ARR-PATH
    PERFORM OPEN-STORE
    IF OS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE OS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO OS-RC
            MOVE "UNKNOWN ARRANGEMENT STORE OP" TO OS-MSG
    END-EVALUATE
    CLOSE ARR-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O ARR-FILE
    IF WS-ARR-ST = "35"
        OPEN OUTPUT ARR-FILE
        CLOSE ARR-FILE
        OPEN I-O ARR-FILE
    END-IF
    IF WS-ARR-ST NOT = "00"
        MOVE WS-ARR-ST TO OS-RC
        MOVE "CANNOT OPEN ARRANGEMENT INDEX" TO OS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-COL-ARRANGE TO ARR-REC
    WRITE ARR-REC
        INVALID KEY
            MOVE "22" TO OS-RC
            MOVE "ARRANGEMENT ALREADY EXISTS" TO OS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE AG-ID OF BK-COL-ARRANGE TO AG-ID OF ARR-REC
    READ ARR-FILE
    IF WS-ARR-ST = "00"
        MOVE BK-COL-ARRANGE TO ARR-REC
        REWRITE ARR-REC
    ELSE
        MOVE "23" TO OS-RC
        MOVE "ARRANGEMENT NOT FOUND" TO OS-MSG
    END-IF.

DO-GET.
    MOVE AG-ID OF BK-COL-ARRANGE TO AG-ID OF ARR-REC
    READ ARR-FILE
    IF WS-ARR-ST = "00"
        MOVE ARR-REC TO BK-COL-ARRANGE
        MOVE "00" TO OS-RC
    ELSE
        MOVE "23" TO OS-RC
        MOVE "ARRANGEMENT NOT FOUND" TO OS-MSG
    END-IF.
