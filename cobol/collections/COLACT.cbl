IDENTIFICATION DIVISION.
PROGRAM-ID. COLACT.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "COLSTO".
COPY "COLAQ".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "COLACT".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-I PIC 9(05).
01 WS-BEFORE PIC X(12).
01 WS-ALABEL PIC X(12).
01 BK-COL-CASE.
   COPY "COLC".
01 BK-COL-ACTION.
   COPY "COLA".

LINKAGE SECTION.
COPY "COLOP".

PROCEDURE DIVISION USING BK-COL-PARMS.
    MOVE "00" TO CO-RC
    MOVE SPACES TO CO-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CO-RC
        MOVE "CONFIG MISSING" TO CO-MSG
        GOBACK
    END-IF
    EVALUATE CO-OP
        WHEN "CREATE" PERFORM DO-CREATE
        WHEN "EXECUTE" PERFORM DO-EXECUTE
        WHEN "CANCEL" PERFORM DO-CLOSE-ACT
        WHEN "EXPIRE" PERFORM DO-CLOSE-ACT
        WHEN "FAIL" PERFORM DO-CLOSE-ACT
        WHEN OTHER
            MOVE "99" TO CO-RC
            MOVE "UNKNOWN ACTION OP" TO CO-MSG
    END-EVALUATE
    GOBACK.

DO-CREATE.
    PERFORM LOAD-CASE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF CC-STATUS = "CLOS" OR CC-STATUS = "CANC"
        MOVE "20" TO CO-RC
        MOVE "CASE CLOSED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    IF CO-ACTION-TYPE = SPACES
        MOVE "20" TO CO-RC
        MOVE "ACTION TYPE REQUIRED" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-ACTIVE
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-ID
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-COL-ACTION
    MOVE CO-ACTION-ID TO XA-ID
    MOVE CO-CASE-ID TO XA-CASE-ID
    MOVE CO-ACTION-TYPE TO XA-TYPE
    MOVE "PLANNED" TO XA-STATUS
    MOVE CO-REF TO XA-CHANNEL
    MOVE WS-BIZDATE TO XA-PLANNED
    MOVE WS-BIZDATE TO XA-NEXT-DATE
    MOVE CO-REASON TO XA-REASON
    MOVE CO-OPERATOR TO XA-OPERATOR
    MOVE WS-BIZDATE TO XA-CREATED
    MOVE WS-BIZDATE TO XA-UPDATED
    MOVE 1 TO XA-VERSION
    MOVE "WRITE" TO OS-OP
    CALL "COLASTO" USING BK-COL-STO-REQ BK-COL-ACTION
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-BIZDATE TO CC-LAST-ACTION
    MOVE WS-BIZDATE TO CC-NEXT-ACTION
    PERFORM SAVE-CASE
    MOVE "CREATE" TO WS-ALABEL
    MOVE SPACES TO WS-BEFORE
    CALL "COLAUD" USING BK-COL-PARMS XA-ID WS-ALABEL
        WS-BEFORE XA-STATUS
    MOVE XA-ID TO CO-ACTION-ID
    MOVE "PLANNED" TO CO-STATUS
    MOVE "ACTION CREATED" TO CO-MSG.

DO-EXECUTE.
    PERFORM LOAD-ACTION
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF XA-STATUS NOT = "PLANNED" AND XA-STATUS NOT = "SCHEDULED"
        MOVE "20" TO CO-RC
        MOVE "ACTION NOT EXECUTABLE" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE XA-STATUS TO WS-BEFORE
    MOVE "EXECUTED" TO XA-STATUS
    MOVE WS-BIZDATE TO XA-EXECUTED
    IF CO-REASON NOT = SPACES
        MOVE CO-REASON TO XA-RESULT
    END-IF
    PERFORM SAVE-ACTION
    MOVE "EXECUTE" TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS XA-ID WS-ALABEL
        WS-BEFORE XA-STATUS.

DO-CLOSE-ACT.
    PERFORM LOAD-ACTION
    IF CO-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF XA-STATUS NOT = "PLANNED" AND XA-STATUS NOT = "SCHEDULED"
        MOVE "20" TO CO-RC
        MOVE "ACTION NOT OPEN" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE XA-STATUS TO WS-BEFORE
    EVALUATE CO-OP
        WHEN "CANCEL" MOVE "CANCELLED" TO XA-STATUS
        WHEN "EXPIRE" MOVE "EXPIRED" TO XA-STATUS
        WHEN "FAIL" MOVE "FAILED" TO XA-STATUS
    END-EVALUATE
    IF CO-REASON NOT = SPACES
        MOVE CO-REASON TO XA-RESULT
    END-IF
    PERFORM SAVE-ACTION
    MOVE CO-OP TO WS-ALABEL
    CALL "COLAUD" USING BK-COL-PARMS XA-ID WS-ALABEL
        WS-BEFORE XA-STATUS.

LOAD-CASE.
    MOVE SPACES TO BK-COL-CASE
    MOVE CO-CASE-ID TO CC-ID
    MOVE "GET" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "CASE NOT FOUND" TO CO-MSG
    END-IF.

LOAD-ACTION.
    MOVE SPACES TO BK-COL-ACTION
    MOVE CO-ACTION-ID TO XA-ID
    MOVE "GET" TO OS-OP
    CALL "COLASTO" USING BK-COL-STO-REQ BK-COL-ACTION
    IF OS-RC NOT = "00"
        MOVE "23" TO CO-RC
        MOVE "ACTION NOT FOUND" TO CO-MSG
    END-IF.

CHECK-ACTIVE.
    MOVE CO-CASE-ID TO AL-CASE
    MOVE "LIST" TO AL-OP
    CALL "COLAQ" USING BK-COL-ACTLIST
    IF AL-RC NOT = "00"
        MOVE "36" TO CO-RC
        MOVE "ACTION LIST UNAVAILABLE" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > AL-COUNT
        IF AL-STAT(WS-I) = "PLANNED" OR AL-STAT(WS-I) = "SCHEDULED"
            MOVE "22" TO CO-RC
            MOVE "ACTIVE ACTION EXISTS" TO CO-MSG
        END-IF
    END-PERFORM.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CO-RC
        MOVE "SEQUENCE ERROR" TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CO-ACTION-ID
    STRING "X" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CO-ACTION-ID
    END-STRING.

SAVE-ACTION.
    MOVE WS-BIZDATE TO XA-UPDATED
    ADD 1 TO XA-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLASTO" USING BK-COL-STO-REQ BK-COL-ACTION
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE XA-ID TO CO-ACTION-ID
    MOVE XA-STATUS TO CO-STATUS
    MOVE "ACTION UPDATED" TO CO-MSG.

SAVE-CASE.
    MOVE WS-BIZDATE TO CC-UPDATED
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO OS-OP
    CALL "COLSTO" USING BK-COL-STO-REQ BK-COL-CASE
    IF OS-RC NOT = "00"
        MOVE OS-RC TO CO-RC
        MOVE OS-MSG TO CO-MSG
    END-IF.
