IDENTIFICATION DIVISION.
PROGRAM-ID. COLRSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT REC-FILE ASSIGN TO WS-REC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS RV-ID
        FILE STATUS IS WS-REC-ST.

DATA DIVISION.
FILE SECTION.
FD REC-FILE.
01 REC-REC.
   COPY "COLRC".

WORKING-STORAGE SECTION.
01 WS-REC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-REC-ST PIC X(02).

LINKAGE SECTION.
COPY "COLSTO".
01 BK-COL-RECOVERY.
   COPY "COLRC".

PROCEDURE DIVISION USING BK-COL-STO-REQ BK-COL-RECOVERY.
    MOVE "00" TO OS-RC
    MOVE SPACES TO OS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-REC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/colrec.idx"
        DELIMITED SIZE INTO WS-REC-PATH
    PERFORM OPEN-STORE
    IF OS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE OS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO OS-RC
            MOVE "UNKNOWN RECOVERY STORE OP" TO OS-MSG
    END-EVALUATE
    CLOSE REC-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O REC-FILE
    IF WS-REC-ST = "35"
        OPEN OUTPUT REC-FILE
        CLOSE REC-FILE
        OPEN I-O REC-FILE
    END-IF
    IF WS-REC-ST NOT = "00"
        MOVE WS-REC-ST TO OS-RC
        MOVE "CANNOT OPEN RECOVERY INDEX" TO OS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-COL-RECOVERY TO REC-REC
    WRITE REC-REC
        INVALID KEY
            MOVE "22" TO OS-RC
            MOVE "RECOVERY ALREADY EXISTS" TO OS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE RV-ID OF BK-COL-RECOVERY TO RV-ID OF REC-REC
    READ REC-FILE
    IF WS-REC-ST = "00"
        MOVE BK-COL-RECOVERY TO REC-REC
        REWRITE REC-REC
    ELSE
        MOVE "23" TO OS-RC
        MOVE "RECOVERY NOT FOUND" TO OS-MSG
    END-IF.

DO-GET.
    MOVE RV-ID OF BK-COL-RECOVERY TO RV-ID OF REC-REC
    READ REC-FILE
    IF WS-REC-ST = "00"
        MOVE REC-REC TO BK-COL-RECOVERY
        MOVE "00" TO OS-RC
    ELSE
        MOVE "23" TO OS-RC
        MOVE "RECOVERY NOT FOUND" TO OS-MSG
    END-IF.
