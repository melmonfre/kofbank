IDENTIFICATION DIVISION.
PROGRAM-ID. COLCLIQ.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-NUM PIC 9(05).
COPY "COLAQ".
COPY "COLQ".
COPY "COLPQ".
COPY "COLGQ".
COPY "COLWQ".

LINKAGE SECTION.
01 LS-KIND PIC X(12).
01 LS-CASE PIC X(12).

PROCEDURE DIVISION USING LS-KIND LS-CASE.
    EVALUATE LS-KIND
        WHEN "CASE" PERFORM DO-CASE-LIST
        WHEN "ACTION" PERFORM DO-ACT-LIST
        WHEN "PROMISE" PERFORM DO-PROM-LIST
        WHEN "ARRANGE" PERFORM DO-ARR-LIST
        WHEN "RECOVERY" PERFORM DO-REC-LIST
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN COLLECTION LIST"
    END-EVALUATE
    GOBACK.

DO-CASE-LIST.
    MOVE "LIST" TO OL-OP
    CALL "COLQ" USING BK-COL-LIST
    DISPLAY "rc=" OL-RC
    DISPLAY "count=" OL-COUNT
    PERFORM VARYING WS-NUM FROM 1 BY 1 UNTIL WS-NUM > OL-COUNT
        DISPLAY "case=" FUNCTION TRIM(OL-CASE(WS-NUM))
            " loan=" FUNCTION TRIM(OL-LOAN(WS-NUM))
            " status=" FUNCTION TRIM(OL-STATUS(WS-NUM))
    END-PERFORM.

DO-ACT-LIST.
    MOVE LS-CASE TO AL-CASE
    MOVE "LIST" TO AL-OP
    CALL "COLAQ" USING BK-COL-ACTLIST
    DISPLAY "rc=" AL-RC
    DISPLAY "count=" AL-COUNT
    PERFORM VARYING WS-NUM FROM 1 BY 1 UNTIL WS-NUM > AL-COUNT
        DISPLAY "action=" FUNCTION TRIM(AL-ID(WS-NUM))
            " type=" FUNCTION TRIM(AL-TYPE(WS-NUM))
            " status=" FUNCTION TRIM(AL-STAT(WS-NUM))
    END-PERFORM.

DO-PROM-LIST.
    MOVE LS-CASE TO PL-CASE
    MOVE "LIST" TO PL-OP
    CALL "COLPQ" USING BK-COL-PROMLIST
    DISPLAY "rc=" PL-RC
    DISPLAY "count=" PL-COUNT
    PERFORM VARYING WS-NUM FROM 1 BY 1 UNTIL WS-NUM > PL-COUNT
        DISPLAY "promise=" FUNCTION TRIM(PL-ID(WS-NUM))
        DISPLAY "status=" FUNCTION TRIM(PL-STATUS(WS-NUM))
        DISPLAY "amount=" PL-AMOUNT(WS-NUM)
        DISPLAY "txn=" FUNCTION TRIM(PL-TXN(WS-NUM))
    END-PERFORM.

DO-ARR-LIST.
    MOVE LS-CASE TO GL-CASE
    MOVE "LIST" TO GL-OP
    CALL "COLGQ" USING BK-COL-ARRLIST
    DISPLAY "rc=" GL-RC
    DISPLAY "count=" GL-COUNT
    PERFORM VARYING WS-NUM FROM 1 BY 1 UNTIL WS-NUM > GL-COUNT
        DISPLAY "arrangement=" FUNCTION TRIM(GL-ID(WS-NUM))
        DISPLAY "status=" FUNCTION TRIM(GL-STATUS(WS-NUM))
        DISPLAY "total=" GL-TOTAL(WS-NUM)
    END-PERFORM.

DO-REC-LIST.
    MOVE LS-CASE TO RL-CASE
    MOVE "LIST" TO RL-OP
    CALL "COLWQ" USING BK-COL-RECLIST
    DISPLAY "rc=" RL-RC
    DISPLAY "count=" RL-COUNT
    PERFORM VARYING WS-NUM FROM 1 BY 1 UNTIL WS-NUM > RL-COUNT
        DISPLAY "recovery=" FUNCTION TRIM(RL-ID(WS-NUM))
            " txn=" FUNCTION TRIM(RL-TXN(WS-NUM))
            " status=" FUNCTION TRIM(RL-STATUS(WS-NUM))
            " amount=" RL-AMOUNT(WS-NUM)
    END-PERFORM.
