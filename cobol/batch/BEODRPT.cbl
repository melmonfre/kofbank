IDENTIFICATION DIVISION.
PROGRAM-ID. BEODRPT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RPT-FILE ASSIGN TO WS-RPT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-RPT-ST.

DATA DIVISION.
FILE SECTION.
FD RPT-FILE.
01 RPT-LINE PIC X(120).

WORKING-STORAGE SECTION.
01 WS-RPT-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-RPT-ST PIC X(02).
01 WS-TOT-ED PIC -(15)9.99.
01 WS-PAY-ED PIC -(15)9.99.

LINKAGE SECTION.
COPY "BEODRP".

PROCEDURE DIVISION USING BK-EOD-RPT.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-RPT-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/out/eod_" DELIMITED SIZE
        ER-BIZDATE DELIMITED SIZE ".txt" DELIMITED SIZE
        INTO WS-RPT-PATH
    END-STRING
    OPEN OUTPUT RPT-FILE
    IF WS-RPT-ST NOT = "00"
        MOVE WS-RPT-ST TO ER-RC
        GOBACK
    END-IF
    PERFORM WRITE-HEADER
    PERFORM WRITE-COUNTS
    PERFORM WRITE-PAYMENTS
    PERFORM WRITE-RECON
    MOVE "00" TO ER-RC
    CLOSE RPT-FILE.

WRITE-LINE.
    WRITE RPT-LINE.

WRITE-HEADER.
    MOVE SPACES TO RPT-LINE
    STRING "EOD REPORT " DELIMITED SIZE ER-BIZDATE DELIMITED SIZE
        INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE.

WRITE-COUNTS.
    MOVE SPACES TO RPT-LINE
    STRING "CUSTOMERS " DELIMITED SIZE ER-N-CUST DELIMITED SIZE
        INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "ACCOUNTS " DELIMITED SIZE ER-N-ACCT DELIMITED SIZE
        INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "BALANCES " DELIMITED SIZE ER-N-BAL DELIMITED SIZE
        INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE ER-TOT-LEDGER TO WS-TOT-ED
    MOVE SPACES TO RPT-LINE
    STRING "TOTAL-LIABILITY " DELIMITED SIZE WS-TOT-ED DELIMITED SIZE
        INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE.

WRITE-PAYMENTS.
    MOVE SPACES TO RPT-LINE
    STRING "PAYMENTS " DELIMITED SIZE ER-PE-TOTAL DELIMITED SIZE
        INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "PAYMENTS-SETTLED " DELIMITED SIZE ER-PE-SETTLED
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "PAYMENTS-PENDING " DELIMITED SIZE ER-PE-PENDING
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "PAYMENTS-FAILED " DELIMITED SIZE ER-PE-FAILED
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "PAYMENTS-RETURNED " DELIMITED SIZE ER-PE-RETURNED
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "PAYMENTS-REVERSED " DELIMITED SIZE ER-PE-REVERSED
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE ER-PE-SETTLED-AMT TO WS-PAY-ED
    MOVE SPACES TO RPT-LINE
    STRING "PAYMENTS-SETTLED-AMOUNT " DELIMITED SIZE WS-PAY-ED
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "PAYMENTS-BROKEN " DELIMITED SIZE ER-PE-BROKEN
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE.

WRITE-RECON.
    MOVE SPACES TO RPT-LINE
    STRING "RECON-LEDGER " DELIMITED SIZE FUNCTION TRIM(ER-REC-LED-ID)
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "RECON-PAYMENT " DELIMITED SIZE FUNCTION TRIM(ER-REC-PAY-ID)
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "RECON-TRANSACTION " DELIMITED SIZE
        FUNCTION TRIM(ER-REC-TXN-ID)
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "TRIAL " DELIMITED SIZE FUNCTION TRIM(ER-TB-MSG)
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "RECON-CREDIT " DELIMITED SIZE FUNCTION TRIM(ER-REC-CRD-ID)
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE
    MOVE SPACES TO RPT-LINE
    STRING "CREDIT-EOD " DELIMITED SIZE FUNCTION TRIM(ER-CRD-EOD)
        DELIMITED SIZE INTO RPT-LINE
    END-STRING
    PERFORM WRITE-LINE.
