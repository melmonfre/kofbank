IDENTIFICATION DIVISION.
PROGRAM-ID. CLTEOD.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT COLL-FILE ASSIGN TO WS-COLL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CT-ID
        FILE STATUS IS WS-COLL-ST.
    SELECT VAL-FILE ASSIGN TO WS-VAL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS VA-ID
        FILE STATUS IS WS-VAL-ST.

DATA DIVISION.
FILE SECTION.
FD COLL-FILE.
01 COLL-REC.
   COPY "CLTC".
FD VAL-FILE.
01 VAL-REC.
   COPY "CLTV".

WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "CLTP".
COPY "CLTGDP".
01 WS-COLL-PATH PIC X(200).
01 WS-VAL-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-COLL-ST PIC X(02).
01 WS-VAL-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-EXP PIC 9(05).
01 WS-REV PIC 9(05).
01 WS-SCAN PIC 9(05).
01 WS-ID PIC X(12).
01 WS-VT PIC 9(08).
01 WS-LOCKED PIC X(01).

LINKAGE SECTION.
01 LS-RC PIC X(02).
01 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-RC LS-MSG.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO LS-RC
        MOVE "CONFIG MISSING" TO LS-MSG
        GOBACK
    END-IF
    MOVE SPACES TO WS-COLL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltcoll.idx"
        DELIMITED SIZE INTO WS-COLL-PATH
    MOVE SPACES TO WS-VAL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltval.idx"
        DELIMITED SIZE INTO WS-VAL-PATH
    MOVE 0 TO WS-EXP
    MOVE 0 TO WS-REV
    MOVE 0 TO WS-SCAN
    OPEN INPUT COLL-FILE
    IF WS-COLL-ST = "35"
        MOVE "COLLATERAL EOD NO FILE" TO LS-MSG
        GOBACK
    END-IF
    IF WS-COLL-ST NOT = "00"
        MOVE "35" TO LS-RC
        MOVE "COLLATERAL FILE UNREADABLE" TO LS-MSG
        GOBACK
    END-IF
    OPEN INPUT VAL-FILE
    IF WS-VAL-ST NOT = "00" AND WS-VAL-ST NOT = "35"
        MOVE "35" TO LS-RC
        MOVE "VALUATION FILE UNREADABLE" TO LS-MSG
        CLOSE COLL-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ COLL-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM PROCESS-ONE
        END-READ
    END-PERFORM
    CLOSE COLL-FILE
    IF WS-VAL-ST = "00"
        CLOSE VAL-FILE
    END-IF
    IF WS-VAL-ST = "35"
        CONTINUE
    END-IF
    DISPLAY "COLLATERAL-EOD SCANNED=" WS-SCAN
        " EXPIRED=" WS-EXP " REVIEW=" WS-REV
    MOVE SPACES TO LS-MSG
    STRING "COLLATERAL EOD SCANNED=" DELIMITED SIZE WS-SCAN
        DELIMITED SIZE " EXPIRED=" DELIMITED SIZE WS-EXP
        DELIMITED SIZE " REVIEW=" DELIMITED SIZE WS-REV
        DELIMITED SIZE INTO LS-MSG
    END-STRING
    GOBACK.

PROCESS-ONE.
    ADD 1 TO WS-SCAN
    MOVE CT-ID OF COLL-REC TO WS-ID
    EVALUATE CT-STATUS OF COLL-REC
        WHEN "PENDVALID" PERFORM CHECK-ALL
        WHEN "VALID" PERFORM CHECK-ALL
        WHEN "PARTPLED" PERFORM CHECK-ALL
        WHEN "PLEDGED" PERFORM CHECK-ALL
        WHEN "ENCUMBER" PERFORM CHECK-ALL
        WHEN OTHER CONTINUE
    END-EVALUATE.

CHECK-ALL.
    PERFORM CHECK-EXPIRE
    IF CT-STATUS OF COLL-REC NOT = "EXPIRED"
        PERFORM CHECK-REVIEW
    END-IF.

CHECK-EXPIRE.
    IF CT-EXP-DATE OF COLL-REC > 0
        AND CT-EXP-DATE OF COLL-REC < WS-BIZDATE
        PERFORM LOCK-ONE
        IF WS-LOCKED = "Y"
            MOVE SPACES TO BK-CLT-PARMS
            MOVE "EXPIRE" TO CP-OP
            MOVE WS-ID TO CP-COLL-ID
            MOVE "BATCH" TO CP-OPERATOR
            CALL "CLT" USING BK-CLT-PARMS
            IF CP-RC = "00"
                ADD 1 TO WS-EXP
                MOVE "EXPIRED" TO CT-STATUS OF COLL-REC
            END-IF
            PERFORM UNLOCK-ONE
        END-IF
    END-IF.

CHECK-REVIEW.
    MOVE 0 TO WS-VT
    IF CT-VALUATION-ID OF COLL-REC NOT = SPACES
        AND WS-VAL-ST = "00"
        MOVE CT-VALUATION-ID OF COLL-REC TO VA-ID OF VAL-REC
        READ VAL-FILE
        IF WS-VAL-ST = "00"
            MOVE VA-VALID-THRU OF VAL-REC TO WS-VT
        END-IF
    END-IF
    IF WS-VT > 0
        AND WS-BIZDATE > WS-VT
        AND CT-REVIEW-FLAG OF COLL-REC = "N"
        PERFORM LOCK-ONE
        IF WS-LOCKED = "Y"
            MOVE SPACES TO BK-CLT-PARMS
            MOVE "REVIEW" TO CP-OP
            MOVE WS-ID TO CP-COLL-ID
            MOVE "BATCH" TO CP-OPERATOR
            CALL "CLT" USING BK-CLT-PARMS
            IF CP-RC = "00"
                ADD 1 TO WS-REV
            END-IF
            PERFORM UNLOCK-ONE
        END-IF
    END-IF.

LOCK-ONE.
    MOVE "N" TO WS-LOCKED
    MOVE SPACES TO BK-CLT-GUARD
    MOVE "LOCK" TO GD-OP
    MOVE WS-ID TO GD-LOCK-ID
    MOVE "BATCH" TO GD-OPERATOR
    CALL "CLTGUARD" USING BK-CLT-GUARD
    IF GD-RC = "00"
        MOVE "Y" TO WS-LOCKED
    END-IF.

UNLOCK-ONE.
    IF WS-LOCKED = "Y"
        MOVE SPACES TO BK-CLT-GUARD
        MOVE "UNLOCK" TO GD-OP
        MOVE WS-ID TO GD-LOCK-ID
        MOVE "BATCH" TO GD-OPERATOR
        CALL "CLTGUARD" USING BK-CLT-GUARD
        MOVE "N" TO WS-LOCKED
    END-IF.
