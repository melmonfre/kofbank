IDENTIFICATION DIVISION.
PROGRAM-ID. COLCEOD.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "COLOP".
COPY "COLCFGP".
COPY "BDATP".
COPY "COLQ".
COPY "COLPQ".
COPY "COLLNQ".
01 WS-HOME PIC X(80).
01 WS-I PIC 9(05).
01 WS-J PIC 9(05).
01 WS-N-SNAP PIC 9(05) VALUE 0.
01 WS-N-EXP PIC 9(05) VALUE 0.
01 WS-N-NEW PIC 9(05) VALUE 0.
01 WS-LIMIT PIC 9(08).
01 WS-PAYLOAD PIC X(200).
01 BK-COL-CASE.
   COPY "COLC".

LINKAGE SECTION.
01 LS-RC PIC X(02).
01 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-RC LS-MSG.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    CALL "COLCFG" USING BK-COL-CFG
    MOVE 0 TO WS-N-SNAP
    MOVE 0 TO WS-N-EXP
    MOVE 0 TO WS-N-NEW
    PERFORM AUTO-CREATE
    IF LS-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CASES
    PERFORM PROCESS-CASES
    MOVE SPACES TO LS-MSG
    DISPLAY "COLLECTION-EOD SNAPSHOT=" WS-N-SNAP
        " EXPIRED=" WS-N-EXP " CREATED=" WS-N-NEW
    STRING "COLLECTION EOD SNAPSHOT=" DELIMITED SIZE WS-N-SNAP
        DELIMITED SIZE " EXPIRED=" DELIMITED SIZE WS-N-EXP
        DELIMITED SIZE " CREATED=" DELIMITED SIZE WS-N-NEW
        DELIMITED SIZE INTO LS-MSG
    END-STRING
    GOBACK.

AUTO-CREATE.
    MOVE "LIST" TO LL-OP
    CALL "COLLNQ" USING BK-COL-LOANLIST
    IF LL-RC NOT = "00"
        MOVE LL-RC TO LS-RC
        MOVE "LOAN LIST UNAVAILABLE" TO LS-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LL-COUNT
        MOVE LL-ID(WS-I) TO CO-LOAN-ID
        MOVE "CREATE" TO CO-OP
        MOVE "EOD AUTO-CREATION" TO CO-REASON
        MOVE "BATCH" TO CO-OPERATOR
        MOVE WS-BIZDATE TO CO-CORR
        MOVE SPACES TO CO-REQUEST
        CALL "COL" USING BK-COL-PARMS
        EVALUATE CO-RC
            WHEN "00" ADD 1 TO WS-N-NEW
            WHEN "20" CONTINUE
            WHEN "22" CONTINUE
            WHEN "23" CONTINUE
            WHEN OTHER
                MOVE CO-RC TO LS-RC
                MOVE CO-MSG TO LS-MSG
                EXIT PERFORM
        END-EVALUATE
    END-PERFORM.

LOAD-CASES.
    MOVE "LIST" TO OL-OP
    CALL "COLQ" USING BK-COL-LIST
    IF OL-RC NOT = "00"
        MOVE 0 TO OL-COUNT
    END-IF.

PROCESS-CASES.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > OL-COUNT
        MOVE OL-CASE(WS-I) TO CO-CASE-ID
        MOVE "SNAPSHOT" TO CO-OP
        CALL "COL" USING BK-COL-PARMS
        IF CO-RC = "00"
            ADD 1 TO WS-N-SNAP
            MOVE "STAGE" TO CO-OP
            CALL "COL" USING BK-COL-PARMS
        END-IF
        PERFORM EXPIRE-PROMISES
    END-PERFORM.

EXPIRE-PROMISES.
    MOVE CO-CASE-ID TO PL-CASE
    MOVE "LIST" TO PL-OP
    CALL "COLPQ" USING BK-COL-PROMLIST
    IF PL-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > PL-COUNT
        PERFORM CHECK-EXPIRE
    END-PERFORM.

CHECK-EXPIRE.
    IF PL-STATUS(WS-J) NOT = "PROPOSED"
        AND PL-STATUS(WS-J) NOT = "ACCEPTED"
        EXIT PARAGRAPH
    END-IF
    MOVE PL-DATE(WS-J) TO DAT-DATE
    MOVE KF-EXP-DAYS TO DAT-DAYS
    MOVE "ADD-DAYS" TO DAT-OP
    CALL "BDAT" USING BK-DAT-PARMS
    MOVE DAT-RESULT TO WS-LIMIT
    IF WS-LIMIT >= WS-BIZDATE
        EXIT PARAGRAPH
    END-IF
    MOVE PL-ID(WS-J) TO CO-PROMISE-ID
    MOVE "EXPIRE" TO CO-OP
    MOVE "EOD PROMISE EXPIRY" TO CO-REASON
    MOVE "BATCH" TO CO-OPERATOR
    MOVE WS-BIZDATE TO CO-CORR
    MOVE SPACES TO CO-REQUEST
    CALL "COLPROM" USING BK-COL-PARMS
    IF CO-RC = "00"
        ADD 1 TO WS-N-EXP
    END-IF.
