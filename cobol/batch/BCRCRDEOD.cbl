IDENTIFICATION DIVISION.
PROGRAM-ID. BCRCRDEOD.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT FAC-FILE ASSIGN TO WS-FAC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CRF-ID
        FILE STATUS IS WS-FAC-ST.
    SELECT OBL-FILE ASSIGN TO WS-OBL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CRO-KEY
        FILE STATUS IS WS-OBL-ST.

DATA DIVISION.
FILE SECTION.
FD FAC-FILE.
01 FAC-REC.
   COPY "BCRF".
FD OBL-FILE.
01 OBL-REC.
   COPY "BCRO".

WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BCRSTO".
COPY "BCREXP".
COPY "BCRFP".
01 WS-FAC-PATH PIC X(200).
01 WS-OBL-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-FAC-ST PIC X(02).
01 WS-OBL-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-N-FAC PIC 9(05) VALUE 0.
01 WS-FAC-MAX PIC 9(05) VALUE 100.
01 WS-FT.
   05 WS-F-ROW OCCURS 100 TIMES.
      10 WS-F-ID PIC X(12).
      10 WS-F-STATUS PIC X(04).
      10 WS-F-MAT PIC 9(08).
01 WS-I PIC 9(05).
01 WS-OVERDUE PIC S9(15)V99 COMP-3.
01 WS-DUE-AMT PIC S9(15)V99 COMP-3.
01 WS-PAID-AMT PIC S9(15)V99 COMP-3.
01 WS-MATURED PIC 9(05) VALUE 0.
01 WS-OVERDUE-N PIC 9(05) VALUE 0.
01 WS-REQ PIC X(24).
01 WS-PRIN PIC S9(15)V99 COMP-3.

LINKAGE SECTION.
01 LS-RC PIC X(02).
01 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-RC LS-MSG.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    MOVE SPACES TO WS-FAC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crfac.idx"
        DELIMITED SIZE INTO WS-FAC-PATH
    MOVE SPACES TO WS-OBL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crobl.idx"
        DELIMITED SIZE INTO WS-OBL-PATH
    PERFORM LOAD-FACILITIES
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-FAC
        PERFORM PROCESS-FACILITY
    END-PERFORM
    MOVE SPACES TO LS-MSG
    STRING "CREDIT EOD OVERDUE=" DELIMITED SIZE WS-OVERDUE-N
        DELIMITED SIZE " MATURED=" DELIMITED SIZE WS-MATURED
        DELIMITED SIZE INTO LS-MSG
    END-STRING
    GOBACK.

LOAD-FACILITIES.
    OPEN INPUT FAC-FILE
    IF WS-FAC-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ FAC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-N-FAC < WS-FAC-MAX
                    ADD 1 TO WS-N-FAC
                    MOVE CRF-ID OF FAC-REC TO WS-F-ID(WS-N-FAC)
                    MOVE CRF-STATUS OF FAC-REC TO WS-F-STATUS(WS-N-FAC)
                    MOVE CRF-MATURITY OF FAC-REC TO WS-F-MAT(WS-N-FAC)
                END-IF
        END-READ
    END-PERFORM
    CLOSE FAC-FILE.

PROCESS-FACILITY.
    IF WS-F-STATUS(WS-I) = "CLO" OR WS-F-STATUS(WS-I) = "CAN"
        OR WS-F-STATUS(WS-I) = "EXP" OR WS-F-STATUS(WS-I) = "DEF"
        EXIT PARAGRAPH
    END-IF
    PERFORM SUM-OVERDUE
    PERFORM SET-OVERDUE
    IF WS-F-STATUS(WS-I) = "MAT" OR WS-F-STATUS(WS-I) = "ACT"
        IF WS-F-MAT(WS-I) > 0 AND WS-BIZDATE >= WS-F-MAT(WS-I)
            PERFORM CHECK-MATURITY
        END-IF
    END-IF.

SUM-OVERDUE.
    MOVE 0 TO WS-OVERDUE
    OPEN INPUT OBL-FILE
    IF WS-OBL-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-F-ID(WS-I) TO CRO-FAC-ID OF OBL-REC
    MOVE 0 TO CRO-INSTALLMENT OF OBL-REC
    START OBL-FILE KEY >= CRO-KEY OF OBL-REC
        INVALID KEY MOVE "Y" TO WS-EOF
    END-START
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ OBL-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF CRO-FAC-ID OF OBL-REC NOT = WS-F-ID(WS-I)
                    MOVE "Y" TO WS-EOF
                ELSE
                    IF CRO-STATUS OF OBL-REC NOT = "PA"
                        AND CRO-DUE-DATE OF OBL-REC < WS-BIZDATE
                        PERFORM ADD-OVERDUE
                    END-IF
                END-IF
        END-READ
    END-PERFORM
    CLOSE OBL-FILE.

ADD-OVERDUE.
    COMPUTE WS-DUE-AMT = CRO-TOTAL-DUE OF OBL-REC
    COMPUTE WS-PAID-AMT = CRO-PAID-FEE OF OBL-REC
        + CRO-PAID-INT OF OBL-REC + CRO-PAID-PRIN OF OBL-REC
    COMPUTE WS-DUE-AMT = WS-DUE-AMT - WS-PAID-AMT
    IF WS-DUE-AMT > 0
        ADD WS-DUE-AMT TO WS-OVERDUE
    END-IF.

SET-OVERDUE.
    IF WS-OVERDUE = 0
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-OVERDUE-N
    MOVE "SETOVDUE" TO CE-OP
    MOVE WS-F-ID(WS-I) TO CE-FAC-ID
    MOVE WS-OVERDUE TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS.

CHECK-MATURITY.
    MOVE "GET" TO CE-OP
    MOVE WS-F-ID(WS-I) TO CE-FAC-ID
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CE-PRINCIPAL TO WS-PRIN
    IF WS-PRIN > 0
        EXIT PARAGRAPH
    END-IF
    MOVE "MATURE" TO CF-OP
    MOVE WS-F-ID(WS-I) TO CF-FAC-ID
    MOVE "BATCH" TO CF-OPERATOR
    MOVE WS-BIZDATE TO CF-CORR
    MOVE SPACES TO WS-REQ
    STRING "EODMAT" DELIMITED SIZE WS-F-ID(WS-I) DELIMITED SIZE
        INTO WS-REQ
    END-STRING
    MOVE WS-REQ TO CF-REQUEST
    CALL "BCRF" USING BK-CR-FAC-PARMS
    IF CF-RC = "00"
        ADD 1 TO WS-MATURED
    END-IF.
