IDENTIFICATION DIVISION.
PROGRAM-ID. BBATEOD.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CUST-FILE ASSIGN TO WS-CUST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CU-CUST-ID
        FILE STATUS IS WS-CUST-ST.
    SELECT ACCT-FILE ASSIGN TO WS-ACCT-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS AC-ACCT-ID
        FILE STATUS IS WS-ACCT-ST.
    SELECT BAL-FILE ASSIGN TO WS-BAL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS BAL-ACCT-ID
        FILE STATUS IS WS-BAL-ST.

DATA DIVISION.
FILE SECTION.
FD CUST-FILE.
01 CUST-REC.
   05 CU-CUST-ID PIC X(12).
   05 CU-CUST-TYPE PIC X(01).
   05 CU-CUST-STATUS PIC X(02).
   05 CU-CUST-NAME PIC X(60).
   05 CU-CUST-DOC-TYPE PIC X(04).
   05 CU-CUST-DOC PIC X(20).
   05 CU-CUST-BIRTH PIC 9(08).
   05 CU-CUST-RISK PIC X(02).
   05 CU-CUST-KYC PIC X(02).
   05 CU-CUST-ADDR PIC X(80).
   05 CU-CUST-CREATED PIC 9(08).
   05 CU-CUST-UPDATED PIC 9(08).
   05 CU-CUST-VERSION PIC 9(05).
   05 CU-CUST-HASH PIC X(16).
FD ACCT-FILE.
01 ACCT-REC.
   05 AC-ACCT-ID PIC X(12).
   05 AC-ACCT-CUST-ID PIC X(12).
   05 AC-ACCT-PRODUCT PIC X(04).
   05 AC-ACCT-CURRENCY PIC X(03).
   05 AC-ACCT-STATUS PIC X(02).
   05 AC-ACCT-OPENED PIC 9(08).
   05 AC-ACCT-CLOSED PIC 9(08).
   05 AC-ACCT-VERSION PIC 9(05).
   05 AC-ACCT-HASH PIC X(16).
FD BAL-FILE.
01 BAL-REC.
   05 BAL-ACCT-ID PIC X(12).
   05 BAL-LEDGER PIC S9(15)V99 COMP-3.
   05 BAL-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BAL-BLOCKED PIC S9(15)V99 COMP-3.
   05 BAL-CURRENCY PIC X(03).
   05 BAL-UPDATED PIC 9(08).
   05 BAL-SEQ PIC 9(12).

WORKING-STORAGE SECTION.
01 WS-CUST-PATH PIC X(200).
01 WS-ACCT-PATH PIC X(200).
01 WS-BAL-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CUST-ST PIC X(02).
01 WS-ACCT-ST PIC X(02).
01 WS-BAL-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-N-CUST PIC 9(09) VALUE 0.
01 WS-N-ACCT PIC 9(09) VALUE 0.
01 WS-N-BAL PIC 9(09) VALUE 0.
01 WS-TOT-LEDGER PIC S9(15)V99 COMP-3 VALUE 0.
01 WS-TB-RC PIC X(02).
01 WS-TB-MSG PIC X(80).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BPAYEODP".
COPY "BRECP".
COPY "BPXSLP".
COPY "BPXMBP".
COPY "BEODRP".
COPY "BKEODCP".
01 WS-EODCHK-DATA.
   COPY "BKEODC".
01 WS-SKIP PIC X(01).
01 WS-I PIC 9(02).
01 WS-DONE PIC X(30).
01 WS-EVT-PAYLOAD PIC X(200).
01 WS-REC-FAIL PIC X(01) VALUE "N".
01 WS-REC-LED-ID PIC X(20).
01 WS-REC-PAY-ID PIC X(20).
01 WS-REC-TXN-ID PIC X(20).
01 WS-REC-CRD-ID PIC X(20).
01 WS-CRD-RC PIC X(02).
01 WS-CRD-MSG PIC X(80).
01 WS-REC-LN-ID PIC X(20).
01 WS-LN-RC PIC X(02).
01 WS-LN-MSG PIC X(80).
01 WS-REC-COL-ID PIC X(20).
01 WS-COL-RC PIC X(02).
01 WS-COL-MSG PIC X(80).
01 WS-REC-CLT-ID PIC X(20).
01 WS-REC-CCR-ID PIC X(20).
01 WS-CRC-RC PIC X(02).
01 WS-CRC-MSG PIC X(80).
01 WS-PX-EOD-MSG PIC X(80).
01 WS-PX-EOD-RC PIC X(02).
01 WS-MEDB-INFO PIC X(80).
01 WS-REC-PIX-ID PIC X(20).
01 WS-REC-JRN-ID PIC X(20).
01 WS-REC-BND-ID PIC X(20).
01 WS-CLT-RC PIC X(02).
01 WS-CLT-MSG PIC X(80).

LINKAGE SECTION.
01 LS-RC PIC X(02).
01 LS-MSG PIC X(80).
01 LS-MODE PIC X(06).

PROCEDURE DIVISION USING LS-RC LS-MSG LS-MODE.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    PERFORM RESOLVE-PATHS
    PERFORM INIT-CHECKPOINT
    MOVE 1 TO EC-STAGE-NO
    MOVE "TRIAL-LEDGER" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        CALL "BGLTB" USING WS-TB-RC WS-TB-MSG
        IF WS-TB-RC NOT = "00"
            PERFORM FAIL-CHECKPOINT
            MOVE WS-TB-RC TO LS-RC
            MOVE WS-TB-MSG TO LS-MSG
            GOBACK
        END-IF
        PERFORM END-STAGE
    END-IF
    MOVE 2 TO EC-STAGE-NO
    MOVE "COUNT-CUSTOMERS" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM COUNT-CUSTOMERS PERFORM END-STAGE
    END-IF
    MOVE 3 TO EC-STAGE-NO
    MOVE "COUNT-ACCOUNTS" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM COUNT-ACCOUNTS PERFORM END-STAGE
    END-IF
    MOVE 4 TO EC-STAGE-NO
    MOVE "COUNT-BALANCES" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM COUNT-BALANCES PERFORM END-STAGE
    END-IF
    MOVE 5 TO EC-STAGE-NO
    MOVE "RECON-PAYMENTS" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-PAYMENTS
        IF PE-RC NOT = "00"
            PERFORM FAIL-CHECKPOINT
            MOVE PE-RC TO LS-RC
            MOVE PE-MSG TO LS-MSG
            GOBACK
        END-IF
        PERFORM END-STAGE
    END-IF
    MOVE 6 TO EC-STAGE-NO
    MOVE "RECON-LEDGER" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM RECONCILE-LEDGER PERFORM END-STAGE
    END-IF
    MOVE 7 TO EC-STAGE-NO
    MOVE "RECON-PAYMENT" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-PAYMENT-RUN PERFORM END-STAGE
    END-IF
    MOVE 8 TO EC-STAGE-NO
    MOVE "RECON-TRANSACTION" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-TRANSACTION-RUN PERFORM END-STAGE
    END-IF
    MOVE 9 TO EC-STAGE-NO
    MOVE "RECON-JOURNAL" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-JOURNAL-RUN PERFORM END-STAGE
    END-IF
    MOVE 10 TO EC-STAGE-NO
    MOVE "RECON-BOUNDARY" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-BOUNDARY-RUN PERFORM END-STAGE
    END-IF
    MOVE 11 TO EC-STAGE-NO
    MOVE "CREDIT-EOD" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM CREDIT-EOD PERFORM END-STAGE
    END-IF
    MOVE 12 TO EC-STAGE-NO
    MOVE "RECON-CREDIT" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-CREDIT-RUN PERFORM END-STAGE
    END-IF
    MOVE 13 TO EC-STAGE-NO
    MOVE "LOAN-EOD" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM LOAN-EOD PERFORM END-STAGE
    END-IF
    MOVE 14 TO EC-STAGE-NO
    MOVE "RECON-LOAN" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-LOAN-RUN PERFORM END-STAGE
    END-IF
    MOVE 15 TO EC-STAGE-NO
    MOVE "COLLECTION-EOD" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM COLLECTION-EOD PERFORM END-STAGE
    END-IF
    MOVE 16 TO EC-STAGE-NO
    MOVE "RECON-COLLECTION" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-COLLECTION-RUN PERFORM END-STAGE
    END-IF
    MOVE 17 TO EC-STAGE-NO
    MOVE "COLLATERAL-EOD" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM COLLATERAL-EOD PERFORM END-STAGE
    END-IF
    MOVE 18 TO EC-STAGE-NO
    MOVE "RECON-COLLATERAL" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-COLLATERAL-RUN PERFORM END-STAGE
    END-IF
    MOVE 19 TO EC-STAGE-NO
    MOVE "CARDS-EOD" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM CARDS-EOD PERFORM END-STAGE
    END-IF
    MOVE 20 TO EC-STAGE-NO
    MOVE "RECON-CARDCLR" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-CARDCLR-RUN PERFORM END-STAGE
    END-IF
    MOVE 21 TO EC-STAGE-NO
    MOVE "PIX-SETTLEMENT" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM PIX-SETTLEMENT-EOD PERFORM END-STAGE
    END-IF
    MOVE 22 TO EC-STAGE-NO
    MOVE "RECON-PIXSTL" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y"
        PERFORM RECONCILE-PIXSTL-RUN PERFORM END-STAGE
    END-IF
    MOVE 23 TO EC-STAGE-NO
    MOVE "MED-BATCH" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM MED-BATCH-EOD PERFORM END-STAGE
    END-IF
    MOVE 24 TO EC-STAGE-NO
    MOVE "WRITE-REPORT" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM WRITE-REPORT PERFORM END-STAGE
    END-IF
    MOVE 25 TO EC-STAGE-NO
    MOVE "AUDIT-EOD" TO EC-CUR-STAGE
    PERFORM BEGIN-STAGE
    IF WS-SKIP NOT = "Y" PERFORM AUDIT-EOD PERFORM END-STAGE
    END-IF
    IF WS-REC-FAIL = "Y"
        MOVE "20" TO EC-RC OF BK-EODCHK-PARM
        PERFORM FAIL-CHECKPOINT
        MOVE "20" TO LS-RC
        MOVE "EOD STOPPED: RECONCILIATION EXCEPTIONS" TO LS-MSG
        GOBACK
    END-IF
    MOVE "FINISH" TO EC-OP OF BK-EODCHK-PARM
    MOVE "OK" TO EC-STATE OF BK-EODCHK-PARM
    MOVE "EOD COMPLETE" TO EC-MSG OF BK-EODCHK-PARM
    MOVE "00" TO EC-RC OF BK-EODCHK-PARM
    CALL "BEODCHK" USING BK-EODCHK-PARM WS-EODCHK-DATA
    MOVE "EOD COMPLETE" TO LS-MSG
    GOBACK.

INIT-CHECKPOINT.
    MOVE WS-BIZDATE TO EC-BIZDATE OF BK-EODCHK-PARM
    MOVE "BATCH" TO EC-OPERATOR OF BK-EODCHK-PARM
    IF LS-MODE = "RESUME"
        MOVE "GET" TO EC-OP OF BK-EODCHK-PARM
        CALL "BEODCHK" USING BK-EODCHK-PARM WS-EODCHK-DATA
        IF EC-RC OF BK-EODCHK-PARM NOT = "00"
            MOVE EC-RC OF BK-EODCHK-PARM TO LS-RC
            MOVE "NO EOD CHECKPOINT TO RESUME" TO LS-MSG
            GOBACK
        END-IF
    ELSE
        MOVE "INIT" TO EC-OP OF BK-EODCHK-PARM
        CALL "BEODCHK" USING BK-EODCHK-PARM WS-EODCHK-DATA
        IF EC-RC OF BK-EODCHK-PARM NOT = "00"
            MOVE EC-RC OF BK-EODCHK-PARM TO LS-RC
            MOVE EC-MSG OF BK-EODCHK-PARM TO LS-MSG
            GOBACK
        END-IF
    END-IF
    IF LS-MODE = "RESUME"
        PERFORM LOAD-DONE
    ELSE
        MOVE SPACES TO WS-DONE
    END-IF.

FAIL-CHECKPOINT.
    MOVE "FINISH" TO EC-OP OF BK-EODCHK-PARM
    MOVE "FAIL" TO EC-STATE OF BK-EODCHK-PARM
    MOVE "EOD STAGE FAILED" TO EC-MSG OF BK-EODCHK-PARM
    MOVE "20" TO EC-RC OF BK-EODCHK-PARM
    CALL "BEODCHK" USING BK-EODCHK-PARM WS-EODCHK-DATA.

BEGIN-STAGE.
    MOVE "N" TO WS-SKIP
    IF WS-DONE (EC-STAGE-NO:1) = "Y"
        MOVE "Y" TO WS-SKIP
    END-IF.

LOAD-DONE.
    MOVE SPACES TO WS-DONE
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 30
        MOVE EC-STG OF WS-EODCHK-DATA (WS-I)
            TO WS-DONE (WS-I:1)
    END-PERFORM.

END-STAGE.
    MOVE EC-STAGE-NO TO WS-I
    IF WS-I >= 1 AND WS-I <= 30
        MOVE "Y" TO WS-DONE (WS-I:1)
    END-IF
    MOVE "STAGE" TO EC-OP OF BK-EODCHK-PARM
    CALL "BEODCHK" USING BK-EODCHK-PARM WS-EODCHK-DATA.

RECONCILE-PAYMENTS.
    CALL "BPAYEOD" USING BK-PAY-EOD.

RECONCILE-LEDGER.
    MOVE "RUN" TO RP-OP
    MOVE "LEDGER" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-LED-ID
    PERFORM CHECK-REC-RESULT.

RECONCILE-PAYMENT-RUN.
    MOVE "RUN" TO RP-OP
    MOVE "PAYMENT" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-PAY-ID
    PERFORM CHECK-REC-RESULT.

RECONCILE-TRANSACTION-RUN.
    MOVE "RUN" TO RP-OP
    MOVE "TXN" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-TXN-ID
    PERFORM CHECK-REC-RESULT.

RECONCILE-JOURNAL-RUN.
    MOVE "RUN" TO RP-OP
    MOVE "JOURNAL" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-JRN-ID
    PERFORM CHECK-REC-RESULT.

RECONCILE-BOUNDARY-RUN.
    MOVE "RUN" TO RP-OP
    MOVE "BOUNDARY" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-BND-ID
    PERFORM CHECK-REC-RESULT.

CREDIT-EOD.
    CALL "BCRCRDEOD" USING WS-CRD-RC WS-CRD-MSG
    IF WS-CRD-RC NOT = "00"
        MOVE "Y" TO WS-REC-FAIL
    END-IF.

RECONCILE-CREDIT-RUN.
    MOVE "RUN" TO RP-OP
    MOVE "CREDIT" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-CRD-ID
    PERFORM CHECK-REC-RESULT.

LOAN-EOD.
    CALL "BLNCEOD" USING WS-LN-RC WS-LN-MSG
    IF WS-LN-RC NOT = "00"
        MOVE "Y" TO WS-REC-FAIL
    END-IF.

RECONCILE-LOAN-RUN.
    MOVE "RUN" TO RP-OP
    MOVE "LOAN" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-LN-ID
    PERFORM CHECK-REC-RESULT.

COLLECTION-EOD.
    CALL "COLCEOD" USING WS-COL-RC WS-COL-MSG
    IF WS-COL-RC NOT = "00"
        MOVE "Y" TO WS-REC-FAIL
    END-IF.

COLLATERAL-EOD.
    CALL "CLTEOD" USING WS-CLT-RC WS-CLT-MSG
    IF WS-CLT-RC NOT = "00"
        MOVE "Y" TO WS-REC-FAIL
    END-IF.

RECONCILE-COLLATERAL-RUN.
    MOVE "RUN" TO RP-OP
    MOVE "CLTREG" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-CLT-ID
    PERFORM CHECK-REC-RESULT.

CARDS-EOD.
    CALL "CCRCEOD" USING WS-CRC-RC WS-CRC-MSG
    IF WS-CRC-RC NOT = "00"
        MOVE "Y" TO WS-REC-FAIL
    END-IF.

RECONCILE-CARDCLR-RUN.
    MOVE "RUN" TO RP-OP
    MOVE "CARDCLR" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-CCR-ID
    PERFORM CHECK-REC-RESULT.

PIX-SETTLEMENT-EOD.
    MOVE SPACES TO BK-PX-STL-PARMS
    MOVE "PIX-EOD" TO SL-OP
    CALL "BPXEOD" USING BK-PX-STL-PARMS
    MOVE SL-RC TO WS-PX-EOD-RC
    MOVE SL-MSG TO WS-PX-EOD-MSG
    IF SL-RC NOT = "00"
        MOVE "Y" TO WS-REC-FAIL
    END-IF.

RECONCILE-PIXSTL-RUN.
    MOVE "RUN" TO RP-OP
    MOVE "PIXSTL" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-PIX-ID
    IF RP-RC NOT = "00" AND RP-RC NOT = "24"
        MOVE "Y" TO WS-REC-FAIL
    END-IF.

MED-BATCH-EOD.
    MOVE SPACES TO BK-MED-BATCH
    MOVE "PROCESS" TO MB-OP
    MOVE "BATCH" TO MB-OPERATOR
    MOVE WS-BIZDATE TO MB-CORR
    CALL "BPXMEOD" USING BK-MED-BATCH
    IF MB-RC NOT = "00"
        MOVE "Y" TO WS-REC-FAIL
    END-IF
    MOVE SPACES TO WS-MEDB-INFO
    STRING "MEDBATCH rc=" DELIMITED SIZE MB-RC DELIMITED SIZE
        "|exp=" DELIMITED SIZE MB-EXPIRED OF BK-MED-BATCH
        DELIMITED SIZE "|rtr=" DELIMITED SIZE
        MB-RETRIED OF BK-MED-BATCH DELIMITED SIZE "|rfsh="
        DELIMITED SIZE MB-REFRESHED OF BK-MED-BATCH
        DELIMITED SIZE "|skip=" DELIMITED SIZE
        MB-SKIPPED OF BK-MED-BATCH DELIMITED SIZE "|fail="
        DELIMITED SIZE MB-FAILED OF BK-MED-BATCH DELIMITED SIZE
        INTO WS-MEDB-INFO
    END-STRING.

RECONCILE-COLLECTION-RUN.
    MOVE "RUN" TO RP-OP
    MOVE "COLLECT" TO RP-TYPE
    MOVE SPACES TO RP-RUN-ID
    MOVE "BATCH" TO RP-OPERATOR
    MOVE WS-BIZDATE TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    MOVE RP-RUN-ID TO WS-REC-COL-ID
    PERFORM CHECK-REC-RESULT.

CHECK-REC-RESULT.
    IF RP-RC = "00"
        IF RP-OPEN-EXC > 0
            MOVE "Y" TO WS-REC-FAIL
        END-IF
        EXIT PARAGRAPH
    END-IF
    IF RP-RC = "24"
        EXIT PARAGRAPH
    END-IF
    MOVE "Y" TO WS-REC-FAIL.

RESOLVE-PATHS.
    MOVE SPACES TO WS-CUST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cust.idx"
        DELIMITED SIZE INTO WS-CUST-PATH
    MOVE SPACES TO WS-ACCT-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/acct.idx"
        DELIMITED SIZE INTO WS-ACCT-PATH
    MOVE SPACES TO WS-BAL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/acctbal.idx"
        DELIMITED SIZE INTO WS-BAL-PATH.

COUNT-CUSTOMERS.
    OPEN INPUT CUST-FILE
    IF WS-CUST-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CUST-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END ADD 1 TO WS-N-CUST
        END-READ
    END-PERFORM
    CLOSE CUST-FILE.

COUNT-ACCOUNTS.
    OPEN INPUT ACCT-FILE
    IF WS-ACCT-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ ACCT-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END ADD 1 TO WS-N-ACCT
        END-READ
    END-PERFORM
    CLOSE ACCT-FILE.

COUNT-BALANCES.
    OPEN INPUT BAL-FILE
    IF WS-BAL-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ BAL-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                ADD 1 TO WS-N-BAL
                ADD BAL-LEDGER TO WS-TOT-LEDGER
        END-READ
    END-PERFORM
    CLOSE BAL-FILE.

WRITE-REPORT.
    MOVE WS-BIZDATE TO ER-BIZDATE
    MOVE WS-N-CUST TO ER-N-CUST
    MOVE WS-N-ACCT TO ER-N-ACCT
    MOVE WS-N-BAL TO ER-N-BAL
    MOVE WS-TOT-LEDGER TO ER-TOT-LEDGER
    MOVE PE-TOTAL TO ER-PE-TOTAL
    MOVE PE-SETTLED TO ER-PE-SETTLED
    MOVE PE-PENDING TO ER-PE-PENDING
    MOVE PE-FAILED TO ER-PE-FAILED
    MOVE PE-RETURNED TO ER-PE-RETURNED
    MOVE PE-REVERSED TO ER-PE-REVERSED
    MOVE PE-BROKEN TO ER-PE-BROKEN
    MOVE PE-SETTLED-AMT TO ER-PE-SETTLED-AMT
