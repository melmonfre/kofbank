IDENTIFICATION DIVISION.
PROGRAM-ID. BLNCEOD.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT LOAN-FILE ASSIGN TO WS-LOAN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS LN-ID
        FILE STATUS IS WS-LOAN-ST.
    SELECT INST-FILE ASSIGN TO WS-INST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS LI-KEY
        FILE STATUS IS WS-INST-ST.

DATA DIVISION.
FILE SECTION.
FD LOAN-FILE.
01 LOAN-REC.
   COPY "BLN".
FD INST-FILE.
01 INST-REC.
   COPY "BLNI".

WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BLNSTO".
COPY "BLNOP".
COPY "BCRSTO".
COPY "BCREXP".
01 WS-LOAN-PATH PIC X(200).
01 WS-INST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-LOAN-ST PIC X(02).
01 WS-INST-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-OVERDUE PIC S9(15)V99 COMP-3.
01 WS-DUE PIC S9(15)V99 COMP-3.
01 WS-PAID PIC S9(15)V99 COMP-3.
01 WS-OVERDUE-N PIC 9(05) VALUE 0.
01 WS-N-FAC PIC 9(05) VALUE 0.
01 WS-FAC-MAX PIC 9(05) VALUE 100.
01 WS-FT.
   05 WS-F-ROW OCCURS 100 TIMES.
      10 WS-F-ID PIC X(12).
      10 WS-F-AMT PIC S9(15)V99 COMP-3.
01 WS-I PIC 9(05).
01 WS-J PIC 9(05).

LINKAGE SECTION.
01 LS-RC PIC X(02).
01 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-RC LS-MSG.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    MOVE SPACES TO WS-LOAN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/loans.idx"
        DELIMITED SIZE INTO WS-LOAN-PATH
    MOVE SPACES TO WS-INST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/loaninst.idx"
        DELIMITED SIZE INTO WS-INST-PATH
    MOVE 0 TO WS-N-FAC
    PERFORM PROCESS-LOANS
    PERFORM FLUSH-FACILITIES
    MOVE SPACES TO LS-MSG
    STRING "LOAN EOD OVERDUE=" DELIMITED SIZE WS-OVERDUE-N
        DELIMITED SIZE INTO LS-MSG
    END-STRING
    GOBACK.

PROCESS-LOANS.
    OPEN INPUT LOAN-FILE
    IF WS-LOAN-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ LOAN-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM PROCESS-LOAN
        END-READ
    END-PERFORM
    CLOSE LOAN-FILE.

PROCESS-LOAN.
    IF LN-STATUS OF LOAN-REC = "CLO" OR LN-STATUS OF LOAN-REC = "CAN"
        OR LN-STATUS OF LOAN-REC = "SET" OR LN-STATUS OF LOAN-REC = "MAT"
        EXIT PARAGRAPH
    END-IF
    IF LN-DISBURSED OF LOAN-REC <= 0
        EXIT PARAGRAPH
    END-IF
    PERFORM SUM-OVERDUE
    IF WS-OVERDUE = 0
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-OVERDUE-N
    MOVE "SET-OVERDUE" TO CL-OP
    MOVE LN-ID OF LOAN-REC TO CL-LOAN-ID
    MOVE WS-OVERDUE TO CL-AMOUNT
    CALL "BLNUPD" USING BK-LN-PARMS
    PERFORM ACCUM-FACILITY.

SUM-OVERDUE.
    MOVE 0 TO WS-OVERDUE
    OPEN I-O INST-FILE
    IF WS-INST-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE LN-ID OF LOAN-REC TO LI-LOAN-ID OF INST-REC
    MOVE 0 TO LI-NUMBER OF INST-REC
    START INST-FILE KEY >= LI-KEY OF INST-REC
        INVALID KEY MOVE "Y" TO WS-EOF
    END-START
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ INST-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF LI-LOAN-ID OF INST-REC NOT = LN-ID OF LOAN-REC
                    MOVE "Y" TO WS-EOF
                ELSE
                    PERFORM CHECK-INSTALLMENT
                END-IF
        END-READ
    END-PERFORM
    CLOSE INST-FILE.

CHECK-INSTALLMENT.
    IF LI-STATUS OF INST-REC = "PA"
        EXIT PARAGRAPH
    END-IF
    IF LI-DUE-DATE OF INST-REC >= WS-BIZDATE
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-DUE = LI-TOTAL OF INST-REC
    COMPUTE WS-PAID = LI-PAID-PRIN OF INST-REC
        + LI-PAID-INT OF INST-REC + LI-PAID-FEE OF INST-REC
    COMPUTE WS-DUE = WS-DUE - WS-PAID
    IF WS-DUE > 0
        ADD WS-DUE TO WS-OVERDUE
    END-IF
    IF LI-STATUS OF INST-REC = "SC" OR LI-STATUS OF INST-REC = "PT"
        MOVE "OD" TO LI-STATUS OF INST-REC
        MOVE WS-BIZDATE TO LI-UPDATED OF INST-REC
        ADD 1 TO LI-VERSION OF INST-REC
        REWRITE INST-REC
    END-IF.

ACCUM-FACILITY.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-FAC
        IF WS-F-ID(WS-I) = LN-FAC-ID OF LOAN-REC
            ADD WS-OVERDUE TO WS-F-AMT(WS-I)
            EXIT PARAGRAPH
        END-IF
    END-PERFORM
    IF WS-N-FAC >= WS-FAC-MAX
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-N-FAC
    MOVE LN-FAC-ID OF LOAN-REC TO WS-F-ID(WS-N-FAC)
    MOVE WS-OVERDUE TO WS-F-AMT(WS-N-FAC).

FLUSH-FACILITIES.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-FAC
        MOVE "SETOVDUE" TO CE-OP
        MOVE WS-F-ID(WS-I) TO CE-FAC-ID
        MOVE WS-F-AMT(WS-I) TO CE-AMOUNT
        CALL "BCRUPD" USING BK-CR-EXP-PARMS
    END-PERFORM.
