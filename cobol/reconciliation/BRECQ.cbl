IDENTIFICATION DIVISION.
PROGRAM-ID. BRECQ.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT REC-FILE ASSIGN TO WS-REC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS REC-RUN-ID
        FILE STATUS IS WS-REC-ST.
    SELECT EXC-FILE ASSIGN TO WS-EXC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS EXC-ID
        FILE STATUS IS WS-EXC-ST.

DATA DIVISION.
FILE SECTION.
FD REC-FILE.
01 REC-REC.
   COPY "BREC".
FD EXC-FILE.
01 EXC-REC.
   COPY "BRECE".

WORKING-STORAGE SECTION.
01 WS-REC-PATH PIC X(200).
01 WS-EXC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-REC-ST PIC X(02).
01 WS-EXC-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-COUNT PIC 9(09).

LINKAGE SECTION.
01 LS-OP PIC X(08).
01 LS-RUN-ID PIC X(20).
01 LS-RC PIC X(02).

PROCEDURE DIVISION USING LS-OP LS-RUN-ID LS-RC.
    MOVE "00" TO LS-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-REC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/rec.idx"
        DELIMITED SIZE INTO WS-REC-PATH
    MOVE SPACES TO WS-EXC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/recexc.idx"
        DELIMITED SIZE INTO WS-EXC-PATH
    EVALUATE LS-OP
        WHEN "GET" PERFORM DO-GET
        WHEN "LIST" PERFORM DO-LIST
        WHEN "EXC" PERFORM DO-EXC
        WHEN OTHER MOVE "99" TO LS-RC
    END-EVALUATE
    GOBACK.

DO-GET.
    OPEN INPUT REC-FILE
    IF WS-REC-ST NOT = "00"
        MOVE "35" TO LS-RC
        GOBACK
    END-IF
    MOVE LS-RUN-ID TO REC-RUN-ID
    READ REC-FILE
    IF WS-REC-ST = "00"
        PERFORM SHOW-RUN
    ELSE
        MOVE "23" TO LS-RC
    END-IF
    CLOSE REC-FILE.

DO-LIST.
    OPEN INPUT REC-FILE
    IF WS-REC-ST NOT = "00"
        MOVE "35" TO LS-RC
        GOBACK
    END-IF
    MOVE 0 TO WS-COUNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ REC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                ADD 1 TO WS-COUNT
                PERFORM SHOW-RUN
        END-READ
    END-PERFORM
    CLOSE REC-FILE
    DISPLAY "runs=" WS-COUNT.

DO-EXC.
    OPEN INPUT EXC-FILE
    IF WS-EXC-ST NOT = "00"
        MOVE "35" TO LS-RC
        GOBACK
    END-IF
    MOVE 0 TO WS-COUNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ EXC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF EXC-RUN-ID = LS-RUN-ID
                    ADD 1 TO WS-COUNT
                    PERFORM SHOW-EXC
                END-IF
        END-READ
    END-PERFORM
    CLOSE EXC-FILE
    DISPLAY "exceptions=" WS-COUNT.

SHOW-RUN.
    DISPLAY "run=" FUNCTION TRIM(REC-RUN-ID)
    DISPLAY "type=" FUNCTION TRIM(REC-TYPE)
    DISPLAY "status=" FUNCTION TRIM(REC-STATUS)
    DISPLAY "source=" REC-SRC-COUNT
    DISPLAY "matched=" REC-MATCHED
    DISPLAY "unmatched-internal=" REC-UNMATCHED-I
    DISPLAY "unmatched-external=" REC-UNMATCHED-E
    DISPLAY "exceptions=" REC-EXCEPTIONS
    DISPLAY "open=" REC-OPEN-EXC
    DISPLAY "adjustments=" REC-ADJUSTMENTS.

SHOW-EXC.
    DISPLAY "exc=" FUNCTION TRIM(EXC-ID)
    DISPLAY "code=" FUNCTION TRIM(EXC-CODE)
    DISPLAY "status=" FUNCTION TRIM(EXC-STATUS)
    DISPLAY "key=" FUNCTION TRIM(EXC-KEY)
    DISPLAY "reason=" FUNCTION TRIM(EXC-REASON)
    DISPLAY "resolution=" FUNCTION TRIM(EXC-RESOLUTION).
