IDENTIFICATION DIVISION.
PROGRAM-ID. BRECLGR.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT GL-FILE ASSIGN TO WS-GL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS GL-CODE
        FILE STATUS IS WS-GL-ST.
    SELECT BAL-FILE ASSIGN TO WS-BAL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS BAL-ACCT-ID
        FILE STATUS IS WS-BAL-ST.
    SELECT PST-FILE ASSIGN TO WS-PST-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-PST-ST.

DATA DIVISION.
FILE SECTION.
FD GL-FILE.
01 GL-REC.
   05 GL-CODE PIC X(10).
   05 GL-NAME PIC X(40).
   05 GL-TYPE PIC X(01).
   05 GL-STATUS PIC X(01).
FD BAL-FILE.
01 BAL-REC.
   05 BAL-ACCT-ID PIC X(12).
   05 BAL-LEDGER PIC S9(15)V99 COMP-3.
   05 BAL-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BAL-BLOCKED PIC S9(15)V99 COMP-3.
   05 BAL-CURRENCY PIC X(03).
   05 BAL-UPDATED PIC 9(08).
   05 BAL-SEQ PIC 9(12).
FD PST-FILE.
01 PST-LINE PIC X(300).

WORKING-STORAGE SECTION.
01 WS-GL-PATH PIC X(200).
01 WS-BAL-PATH PIC X(200).
01 WS-PST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-GL-ST PIC X(02).
01 WS-BAL-ST PIC X(02).
01 WS-PST-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-I PIC 9(05).
01 WS-J PIC 9(05).
01 WS-FOUND PIC X(01).
01 WS-CNT PIC 9(09).
01 WS-TYPE PIC X(01).
01 WS-DELTA PIC S9(15)V99 COMP-3.
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT-STR PIC X(30).
01 WS-TAG PIC X(04).
01 WS-GL PIC X(10).
01 WS-DC PIC X(01).
01 WS-ENTITY PIC X(20).
01 WS-CUR PIC X(03).
01 WS-JRN PIC X(20).
01 WS-DATE PIC X(08).
01 WS-N-GL PIC 9(05) VALUE 0.
01 WS-GL-MAX PIC 9(05) VALUE 100.
01 WS-GLT.
   05 WS-GL-ROW OCCURS 100 TIMES.
      10 WS-GL-C PIC X(10).
      10 WS-GL-T PIC X(01).
01 WS-N-BAL PIC 9(05) VALUE 0.
01 WS-BAL-MAX PIC 9(05) VALUE 200.
01 WS-BALT.
   05 WS-BAL-ROW OCCURS 200 TIMES.
      10 WS-B-C PIC X(12).
      10 WS-B-LED PIC S9(15)V99 COMP-3.
      10 WS-B-REC PIC S9(15)V99 COMP-3.
      10 WS-B-MATCH PIC X(01).
01 WS-N-ORPH PIC 9(05) VALUE 0.
01 WS-ORPH-MAX PIC 9(05) VALUE 200.
01 WS-ORPHT.
   05 WS-ORPH-ROW OCCURS 200 TIMES.
      10 WS-O-C PIC X(20).

01 BK-EXC-REC.
   COPY "BRECE".
LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-GL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/gl.idx"
        DELIMITED SIZE INTO WS-GL-PATH
    MOVE SPACES TO WS-BAL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/acctbal.idx"
        DELIMITED SIZE INTO WS-BAL-PATH
    MOVE SPACES TO WS-PST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/postings.log"
        DELIMITED SIZE INTO WS-PST-PATH
    MOVE 0 TO WS-N-GL
    MOVE 0 TO WS-N-BAL
    MOVE 0 TO WS-N-ORPH
    PERFORM LOAD-CHART
    PERFORM LOAD-BALANCES
    PERFORM LOAD-POSTINGS
    PERFORM COMPARE-BALANCES
    PERFORM RAISE-ORPHANS
    GOBACK.

LOAD-CHART.
    OPEN INPUT GL-FILE
    IF WS-GL-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ GL-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-N-GL < WS-GL-MAX
                    ADD 1 TO WS-N-GL
                    MOVE GL-CODE TO WS-GL-C(WS-N-GL)
                    MOVE GL-TYPE TO WS-GL-T(WS-N-GL)
                END-IF
        END-READ
    END-PERFORM
    CLOSE GL-FILE.

LOAD-BALANCES.
    OPEN INPUT BAL-FILE
    IF WS-BAL-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ BAL-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-BALANCE
        END-READ
    END-PERFORM
    CLOSE BAL-FILE
    MOVE WS-N-BAL TO REC-INT-COUNT.

ADD-BALANCE.
    IF WS-N-BAL >= WS-BAL-MAX
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-N-BAL
    MOVE BAL-ACCT-ID TO WS-B-C(WS-N-BAL)
    MOVE BAL-LEDGER TO WS-B-LED(WS-N-BAL)
    MOVE 0 TO WS-B-REC(WS-N-BAL)
    MOVE "N" TO WS-B-MATCH(WS-N-BAL).

LOAD-POSTINGS.
    OPEN INPUT PST-FILE
    IF WS-PST-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE 0 TO WS-CNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PST-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM APPLY-POSTING
        END-READ
    END-PERFORM
    CLOSE PST-FILE
    MOVE WS-CNT TO REC-SRC-COUNT.

APPLY-POSTING.
    IF PST-LINE(1:4) NOT = "GLP|"
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-CNT
    MOVE SPACES TO WS-TAG WS-GL WS-DC WS-AMT-STR WS-ENTITY
        WS-CUR WS-JRN WS-DATE
    UNSTRING PST-LINE DELIMITED BY "|"
        INTO WS-TAG WS-GL WS-DC WS-AMT-STR WS-ENTITY WS-CUR
        WS-JRN WS-DATE
    END-UNSTRING
    IF WS-ENTITY = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE 0 TO WS-AMT
    MOVE WS-AMT-STR TO WS-AMT
    PERFORM FIND-GL-TYPE
    MOVE WS-AMT TO WS-DELTA
    IF WS-TYPE = "A" AND WS-DC = "C"
        MULTIPLY -1 BY WS-DELTA
    END-IF
    IF WS-TYPE = "L" AND WS-DC = "D"
        MULTIPLY -1 BY WS-DELTA
    END-IF
    PERFORM FIND-BALANCE
    IF WS-FOUND = "Y"
        ADD WS-DELTA TO WS-B-REC(WS-I)
    ELSE
        PERFORM ADD-ORPHAN
    END-IF.

FIND-GL-TYPE.
    MOVE SPACES TO WS-TYPE
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-GL
        IF WS-GL-C(WS-J) = WS-GL
            MOVE WS-GL-T(WS-J) TO WS-TYPE
            EXIT PERFORM
        END-IF
    END-PERFORM.

FIND-BALANCE.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-BAL
        IF WS-B-C(WS-I) = WS-ENTITY
            MOVE "Y" TO WS-FOUND
            EXIT PERFORM
        END-IF
    END-PERFORM.

ADD-ORPHAN.
    IF WS-N-ORPH >= WS-ORPH-MAX
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-FOUND
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-ORPH
        IF WS-O-C(WS-J) = WS-ENTITY
            MOVE "Y" TO WS-FOUND
            EXIT PERFORM
        END-IF
    END-PERFORM
    IF WS-FOUND = "N"
        ADD 1 TO WS-N-ORPH
        MOVE WS-ENTITY TO WS-O-C(WS-N-ORPH)
    END-IF.

COMPARE-BALANCES.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-BAL
        IF WS-B-REC(WS-I) = WS-B-LED(WS-I)
            ADD 1 TO REC-MATCHED
        ELSE
            ADD 1 TO REC-UNMATCHED-I
            PERFORM RAISE-MISMATCH
        END-IF
    END-PERFORM.

RAISE-MISMATCH.
    MOVE SPACES TO BK-EXC-REC
    MOVE "MISMATCH" TO EXC-CODE
    MOVE WS-B-C(WS-I) TO EXC-KEY
    MOVE WS-B-C(WS-I) TO EXC-INT-REF
    MOVE WS-B-LED(WS-I) TO EXC-AMOUNT
    MOVE "BRL" TO EXC-CURRENCY
    MOVE "BALANCE DOES NOT MATCH POSTINGS" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-ORPHANS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-ORPH
        MOVE SPACES TO BK-EXC-REC
        MOVE "ORPHAN" TO EXC-CODE
        MOVE WS-O-C(WS-I) TO EXC-KEY
        MOVE WS-O-C(WS-I) TO EXC-SRC-REF
        MOVE "POSTING WITHOUT BALANCE RECORD" TO EXC-REASON
        CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    END-PERFORM.
