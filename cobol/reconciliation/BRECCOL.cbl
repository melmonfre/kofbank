IDENTIFICATION DIVISION.
PROGRAM-ID. BRECCOL.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CASE-FILE ASSIGN TO WS-CASE-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CC-ID
        FILE STATUS IS WS-CASE-ST.
    SELECT REC-FILE ASSIGN TO WS-REC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS RV-ID
        FILE STATUS IS WS-REC-ST.

DATA DIVISION.
FILE SECTION.
FD CASE-FILE.
01 CASE-REC.
   COPY "COLC".
FD REC-FILE.
01 REC-REC.
   COPY "COLRC".

WORKING-STORAGE SECTION.
01 WS-CASE-PATH PIC X(200).
01 WS-REC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CASE-ST PIC X(02).
01 WS-REC-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-N-CASE PIC 9(05) VALUE 0.
01 WS-CASE-MAX PIC 9(05) VALUE 100.
01 WS-CT.
   05 WS-C-ROW OCCURS 100 TIMES.
      10 WS-C-ID PIC X(12).
      10 WS-C-RECOV PIC S9(15)V99 COMP-3.
01 WS-N-REC PIC 9(05) VALUE 0.
01 WS-REC-MAX PIC 9(05) VALUE 300.
01 WS-RT.
   05 WS-R-ROW OCCURS 300 TIMES.
      10 WS-R-CASE PIC X(12).
      10 WS-R-AMT PIC S9(15)V99 COMP-3.
      10 WS-R-STATUS PIC X(12).
01 WS-I PIC 9(05).
01 WS-K PIC 9(05).
01 WS-SUM PIC S9(15)V99 COMP-3.
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CASE-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/colcase.idx"
        DELIMITED SIZE INTO WS-CASE-PATH
    MOVE SPACES TO WS-REC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/colrec.idx"
        DELIMITED SIZE INTO WS-REC-PATH
    MOVE 0 TO WS-N-CASE
    MOVE 0 TO WS-N-REC
    PERFORM LOAD-CASES
    PERFORM LOAD-RECS
    PERFORM MATCH-CASES
    MOVE WS-N-CASE TO REC-SRC-COUNT
    GOBACK.

LOAD-CASES.
    OPEN INPUT CASE-FILE
    IF WS-CASE-ST = "35"
        EXIT PARAGRAPH
    END-IF
    IF WS-CASE-ST NOT = "00"
        MOVE "36" TO REC-RC
        MOVE "SOURCE FILE UNREADABLE" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CASE-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-N-CASE >= WS-CASE-MAX
                    MOVE "37" TO REC-RC
                    MOVE "CASE SOURCE LIMIT EXCEEDED" TO REC-MSG
                ELSE
                    ADD 1 TO WS-N-CASE
                    MOVE CC-ID OF CASE-REC TO WS-C-ID(WS-N-CASE)
                    MOVE CC-RECOVERED-AMT OF CASE-REC
                        TO WS-C-RECOV(WS-N-CASE)
                END-IF
        END-READ
    END-PERFORM
    CLOSE CASE-FILE.

LOAD-RECS.
    OPEN INPUT REC-FILE
    IF WS-REC-ST = "35"
        EXIT PARAGRAPH
    END-IF
    IF WS-REC-ST NOT = "00"
        MOVE "36" TO REC-RC
        MOVE "SOURCE FILE UNREADABLE" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ REC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-N-REC >= WS-REC-MAX
                    MOVE "37" TO REC-RC
                    MOVE "RECOVERY SOURCE LIMIT EXCEEDED" TO REC-MSG
                ELSE
                    ADD 1 TO WS-N-REC
                    MOVE RV-CASE-ID OF REC-REC TO WS-R-CASE(WS-N-REC)
                    MOVE RV-APPLIED OF REC-REC TO WS-R-AMT(WS-N-REC)
                    MOVE RV-STATUS OF REC-REC
                        TO WS-R-STATUS(WS-N-REC)
                END-IF
        END-READ
    END-PERFORM
    CLOSE REC-FILE.

MATCH-CASES.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-CASE
        PERFORM MATCH-ONE-CASE
    END-PERFORM.

MATCH-ONE-CASE.
    MOVE 0 TO WS-SUM
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-REC
        IF WS-R-CASE(WS-K) = WS-C-ID(WS-I)
            AND WS-R-STATUS(WS-K) = "POSTED"
            ADD WS-R-AMT(WS-K) TO WS-SUM
        END-IF
    END-PERFORM
    IF WS-SUM NOT = WS-C-RECOV(WS-I)
        ADD 1 TO REC-UNMATCHED-I
        MOVE SPACES TO BK-EXC-REC
        MOVE "MISMATCH" TO EXC-CODE
        MOVE WS-C-ID(WS-I) TO EXC-KEY
        MOVE WS-SUM TO EXC-AMOUNT
        MOVE "COLLECTION RECOVERED MISMATCH" TO EXC-REASON
        CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    ELSE
        ADD 1 TO REC-MATCHED
    END-IF.
