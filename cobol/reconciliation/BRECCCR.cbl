IDENTIFICATION DIVISION.
PROGRAM-ID. BRECCCR.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CLR-FILE ASSIGN TO WS-CLR-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CC-ID
        FILE STATUS IS WS-CLR-ST.
    SELECT STL-FILE ASSIGN TO WS-STL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CS-ID
        FILE STATUS IS WS-STL-ST.
    SELECT TXN-FILE ASSIGN TO WS-TXN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS TXN-ID
        FILE STATUS IS WS-TXN-ST.

DATA DIVISION.
FILE SECTION.
FD CLR-FILE.
01 CLR-REC.
   COPY "CCRC".
FD STL-FILE.
01 STL-REC.
   COPY "CCRS".
FD TXN-FILE.
01 TXN-REC.
   COPY "BTXREC".

WORKING-STORAGE SECTION.
01 WS-CLR-PATH PIC X(200).
01 WS-STL-PATH PIC X(200).
01 WS-TXN-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CLR-ST PIC X(02).
01 WS-STL-ST PIC X(02).
01 WS-TXN-ST PIC X(02).
01 WS-HAS-CLR PIC X(01).
01 WS-HAS-STL PIC X(01).
01 WS-HAS-TXN PIC X(01).
01 WS-EOF PIC X(01).
01 WS-N-CLR PIC 9(05) VALUE 0.
01 WS-CLR-MAX PIC 9(05) VALUE 2000.
01 WS-CT.
   05 WS-C-ROW OCCURS 2000 TIMES.
      10 WS-C-ID PIC X(12).
      10 WS-C-BATCH PIC X(12).
      10 WS-C-TXN PIC X(12).
      10 WS-C-AMT PIC S9(15)V99 COMP-3.
      10 WS-C-SSTAT PIC X(12).
      10 WS-C-RSTAT PIC X(12).
01 WS-I PIC 9(05).
01 WS-K PIC 9(05).
01 WS-B-CNT PIC 9(07).
01 WS-B-SUM PIC S9(15)V99 COMP-3.
01 BK-EXC-REC.
   COPY "BRECE".
01 WS-FUNCTION-CURRENT-DATE PIC X(14).

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CLR-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdclr.idx"
        DELIMITED SIZE INTO WS-CLR-PATH
    MOVE SPACES TO WS-STL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdstl.idx"
        DELIMITED SIZE INTO WS-STL-PATH
    MOVE SPACES TO WS-TXN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/txn.idx"
        DELIMITED SIZE INTO WS-TXN-PATH
    MOVE "N" TO WS-HAS-CLR
    MOVE "N" TO WS-HAS-STL
    MOVE "N" TO WS-HAS-TXN
    OPEN I-O CLR-FILE
    IF WS-CLR-ST = "00"
        MOVE "Y" TO WS-HAS-CLR
    END-IF
    OPEN I-O STL-FILE
    IF WS-STL-ST = "00"
        MOVE "Y" TO WS-HAS-STL
    END-IF
    OPEN INPUT TXN-FILE
    IF WS-TXN-ST = "00"
        MOVE "Y" TO WS-HAS-TXN
    END-IF
    MOVE 0 TO WS-N-CLR
    IF WS-HAS-CLR = "Y"
        PERFORM LOAD-CLEARINGS
    END-IF
    IF WS-HAS-STL = "Y"
        PERFORM CHECK-BATCHES
    END-IF
    IF WS-HAS-CLR = "Y"
        PERFORM CHECK-ORPHANS
    END-IF
    PERFORM CLOSE-ALL
    MOVE WS-N-CLR TO REC-SRC-COUNT
    GOBACK.

CLOSE-ALL.
    IF WS-HAS-CLR = "Y"
        CLOSE CLR-FILE
    END-IF
    IF WS-HAS-STL = "Y"
        CLOSE STL-FILE
    END-IF
    IF WS-HAS-TXN = "Y"
        CLOSE TXN-FILE
    END-IF.

LOAD-CLEARINGS.
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CLR-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-N-CLR >= WS-CLR-MAX
                    MOVE "Y" TO WS-EOF
                    MOVE "37" TO REC-RC
                    MOVE "CLEARING SOURCE LIMIT EXCEEDED" TO REC-MSG
                ELSE
                    ADD 1 TO WS-N-CLR
                    MOVE CC-ID OF CLR-REC TO WS-C-ID(WS-N-CLR)
                    MOVE CC-SETTLE-BATCH OF CLR-REC
                        TO WS-C-BATCH(WS-N-CLR)
                    MOVE CC-TXN-ID OF CLR-REC TO WS-C-TXN(WS-N-CLR)
                    MOVE CC-AMOUNT OF CLR-REC TO WS-C-AMT(WS-N-CLR)
                    MOVE CC-SETTLE-STATUS OF CLR-REC
                        TO WS-C-SSTAT(WS-N-CLR)
                    MOVE CC-RECON-STATUS OF CLR-REC
                        TO WS-C-RSTAT(WS-N-CLR)
                END-IF
        END-READ
    END-PERFORM.

CHECK-BATCHES.
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ STL-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-STL-ST NOT = "00"
                    MOVE "Y" TO WS-EOF
                ELSE
                    PERFORM MATCH-ONE-BATCH
                END-IF
        END-READ
    END-PERFORM.

MATCH-ONE-BATCH.
    MOVE 0 TO WS-B-CNT
    MOVE 0 TO WS-B-SUM
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-CLR
        IF WS-C-BATCH(WS-K) = CS-ID OF STL-REC
            ADD 1 TO WS-B-CNT
            ADD WS-C-AMT(WS-K) TO WS-B-SUM
        END-IF
    END-PERFORM
    IF WS-B-CNT NOT = CS-TOTAL-COUNT OF STL-REC OR
       WS-B-SUM NOT = CS-TOTAL-AMT OF STL-REC
        ADD 1 TO REC-UNMATCHED-I
        MOVE SPACES TO BK-EXC-REC
        MOVE "BATCH-TOTAL" TO EXC-CODE
        MOVE CS-ID OF STL-REC TO EXC-KEY
        MOVE WS-B-SUM TO EXC-AMOUNT
        MOVE "SETTLEMENT BATCH TOTAL MISMATCH" TO EXC-REASON
        CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    ELSE
        ADD 1 TO REC-MATCHED
        IF CS-STATUS OF STL-REC = "SETTLED" AND
           CS-RECON-STATUS OF STL-REC NOT = "RECONCILED"
            MOVE "RECONCILED" TO CS-RECON-STATUS OF STL-REC
            REWRITE STL-REC
            IF WS-STL-ST = "00"
                PERFORM MARK-MEMBERS-RECONCILED
            END-IF
        END-IF
    END-IF.

MARK-MEMBERS-RECONCILED.
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-CLR
        IF WS-C-BATCH(WS-K) = CS-ID OF STL-REC AND
           WS-C-RSTAT(WS-K) NOT = "RECONCILED"
            MOVE WS-C-ID(WS-K) TO CC-ID OF CLR-REC
            READ CLR-FILE
            IF WS-CLR-ST = "00"
                MOVE "RECONCILED" TO CC-RECON-STATUS OF CLR-REC
                MOVE FUNCTION CURRENT-DATE
                    TO WS-FUNCTION-CURRENT-DATE
                MOVE WS-FUNCTION-CURRENT-DATE(1:14)
                    TO CC-UPDATED OF CLR-REC
                ADD 1 TO CC-VERSION OF CLR-REC
                REWRITE CLR-REC
                IF WS-CLR-ST = "00"
                    MOVE "RECONCILED" TO WS-C-RSTAT(WS-K)
                END-IF
            END-IF
        END-IF
    END-PERFORM.

CHECK-ORPHANS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-CLR
        EVALUATE TRUE
            WHEN WS-C-BATCH(WS-I) NOT = SPACES
                PERFORM CHECK-BATCH-REF
            WHEN WS-C-SSTAT(WS-I) = "BATCHED" OR
                 WS-C-SSTAT(WS-I) = "SETTLED"
                PERFORM CHECK-BATCH-MISSING
            WHEN WS-C-SSTAT(WS-I) = "PENDING" CONTINUE
            WHEN WS-C-TXN(WS-I) NOT = SPACES CONTINUE
            WHEN OTHER CONTINUE
        END-EVALUATE
    END-PERFORM.

CHECK-BATCH-REF.
    IF WS-HAS-STL NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-C-BATCH(WS-I) TO CS-ID OF STL-REC
    READ STL-FILE
        INVALID KEY CONTINUE
    END-READ
    IF WS-STL-ST NOT = "00"
        ADD 1 TO REC-UNMATCHED-I
        MOVE SPACES TO BK-EXC-REC
        MOVE "MISSING-BATCH" TO EXC-CODE
        MOVE WS-C-ID(WS-I) TO EXC-KEY
        MOVE WS-C-AMT(WS-I) TO EXC-AMOUNT
        MOVE "CLEARING REFERENCES UNKNOWN BATCH" TO EXC-REASON
        CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    END-IF.

CHECK-BATCH-MISSING.
    ADD 1 TO REC-UNMATCHED-I
    MOVE SPACES TO BK-EXC-REC
    MOVE "UNBATCHED" TO EXC-CODE
    MOVE WS-C-ID(WS-I) TO EXC-KEY
    MOVE WS-C-AMT(WS-I) TO EXC-AMOUNT
    MOVE "SETTLED ITEM WITHOUT BATCH" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.
