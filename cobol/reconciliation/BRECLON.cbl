IDENTIFICATION DIVISION.
PROGRAM-ID. BRECLON.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT LOAN-FILE ASSIGN TO WS-LOAN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS LN-ID
        FILE STATUS IS WS-LOAN-ST.
    SELECT TXN-FILE ASSIGN TO WS-TXN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS TXN-ID
        FILE STATUS IS WS-TXN-ST.

DATA DIVISION.
FILE SECTION.
FD LOAN-FILE.
01 LOAN-REC.
   COPY "BLN".
FD TXN-FILE.
01 TXN-REC.
   COPY "BTXREC".

WORKING-STORAGE SECTION.
01 WS-LOAN-PATH PIC X(200).
01 WS-TXN-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-LOAN-ST PIC X(02).
01 WS-TXN-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-N-LOAN PIC 9(05) VALUE 0.
01 WS-LOAN-MAX PIC 9(05) VALUE 100.
01 WS-LT.
   05 WS-L-ROW OCCURS 100 TIMES.
      10 WS-L-ID PIC X(12).
      10 WS-L-OUT PIC S9(15)V99 COMP-3.
      10 WS-L-STATUS PIC X(04).
01 WS-N-TXN PIC 9(05) VALUE 0.
01 WS-TXN-MAX PIC 9(05) VALUE 200.
01 WS-TT.
   05 WS-T-ROW OCCURS 200 TIMES.
      10 WS-T-REF PIC X(24).
      10 WS-T-TYPE PIC X(08).
      10 WS-T-STATUS PIC X(02).
      10 WS-T-PRIN PIC S9(15)V99 COMP-3.
      10 WS-T-AMT PIC S9(15)V99 COMP-3.
01 WS-I PIC 9(05).
01 WS-K PIC 9(05).
01 WS-COMPUTED PIC S9(15)V99 COMP-3.
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-LOAN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/loans.idx"
        DELIMITED SIZE INTO WS-LOAN-PATH
    MOVE SPACES TO WS-TXN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/txn.idx"
        DELIMITED SIZE INTO WS-TXN-PATH
    MOVE 0 TO WS-N-LOAN
    MOVE 0 TO WS-N-TXN
    PERFORM LOAD-LOANS
    PERFORM LOAD-TXNS
    PERFORM MATCH-LOANS
    MOVE WS-N-LOAN TO REC-SRC-COUNT
    GOBACK.

LOAD-LOANS.
    OPEN INPUT LOAN-FILE
    IF WS-LOAN-ST = "35"
        EXIT PARAGRAPH
    END-IF
    IF WS-LOAN-ST NOT = "00"
        MOVE "36" TO REC-RC
        MOVE "SOURCE FILE UNREADABLE" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ LOAN-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-N-LOAN >= WS-LOAN-MAX
                    MOVE "37" TO REC-RC
                    MOVE "LOAN SOURCE LIMIT EXCEEDED" TO REC-MSG
                ELSE
                    ADD 1 TO WS-N-LOAN
                    MOVE LN-ID OF LOAN-REC TO WS-L-ID(WS-N-LOAN)
                    MOVE LN-OUTSTANDING OF LOAN-REC
                        TO WS-L-OUT(WS-N-LOAN)
                    MOVE LN-STATUS OF LOAN-REC
                        TO WS-L-STATUS(WS-N-LOAN)
                END-IF
        END-READ
    END-PERFORM
    CLOSE LOAN-FILE.

LOAD-TXNS.
    OPEN INPUT TXN-FILE
    IF WS-TXN-ST = "35"
        EXIT PARAGRAPH
    END-IF
    IF WS-TXN-ST NOT = "00"
        MOVE "36" TO REC-RC
        MOVE "SOURCE FILE UNREADABLE" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ TXN-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-N-TXN >= WS-TXN-MAX
                    MOVE "37" TO REC-RC
                    MOVE "TRANSACTION SOURCE LIMIT EXCEEDED" TO REC-MSG
                ELSE
                    ADD 1 TO WS-N-TXN
                    MOVE TXN-REF OF TXN-REC TO WS-T-REF(WS-N-TXN)
                    MOVE TXN-TYPE OF TXN-REC TO WS-T-TYPE(WS-N-TXN)
                    MOVE TXN-STATUS OF TXN-REC TO WS-T-STATUS(WS-N-TXN)
                    MOVE TXN-PRINCIPAL OF TXN-REC
                        TO WS-T-PRIN(WS-N-TXN)
                    MOVE TXN-AMOUNT OF TXN-REC TO WS-T-AMT(WS-N-TXN)
                END-IF
        END-READ
    END-PERFORM
    CLOSE TXN-FILE.

MATCH-LOANS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-LOAN
        PERFORM MATCH-ONE-LOAN
    END-PERFORM.

MATCH-ONE-LOAN.
    MOVE 0 TO WS-COMPUTED
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-TXN
        PERFORM ACCUMULATE-TXN
    END-PERFORM
    IF WS-COMPUTED NOT = WS-L-OUT(WS-I)
        ADD 1 TO REC-UNMATCHED-I
        MOVE SPACES TO BK-EXC-REC
        MOVE "MISMATCH" TO EXC-CODE
        MOVE WS-L-ID(WS-I) TO EXC-KEY
        MOVE WS-COMPUTED TO EXC-AMOUNT
        MOVE "LOAN OUTSTANDING MISMATCH" TO EXC-REASON
        CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    ELSE
        ADD 1 TO REC-MATCHED
    END-IF
    IF WS-L-STATUS(WS-I) = "CLO" OR WS-L-STATUS(WS-I) = "SET"
        IF WS-L-OUT(WS-I) > 0
            ADD 1 TO REC-UNMATCHED-I
            MOVE SPACES TO BK-EXC-REC
            MOVE "MISMATCH" TO EXC-CODE
            MOVE WS-L-ID(WS-I) TO EXC-KEY
            MOVE WS-L-OUT(WS-I) TO EXC-AMOUNT
            MOVE "CLOSED LOAN WITH OUTSTANDING" TO EXC-REASON
            CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
        END-IF
    END-IF.

ACCUMULATE-TXN.
    IF WS-T-REF(WS-K) NOT = WS-L-ID(WS-I)
        EXIT PARAGRAPH
    END-IF
    IF WS-T-STATUS(WS-K) NOT = "ST" AND WS-T-STATUS(WS-K) NOT = "CP"
        EXIT PARAGRAPH
    END-IF
    EVALUATE WS-T-TYPE(WS-K)
        WHEN "CREDDISB"
            ADD WS-T-PRIN(WS-K) TO WS-COMPUTED
        WHEN "CREDREPY"
            SUBTRACT WS-T-PRIN(WS-K) FROM WS-COMPUTED
        WHEN "CREDWOFF"
            SUBTRACT WS-T-AMT(WS-K) FROM WS-COMPUTED
    END-EVALUATE.
