IDENTIFICATION DIVISION.
PROGRAM-ID. BRECPAY.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PAY-FILE ASSIGN TO WS-PAY-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PAY-ID
        FILE STATUS IS WS-PAY-ST.
    SELECT PST-FILE ASSIGN TO WS-PST-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-PST-ST.

DATA DIVISION.
FILE SECTION.
FD PAY-FILE.
01 PAY-REC.
   COPY "BPAYREC".
FD PST-FILE.
01 PST-LINE PIC X(300).

WORKING-STORAGE SECTION.
01 WS-PAY-PATH PIC X(200).
01 WS-PST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-PAY-ST PIC X(02).
01 WS-PST-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-I PIC 9(05).
01 WS-J PIC 9(05).
01 WS-K PIC 9(05).
01 WS-JI PIC 9(05).
01 WS-FOUND PIC X(01).
01 WS-CNT PIC 9(09).
01 WS-TAG PIC X(04).
01 WS-GL PIC X(10).
01 WS-DC PIC X(01).
01 WS-AMT PIC X(30).
01 WS-ENTITY PIC X(20).
01 WS-CUR PIC X(03).
01 WS-JRN PIC X(20).
01 WS-DATE PIC X(08).
01 WS-N-PAY PIC 9(05) VALUE 0.
01 WS-PAY-MAX PIC 9(05) VALUE 200.
01 WS-PAYT.
   05 WS-PAY-ROW OCCURS 200 TIMES.
      10 WS-P-ID PIC X(12).
      10 WS-P-TXN PIC X(24).
      10 WS-P-JRN PIC X(20).
      10 WS-P-STATUS PIC X(02).
      10 WS-P-AMT PIC S9(15)V99 COMP-3.
      10 WS-P-MATCH PIC X(01).
01 WS-N-JRN PIC 9(05) VALUE 0.
01 WS-JRN-MAX PIC 9(05) VALUE 400.
01 WS-JRNT.
   05 WS-JRN-ROW OCCURS 400 TIMES.
      10 WS-J-ID PIC X(20).
      10 WS-J-MATCH PIC X(01).

01 BK-EXC-REC.
   COPY "BRECE".
LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-PAY-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pay.idx"
        DELIMITED SIZE INTO WS-PAY-PATH
    MOVE SPACES TO WS-PST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/postings.log"
        DELIMITED SIZE INTO WS-PST-PATH
    MOVE 0 TO WS-N-PAY
    MOVE 0 TO WS-N-JRN
    PERFORM LOAD-PAYMENTS
    PERFORM LOAD-JOURNALS
    PERFORM MATCH-PAYMENTS
    PERFORM CHECK-ORPHAN-JOURNALS
    GOBACK.

LOAD-PAYMENTS.
    OPEN INPUT PAY-FILE
    IF WS-PAY-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PAY-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-PAYMENT
        END-READ
    END-PERFORM
    CLOSE PAY-FILE
    MOVE WS-N-PAY TO REC-SRC-COUNT.

ADD-PAYMENT.
    IF WS-N-PAY >= WS-PAY-MAX
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-N-PAY
    MOVE PAY-ID TO WS-P-ID(WS-N-PAY)
    MOVE PAY-TXN-ID TO WS-P-TXN(WS-N-PAY)
    MOVE PAY-JRN-ID TO WS-P-JRN(WS-N-PAY)
    MOVE PAY-STATUS TO WS-P-STATUS(WS-N-PAY)
    MOVE PAY-AMOUNT TO WS-P-AMT(WS-N-PAY)
    MOVE "N" TO WS-P-MATCH(WS-N-PAY).

LOAD-JOURNALS.
    OPEN INPUT PST-FILE
    IF WS-PST-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE 0 TO WS-CNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PST-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-JOURNAL
        END-READ
    END-PERFORM
    CLOSE PST-FILE.

ADD-JOURNAL.
    IF PST-LINE(1:4) NOT = "GLP|"
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-CNT
    MOVE SPACES TO WS-TAG WS-GL WS-DC WS-AMT WS-ENTITY
        WS-CUR WS-JRN WS-DATE
    UNSTRING PST-LINE DELIMITED BY "|"
        INTO WS-TAG WS-GL WS-DC WS-AMT WS-ENTITY WS-CUR
        WS-JRN WS-DATE
    END-UNSTRING
    IF WS-JRN = SPACES
        EXIT PARAGRAPH
    END-IF
    PERFORM FIND-JRN
    IF WS-FOUND = "N" AND WS-N-JRN < WS-JRN-MAX
        ADD 1 TO WS-N-JRN
        MOVE WS-JRN TO WS-J-ID(WS-N-JRN)
        MOVE "N" TO WS-J-MATCH(WS-N-JRN)
    END-IF.

FIND-JRN.
    MOVE "N" TO WS-FOUND
    MOVE 0 TO WS-JI
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-JRN
        IF WS-J-ID(WS-K) = WS-JRN
            MOVE "Y" TO WS-FOUND
            MOVE WS-K TO WS-JI
            EXIT PERFORM
        END-IF
    END-PERFORM.

MATCH-PAYMENTS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-PAY
        PERFORM MATCH-ONE-PAYMENT
    END-PERFORM.

MATCH-ONE-PAYMENT.
    IF WS-P-JRN(WS-I) = SPACES
        PERFORM CHECK-PENDING
        EXIT PARAGRAPH
    END-IF
    MOVE WS-P-JRN(WS-I) TO WS-JRN
    PERFORM FIND-JRN
    IF WS-FOUND = "Y"
        MOVE "Y" TO WS-J-MATCH(WS-JI)
        ADD 1 TO REC-MATCHED
    ELSE
        ADD 1 TO REC-UNMATCHED-I
        PERFORM RAISE-NO-POSTING
    END-IF.

CHECK-PENDING.
    IF WS-P-STATUS(WS-I) = "ST" OR WS-P-STATUS(WS-I) = "RT"
        OR WS-P-STATUS(WS-I) = "RV"
        ADD 1 TO REC-UNMATCHED-I
        PERFORM RAISE-NO-POSTING
    END-IF.

RAISE-NO-POSTING.
    MOVE SPACES TO BK-EXC-REC
    MOVE "NO_POSTING" TO EXC-CODE
    MOVE WS-P-ID(WS-I) TO EXC-KEY
    MOVE WS-P-TXN(WS-I) TO EXC-SRC-REF
    MOVE WS-P-AMT(WS-I) TO EXC-AMOUNT
    MOVE "PAYMENT HAS NO LEDGER POSTING" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

CHECK-ORPHAN-JOURNALS.
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-JRN
        IF WS-J-MATCH(WS-J) = "N" AND WS-J-ID(WS-J)(1:3) = "PAY"
            ADD 1 TO REC-UNMATCHED-E
            MOVE SPACES TO BK-EXC-REC
            MOVE "ORPHAN" TO EXC-CODE
            MOVE WS-J-ID(WS-J) TO EXC-KEY
            MOVE WS-J-ID(WS-J) TO EXC-SRC-REF
            MOVE "PAYMENT POSTING WITHOUT PAYMENT" TO EXC-REASON
            CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
        END-IF
    END-PERFORM.
