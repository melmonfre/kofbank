IDENTIFICATION DIVISION.
PROGRAM-ID. BREC.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-NOW PIC X(14).
01 BK-REC-REC.
   COPY "BREC".
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
COPY "BRECP".

PROCEDURE DIVISION USING BK-REC-PARMS.
    MOVE "00" TO RP-RC
    MOVE SPACES TO RP-MSG
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO RP-RC
        MOVE "CONFIG MISSING" TO RP-MSG
        GOBACK
    END-IF
    PERFORM BUILD-RUN-ID
    PERFORM LOAD-OR-CREATE
    IF RP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "MATCHING" TO REC-STATUS
    PERFORM RUN-MATCHER
    IF RP-RC NOT = "00"
        MOVE RP-RC TO REC-RC
        MOVE RP-MSG TO REC-MSG
        PERFORM FAIL-RUN
        GOBACK
    END-IF
    IF REC-RC NOT = "00"
        PERFORM FAIL-RUN
        GOBACK
    END-IF
    PERFORM REFRESH-OPEN
    PERFORM FINALIZE-RUN
    MOVE REC-STATUS TO RP-MSG
    GOBACK.

BUILD-RUN-ID.
    IF RP-RUN-ID NOT = SPACES
        MOVE RP-RUN-ID TO REC-RUN-ID
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO REC-RUN-ID
    STRING "REC-" DELIMITED SIZE FUNCTION TRIM(RP-TYPE)
        DELIMITED SIZE "-" DELIMITED SIZE WS-BIZDATE DELIMITED SIZE
        INTO REC-RUN-ID
    END-STRING.

LOAD-OR-CREATE.
    MOVE REC-RUN-ID TO RP-RUN-ID
    MOVE "GET" TO RP-OP
    CALL "BRECSTO" USING BK-REC-PARMS BK-REC-REC
    IF RP-RC = "00"
        IF REC-STATUS NOT = "FAILED"
            MOVE REC-MATCHED TO RP-MATCHED
            ADD REC-UNMATCHED-I TO REC-UNMATCHED-E
                GIVING RP-UNMATCHED
            MOVE REC-OPEN-EXC TO RP-OPEN-EXC
            MOVE "24" TO RP-RC
            MOVE "RUN ALREADY EXISTS" TO RP-MSG
            GOBACK
        END-IF
        PERFORM RESET-RUN
        MOVE "UPDATE" TO RP-OP
        CALL "BRECSTO" USING BK-REC-PARMS BK-REC-REC
        EXIT PARAGRAPH
    END-IF
    PERFORM RESET-RUN
    MOVE "WRITE" TO RP-OP
    CALL "BRECSTO" USING BK-REC-PARMS BK-REC-REC
    IF RP-RC = "22"
        MOVE "24" TO RP-RC
        MOVE "RUN ALREADY EXISTS" TO RP-MSG
    END-IF.

RESET-RUN.
    MOVE RP-TYPE TO REC-TYPE
    MOVE WS-BIZDATE TO REC-BIZDATE
    MOVE "CREATED" TO REC-STATUS
    IF RP-OPERATOR = SPACES
        MOVE "SYSTEM" TO REC-OPERATOR
    ELSE
        MOVE RP-OPERATOR TO REC-OPERATOR
    END-IF
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO REC-STARTED
    MOVE 0 TO REC-FINISHED
    MOVE 0 TO REC-SRC-COUNT
    MOVE 0 TO REC-INT-COUNT
    MOVE 0 TO REC-MATCHED
    MOVE 0 TO REC-UNMATCHED-I
    MOVE 0 TO REC-UNMATCHED-E
    MOVE 0 TO REC-EXCEPTIONS
    MOVE 0 TO REC-OPEN-EXC
    MOVE 0 TO REC-ADJUSTMENTS
    MOVE 0 TO REC-SRC-AMT
    MOVE 0 TO REC-INT-AMT
    MOVE "00" TO REC-RC
    MOVE SPACES TO REC-MSG.

RUN-MATCHER.
    EVALUATE REC-TYPE
        WHEN "LEDGER" CALL "BRECLGR" USING BK-REC-REC
        WHEN "PAYMENT" CALL "BRECPAY" USING BK-REC-REC
        WHEN "TXN" CALL "BRECTXN" USING BK-REC-REC
        WHEN "JOURNAL" CALL "BRECLJN" USING BK-REC-REC
        WHEN "BOUNDARY" CALL "BRECBND" USING BK-REC-REC
        WHEN "CREDIT" CALL "BRECCRD" USING BK-REC-REC
        WHEN "LOAN" CALL "BRECLON" USING BK-REC-REC
        WHEN "COLLECT" CALL "BRECCOL" USING BK-REC-REC
        WHEN "CLTREG" CALL "BRECCLT" USING BK-REC-REC
        WHEN "CARDCLR" CALL "BRECCCR" USING BK-REC-REC
        WHEN "CCRCLR" CALL "BRECCCR" USING BK-REC-REC
        WHEN "CLT" CALL "BRECCLT" USING BK-REC-REC
        WHEN "COL" CALL "BRECCOL" USING BK-REC-REC
        WHEN "PIXSTL" CALL "BRECPIX" USING BK-REC-REC
        WHEN "PIX" CALL "BRECPIX" USING BK-REC-REC
        WHEN "EXTERNAL" CALL "BRECEXT" USING BK-REC-REC BK-REC-PARMS
        WHEN OTHER
            MOVE "99" TO RP-RC
            MOVE "UNKNOWN REC TYPE" TO RP-MSG
    END-EVALUATE.

REFRESH-OPEN.
    MOVE REC-RUN-ID TO RP-RUN-ID
    MOVE "COUNT" TO RP-OP
    CALL "BRECESO" USING BK-REC-PARMS BK-EXC-REC
    MOVE EXC-CREATED TO REC-OPEN-EXC.

FINALIZE-RUN.
    IF REC-OPEN-EXC > 0 OR REC-UNMATCHED-I > 0
        MOVE "EXCEPTIONS" TO REC-STATUS
    ELSE
        MOVE "BALANCED" TO REC-STATUS
    END-IF
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO REC-FINISHED
    PERFORM SAVE-RUN.

SAVE-RUN.
    MOVE REC-RUN-ID TO RP-RUN-ID
    MOVE "UPDATE" TO RP-OP
    CALL "BRECSTO" USING BK-REC-PARMS BK-REC-REC
    MOVE REC-MATCHED TO RP-MATCHED
    ADD REC-UNMATCHED-I TO REC-UNMATCHED-E
        GIVING RP-UNMATCHED
    MOVE REC-OPEN-EXC TO RP-OPEN-EXC
    MOVE "00" TO RP-RC.

FAIL-RUN.
    MOVE "FAILED" TO REC-STATUS
    PERFORM SAVE-RUN
    IF RP-RC = "00"
        MOVE REC-RC TO RP-RC
        MOVE REC-MSG TO RP-MSG
    END-IF.
