IDENTIFICATION DIVISION.
PROGRAM-ID. BRECEXT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT EXT-FILE ASSIGN TO WS-EXT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-EXT-ST.
    SELECT PST-FILE ASSIGN TO WS-PST-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-PST-ST.

DATA DIVISION.
FILE SECTION.
FD EXT-FILE.
01 EXT-LINE PIC X(300).
FD PST-FILE.
01 PST-LINE PIC X(300).

WORKING-STORAGE SECTION.
01 WS-EXT-PATH PIC X(200).
01 WS-PST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-EXT-ST PIC X(02).
01 WS-PST-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-I PIC 9(05).
01 WS-J PIC 9(05).
01 WS-K PIC 9(05).
01 WS-JI PIC 9(05).
01 WS-FOUND PIC X(01).
01 WS-CNT PIC 9(09).
01 WS-TAG PIC X(04).
01 WS-GL PIC X(10).
01 WS-DC PIC X(01).
01 WS-AMT-STR PIC X(30).
01 WS-ENTITY PIC X(20).
01 WS-CUR PIC X(03).
01 WS-JRN PIC X(20).
01 WS-DATE PIC X(08).
01 WS-EXT-REF PIC X(24).
01 WS-EXT-AMT-STR PIC X(30).
01 WS-EXT-AMT PIC S9(15)V99 COMP-3.
01 WS-EXT-CUR PIC X(03).
01 WS-EXT-DATE PIC X(08).
01 WS-N-EXT PIC 9(05) VALUE 0.
01 WS-EXT-MAX PIC 9(05) VALUE 200.
01 WS-EXTT.
   05 WS-E-ROW OCCURS 200 TIMES.
      10 WS-E-REF PIC X(24).
      10 WS-E-AMT PIC S9(15)V99 COMP-3.
      10 WS-E-CUR PIC X(03).
      10 WS-E-DATE PIC X(08).
      10 WS-E-MATCH PIC X(01).
01 WS-N-JRN PIC 9(05) VALUE 0.
01 WS-JRN-MAX PIC 9(05) VALUE 400.
01 WS-JRNT.
   05 WS-J-ROW OCCURS 400 TIMES.
      10 WS-J-ID PIC X(20).
      10 WS-J-AMT PIC S9(15)V99 COMP-3.
      10 WS-J-CUR PIC X(03).
      10 WS-J-MATCH PIC X(01).
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".
COPY "BRECP".

PROCEDURE DIVISION USING BK-REC-REC BK-REC-PARMS.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-PST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/postings.log"
        DELIMITED SIZE INTO WS-PST-PATH
    MOVE RP-FILE TO WS-EXT-PATH
    MOVE 0 TO WS-N-EXT
    MOVE 0 TO WS-N-JRN
    PERFORM LOAD-EXTERNAL
    PERFORM LOAD-JOURNALS
    PERFORM MATCH-EXTERNAL
    PERFORM CHECK-INTERNAL
    GOBACK.

LOAD-EXTERNAL.
    OPEN INPUT EXT-FILE
    IF WS-EXT-ST NOT = "00"
        MOVE "35" TO REC-RC
        MOVE "EXTERNAL FILE MISSING" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ EXT-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-EXTERNAL
        END-READ
    END-PERFORM
    CLOSE EXT-FILE
    MOVE WS-N-EXT TO REC-SRC-COUNT.

ADD-EXTERNAL.
    IF EXT-LINE = SPACES OR WS-N-EXT >= WS-EXT-MAX
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-EXT-REF WS-EXT-AMT-STR WS-EXT-CUR WS-EXT-DATE
    UNSTRING EXT-LINE DELIMITED BY "|"
        INTO WS-EXT-REF WS-EXT-AMT-STR WS-EXT-CUR WS-EXT-DATE
    END-UNSTRING
    MOVE 0 TO WS-EXT-AMT
    MOVE WS-EXT-AMT-STR TO WS-EXT-AMT
    MOVE WS-EXT-REF TO WS-JRN
    PERFORM FIND-EXT
    IF WS-FOUND = "Y"
        ADD 1 TO REC-UNMATCHED-E
        MOVE SPACES TO BK-EXC-REC
        MOVE "DUPLICATE" TO EXC-CODE
        MOVE WS-EXT-REF TO EXC-KEY
        MOVE WS-EXT-REF TO EXC-SRC-REF
        MOVE WS-EXT-AMT TO EXC-AMOUNT
        MOVE WS-EXT-CUR TO EXC-CURRENCY
        MOVE "DUPLICATE EXTERNAL RECORD" TO EXC-REASON
        CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-N-EXT
    MOVE WS-EXT-REF TO WS-E-REF(WS-N-EXT)
    MOVE WS-EXT-AMT TO WS-E-AMT(WS-N-EXT)
    MOVE WS-EXT-CUR TO WS-E-CUR(WS-N-EXT)
    MOVE WS-EXT-DATE TO WS-E-DATE(WS-N-EXT)
    MOVE "N" TO WS-E-MATCH(WS-N-EXT).

FIND-EXT.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-EXT
        IF WS-E-REF(WS-K) = WS-JRN
            MOVE "Y" TO WS-FOUND
            EXIT PERFORM
        END-IF
    END-PERFORM.

LOAD-JOURNALS.
    OPEN INPUT PST-FILE
    IF WS-PST-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE 0 TO WS-CNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PST-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-JOURNAL
        END-READ
    END-PERFORM
    CLOSE PST-FILE.

ADD-JOURNAL.
    IF PST-LINE(1:4) NOT = "GLP|"
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-CNT
    MOVE SPACES TO WS-TAG WS-GL WS-DC WS-AMT-STR WS-ENTITY
        WS-CUR WS-JRN WS-DATE
    UNSTRING PST-LINE DELIMITED BY "|"
        INTO WS-TAG WS-GL WS-DC WS-AMT-STR WS-ENTITY WS-CUR
        WS-JRN WS-DATE
    END-UNSTRING
    PERFORM FIND-JRN
    IF WS-FOUND = "Y"
        EXIT PARAGRAPH
    END-IF
    IF WS-N-JRN >= WS-JRN-MAX
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-N-JRN
    MOVE WS-JRN TO WS-J-ID(WS-N-JRN)
    MOVE 0 TO WS-J-AMT(WS-N-JRN)
    MOVE WS-AMT-STR TO WS-J-AMT(WS-N-JRN)
    MOVE WS-CUR TO WS-J-CUR(WS-N-JRN)
    MOVE "N" TO WS-J-MATCH(WS-N-JRN).

FIND-JRN.
    MOVE "N" TO WS-FOUND
    MOVE 0 TO WS-JI
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-JRN
        IF WS-J-ID(WS-K) = WS-JRN
            MOVE "Y" TO WS-FOUND
            MOVE WS-K TO WS-JI
            EXIT PERFORM
        END-IF
    END-PERFORM.

MATCH-EXTERNAL.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-EXT
        PERFORM MATCH-ONE
    END-PERFORM.

MATCH-ONE.
    MOVE WS-E-REF(WS-I) TO WS-JRN
    PERFORM FIND-JRN
    IF WS-FOUND = "N"
        ADD 1 TO REC-UNMATCHED-E
        PERFORM RAISE-MISSING
        EXIT PARAGRAPH
    END-IF
    IF WS-J-AMT(WS-JI) NOT = WS-E-AMT(WS-I)
        MOVE "Y" TO WS-J-MATCH(WS-JI)
        ADD 1 TO REC-UNMATCHED-E
        PERFORM RAISE-AMOUNT
        EXIT PARAGRAPH
    END-IF
    IF WS-J-CUR(WS-JI) NOT = WS-E-CUR(WS-I)
        MOVE "Y" TO WS-J-MATCH(WS-JI)
        ADD 1 TO REC-UNMATCHED-E
        PERFORM RAISE-CURRENCY
        EXIT PARAGRAPH
    END-IF
    MOVE "Y" TO WS-E-MATCH(WS-I)
    MOVE "Y" TO WS-J-MATCH(WS-JI)
    ADD 1 TO REC-MATCHED.

RAISE-MISSING.
    MOVE SPACES TO BK-EXC-REC
    MOVE "UNMATCHED" TO EXC-CODE
    MOVE WS-E-REF(WS-I) TO EXC-KEY
    MOVE WS-E-REF(WS-I) TO EXC-SRC-REF
    MOVE WS-E-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-E-CUR(WS-I) TO EXC-CURRENCY
    MOVE "EXTERNAL RECORD WITHOUT INTERNAL POSTING" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-AMOUNT.
    MOVE SPACES TO BK-EXC-REC
    MOVE "AMOUNT" TO EXC-CODE
    MOVE WS-E-REF(WS-I) TO EXC-KEY
    MOVE WS-E-REF(WS-I) TO EXC-SRC-REF
    MOVE WS-E-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-E-CUR(WS-I) TO EXC-CURRENCY
    MOVE "AMOUNT DIFFERS FROM INTERNAL POSTING" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-CURRENCY.
    MOVE SPACES TO BK-EXC-REC
    MOVE "CURRENCY" TO EXC-CODE
    MOVE WS-E-REF(WS-I) TO EXC-KEY
    MOVE WS-E-REF(WS-I) TO EXC-SRC-REF
    MOVE WS-E-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-E-CUR(WS-I) TO EXC-CURRENCY
    MOVE "CURRENCY DIFFERS FROM INTERNAL POSTING" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

CHECK-INTERNAL.
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-JRN
        IF WS-J-MATCH(WS-J) = "N"
            ADD 1 TO REC-UNMATCHED-I
            MOVE SPACES TO BK-EXC-REC
            MOVE "UNMATCHED" TO EXC-CODE
            MOVE WS-J-ID(WS-J) TO EXC-KEY
            MOVE WS-J-ID(WS-J) TO EXC-INT-REF
            MOVE "INTERNAL POSTING WITHOUT EXTERNAL RECORD" TO EXC-REASON
            CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
        END-IF
    END-PERFORM.
