IDENTIFICATION DIVISION.
PROGRAM-ID. BRECEXT.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-I PIC 9(05).
01 WS-J PIC 9(05).
01 WS-K PIC 9(05).
01 WS-JI PIC 9(05).
01 WS-FOUND PIC X(01).
01 WS-JRN PIC X(20).
01 WS-M-MATCHED PIC X(01).
01 WS-M-AMBIG PIC X(01).
01 WS-M-CAND PIC 9(05).
01 WS-M-JI PIC 9(05).
01 WS-TOT-SRC PIC S9(15)V99 COMP-3.
01 WS-TOT-MATCH PIC S9(15)V99 COMP-3.
01 WS-TOT-EXC PIC S9(15)V99 COMP-3.
01 WS-TOT-CAL PIC S9(15)V99 COMP-3.
01 XL-LDR.
   COPY "BRECEXT".
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".
COPY "BRECP".

PROCEDURE DIVISION USING BK-REC-REC BK-REC-PARMS.
    MOVE "00" TO XL-RC
    CALL "BRECEXTL" USING XL-LDR BK-REC-PARMS
    MOVE XL-RC TO REC-RC
    MOVE XL-MSG TO REC-MSG
    IF XL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE XL-N-EXT TO REC-SRC-COUNT
    MOVE XL-N-JRN TO REC-INT-COUNT
    MOVE 0 TO WS-TOT-SRC
    MOVE 0 TO WS-TOT-MATCH
    MOVE 0 TO WS-TOT-EXC
    PERFORM MATCH-EXTERNAL
    PERFORM CHECK-INTERNAL
    PERFORM CLASSIFY-SOURCE
    PERFORM INVARIANT-CHECK
    GOBACK.

MATCH-EXTERNAL.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > XL-N-EXT
        PERFORM MATCH-ONE
    END-PERFORM.

MATCH-ONE.
    IF XL-E-REF(WS-I) NOT = SPACES
        PERFORM FIND-DUP
        IF WS-FOUND = "Y"
            MOVE "X" TO XL-E-STATE(WS-I)
            ADD XL-E-AMT(WS-I) TO WS-TOT-EXC
            ADD 1 TO REC-UNMATCHED-E
            PERFORM RAISE-DUPLICATE
            EXIT PARAGRAPH
        END-IF
    END-IF
    MOVE "N" TO WS-M-MATCHED
    MOVE "N" TO WS-M-AMBIG
    MOVE 0 TO WS-M-CAND
    MOVE 0 TO WS-M-JI
    IF XL-E-REF(WS-I) NOT = SPACES
        MOVE XL-E-REF(WS-I) TO WS-JRN
        PERFORM FIND-JRN
        IF WS-FOUND = "Y"
            MOVE WS-JI TO WS-M-JI
            MOVE "Y" TO WS-M-MATCHED
        END-IF
    END-IF
    IF WS-M-MATCHED = "N"
        PERFORM MATCH-KEY
    END-IF
    IF WS-M-AMBIG = "Y"
        PERFORM RAISE-AMBIG
        EXIT PARAGRAPH
    END-IF
    IF WS-M-MATCHED = "N"
        PERFORM RAISE-MISSING
        EXIT PARAGRAPH
    END-IF
    IF XL-E-REF(WS-I) NOT = SPACES
        IF XL-J-AMT(WS-M-JI) NOT = XL-E-AMT(WS-I)
            MOVE "Y" TO XL-J-MATCH(WS-M-JI)
            PERFORM RAISE-AMOUNT
            EXIT PARAGRAPH
        END-IF
        IF XL-J-CUR(WS-M-JI) NOT = XL-E-CUR(WS-I)
            MOVE "Y" TO XL-J-MATCH(WS-M-JI)
            PERFORM RAISE-CURRENCY
            EXIT PARAGRAPH
        END-IF
        IF XL-J-DATE(WS-M-JI) NOT = XL-E-DATE(WS-I)
            MOVE "Y" TO XL-J-MATCH(WS-M-JI)
            PERFORM RAISE-DATE
            EXIT PARAGRAPH
        END-IF
    END-IF
    MOVE "M" TO XL-E-STATE(WS-I)
    MOVE "Y" TO XL-J-MATCH(WS-M-JI)
    ADD XL-E-AMT(WS-I) TO WS-TOT-MATCH
    ADD 1 TO REC-MATCHED.

MARK-EXCEPTION.
    MOVE "X" TO XL-E-STATE(WS-I)
    ADD XL-E-AMT(WS-I) TO WS-TOT-EXC
    ADD 1 TO REC-UNMATCHED-E.

FIND-DUP.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K >= WS-I
        IF XL-E-REF(WS-K) = XL-E-REF(WS-I)
            MOVE "Y" TO WS-FOUND
            EXIT PERFORM
        END-IF
    END-PERFORM.

FIND-JRN.
    MOVE "N" TO WS-FOUND
    MOVE 0 TO WS-JI
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > XL-N-JRN
        IF XL-J-ID(WS-K) = WS-JRN
            MOVE "Y" TO WS-FOUND
            MOVE WS-K TO WS-JI
            EXIT PERFORM
        END-IF
    END-PERFORM.

MATCH-KEY.
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > XL-N-JRN
        IF XL-J-MATCH(WS-K) = "N"
            IF XL-J-AMT(WS-K) = XL-E-AMT(WS-I)
                IF XL-J-CUR(WS-K) = XL-E-CUR(WS-I)
                    IF XL-J-DATE(WS-K) = XL-E-DATE(WS-I)
                        ADD 1 TO WS-M-CAND
                        MOVE WS-K TO WS-M-JI
                    END-IF
                END-IF
            END-IF
        END-IF
    END-PERFORM
    IF WS-M-CAND = 1
        MOVE "Y" TO WS-M-MATCHED
    ELSE
        IF WS-M-CAND > 1
            MOVE "Y" TO WS-M-AMBIG
        END-IF
    END-IF.

RAISE-DUPLICATE.
    MOVE SPACES TO BK-EXC-REC
    MOVE "DUPLICATE" TO EXC-CODE
    MOVE XL-E-REF(WS-I) TO EXC-KEY
    MOVE XL-E-REF(WS-I) TO EXC-SRC-REF
    MOVE XL-E-AMT(WS-I) TO EXC-AMOUNT
    MOVE XL-E-CUR(WS-I) TO EXC-CURRENCY
    MOVE "DUPLICATE EXTERNAL RECORD" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-MISSING.
    MOVE SPACES TO BK-EXC-REC
    MOVE "UNMATCHED" TO EXC-CODE
    MOVE XL-E-KEY(WS-I) TO EXC-KEY
    MOVE XL-E-KEY(WS-I) TO EXC-SRC-REF
    MOVE XL-E-AMT(WS-I) TO EXC-AMOUNT
    MOVE XL-E-CUR(WS-I) TO EXC-CURRENCY
    MOVE "EXTERNAL RECORD WITHOUT INTERNAL POSTING" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    PERFORM MARK-EXCEPTION.

RAISE-AMOUNT.
    MOVE SPACES TO BK-EXC-REC
    MOVE "AMOUNT" TO EXC-CODE
    MOVE XL-E-REF(WS-I) TO EXC-KEY
    MOVE XL-E-REF(WS-I) TO EXC-SRC-REF
    MOVE XL-E-AMT(WS-I) TO EXC-AMOUNT
    MOVE XL-E-CUR(WS-I) TO EXC-CURRENCY
    MOVE "AMOUNT DIFFERS FROM INTERNAL POSTING" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    PERFORM MARK-EXCEPTION.

RAISE-CURRENCY.
    MOVE SPACES TO BK-EXC-REC
    MOVE "CURRENCY" TO EXC-CODE
    MOVE XL-E-REF(WS-I) TO EXC-KEY
    MOVE XL-E-REF(WS-I) TO EXC-SRC-REF
    MOVE XL-E-AMT(WS-I) TO EXC-AMOUNT
    MOVE XL-E-CUR(WS-I) TO EXC-CURRENCY
    MOVE "CURRENCY DIFFERS FROM INTERNAL POSTING" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    PERFORM MARK-EXCEPTION.

RAISE-DATE.
    MOVE SPACES TO BK-EXC-REC
    MOVE "DATE" TO EXC-CODE
    MOVE XL-E-REF(WS-I) TO EXC-KEY
    MOVE XL-E-REF(WS-I) TO EXC-SRC-REF
    MOVE XL-J-ID(WS-M-JI) TO EXC-INT-REF
    MOVE XL-E-AMT(WS-I) TO EXC-AMOUNT
    MOVE XL-E-CUR(WS-I) TO EXC-CURRENCY
    MOVE "VALUE DATE DIFFERS FROM INTERNAL POSTING" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    PERFORM MARK-EXCEPTION.

RAISE-AMBIG.
    MOVE SPACES TO BK-EXC-REC
    MOVE "AMBIGUOUS" TO EXC-CODE
    MOVE XL-E-KEY(WS-I) TO EXC-KEY
    MOVE XL-E-KEY(WS-I) TO EXC-SRC-REF
    MOVE XL-E-AMT(WS-I) TO EXC-AMOUNT
    MOVE XL-E-CUR(WS-I) TO EXC-CURRENCY
    MOVE "KEYLESS RECORD MATCHED MULTIPLE INTERNAL POSTINGS" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    MOVE "X" TO XL-E-STATE(WS-I)
    ADD XL-E-AMT(WS-I) TO WS-TOT-EXC
    ADD 1 TO REC-UNMATCHED-E.

CHECK-INTERNAL.
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > XL-N-JRN
        IF XL-J-MATCH(WS-J) = "N"
            ADD 1 TO REC-UNMATCHED-I
            MOVE SPACES TO BK-EXC-REC
            MOVE "UNMATCHED" TO EXC-CODE
            MOVE XL-J-ID(WS-J) TO EXC-KEY
            MOVE XL-J-ID(WS-J) TO EXC-INT-REF
            MOVE "INTERNAL POSTING WITHOUT EXTERNAL RECORD" TO EXC-REASON
            CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
        END-IF
    END-PERFORM.

CLASSIFY-SOURCE.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > XL-N-EXT
        ADD XL-E-AMT(WS-I) TO WS-TOT-SRC
    END-PERFORM
    MOVE WS-TOT-SRC TO REC-SRC-AMT
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > XL-N-JRN
        IF XL-J-MATCH(WS-J) = "Y"
            ADD XL-J-AMT(WS-J) TO REC-INT-AMT
        END-IF
    END-PERFORM.

INVARIANT-CHECK.
    ADD WS-TOT-MATCH TO WS-TOT-EXC GIVING WS-TOT-CAL
    IF WS-TOT-CAL NOT = WS-TOT-SRC
        MOVE "38" TO REC-RC
        MOVE "EXTERNAL SOURCE CLASSIFICATION INCOMPLETE" TO REC-MSG
    END-IF.
