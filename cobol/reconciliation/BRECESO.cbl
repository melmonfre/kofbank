IDENTIFICATION DIVISION.
PROGRAM-ID. BRECESO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT EXC-FILE ASSIGN TO WS-EXC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS EXC-ID OF EXC-REC
        FILE STATUS IS WS-EXC-ST.

DATA DIVISION.
FILE SECTION.
FD EXC-FILE.
01 EXC-REC.
   COPY "BRECE".

WORKING-STORAGE SECTION.
01 WS-EXC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-EXC-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-CNT PIC 9(09).

LINKAGE SECTION.
COPY "BRECP".
01 BK-EXC-REC.
   COPY "BRECE".

PROCEDURE DIVISION USING BK-REC-PARMS BK-EXC-REC.
    MOVE "00" TO RP-RC
    MOVE SPACES TO RP-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-EXC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/recexc.idx"
        DELIMITED SIZE INTO WS-EXC-PATH
    PERFORM OPEN-STORE
    IF RP-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE RP-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "UPDATE" PERFORM DO-UPDATE
        WHEN "GET" PERFORM DO-GET
        WHEN "COUNT" PERFORM DO-COUNT
        WHEN OTHER
            MOVE "99" TO RP-RC
            MOVE "UNKNOWN EXC STORE OP" TO RP-MSG
    END-EVALUATE
    CLOSE EXC-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O EXC-FILE
    IF WS-EXC-ST = "35"
        OPEN OUTPUT EXC-FILE
        CLOSE EXC-FILE
        OPEN I-O EXC-FILE
    END-IF
    IF WS-EXC-ST NOT = "00"
        MOVE WS-EXC-ST TO RP-RC
        MOVE "CANNOT OPEN EXCEPTION INDEX" TO RP-MSG
    END-IF.

DO-WRITE.
    MOVE BK-EXC-REC TO EXC-REC
    WRITE EXC-REC
        INVALID KEY
            MOVE "22" TO RP-RC
            MOVE "EXCEPTION ALREADY EXISTS" TO RP-MSG
    END-WRITE.

DO-UPDATE.
    MOVE EXC-ID OF BK-EXC-REC TO EXC-ID OF EXC-REC
    READ EXC-FILE
    IF WS-EXC-ST = "00"
        MOVE BK-EXC-REC TO EXC-REC
        REWRITE EXC-REC
    ELSE
        MOVE "23" TO RP-RC
        MOVE "EXCEPTION NOT FOUND" TO RP-MSG
    END-IF.

DO-GET.
    MOVE RP-EXC-ID TO EXC-ID OF EXC-REC
    READ EXC-FILE
    IF WS-EXC-ST = "00"
        MOVE EXC-REC TO BK-EXC-REC
        MOVE "00" TO RP-RC
    ELSE
        MOVE "23" TO RP-RC
        MOVE "EXCEPTION NOT FOUND" TO RP-MSG
    END-IF.

DO-COUNT.
    MOVE 0 TO WS-CNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ EXC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM COUNT-ONE
        END-READ
    END-PERFORM
    MOVE WS-CNT TO EXC-CREATED OF BK-EXC-REC.

COUNT-ONE.
    IF EXC-RUN-ID OF EXC-REC NOT = RP-RUN-ID
        EXIT PARAGRAPH
    END-IF
    IF EXC-STATUS OF EXC-REC = "OPEN"
        ADD 1 TO WS-CNT
        EXIT PARAGRAPH
    END-IF
    IF EXC-STATUS OF EXC-REC = "UNDER_REVIEW"
        ADD 1 TO WS-CNT
    END-IF.
