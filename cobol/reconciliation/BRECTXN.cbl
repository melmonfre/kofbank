IDENTIFICATION DIVISION.
PROGRAM-ID. BRECTXN.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TXN-FILE ASSIGN TO WS-TXN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS TXN-ID
        FILE STATUS IS WS-TXN-ST.
    SELECT PST-FILE ASSIGN TO WS-PST-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-PST-ST.

DATA DIVISION.
FILE SECTION.
FD TXN-FILE.
01 TXN-REC.
   COPY "BTXREC".
FD PST-FILE.
01 PST-LINE PIC X(300).

WORKING-STORAGE SECTION.
01 WS-TXN-PATH PIC X(200).
01 WS-PST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-TXN-ST PIC X(02).
01 WS-PST-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-I PIC 9(05).
01 WS-J PIC 9(05).
01 WS-K PIC 9(05).
01 WS-JI PIC 9(05).
01 WS-FOUND PIC X(01).
01 WS-CNT PIC 9(09).
01 WS-TAG PIC X(04).
01 WS-GL PIC X(10).
01 WS-DC PIC X(01).
01 WS-AMT PIC X(30).
01 WS-ENTITY PIC X(20).
01 WS-CUR PIC X(03).
01 WS-JRN PIC X(20).
01 WS-DATE PIC X(08).
01 WS-N-TXN PIC 9(05) VALUE 0.
01 WS-TXN-MAX PIC 9(05) VALUE 200.
01 WS-TXNT.
   05 WS-TXN-ROW OCCURS 200 TIMES.
      10 WS-T-ID PIC X(12).
      10 WS-T-JRN PIC X(20).
      10 WS-T-STATUS PIC X(02).
      10 WS-T-AMT PIC S9(15)V99 COMP-3.
      10 WS-T-MATCH PIC X(01).
01 WS-N-JRN PIC 9(05) VALUE 0.
01 WS-JRN-MAX PIC 9(05) VALUE 400.
01 WS-JRNT.
   05 WS-JRN-ROW OCCURS 400 TIMES.
      10 WS-J-ID PIC X(20).
      10 WS-J-MATCH PIC X(01).
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-TXN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/txn.idx"
        DELIMITED SIZE INTO WS-TXN-PATH
    MOVE SPACES TO WS-PST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/postings.log"
        DELIMITED SIZE INTO WS-PST-PATH
    MOVE 0 TO WS-N-TXN
    MOVE 0 TO WS-N-JRN
    PERFORM LOAD-TXNS
    PERFORM LOAD-JOURNALS
    PERFORM MATCH-TXNS
    PERFORM CHECK-ORPHAN-JOURNALS
    GOBACK.

LOAD-TXNS.
    OPEN INPUT TXN-FILE
    IF WS-TXN-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ TXN-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-TXN
        END-READ
    END-PERFORM
    CLOSE TXN-FILE
    MOVE WS-N-TXN TO REC-SRC-COUNT.

ADD-TXN.
    IF WS-N-TXN >= WS-TXN-MAX
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-N-TXN
    MOVE TXN-ID OF TXN-REC TO WS-T-ID(WS-N-TXN)
    MOVE TXN-JRN-ID OF TXN-REC TO WS-T-JRN(WS-N-TXN)
    MOVE TXN-STATUS OF TXN-REC TO WS-T-STATUS(WS-N-TXN)
    MOVE TXN-AMOUNT OF TXN-REC TO WS-T-AMT(WS-N-TXN)
    MOVE "N" TO WS-T-MATCH(WS-N-TXN).

LOAD-JOURNALS.
    OPEN INPUT PST-FILE
    IF WS-PST-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PST-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-JOURNAL
        END-READ
    END-PERFORM
    CLOSE PST-FILE.

ADD-JOURNAL.
    IF PST-LINE(1:4) NOT = "GLP|"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-TAG WS-GL WS-DC WS-AMT WS-ENTITY
        WS-CUR WS-JRN WS-DATE
    UNSTRING PST-LINE DELIMITED BY "|"
        INTO WS-TAG WS-GL WS-DC WS-AMT WS-ENTITY WS-CUR
        WS-JRN WS-DATE
    END-UNSTRING
    IF WS-JRN = SPACES
        EXIT PARAGRAPH
    END-IF
    PERFORM FIND-JRN
    IF WS-FOUND = "N" AND WS-N-JRN < WS-JRN-MAX
        ADD 1 TO WS-N-JRN
        MOVE WS-JRN TO WS-J-ID(WS-N-JRN)
        MOVE "N" TO WS-J-MATCH(WS-N-JRN)
    END-IF.

FIND-JRN.
    MOVE "N" TO WS-FOUND
    MOVE 0 TO WS-JI
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-JRN
        IF WS-J-ID(WS-K) = WS-JRN
            MOVE "Y" TO WS-FOUND
            MOVE WS-K TO WS-JI
            EXIT PERFORM
        END-IF
    END-PERFORM.

MATCH-TXNS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-TXN
        PERFORM MATCH-ONE-TXN
    END-PERFORM.

MATCH-ONE-TXN.
    IF WS-T-STATUS(WS-I) NOT = "ST" AND WS-T-STATUS(WS-I) NOT = "CP"
        AND WS-T-STATUS(WS-I) NOT = "RV"
        AND WS-T-STATUS(WS-I) NOT = "RT"
        EXIT PARAGRAPH
    END-IF
    IF WS-T-JRN(WS-I) = SPACES
        ADD 1 TO REC-UNMATCHED-I
        PERFORM RAISE-NO-POSTING
        EXIT PARAGRAPH
    END-IF
    MOVE WS-T-JRN(WS-I) TO WS-JRN
    PERFORM FIND-JRN
    IF WS-FOUND = "Y"
        MOVE "Y" TO WS-J-MATCH(WS-JI)
        ADD 1 TO REC-MATCHED
    ELSE
        ADD 1 TO REC-UNMATCHED-I
        PERFORM RAISE-NO-POSTING
    END-IF.

RAISE-NO-POSTING.
    MOVE SPACES TO BK-EXC-REC
    MOVE "NO_POSTING" TO EXC-CODE
    MOVE WS-T-ID(WS-I) TO EXC-KEY
    MOVE WS-T-JRN(WS-I) TO EXC-SRC-REF
    MOVE WS-T-AMT(WS-I) TO EXC-AMOUNT
    MOVE "TRANSACTION HAS NO LEDGER POSTING" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

CHECK-ORPHAN-JOURNALS.
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-JRN
        IF WS-J-MATCH(WS-J) = "N" AND WS-J-ID(WS-J)(1:3) = "TXN"
            ADD 1 TO REC-UNMATCHED-E
            MOVE SPACES TO BK-EXC-REC
            MOVE "ORPHAN" TO EXC-CODE
            MOVE WS-J-ID(WS-J) TO EXC-KEY
            MOVE WS-J-ID(WS-J) TO EXC-SRC-REF
            MOVE "TRANSACTION POSTING WITHOUT TRANSACTION" TO EXC-REASON
            CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
        END-IF
    END-PERFORM.
