IDENTIFICATION DIVISION.
PROGRAM-ID. BRECEXTL.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT EXT-FILE ASSIGN TO WS-EXT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-EXT-ST.
    SELECT PST-FILE ASSIGN TO WS-PST-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-PST-ST.

DATA DIVISION.
FILE SECTION.
FD EXT-FILE.
01 EXT-LINE PIC X(300).
FD PST-FILE.
01 PST-LINE PIC X(300).

WORKING-STORAGE SECTION.
01 WS-EXT-PATH PIC X(200).
01 WS-PST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-EXT-ST PIC X(02).
01 WS-PST-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-K PIC 9(05).
01 WS-FOUND PIC X(01).
01 WS-TAG PIC X(04).
01 WS-GL PIC X(10).
01 WS-DC PIC X(01).
01 WS-AMT-STR PIC X(30).
01 WS-ENTITY PIC X(20).
01 WS-CUR PIC X(03).
01 WS-JRN PIC X(20).
01 WS-DATE PIC X(08).
01 WS-EXT-REF PIC X(24).
01 WS-EXT-AMT-STR PIC X(30).
01 WS-EXT-AMT PIC S9(15)V99 COMP-3.
01 WS-EXT-CUR PIC X(03).
01 WS-EXT-DATE PIC X(08).

LINKAGE SECTION.
01 XL-LDR.
   COPY "BRECEXT".
COPY "BRECP".

PROCEDURE DIVISION USING XL-LDR BK-REC-PARMS.
    MOVE "00" TO XL-RC
    MOVE SPACES TO XL-MSG
    MOVE 0 TO XL-N-EXT
    MOVE 0 TO XL-N-JRN
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-PST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/postings.log"
        DELIMITED SIZE INTO WS-PST-PATH
    PERFORM LOAD-EXTERNAL
    IF XL-RC = "00"
        PERFORM LOAD-JOURNALS
    END-IF
    GOBACK.

LOAD-EXTERNAL.
    MOVE RP-FILE TO WS-EXT-PATH
    OPEN INPUT EXT-FILE
    IF WS-EXT-ST NOT = "00"
        MOVE "35" TO XL-RC
        MOVE "EXTERNAL FILE MISSING" TO XL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ EXT-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-EXTERNAL
        END-READ
    END-PERFORM
    CLOSE EXT-FILE.

ADD-EXTERNAL.
    IF EXT-LINE = SPACES
        EXIT PARAGRAPH
    END-IF
    IF XL-N-EXT >= 200
        MOVE "37" TO XL-RC
        MOVE "EXTERNAL SOURCE LIMIT EXCEEDED" TO XL-MSG
        MOVE "Y" TO WS-EOF
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-EXT-REF WS-EXT-AMT-STR WS-EXT-CUR WS-EXT-DATE
    UNSTRING EXT-LINE DELIMITED BY "|"
        INTO WS-EXT-REF WS-EXT-AMT-STR WS-EXT-CUR WS-EXT-DATE
    END-UNSTRING
    MOVE 0 TO WS-EXT-AMT
    MOVE WS-EXT-AMT-STR TO WS-EXT-AMT
    ADD 1 TO XL-N-EXT
    MOVE WS-EXT-REF TO XL-E-REF(XL-N-EXT)
    IF WS-EXT-REF = SPACES
        MOVE SPACES TO XL-E-KEY(XL-N-EXT)
        MOVE WS-EXT-AMT-STR TO XL-E-KEY(XL-N-EXT)
    ELSE
        MOVE WS-EXT-REF TO XL-E-KEY(XL-N-EXT)
    END-IF
    MOVE WS-EXT-AMT TO XL-E-AMT(XL-N-EXT)
    MOVE WS-EXT-CUR TO XL-E-CUR(XL-N-EXT)
    MOVE WS-EXT-DATE TO XL-E-DATE(XL-N-EXT)
    MOVE "N" TO XL-E-STATE(XL-N-EXT).

LOAD-JOURNALS.
    OPEN INPUT PST-FILE
    IF WS-PST-ST = "35"
        EXIT PARAGRAPH
    END-IF
    IF WS-PST-ST NOT = "00"
        MOVE "36" TO XL-RC
        MOVE "SOURCE FILE UNREADABLE" TO XL-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PST-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-JOURNAL
        END-READ
    END-PERFORM
    CLOSE PST-FILE.

ADD-JOURNAL.
    IF PST-LINE(1:4) NOT = "GLP|"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-TAG WS-GL WS-DC WS-AMT-STR WS-ENTITY
        WS-CUR WS-JRN WS-DATE
    UNSTRING PST-LINE DELIMITED BY "|"
        INTO WS-TAG WS-GL WS-DC WS-AMT-STR WS-ENTITY WS-CUR
        WS-JRN WS-DATE
    END-UNSTRING
    PERFORM FIND-JRN
    IF WS-FOUND = "Y"
        EXIT PARAGRAPH
    END-IF
    IF XL-N-JRN >= 400
        MOVE "37" TO XL-RC
        MOVE "POSTING SOURCE LIMIT EXCEEDED" TO XL-MSG
        MOVE "Y" TO WS-EOF
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO XL-N-JRN
    MOVE WS-JRN TO XL-J-ID(XL-N-JRN)
    MOVE 0 TO XL-J-AMT(XL-N-JRN)
    MOVE WS-AMT-STR TO XL-J-AMT(XL-N-JRN)
    MOVE WS-CUR TO XL-J-CUR(XL-N-JRN)
    MOVE WS-DATE TO XL-J-DATE(XL-N-JRN)
    MOVE "N" TO XL-J-MATCH(XL-N-JRN).

FIND-JRN.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > XL-N-JRN
        IF XL-J-ID(WS-K) = WS-JRN
            MOVE "Y" TO WS-FOUND
            EXIT PERFORM
        END-IF
    END-PERFORM.
