IDENTIFICATION DIVISION.
PROGRAM-ID. BRECLJN.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT JRN-FILE ASSIGN TO WS-JRN-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-JRN-ST.
    SELECT PST-FILE ASSIGN TO WS-PST-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-PST-ST.

DATA DIVISION.
FILE SECTION.
FD JRN-FILE.
01 JRN-LINE PIC X(500).
FD PST-FILE.
01 PST-LINE PIC X(300).

WORKING-STORAGE SECTION.
01 WS-JRN-PATH PIC X(200).
01 WS-PST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-JRN-ST PIC X(02).
01 WS-PST-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-I PIC 9(04).
01 WS-J PIC 9(04).
01 WS-FIELDS.
   05 WS-F PIC X(60) OCCURS 12 TIMES.
01 WS-LJRN-MAX PIC 9(05) VALUE 400.
01 WS-LJRN-ROWS.
   05 WS-LJRN-ROW OCCURS 400 TIMES.
      10 WS-LJRN-ID     PIC X(20).
      10 WS-LJRN-DECL   PIC 9(04).
      10 WS-LJRN-TOTAL  PIC S9(15)V99 COMP-3.
01 WS-N-LJRN PIC 9(05) VALUE 0.
01 WS-GL-MAX PIC 9(05) VALUE 400.
01 WS-GL-ROWS.
   05 WS-GL-ROW OCCURS 400 TIMES.
      10 WS-GL-ID       PIC X(20).
      10 WS-GL-COUNT    PIC 9(04).
      10 WS-GL-DR       PIC S9(15)V99 COMP-3.
      10 WS-GL-CR       PIC S9(15)V99 COMP-3.
      10 WS-GL-MATCH    PIC X(01).
01 WS-N-GL PIC 9(05) VALUE 0.
01 WS-AMT PIC S9(15)V99 COMP-3.
COPY "BKJRNP".
COPY "BKPSTT".
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    MOVE "00" TO REC-RC
    MOVE SPACES TO REC-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-JRN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/journal.log"
        DELIMITED SIZE INTO WS-JRN-PATH
    MOVE SPACES TO WS-PST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/postings.log"
        DELIMITED SIZE INTO WS-PST-PATH
    PERFORM LOAD-HEADERS
    IF REC-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM VERIFY-HEADERS
    PERFORM LOAD-LEDGER-IDS
    PERFORM MATCH-PAIRS
    MOVE WS-N-LJRN TO REC-SRC-COUNT
    MOVE WS-N-GL TO REC-INT-COUNT
    GOBACK.

LOAD-HEADERS.
    OPEN INPUT JRN-FILE
    IF WS-JRN-ST = "35"
        CLOSE JRN-FILE
        EXIT PARAGRAPH
    END-IF
    IF WS-JRN-ST NOT = "00"
        MOVE WS-JRN-ST TO REC-RC
        MOVE "CANNOT OPEN JOURNAL" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ JRN-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM HEADER-SCAN
        END-READ
    END-PERFORM
    CLOSE JRN-FILE.

HEADER-SCAN.
    IF JRN-LINE(1:4) NOT = "JRN|"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-FIELDS
    UNSTRING JRN-LINE DELIMITED BY "|"
        INTO WS-F(1) WS-F(2) WS-F(3) WS-F(4) WS-F(5) WS-F(6)
            WS-F(7) WS-F(8) WS-F(9) WS-F(10) WS-F(11) WS-F(12)
    END-UNSTRING
    IF WS-N-LJRN >= WS-LJRN-MAX
        MOVE "20" TO REC-RC
        MOVE "JOURNAL SOURCE LIMIT EXCEEDED" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-LJRN
        IF WS-LJRN-ID(WS-J) = WS-F(2)
            PERFORM RAISE-DUPLICATE-SCAN
            EXIT PARAGRAPH
        END-IF
    END-PERFORM
    ADD 1 TO WS-N-LJRN
    MOVE WS-F(2) TO WS-LJRN-ID(WS-N-LJRN)
    MOVE FUNCTION NUMVAL(WS-F(10)) TO
        WS-LJRN-DECL(WS-N-LJRN)
    MOVE FUNCTION NUMVAL(WS-F(11)) TO
        WS-LJRN-TOTAL(WS-N-LJRN).

VERIFY-HEADERS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-LJRN
        MOVE SPACES TO BK-JRN-PARMS
        MOVE WS-LJRN-ID(WS-I) TO BK-JRN-ID
        MOVE "G" TO BK-JRN-MODE
        CALL "BJRN" USING BK-JRN-PARMS BK-PST-TABLE
        IF BK-JRN-F-DR NOT = BK-JRN-F-CR
            PERFORM RAISE-UNBALANCED
        END-IF
        IF BK-JRN-F-NCOL NOT = WS-LJRN-DECL(WS-I)
            PERFORM RAISE-COUNT
        END-IF
        IF BK-JRN-F-DR NOT = WS-LJRN-TOTAL(WS-I)
            PERFORM RAISE-UNBALANCED
        END-IF
    END-PERFORM.

LOAD-LEDGER-IDS.
    OPEN INPUT PST-FILE
    IF WS-PST-ST = "35"
        CLOSE PST-FILE
        EXIT PARAGRAPH
    END-IF
    IF WS-PST-ST NOT = "00"
        MOVE WS-PST-ST TO REC-RC
        MOVE "CANNOT OPEN POSTINGS" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PST-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM LEDGER-SCAN
        END-READ
    END-PERFORM
    CLOSE PST-FILE.

LEDGER-SCAN.
    IF PST-LINE(1:4) NOT = "GLP|"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-FIELDS
    UNSTRING PST-LINE DELIMITED BY "|"
        INTO WS-F(1) WS-F(2) WS-F(3) WS-F(4) WS-F(5) WS-F(6)
            WS-F(7) WS-F(8)
    END-UNSTRING
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-GL
        IF WS-GL-ID(WS-J) = WS-F(7)
            EXIT PERFORM
        END-IF
    END-PERFORM
    IF WS-J > WS-N-GL
        IF WS-N-GL >= WS-GL-MAX
            MOVE "20" TO REC-RC
            MOVE "LEDGER SOURCE LIMIT EXCEEDED" TO REC-MSG
            EXIT PARAGRAPH
        END-IF
        ADD 1 TO WS-N-GL
        MOVE WS-N-GL TO WS-J
        MOVE WS-F(7) TO WS-GL-ID(WS-J)
        MOVE 0 TO WS-GL-COUNT(WS-J)
        MOVE 0 TO WS-GL-DR(WS-J)
        MOVE 0 TO WS-GL-CR(WS-J)
        MOVE "N" TO WS-GL-MATCH(WS-J)
    END-IF
    ADD 1 TO WS-GL-COUNT(WS-J)
    MOVE FUNCTION NUMVAL(WS-F(4)) TO WS-AMT
    IF WS-F(3) = "D"
        ADD WS-AMT TO WS-GL-DR(WS-J)
    ELSE
        ADD WS-AMT TO WS-GL-CR(WS-J)
    END-IF.

MATCH-PAIRS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-LJRN
        PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-GL
            IF WS-GL-ID(WS-J) = WS-LJRN-ID(WS-I)
                MOVE "Y" TO WS-GL-MATCH(WS-J)
                ADD 1 TO REC-MATCHED
                IF WS-GL-COUNT(WS-J) NOT =
                    WS-LJRN-DECL(WS-I) OR
                    WS-GL-DR(WS-J) NOT = WS-LJRN-TOTAL(WS-I)
                    PERFORM RAISE-MISMATCH
                END-IF
                EXIT PERFORM
            END-IF
        END-PERFORM
        IF WS-J > WS-N-GL
            ADD 1 TO REC-UNMATCHED-I
            PERFORM RAISE-NO-LEDGER
        END-IF
    END-PERFORM
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-GL
        IF WS-GL-MATCH(WS-J) = "N"
            ADD 1 TO REC-UNMATCHED-E
            PERFORM RAISE-ORPHAN
        END-IF
    END-PERFORM.

RAISE-DUPLICATE-SCAN.
    ADD 1 TO REC-UNMATCHED-E
    MOVE SPACES TO BK-EXC-REC
    MOVE "JRN_DUP" TO EXC-CODE
    MOVE WS-F(2) TO EXC-KEY
    MOVE WS-F(2) TO EXC-SRC-REF
    MOVE "JOURNAL HEADER WRITTEN TWICE" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-UNBALANCED.
    MOVE SPACES TO BK-EXC-REC
    MOVE "JRN_UNBAL" TO EXC-CODE
    MOVE WS-LJRN-ID(WS-I) TO EXC-KEY
    MOVE WS-LJRN-ID(WS-I) TO EXC-SRC-REF
    MOVE BK-JRN-F-DR TO EXC-AMOUNT
    MOVE "JOURNAL LINES DO NOT BALANCE" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-COUNT.
    MOVE SPACES TO BK-EXC-REC
    MOVE "JRN_COUNT" TO EXC-CODE
    MOVE WS-LJRN-ID(WS-I) TO EXC-KEY
    MOVE WS-LJRN-ID(WS-I) TO EXC-SRC-REF
    MOVE WS-LJRN-ID(WS-I) TO EXC-INT-REF
    MOVE "JOURNAL LINE COUNT DIFFERS" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-MISMATCH.
    MOVE SPACES TO BK-EXC-REC
    MOVE "JRN_MISMATCH" TO EXC-CODE
    MOVE WS-LJRN-ID(WS-I) TO EXC-KEY
    MOVE WS-LJRN-ID(WS-I) TO EXC-SRC-REF
    MOVE WS-LJRN-ID(WS-I) TO EXC-INT-REF
    MOVE WS-GL-DR(WS-J) TO EXC-AMOUNT
    MOVE "JOURNAL AND LEDGER EFFECTS DIFFER" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-NO-LEDGER.
    MOVE SPACES TO BK-EXC-REC
    MOVE "JRN_NO_LEDGER" TO EXC-CODE
    MOVE WS-LJRN-ID(WS-I) TO EXC-KEY
    MOVE WS-LJRN-ID(WS-I) TO EXC-SRC-REF
    MOVE WS-LJRN-TOTAL(WS-I) TO EXC-AMOUNT
    MOVE "JOURNAL HAS NO LEDGER EFFECT" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-ORPHAN.
    MOVE SPACES TO BK-EXC-REC
    MOVE "LGR_ORPHAN" TO EXC-CODE
    MOVE WS-GL-ID(WS-J) TO EXC-KEY
    MOVE WS-GL-ID(WS-J) TO EXC-SRC-REF
    MOVE WS-GL-DR(WS-J) TO EXC-AMOUNT
    MOVE "LEDGER EFFECT WITHOUT JOURNAL" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.
