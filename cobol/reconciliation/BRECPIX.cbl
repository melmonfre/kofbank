IDENTIFICATION DIVISION.
PROGRAM-ID. BRECPIX.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT STL-FILE ASSIGN TO WS-STL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS SR-STL-ID OF STL-REC
        FILE STATUS IS WS-STL-ST.
    SELECT XST-FILE ASSIGN TO WS-XST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS XS-KEY OF XST-REC
        FILE STATUS IS WS-XST-ST.

DATA DIVISION.
FILE SECTION.
FD STL-FILE.
01 STL-REC.
   COPY "BPXSTLR".
FD XST-FILE.
01 XST-REC.
   05 XS-KEY.
      10 XS-SOURCE     PIC X(08).
      10 XS-SEP1       PIC X(01).
      10 XS-EXT-REF    PIC X(32).
   05 XS-STL-ID        PIC X(12).
   05 XS-CYCLE-ID      PIC X(20).
   05 XS-AMOUNT        PIC S9(15)V99 COMP-3.
   05 XS-STATUS        PIC X(16).
   05 XS-RESULT-REF    PIC X(32).
   05 XS-DATE          PIC 9(08).
   05 XS-TS            PIC 9(14).

WORKING-STORAGE SECTION.
01 WS-STL-PATH PIC X(200).
01 WS-XST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-STL-ST PIC X(02).
01 WS-XST-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-I PIC 9(05).
01 WS-J PIC 9(05).
01 WS-K PIC 9(05).
01 WS-JI PIC 9(05).
01 WS-FOUND PIC X(01).
01 WS-NOW PIC 9(14).
01 WS-N-OBL PIC 9(05) VALUE 0.
01 WS-OBL-MAX PIC 9(05) VALUE 300.
01 WS-OBLT.
   05 WS-OBL-ROW OCCURS 300 TIMES.
      10 WS-O-ID       PIC X(12).
      10 WS-O-CYCLE    PIC X(20).
      10 WS-O-EXT      PIC X(32).
      10 WS-O-STATUS   PIC X(16).
      10 WS-O-RECON    PIC X(12).
      10 WS-O-AMT      PIC S9(15)V99 COMP-3.
      10 WS-O-CUR      PIC X(03).
      10 WS-O-PART     PIC X(12).
      10 WS-O-DATE     PIC 9(08).
      10 WS-O-DUP      PIC X(01).
      10 WS-O-CHANGE   PIC X(01).
      10 WS-O-CNT      PIC 9(03).
01 WS-N-EXT PIC 9(05) VALUE 0.
01 WS-EXT-MAX PIC 9(05) VALUE 300.
01 WS-EXTT.
   05 WS-EXT-ROW OCCURS 300 TIMES.
      10 WS-E-EXT      PIC X(32).
      10 WS-E-STL      PIC X(12).
      10 WS-E-CYCLE    PIC X(20).
      10 WS-E-AMT      PIC S9(15)V99 COMP-3.
      10 WS-E-STATUS   PIC X(16).
      10 WS-E-MATCH    PIC X(01).
      10 WS-E-DUP      PIC X(01).
01 WS-N-CYC PIC 9(03) VALUE 0.
01 WS-CYC-MAX PIC 9(03) VALUE 60.
01 WS-CYCT.
   05 WS-CYC-ROW OCCURS 60 TIMES.
      10 WS-C-ID       PIC X(20).
      10 WS-C-TOTAL    PIC 9(05).
      10 WS-C-RECON    PIC 9(05).
      10 WS-C-EXC      PIC 9(05).
01 WS-CYC-ID PIC X(20).
01 WS-CYC-BAD PIC 9(05).
01 WS-CYC-OK PIC 9(05).
01 WS-EVT PIC X(20).
01 WS-CUR-STATE PIC X(16).
01 WS-NXT PIC X(16).
01 WS-STM-RC PIC X(02).
01 WS-STM-MSG PIC X(80).
   COPY "BPXSSO".
01 BK-PX-CY-REC.
   COPY "BPXCY".
01 BK-PX-ST-REC2.
   COPY "BPXSTLR".
01 BK-PX-PO-REC.
   COPY "BPXPO".
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-STL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxstl.idx"
        DELIMITED SIZE INTO WS-STL-PATH
    MOVE SPACES TO WS-XST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxstlx.idx"
        DELIMITED SIZE INTO WS-XST-PATH
    PERFORM LOAD-OBLIGATIONS
    IF REC-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-EXTERNALS
    IF REC-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM MATCH-OBLIGATIONS
    PERFORM CHECK-ORPHANS
    PERFORM APPLY-EDITS
    GOBACK.

LOAD-OBLIGATIONS.
    OPEN INPUT STL-FILE
    IF WS-STL-ST = "35"
        MOVE 0 TO REC-SRC-COUNT
        EXIT PARAGRAPH
    END-IF
    IF WS-STL-ST NOT = "00"
        MOVE "36" TO REC-RC
        MOVE "PIX SETTLEMENT STORE UNREADABLE" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ STL-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-OBLIGATION
        END-READ
    END-PERFORM
    CLOSE STL-FILE
    MOVE WS-N-OBL TO REC-SRC-COUNT.

ADD-OBLIGATION.
    IF WS-N-OBL >= WS-OBL-MAX
        MOVE "37" TO REC-RC
        MOVE "PIX SETTLEMENT SOURCE LIMIT EXCEEDED" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-N-OBL
    MOVE SR-STL-ID OF STL-REC TO WS-O-ID(WS-N-OBL)
    MOVE SR-CYCLE-ID OF STL-REC TO WS-O-CYCLE(WS-N-OBL)
    MOVE SR-EXTERNAL-REF OF STL-REC TO WS-O-EXT(WS-N-OBL)
    MOVE SR-STATUS OF STL-REC TO WS-O-STATUS(WS-N-OBL)
    MOVE SR-RECON-STATUS OF STL-REC TO WS-O-RECON(WS-N-OBL)
    MOVE SR-NET-AMT OF STL-REC TO WS-O-AMT(WS-N-OBL)
    MOVE SR-CURRENCY OF STL-REC TO WS-O-CUR(WS-N-OBL)
    MOVE SR-PARTICIPANT OF STL-REC TO WS-O-PART(WS-N-OBL)
    MOVE SR-SETTLE-DATE OF STL-REC TO WS-O-DATE(WS-N-OBL)
    MOVE "N" TO WS-O-DUP(WS-N-OBL)
    MOVE "N" TO WS-O-CHANGE(WS-N-OBL)
    MOVE 0 TO WS-O-CNT(WS-N-OBL)
    IF WS-O-STATUS(WS-N-OBL) = "SETTLED" OR
       WS-O-STATUS(WS-N-OBL) = "RECONCILED"
        ADD WS-O-AMT(WS-N-OBL) TO REC-INT-AMT
    END-IF.

LOAD-EXTERNALS.
    OPEN INPUT XST-FILE
    IF WS-XST-ST = "35"
        EXIT PARAGRAPH
    END-IF
    IF WS-XST-ST NOT = "00"
        MOVE "36" TO REC-RC
        MOVE "PIX EXTERNAL REF STORE UNREADABLE" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ XST-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM ADD-EXTERNAL
        END-READ
    END-PERFORM
    CLOSE XST-FILE.

ADD-EXTERNAL.
    IF XS-STL-ID = SPACES
        EXIT PARAGRAPH
    END-IF
    PERFORM FIND-EXTERNAL
    IF WS-FOUND = "Y"
        MOVE "Y" TO WS-E-DUP(WS-JI)
        ADD 1 TO WS-O-CNT(WS-JI)
        EXIT PARAGRAPH
    END-IF
    IF WS-N-EXT >= WS-EXT-MAX
        MOVE "37" TO REC-RC
        MOVE "PIX EXTERNAL SOURCE LIMIT EXCEEDED" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO WS-N-EXT
    MOVE XS-EXT-REF OF XST-REC TO WS-E-EXT(WS-N-EXT)
    MOVE XS-STL-ID TO WS-E-STL(WS-N-EXT)
    MOVE XS-CYCLE-ID TO WS-E-CYCLE(WS-N-EXT)
    MOVE XS-AMOUNT TO WS-E-AMT(WS-N-EXT)
    MOVE XS-STATUS TO WS-E-STATUS(WS-N-EXT)
    MOVE "N" TO WS-E-MATCH(WS-N-EXT)
    MOVE "N" TO WS-E-DUP(WS-N-EXT)
    ADD XS-AMOUNT TO REC-SRC-AMT.

FIND-EXTERNAL.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-EXT
        IF WS-E-STL(WS-K) = XS-STL-ID
            MOVE "Y" TO WS-FOUND
            MOVE WS-K TO WS-JI
            EXIT PERFORM
        END-IF
    END-PERFORM.

MATCH-OBLIGATIONS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-OBL
        PERFORM MATCH-ONE-OBLIGATION
    END-PERFORM.

MATCH-ONE-OBLIGATION.
    PERFORM TRACK-CYCLE
    IF WS-O-STATUS(WS-I) = "PENDING" OR
       WS-O-STATUS(WS-I) = "SUBMIT-FAILED" OR
       WS-O-STATUS(WS-I) = "REJECTED" OR
       WS-O-STATUS(WS-I) = "CANCELLED"
        EXIT PARAGRAPH
    END-IF
    IF WS-O-STATUS(WS-I) = "SUBMITTED"
        PERFORM FIND-BY-EXT
        IF WS-FOUND = "Y"
            MOVE "Y" TO WS-E-MATCH(WS-JI)
        END-IF
        IF WS-O-RECON(WS-I) = "PENDING"
            MOVE "EXCEPTION" TO WS-O-RECON(WS-I)
            MOVE "Y" TO WS-O-CHANGE(WS-I)
            ADD 1 TO REC-UNMATCHED-I
            PERFORM RAISE-STALE
        END-IF
        EXIT PARAGRAPH
    END-IF
    IF WS-O-STATUS(WS-I) = "UNKNOWN"
        PERFORM FIND-BY-EXT
        IF WS-FOUND = "Y"
            MOVE "Y" TO WS-E-MATCH(WS-JI)
        END-IF
        IF WS-O-RECON(WS-I) NOT = "EXCEPTION"
            MOVE "EXCEPTION" TO WS-O-RECON(WS-I)
            MOVE "Y" TO WS-O-CHANGE(WS-I)
            ADD 1 TO REC-UNMATCHED-I
            PERFORM RAISE-UNKNOWN
        END-IF
        EXIT PARAGRAPH
    END-IF
    PERFORM FIND-BY-EXT
    IF WS-FOUND = "N"
        IF WS-O-EXT(WS-I) = SPACES
            IF WS-O-RECON(WS-I) NOT = "EXCEPTION"
                MOVE "EXCEPTION" TO WS-O-RECON(WS-I)
                MOVE "Y" TO WS-O-CHANGE(WS-I)
                ADD 1 TO REC-UNMATCHED-I
                PERFORM RAISE-NO-REFERENCE
            END-IF
        ELSE
            IF WS-O-RECON(WS-I) NOT = "EXCEPTION"
                MOVE "EXCEPTION" TO WS-O-RECON(WS-I)
                MOVE "Y" TO WS-O-CHANGE(WS-I)
                ADD 1 TO REC-UNMATCHED-I
                PERFORM RAISE-MISSING-EXTERNAL
            END-IF
        END-IF
        EXIT PARAGRAPH
    END-IF
    MOVE "Y" TO WS-E-MATCH(WS-JI)
    IF WS-O-CNT(WS-I) > 1
        MOVE "Y" TO WS-O-DUP(WS-I)
    END-IF
    PERFORM COMPARE-EXTERNAL.

TRACK-CYCLE.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-CYC OR
                             WS-FOUND = "Y"
        IF WS-C-ID(WS-K) = WS-O-CYCLE(WS-I)
            MOVE "Y" TO WS-FOUND
            ADD 1 TO WS-C-TOTAL(WS-K)
        END-IF
    END-PERFORM
    IF WS-FOUND = "N"
        IF WS-N-CYC < WS-CYC-MAX
            ADD 1 TO WS-N-CYC
            MOVE WS-O-CYCLE(WS-I) TO WS-C-ID(WS-N-CYC)
            MOVE 1 TO WS-C-TOTAL(WS-N-CYC)
        END-IF
    END-IF.

FIND-BY-EXT.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-EXT
        IF WS-E-STL(WS-K) = WS-O-ID(WS-I)
            MOVE "Y" TO WS-FOUND
            MOVE WS-K TO WS-JI
            EXIT PERFORM
        END-IF
    END-PERFORM.

COMPARE-EXTERNAL.
    IF WS-E-EXT(WS-JI) NOT = WS-O-EXT(WS-I)
        IF WS-O-RECON(WS-I) NOT = "EXCEPTION"
            ADD 1 TO REC-UNMATCHED-I
            PERFORM RAISE-REFERENCE-MISMATCH
        END-IF
        EXIT PARAGRAPH
    END-IF
    IF WS-E-AMT(WS-JI) NOT = WS-O-AMT(WS-I)
        IF WS-O-RECON(WS-I) NOT = "EXCEPTION"
            ADD 1 TO REC-UNMATCHED-I
            PERFORM RAISE-AMOUNT-MISMATCH
        END-IF
        EXIT PARAGRAPH
    END-IF
    IF WS-E-STATUS(WS-JI) NOT = "SETTLED" AND
       WS-E-STATUS(WS-JI) NOT = "RECONCILED"
        IF WS-O-RECON(WS-I) NOT = "EXCEPTION"
            ADD 1 TO REC-UNMATCHED-I
            PERFORM RAISE-STATUS-MISMATCH
        END-IF
        EXIT PARAGRAPH
    END-IF
    IF WS-O-DUP(WS-I) = "Y"
        IF WS-O-RECON(WS-I) NOT = "EXCEPTION"
            ADD 1 TO REC-UNMATCHED-I
            PERFORM RAISE-DUPLICATE-EXTERNAL
        END-IF
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO REC-MATCHED
    IF WS-O-RECON(WS-I) NOT = "MATCHED"
        MOVE "MATCHED" TO WS-O-RECON(WS-I)
        MOVE "Y" TO WS-O-CHANGE(WS-I)
    END-IF
    PERFORM MARK-CYCLE-OK.

MARK-CYCLE-OK.
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-CYC
        IF WS-C-ID(WS-K) = WS-O-CYCLE(WS-I)
            ADD 1 TO WS-C-RECON(WS-K)
        END-IF
    END-PERFORM.

RAISE-STALE.
    MOVE SPACES TO BK-EXC-REC
    MOVE "STALE_SETTLE" TO EXC-CODE
    MOVE WS-O-ID(WS-I) TO EXC-KEY
    MOVE WS-O-ID(WS-I) TO EXC-INT-REF
    MOVE WS-O-CYCLE(WS-I) TO EXC-SRC-REF
    MOVE WS-O-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-O-CUR(WS-I) TO EXC-CURRENCY
    MOVE "SETTLEMENT SUBMITTED WITHOUT RESULT" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-UNKNOWN.
    MOVE SPACES TO BK-EXC-REC
    MOVE "UNK_OUTCOME" TO EXC-CODE
    MOVE WS-O-ID(WS-I) TO EXC-KEY
    MOVE WS-O-ID(WS-I) TO EXC-INT-REF
    MOVE WS-O-CYCLE(WS-I) TO EXC-SRC-REF
    MOVE WS-O-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-O-CUR(WS-I) TO EXC-CURRENCY
    MOVE "SETTLEMENT OUTCOME UNKNOWN" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-NO-REFERENCE.
    MOVE SPACES TO BK-EXC-REC
    MOVE "NO_REFERENCE" TO EXC-CODE
    MOVE WS-O-ID(WS-I) TO EXC-KEY
    MOVE WS-O-ID(WS-I) TO EXC-INT-REF
    MOVE WS-O-CYCLE(WS-I) TO EXC-SRC-REF
    MOVE WS-O-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-O-CUR(WS-I) TO EXC-CURRENCY
    MOVE "SETTLEMENT HAS NO EXTERNAL REFERENCE" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-MISSING-EXTERNAL.
    MOVE SPACES TO BK-EXC-REC
    MOVE "MISSING_EXT" TO EXC-CODE
    MOVE WS-O-ID(WS-I) TO EXC-KEY
    MOVE WS-O-EXT(WS-I) TO EXC-SRC-REF
    MOVE WS-O-ID(WS-I) TO EXC-INT-REF
    MOVE WS-O-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-O-CUR(WS-I) TO EXC-CURRENCY
    MOVE "SETTLEMENT MISSING IN SPI RESULTS" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-AMOUNT-MISMATCH.
    MOVE SPACES TO BK-EXC-REC
    MOVE "AMT_MISMATCH" TO EXC-CODE
    MOVE WS-O-ID(WS-I) TO EXC-KEY
    MOVE WS-O-EXT(WS-I) TO EXC-SRC-REF
    MOVE WS-O-ID(WS-I) TO EXC-INT-REF
    MOVE WS-O-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-O-CUR(WS-I) TO EXC-CURRENCY
    MOVE "SPI AMOUNT DIFFERS FROM OBLIGATION" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-REFERENCE-MISMATCH.
    MOVE SPACES TO BK-EXC-REC
    MOVE "REF_MISMATCH" TO EXC-CODE
    MOVE WS-O-ID(WS-I) TO EXC-KEY
    MOVE WS-O-EXT(WS-I) TO EXC-SRC-REF
    MOVE WS-O-ID(WS-I) TO EXC-INT-REF
    MOVE WS-O-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-O-CUR(WS-I) TO EXC-CURRENCY
    MOVE "SPI REFERENCE DOES NOT MATCH OBLIGATION" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-STATUS-MISMATCH.
    MOVE SPACES TO BK-EXC-REC
    MOVE "STATUS_MISM" TO EXC-CODE
    MOVE WS-O-ID(WS-I) TO EXC-KEY
    MOVE WS-O-EXT(WS-I) TO EXC-SRC-REF
    MOVE WS-O-ID(WS-I) TO EXC-INT-REF
    MOVE WS-O-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-O-CUR(WS-I) TO EXC-CURRENCY
    MOVE "SPI STATUS NOT SETTLED" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-DUPLICATE-EXTERNAL.
    MOVE SPACES TO BK-EXC-REC
    MOVE "DUP_EXTERNAL" TO EXC-CODE
    MOVE WS-O-ID(WS-I) TO EXC-KEY
    MOVE WS-O-EXT(WS-I) TO EXC-SRC-REF
    MOVE WS-O-ID(WS-I) TO EXC-INT-REF
    MOVE WS-O-AMT(WS-I) TO EXC-AMOUNT
    MOVE WS-O-CUR(WS-I) TO EXC-CURRENCY
    MOVE "MULTIPLE SPI RECORDS FOR SETTLEMENT" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-ORPHAN.
    MOVE SPACES TO BK-EXC-REC
    MOVE "ORPHAN_EXT" TO EXC-CODE
    MOVE WS-E-STL(WS-J) TO EXC-KEY
    MOVE WS-E-EXT(WS-J) TO EXC-SRC-REF
    MOVE WS-E-STL(WS-J) TO EXC-INT-REF
    MOVE WS-E-AMT(WS-J) TO EXC-AMOUNT
    MOVE "SPI RESULT WITHOUT OBLIGATION" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

CHECK-ORPHANS.
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-EXT
        IF WS-E-MATCH(WS-J) = "N"
            ADD 1 TO REC-UNMATCHED-E
            PERFORM RAISE-ORPHAN
        END-IF
    END-PERFORM.

APPLY-EDITS.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-OBL
        IF WS-O-CHANGE(WS-I) = "Y"
            PERFORM SAVE-OBLIGATION
        END-IF
    END-PERFORM
    PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-N-CYC
        IF WS-C-TOTAL(WS-J) > 0
            PERFORM SAVE-CYCLE
        END-IF
    END-PERFORM.

SAVE-OBLIGATION.
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "STL-GET" TO SS-OP
    MOVE WS-O-ID(WS-I) TO SS-STL-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ BK-PX-CY-REC
        BK-PX-ST-REC2 BK-PX-PO-REC
    IF SS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-O-RECON(WS-I) TO SR-RECON-STATUS OF BK-PX-ST-REC2
    IF WS-O-RECON(WS-I) = "MATCHED"
        MOVE "RECONCILED" TO SR-STATUS OF BK-PX-ST-REC2
        MOVE FUNCTION CURRENT-DATE TO WS-NOW
        MOVE WS-NOW TO SR-RECONCILED OF BK-PX-ST-REC2
    END-IF
    MOVE SPACES TO BK-PX-SS-STO-REQ(1:16)
    MOVE "STL-UPDATE" TO SS-OP
    MOVE WS-O-ID(WS-I) TO SS-STL-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ BK-PX-CY-REC
        BK-PX-ST-REC2 BK-PX-PO-REC.

SAVE-CYCLE.
    MOVE WS-C-ID(WS-J) TO WS-CYC-ID
    MOVE 0 TO WS-CYC-BAD WS-CYC-OK
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-OBL
        IF WS-O-CYCLE(WS-I) = WS-C-ID(WS-J)
            IF WS-O-RECON(WS-I) = "EXCEPTION"
                ADD 1 TO WS-CYC-BAD
            ELSE
                IF WS-O-STATUS(WS-I) = "SETTLED" OR
                   WS-O-STATUS(WS-I) = "RECONCILED"
                    ADD 1 TO WS-CYC-OK
                END-IF
            END-IF
        END-IF
    END-PERFORM
    IF WS-CYC-BAD > 0
        MOVE "RECON-EXCEPTION" TO WS-EVT
    ELSE
        MOVE "RECONCILE" TO WS-EVT
    END-IF
    MOVE SPACES TO BK-PX-SS-STO-REQ
    MOVE "CYC-GET" TO SS-OP
    MOVE WS-C-ID(WS-J) TO SS-CYCLE-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ BK-PX-CY-REC
        BK-PX-ST-REC2 BK-PX-PO-REC
    IF SS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CY-STATUS OF BK-PX-CY-REC TO WS-CUR-STATE
    CALL "BPXCYM" USING WS-CUR-STATE WS-EVT WS-NXT WS-STM-RC
        WS-STM-MSG
    IF WS-STM-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF WS-EVT = "RECONCILE" AND WS-CYC-OK = 0
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NXT TO CY-STATUS OF BK-PX-CY-REC
    IF WS-EVT = "RECONCILE"
        MOVE "MATCHED" TO CY-RECON-STATUS OF BK-PX-CY-REC
    ELSE
        MOVE "EXCEPTION" TO CY-RECON-STATUS OF BK-PX-CY-REC
    END-IF
    MOVE SPACES TO BK-PX-SS-STO-REQ(1:16)
    MOVE "CYC-UPDATE" TO SS-OP
    MOVE WS-C-ID(WS-J) TO SS-CYCLE-ID
    CALL "BPXSLSTO" USING BK-PX-SS-STO-REQ BK-PX-CY-REC
        BK-PX-ST-REC2 BK-PX-PO-REC.
