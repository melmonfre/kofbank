IDENTIFICATION DIVISION.
PROGRAM-ID. BRECCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(20).
01 WS-A PIC X(24).
01 WS-B PIC X(24).
01 WS-C PIC X(120).
01 WS-D PIC X(24).
01 WS-E PIC X(80).
01 WS-QOP PIC X(08).
01 WS-QRC PIC X(02).
COPY "BRECP".

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "run" PERFORM DO-RUN
        WHEN "get" PERFORM DO-GET
        WHEN "list" PERFORM DO-LIST
        WHEN "exceptions" PERFORM DO-EXCEPTIONS
        WHEN "resolve" PERFORM DO-RESOLVE
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN RECONCILIATION OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E
    END-UNSTRING.

DO-RUN.
    MOVE "RUN" TO RP-OP
    MOVE WS-A TO RP-TYPE
    MOVE WS-B TO RP-RUN-ID
    MOVE WS-C TO RP-FILE
    MOVE WS-D TO RP-OPERATOR
    MOVE WS-E TO RP-CORR
    CALL "BREC" USING BK-REC-PARMS
    DISPLAY "rc=" RP-RC
    DISPLAY "run=" FUNCTION TRIM(RP-RUN-ID)
    DISPLAY "msg=" FUNCTION TRIM(RP-MSG).

DO-GET.
    MOVE "GET" TO WS-QOP
    MOVE WS-A TO RP-RUN-ID
    CALL "BRECQ" USING WS-QOP RP-RUN-ID WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-LIST.
    MOVE "LIST" TO WS-QOP
    MOVE SPACES TO RP-RUN-ID
    CALL "BRECQ" USING WS-QOP RP-RUN-ID WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-EXCEPTIONS.
    MOVE "EXC" TO WS-QOP
    MOVE WS-A TO RP-RUN-ID
    CALL "BRECQ" USING WS-QOP RP-RUN-ID WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-RESOLVE.
    MOVE WS-A TO RP-EXC-ID
    MOVE WS-B TO RP-ACTION
    MOVE WS-C TO RP-TXN-REF
    MOVE WS-D TO RP-OPERATOR
    MOVE WS-E TO RP-REASON
    CALL "BRECRES" USING BK-REC-PARMS
    DISPLAY "rc=" RP-RC
    DISPLAY "msg=" FUNCTION TRIM(RP-MSG).
