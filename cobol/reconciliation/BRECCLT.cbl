IDENTIFICATION DIVISION.
PROGRAM-ID. BRECCLT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT COLL-FILE ASSIGN TO WS-COLL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CT-ID
        FILE STATUS IS WS-COLL-ST.
    SELECT ALOC-FILE ASSIGN TO WS-ALOC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS AA-ID
        FILE STATUS IS WS-ALOC-ST.
    SELECT VAL-FILE ASSIGN TO WS-VAL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS VA-ID
        FILE STATUS IS WS-VAL-ST.

DATA DIVISION.
FILE SECTION.
FD COLL-FILE.
01 COLL-REC.
   COPY "CLTC".
FD ALOC-FILE.
01 ALOC-REC.
   COPY "CLTA".
FD VAL-FILE.
01 VAL-REC.
   COPY "CLTV".

WORKING-STORAGE SECTION.
01 WS-COLL-PATH PIC X(200).
01 WS-ALOC-PATH PIC X(200).
01 WS-VAL-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-COLL-ST PIC X(02).
01 WS-ALOC-ST PIC X(02).
01 WS-VAL-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-N-ALLOC PIC 9(05) VALUE 0.
01 WS-ALLOC-MAX PIC 9(05) VALUE 500.
01 WS-AT.
   05 WS-A-ROW OCCURS 500 TIMES.
      10 WS-A-ID PIC X(12).
      10 WS-A-COLL PIC X(12).
      10 WS-A-AMT PIC S9(15)V99 COMP-3.
      10 WS-A-STAT PIC X(12).
01 WS-I PIC 9(05).
01 WS-K PIC 9(05).
01 WS-SUM PIC S9(15)V99 COMP-3.
01 WS-N-COLL PIC 9(05) VALUE 0.
01 WS-HAS-COLL PIC X(01).
01 WS-HAS-VAL PIC X(01).
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-COLL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltcoll.idx"
        DELIMITED SIZE INTO WS-COLL-PATH
    END-STRING
    MOVE SPACES TO WS-ALOC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltalloc.idx"
        DELIMITED SIZE INTO WS-ALOC-PATH
    END-STRING
    MOVE SPACES TO WS-VAL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/cltval.idx"
        DELIMITED SIZE INTO WS-VAL-PATH
    END-STRING
    MOVE "N" TO WS-HAS-COLL
    MOVE "N" TO WS-HAS-VAL
    OPEN INPUT COLL-FILE
    IF WS-COLL-ST = "00"
        MOVE "Y" TO WS-HAS-COLL
    END-IF
    OPEN INPUT VAL-FILE
    IF WS-VAL-ST = "00"
        MOVE "Y" TO WS-HAS-VAL
    END-IF
    MOVE 0 TO WS-N-ALLOC
    MOVE 0 TO WS-N-COLL
    PERFORM LOAD-ALLOCATIONS
    IF REC-RC NOT = "00"
        PERFORM CLOSE-ALL
        GOBACK
    END-IF
    PERFORM CHECK-ALLOCATION-ORPHANS
    PERFORM CHECK-COLLATERALS
    PERFORM CLOSE-ALL
    MOVE WS-N-COLL TO REC-SRC-COUNT
    GOBACK.

CLOSE-ALL.
    IF WS-HAS-COLL = "Y"
        CLOSE COLL-FILE
    END-IF
    IF WS-HAS-VAL = "Y"
        CLOSE VAL-FILE
    END-IF.

LOAD-ALLOCATIONS.
    OPEN INPUT ALOC-FILE
    IF WS-ALOC-ST = "35"
        EXIT PARAGRAPH
    END-IF
    IF WS-ALOC-ST NOT = "00"
        MOVE "36" TO REC-RC
        MOVE "SOURCE FILE UNREADABLE" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ ALOC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-N-ALLOC >= WS-ALLOC-MAX
                    MOVE "37" TO REC-RC
                    MOVE "ALLOCATION SOURCE LIMIT EXCEEDED" TO REC-MSG
                ELSE
                    ADD 1 TO WS-N-ALLOC
                    MOVE AA-ID OF ALOC-REC TO WS-A-ID(WS-N-ALLOC)
                    MOVE AA-COLL-ID OF ALOC-REC TO WS-A-COLL(WS-N-ALLOC)
                    MOVE AA-AMOUNT OF ALOC-REC TO WS-A-AMT(WS-N-ALLOC)
                    MOVE AA-STATUS OF ALOC-REC TO WS-A-STAT(WS-N-ALLOC)
                END-IF
        END-READ
    END-PERFORM
    CLOSE ALOC-FILE.

CHECK-ALLOCATION-ORPHANS.
    IF WS-HAS-COLL NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-ALLOC
        IF WS-A-STAT(WS-I) = "ACTIVE"
            MOVE WS-A-COLL(WS-I) TO CT-ID OF COLL-REC
            READ COLL-FILE
                INVALID KEY CONTINUE
            END-READ
            IF WS-COLL-ST NOT = "00"
                ADD 1 TO REC-UNMATCHED-E
                MOVE SPACES TO BK-EXC-REC
                MOVE "ORPHAN" TO EXC-CODE
                MOVE WS-A-ID(WS-I) TO EXC-KEY
                MOVE WS-A-AMT(WS-I) TO EXC-AMOUNT
                MOVE "ALLOCATION WITHOUT COLLATERAL" TO EXC-REASON
                CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
            END-IF
        END-IF
    END-PERFORM.

CHECK-COLLATERALS.
    IF WS-HAS-COLL NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ COLL-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                ADD 1 TO WS-N-COLL
                PERFORM MATCH-ONE-COLLATERAL
        END-READ
    END-PERFORM.

MATCH-ONE-COLLATERAL.
    MOVE 0 TO WS-SUM
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-ALLOC
        IF WS-A-COLL(WS-K) = CT-ID OF COLL-REC
            AND WS-A-STAT(WS-K) = "ACTIVE"
            ADD WS-A-AMT(WS-K) TO WS-SUM
        END-IF
    END-PERFORM
    IF WS-SUM NOT = CT-ALLOCATED OF COLL-REC
        ADD 1 TO REC-UNMATCHED-I
        MOVE SPACES TO BK-EXC-REC
        MOVE "MISMATCH" TO EXC-CODE
        MOVE CT-ID OF COLL-REC TO EXC-KEY
        MOVE WS-SUM TO EXC-AMOUNT
        MOVE "COLLATERAL ALLOCATED MISMATCH" TO EXC-REASON
        CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    ELSE
        ADD 1 TO REC-MATCHED
    END-IF
    PERFORM CHECK-CURRENT-VALUATION.

CHECK-CURRENT-VALUATION.
    IF CT-VALUATION-ID OF COLL-REC = SPACES
        EXIT PARAGRAPH
    END-IF
    IF WS-HAS-VAL NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE CT-VALUATION-ID OF COLL-REC TO VA-ID OF VAL-REC
    READ VAL-FILE
        INVALID KEY CONTINUE
    END-READ
    IF WS-VAL-ST NOT = "00"
        ADD 1 TO REC-UNMATCHED-I
        MOVE SPACES TO BK-EXC-REC
        MOVE "STALE" TO EXC-CODE
        MOVE CT-ID OF COLL-REC TO EXC-KEY
        MOVE CT-VALUATION OF COLL-REC TO EXC-AMOUNT
        MOVE "CURRENT VALUATION MISSING" TO EXC-REASON
        CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    END-IF.
