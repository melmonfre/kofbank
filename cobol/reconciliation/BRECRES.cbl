IDENTIFICATION DIVISION.
PROGRAM-ID. BRECRES.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-NOW PIC X(14).
COPY "BKAUDP".
01 BK-EXC-REC.
   COPY "BRECE".
01 BK-REC-REC.
   COPY "BREC".

LINKAGE SECTION.
COPY "BRECP".

PROCEDURE DIVISION USING BK-REC-PARMS.
    MOVE "00" TO RP-RC
    MOVE SPACES TO RP-MSG
    PERFORM LOAD-EXCEPTION
    IF RP-RC NOT = "00"
        GOBACK
    END-IF
    IF EXC-STATUS = "CLOSED" OR EXC-STATUS = "REJECTED"
        MOVE "20" TO RP-RC
        MOVE "EXCEPTION IS TERMINAL" TO RP-MSG
        GOBACK
    END-IF
    PERFORM APPLY-ACTION
    IF RP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM SAVE-EXCEPTION
    PERFORM AUDIT-RESOLUTION
    GOBACK.

LOAD-EXCEPTION.
    MOVE "GET" TO RP-OP
    CALL "BRECESO" USING BK-REC-PARMS BK-EXC-REC
    IF RP-RC NOT = "00"
        MOVE "23" TO RP-RC
        MOVE "EXCEPTION NOT FOUND" TO RP-MSG
    END-IF.

APPLY-ACTION.
    EVALUATE RP-ACTION
        WHEN "ACCEPT"
            MOVE "ACCEPTED" TO EXC-STATUS
            MOVE "MANUAL ACCEPTANCE" TO EXC-RESOLUTION
        WHEN "REJECT"
            MOVE "REJECTED" TO EXC-STATUS
            MOVE "REJECTED" TO EXC-RESOLUTION
        WHEN "REPROCESS"
            MOVE "REPROCESSED" TO EXC-STATUS
            MOVE "REPROCESSED" TO EXC-RESOLUTION
        WHEN "EXTERNAL"
            MOVE "RESOLVED" TO EXC-STATUS
            MOVE "EXTERNAL CORRECTION" TO EXC-RESOLUTION
        WHEN "INTERNAL"
            MOVE "RESOLVED" TO EXC-STATUS
            MOVE "INTERNAL CORRECTION" TO EXC-RESOLUTION
        WHEN "ADJUST"
            PERFORM REQUIRE-TXN
            MOVE "RESOLVED" TO EXC-STATUS
            MOVE "APPROVED ADJUSTMENT" TO EXC-RESOLUTION
        WHEN "REVERSE"
            PERFORM REQUIRE-TXN
            MOVE "RESOLVED" TO EXC-STATUS
            MOVE "REVERSAL" TO EXC-RESOLUTION
        WHEN "CLOSE"
            MOVE "CLOSED" TO EXC-STATUS
            MOVE "CLOSED" TO EXC-RESOLUTION
        WHEN OTHER
            MOVE "20" TO RP-RC
            MOVE "UNKNOWN RESOLUTION ACTION" TO RP-MSG
    END-EVALUATE.

REQUIRE-TXN.
    IF RP-TXN-REF = SPACES
        MOVE "20" TO RP-RC
        MOVE "ADJUSTMENT REQUIRES FINANCIAL REFERENCE" TO RP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE RP-TXN-REF TO EXC-TXN-REF.

SAVE-EXCEPTION.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO EXC-UPDATED
    IF RP-OPERATOR = SPACES
        MOVE "SYSTEM" TO EXC-OPERATOR
    ELSE
        MOVE RP-OPERATOR TO EXC-OPERATOR
    END-IF
    MOVE "UPDATE" TO RP-OP
    CALL "BRECESO" USING BK-REC-PARMS BK-EXC-REC
    PERFORM UPDATE-RUN.

UPDATE-RUN.
    MOVE EXC-RUN-ID TO RP-RUN-ID
    MOVE "GET" TO RP-OP
    CALL "BRECSTO" USING BK-REC-PARMS BK-REC-REC
    IF RP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF RP-TXN-REF NOT = SPACES
        ADD 1 TO REC-ADJUSTMENTS
    END-IF
    MOVE EXC-RUN-ID TO RP-RUN-ID
    MOVE "COUNT" TO RP-OP
    CALL "BRECESO" USING BK-REC-PARMS BK-EXC-REC
    MOVE EXC-CREATED TO REC-OPEN-EXC
    IF REC-OPEN-EXC = 0
        MOVE "BALANCED" TO REC-STATUS
    END-IF
    MOVE "UPDATE" TO RP-OP
    CALL "BRECSTO" USING BK-REC-PARMS BK-REC-REC.

AUDIT-RESOLUTION.
    MOVE EXC-OPERATOR TO BK-AUD-OPERATOR
    MOVE "REC.RESOLVE" TO BK-AUD-ACTION
    MOVE EXC-ID TO BK-AUD-ENTITY
    MOVE EXC-RUN-ID TO BK-AUD-CORR
    MOVE EXC-STATUS TO BK-AUD-BEFORE
    MOVE EXC-RESOLUTION TO BK-AUD-AFTER
    MOVE "00" TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE "RESOLVED" TO RP-MSG
    MOVE "00" TO RP-RC.
