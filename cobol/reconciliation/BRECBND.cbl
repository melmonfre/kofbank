IDENTIFICATION DIVISION.
PROGRAM-ID. BRECBND.

*> External boundary reconciliation (GATE 3).  Compares the durable
*> outbound intent store, the SPI settlement double store, the inbound
*> message identity registry and the journal (financial truth).  Raises
*> durable exceptions only; it NEVER repairs, reposts or silently
*> reconciles.  External vs settlement obligation reconciliation for
*> real settlement cycles stays in BPXSTL (pix.stl.recon).

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT OB-FILE ASSIGN TO WS-OB-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS OB-OPID OF OB-REC
        FILE STATUS IS WS-OB-ST.
    SELECT SPI-FILE ASSIGN TO WS-SPI-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS SP-KEY OF SP-REC
        FILE STATUS IS WS-SPI-ST.
    SELECT MI-FILE ASSIGN TO WS-MI-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS MI-MSGID OF MI-REC
        FILE STATUS IS WS-MI-ST.

DATA DIVISION.
FILE SECTION.
FD OB-FILE.
01 OB-REC.
   05 OB-OPID          PIC X(16).
   05 OB-OPKIND        PIC X(12).
   05 OB-OP            PIC X(14).
   05 OB-CHANNEL       PIC X(12).
   05 OB-E2E           PIC X(32).
   05 OB-MSGID         PIC X(32).
   05 OB-AMT           PIC S9(15)V99 COMP-3.
   05 OB-CUR           PIC X(03).
   05 OB-INTERNAL      PIC X(32).
   05 OB-STATE         PIC X(16).
   05 OB-RETRIES       PIC 9(03).
   05 OB-CERTID        PIC X(24).
   05 OB-SIG           PIC X(64).
   05 OB-SIM           PIC X(12).
   05 OB-OUTCOME       PIC X(12).
   05 OB-EXTREF        PIC X(32).
   05 OB-FP            PIC X(16).
   05 OB-ENV           PIC X(16).
   05 OB-REASON        PIC X(60).
   05 OB-OPER          PIC X(12).
   05 OB-CORR          PIC X(24).
   05 OB-CREATED       PIC 9(14).
   05 OB-SENT          PIC 9(14).
   05 OB-RESP          PIC 9(14).
FD SPI-FILE.
01 SP-REC.
   05 SP-KEY           PIC X(36).
   05 SP-RESULT        PIC X(12).
   05 SP-EXT-REF       PIC X(32).
   05 SP-AMOUNT        PIC S9(15)V99 COMP-3.
   05 SP-CURRENCY      PIC X(03).
   05 SP-QUERIES       PIC 9(03).
   05 SP-CREATED       PIC 9(14).
FD MI-FILE.
01 MI-REC.
   05 MI-MSGID         PIC X(32).
   05 MI-VER           PIC X(05).
   05 MI-MSGNM         PIC X(20).
   05 MI-E2E           PIC X(32).
   05 MI-FP            PIC X(16).
   05 MI-ENV           PIC X(16).
   05 MI-CHANNEL       PIC X(12).
   05 MI-STATE         PIC X(12).
   05 MI-PIXID         PIC X(12).
   05 MI-TXNID         PIC X(12).
   05 MI-JRNID         PIC X(20).
   05 MI-AMT           PIC S9(15)V99 COMP-3.
   05 MI-CUR           PIC X(03).
   05 MI-CREATED       PIC 9(14).
   05 MI-UPDATED       PIC 9(14).
   05 MI-COUNT         PIC 9(03).

WORKING-STORAGE SECTION.
01 WS-OB-PATH PIC X(200).
01 WS-SPI-PATH PIC X(200).
01 WS-MI-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-OB-ST PIC X(02).
01 WS-SPI-ST PIC X(02).
01 WS-MI-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-AGE-CUTOFF PIC 9(14).
01 WS-NOW PIC X(14).
01 WS-O-CNT PIC 9(06).
01 WS-M-CNT PIC 9(06).
01 WS-J PIC 9(04).
01 WS-ROWS-MAX PIC 9(04) VALUE 200.
01 WS-POST-ROWS.
   05 WS-POST-ROW OCCURS 200 TIMES.
      10 WS-POST-MSGID  PIC X(32).
      10 WS-POST-JRN    PIC X(20).
01 WS-N-POST PIC 9(04) VALUE 0.
01 WS-IDX PIC 9(04).
COPY "BKJRNP".
COPY "BKPSTT".
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    MOVE "00" TO REC-RC
    MOVE SPACES TO REC-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE 86400 TO WS-AGE-CUTOFF
    COMPUTE WS-AGE-CUTOFF =
        FUNCTION NUMVAL(WS-NOW(1:14)) - WS-AGE-CUTOFF
    PERFORM PATHS
    PERFORM SCAN-OUTBOX
    IF REC-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM SCAN-REGISTRY
    IF REC-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM VERIFY-POSTED-JOURNALS
    GOBACK.

PATHS.
    MOVE SPACES TO WS-OB-PATH WS-SPI-PATH WS-MI-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/bndout.idx"
        DELIMITED SIZE INTO WS-OB-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pxspis.idx"
        DELIMITED SIZE INTO WS-SPI-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/bndmsgid.idx"
        DELIMITED SIZE INTO WS-MI-PATH.

SCAN-OUTBOX.
    MOVE 0 TO WS-O-CNT
    OPEN INPUT OB-FILE
    IF WS-OB-ST = "35"
        CLOSE OB-FILE
        EXIT PARAGRAPH
    END-IF
    IF WS-OB-ST NOT = "00"
        MOVE WS-OB-ST TO REC-RC
        MOVE "CANNOT OPEN OUTBOUND INTENT STORE" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ OB-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM OUTBOX-CHECKS
        END-READ
    END-PERFORM
    CLOSE OB-FILE.

OUTBOX-CHECKS.
    ADD 1 TO WS-O-CNT
    IF OB-STATE OF OB-REC NOT = "ACKED" AND
       OB-STATE OF OB-REC NOT = "REJECTED"
        IF OB-CREATED OF OB-REC < WS-AGE-CUTOFF
            PERFORM RAISE-STALE
        END-IF
        IF OB-STATE OF OB-REC = "UNKNOWN" AND
           OB-REASON OF OB-REC = SPACES
            PERFORM RAISE-UNCORRELATED
        END-IF
    END-IF
    IF OB-STATE OF OB-REC = "ACKED" AND
       OB-OPKIND OF OB-REC = "STL" AND
       OB-CHANNEL OF OB-REC = "SPI"
        PERFORM VERIFY-SPI-RECORD
    END-IF.

VERIFY-SPI-RECORD.
    OPEN INPUT SPI-FILE
    IF WS-SPI-ST = "35" OR WS-SPI-ST NOT = "00"
        CLOSE SPI-FILE
        PERFORM RAISE-NO-EXTERNAL
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO SP-KEY OF SP-REC
    STRING "S" DELIMITED SIZE FUNCTION TRIM(OB-E2E OF OB-REC)
        DELIMITED SIZE INTO SP-KEY OF SP-REC
    END-STRING
    READ SPI-FILE
        INVALID KEY
            CLOSE SPI-FILE
            PERFORM RAISE-NO-EXTERNAL
            EXIT PARAGRAPH
    END-READ
    IF SP-RESULT OF SP-REC = "REJECTED"
        CLOSE SPI-FILE
        PERFORM RAISE-OUTCOME-CONFLICT
        EXIT PARAGRAPH
    END-IF
    IF SP-AMOUNT OF SP-REC NOT = OB-AMT OF OB-REC
        CLOSE SPI-FILE
        PERFORM RAISE-AMOUNT-CONFLICT
        EXIT PARAGRAPH
    END-IF
    CLOSE SPI-FILE.

SCAN-REGISTRY.
    MOVE 0 TO WS-M-CNT
    OPEN INPUT MI-FILE
    IF WS-MI-ST = "35"
        CLOSE MI-FILE
        EXIT PARAGRAPH
    END-IF
    IF WS-MI-ST NOT = "00"
        MOVE WS-MI-ST TO REC-RC
        MOVE "CANNOT OPEN MESSAGE IDENTITY STORE" TO REC-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ MI-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM REGISTRY-CHECKS
        END-READ
    END-PERFORM
    CLOSE MI-FILE.

REGISTRY-CHECKS.
    ADD 1 TO WS-M-CNT
    IF MI-STATE OF MI-REC = "RECEIVED" AND
       MI-CREATED OF MI-REC < WS-AGE-CUTOFF
        PERFORM RAISE-UNFINISHED
    END-IF
    IF MI-STATE OF MI-REC = "POSTED"
        IF WS-N-POST < WS-ROWS-MAX
            ADD 1 TO WS-N-POST
            MOVE MI-MSGID OF MI-REC TO WS-POST-MSGID(WS-N-POST)
            MOVE MI-JRNID OF MI-REC TO WS-POST-JRN(WS-N-POST)
        ELSE
            MOVE "20" TO REC-RC
            MOVE "BOUNDARY RECON ROW LIMIT EXCEEDED" TO REC-MSG
        END-IF
    END-IF.

VERIFY-POSTED-JOURNALS.
    PERFORM VARYING WS-IDX FROM 1 BY 1
        UNTIL WS-IDX > WS-N-POST
        MOVE SPACES TO BK-JRN-PARMS
        MOVE "G" TO BK-JRN-MODE
        MOVE WS-POST-JRN(WS-IDX) TO BK-JRN-ID
        CALL "BJRN" USING BK-JRN-PARMS BK-PST-TABLE
        IF BK-JRN-F-FOUND = 0
            PERFORM RAISE-NO-LEDGER
        END-IF
    END-PERFORM.

RAISE-STALE.
    MOVE SPACES TO BK-EXC-REC
    MOVE "OUTB_STALE" TO EXC-CODE
    MOVE OB-OPID OF OB-REC TO EXC-KEY
    MOVE OB-OPID OF OB-REC TO EXC-SRC-REF
    MOVE OB-STATE OF OB-REC TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-UNCORRELATED.
    MOVE SPACES TO BK-EXC-REC
    MOVE "OUTB_UNCORR" TO EXC-CODE
    MOVE OB-OPID OF OB-REC TO EXC-KEY
    MOVE OB-OPID OF OB-REC TO EXC-SRC-REF
    MOVE "EXTERNAL UNKNOWN WITHOUT CORRELATION REASON"
        TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-NO-EXTERNAL.
    MOVE SPACES TO BK-EXC-REC
    MOVE "OUTB_NOEXT" TO EXC-CODE
    MOVE OB-OPID OF OB-REC TO EXC-KEY
    MOVE OB-OPID OF OB-REC TO EXC-SRC-REF
    MOVE OB-INTERNAL OF OB-REC TO EXC-INT-REF
    MOVE OB-AMT OF OB-REC TO EXC-AMOUNT
    MOVE OB-CUR OF OB-REC TO EXC-CURRENCY
    MOVE "ACKED INTENT WITHOUT EXTERNAL RECORD" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-OUTCOME-CONFLICT.
    MOVE SPACES TO BK-EXC-REC
    MOVE "OUTB_CONF" TO EXC-CODE
    MOVE OB-OPID OF OB-REC TO EXC-KEY
    MOVE OB-OPID OF OB-REC TO EXC-SRC-REF
    MOVE OB-INTERNAL OF OB-REC TO EXC-INT-REF
    MOVE "INTERNAL ACKED EXTERNAL REJECTED" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-AMOUNT-CONFLICT.
    MOVE SPACES TO BK-EXC-REC
    MOVE "OUTB_AMT" TO EXC-CODE
    MOVE OB-OPID OF OB-REC TO EXC-KEY
    MOVE OB-OPID OF OB-REC TO EXC-SRC-REF
    MOVE OB-AMT OF OB-REC TO EXC-AMOUNT
    MOVE OB-CUR OF OB-REC TO EXC-CURRENCY
    MOVE "INTENT AND EXTERNAL AMOUNTS DIFFER" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-UNFINISHED.
    MOVE SPACES TO BK-EXC-REC
    MOVE "MSG_UNFIN" TO EXC-CODE
    MOVE MI-MSGID OF MI-REC(1:24) TO EXC-KEY
    MOVE MI-MSGID OF MI-REC(1:24) TO EXC-SRC-REF
    MOVE "RECEIVED MESSAGE NEVER RESOLVED" TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.

RAISE-NO-LEDGER.
    MOVE SPACES TO BK-EXC-REC
    MOVE "MSG_NOLEDG" TO EXC-CODE
    MOVE WS-POST-MSGID(WS-IDX)(1:24) TO EXC-KEY
    MOVE WS-POST-MSGID(WS-IDX)(1:24) TO EXC-SRC-REF
    MOVE WS-POST-JRN(WS-IDX) TO EXC-TXN-REF
    MOVE "POSTED MESSAGE WITHOUT JOURNAL IN LEDGER"
        TO EXC-REASON
    CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC.
