IDENTIFICATION DIVISION.
PROGRAM-ID. BRECSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT REC-FILE ASSIGN TO WS-REC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS REC-RUN-ID OF REC-REC
        FILE STATUS IS WS-REC-ST.

DATA DIVISION.
FILE SECTION.
FD REC-FILE.
01 REC-REC.
   COPY "BREC".

WORKING-STORAGE SECTION.
01 WS-REC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-REC-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-CNT PIC 9(09).

LINKAGE SECTION.
COPY "BRECP".
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-PARMS BK-REC-REC.
    MOVE "00" TO RP-RC
    MOVE SPACES TO RP-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-REC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/rec.idx"
        DELIMITED SIZE INTO WS-REC-PATH
    PERFORM OPEN-STORE
    IF RP-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE RP-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "UPDATE" PERFORM DO-UPDATE
        WHEN "GET" PERFORM DO-GET
        WHEN "COUNT" PERFORM DO-COUNT
        WHEN OTHER
            MOVE "99" TO RP-RC
            MOVE "UNKNOWN REC STORE OP" TO RP-MSG
    END-EVALUATE
    CLOSE REC-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O REC-FILE
    IF WS-REC-ST = "35"
        OPEN OUTPUT REC-FILE
        CLOSE REC-FILE
        OPEN I-O REC-FILE
    END-IF
    IF WS-REC-ST NOT = "00"
        MOVE WS-REC-ST TO RP-RC
        MOVE "CANNOT OPEN RECON INDEX" TO RP-MSG
    END-IF.

DO-WRITE.
    MOVE BK-REC-REC TO REC-REC
    WRITE REC-REC
        INVALID KEY
            MOVE "22" TO RP-RC
            MOVE "RUN ALREADY EXISTS" TO RP-MSG
    END-WRITE.

DO-UPDATE.
    MOVE REC-RUN-ID OF BK-REC-REC TO REC-RUN-ID OF REC-REC
    READ REC-FILE
    IF WS-REC-ST = "00"
        MOVE BK-REC-REC TO REC-REC
        REWRITE REC-REC
    ELSE
        MOVE "23" TO RP-RC
        MOVE "RUN NOT FOUND" TO RP-MSG
    END-IF.

DO-GET.
    MOVE RP-RUN-ID TO REC-RUN-ID OF REC-REC
    READ REC-FILE
    IF WS-REC-ST = "00"
        MOVE REC-REC TO BK-REC-REC
        MOVE "00" TO RP-RC
    ELSE
        MOVE "23" TO RP-RC
        MOVE "RUN NOT FOUND" TO RP-MSG
    END-IF.

DO-COUNT.
    MOVE 0 TO WS-CNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ REC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END ADD 1 TO WS-CNT
        END-READ
    END-PERFORM
    MOVE WS-CNT TO REC-INT-COUNT OF BK-REC-REC.
