IDENTIFICATION DIVISION.
PROGRAM-ID. BRECCRD.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT FAC-FILE ASSIGN TO WS-FAC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CRF-ID
        FILE STATUS IS WS-FAC-ST.
    SELECT EXP-FILE ASSIGN TO WS-EXP-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CX-FAC-ID
        FILE STATUS IS WS-EXP-ST.
    SELECT TXN-FILE ASSIGN TO WS-TXN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS TXN-ID
        FILE STATUS IS WS-TXN-ST.

DATA DIVISION.
FILE SECTION.
FD FAC-FILE.
01 FAC-REC.
   COPY "BCRF".
FD EXP-FILE.
01 EXP-REC.
   COPY "BCEXP".
FD TXN-FILE.
01 TXN-REC.
   COPY "BTXREC".

WORKING-STORAGE SECTION.
01 WS-FAC-PATH PIC X(200).
01 WS-EXP-PATH PIC X(200).
01 WS-TXN-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-FAC-ST PIC X(02).
01 WS-EXP-ST PIC X(02).
01 WS-TXN-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-N-FAC PIC 9(05) VALUE 0.
01 WS-FAC-MAX PIC 9(05) VALUE 100.
01 WS-FT.
   05 WS-F-ROW OCCURS 100 TIMES.
      10 WS-F-ID PIC X(12).
      10 WS-F-CUR PIC X(03).
01 WS-N-TXN PIC 9(05) VALUE 0.
01 WS-TXN-MAX PIC 9(05) VALUE 200.
01 WS-TT.
   05 WS-T-ROW OCCURS 200 TIMES.
      10 WS-T-ID PIC X(12).
      10 WS-T-TYPE PIC X(08).
      10 WS-T-STATUS PIC X(02).
      10 WS-T-FAC PIC X(12).
      10 WS-T-PRIN PIC S9(15)V99 COMP-3.
      10 WS-T-AMT PIC S9(15)V99 COMP-3.
01 WS-I PIC 9(05).
01 WS-K PIC 9(05).
01 WS-COMPUTED PIC S9(15)V99 COMP-3.
01 WS-EXP-PRIN PIC S9(15)V99 COMP-3.
01 WS-FOUND PIC X(01).
01 BK-EXC-REC.
   COPY "BRECE".

LINKAGE SECTION.
01 BK-REC-REC.
   COPY "BREC".

PROCEDURE DIVISION USING BK-REC-REC.
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-FAC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crfac.idx"
        DELIMITED SIZE INTO WS-FAC-PATH
    MOVE SPACES TO WS-EXP-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crexp.idx"
        DELIMITED SIZE INTO WS-EXP-PATH
    MOVE SPACES TO WS-TXN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/txn.idx"
        DELIMITED SIZE INTO WS-TXN-PATH
    MOVE 0 TO WS-N-FAC
    MOVE 0 TO WS-N-TXN
    PERFORM LOAD-FACILITIES
    PERFORM LOAD-TXNS
    PERFORM MATCH-FACILITIES
    MOVE WS-N-FAC TO REC-SRC-COUNT
    GOBACK.

LOAD-FACILITIES.
    OPEN INPUT FAC-FILE
    IF WS-FAC-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ FAC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-N-FAC < WS-FAC-MAX
                    ADD 1 TO WS-N-FAC
                    MOVE CRF-ID OF FAC-REC TO WS-F-ID(WS-N-FAC)
                    MOVE CRF-CURRENCY OF FAC-REC TO WS-F-CUR(WS-N-FAC)
                END-IF
        END-READ
    END-PERFORM
    CLOSE FAC-FILE.

LOAD-TXNS.
    OPEN INPUT TXN-FILE
    IF WS-TXN-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ TXN-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-N-TXN < WS-TXN-MAX
                    ADD 1 TO WS-N-TXN
                    MOVE TXN-ID OF TXN-REC TO WS-T-ID(WS-N-TXN)
                    MOVE TXN-TYPE OF TXN-REC TO WS-T-TYPE(WS-N-TXN)
                    MOVE TXN-STATUS OF TXN-REC TO WS-T-STATUS(WS-N-TXN)
                    MOVE TXN-FACILITY OF TXN-REC TO WS-T-FAC(WS-N-TXN)
                    MOVE TXN-PRINCIPAL OF TXN-REC TO WS-T-PRIN(WS-N-TXN)
                    MOVE TXN-AMOUNT OF TXN-REC TO WS-T-AMT(WS-N-TXN)
                END-IF
        END-READ
    END-PERFORM
    CLOSE TXN-FILE.

MATCH-FACILITIES.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-FAC
        PERFORM MATCH-ONE-FACILITY
    END-PERFORM.

MATCH-ONE-FACILITY.
    MOVE 0 TO WS-COMPUTED
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > WS-N-TXN
        PERFORM ACCUMULATE-TXN
    END-PERFORM
    MOVE SPACES TO EXP-REC
    MOVE WS-F-ID(WS-I) TO CX-FAC-ID
    OPEN INPUT EXP-FILE
    IF WS-EXP-ST = "00"
        READ EXP-FILE
        IF WS-EXP-ST = "00"
            MOVE CX-PRINCIPAL OF EXP-REC TO WS-EXP-PRIN
        ELSE
            MOVE -1 TO WS-EXP-PRIN
        END-IF
        CLOSE EXP-FILE
    ELSE
        MOVE -1 TO WS-EXP-PRIN
    END-IF
    IF WS-EXP-PRIN < 0
        ADD 1 TO REC-UNMATCHED-I
        MOVE SPACES TO BK-EXC-REC
        MOVE "NO_EXPOSURE" TO EXC-CODE
        MOVE WS-F-ID(WS-I) TO EXC-KEY
        MOVE "FACILITY HAS NO EXPOSURE" TO EXC-REASON
        CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
    ELSE
        IF WS-COMPUTED NOT = WS-EXP-PRIN
            ADD 1 TO REC-UNMATCHED-I
            MOVE SPACES TO BK-EXC-REC
            MOVE "MISMATCH" TO EXC-CODE
            MOVE WS-F-ID(WS-I) TO EXC-KEY
            MOVE WS-COMPUTED TO EXC-AMOUNT
            MOVE "EXPOSURE PRINCIPAL MISMATCH" TO EXC-REASON
            CALL "BRECEXC" USING BK-REC-REC BK-EXC-REC
        ELSE
            ADD 1 TO REC-MATCHED
        END-IF
    END-IF.

ACCUMULATE-TXN.
    IF WS-T-STATUS(WS-K) NOT = "ST" AND WS-T-STATUS(WS-K) NOT = "CP"
        EXIT PARAGRAPH
    END-IF
    IF WS-T-FAC(WS-K) NOT = WS-F-ID(WS-I)
        EXIT PARAGRAPH
    END-IF
    EVALUATE WS-T-TYPE(WS-K)
        WHEN "CREDDISB"
            ADD WS-T-PRIN(WS-K) TO WS-COMPUTED
        WHEN "CREDREPY"
            SUBTRACT WS-T-PRIN(WS-K) FROM WS-COMPUTED
        WHEN "CREDWOFF"
            SUBTRACT WS-T-AMT(WS-K) FROM WS-COMPUTED
    END-EVALUATE.
