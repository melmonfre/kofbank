IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCASTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT AUTH-FILE ASSIGN TO WS-A-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CA-ID
        FILE STATUS IS WS-A-ST.

DATA DIVISION.
FILE SECTION.
FD AUTH-FILE.
01 AUTH-REC.
   COPY "CCRA".

WORKING-STORAGE SECTION.
01 WS-A-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-A-ST PIC X(02).

LINKAGE SECTION.
COPY "CCRASTO".
01 BK-CCRD-AUTH.
   COPY "CCRA".

PROCEDURE DIVISION USING BK-CCRD-STO-AUTH BK-CCRD-AUTH.
    MOVE "00" TO SA-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-A-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdauth.idx"
        DELIMITED SIZE INTO WS-A-PATH
    OPEN I-O AUTH-FILE
    IF WS-A-ST = "35"
        OPEN OUTPUT AUTH-FILE
        CLOSE AUTH-FILE
        OPEN I-O AUTH-FILE
    END-IF
    IF WS-A-ST NOT = "00"
        MOVE WS-A-ST TO SA-RC
        GOBACK
    END-IF
    EVALUATE SA-OP
        WHEN "WRITE"
            MOVE BK-CCRD-AUTH TO AUTH-REC
            WRITE AUTH-REC
                INVALID KEY MOVE "22" TO SA-RC
            END-WRITE
        WHEN "REWRITE"
            MOVE CA-ID OF BK-CCRD-AUTH TO CA-ID OF AUTH-REC
            READ AUTH-FILE
            IF WS-A-ST = "00"
                MOVE BK-CCRD-AUTH TO AUTH-REC
                REWRITE AUTH-REC
            ELSE
                MOVE "23" TO SA-RC
            END-IF
        WHEN "GET"
            MOVE CA-ID OF BK-CCRD-AUTH TO CA-ID OF AUTH-REC
            READ AUTH-FILE
            IF WS-A-ST = "00"
                MOVE AUTH-REC TO BK-CCRD-AUTH
            ELSE
                MOVE "23" TO SA-RC
            END-IF
        WHEN OTHER
            MOVE "99" TO SA-RC
    END-EVALUATE
    CLOSE AUTH-FILE
    GOBACK.
