IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCM.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "CCRCSTO".
COPY "CCRMSTO".
COPY "CCREXCSTO".
COPY "CCRASTO".
COPY "CCRDGP".
COPY "CCRDP".
01 BK-CCRD-CLR.
   COPY "CCRC".
01 BK-CCRD-MATCH.
   COPY "CCRM".
01 BK-CCRD-EXC-REC.
   COPY "CCREXC".
01 BK-CCRD-AUTH.
   COPY "CCRA".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).
01 WS-LOCKED PIC X(01).
01 WS-MODE PIC X(08).
01 WS-VAL PIC X(32).
01 WS-N-CAND PIC 9(03).
01 WS-CAND.
   05 WS-C-ID-ROW OCCURS 25 TIMES PIC X(12).
01 WS-SCAN-N PIC 9(03).
01 WS-SCAN.
   05 WS-S-ID-ROW OCCURS 25 TIMES PIC X(12).
01 WS-I PIC 9(03).
01 WS-KEEP PIC X(01).
01 WS-METH PIC X(16).
01 WS-RESULT PIC X(12).
01 WS-REASON PIC X(40).
01 WS-MSGT PIC X(80).
01 WS-RC-T PIC X(02).
01 WS-NEXT PIC X(12).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-REVIEW PIC X(01) VALUE "N".
01 WS-SEQ-NAME PIC X(20).
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-IDX PIC X(12).
01 WS-NOW PIC X(14).
01 WS-CAP PIC S9(15)V99 COMP-3.
01 WS-STRICT PIC X(01).
01 WS-PFX PIC X(01).
01 WS-EX-TYPE PIC X(16).
01 WS-EVT PIC X(16).
01 WS-AUD-BEFORE PIC X(120).
01 WS-AUD-AFTER PIC X(120).
01 WS-A-ENT PIC X(12).
01 WS-A-ACT PIC X(12).
01 WS-REQ PIC X(24).

LINKAGE SECTION.
COPY "CCRCP".

PROCEDURE DIVISION USING BK-CCRD-CLR-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    MOVE "N" TO CP-REPLAY
    MOVE "N" TO WS-LOCKED
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    EVALUATE CP-OP
        WHEN "CLEARING-MATCH" PERFORM DO-MATCH
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN CLEARING OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

DO-MATCH.
    PERFORM LOCK-CLR
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CLR
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-CLR
        GOBACK
    END-IF
    MOVE CC-STATUS TO WS-AUD-BEFORE
    IF CC-MATCH-STATUS = "MATCHED" OR
       CC-MATCH-STATUS = "NO-AUTH"
        MOVE "Y" TO CP-REPLAY
        PERFORM EXPOSE-CLR
        PERFORM UNLOCK-CLR
        MOVE "MATCH ALREADY DONE" TO CP-MSG
        GOBACK
    END-IF
    IF CC-STATUS = "RECEIVED"
        MOVE "ACCEPT" TO WS-EVT
        CALL "CCRCST" USING CC-STATUS WS-EVT WS-NEXT WS-RC-T WS-MSGT
        IF WS-RC-T = "00"
            MOVE WS-NEXT TO CC-STATUS
        END-IF
    END-IF
    IF CC-STATUS NOT = "VALIDATED" AND
       CC-STATUS NOT = "UNMATCHED" AND
       CC-STATUS NOT = "EXCEPTION"
        MOVE "20" TO CP-RC
        MOVE "CLEARING NOT MATCHABLE" TO CP-MSG
        PERFORM UNLOCK-CLR
        GOBACK
    END-IF
    PERFORM FIND-AUTH
    PERFORM APPLY-RESULT
    PERFORM RECORD-HISTORY
    IF CP-RC = "00"
        PERFORM SAVE-CLR
    END-IF
    PERFORM UNLOCK-CLR
    IF CP-RC = "00"
        MOVE CC-ID TO WS-A-ENT
        MOVE "MATCH" TO WS-A-ACT
        MOVE CC-STATUS TO WS-AUD-AFTER
        CALL "CCRCRA" USING BK-CCRD-CLR-PARMS WS-A-ENT WS-A-ACT
            WS-AUD-BEFORE WS-AUD-AFTER
    END-IF
    IF WS-REVIEW = "Y"
        MOVE "20" TO CP-RC
        MOVE "MATCH NEEDS REVIEW" TO CP-MSG
    ELSE
        MOVE "CLEARING MATCHED" TO CP-MSG
    END-IF
    PERFORM EXPOSE-CLR
    GOBACK.

LOCK-CLR.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "LOCK" TO GD-OP
    STRING "CLR-" DELIMITED SIZE CP-CLR-ID DELIMITED SIZE
        INTO GD-LOCK-ID
    END-STRING
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "CLEARING BUSY" TO CP-MSG
    END-IF.

UNLOCK-CLR.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "UNLOCK" TO GD-OP
    STRING "CLR-" DELIMITED SIZE CP-CLR-ID DELIMITED SIZE
        INTO GD-LOCK-ID
    END-STRING
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD.

LOAD-CLR.
    MOVE CP-CLR-ID TO CC-ID
    MOVE "GET" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "CLEARING NOT FOUND" TO CP-MSG
    END-IF.

SAVE-CLR.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO CC-UPDATED
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE SC-RC TO CP-RC
        MOVE "CLEARING UPDATE FAILED" TO CP-MSG
    END-IF.

FIND-AUTH.
    MOVE 0 TO WS-N-CAND
    MOVE SPACES TO WS-METH
    MOVE SPACES TO WS-RESULT
    MOVE SPACES TO WS-REASON
    IF CC-TXN-TYPE = "REFUND" OR CC-TXN-TYPE = "FEE"
       OR CC-TXN-TYPE = "REVERSAL"
        MOVE "NO-AUTH" TO WS-RESULT
        MOVE "NO-AUTH-REQUIRED" TO WS-REASON
        EXIT PARAGRAPH
    END-IF
    IF CC-AUTH-ID NOT = SPACES
        MOVE CC-AUTH-ID TO CA-ID
        MOVE "GET" TO SA-OP
        CALL "CCRCASTO" USING BK-CCRD-STO-AUTH BK-CCRD-AUTH
        IF SA-RC = "00" AND CA-CARD-ID = CC-CARD-ID
            MOVE 1 TO WS-N-CAND
            MOVE CA-ID TO WS-C-ID-ROW(1)
            MOVE "GIVEN-REF" TO WS-METH
        ELSE
            MOVE "GIVEN-NOT-FOUND" TO WS-METH
            MOVE "NO-CANDIDATE" TO WS-REASON
        END-IF
        EXIT PARAGRAPH
    END-IF
    MOVE CC-EXT-REF TO WS-VAL
    MOVE "EXTREF" TO WS-MODE
    CALL "CCRCAUS" USING WS-MODE WS-VAL WS-SCAN-N WS-SCAN
        WS-RC-T
    IF WS-RC-T = "00" AND WS-SCAN-N > 0
        MOVE "Y" TO WS-STRICT
        PERFORM FILTER-SCAN
        MOVE "N" TO WS-STRICT
        IF WS-N-CAND = 1
            MOVE "EXT-REF" TO WS-METH
            EXIT PARAGRAPH
        END-IF
        IF WS-N-CAND > 1
            MOVE "MULTI-CANDIDATE" TO WS-REASON
            EXIT PARAGRAPH
        END-IF
        MOVE 0 TO WS-N-CAND
    END-IF
    MOVE CC-CARD-ID TO WS-VAL
    MOVE "CARD" TO WS-MODE
    CALL "CCRCAUS" USING WS-MODE WS-VAL WS-SCAN-N WS-SCAN WS-RC-T
    IF WS-RC-T = "00" AND WS-SCAN-N > 0
        PERFORM FILTER-SCAN
        IF WS-N-CAND = 1
            MOVE "CARD-SCOPE" TO WS-METH
        ELSE IF WS-N-CAND > 1
            MOVE "MULTI-CANDIDATE" TO WS-REASON
        END-IF
    END-IF
    IF WS-N-CAND = 0 AND WS-RESULT = SPACES
        MOVE "UNMATCHED" TO WS-RESULT
        IF WS-REASON = SPACES
            MOVE "NO-CANDIDATE" TO WS-REASON
        END-IF
    END-IF.

FILTER-SCAN.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-SCAN-N
        MOVE WS-S-ID-ROW(WS-I) TO CA-ID
        MOVE "GET" TO SA-OP
        CALL "CCRCASTO" USING BK-CCRD-STO-AUTH BK-CCRD-AUTH
        IF SA-RC = "00"
            PERFORM CONSIDER-CAND
        END-IF
    END-PERFORM.

CONSIDER-CAND.
    MOVE "N" TO WS-KEEP
    IF CA-CARD-ID NOT = CC-CARD-ID
        EXIT PARAGRAPH
    END-IF
    IF CA-STATUS NOT = "APPROVED" AND CA-STATUS NOT = "PARTCAP"
       AND CA-STATUS NOT = "PENDING"
        EXIT PARAGRAPH
    END-IF
    IF CA-CURRENCY NOT = CC-CURRENCY
        EXIT PARAGRAPH
    END-IF
    IF WS-STRICT NOT = "Y"
        IF CA-AMOUNT < CC-AMOUNT
            EXIT PARAGRAPH
        END-IF
        IF CA-DATE > CC-TXN-DATE
            EXIT PARAGRAPH
        END-IF
    END-IF
    MOVE "Y" TO WS-KEEP
    ADD 1 TO WS-N-CAND
    MOVE CA-ID TO WS-C-ID-ROW(WS-N-CAND).

APPLY-RESULT.
    IF WS-RESULT NOT = SPACES
        EXIT PARAGRAPH
    END-IF
    IF WS-N-CAND = 0
        MOVE "UNMATCHED" TO WS-RESULT
        IF WS-REASON = SPACES
            MOVE "NO-CANDIDATE" TO WS-REASON
        END-IF
        EXIT PARAGRAPH
    END-IF
    IF WS-N-CAND > 1
        MOVE "AMBIGUOUS" TO WS-RESULT
        EXIT PARAGRAPH
    END-IF
    MOVE WS-C-ID-ROW(1) TO CA-ID
    MOVE "GET" TO SA-OP
    CALL "CCRCASTO" USING BK-CCRD-STO-AUTH BK-CCRD-AUTH
    IF CA-CLEAR-ID NOT = SPACES AND
       CA-CLEAR-ID NOT = CC-ID
        MOVE "DUPLICATE" TO WS-RESULT
        MOVE "AUTH CLAIMED BY OTHER CLEARING" TO WS-REASON
        EXIT PARAGRAPH
    END-IF
    IF CA-EXPIRY > 0 AND CA-EXPIRY < CC-CLEAR-DATE
        MOVE "EXPIRED" TO WS-RESULT
        MOVE CA-ID TO CC-AUTH-ID
        MOVE CA-AMOUNT TO CC-AUTH-AMOUNT
        COMPUTE CC-DIFF-AMOUNT = CC-AMOUNT - CA-AMOUNT
        EXIT PARAGRAPH
    END-IF
    MOVE "MATCHED" TO WS-RESULT
    MOVE CA-ID TO CC-AUTH-ID
    MOVE CA-AMOUNT TO CC-AUTH-AMOUNT
    COMPUTE CC-DIFF-AMOUNT = CC-AMOUNT - CA-AMOUNT
    IF WS-METH = SPACES
        MOVE "CARD-SCOPE" TO WS-METH
    END-IF.

RECORD-HISTORY.
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "I" TO WS-PFX
    PERFORM NEXT-ID
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-CCRD-MATCH
    MOVE WS-IDX TO CM-ID
    MOVE CC-ID TO CM-CLR-ID
    IF WS-RESULT NOT = "UNMATCHED"
        MOVE CC-AUTH-ID TO CM-AUTH-ID
    END-IF
    MOVE WS-METH TO CM-METHOD
    MOVE WS-RESULT TO CM-RESULT
    MOVE WS-BIZDATE TO CM-BIZDATE
    MOVE CP-OPERATOR TO CM-OPERATOR
    MOVE WS-REASON TO CM-REASON
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO CM-TIMESTAMP
    MOVE "WRITE" TO SM-OP
    CALL "CCRMSTO" USING BK-CCRD-STO-MATCH BK-CCRD-MATCH
    IF SM-RC NOT = "00"
        MOVE SM-RC TO CP-RC
        MOVE "MATCH HISTORY WRITE FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    EVALUATE WS-RESULT
        WHEN "MATCHED"
            MOVE "MATCH" TO WS-EVT
        CALL "CCRCST" USING CC-STATUS WS-EVT WS-NEXT WS-RC-T WS-MSGT
            IF WS-RC-T = "00"
                MOVE WS-NEXT TO CC-STATUS
                MOVE "MATCHED" TO CC-MATCH-STATUS
            END-IF
        WHEN "EXPIRED"
            MOVE "MATCH" TO WS-EVT
        CALL "CCRCST" USING CC-STATUS WS-EVT WS-NEXT WS-RC-T WS-MSGT
            IF WS-RC-T = "00"
                MOVE WS-NEXT TO CC-STATUS
                MOVE "EXPIRED" TO CC-MATCH-STATUS
            END-IF
            PERFORM OPEN-EXCEPTION
            MOVE "Y" TO WS-REVIEW
        WHEN "UNMATCHED"
            MOVE "UNMATCH" TO WS-EVT
        CALL "CCRCST" USING CC-STATUS WS-EVT WS-NEXT WS-RC-T WS-MSGT
            IF WS-RC-T = "00"
                MOVE WS-NEXT TO CC-STATUS
                MOVE "UNMATCHED" TO CC-MATCH-STATUS
            END-IF
            PERFORM OPEN-EXCEPTION
        WHEN "NO-AUTH"
            MOVE "MATCH" TO WS-EVT
        CALL "CCRCST" USING CC-STATUS WS-EVT WS-NEXT WS-RC-T WS-MSGT
            IF WS-RC-T = "00"
                MOVE WS-NEXT TO CC-STATUS
                MOVE "NO-AUTH" TO CC-MATCH-STATUS
            END-IF
        WHEN OTHER
            MOVE "Y" TO WS-REVIEW
            PERFORM OPEN-EXCEPTION
            MOVE "EXCEPTION" TO WS-EVT
        CALL "CCRCST" USING CC-STATUS WS-EVT WS-NEXT WS-RC-T WS-MSGT
            IF WS-RC-T = "00"
                MOVE WS-NEXT TO CC-STATUS
            END-IF
            MOVE WS-RESULT TO CC-MATCH-STATUS
            MOVE "MATCH NEEDS REVIEW" TO CP-MSG
    END-EVALUATE
    IF WS-RESULT = "MATCHED"
        PERFORM CONSUME-AUTH
    END-IF.

NEXT-ID.
    EVALUATE WS-PFX
        WHEN "I" MOVE "CARD-CMATCH" TO WS-SEQ-NAME
        WHEN OTHER MOVE "CARD-CEXEC" TO WS-SEQ-NAME
    END-EVALUATE
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO WS-IDX
    STRING WS-PFX DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO WS-IDX
    END-STRING.

CONSUME-AUTH.
    MOVE CC-AUTH-ID TO CA-ID
    MOVE "GET" TO SA-OP
    CALL "CCRCASTO" USING BK-CCRD-STO-AUTH BK-CCRD-AUTH
    IF SA-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CC-ID TO CA-CLEAR-ID
    ADD 1 TO CA-VERSION
    MOVE WS-BIZDATE TO CA-UPDATED
    MOVE "REWRITE" TO SA-OP
    CALL "CCRCASTO" USING BK-CCRD-STO-AUTH BK-CCRD-AUTH
    IF CA-AMOUNT - CA-CAPTURED <= 0
        EXIT PARAGRAPH
    END-IF
    MOVE CP-CLR-ID TO CK-CARD-ID
    MOVE CC-AUTH-ID TO CK-AUTH-ID
    MOVE CC-AMOUNT TO CK-AMOUNT
    IF CK-AMOUNT > CA-AMOUNT - CA-CAPTURED
        COMPUTE CK-AMOUNT = CA-AMOUNT - CA-CAPTURED
    END-IF
    MOVE "CAPTURE" TO CK-OP
    MOVE CP-OPERATOR TO CK-OPERATOR
    MOVE CP-CORR TO CK-CORR
    MOVE SPACES TO WS-REQ
    STRING "KMP-" DELIMITED SIZE CP-CLR-ID DELIMITED SIZE
        INTO WS-REQ
    END-STRING
    MOVE WS-REQ TO CK-REQUEST
    CALL "CCRCHOLD" USING BK-CCRD-PARMS
    COMPUTE WS-CAP = CC-AUTH-AMOUNT - CC-AMOUNT
    IF CP-RC = "00" AND WS-CAP > 0
        MOVE "RELEASE" TO CK-OP
        MOVE 0 TO CK-AMOUNT
        MOVE SPACES TO WS-REQ
        STRING "KMR-" DELIMITED SIZE CP-CLR-ID DELIMITED SIZE
            INTO WS-REQ
        END-STRING
        MOVE WS-REQ TO CK-REQUEST
        CALL "CCRCHOLD" USING BK-CCRD-PARMS
    END-IF
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG.

OPEN-EXCEPTION.
    IF WS-RESULT = "UNMATCHED"
        MOVE "UNMATCHED-AUTH" TO WS-EX-TYPE
    ELSE
        MOVE WS-RESULT TO WS-EX-TYPE
    END-IF
    MOVE SPACES TO BK-CCRD-EXC-REC
    MOVE CP-CLR-ID TO EX-CLR-ID
    MOVE WS-EX-TYPE TO EX-TYPE
    MOVE "FIND-OPEN" TO SX-OP
    CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    IF SX-RC NOT = "00"
        MOVE "O" TO WS-PFX
        MOVE "00" TO WS-SEQ-ST
        PERFORM NEXT-ID
        IF WS-SEQ-ST NOT = "00"
            EXIT PARAGRAPH
        END-IF
        MOVE SPACES TO BK-CCRD-EXC-REC
        MOVE WS-IDX TO EX-ID
        MOVE WS-EX-TYPE TO EX-TYPE
        MOVE CP-CLR-ID TO EX-CLR-ID
        MOVE CC-AUTH-ID TO EX-AUTH-ID
        MOVE CC-SOURCE TO EX-SOURCE
        MOVE "OPEN" TO EX-STATUS
        MOVE WS-REASON TO EX-REASON
        MOVE CP-OPERATOR TO EX-OPERATOR
        MOVE WS-BIZDATE TO EX-BIZDATE
        MOVE FUNCTION CURRENT-DATE TO WS-NOW
        MOVE WS-NOW(1:14) TO EX-CREATED
        MOVE "WRITE" TO SX-OP
        CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    ELSE
        MOVE EX-ID TO WS-IDX
    END-IF.

EXPOSE-CLR.
    MOVE CC-ID TO CP-CLR-ID
    MOVE CC-CARD-ID TO CP-CARD-ID
    MOVE CC-ACCOUNT TO CP-ACCOUNT
    MOVE CC-FACILITY TO CP-FACILITY
    MOVE CC-AUTH-ID TO CP-AUTH-ID
    MOVE CC-TXN-ID TO CP-TXN-ID
    MOVE CC-ORIG-CLR-ID TO CP-ORIG-CLR-ID
    MOVE CC-EXT-REF TO CP-EXT-REF
    MOVE CC-EXT-BATCH TO CP-EXT-BATCH
    MOVE CC-SOURCE TO CP-SOURCE
    MOVE CC-MERCHANT-ID TO CP-MERCHANT-ID
    MOVE CC-MCC TO CP-MCC
    MOVE CC-TXN-TYPE TO CP-TXN-TYPE
    MOVE CC-AMOUNT TO CP-AMOUNT
    MOVE CC-CURRENCY TO CP-CURRENCY
    MOVE CC-AUTH-AMOUNT TO CP-AUTH-AMOUNT
    MOVE CC-DIFF-AMOUNT TO CP-DIFF-AMOUNT
    MOVE CC-FEE-AMT TO CP-FEE-AMT
    MOVE CC-SETTLE-CURR TO CP-SETTLE-CURR
    MOVE CC-SETTLE-AMT TO CP-SETTLE-AMT
    MOVE CC-SETTLE-BATCH TO CP-SETTLE-BATCH
    MOVE CC-STATUS TO CP-STATUS
    MOVE CC-MATCH-STATUS TO CP-MATCH-STATUS
    MOVE CC-POST-STATUS TO CP-POST-STATUS
    MOVE CC-SETTLE-STATUS TO CP-SETTLE-STATUS
    MOVE CC-RECON-STATUS TO CP-RECON-STATUS.
