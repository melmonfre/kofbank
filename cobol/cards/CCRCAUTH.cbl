IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCAUTH.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "CCRASTO".
COPY "CCRHSTO".
COPY "CCRDSTO".
COPY "CCRDGP".
COPY "CCRDCLP".
COPY "BDATP".
COPY "BCREXP".
COPY "BLIMP".
COPY "BKEVTP".
01 BK-CCRD-AUTH.
   COPY "CCRA".
01 BK-CCRD-HOLD.
   COPY "CCRH".
01 BK-CCRD-CARD.
   COPY "CCRD".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).
01 WS-SEQ-NAME PIC X(20).
01 WS-MODE PIC X(08).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC 9(11).
01 WS-LOCKED PIC X(01).
01 WS-OPNAME PIC X(16).
01 WS-DECISION PIC X(12).
01 WS-HOLDS PIC S9(15)V99 COMP-3.
01 WS-AVAIL PIC S9(15)V99 COMP-3.
01 WS-THRESHOLD PIC S9(15)V99 COMP-3.
01 WS-LIMIT PIC S9(15)V99 COMP-3.
01 WS-RC-TMP PIC X(02).
01 WS-BAL-OUT.
   05 BO-LEDGER PIC S9(15)V99 COMP-3.
   05 BO-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BO-BLOCKED PIC S9(15)V99 COMP-3.
   05 BO-CURRENCY PIC X(03).
   05 BO-UPDATED PIC 9(08).
   05 BO-SEQ PIC 9(12).
   05 BO-RC PIC X(02).
01 WS-ACCT-ID PIC X(12).
01 WS-EVT-PAYLOAD PIC X(200).
01 WS-AUD-BEFORE PIC X(120).
01 WS-AUD-AFTER PIC X(120).
01 WS-A-ENT PIC X(12).
01 WS-A-ACT PIC X(12).
01 WS-EXPIRY PIC 9(08).

LINKAGE SECTION.
COPY "CCRDP".

PROCEDURE DIVISION USING BK-CCRD-PARMS.
    MOVE "00" TO CK-RC
    MOVE SPACES TO CK-MSG
    MOVE "N" TO CK-REPLAY
    MOVE "N" TO WS-LOCKED
    MOVE "APPROVED" TO WS-DECISION
    MOVE "APPROVED" TO CK-REASON
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CK-RC
        MOVE "CONFIG MISSING" TO CK-MSG
        GOBACK
    END-IF
    STRING "CARD." DELIMITED SIZE FUNCTION TRIM(CK-OP)
        DELIMITED SIZE INTO WS-OPNAME
    END-STRING
    EVALUATE CK-OP
        WHEN "AUTHORIZE" PERFORM DO-AUTHORIZE
        WHEN "GET-AUTH" PERFORM DO-GET-AUTH
        WHEN OTHER
            MOVE "99" TO CK-RC
            MOVE "UNKNOWN AUTH OP" TO CK-MSG
    END-EVALUATE
    GOBACK.

DO-AUTHORIZE.
    IF CK-AMOUNT <= 0
        MOVE "20" TO CK-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO CK-MSG
        GOBACK
    END-IF
    PERFORM GUARD-BEGIN
    IF CK-REPLAY = "Y"
        GOBACK
    END-IF
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM LOCK-CARD
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM LOAD-CARD
    IF CK-RC NOT = "00"
        PERFORM UNLOCK-CARD
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM RESOLVE-CFG
    PERFORM DECIDE
    IF WS-DECISION NOT = "DECLINED"
        PERFORM CHECK-FUNDS
    END-IF
    IF WS-DECISION NOT = "DECLINED"
        PERFORM CHECK-LIMITS
    END-IF
    PERFORM BUILD-AUTH-ID
    PERFORM WRITE-AUTH
    IF WS-DECISION NOT = "DECLINED"
        PERFORM WRITE-HOLD
    END-IF
    MOVE WS-DECISION TO CK-STATUS
    IF WS-DECISION = "DECLINED"
        MOVE "AUTHORIZATION DECLINED" TO CK-MSG
    ELSE
        MOVE "AUTHORIZATION DECIDED" TO CK-MSG
    END-IF
    PERFORM AUDIT-AUTH
    PERFORM EMIT-FRAUD-EVENT
    PERFORM UNLOCK-CARD
    MOVE CK-AUTH-ID TO GD-RESULT(1:12)
    MOVE WS-DECISION TO GD-RESULT(13:12)
    PERFORM GUARD-END
    GOBACK.

DO-GET-AUTH.
    MOVE SPACES TO BK-CCRD-AUTH
    MOVE CK-AUTH-ID TO CA-ID
    MOVE "GET" TO SA-OP
    CALL "CCRCASTO" USING BK-CCRD-STO-AUTH BK-CCRD-AUTH
    IF SA-RC NOT = "00"
        MOVE "23" TO CK-RC
        MOVE "AUTHORIZATION NOT FOUND" TO CK-MSG
        GOBACK
    END-IF
    PERFORM EXPOSE-AUTH
    GOBACK.

RESOLVE-CFG.
    MOVE SPACES TO BK-CCRD-CFG
    MOVE CN-PRODUCT TO CG-PRODUCT
    CALL "CCRDCFG" USING BK-CCRD-CFG.

DECIDE.
    IF CN-STATUS NOT = "ACTIVE"
        MOVE "DECLINED" TO WS-DECISION
        MOVE "CARD NOT ACTIVE" TO CK-REASON
        EXIT PARAGRAPH
    END-IF
    IF CN-EXP-DATE > 0 AND CN-EXP-DATE < WS-BIZDATE
        MOVE "DECLINED" TO WS-DECISION
        MOVE "CARD EXPIRED" TO CK-REASON
        EXIT PARAGRAPH
    END-IF
    IF CK-CURRENCY NOT = SPACES
        IF CK-CURRENCY NOT = CN-CURRENCY
            MOVE "DECLINED" TO WS-DECISION
            MOVE "CURRENCY NOT SUPPORTED" TO CK-REASON
            EXIT PARAGRAPH
        END-IF
    END-IF
    IF CK-TXN-KIND = "CASH"
        IF CG-CASH-ALLOW NOT = "Y"
            MOVE "DECLINED" TO WS-DECISION
            MOVE "CASH NOT ALLOWED" TO CK-REASON
        END-IF
    END-IF.

CHECK-FUNDS.
    MOVE 0 TO WS-HOLDS
    IF CN-KIND = "DEBIT"
        MOVE CN-ACCOUNT TO WS-ACCT-ID
        CALL "BGLBAL" USING WS-ACCT-ID WS-BAL-OUT
        IF BO-RC NOT = "00"
            MOVE "DECLINED" TO WS-DECISION
            MOVE "ACCOUNT BALANCE MISSING" TO CK-REASON
            EXIT PARAGRAPH
        END-IF
        MOVE "CARD" TO WS-MODE
        CALL "CCRCHSUM" USING WS-MODE CN-ID WS-HOLDS WS-RC-TMP
        COMPUTE WS-AVAIL = BO-AVAILABLE - WS-HOLDS
        IF WS-AVAIL < CK-AMOUNT
            MOVE "DECLINED" TO WS-DECISION
            MOVE "INSUFFICIENT FUNDS" TO CK-REASON
        END-IF
    ELSE
        MOVE SPACES TO BK-CR-EXP-PARMS
        MOVE "GET" TO CE-OP
        MOVE CN-FACILITY TO CE-FAC-ID
        CALL "BCRUPD" USING BK-CR-EXP-PARMS
        IF CE-RC NOT = "00"
            MOVE "DECLINED" TO WS-DECISION
            MOVE "FACILITY EXPOSURE MISSING" TO CK-REASON
            EXIT PARAGRAPH
        END-IF
        MOVE "FACILITY" TO WS-MODE
        CALL "CCRCHSUM" USING WS-MODE CN-FACILITY
            WS-HOLDS WS-RC-TMP
        COMPUTE WS-AVAIL = CE-CONTRACTED - CE-PRINCIPAL - WS-HOLDS
        IF WS-AVAIL < CK-AMOUNT
            MOVE "DECLINED" TO WS-DECISION
            MOVE "INSUFFICIENT CREDIT" TO CK-REASON
            EXIT PARAGRAPH
        END-IF
        IF CG-PENDING-BPS > 0
            COMPUTE WS-THRESHOLD =
                CE-CONTRACTED * CG-PENDING-BPS / 10000
            IF CK-AMOUNT > WS-THRESHOLD
                MOVE "PENDING" TO WS-DECISION
                MOVE "ABOVE PENDING THRESHOLD" TO CK-REASON
            END-IF
        END-IF
    END-IF.

CHECK-LIMITS.
    MOVE 0 TO WS-HOLDS
    MOVE "CARD" TO LIM-SCOPE
    MOVE CK-CARD-ID TO LIM-KEY
    MOVE "DAILY" TO LIM-PERIOD
    MOVE CK-AMOUNT TO LIM-AMOUNT
    MOVE CK-CURRENCY TO LIM-CURRENCY
    MOVE "CHECK" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ
    IF LIM-RC = "20"
        MOVE "DECLINED" TO WS-DECISION
        MOVE "DAILY LIMIT EXCEEDED" TO CK-REASON
        EXIT PARAGRAPH
    END-IF
    MOVE "MONTHLY" TO LIM-PERIOD
    CALL "BLIM" USING BK-LIM-REQ
    IF LIM-RC = "20"
        MOVE "DECLINED" TO WS-DECISION
        MOVE "MONTHLY LIMIT EXCEEDED" TO CK-REASON
    END-IF.

BUILD-AUTH-ID.
    MOVE "CARD-AUTH" TO WS-SEQ-NAME
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CK-RC
        MOVE "SEQUENCE ERROR" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CK-AUTH-ID
    STRING "Q" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CK-AUTH-ID
    END-STRING.

WRITE-AUTH.
    MOVE SPACES TO BK-CCRD-AUTH
    MOVE CK-AUTH-ID TO CA-ID
    MOVE CN-ID TO CA-CARD-ID
    MOVE CN-CUST-ID TO CA-CUST-ID
    IF CK-TXN-KIND = SPACES
        MOVE "PURCHASE" TO CA-KIND
    ELSE
        MOVE CK-TXN-KIND TO CA-KIND
    END-IF
    MOVE CK-AMOUNT TO CA-AMOUNT
    MOVE CN-CURRENCY TO CA-CURRENCY
    MOVE 0 TO CA-CAPTURED
    MOVE CK-MERCHANT TO CA-MERCHANT
    MOVE CK-MCC TO CA-MCC
    MOVE CK-CHANNEL TO CA-CHANNEL
    MOVE WS-DECISION TO CA-STATUS
    MOVE CK-REASON TO CA-REASON
    MOVE WS-BIZDATE TO CA-DATE
    MOVE 0 TO CA-EXPIRY
    IF WS-DECISION NOT = "DECLINED"
        IF CG-AUTH-DAYS > 0
            MOVE WS-BIZDATE TO DAT-DATE
            MOVE "ADD-DAYS" TO DAT-OP
            MOVE CG-AUTH-DAYS TO DAT-DAYS
            CALL "BDAT" USING BK-DAT-PARMS
            IF DAT-RC = "00"
                MOVE DAT-RESULT TO CA-EXPIRY
            END-IF
        END-IF
    END-IF
    MOVE CK-EXT-REF TO CA-EXT-REF
    MOVE CK-OPERATOR TO CA-OPERATOR
    MOVE CK-CORR TO CA-CORR
    MOVE WS-BIZDATE TO CA-CREATED
    MOVE WS-BIZDATE TO CA-UPDATED
    MOVE 1 TO CA-VERSION
    MOVE "WRITE" TO SA-OP
    CALL "CCRCASTO" USING BK-CCRD-STO-AUTH BK-CCRD-AUTH
    IF SA-RC NOT = "00"
        MOVE SA-RC TO CK-RC
        MOVE "AUTHORIZATION WRITE FAILED" TO CK-MSG
    END-IF.

WRITE-HOLD.
    MOVE SPACES TO BK-CCRD-HOLD
    MOVE CK-AUTH-ID TO CH-ID
    MOVE CK-AUTH-ID TO CH-AUTH-ID
    MOVE CN-ID TO CH-CARD-ID
    IF CK-TXN-KIND = SPACES
        MOVE "PURCHASE" TO CH-KIND
    ELSE
        MOVE CK-TXN-KIND TO CH-KIND
    END-IF
    MOVE CK-AMOUNT TO CH-AMOUNT
    MOVE 0 TO CH-CAPTURED
    MOVE CK-AMOUNT TO CH-REMAINING
    MOVE CN-CURRENCY TO CH-CURRENCY
    MOVE "ACTIVE" TO CH-STATUS
    MOVE CA-EXPIRY TO CH-EXPIRY
    MOVE WS-BIZDATE TO CH-CREATED
    MOVE WS-BIZDATE TO CH-UPDATED
    MOVE 1 TO CH-VERSION
    MOVE "WRITE" TO SH-OP
    CALL "CCRCHSTO" USING BK-CCRD-STO-HOLD BK-CCRD-HOLD
    IF SH-RC NOT = "00"
        MOVE SH-RC TO CK-RC
        MOVE "HOLD WRITE FAILED" TO CK-MSG
    END-IF.

EXPOSE-AUTH.
    MOVE CA-ID TO CK-AUTH-ID
    MOVE CA-CARD-ID TO CK-CARD-ID
    MOVE CA-KIND TO CK-TXN-KIND
    MOVE CA-STATUS TO CK-STATUS
    MOVE CA-AMOUNT TO CK-AMOUNT
    MOVE CA-CAPTURED TO CK-CAPTURED
    COMPUTE CK-REMAIN = CA-AMOUNT - CA-CAPTURED
    MOVE CA-CURRENCY TO CK-CURRENCY
    MOVE CA-MERCHANT TO CK-MERCHANT
    MOVE CA-REASON TO CK-REASON
    MOVE CA-DATE TO CK-DATE
    MOVE CA-EXPIRY TO CK-EXP-DATE
    MOVE CA-CLEAR-ID TO CK-CLEAR-ID
    MOVE CA-TXN-ID TO CK-TXN-ID.

AUDIT-AUTH.
    MOVE CK-AUTH-ID TO WS-A-ENT
    MOVE "AUTH" TO WS-A-ACT
    MOVE SPACES TO WS-AUD-BEFORE
    MOVE SPACES TO WS-AUD-AFTER
    MOVE WS-DECISION TO WS-AUD-AFTER
    CALL "CCRDA" USING BK-CCRD-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER.

EMIT-FRAUD-EVENT.
    MOVE SPACES TO BK-EVT-PARMS
    MOVE "CARD_AUTHORIZATION_EVENT" TO BK-EVT-TYPE
    MOVE CK-AUTH-ID TO BK-EVT-KEY
    STRING "card=" FUNCTION TRIM(CN-ID) DELIMITED SIZE
        " auth=" FUNCTION TRIM(CK-AUTH-ID) DELIMITED SIZE
        " decision=" FUNCTION TRIM(WS-DECISION) DELIMITED SIZE
        " amount=" FUNCTION TRIM(CK-CURRENCY) DELIMITED SIZE
        FUNCTION TRIM(CK-MERCHANT) DELIMITED SIZE
        INTO BK-EVT-PAYLOAD
    END-STRING
    CALL "BEVT" USING BK-EVT-PARMS.

GUARD-BEGIN.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "BEGIN" TO GD-OP
    MOVE CK-REQUEST TO GD-REQUEST
    MOVE WS-OPNAME TO GD-OPERATION
    MOVE CK-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CK-RC
        MOVE "REQUEST IN PROGRESS" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    IF GD-HIT = "Y"
        MOVE GD-RESULT(1:12) TO CK-AUTH-ID
        MOVE GD-RESULT(13:12) TO CK-STATUS
        MOVE "Y" TO CK-REPLAY
        MOVE "AUTHORIZATION REPLAY" TO CK-MSG
    END-IF.

GUARD-END.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "END" TO GD-OP
    MOVE CK-REQUEST TO GD-REQUEST
    MOVE WS-OPNAME TO GD-OPERATION
    MOVE CK-OPERATOR TO GD-OPERATOR
    MOVE CK-RC TO GD-RC
    IF CK-RC = "00"
        STRING CK-AUTH-ID DELIMITED SIZE CK-STATUS DELIMITED SIZE
            INTO GD-RESULT
        END-STRING
    ELSE
        MOVE CK-MSG TO GD-RESULT
    END-IF
    CALL "CCRDG" USING BK-CCRD-GUARD.

LOCK-CARD.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "LOCK" TO GD-OP
    MOVE CK-CARD-ID TO GD-LOCK-ID
    MOVE CK-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CK-RC
        MOVE "CARD BUSY" TO CK-MSG
    ELSE
        MOVE "Y" TO WS-LOCKED
    END-IF.

UNLOCK-CARD.
    IF WS-LOCKED = "Y"
        MOVE SPACES TO BK-CCRD-GUARD
        MOVE "UNLOCK" TO GD-OP
        MOVE CK-CARD-ID TO GD-LOCK-ID
        MOVE CK-OPERATOR TO GD-OPERATOR
        CALL "CCRDG" USING BK-CCRD-GUARD
    END-IF.

LOAD-CARD.
    MOVE SPACES TO BK-CCRD-CARD
    MOVE CK-CARD-ID TO CN-ID
    MOVE "GET" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE "20" TO CK-RC
        MOVE "CARD NOT FOUND" TO CK-MSG
    END-IF.
