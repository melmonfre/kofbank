IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CLR-FILE ASSIGN TO WS-CLR-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CC-ID OF CLR-REC
        FILE STATUS IS WS-CLR-ST.
    SELECT XREF-FILE ASSIGN TO WS-XREF-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS XR-KEY OF XREF-REC
        FILE STATUS IS WS-XREF-ST.

DATA DIVISION.
FILE SECTION.
FD CLR-FILE.
01 CLR-REC.
   COPY "CCRC".
FD XREF-FILE.
01 XREF-REC.
   05 XR-KEY.
      10 XR-SOURCE     PIC X(08).
      10 XR-SEP1       PIC X(01).
      10 XR-EXT-REF    PIC X(32).
      10 XR-SEP2       PIC X(01).
      10 XR-TXN-TYPE   PIC X(08).
   05 XR-CLR-ID        PIC X(12).

WORKING-STORAGE SECTION.
01 WS-CLR-PATH PIC X(200).
01 WS-XREF-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CLR-ST PIC X(02).
01 WS-XREF-ST PIC X(02).

LINKAGE SECTION.
COPY "CCRCSTO".
01 BK-CCRD-CLR.
   COPY "CCRC".

PROCEDURE DIVISION USING BK-CCRD-STO-CLR BK-CCRD-CLR.
    MOVE "00" TO SC-RC
    MOVE SPACES TO SC-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CLR-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdclr.idx"
        DELIMITED SIZE INTO WS-CLR-PATH
    MOVE SPACES TO WS-XREF-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdclrx.idx"
        DELIMITED SIZE INTO WS-XREF-PATH
    EVALUATE SC-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "WRITE-XREF" PERFORM DO-WRITE-XREF
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN "GET-BY-XREF" PERFORM DO-GET-XREF
        WHEN OTHER
            MOVE "99" TO SC-RC
            MOVE "UNKNOWN CLR STO OP" TO SC-MSG
    END-EVALUATE
    GOBACK.

DO-WRITE.
    PERFORM OPEN-FILES
    IF SC-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE BK-CCRD-CLR TO CLR-REC
    WRITE CLR-REC
        INVALID KEY
            MOVE "22" TO SC-RC
            MOVE "CLEARING ALREADY EXISTS" TO SC-MSG
    END-WRITE
    PERFORM CLOSE-FILES.

DO-WRITE-XREF.
    PERFORM OPEN-FILES
    IF SC-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-XREF-KEY
    WRITE XREF-REC
        INVALID KEY
            MOVE "22" TO SC-RC
            MOVE "CLEARING XREF EXISTS" TO SC-MSG
    END-WRITE
    PERFORM CLOSE-FILES.

DO-REWRITE.
    PERFORM OPEN-FILES
    IF SC-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CC-ID OF BK-CCRD-CLR TO CC-ID OF CLR-REC
    READ CLR-FILE
    IF WS-CLR-ST = "00"
        MOVE BK-CCRD-CLR TO CLR-REC
        REWRITE CLR-REC
        IF WS-CLR-ST NOT = "00"
            MOVE WS-CLR-ST TO SC-RC
            MOVE "CLEARING REWRITE FAILED" TO SC-MSG
        END-IF
    ELSE
        MOVE "23" TO SC-RC
        MOVE "CLEARING NOT FOUND" TO SC-MSG
    END-IF
    PERFORM CLOSE-FILES.

DO-GET.
    PERFORM OPEN-FILES
    IF SC-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CC-ID OF BK-CCRD-CLR TO CC-ID OF CLR-REC
    READ CLR-FILE
    IF WS-CLR-ST = "00"
        MOVE CLR-REC TO BK-CCRD-CLR
    ELSE
        MOVE "23" TO SC-RC
        MOVE "CLEARING NOT FOUND" TO SC-MSG
    END-IF
    PERFORM CLOSE-FILES.

DO-GET-XREF.
    PERFORM OPEN-FILES
    IF SC-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-XREF-KEY
    READ XREF-FILE
    IF WS-XREF-ST = "00"
        MOVE XR-CLR-ID OF XREF-REC TO CC-ID OF BK-CCRD-CLR
    END-IF
    IF WS-XREF-ST = "00"
        MOVE XR-CLR-ID OF XREF-REC TO CC-ID OF CLR-REC
        READ CLR-FILE
        IF WS-CLR-ST = "00"
            MOVE CLR-REC TO BK-CCRD-CLR
        ELSE
            MOVE "23" TO SC-RC
            MOVE "CLEARING DATA CORRUPT" TO SC-MSG
        END-IF
    ELSE
        MOVE "23" TO SC-RC
        MOVE "CLEARING XREF NOT FOUND" TO SC-MSG
    END-IF
    PERFORM CLOSE-FILES.

BUILD-XREF-KEY.
    MOVE CC-SOURCE OF BK-CCRD-CLR TO XR-SOURCE OF XREF-REC
    MOVE "|" TO XR-SEP1 OF XREF-REC
    MOVE CC-EXT-REF OF BK-CCRD-CLR TO XR-EXT-REF OF XREF-REC
    MOVE "|" TO XR-SEP2 OF XREF-REC
    MOVE CC-TXN-TYPE OF BK-CCRD-CLR TO XR-TXN-TYPE OF XREF-REC
    MOVE CC-ID OF BK-CCRD-CLR TO XR-CLR-ID OF XREF-REC.

OPEN-FILES.
    OPEN I-O CLR-FILE
    IF WS-CLR-ST = "35"
        OPEN OUTPUT CLR-FILE
        CLOSE CLR-FILE
        OPEN I-O CLR-FILE
    END-IF
    IF WS-CLR-ST NOT = "00"
        MOVE WS-CLR-ST TO SC-RC
        MOVE "OPEN CLR FILE FAILED" TO SC-MSG
        EXIT PARAGRAPH
    END-IF
    OPEN I-O XREF-FILE
    IF WS-XREF-ST = "35"
        OPEN OUTPUT XREF-FILE
        CLOSE XREF-FILE
        OPEN I-O XREF-FILE
    END-IF
    IF WS-XREF-ST NOT = "00"
        CLOSE CLR-FILE
        MOVE WS-XREF-ST TO SC-RC
        MOVE "OPEN XREF FILE FAILED" TO SC-MSG
    END-IF.

CLOSE-FILES.
    CLOSE CLR-FILE
    CLOSE XREF-FILE.
