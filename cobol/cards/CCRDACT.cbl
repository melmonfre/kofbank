IDENTIFICATION DIVISION.
PROGRAM-ID. CCRDACT.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "CCRDSTO".
COPY "CCRDGP".
COPY "BDATP".
01 BK-CCRD-CARD.
   COPY "CCRD".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).
01 WS-NEXT PIC X(12).
01 WS-ST-RC PIC X(02).
01 WS-ST-MSG PIC X(80).
01 WS-LOCKED PIC X(01).
01 WS-OPNAME PIC X(16).
01 WS-AUD-ACT PIC X(12).
01 WS-AUD-BEFORE PIC X(120).
01 WS-AUD-AFTER PIC X(120).
01 WS-HASH-BUF PIC X(64).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH-V PIC X(16).
01 WS-A-ENT PIC X(12).
01 WS-A-ACT PIC X(12).
01 WS-REPL-ID PIC X(12).
01 WS-SEQ-NAME PIC X(20).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC 9(11).
01 WS-REPL-EXP PIC 9(08).
01 WS-KEEP-CUST PIC X(12).
01 WS-KEEP-PRODUCT PIC X(04).
01 WS-KEEP-KIND PIC X(08).
01 WS-KEEP-ACCOUNT PIC X(12).
01 WS-KEEP-FACILITY PIC X(12).
01 WS-KEEP-CURRENCY PIC X(03).
01 WS-KEEP-NETREF PIC X(24).
01 WS-KEEP-PINSET PIC X(01).
01 WS-KEEP-DESC PIC X(40).
01 WS-KEEP-PREV PIC X(12).
COPY "CCRDCLP".
01 WS-SEQ-KEEP PIC X(02).

LINKAGE SECTION.
COPY "CCRDP".

PROCEDURE DIVISION USING BK-CCRD-PARMS.
    MOVE "00" TO CK-RC
    MOVE SPACES TO CK-MSG
    MOVE "N" TO CK-REPLAY
    MOVE "N" TO WS-LOCKED
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CK-RC
        MOVE "CONFIG MISSING" TO CK-MSG
        GOBACK
    END-IF
    STRING "CARD." DELIMITED SIZE FUNCTION TRIM(CK-OP)
        DELIMITED SIZE INTO WS-OPNAME
    END-STRING
    EVALUATE CK-OP
        WHEN "REPLACE" PERFORM DO-REPLACE
        WHEN OTHER PERFORM DO-TRANSITION
    END-EVALUATE
    GOBACK.

DO-TRANSITION.
    PERFORM GUARD-BEGIN
    IF CK-REPLAY = "Y"
        GOBACK
    END-IF
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM LOCK-CARD
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM LOAD-CARD
    IF CK-RC NOT = "00"
        PERFORM UNLOCK-CARD
        PERFORM GUARD-END
        GOBACK
    END-IF
    MOVE CK-OP TO WS-AUD-ACT
    PERFORM RUN-STATE-MACHINE
    IF CK-RC NOT = "00"
        PERFORM UNLOCK-CARD
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM APPLY-TO-CARD
    MOVE "REWRITE" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CK-RC
        MOVE "CARD UPDATE FAILED" TO CK-MSG
    END-IF
    PERFORM SYNC-PARAMS
    PERFORM AUDIT-CHANGE
    PERFORM UNLOCK-CARD
    PERFORM GUARD-END
    GOBACK.

RUN-STATE-MACHINE.
    CALL "CCRDST" USING CN-STATUS WS-AUD-ACT WS-NEXT WS-ST-RC
        WS-ST-MSG
    IF WS-ST-RC NOT = "00"
        MOVE "20" TO CK-RC
        MOVE WS-ST-MSG TO CK-MSG
    END-IF.

APPLY-TO-CARD.
    MOVE WS-NEXT TO CN-STATUS
    MOVE CK-REASON TO CN-REASON
    MOVE WS-BIZDATE TO CN-UPDATED
    ADD 1 TO CN-VERSION
    IF WS-AUD-ACT = "ACTIVATE"
        MOVE WS-BIZDATE TO CN-ACTIVE-DATE
    END-IF
    IF WS-AUD-ACT = "CANCEL"
        OR WS-AUD-ACT = "REJECT"
        OR WS-AUD-ACT = "CLOSE"
        MOVE WS-BIZDATE TO CN-CANCEL-DATE
    END-IF
    PERFORM COMPUTE-HASH.

EXPORT-CARD.
    MOVE CN-MASKED TO CK-MASKED
    MOVE CN-NETWORK TO CK-NETWORK
    MOVE CN-NET-REF TO CK-NET-REF
    MOVE CN-TOKEN TO CK-TOKEN
    MOVE CN-PIN-SET TO CK-PIN-SET
    MOVE CN-EXP-DATE TO CK-EXP-DATE.

SYNC-PARAMS.
    MOVE CN-STATUS TO CK-STATUS
    PERFORM EXPORT-CARD
    MOVE "CARD TRANSITION OK" TO CK-MSG.

DO-REPLACE.
    PERFORM GUARD-BEGIN
    IF CK-REPLAY = "Y"
        GOBACK
    END-IF
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM LOCK-CARD
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM LOAD-CARD
    IF CK-RC NOT = "00"
        PERFORM UNLOCK-CARD
        PERFORM GUARD-END
        GOBACK
    END-IF
    MOVE "REPLACE" TO WS-AUD-ACT
    PERFORM RUN-STATE-MACHINE
    IF CK-RC NOT = "00"
        PERFORM UNLOCK-CARD
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM BUILD-REPL-ID
    IF CK-RC NOT = "00"
        PERFORM UNLOCK-CARD
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM STORE-OLD-WITH-NEXT
    IF CK-RC NOT = "00"
        PERFORM UNLOCK-CARD
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM WRITE-NEW-CARD
    IF CK-RC NOT = "00"
        PERFORM UNLOCK-CARD
        PERFORM GUARD-END
        GOBACK
    END-IF
    MOVE "REPLACED" TO CK-STATUS
    MOVE WS-REPL-ID TO CK-NEXT-CARD
    MOVE CK-CARD-ID TO CK-PREV-CARD
    MOVE "CARD REPLACED" TO CK-MSG
    PERFORM AUDIT-CHANGE
    PERFORM AUDIT-NEW
    PERFORM UNLOCK-CARD
    PERFORM GUARD-END
    GOBACK.

BUILD-REPL-ID.
    MOVE "CARD" TO WS-SEQ-NAME
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CK-RC
        MOVE "SEQUENCE ERROR" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO WS-REPL-ID
    STRING "U" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO WS-REPL-ID
    END-STRING.

STORE-OLD-WITH-NEXT.
    MOVE WS-NEXT TO CN-STATUS
    MOVE WS-REPL-ID TO CN-NEXT-CARD
    MOVE CK-REASON TO CN-REASON
    MOVE WS-BIZDATE TO CN-UPDATED
    ADD 1 TO CN-VERSION
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CK-RC
        MOVE "OLD CARD UPDATE FAILED" TO CK-MSG
    END-IF.

WRITE-NEW-CARD.
    MOVE CN-EXP-DATE TO WS-REPL-EXP
    MOVE CN-CUST-ID TO WS-KEEP-CUST
    MOVE CN-PRODUCT TO WS-KEEP-PRODUCT
    MOVE CN-KIND TO WS-KEEP-KIND
    MOVE CN-ACCOUNT TO WS-KEEP-ACCOUNT
    MOVE CN-FACILITY TO WS-KEEP-FACILITY
    MOVE CN-CURRENCY TO WS-KEEP-CURRENCY
    MOVE CN-NET-REF TO WS-KEEP-NETREF
    MOVE CN-PIN-SET TO WS-KEEP-PINSET
    MOVE CN-DESCRIPTION TO WS-KEEP-DESC
    MOVE CK-CARD-ID TO WS-KEEP-PREV
    PERFORM RESOLVE-REPL-EXP
    MOVE SPACES TO BK-CCRD-CARD
    MOVE WS-REPL-ID TO CN-ID
    MOVE WS-KEEP-CUST TO CN-CUST-ID
    MOVE WS-KEEP-PRODUCT TO CN-PRODUCT
    MOVE WS-KEEP-KIND TO CN-KIND
    MOVE WS-KEEP-ACCOUNT TO CN-ACCOUNT
    MOVE WS-KEEP-FACILITY TO CN-FACILITY
    MOVE "ISSUED" TO CN-STATUS
    MOVE WS-KEEP-CURRENCY TO CN-CURRENCY
    PERFORM BUILD-REPL-MASKED
    MOVE WS-KEEP-NETREF TO CN-NET-REF
    MOVE WS-KEEP-PINSET TO CN-PIN-SET
    MOVE WS-BIZDATE TO CN-ISSUE-DATE
    MOVE 0 TO CN-ACTIVE-DATE
    MOVE WS-REPL-EXP TO CN-EXP-DATE
    MOVE 0 TO CN-CANCEL-DATE
    MOVE WS-KEEP-PREV TO CN-PREV-CARD
    MOVE SPACES TO CN-NEXT-CARD
    MOVE WS-KEEP-DESC TO CN-DESCRIPTION
    MOVE CK-REASON TO CN-REASON
    MOVE CK-OPERATOR TO CN-OPERATOR
    MOVE CK-CORR TO CN-CORR
    MOVE WS-BIZDATE TO CN-CREATED
    MOVE WS-BIZDATE TO CN-UPDATED
    MOVE 1 TO CN-VERSION
    PERFORM COMPUTE-HASH
    MOVE "WRITE" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CK-RC
        MOVE "NEW CARD WRITE FAILED" TO CK-MSG
    END-IF.

BUILD-REPL-MASKED.
    MOVE SPACES TO CN-MASKED
    STRING "MASK" DELIMITED SIZE WS-REPL-ID DELIMITED SIZE
        INTO CN-MASKED
    END-STRING
    MOVE SPACES TO CN-TOKEN
    STRING "TOK" DELIMITED SIZE WS-REPL-ID DELIMITED SIZE
        INTO CN-TOKEN
    END-STRING.

RESOLVE-REPL-EXP.
    MOVE SPACES TO BK-CCRD-CFG
    MOVE WS-KEEP-PRODUCT TO CG-PRODUCT
    CALL "CCRDCFG" USING BK-CCRD-CFG
    MOVE WS-BIZDATE TO DAT-DATE
    MOVE "ADD-MONTHS" TO DAT-OP
    IF CG-STATUS = "00"
        MOVE CG-VALID-MONTHS TO DAT-MONTHS
    ELSE
        MOVE 0 TO DAT-MONTHS
    END-IF
    CALL "BDAT" USING BK-DAT-PARMS
    IF DAT-RC = "00"
        MOVE DAT-RESULT TO WS-REPL-EXP
    ELSE
        MOVE CN-EXP-DATE TO WS-REPL-EXP
    END-IF.

LOCK-CARD.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "LOCK" TO GD-OP
    MOVE CK-CARD-ID TO GD-LOCK-ID
    MOVE CK-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CK-RC
        MOVE "CARD BUSY" TO CK-MSG
    ELSE
        MOVE "Y" TO WS-LOCKED
    END-IF.

UNLOCK-CARD.
    IF WS-LOCKED = "Y"
        MOVE SPACES TO BK-CCRD-GUARD
        MOVE "UNLOCK" TO GD-OP
        MOVE CK-CARD-ID TO GD-LOCK-ID
        MOVE CK-OPERATOR TO GD-OPERATOR
        CALL "CCRDG" USING BK-CCRD-GUARD
    END-IF.

GUARD-BEGIN.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "BEGIN" TO GD-OP
    MOVE CK-REQUEST TO GD-REQUEST
    MOVE WS-OPNAME TO GD-OPERATION
    MOVE CK-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CK-RC
        MOVE "REQUEST IN PROGRESS" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    IF GD-HIT = "Y"
        MOVE GD-RESULT(1:12) TO CK-CARD-ID
        MOVE GD-RESULT(13:12) TO CK-STATUS
        MOVE "Y" TO CK-REPLAY
        MOVE "CARD ACTION REPLAY" TO CK-MSG
    END-IF.

GUARD-END.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "END" TO GD-OP
    MOVE CK-REQUEST TO GD-REQUEST
    MOVE WS-OPNAME TO GD-OPERATION
    MOVE CK-OPERATOR TO GD-OPERATOR
    MOVE CK-RC TO GD-RC
    STRING CK-CARD-ID DELIMITED SIZE CK-STATUS DELIMITED SIZE
        INTO GD-RESULT
    END-STRING
    CALL "CCRDG" USING BK-CCRD-GUARD.

LOAD-CARD.
    MOVE SPACES TO BK-CCRD-CARD
    MOVE CK-CARD-ID TO CN-ID
    MOVE "GET" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE "23" TO CK-RC
        MOVE "CARD NOT FOUND" TO CK-MSG
    END-IF.

COMPUTE-HASH.
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(CN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CN-STATUS) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CN-MASKED) DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 64 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH-V
    MOVE WS-HASH-V TO CN-HASH.

AUDIT-CHANGE.
    MOVE SPACES TO WS-AUD-BEFORE
    MOVE CK-STATUS TO WS-AUD-BEFORE
    MOVE SPACES TO WS-AUD-AFTER
    MOVE CN-STATUS TO WS-AUD-AFTER
    MOVE CN-ID TO WS-A-ENT
    MOVE WS-AUD-ACT TO WS-A-ACT
    CALL "CCRDA" USING BK-CCRD-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER.

AUDIT-NEW.
    MOVE SPACES TO WS-AUD-BEFORE
    MOVE SPACES TO WS-AUD-AFTER
    MOVE WS-REPL-ID TO WS-A-ENT
    MOVE "REPLAC" TO WS-A-ACT
    CALL "CCRDA" USING BK-CCRD-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER.
