IDENTIFICATION DIVISION.
PROGRAM-ID. CCRDCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(24).
01 WS-P.
   05 WS-A PIC X(80).
   05 WS-B PIC X(80).
   05 WS-C PIC X(80).
   05 WS-D PIC X(80).
   05 WS-E PIC X(80).
   05 WS-F PIC X(80).
   05 WS-G PIC X(80).
   05 WS-H PIC X(80).
   05 WS-I2 PIC X(80).
   05 WS-J2 PIC X(80).
   05 WS-K2 PIC X(80).
   05 WS-L2 PIC X(80).
   05 WS-M2 PIC X(80).
   05 WS-N2 PIC X(80).
   05 WS-O2 PIC X(80).
COPY "CCRDP".

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "create" PERFORM DO-REGISTER
        WHEN "approve" PERFORM DO-ACTION
        WHEN "reject" PERFORM DO-ACTION
        WHEN "issue" PERFORM DO-ACTION
        WHEN "activate" PERFORM DO-ACTION
        WHEN "block" PERFORM DO-ACTION
        WHEN "unblock" PERFORM DO-ACTION
        WHEN "suspend" PERFORM DO-ACTION
        WHEN "resume" PERFORM DO-ACTION
        WHEN "expire" PERFORM DO-ACTION
        WHEN "cancel" PERFORM DO-ACTION
        WHEN "close" PERFORM DO-ACTION
        WHEN "replace" PERFORM DO-REPLACE
        WHEN "get" PERFORM DO-GET
        WHEN "list" PERFORM DO-LIST
        WHEN "auth" PERFORM DO-AUTH
        WHEN "auth-get" PERFORM DO-AUTH-GET
        WHEN "capture" PERFORM DO-CAPTURE
        WHEN "release" PERFORM DO-RELEASE
        WHEN "auth-reverse" PERFORM DO-REVERSE
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN CARD OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-P
    MOVE SPACES TO WS-OP
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H
            WS-I2 WS-J2 WS-K2 WS-L2 WS-M2 WS-N2 WS-O2
    END-UNSTRING.

DO-REGISTER.
    MOVE "REGISTER" TO CK-OP
    MOVE WS-A TO CK-PRODUCT
    MOVE WS-B TO CK-CUST-ID
    MOVE WS-C TO CK-ACCOUNT
    MOVE WS-D TO CK-FACILITY
    MOVE WS-E TO CK-CURRENCY
    MOVE WS-F TO CK-MASKED
    MOVE WS-G TO CK-NET-REF
    MOVE WS-H TO CK-TOKEN
    MOVE WS-I2 TO CK-PIN-SET
    MOVE WS-J2 TO CK-DESCRIPTION
    MOVE WS-K2 TO CK-REASON
    MOVE WS-L2 TO CK-OPERATOR
    MOVE WS-M2 TO CK-CORR
    MOVE WS-N2 TO CK-REQUEST
    CALL "CCRD" USING BK-CCRD-PARMS
    PERFORM SHOW-CARD.

DO-ACTION.
    EVALUATE WS-OP
        WHEN "approve" MOVE "APPROVE" TO CK-OP
        WHEN "reject" MOVE "REJECT" TO CK-OP
        WHEN "issue" MOVE "ISSUE" TO CK-OP
        WHEN "activate" MOVE "ACTIVATE" TO CK-OP
        WHEN "block" MOVE "BLOCK" TO CK-OP
        WHEN "unblock" MOVE "UNBLOCK" TO CK-OP
        WHEN "suspend" MOVE "SUSPEND" TO CK-OP
        WHEN "resume" MOVE "RESUME" TO CK-OP
        WHEN "expire" MOVE "EXPIRE" TO CK-OP
        WHEN "cancel" MOVE "CANCEL" TO CK-OP
        WHEN "close" MOVE "CLOSE" TO CK-OP
    END-EVALUATE
    MOVE WS-A TO CK-CARD-ID
    MOVE WS-B TO CK-REASON
    MOVE WS-C TO CK-OPERATOR
    MOVE WS-D TO CK-CORR
    MOVE WS-E TO CK-REQUEST
    CALL "CCRD" USING BK-CCRD-PARMS
    PERFORM SHOW-CARD.

DO-REPLACE.
    MOVE "REPLACE" TO CK-OP
    MOVE WS-A TO CK-CARD-ID
    MOVE WS-B TO CK-REASON
    MOVE WS-C TO CK-OPERATOR
    MOVE WS-D TO CK-CORR
    MOVE WS-E TO CK-REQUEST
    CALL "CCRD" USING BK-CCRD-PARMS
    PERFORM SHOW-CARD.

DO-GET.
    MOVE "GET" TO CK-OP
    MOVE WS-A TO CK-CARD-ID
    CALL "CCRD" USING BK-CCRD-PARMS
    PERFORM SHOW-CARD.

DO-LIST.
    MOVE "LIST" TO CK-OP
    MOVE WS-A TO CK-CUST-ID
    MOVE WS-B TO CK-STATUS
    CALL "CCRD" USING BK-CCRD-PARMS
    DISPLAY "rc=" CK-RC
    DISPLAY "count=" CK-COUNT.

SHOW-CARD.
    DISPLAY "rc=" CK-RC
    DISPLAY "card=" FUNCTION TRIM(CK-CARD-ID)
    DISPLAY "cust=" FUNCTION TRIM(CK-CUST-ID)
    DISPLAY "product=" FUNCTION TRIM(CK-PRODUCT)
    DISPLAY "kind=" FUNCTION TRIM(CK-KIND)
    DISPLAY "account=" FUNCTION TRIM(CK-ACCOUNT)
    DISPLAY "facility=" FUNCTION TRIM(CK-FACILITY)
    DISPLAY "status=" FUNCTION TRIM(CK-STATUS)
    DISPLAY "currency=" FUNCTION TRIM(CK-CURRENCY)
    DISPLAY "masked=" FUNCTION TRIM(CK-MASKED)
    DISPLAY "network=" FUNCTION TRIM(CK-NETWORK)
    DISPLAY "expiry=" CK-EXP-DATE
    DISPLAY "prev=" FUNCTION TRIM(CK-PREV-CARD)
    DISPLAY "next=" FUNCTION TRIM(CK-NEXT-CARD)
    DISPLAY "msg=" FUNCTION TRIM(CK-MSG).

DO-AUTH.
    MOVE "AUTHORIZE" TO CK-OP
    MOVE WS-A TO CK-CARD-ID
    MOVE WS-B TO CK-AMOUNT
    MOVE WS-C TO CK-CURRENCY
    MOVE WS-D TO CK-MERCHANT
    MOVE WS-E TO CK-MCC
    MOVE WS-F TO CK-CHANNEL
    MOVE WS-G TO CK-TXN-KIND
    MOVE WS-H TO CK-EXT-REF
    MOVE WS-I2 TO CK-OPERATOR
    MOVE WS-J2 TO CK-CORR
    MOVE WS-K2 TO CK-REQUEST
    CALL "CCRCAUTH" USING BK-CCRD-PARMS
    PERFORM SHOW-AUTH.

DO-AUTH-GET.
    MOVE "GET-AUTH" TO CK-OP
    MOVE WS-A TO CK-AUTH-ID
    CALL "CCRCAUTH" USING BK-CCRD-PARMS
    PERFORM SHOW-AUTH.

DO-CAPTURE.
    MOVE "CAPTURE" TO CK-OP
    PERFORM HOLD-PARSE
    CALL "CCRCHOLD" USING BK-CCRD-PARMS
    PERFORM SHOW-AUTH.

DO-RELEASE.
    MOVE "RELEASE" TO CK-OP
    PERFORM HOLD-PARSE
    CALL "CCRCHOLD" USING BK-CCRD-PARMS
    PERFORM SHOW-AUTH.

DO-REVERSE.
    MOVE "REVERSE-AUTH" TO CK-OP
    MOVE WS-A TO CK-AUTH-ID
    MOVE WS-B TO CK-OPERATOR
    MOVE WS-C TO CK-CORR
    MOVE WS-D TO CK-REQUEST
    CALL "CCRCHOLD" USING BK-CCRD-PARMS
    PERFORM SHOW-AUTH.

HOLD-PARSE.
    MOVE WS-A TO CK-AUTH-ID
    MOVE WS-B TO CK-AMOUNT
    MOVE WS-C TO CK-OPERATOR
    MOVE WS-D TO CK-CORR
    MOVE WS-E TO CK-REQUEST.

SHOW-AUTH.
    DISPLAY "rc=" CK-RC
    DISPLAY "auth=" FUNCTION TRIM(CK-AUTH-ID)
    DISPLAY "status=" FUNCTION TRIM(CK-STATUS)
    DISPLAY "amount=" CK-AMOUNT
    DISPLAY "captured=" CK-CAPTURED
    DISPLAY "remaining=" CK-REMAIN
    DISPLAY "reason=" FUNCTION TRIM(CK-REASON)
    DISPLAY "expiry=" CK-EXP-DATE
    DISPLAY "msg=" FUNCTION TRIM(CK-MSG).
