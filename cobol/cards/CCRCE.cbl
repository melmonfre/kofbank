IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCE.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT EXC-FILE ASSIGN TO WS-X-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS EX-ID OF EXC-REC
        FILE STATUS IS WS-X-ST.

DATA DIVISION.
FILE SECTION.
FD EXC-FILE.
01 EXC-REC.
   COPY "CCREXC".

WORKING-STORAGE SECTION.
COPY "CCREXCSTO".
COPY "CCRCSTO".
COPY "CCRDP".
01 BK-CCRD-EXC-REC.
   COPY "CCREXC".
01 BK-CCRD-CLR.
   COPY "CCRC".
01 WS-X-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-X-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-LOCKED PIC X(01).
01 WS-NOW PIC X(14).
01 WS-CLR-STATUS PIC X(12).
01 WS-REQ PIC X(24).
01 WS-NEXT PIC X(12).
01 WS-KEEPOPR PIC X(12).
01 WS-KEEPCORR PIC X(24).
01 WS-RC-T PIC X(02).
01 WS-EVT PIC X(16).
01 WS-MSGT PIC X(80).
01 WS-AUD-BEFORE PIC X(120).
01 WS-AUD-AFTER PIC X(120).
01 WS-A-ENT PIC X(12).
01 WS-A-ACT PIC X(12).

LINKAGE SECTION.
COPY "CCRCP".

PROCEDURE DIVISION USING BK-CCRD-CLR-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    MOVE "N" TO CP-REPLAY
    MOVE "N" TO WS-LOCKED
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-X-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdcexc.idx"
        DELIMITED SIZE INTO WS-X-PATH
    EVALUATE CP-OP
        WHEN "EXCEPTION-GET" PERFORM DO-GET
        WHEN "EXCEPTION-LIST" PERFORM DO-LIST
        WHEN "EXCEPTION-RESOLVE" PERFORM DO-RESOLVE
        WHEN "EXCEPTION-RETRY" PERFORM DO-RETRY
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN EXCEPTION OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

DO-GET.
    MOVE CP-EXC-ID TO EX-ID OF BK-CCRD-EXC-REC
    MOVE "GET" TO SX-OP
    CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    IF SX-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "EXCEPTION NOT FOUND" TO CP-MSG
        GOBACK
    END-IF
    PERFORM EXPOSE
    GOBACK.

DO-LIST.
    MOVE 0 TO CP-COUNT
    OPEN INPUT EXC-FILE
    IF WS-X-ST NOT = "00"
        MOVE "00" TO CP-RC
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ EXC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-X-ST = "00" AND
                   (CP-STATUS = SPACES OR
                    EX-STATUS OF EXC-REC = CP-STATUS)
                    ADD 1 TO CP-COUNT
                    MOVE EX-ID OF EXC-REC TO CP-EXC-ID
                END-IF
        END-READ
    END-PERFORM
    CLOSE EXC-FILE
    GOBACK.

EXPOSE.
    MOVE EX-ID OF BK-CCRD-EXC-REC TO CP-EXC-ID
    MOVE EX-CLR-ID OF BK-CCRD-EXC-REC TO CP-CLR-ID
    MOVE EX-TYPE OF BK-CCRD-EXC-REC TO CP-MATCH-STATUS.

DO-RESOLVE.
    MOVE CP-EXC-ID TO EX-ID OF BK-CCRD-EXC-REC
    MOVE "GET" TO SX-OP
    CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    IF SX-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "EXCEPTION NOT FOUND" TO CP-MSG
        GOBACK
    END-IF
    MOVE EX-STATUS OF BK-CCRD-EXC-REC TO WS-AUD-BEFORE
    IF EX-STATUS OF BK-CCRD-EXC-REC = "RESOLVED" OR EX-STATUS OF BK-CCRD-EXC-REC = "CANCELLED"
        MOVE "Y" TO CP-REPLAY
        MOVE "EXCEPTION REPLAY" TO CP-MSG
        GOBACK
    END-IF
    MOVE "RESOLVED" TO EX-STATUS OF BK-CCRD-EXC-REC
    MOVE CP-REASON TO EX-RESOLUTION OF BK-CCRD-EXC-REC
    MOVE CP-OPERATOR TO EX-OPERATOR OF BK-CCRD-EXC-REC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW(1:14)
    MOVE WS-NOW(1:14) TO EX-RESOLVED OF BK-CCRD-EXC-REC
    MOVE "REWRITE" TO SX-OP
    CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    IF SX-RC NOT = "00"
        MOVE SX-RC TO CP-RC
        MOVE "EXCEPTION UPDATE FAILED" TO CP-MSG
        GOBACK
    END-IF
    MOVE "RESOLVE" TO WS-A-ACT
    MOVE EX-ID OF BK-CCRD-EXC-REC TO WS-A-ENT
    MOVE "RESOLVED" TO WS-AUD-AFTER
    CALL "CCRCRA" USING BK-CCRD-CLR-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER
    MOVE "EXCEPTION RESOLVED" TO CP-MSG
    GOBACK.

DO-RETRY.
    MOVE CP-EXC-ID TO EX-ID OF BK-CCRD-EXC-REC
    MOVE "GET" TO SX-OP
    CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    IF SX-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "EXCEPTION NOT FOUND" TO CP-MSG
        GOBACK
    END-IF
    IF EX-STATUS OF BK-CCRD-EXC-REC NOT = "OPEN" AND EX-STATUS OF BK-CCRD-EXC-REC NOT = "RETRY-PEND"
        MOVE "Y" TO CP-REPLAY
        MOVE "20" TO CP-RC
        MOVE "EXCEPTION NOT RETRYABLE" TO CP-MSG
        GOBACK
    END-IF
    MOVE "RETRYING" TO EX-STATUS OF BK-CCRD-EXC-REC
    MOVE "REWRITE" TO SX-OP
    CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    EVALUATE EX-TYPE OF BK-CCRD-EXC-REC
        WHEN "UNMATCHED-AUTH" PERFORM RETRY-MATCH
        WHEN "MATCHED" PERFORM RETRY-MATCH
        WHEN "AMBIGUOUS" PERFORM RETRY-MATCH
        WHEN "DUPLICATE" PERFORM RETRY-MATCH
        WHEN "EXPIRED" PERFORM RETRY-MATCH
        WHEN "POST-FAILURE" PERFORM RETRY-POST
        WHEN "BATCH-MISMATCH"
            MOVE "20" TO CP-RC
            MOVE "MANUAL BATCH CORRECTION" TO CP-MSG
        WHEN OTHER
            MOVE "20" TO CP-RC
            MOVE "NON-RETRYABLE EXCEPTION" TO CP-MSG
    END-EVALUATE
    GOBACK.

RETRY-MATCH.
    MOVE SPACES TO BK-CCRD-CLR-PARMS
    MOVE "CLEARING-MATCH" TO CP-OP
    MOVE EX-CLR-ID OF BK-CCRD-EXC-REC TO CP-CLR-ID
    MOVE CP-OPERATOR TO CP-OPERATOR
    MOVE CP-CORR TO CP-CORR
    STRING "XMR-" DELIMITED SIZE EX-ID OF BK-CCRD-EXC-REC DELIMITED SIZE
        INTO CP-REQUEST
    END-STRING
    CALL "CCRCM" USING BK-CCRD-CLR-PARMS
    MOVE CP-RC TO WS-RC-T
    MOVE CP-MSG TO WS-MSGT
    PERFORM RETRY-CHECK.

RETRY-POST.
    MOVE SPACES TO BK-CCRD-CLR-PARMS
    MOVE "CLEARING-POST" TO CP-OP
    MOVE EX-CLR-ID OF BK-CCRD-EXC-REC TO CP-CLR-ID
    MOVE "Y" TO CP-FORCE
    MOVE CP-OPERATOR TO CP-OPERATOR
    MOVE CP-CORR TO CP-CORR
    STRING "XPR-" DELIMITED SIZE EX-ID OF BK-CCRD-EXC-REC DELIMITED SIZE
        INTO CP-REQUEST
    END-STRING
    CALL "CCRCP" USING BK-CCRD-CLR-PARMS
    MOVE CP-RC TO WS-RC-T
    MOVE CP-MSG TO WS-MSGT
    PERFORM RETRY-CHECK.

RETRY-CHECK.
    
    MOVE "GET" TO SX-OP
    CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    IF WS-RC-T = "00"
        PERFORM MARK-RESOLVED
    ELSE
        MOVE WS-RC-T TO CP-RC
        MOVE WS-MSGT TO CP-MSG
        MOVE "RETRY-PEND" TO EX-STATUS OF BK-CCRD-EXC-REC
        MOVE "REWRITE" TO SX-OP
        CALL "CCREXCSTO" USING BK-CCRD-STO-EXC
            BK-CCRD-EXC-REC
    END-IF.

MARK-RESOLVED.
    MOVE "RESOLVED" TO EX-STATUS OF BK-CCRD-EXC-REC
    MOVE "AUTO RETRY" TO EX-RESOLUTION OF BK-CCRD-EXC-REC
    MOVE FUNCTION CURRENT-DATE TO WS-NOW(1:14)
    MOVE WS-NOW(1:14) TO EX-RESOLVED OF BK-CCRD-EXC-REC
    MOVE "REWRITE" TO SX-OP
    CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    MOVE "00" TO CP-RC
    MOVE "EXCEPTION RETRY RESOLVED" TO CP-MSG.
