IDENTIFICATION DIVISION.
PROGRAM-ID. CCRSSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT STL-FILE ASSIGN TO WS-S-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CS-ID OF STL-REC
        FILE STATUS IS WS-S-ST.

DATA DIVISION.
FILE SECTION.
FD STL-FILE.
01 STL-REC.
   COPY "CCRS".

WORKING-STORAGE SECTION.
01 WS-S-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-S-ST PIC X(02).

LINKAGE SECTION.
COPY "CCRSSTO".
01 BK-CCRD-STL.
   COPY "CCRS".

PROCEDURE DIVISION USING BK-CCRD-STO-SETTLE BK-CCRD-STL.
    MOVE "00" TO SS-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-S-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdstl.idx"
        DELIMITED SIZE INTO WS-S-PATH
    OPEN I-O STL-FILE
    IF WS-S-ST = "35"
        OPEN OUTPUT STL-FILE
        CLOSE STL-FILE
        OPEN I-O STL-FILE
    END-IF
    IF WS-S-ST NOT = "00"
        MOVE WS-S-ST TO SS-RC
        GOBACK
    END-IF
    EVALUATE SS-OP
        WHEN "WRITE"
            MOVE BK-CCRD-STL TO STL-REC
            WRITE STL-REC
                INVALID KEY MOVE "22" TO SS-RC
            END-WRITE
        WHEN "REWRITE"
            MOVE CS-ID OF BK-CCRD-STL TO CS-ID OF STL-REC
            READ STL-FILE
            IF WS-S-ST = "00"
                MOVE BK-CCRD-STL TO STL-REC
                REWRITE STL-REC
            ELSE
                MOVE "23" TO SS-RC
            END-IF
        WHEN "GET"
            MOVE CS-ID OF BK-CCRD-STL TO CS-ID OF STL-REC
            READ STL-FILE
            IF WS-S-ST = "00"
                MOVE STL-REC TO BK-CCRD-STL
            ELSE
                MOVE "23" TO SS-RC
            END-IF
        WHEN OTHER
            MOVE "99" TO SS-RC
    END-EVALUATE
    CLOSE STL-FILE
    GOBACK.
