IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCHSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT HOLD-FILE ASSIGN TO WS-H-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CH-ID
        FILE STATUS IS WS-H-ST.

DATA DIVISION.
FILE SECTION.
FD HOLD-FILE.
01 HOLD-REC.
   COPY "CCRH".

WORKING-STORAGE SECTION.
01 WS-H-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-H-ST PIC X(02).

LINKAGE SECTION.
COPY "CCRHSTO".
01 BK-CCRD-HOLD.
   COPY "CCRH".

PROCEDURE DIVISION USING BK-CCRD-STO-HOLD BK-CCRD-HOLD.
    MOVE "00" TO SH-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-H-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdhold.idx"
        DELIMITED SIZE INTO WS-H-PATH
    OPEN I-O HOLD-FILE
    IF WS-H-ST = "35"
        OPEN OUTPUT HOLD-FILE
        CLOSE HOLD-FILE
        OPEN I-O HOLD-FILE
    END-IF
    IF WS-H-ST NOT = "00"
        MOVE WS-H-ST TO SH-RC
        GOBACK
    END-IF
    EVALUATE SH-OP
        WHEN "WRITE"
            MOVE BK-CCRD-HOLD TO HOLD-REC
            WRITE HOLD-REC
                INVALID KEY MOVE "22" TO SH-RC
            END-WRITE
        WHEN "REWRITE"
            MOVE CH-ID OF BK-CCRD-HOLD TO CH-ID OF HOLD-REC
            READ HOLD-FILE
            IF WS-H-ST = "00"
                MOVE BK-CCRD-HOLD TO HOLD-REC
                REWRITE HOLD-REC
            ELSE
                MOVE "23" TO SH-RC
            END-IF
        WHEN "GET"
            MOVE CH-ID OF BK-CCRD-HOLD TO CH-ID OF HOLD-REC
            READ HOLD-FILE
            IF WS-H-ST = "00"
                MOVE HOLD-REC TO BK-CCRD-HOLD
            ELSE
                MOVE "23" TO SH-RC
            END-IF
        WHEN OTHER
            MOVE "99" TO SH-RC
    END-EVALUATE
    CLOSE HOLD-FILE
    GOBACK.
