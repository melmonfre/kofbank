IDENTIFICATION DIVISION.
PROGRAM-ID. CCRDSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CARD-FILE ASSIGN TO WS-CARD-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CN-ID
        FILE STATUS IS WS-CARD-ST.

DATA DIVISION.
FILE SECTION.
FD CARD-FILE.
01 CARD-REC.
   COPY "CCRD".

WORKING-STORAGE SECTION.
01 WS-CARD-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CARD-ST PIC X(02).

LINKAGE SECTION.
COPY "CCRDSTO".
01 BK-CCRD-CARD.
   COPY "CCRD".

PROCEDURE DIVISION USING BK-CCRD-STO-REQ BK-CCRD-CARD.
    MOVE "00" TO ST-RC
    MOVE SPACES TO ST-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CARD-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdcard.idx"
        DELIMITED SIZE INTO WS-CARD-PATH
    PERFORM OPEN-STORE
    IF ST-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE ST-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO ST-RC
            MOVE "UNKNOWN CARD STORE OP" TO ST-MSG
    END-EVALUATE
    CLOSE CARD-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O CARD-FILE
    IF WS-CARD-ST = "35"
        OPEN OUTPUT CARD-FILE
        CLOSE CARD-FILE
        OPEN I-O CARD-FILE
    END-IF
    IF WS-CARD-ST NOT = "00"
        MOVE WS-CARD-ST TO ST-RC
        MOVE "CANNOT OPEN CARD INDEX" TO ST-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CCRD-CARD TO CARD-REC
    WRITE CARD-REC
        INVALID KEY
            MOVE "22" TO ST-RC
            MOVE "CARD ALREADY EXISTS" TO ST-MSG
    END-WRITE.

DO-REWRITE.
    MOVE CN-ID OF BK-CCRD-CARD TO CN-ID OF CARD-REC
    READ CARD-FILE
    IF WS-CARD-ST = "00"
        MOVE BK-CCRD-CARD TO CARD-REC
        REWRITE CARD-REC
    ELSE
        MOVE "23" TO ST-RC
        MOVE "CARD NOT FOUND" TO ST-MSG
    END-IF.

DO-GET.
    MOVE CN-ID OF BK-CCRD-CARD TO CN-ID OF CARD-REC
    READ CARD-FILE
    IF WS-CARD-ST = "00"
        MOVE CARD-REC TO BK-CCRD-CARD
    ELSE
        MOVE "23" TO ST-RC
        MOVE "CARD NOT FOUND" TO ST-MSG
    END-IF.
