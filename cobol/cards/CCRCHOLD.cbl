IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCHOLD.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "CCRASTO".
COPY "CCRHSTO".
COPY "CCRDSTO".
COPY "CCRDGP".
01 BK-CCRD-AUTH.
   COPY "CCRA".
01 BK-CCRD-HOLD.
   COPY "CCRH".
01 BK-CCRD-CARD.
   COPY "CCRD".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).
01 WS-LOCKED PIC X(01).
01 WS-OPNAME PIC X(16).
01 WS-REMAINING PIC S9(15)V99 COMP-3.
01 WS-AUD-BEFORE PIC X(120).
01 WS-AUD-AFTER PIC X(120).
01 WS-A-ENT PIC X(12).
01 WS-A-ACT PIC X(12).

LINKAGE SECTION.
COPY "CCRDP".

PROCEDURE DIVISION USING BK-CCRD-PARMS.
    MOVE "00" TO CK-RC
    MOVE SPACES TO CK-MSG
    MOVE "N" TO CK-REPLAY
    MOVE "N" TO WS-LOCKED
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CK-RC
        MOVE "CONFIG MISSING" TO CK-MSG
        GOBACK
    END-IF
    STRING "CARD." DELIMITED SIZE FUNCTION TRIM(CK-OP)
        DELIMITED SIZE INTO WS-OPNAME
    END-STRING
    EVALUATE CK-OP
        WHEN "CAPTURE" PERFORM DO-CAPTURE
        WHEN "RELEASE" PERFORM CALL-HLR
        WHEN "REVERSE-AUTH" PERFORM CALL-HLR
        WHEN OTHER
            MOVE "99" TO CK-RC
            MOVE "UNKNOWN HOLD OP" TO CK-MSG
    END-EVALUATE
    GOBACK.

CALL-HLR.
    CALL "CCRCHLR" USING BK-CCRD-PARMS
    GOBACK.

DO-CAPTURE.
    IF CK-AMOUNT <= 0
        MOVE "20" TO CK-RC
        MOVE "CAPTURE AMOUNT MUST BE POSITIVE" TO CK-MSG
        GOBACK
    END-IF
    PERFORM GUARD-BEGIN
    IF CK-REPLAY = "Y"
        PERFORM REPLAY-VIEW
        GOBACK
    END-IF
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM LOAD-AUTH
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM LOCK-CARD
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM RELOAD-AUTH
    IF CK-RC NOT = "00"
        PERFORM UNLOCK-CARD
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM CHECK-CAPTURE
    IF CK-RC NOT = "00"
        PERFORM UNLOCK-CARD
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM APPLY-CAPTURE
    PERFORM UNLOCK-CARD
    MOVE CA-ID TO GD-RESULT(1:12)
    MOVE CA-STATUS TO GD-RESULT(13:12)
    PERFORM GUARD-END
    GOBACK.

CHECK-CAPTURE.
    IF CA-STATUS NOT = "APPROVED" AND
       CA-STATUS NOT = "PARTCAP"
        MOVE "20" TO CK-RC
        MOVE "AUTHORIZATION NOT CAPTURABLE" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    IF CA-EXPIRY > 0 AND CA-EXPIRY < WS-BIZDATE
        MOVE "20" TO CK-RC
        MOVE "AUTHORIZATION EXPIRED" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-REMAINING = CA-AMOUNT - CA-CAPTURED
    IF CK-AMOUNT > WS-REMAINING
        MOVE "20" TO CK-RC
        MOVE "CAPTURE EXCEEDS AUTHORIZATION" TO CK-MSG
    END-IF.

APPLY-CAPTURE.
    ADD CK-AMOUNT TO CA-CAPTURED
    MOVE WS-BIZDATE TO CA-UPDATED
    ADD 1 TO CA-VERSION
    IF CA-CAPTURED >= CA-AMOUNT
        MOVE "CAPTURED" TO CA-STATUS
    ELSE
        MOVE "PARTCAP" TO CA-STATUS
    END-IF
    MOVE "REWRITE" TO SA-OP
    CALL "CCRCASTO" USING BK-CCRD-STO-AUTH BK-CCRD-AUTH
    IF SA-RC NOT = "00"
        MOVE SA-RC TO CK-RC
        MOVE "AUTHORIZATION UPDATE FAILED" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM ADJUST-HOLD-INTERNAL
    IF CK-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE CA-STATUS TO CK-STATUS
    MOVE CK-AMOUNT TO CK-CAPTURED
    COMPUTE CK-REMAIN = CA-AMOUNT - CA-CAPTURED
    MOVE "CAPTURE APPLIED" TO CK-MSG
    MOVE CA-ID TO WS-A-ENT
    MOVE "CAPT" TO WS-A-ACT
    MOVE "APPROVED" TO WS-AUD-BEFORE
    MOVE CA-STATUS TO WS-AUD-AFTER
    CALL "CCRDA" USING BK-CCRD-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER.

ADJUST-HOLD-INTERNAL.
    MOVE CA-ID TO CH-ID
    MOVE "GET" TO SH-OP
    CALL "CCRCHSTO" USING BK-CCRD-STO-HOLD BK-CCRD-HOLD
    IF SH-RC NOT = "00"
        MOVE "23" TO CK-RC
        MOVE "HOLD NOT FOUND" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    ADD CK-AMOUNT TO CH-CAPTURED
    SUBTRACT CK-AMOUNT FROM CH-REMAINING
    IF CH-REMAINING < 0
        MOVE 0 TO CH-REMAINING
    END-IF
    MOVE WS-BIZDATE TO CH-UPDATED
    ADD 1 TO CH-VERSION
    IF CH-REMAINING <= 0
        MOVE "USED" TO CH-STATUS
    ELSE
        MOVE "PART" TO CH-STATUS
    END-IF
    MOVE "REWRITE" TO SH-OP
    CALL "CCRCHSTO" USING BK-CCRD-STO-HOLD BK-CCRD-HOLD
    IF SH-RC NOT = "00"
        MOVE SH-RC TO CK-RC
        MOVE "HOLD UPDATE FAILED" TO CK-MSG
    END-IF.

REPLAY-VIEW.
    MOVE GD-RESULT(1:12) TO CK-AUTH-ID
    PERFORM LOAD-AUTH
    IF CK-RC = "00"
        MOVE CA-CAPTURED TO CK-CAPTURED
        COMPUTE CK-REMAIN = CA-AMOUNT - CA-CAPTURED
    END-IF.

LOAD-AUTH.
    MOVE SPACES TO BK-CCRD-AUTH
    MOVE CK-AUTH-ID TO CA-ID
    MOVE "GET" TO SA-OP
    CALL "CCRCASTO" USING BK-CCRD-STO-AUTH BK-CCRD-AUTH
    IF SA-RC NOT = "00"
        MOVE "23" TO CK-RC
        MOVE "AUTHORIZATION NOT FOUND" TO CK-MSG
    ELSE
        MOVE CA-CARD-ID TO CK-CARD-ID
    END-IF.

RELOAD-AUTH.
    PERFORM LOAD-AUTH
    IF CK-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-CCRD-CARD
    MOVE CK-CARD-ID TO CN-ID
    MOVE "GET" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE "23" TO CK-RC
        MOVE "CARD NOT FOUND" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    IF CN-STATUS NOT = "ACTIVE"
        MOVE "20" TO CK-RC
        MOVE "CARD NOT ACTIVE" TO CK-MSG
    END-IF.

LOCK-CARD.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "LOCK" TO GD-OP
    MOVE CK-CARD-ID TO GD-LOCK-ID
    MOVE CK-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CK-RC
        MOVE "CARD BUSY" TO CK-MSG
    ELSE
        MOVE "Y" TO WS-LOCKED
    END-IF.

UNLOCK-CARD.
    IF WS-LOCKED = "Y"
        MOVE SPACES TO BK-CCRD-GUARD
        MOVE "UNLOCK" TO GD-OP
        MOVE CK-CARD-ID TO GD-LOCK-ID
        MOVE CK-OPERATOR TO GD-OPERATOR
        CALL "CCRDG" USING BK-CCRD-GUARD
    END-IF.

GUARD-BEGIN.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "BEGIN" TO GD-OP
    MOVE CK-REQUEST TO GD-REQUEST
    MOVE WS-OPNAME TO GD-OPERATION
    MOVE CK-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CK-RC
        MOVE "REQUEST IN PROGRESS" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    IF GD-HIT = "Y"
        MOVE GD-RESULT(1:12) TO CK-AUTH-ID
        MOVE GD-RESULT(13:12) TO CK-STATUS
        MOVE "Y" TO CK-REPLAY
        MOVE "HOLD ACTION REPLAY" TO CK-MSG
    END-IF.

GUARD-END.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "END" TO GD-OP
    MOVE CK-REQUEST TO GD-REQUEST
    MOVE WS-OPNAME TO GD-OPERATION
    MOVE CK-OPERATOR TO GD-OPERATOR
    MOVE CK-RC TO GD-RC
    IF CK-RC = "00"
        STRING CA-ID DELIMITED SIZE CA-STATUS DELIMITED SIZE
            INTO GD-RESULT
        END-STRING
    ELSE
        MOVE CK-MSG TO GD-RESULT
    END-IF
    CALL "CCRDG" USING BK-CCRD-GUARD.
