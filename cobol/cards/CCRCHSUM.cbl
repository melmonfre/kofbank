IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCHSUM.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT HOLD-FILE ASSIGN TO WS-H-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS SEQUENTIAL
        RECORD KEY IS CH-ID
        FILE STATUS IS WS-H-ST.
    SELECT CARD-FILE ASSIGN TO WS-C-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CN-ID
        FILE STATUS IS WS-C-ST.

DATA DIVISION.
FILE SECTION.
FD HOLD-FILE.
01 HOLD-REC.
   COPY "CCRH".
FD CARD-FILE.
01 CARD-REC.
   COPY "CCRD".

WORKING-STORAGE SECTION.
01 WS-H-PATH PIC X(200).
01 WS-C-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-H-ST PIC X(02).
01 WS-C-ST PIC X(02).
01 WS-EOF PIC X(01).

LINKAGE SECTION.
01 LS-MODE PIC X(08).
01 LS-REF PIC X(12).
01 LS-TOTAL PIC S9(15)V99 COMP-3.
01 LS-RC PIC X(02).

PROCEDURE DIVISION USING LS-MODE LS-REF LS-TOTAL LS-RC.
    MOVE 0 TO LS-TOTAL
    MOVE "00" TO LS-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-H-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdhold.idx"
        DELIMITED SIZE INTO WS-H-PATH
    MOVE SPACES TO WS-C-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdcard.idx"
        DELIMITED SIZE INTO WS-C-PATH
    OPEN INPUT HOLD-FILE
    IF WS-H-ST NOT = "00"
        CLOSE HOLD-FILE
        GOBACK
    END-IF
    OPEN INPUT CARD-FILE
    IF WS-C-ST NOT = "00"
        CLOSE HOLD-FILE
        CLOSE CARD-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ HOLD-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM CONSIDER-HOLD
        END-READ
    END-PERFORM
    CLOSE HOLD-FILE
    CLOSE CARD-FILE
    GOBACK.

CONSIDER-HOLD.
    IF CH-STATUS OF HOLD-REC NOT = "ACTIVE"
        AND CH-STATUS OF HOLD-REC NOT = "PART"
        EXIT PARAGRAPH
    END-IF
    MOVE CH-CARD-ID OF HOLD-REC TO CN-ID OF CARD-REC
    READ CARD-FILE
    IF WS-C-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    EVALUATE FUNCTION TRIM(LS-MODE)
        WHEN "CARD"
            IF CN-ID OF CARD-REC NOT = LS-REF
                EXIT PARAGRAPH
            END-IF
        WHEN OTHER
            IF CN-FACILITY OF CARD-REC NOT = LS-REF
                EXIT PARAGRAPH
            END-IF
    END-EVALUATE
    ADD CH-REMAINING OF HOLD-REC TO LS-TOTAL.
