IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCEOD.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT AUTH-FILE ASSIGN TO WS-A-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CA-ID
        FILE STATUS IS WS-A-ST.

DATA DIVISION.
FILE SECTION.
FD AUTH-FILE.
01 AUTH-REC.
   COPY "CCRA".

WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CFG-SEQ PIC X(08).
   05 WS-CFG-ST PIC X(02).
COPY "CCRASTO".
01 WS-A-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-A-ST PIC X(02).
01 WS-HAS-A PIC X(01).
01 WS-EOF PIC X(01).
01 WS-N-EXP PIC 9(05) VALUE 0.
01 WS-EXP-MAX PIC 9(05) VALUE 500.
01 WS-ET.
   05 WS-E-ID OCCURS 500 TIMES PIC X(12).
01 WS-I PIC 9(05).
01 WS-RC-L PIC X(02).
01 WS-MSG-L PIC X(80).
COPY "CCRDP".
01 WS-BIZ PIC 9(08).

LINKAGE SECTION.
01 LS-RC PIC X(02).
01 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-RC LS-MSG.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    MOVE 0 TO WS-N-EXP
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO LS-RC
        MOVE "CONFIG READ FAILED" TO LS-MSG
        GOBACK
    END-IF
    MOVE WS-BIZDATE TO WS-BIZ
    MOVE SPACES TO WS-A-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdauth.idx"
        DELIMITED SIZE INTO WS-A-PATH
    MOVE "N" TO WS-HAS-A
    OPEN INPUT AUTH-FILE
    IF WS-A-ST = "00"
        MOVE "Y" TO WS-HAS-A
    END-IF
    IF WS-HAS-A = "Y"
        PERFORM COLLECT-EXPIRED
        CLOSE AUTH-FILE
        PERFORM RELEASE-EXPIRED
    END-IF
    MOVE SPACES TO LS-MSG
    STRING "CARD EOD: EXPIRED=" DELIMITED SIZE WS-N-EXP
        DELIMITED SIZE INTO LS-MSG
    END-STRING
    GOBACK.

COLLECT-EXPIRED.
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ AUTH-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-A-ST NOT = "00"
                    MOVE "Y" TO WS-EOF
                ELSE IF CA-STATUS OF AUTH-REC = "APPROVED" OR
                    CA-STATUS OF AUTH-REC = "PENDING" OR
                    CA-STATUS OF AUTH-REC = "PARTCAP"
                    AND CA-EXPIRY OF AUTH-REC > 0 AND
                    CA-EXPIRY OF AUTH-REC < WS-BIZ
                        IF WS-N-EXP < WS-EXP-MAX
                            ADD 1 TO WS-N-EXP
                            MOVE CA-ID OF AUTH-REC
                                TO WS-E-ID(WS-N-EXP)
                        END-IF
                    END-IF
                END-IF
        END-READ
    END-PERFORM.

RELEASE-EXPIRED.
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-N-EXP
        MOVE SPACES TO BK-CCRD-PARMS
        MOVE "RELEASE" TO CK-OP
        MOVE WS-E-ID(WS-I) TO CK-AUTH-ID
        MOVE 0 TO CK-AMOUNT
        MOVE "EOD" TO CK-OPERATOR
        MOVE "BATCH" TO CK-CORR
        MOVE SPACES TO CK-REQUEST
        STRING "EOD-" DELIMITED SIZE WS-E-ID(WS-I)
            DELIMITED SIZE INTO CK-REQUEST
        END-STRING
        CALL "CCRCHLR" USING BK-CCRD-PARMS
        IF CK-RC NOT = "00" AND CK-RC NOT = "20"
            MOVE CK-RC TO LS-RC
        END-IF
    END-PERFORM.
