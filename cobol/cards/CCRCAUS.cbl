IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCAUS.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT AUTH-FILE ASSIGN TO WS-A-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CA-ID
        FILE STATUS IS WS-A-ST.

DATA DIVISION.
FILE SECTION.
FD AUTH-FILE.
01 AUTH-REC.
   COPY "CCRA".

WORKING-STORAGE SECTION.
01 WS-A-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-A-ST PIC X(02).
01 WS-EOF PIC X(01).

LINKAGE SECTION.
01 LS-MODE PIC X(08).
01 LS-VAL PIC X(32).
01 LS-N PIC 9(03).
01 LS-LIST.
   05 LS-ID-ROW OCCURS 25 TIMES PIC X(12).
01 LS-RC PIC X(02).

PROCEDURE DIVISION USING LS-MODE LS-VAL LS-N LS-LIST LS-RC.
    MOVE "00" TO LS-RC
    MOVE 0 TO LS-N
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-A-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdauth.idx"
        DELIMITED SIZE INTO WS-A-PATH
    OPEN INPUT AUTH-FILE
    IF WS-A-ST NOT = "00"
        MOVE "00" TO LS-RC
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ AUTH-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM CONSIDER
        END-READ
    END-PERFORM
    CLOSE AUTH-FILE
    GOBACK.

CONSIDER.
    IF LS-N >= 25
        EXIT PARAGRAPH
    END-IF
    EVALUATE FUNCTION TRIM(LS-MODE)
        WHEN "CARD"
            IF CA-CARD-ID OF AUTH-REC = LS-VAL
                ADD 1 TO LS-N
                MOVE CA-ID OF AUTH-REC TO LS-ID-ROW(LS-N)
            END-IF
        WHEN "EXTREF"
            IF CA-EXT-REF OF AUTH-REC = LS-VAL(1:24)
                ADD 1 TO LS-N
                MOVE CA-ID OF AUTH-REC TO LS-ID-ROW(LS-N)
            END-IF
        WHEN OTHER
            CONTINUE
    END-EVALUATE.
