IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCST.

DATA DIVISION.
WORKING-STORAGE SECTION.

LINKAGE SECTION.
01 LS-CUR PIC X(12).
01 LS-EVT PIC X(16).
01 LS-NXT PIC X(12).
01 LS-RC PIC X(02).
01 LS-MSG PIC X(80).

PROCEDURE DIVISION USING LS-CUR LS-EVT LS-NXT LS-RC LS-MSG.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    MOVE SPACES TO LS-NXT
    EVALUATE TRUE
        WHEN LS-EVT = "ACCEPT"
            IF LS-CUR = "RECEIVED" MOVE "VALIDATED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "REJECT"
            IF LS-CUR = "RECEIVED" MOVE "REJECTED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "MATCH"
            IF LS-CUR = "VALIDATED" OR LS-CUR = "UNMATCHED"
                MOVE "MATCHED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "UNMATCH"
            IF LS-CUR = "VALIDATED" OR LS-CUR = "MATCHED"
                MOVE "UNMATCHED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "POST-PENDING"
            IF LS-CUR = "MATCHED" OR LS-CUR = "UNMATCHED"
                MOVE "POSTING-PEND" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "POST"
            IF LS-CUR = "POSTING-PEND" MOVE "POSTED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "POST-FAIL"
            IF LS-CUR = "POSTING-PEND" MOVE "POST-FAILED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "RETRY"
            IF LS-CUR = "POST-FAILED"
                MOVE "POSTING-PEND" TO LS-NXT
            ELSE IF LS-CUR = "EXCEPTION"
                MOVE "VALIDATED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "BATCH"
            IF LS-CUR = "POSTED" MOVE "SETTLE-PEND" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "SETTLE"
            IF LS-CUR = "SETTLE-PEND" MOVE "SETTLED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "RECON"
            IF LS-CUR = "SETTLED" MOVE "RECONCILED" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "EXCEPTION"
            IF LS-CUR = "RECEIVED" OR LS-CUR = "VALIDATED" OR
               LS-CUR = "MATCHED" OR LS-CUR = "UNMATCHED"
                MOVE "EXCEPTION" TO LS-NXT
            ELSE PERFORM SET-INVALID
        WHEN LS-EVT = "CANCEL"
            IF LS-CUR = "POSTED" OR LS-CUR = "SETTLED" OR
               LS-CUR = "RECONCILED"
                MOVE "20" TO LS-RC
                MOVE "USE FINANCIAL REVERSAL" TO LS-MSG
            ELSE IF LS-CUR = "REJECTED"
                PERFORM SET-INVALID
            ELSE
                MOVE "CANCELLED" TO LS-NXT
            END-IF
        WHEN OTHER
            MOVE "20" TO LS-RC
            MOVE "UNKNOWN CLEARING EVENT" TO LS-MSG
    END-EVALUATE
    IF LS-RC = "00" AND LS-NXT = SPACES
        PERFORM SET-INVALID
    END-IF
    GOBACK.

SET-INVALID.
    MOVE "20" TO LS-RC
    MOVE SPACES TO LS-NXT
    MOVE "INVALID CLEARING TRANSITION" TO LS-MSG.
