IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCI.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "CCRCSTO".
COPY "CCRDSTO".
COPY "CCRASTO".
COPY "CCRDGP".
01 BK-CCRD-CLR.
   COPY "CCRC".
01 BK-CCRD-CARD.
   COPY "CCRD".
01 BK-CCRD-AUTH.
   COPY "CCRA".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20).
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-NOW PIC X(14).
01 WS-AUD-BEFORE PIC X(120).
01 WS-AUD-AFTER PIC X(120).
01 WS-A-ENT PIC X(12).
01 WS-A-ACT PIC X(12).
01 WS-DUP-ID PIC X(12).
01 WS-LOADED PIC X(01).
01 WS-EVT PIC X(16).
01 WS-RC-T PIC X(02).

LINKAGE SECTION.
COPY "CCRCP".

PROCEDURE DIVISION USING BK-CCRD-CLR-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    MOVE "N" TO CP-REPLAY
    MOVE "N" TO WS-LOADED
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    EVALUATE CP-OP
        WHEN "CLEARING-INGEST" PERFORM DO-INGEST
        WHEN "CLEARING-GET" PERFORM DO-GET
        WHEN "CLEARING-STATUS" PERFORM DO-STATUS
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN CLEARING OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

DO-INGEST.
    PERFORM CHECK-REQUIRED
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-AUTH-REF
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE CP-SOURCE TO CC-SOURCE OF BK-CCRD-CLR
    MOVE CP-EXT-REF TO CC-EXT-REF OF BK-CCRD-CLR
    MOVE CP-TXN-TYPE TO CC-TXN-TYPE OF BK-CCRD-CLR
    MOVE "GET-BY-XREF" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC = "00"
        PERFORM XREF-HIT
        IF CP-RC = "00"
            MOVE "Y" TO CP-REPLAY
            PERFORM EXPOSE-CLR
            MOVE "CLEARING REPLAY" TO CP-MSG
        END-IF
        GOBACK
    END-IF
    IF SC-RC = "23" AND CC-ID OF BK-CCRD-CLR NOT = SPACES
        MOVE CC-ID OF BK-CCRD-CLR TO WS-DUP-ID
        PERFORM RECOVER-RECORD
        IF CP-RC = "00"
            MOVE "Y" TO CP-REPLAY
            PERFORM EXPOSE-CLR
            MOVE "CLEARING REPLAY" TO CP-MSG
        END-IF
        GOBACK
    END-IF
    IF SC-RC NOT = "23"
        MOVE SC-RC TO CP-RC
        MOVE "CLEARING STORE ERROR" TO CP-MSG
        GOBACK
    END-IF
    PERFORM FRESH-INGEST
    GOBACK.

XREF-HIT.
    MOVE CC-ID OF BK-CCRD-CLR TO WS-DUP-ID
    MOVE WS-DUP-ID TO CC-ID
    MOVE "GET" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC = "00"
        MOVE SPACES TO SC-MSG
        EXIT PARAGRAPH
    END-IF
    IF SC-RC NOT = "23"
        MOVE SC-RC TO CP-RC
        MOVE "CLEARING STORE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-DUP-ID TO CP-CLR-ID
    PERFORM RECOVER-RECORD.

FRESH-INGEST.
    PERFORM VALIDATE-CLR
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM BUILD-ID
    IF CP-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM INIT-CLR
    MOVE "WRITE-XREF" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC = "22"
        MOVE "GET-BY-XREF" TO SC-OP
        CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
        IF SC-RC = "00"
            MOVE "Y" TO CP-REPLAY
            PERFORM EXPOSE-CLR
            MOVE "CLEARING REPLAY" TO CP-MSG
            EXIT PARAGRAPH
        END-IF
        IF SC-RC = "23" AND
           CC-ID OF BK-CCRD-CLR NOT = SPACES
            MOVE CC-ID OF BK-CCRD-CLR TO WS-DUP-ID
            PERFORM RECOVER-RECORD
            IF CP-RC = "00"
                MOVE "Y" TO CP-REPLAY
                PERFORM EXPOSE-CLR
                MOVE "CLEARING REPLAY" TO CP-MSG
            END-IF
            EXIT PARAGRAPH
        END-IF
        MOVE "24" TO CP-RC
        MOVE "CLEARING RACE RECOVERY FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF SC-RC NOT = "00"
        MOVE SC-RC TO CP-RC
        MOVE "CLEARING XREF WRITE FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM STORE-RECORD.

STORE-RECORD.
    MOVE "WRITE" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE "24" TO CP-RC
        MOVE "CLEARING WRITE FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM EXPOSE-CLR
    MOVE "CLEARING INGESTED" TO CP-MSG
    MOVE CC-ID TO WS-A-ENT
    MOVE "INGEST" TO WS-A-ACT
    MOVE SPACES TO WS-AUD-BEFORE
    MOVE CC-STATUS TO WS-AUD-AFTER
    CALL "CCRCRA" USING BK-CCRD-CLR-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER.

RECOVER-RECORD.
    MOVE SPACES TO BK-CCRD-CARD
    MOVE CP-CARD-ID TO CN-ID
    MOVE "GET" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE "24" TO CP-RC
        MOVE "CLEARING RECOVERY BLOCKED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-DUP-ID TO CC-ID
    PERFORM INIT-CLR
    MOVE WS-DUP-ID TO CC-ID
    MOVE WS-DUP-ID TO CP-CLR-ID
    MOVE "WRITE" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00" AND SC-RC NOT = "22"
        MOVE "24" TO CP-RC
        MOVE "CLEARING RECOVERY FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO SC-MSG
    MOVE "GET" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE SC-RC TO CP-RC
        MOVE "CLEARING RECOVERY FAILED" TO CP-MSG
    END-IF.

CHECK-AUTH-REF.
    IF CP-AUTH-ID = SPACES
        EXIT PARAGRAPH
    END-IF
    IF CP-TXN-TYPE = "REVERSAL"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-CCRD-AUTH
    MOVE CP-AUTH-ID TO CA-ID OF BK-CCRD-AUTH
    MOVE "GET" TO SA-OP
    CALL "CCRCASTO" USING BK-CCRD-STO-AUTH BK-CCRD-AUTH
    IF SA-RC NOT = "00" OR
       CA-CARD-ID OF BK-CCRD-AUTH NOT = CP-CARD-ID
        MOVE "20" TO CP-RC
        MOVE "AUTHORIZATION REFERENCE INVALID" TO CP-MSG
    END-IF.

CHECK-REQUIRED.
    IF CP-SOURCE = SPACES
        MOVE "20" TO CP-RC
        MOVE "SOURCE REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-EXT-REF = SPACES
        MOVE "20" TO CP-RC
        MOVE "EXTERNAL REFERENCE REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-CARD-ID = SPACES
        MOVE "20" TO CP-RC
        MOVE "CARD REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-TXN-TYPE = SPACES
        MOVE "20" TO CP-RC
        MOVE "TRANSACTION TYPE REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-AMOUNT <= 0
        MOVE "20" TO CP-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO CP-MSG
    END-IF.

VALIDATE-CLR.
    MOVE SPACES TO BK-CCRD-CARD
    MOVE CP-CARD-ID TO CN-ID
    MOVE "GET" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE "20" TO CP-RC
        MOVE "CARD NOT FOUND" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CN-STATUS OF BK-CCRD-CARD = "CANCELLED" OR
       CN-STATUS OF BK-CCRD-CARD = "CLOSED"
        MOVE "20" TO CP-RC
        MOVE "CARD NOT CLEARABLE" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    EVALUATE CP-TXN-TYPE
        WHEN "PURCHASE" CONTINUE
        WHEN "REFUND" CONTINUE
        WHEN "CASH" CONTINUE
        WHEN "FEE" CONTINUE
        WHEN "REVERSAL" CONTINUE
        WHEN OTHER
            MOVE "20" TO CP-RC
            MOVE "UNKNOWN CLEARING TYPE" TO CP-MSG
            EXIT PARAGRAPH
    END-EVALUATE
    IF CN-CURRENCY OF BK-CCRD-CARD NOT = CP-CURRENCY
        MOVE "20" TO CP-RC
        MOVE "CURRENCY MISMATCH" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-SETTLE-CURR = SPACES
        MOVE CP-CURRENCY TO CP-SETTLE-CURR
        MOVE CP-AMOUNT TO CP-SETTLE-AMT
    END-IF
    IF CP-SETTLE-CURR NOT = CP-CURRENCY
        MOVE "20" TO CP-RC
        MOVE "FX CONVERSION NOT SUPPORTED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-TXN-DATE NOT > 0
        MOVE WS-BIZDATE TO CP-TXN-DATE
    END-IF
    IF CP-CLEAR-DATE NOT > 0
        MOVE WS-BIZDATE TO CP-CLEAR-DATE
    END-IF
    IF CP-TXN-DATE > WS-BIZDATE
        MOVE "20" TO CP-RC
        MOVE "FUTURE TRANSACTION DATE" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CP-CLEAR-DATE < CP-TXN-DATE
        MOVE "20" TO CP-RC
        MOVE "CLEARING BEFORE TRANSACTION" TO CP-MSG
    END-IF.

INIT-CLR.
    MOVE CP-CLR-ID TO CC-ID
    MOVE CP-CARD-ID TO CC-CARD-ID
    MOVE CN-ACCOUNT OF BK-CCRD-CARD TO CC-ACCOUNT
    MOVE CN-FACILITY OF BK-CCRD-CARD TO CC-FACILITY
    MOVE CP-AUTH-ID TO CC-AUTH-ID
    MOVE CP-ORIG-CLR-ID TO CC-ORIG-CLR-ID
    MOVE CP-EXT-REF TO CC-EXT-REF
    MOVE CP-EXT-BATCH TO CC-EXT-BATCH
    MOVE CP-SOURCE TO CC-SOURCE
    MOVE CP-MERCHANT-ID TO CC-MERCHANT-ID
    MOVE CP-MERCHANT-NAME TO CC-MERCHANT-NAME
    MOVE CP-MCC TO CC-MCC
    MOVE CP-CHANNEL TO CC-CHANNEL
    MOVE CP-TXN-TYPE TO CC-TXN-TYPE
    MOVE CP-AMOUNT TO CC-AMOUNT
    MOVE CP-CURRENCY TO CC-CURRENCY
    MOVE CP-FEE-AMT TO CC-FEE-AMT
    MOVE CP-SETTLE-CURR TO CC-SETTLE-CURR
    MOVE CP-SETTLE-AMT TO CC-SETTLE-AMT
    MOVE "RECEIVED" TO CC-STATUS
    MOVE "PENDING" TO CC-MATCH-STATUS
    MOVE "PENDING" TO CC-POST-STATUS
    MOVE "PENDING" TO CC-SETTLE-STATUS
    MOVE "PENDING" TO CC-RECON-STATUS
    MOVE CP-TXN-DATE TO CC-TXN-DATE
    MOVE CP-CLEAR-DATE TO CC-CLEAR-DATE
    MOVE WS-BIZDATE TO CC-PROC-DATE
    MOVE WS-BIZDATE TO CC-BIZDATE
    MOVE CP-OPERATOR TO CC-OPERATOR
    MOVE CP-CORR TO CC-CORR
    MOVE CP-REQUEST TO CC-REQUEST
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO CC-CREATED
    MOVE WS-NOW(1:14) TO CC-UPDATED
    MOVE 1 TO CC-VERSION.

BUILD-ID.
    MOVE "CARD-CLEAR" TO WS-SEQ-NAME
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CP-CLR-ID
    STRING "Y" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CP-CLR-ID
    END-STRING
    MOVE CP-CLR-ID TO CC-ID.

EXPOSE-CLR.
    MOVE CC-ID TO CP-CLR-ID
    MOVE CC-CARD-ID TO CP-CARD-ID
    MOVE CC-ACCOUNT TO CP-ACCOUNT
    MOVE CC-FACILITY TO CP-FACILITY
    MOVE CC-AUTH-ID TO CP-AUTH-ID
    MOVE CC-TXN-ID TO CP-TXN-ID
    MOVE CC-ORIG-CLR-ID TO CP-ORIG-CLR-ID
    MOVE CC-EXT-REF TO CP-EXT-REF
    MOVE CC-EXT-BATCH TO CP-EXT-BATCH
    MOVE CC-SOURCE TO CP-SOURCE
    MOVE CC-MERCHANT-ID TO CP-MERCHANT-ID
    MOVE CC-MCC TO CP-MCC
    MOVE CC-TXN-TYPE TO CP-TXN-TYPE
    MOVE CC-AMOUNT TO CP-AMOUNT
    MOVE CC-CURRENCY TO CP-CURRENCY
    MOVE CC-AUTH-AMOUNT TO CP-AUTH-AMOUNT
    MOVE CC-DIFF-AMOUNT TO CP-DIFF-AMOUNT
    MOVE CC-FEE-AMT TO CP-FEE-AMT
    MOVE CC-SETTLE-CURR TO CP-SETTLE-CURR
    MOVE CC-SETTLE-AMT TO CP-SETTLE-AMT
    MOVE CC-SETTLE-BATCH TO CP-SETTLE-BATCH
    MOVE CC-STATUS TO CP-STATUS
    MOVE CC-MATCH-STATUS TO CP-MATCH-STATUS
    MOVE CC-POST-STATUS TO CP-POST-STATUS
    MOVE CC-SETTLE-STATUS TO CP-SETTLE-STATUS
    MOVE CC-RECON-STATUS TO CP-RECON-STATUS.

DO-GET.
    MOVE CP-CLR-ID TO CC-ID
    MOVE "GET" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "CLEARING NOT FOUND" TO CP-MSG
        GOBACK
    END-IF
    PERFORM EXPOSE-CLR
    GOBACK.

STATUS-TO-EVENT.
    EVALUATE FUNCTION TRIM(CP-STATUS)
        WHEN "RECEIVED" MOVE "RECEIVED" TO WS-EVT
        WHEN "VALIDATED" MOVE "ACCEPT" TO WS-EVT
        WHEN "REJECTED" MOVE "REJECT" TO WS-EVT
        WHEN "MATCHED" MOVE "MATCH" TO WS-EVT
        WHEN "UNMATCHED" MOVE "UNMATCH" TO WS-EVT
        WHEN "POSTING-PEND" MOVE "POST-PENDING" TO WS-EVT
        WHEN "POSTED" MOVE "POST" TO WS-EVT
        WHEN "POST-FAILED" MOVE "POST-FAIL" TO WS-EVT
        WHEN "SETTLE-PEND" MOVE "BATCH" TO WS-EVT
        WHEN "SETTLED" MOVE "SETTLE" TO WS-EVT
        WHEN "RECONCILED" MOVE "RECON" TO WS-EVT
        WHEN "EXCEPTION" MOVE "EXCEPTION" TO WS-EVT
        WHEN "CANCELLED" MOVE "CANCEL" TO WS-EVT
        WHEN OTHER MOVE SPACES TO WS-EVT
    END-EVALUATE.

DO-STATUS.
    MOVE CP-CLR-ID TO CC-ID
    MOVE "GET" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "CLEARING NOT FOUND" TO CP-MSG
        GOBACK
    END-IF
    PERFORM STATUS-TO-EVENT
    IF WS-EVT = SPACES
        MOVE "20" TO CP-RC
        MOVE "UNKNOWN TARGET STATUS" TO CP-MSG
        GOBACK
    END-IF
    CALL "CCRCST" USING CC-STATUS WS-EVT WS-AUD-AFTER WS-RC-T
        CP-MSG
    IF WS-RC-T NOT = "00"
        MOVE "20" TO CP-RC
        GOBACK
    END-IF
    MOVE CC-STATUS TO WS-AUD-BEFORE
    MOVE WS-AUD-AFTER TO CC-STATUS
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO CC-UPDATED
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE SC-RC TO CP-RC
        MOVE "CLEARING UPDATE FAILED" TO CP-MSG
        GOBACK
    END-IF
    PERFORM EXPOSE-CLR
    MOVE "CLEARING STATUS SET" TO CP-MSG
    MOVE CC-ID TO WS-A-ENT
    MOVE "STSET" TO WS-A-ACT
    CALL "CCRCRA" USING BK-CCRD-CLR-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER
    GOBACK.
