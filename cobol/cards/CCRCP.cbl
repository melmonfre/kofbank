IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCP.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "CCRCSTO".
COPY "CCREXCSTO".
COPY "CCRDSTO".
COPY "CCRDGP".
COPY "BTXNLFC".
COPY "BTXNRESP".
COPY "BCREXP".
01 BK-CCRD-CLR.
   COPY "CCRC".
01 BK-CCRD-CARD.
   COPY "CCRD".
01 BK-CCRD-EXC-REC.
   COPY "CCREXC".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).
01 WS-LOCKED PIC X(01).
01 WS-KIND PIC X(08).
01 WS-TXNTYPE PIC X(08).
01 WS-OP PIC X(12).
01 WS-REQ PIC X(24).
01 WS-EVT PIC X(16).
01 WS-NEXT PIC X(12).
01 WS-RC-T PIC X(02).
01 WS-CUR-ID PIC X(12).
01 WS-ORIG-ID PIC X(12).
01 WS-REVTXN PIC X(12).
01 WS-KEEPMSG PIC X(80).
01 WS-KEEPST PIC X(12).
01 WS-KEEPID PIC X(12).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20).
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-IDX PIC X(12).
01 WS-PFX PIC X(01).
01 WS-NOW PIC X(14).
01 WS-DESCR PIC X(40).
01 WS-AUD-BEFORE PIC X(120).
01 WS-AUD-AFTER PIC X(120).
01 WS-A-ENT PIC X(12).
01 WS-A-ACT PIC X(12).

LINKAGE SECTION.
COPY "CCRCP".

PROCEDURE DIVISION USING BK-CCRD-CLR-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    MOVE "N" TO CP-REPLAY
    MOVE "N" TO WS-LOCKED
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    EVALUATE CP-OP
        WHEN "CLEARING-POST" PERFORM DO-POST
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN CLEARING OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

DO-POST.
    PERFORM LOCK-CLR
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-CLR
    IF CP-RC NOT = "00"
        PERFORM UNLOCK-CLR
        GOBACK
    END-IF
    MOVE CC-STATUS TO WS-AUD-BEFORE
    IF CC-POST-STATUS = "REVERSED" AND
       CC-TXN-TYPE = "REVERSAL"
        MOVE "Y" TO CP-REPLAY
        PERFORM EXPOSE-CLR
        PERFORM UNLOCK-CLR
        MOVE "REVERSAL REPLAY" TO CP-MSG
        GOBACK
    END-IF
    IF CC-POST-STATUS = "POSTED"
        MOVE "Y" TO CP-REPLAY
        PERFORM EXPOSE-CLR
        PERFORM UNLOCK-CLR
        MOVE "POST REPLAY" TO CP-MSG
        GOBACK
    END-IF
    PERFORM CHECK-RETRY
    EVALUATE CC-STATUS
        WHEN "MATCHED"
            IF CC-MATCH-STATUS = "EXPIRED"
                MOVE "20" TO CP-RC
                MOVE "EXPIRED REQUIRES AUTH REVIVAL" TO CP-MSG
                PERFORM UNLOCK-CLR
                GOBACK
            END-IF
        WHEN "EXCEPTION"
            IF CC-MATCH-STATUS = "EXPIRED"
                MOVE "20" TO CP-RC
                MOVE "EXPIRED REQUIRES AUTH REVIVAL" TO CP-MSG
                PERFORM UNLOCK-CLR
                GOBACK
            END-IF
        WHEN "UNMATCHED"
            IF CP-FORCE NOT = "Y"
                MOVE "20" TO CP-RC
                MOVE "UNMATCHED REQUIRES FORCE" TO CP-MSG
                PERFORM UNLOCK-CLR
                GOBACK
            END-IF
        WHEN OTHER
            MOVE "20" TO CP-RC
            MOVE "CLEARING NOT POSTABLE" TO CP-MSG
            PERFORM UNLOCK-CLR
            GOBACK
    END-EVALUATE
    PERFORM RESOLVE-KIND
    IF CP-RC = "00" AND CC-TXN-TYPE = "REVERSAL"
        PERFORM RUN-REVERSAL
        IF CP-RC = "00" AND CP-REPLAY NOT = "Y"
            MOVE "REVERSED" TO CC-POST-STATUS
            MOVE WS-REVTXN TO CC-TXN-ID OF BK-CCRD-CLR
            MOVE "POSTED" TO CC-STATUS
            PERFORM SAVE-CLR
            MOVE "CLEARING REVERSED" TO CP-MSG
            MOVE CC-ID TO WS-A-ENT
            MOVE "REVERS" TO WS-A-ACT
            MOVE CC-STATUS TO WS-AUD-AFTER
            CALL "CCRCRA" USING BK-CCRD-CLR-PARMS WS-A-ENT
                WS-A-ACT WS-AUD-BEFORE WS-AUD-AFTER
            PERFORM EXPOSE-CLR
        END-IF
    END-IF
    IF CP-RC = "00" AND CC-TXN-TYPE NOT = "REVERSAL"
        PERFORM MARK-PENDING
        PERFORM RUN-LIFECYCLE
    END-IF
    IF CP-RC = "00" AND WS-KIND = "CREDIT" AND
       CC-TXN-TYPE NOT = "REVERSAL"
        PERFORM UPDATE-EXPOSURE
    END-IF
    IF CP-RC = "00" AND CP-REPLAY NOT = "Y" AND
       CC-TXN-TYPE NOT = "REVERSAL"
        PERFORM FINISH-POST
    ELSE
        IF CP-RC NOT = "00" AND CP-REPLAY NOT = "Y" AND
           CC-TXN-TYPE NOT = "REVERSAL"
            PERFORM MARK-FAIL
        END-IF
    END-IF
    PERFORM UNLOCK-CLR
    GOBACK.

LOCK-CLR.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "LOCK" TO GD-OP
    STRING "CLR-" DELIMITED SIZE CP-CLR-ID DELIMITED SIZE
        INTO GD-LOCK-ID
    END-STRING
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "CLEARING BUSY" TO CP-MSG
    END-IF.

UNLOCK-CLR.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "UNLOCK" TO GD-OP
    STRING "CLR-" DELIMITED SIZE CP-CLR-ID DELIMITED SIZE
        INTO GD-LOCK-ID
    END-STRING
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD.

LOAD-CLR.
    MOVE CP-CLR-ID TO CC-ID
    MOVE "GET" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "CLEARING NOT FOUND" TO CP-MSG
    END-IF.

SAVE-CLR.
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO CC-UPDATED
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE SC-RC TO CP-RC
        MOVE "CLEARING UPDATE FAILED" TO CP-MSG
    END-IF.

CHECK-RETRY.
    IF CC-STATUS NOT = "POST-FAILED"
        EXIT PARAGRAPH
    END-IF
    MOVE "RETRY" TO WS-EVT
    CALL "CCRCST" USING CC-STATUS WS-EVT WS-NEXT WS-RC-T CP-MSG
    IF WS-RC-T = "00"
        MOVE WS-NEXT TO CC-STATUS
    END-IF.

RESOLVE-KIND.
    MOVE SPACES TO BK-CCRD-CARD
    MOVE CC-CARD-ID TO CN-ID
    MOVE "GET" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE "20" TO CP-RC
        MOVE "CARD NOT FOUND" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CN-KIND TO WS-KIND
    EVALUATE WS-KIND
        WHEN "DEBIT"
            EVALUATE CC-TXN-TYPE
                WHEN "REFUND" MOVE "DEPOSIT" TO WS-TXNTYPE
                WHEN OTHER MOVE "WITHDRAW" TO WS-TXNTYPE
            END-EVALUATE
        WHEN "CREDIT"
            EVALUATE CC-TXN-TYPE
                WHEN "REFUND" MOVE "CREDREF" TO WS-TXNTYPE
                WHEN OTHER MOVE "CREDCHRG" TO WS-TXNTYPE
            END-EVALUATE
        WHEN OTHER
            MOVE "20" TO CP-RC
            MOVE "UNKNOWN CARD KIND" TO CP-MSG
    END-EVALUATE
    MOVE CP-CLR-ID TO LFC-REF
    MOVE CC-ID TO LFC-ORIGIN.

SETUP-TXN.
    MOVE WS-TXNTYPE TO LFC-TYPE
    MOVE CC-AMOUNT TO LFC-AMOUNT
    MOVE CC-CURRENCY TO LFC-CURRENCY
    MOVE CP-OPERATOR TO LFC-OPERATOR
    MOVE CP-CORR TO LFC-CORR
    MOVE SPACES TO WS-DESCR
    STRING "CARD " DELIMITED SIZE CC-TXN-TYPE
        DELIMITED SIZE " " DELIMITED SIZE
        FUNCTION TRIM(CC-MERCHANT-ID) DELIMITED SIZE
        INTO WS-DESCR
    END-STRING
    MOVE WS-DESCR TO LFC-DESCR
    IF WS-KIND = "DEBIT"
        IF WS-TXNTYPE = "DEPOSIT"
            MOVE CC-ACCOUNT TO LFC-DST
            MOVE SPACES TO LFC-SRC
        ELSE
            MOVE CC-ACCOUNT TO LFC-SRC
            MOVE SPACES TO LFC-DST
        END-IF
        MOVE SPACES TO LFC-FACILITY
    ELSE
        MOVE CC-FACILITY TO LFC-FACILITY
        MOVE CC-AMOUNT TO LFC-PRINCIPAL
        MOVE 0 TO LFC-INTEREST
        MOVE CC-FEE-AMT TO LFC-FEE-AMT
        MOVE SPACES TO LFC-SRC
        MOVE SPACES TO LFC-DST
    END-IF.

RUN-LIFECYCLE.
    MOVE "CREATE" TO WS-OP
    PERFORM DO-LFC-PHASE
    IF CP-RC = "00"
        MOVE "AUTHORIZE" TO WS-OP
        PERFORM DO-LFC-PHASE
    END-IF
    IF CP-RC = "00"
        MOVE "POST" TO WS-OP
        PERFORM DO-LFC-PHASE
    END-IF
    IF CP-RC = "00"
        MOVE "SETTLE" TO WS-OP
        PERFORM DO-LFC-PHASE
    END-IF.

DO-LFC-PHASE.
    MOVE WS-OP TO LFC-OP
    PERFORM SETUP-TXN
    MOVE LFC-TXN-ID TO WS-IDX
    MOVE SPACES TO LFC-REQUEST
    STRING "KTX-" DELIMITED SIZE CP-CLR-ID DELIMITED SIZE
        "-" DELIMITED SIZE LFC-OP DELIMITED SIZE INTO LFC-REQUEST
    END-STRING
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    IF TXR-RC NOT = "00"
        MOVE TXR-RC TO CP-RC
        MOVE TXR-MSG TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE TXR-ID TO LFC-TXN-ID.

EXPOSE-CLR.
    MOVE CC-ID TO CP-CLR-ID
    MOVE CC-AUTH-ID TO CP-AUTH-ID
    MOVE CC-TXN-ID TO CP-TXN-ID
    MOVE CC-STATUS TO CP-STATUS
    MOVE CC-MATCH-STATUS TO CP-MATCH-STATUS
    MOVE CC-POST-STATUS TO CP-POST-STATUS
    MOVE CC-SETTLE-STATUS TO CP-SETTLE-STATUS
    MOVE CC-RECON-STATUS TO CP-RECON-STATUS
    MOVE CC-AMOUNT TO CP-AMOUNT
    MOVE CC-CURRENCY TO CP-CURRENCY
    MOVE CC-TXN-TYPE TO CP-TXN-TYPE
    MOVE CC-CARD-ID TO CP-CARD-ID.

UPDATE-EXPOSURE.
    MOVE SPACES TO BK-CR-EXP-PARMS
    IF CC-TXN-TYPE = "REFUND"
        MOVE "REPAY" TO CE-OP
    ELSE
        MOVE "DISBURSE" TO CE-OP
    END-IF
    MOVE CC-FACILITY TO CE-FAC-ID
    MOVE CC-AMOUNT TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        MOVE CE-RC TO CP-RC
        MOVE CE-MSG TO CP-MSG
    END-IF.

FINISH-POST.
    MOVE LFC-TXN-ID TO CC-TXN-ID
    MOVE "POSTED" TO CC-POST-STATUS
    MOVE "POST" TO WS-EVT
    CALL "CCRCST" USING CC-STATUS WS-EVT WS-NEXT WS-RC-T CP-MSG
    IF WS-RC-T = "00"
        MOVE WS-NEXT TO CC-STATUS
    END-IF
    MOVE CC-TXN-ID TO CP-TXN-ID
    PERFORM SAVE-CLR
    IF CP-RC = "00"
        MOVE CC-ID TO WS-A-ENT
        MOVE "POST" TO WS-A-ACT
        MOVE CC-STATUS TO WS-AUD-AFTER
        CALL "CCRCRA" USING BK-CCRD-CLR-PARMS WS-A-ENT WS-A-ACT
            WS-AUD-BEFORE WS-AUD-AFTER
        PERFORM EXPOSE-CLR
        MOVE "CLEARING POSTED" TO CP-MSG
    END-IF.

MARK-FAIL.
    MOVE CP-MSG TO WS-KEEPMSG
    MOVE "POST-FAIL" TO WS-EVT
    CALL "CCRCST" USING CC-STATUS WS-EVT WS-NEXT WS-RC-T CP-MSG
    IF CP-RC NOT = "00"
        MOVE WS-KEEPMSG TO CP-MSG
    END-IF
    IF WS-RC-T = "00"
        MOVE WS-NEXT TO CC-STATUS
        MOVE "FAILED" TO CC-POST-STATUS
        MOVE SPACES TO CP-MSG
        MOVE WS-OP TO CP-MSG
        PERFORM SAVE-CLR
        PERFORM OPEN-POST-EXCEPTION
    END-IF.

OPEN-POST-EXCEPTION.
    MOVE SPACES TO BK-CCRD-EXC-REC
    MOVE CP-CLR-ID TO EX-CLR-ID
    MOVE "POST-FAILURE" TO EX-TYPE
    MOVE "FIND-OPEN" TO SX-OP
    CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    IF SX-RC NOT = "00"
        MOVE "O" TO WS-PFX
        MOVE "CARD-CEXEC" TO WS-SEQ-NAME
        CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
        IF WS-SEQ-ST = "00"
            MOVE WS-SEQ TO WS-ID-NUM
            MOVE WS-ID-NUM TO WS-ID-ED
            MOVE SPACES TO WS-IDX
            STRING WS-PFX DELIMITED SIZE WS-ID-ED DELIMITED SIZE
                INTO WS-IDX
            END-STRING
            MOVE SPACES TO BK-CCRD-EXC-REC
            MOVE WS-IDX TO EX-ID
            MOVE "POST-FAILURE" TO EX-TYPE
            MOVE CP-CLR-ID TO EX-CLR-ID
            MOVE CC-AUTH-ID TO EX-AUTH-ID
            MOVE CC-SOURCE TO EX-SOURCE
            MOVE "OPEN" TO EX-STATUS
            MOVE CP-MSG TO EX-REASON
            MOVE CP-OPERATOR TO EX-OPERATOR
            MOVE WS-BIZDATE TO EX-BIZDATE
            MOVE FUNCTION CURRENT-DATE TO WS-NOW
            MOVE WS-NOW(1:14) TO EX-CREATED
            MOVE "WRITE" TO SX-OP
            CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
        END-IF
    END-IF
    MOVE "00" TO CP-RC.

RUN-REVERSAL.
    MOVE CC-ID TO WS-CUR-ID
    MOVE CC-ORIG-CLR-ID TO WS-ORIG-ID
    IF WS-ORIG-ID = SPACES
        MOVE "20" TO CP-RC
        MOVE "ORIGINAL CLEARING REQUIRED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-ORIG-ID TO CC-ID
    MOVE "GET" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE "20" TO CP-RC
        MOVE "ORIGINAL CLEARING NOT FOUND" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CC-POST-STATUS = "REVERSED"
        MOVE "Y" TO CP-REPLAY
        MOVE WS-CUR-ID TO CP-CLR-ID
        MOVE CC-TXN-ID TO CP-TXN-ID
        MOVE "REVERSAL ALREADY DONE" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CC-SETTLE-STATUS = "SETTLED"
        MOVE "20" TO CP-RC
        MOVE "USE REFUND AFTER SETTLEMENT" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CC-POST-STATUS NOT = "POSTED"
        MOVE "20" TO CP-RC
        MOVE "ORIGINAL NOT POSTED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-TXN-LFC-REQ
    MOVE "REVERSE" TO LFC-OP
    MOVE CC-TXN-ID TO LFC-TXN-ID
    MOVE CP-OPERATOR TO LFC-OPERATOR
    MOVE CP-CORR TO LFC-CORR
    MOVE WS-CUR-ID TO LFC-REF
    MOVE "CLEARING REVERSAL" TO LFC-REASON
    STRING "KTX-" DELIMITED SIZE WS-CUR-ID DELIMITED SIZE
        "-R" DELIMITED SIZE INTO LFC-REQUEST
    END-STRING
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    IF TXR-RC NOT = "00"
        MOVE TXR-RC TO CP-RC
        MOVE TXR-MSG TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE TXR-ID TO WS-REVTXN
    MOVE CC-POST-STATUS TO WS-KEEPST
    MOVE "REVERSED" TO CC-POST-STATUS
    ADD 1 TO CC-VERSION
    MOVE "REWRITE" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    MOVE WS-KEEPST TO CC-POST-STATUS
    MOVE WS-CUR-ID TO CC-ID
    MOVE "GET" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE SC-RC TO CP-RC
        MOVE "CLEARING RELOAD FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF.

MARK-PENDING.
    MOVE "POST-PENDING" TO WS-EVT
    CALL "CCRCST" USING CC-STATUS WS-EVT WS-NEXT WS-RC-T CP-MSG
    IF WS-RC-T = "00"
        MOVE WS-NEXT TO CC-STATUS
        MOVE "PENDING" TO CC-POST-STATUS
    END-IF.
