IDENTIFICATION DIVISION.
PROGRAM-ID. CCRDREG.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "CCRDSTO".
COPY "CCRDCLP".
COPY "BPRODO".
COPY "BDATP".
COPY "BCREXP".
COPY "CCRDGP".
01 BK-CCRD-CARD.
   COPY "CCRD".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).
01 WS-SEQ-NAME PIC X(20).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC 9(11).
01 WS-PROD-ID PIC X(04).
01 WS-CUST-OUT.
   05 CU-OUT-ID PIC X(12).
   05 CU-OUT-TYPE PIC X(01).
   05 CU-OUT-STATUS PIC X(02).
   05 CU-OUT-NAME PIC X(60).
   05 CU-OUT-DOC-TYPE PIC X(04).
   05 CU-OUT-DOC PIC X(20).
   05 CU-OUT-BIRTH PIC 9(08).
   05 CU-OUT-RISK PIC X(02).
   05 CU-OUT-KYC PIC X(02).
   05 CU-OUT-ADDR PIC X(80).
   05 CU-OUT-VERSION PIC 9(05).
   05 CU-OUT-HASH PIC X(16).
   05 CU-RC PIC X(02).
01 WS-ACCT-OUT.
   05 AC-OUT-ID PIC X(12).
   05 AC-OUT-CUST PIC X(12).
   05 AC-OUT-PRODUCT PIC X(04).
   05 AC-OUT-CURRENCY PIC X(03).
   05 AC-OUT-STATUS PIC X(02).
   05 AC-OUT-OPENED PIC 9(08).
   05 AC-OUT-CLOSED PIC 9(08).
   05 AC-OUT-VERSION PIC 9(05).
   05 AC-OUT-HASH PIC X(16).
   05 AC-RC PIC X(02).
01 WS-AUD-BEFORE PIC X(120).
01 WS-AUD-AFTER PIC X(120).
01 WS-HASH-BUF PIC X(64).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH-V PIC X(16).
01 WS-A-ENT PIC X(12).
01 WS-A-ACT PIC X(12).

LINKAGE SECTION.
COPY "CCRDP".

PROCEDURE DIVISION USING BK-CCRD-PARMS.
    MOVE "00" TO CK-RC
    MOVE SPACES TO CK-MSG
    MOVE "N" TO CK-REPLAY
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CK-RC
        MOVE "CONFIG MISSING" TO CK-MSG
        GOBACK
    END-IF
    PERFORM CHECK-PRODUCT-CFG
    IF CK-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-RELATIONSHIP
    IF CK-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM GUARD-BEGIN
    IF CK-REPLAY = "Y"
        GOBACK
    END-IF
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM BUILD-ID
    IF CK-RC NOT = "00"
        PERFORM GUARD-END
        GOBACK
    END-IF
    PERFORM INIT-CARD
    MOVE "WRITE" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE ST-RC TO CK-RC
        MOVE "CARD WRITE FAILED" TO CK-MSG
        PERFORM GUARD-END
        GOBACK
    END-IF
    MOVE "REQUESTED" TO CK-STATUS
    PERFORM EXPORT-CARD
    MOVE "CARD REGISTERED" TO CK-MSG
    MOVE CK-CARD-ID TO WS-A-ENT
    MOVE "CREAT" TO WS-A-ACT
    MOVE SPACES TO WS-AUD-BEFORE
    MOVE SPACES TO WS-AUD-AFTER
    MOVE CK-PRODUCT TO WS-AUD-AFTER
    CALL "CCRDA" USING BK-CCRD-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER
    PERFORM GUARD-END
    GOBACK.

CHECK-PRODUCT-CFG.
    MOVE SPACES TO BK-CCRD-CFG
    MOVE CK-PRODUCT TO CG-PRODUCT
    CALL "CCRDCFG" USING BK-CCRD-CFG
    IF CG-STATUS NOT = "00"
        MOVE "20" TO CK-RC
        MOVE "CARD PRODUCT NOT CONFIGURED" TO CK-MSG
        GOBACK
    END-IF
    MOVE CK-PRODUCT TO WS-PROD-ID
    CALL "BPRODQ" USING WS-PROD-ID WS-BIZDATE BK-PROD-OUT
    IF PQ-FOUND NOT = "Y"
        MOVE "20" TO CK-RC
        MOVE "PRODUCT NOT IN CATALOG" TO CK-MSG
        GOBACK
    END-IF
    IF CK-KIND = SPACES
        MOVE CG-KIND TO CK-KIND
    END-IF
    IF CK-KIND NOT = CG-KIND
        MOVE "20" TO CK-RC
        MOVE "CARD KIND NOT ALLOWED BY PRODUCT" TO CK-MSG
        GOBACK
    END-IF
    IF CK-CURRENCY = SPACES
        MOVE CG-CURRENCY TO CK-CURRENCY
    END-IF
    IF CK-CURRENCY NOT = CG-CURRENCY
        MOVE "20" TO CK-RC
        MOVE "CURRENCY NOT SUPPORTED" TO CK-MSG
    END-IF.

CHECK-RELATIONSHIP.
    CALL "BCUSTQ" USING CK-CUST-ID WS-CUST-OUT
    IF CU-RC NOT = "00"
        MOVE "20" TO CK-RC
        MOVE "CUSTOMER NOT FOUND" TO CK-MSG
        GOBACK
    END-IF
    IF CU-OUT-STATUS NOT = "AC"
        MOVE "20" TO CK-RC
        MOVE "CUSTOMER NOT ACTIVE" TO CK-MSG
        GOBACK
    END-IF
    IF CK-KIND = "DEBIT"
        PERFORM CHECK-ACCOUNT
    ELSE
        PERFORM CHECK-FACILITY
    END-IF.

CHECK-ACCOUNT.
    IF CK-ACCOUNT = SPACES
        MOVE "20" TO CK-RC
        MOVE "ACCOUNT REQUIRED FOR DEBIT CARD" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    CALL "BACQRY" USING CK-ACCOUNT WS-ACCT-OUT
    IF AC-RC NOT = "00"
        MOVE "20" TO CK-RC
        MOVE "ACCOUNT NOT FOUND" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    IF AC-OUT-STATUS NOT = "AC"
        MOVE "20" TO CK-RC
        MOVE "ACCOUNT NOT ACTIVE" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    IF AC-OUT-CUST NOT = CK-CUST-ID
        MOVE "20" TO CK-RC
        MOVE "ACCOUNT NOT OWNED BY CUSTOMER" TO CK-MSG
    END-IF.

CHECK-FACILITY.
    IF CK-FACILITY = SPACES
        MOVE "20" TO CK-RC
        MOVE "FACILITY REQUIRED FOR CREDIT CARD" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO BK-CR-EXP-PARMS
    MOVE "GET" TO CE-OP
    MOVE CK-FACILITY TO CE-FAC-ID
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        MOVE "20" TO CK-RC
        MOVE "CREDIT FACILITY NOT FOUND" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    IF CE-STATUS NOT = "ACT"
        MOVE "20" TO CK-RC
        MOVE "FACILITY NOT ACTIVE" TO CK-MSG
    END-IF.

GUARD-BEGIN.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "BEGIN" TO GD-OP
    MOVE CK-REQUEST TO GD-REQUEST
    MOVE "CARD.REGISTER" TO GD-OPERATION
    MOVE CK-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CK-RC
        MOVE "REQUEST IN PROGRESS" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    IF GD-HIT = "Y"
        MOVE GD-RESULT(1:12) TO CK-CARD-ID
        MOVE "Y" TO CK-REPLAY
        MOVE "CARD REGISTER REPLAY" TO CK-MSG
    END-IF.

GUARD-END.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "END" TO GD-OP
    MOVE CK-REQUEST TO GD-REQUEST
    MOVE "CARD.REGISTER" TO GD-OPERATION
    MOVE CK-OPERATOR TO GD-OPERATOR
    MOVE CK-RC TO GD-RC
    IF CK-RC = "00"
        MOVE CK-CARD-ID TO GD-RESULT
    ELSE
        MOVE CK-MSG TO GD-RESULT
    END-IF
    CALL "CCRDG" USING BK-CCRD-GUARD.

BUILD-ID.
    MOVE "CARD" TO WS-SEQ-NAME
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CK-RC
        MOVE "SEQUENCE ERROR" TO CK-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CK-CARD-ID
    STRING "U" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CK-CARD-ID
    END-STRING.

INIT-CARD.
    MOVE SPACES TO BK-CCRD-CARD
    MOVE CK-CARD-ID TO CN-ID
    MOVE CK-CUST-ID TO CN-CUST-ID
    MOVE CK-PRODUCT TO CN-PRODUCT
    MOVE CK-KIND TO CN-KIND
    MOVE CK-ACCOUNT TO CN-ACCOUNT
    MOVE CK-FACILITY TO CN-FACILITY
    MOVE "REQUESTED" TO CN-STATUS
    MOVE CK-CURRENCY TO CN-CURRENCY
    IF CK-MASKED = SPACES
        STRING "MASK" DELIMITED SIZE CK-CARD-ID DELIMITED SIZE
            INTO CN-MASKED
        END-STRING
    ELSE
        MOVE CK-MASKED TO CN-MASKED
    END-IF
    MOVE CG-NETWORK TO CN-NETWORK
    MOVE CK-NET-REF TO CN-NET-REF
    IF CK-TOKEN = SPACES
        STRING "TOK" DELIMITED SIZE CK-CARD-ID DELIMITED SIZE
            INTO CN-TOKEN
        END-STRING
    ELSE
        MOVE CK-TOKEN TO CN-TOKEN
    END-IF
    IF CK-PIN-SET = "Y"
        MOVE "Y" TO CN-PIN-SET
    ELSE
        MOVE "N" TO CN-PIN-SET
    END-IF
    MOVE WS-BIZDATE TO CN-ISSUE-DATE
    MOVE 0 TO CN-ACTIVE-DATE
    MOVE WS-BIZDATE TO DAT-DATE
    MOVE "ADD-MONTHS" TO DAT-OP
    MOVE CG-VALID-MONTHS TO DAT-MONTHS
    CALL "BDAT" USING BK-DAT-PARMS
    IF DAT-RC = "00"
        MOVE DAT-RESULT TO CN-EXP-DATE
    ELSE
        MOVE 0 TO CN-EXP-DATE
    END-IF
    MOVE 0 TO CN-CANCEL-DATE
    MOVE SPACES TO CN-PREV-CARD
    MOVE SPACES TO CN-NEXT-CARD
    MOVE CK-DESCRIPTION TO CN-DESCRIPTION
    MOVE CK-REASON TO CN-REASON
    MOVE CK-OPERATOR TO CN-OPERATOR
    MOVE CK-CORR TO CN-CORR
    MOVE WS-BIZDATE TO CN-CREATED
    MOVE WS-BIZDATE TO CN-UPDATED
    MOVE 1 TO CN-VERSION
    PERFORM EXPORT-CARD.
    MOVE CN-MASKED TO CK-MASKED
    MOVE CN-NETWORK TO CK-NETWORK
    MOVE CN-NET-REF TO CK-NET-REF
    MOVE CN-TOKEN TO CK-TOKEN
    MOVE CN-PIN-SET TO CK-PIN-SET
    MOVE CN-EXP-DATE TO CK-EXP-DATE
    MOVE SPACES TO CK-PREV-CARD
    MOVE SPACES TO CK-NEXT-CARD.

COMPUTE-HASH.

EXPORT-CARD.
    MOVE CN-MASKED TO CK-MASKED
    MOVE CN-NETWORK TO CK-NETWORK
    MOVE CN-NET-REF TO CK-NET-REF
    MOVE CN-TOKEN TO CK-TOKEN
    MOVE CN-PIN-SET TO CK-PIN-SET
    MOVE CN-EXP-DATE TO CK-EXP-DATE
    MOVE SPACES TO CK-PREV-CARD
    MOVE SPACES TO CK-NEXT-CARD.

COMPUTE-HASH.
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(CN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CN-STATUS) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CN-MASKED) DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 64 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH-V
    MOVE WS-HASH-V TO CN-HASH.
