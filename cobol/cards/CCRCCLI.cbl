IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "CCRCP".
01 WS-OP PIC X(24).
01 WS-A PIC X(40).
01 WS-B PIC X(40).
01 WS-C PIC X(40).
01 WS-D PIC X(40).
01 WS-E PIC X(40).
01 WS-F PIC X(40).
01 WS-G PIC X(40).
01 WS-H PIC X(40).
01 WS-I PIC X(40).
01 WS-J PIC X(40).
01 WS-K PIC X(40).
01 WS-L PIC X(40).
01 WS-M PIC X(40).
01 WS-N PIC X(40).
01 WS-O PIC X(40).
01 WS-P PIC X(40).
01 WS-Q PIC X(40).
01 WS-R PIC X(40).
01 WS-S PIC X(40).
01 WS-T PIC X(40).

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H
            WS-I WS-J WS-K WS-L WS-M WS-N WS-O WS-P WS-Q WS-R
            WS-S WS-T
    END-UNSTRING
    MOVE SPACES TO BK-CCRD-CLR-PARMS
    EVALUATE FUNCTION TRIM(WS-OP)
        WHEN "ingest" PERFORM DO-INGEST
        WHEN "match" PERFORM DO-MATCH
        WHEN "post" PERFORM DO-POST
        WHEN "get" PERFORM DO-GET
        WHEN "status" PERFORM DO-STATUS
        WHEN "settle-build" PERFORM DO-SETTLE-BUILD
        WHEN "settle-check" PERFORM DO-SETTLE-CHECK
        WHEN "settle-mark" PERFORM DO-SETTLE-MARK
        WHEN "settle-get" PERFORM DO-SETTLE-GET
        WHEN "exc-get" PERFORM DO-EXC-GET
        WHEN "exc-list" PERFORM DO-EXC-LIST
        WHEN "exc-resolve" PERFORM DO-EXC-RESOLVE
        WHEN "exc-retry" PERFORM DO-EXC-RETRY
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN CLEARING OP"
    END-EVALUATE
    GOBACK.

DO-INGEST.
    MOVE "CLEARING-INGEST" TO CP-OP
    MOVE WS-A TO CP-SOURCE
    MOVE WS-B TO CP-EXT-REF
    MOVE WS-C TO CP-CARD-ID
    MOVE WS-D TO CP-AMOUNT
    MOVE WS-E TO CP-CURRENCY
    MOVE WS-F TO CP-TXN-TYPE
    MOVE WS-G TO CP-AUTH-ID
    MOVE WS-H TO CP-MERCHANT-ID
    MOVE WS-I TO CP-MCC
    MOVE WS-J TO CP-CHANNEL
    MOVE WS-K TO CP-TXN-DATE
    MOVE WS-L TO CP-CLEAR-DATE
    MOVE WS-M TO CP-EXT-BATCH
    MOVE WS-N TO CP-FEE-AMT
    MOVE WS-O TO CP-SETTLE-CURR
    MOVE WS-P TO CP-SETTLE-AMT
    MOVE WS-Q TO CP-ORIG-CLR-ID
    MOVE WS-R TO CP-OPERATOR
    MOVE WS-S TO CP-CORR
    MOVE WS-T TO CP-REQUEST
    IF WS-F = "REVERSAL" AND WS-G(1:1) = "Y"
        MOVE WS-G TO CP-ORIG-CLR-ID
        MOVE SPACES TO CP-AUTH-ID
    END-IF
    CALL "CCRCI" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-CLR.

DO-MATCH.
    MOVE "CLEARING-MATCH" TO CP-OP
    MOVE WS-A TO CP-CLR-ID
    MOVE WS-B TO CP-OPERATOR
    MOVE WS-C TO CP-CORR
    MOVE WS-D TO CP-REQUEST
    CALL "CCRCM" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-CLR.

DO-POST.
    MOVE "CLEARING-POST" TO CP-OP
    MOVE WS-A TO CP-CLR-ID
    MOVE WS-B TO CP-FORCE
    MOVE WS-C TO CP-OPERATOR
    MOVE WS-D TO CP-CORR
    MOVE WS-E TO CP-REQUEST
    CALL "CCRCP" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-CLR.

DO-GET.
    MOVE "CLEARING-GET" TO CP-OP
    MOVE WS-A TO CP-CLR-ID
    CALL "CCRCI" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-CLR.

DO-STATUS.
    MOVE "CLEARING-STATUS" TO CP-OP
    MOVE WS-A TO CP-CLR-ID
    MOVE WS-B TO CP-STATUS
    MOVE WS-C TO CP-OPERATOR
    MOVE WS-D TO CP-CORR
    MOVE WS-E TO CP-REQUEST
    CALL "CCRCI" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-CLR.

DO-SETTLE-BUILD.
    MOVE "SETTLE-BUILD" TO CP-OP
    MOVE WS-A TO CP-SOURCE
    MOVE WS-B TO CP-CURRENCY
    MOVE WS-C TO CP-COUNT
    MOVE WS-D TO CP-SETTLE-AMT
    MOVE WS-E TO CP-OPERATOR
    MOVE WS-F TO CP-CORR
    MOVE WS-G TO CP-REQUEST
    CALL "CCRCS" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-SETTLE.

DO-SETTLE-CHECK.
    MOVE "SETTLE-CHECK" TO CP-OP
    MOVE WS-A TO CP-SETTLE-BATCH
    MOVE WS-B TO CP-OPERATOR
    CALL "CCRCS" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-SETTLE.

DO-SETTLE-MARK.
    MOVE "SETTLE-MARK" TO CP-OP
    MOVE WS-A TO CP-SETTLE-BATCH
    MOVE WS-B TO CP-OPERATOR
    MOVE WS-C TO CP-CORR
    MOVE WS-D TO CP-REQUEST
    CALL "CCRCS" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-SETTLE.

DO-SETTLE-GET.
    MOVE "SETTLE-GET" TO CP-OP
    MOVE WS-A TO CP-SETTLE-BATCH
    CALL "CCRCS" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-SETTLE.

DO-EXC-GET.
    MOVE "EXCEPTION-GET" TO CP-OP
    MOVE WS-A TO CP-EXC-ID
    CALL "CCRCE" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-EXC.

DO-EXC-LIST.
    MOVE "EXCEPTION-LIST" TO CP-OP
    MOVE WS-A TO CP-STATUS
    CALL "CCRCE" USING BK-CCRD-CLR-PARMS
    DISPLAY "rc=" CP-RC
    DISPLAY "count=" CP-COUNT
    DISPLAY "last=" FUNCTION TRIM(CP-EXC-ID).

DO-EXC-RESOLVE.
    MOVE "EXCEPTION-RESOLVE" TO CP-OP
    MOVE WS-A TO CP-EXC-ID
    MOVE WS-B TO CP-REASON
    MOVE WS-C TO CP-OPERATOR
    MOVE WS-D TO CP-CORR
    CALL "CCRCE" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-EXC.

DO-EXC-RETRY.
    MOVE "EXCEPTION-RETRY" TO CP-OP
    MOVE WS-A TO CP-EXC-ID
    MOVE WS-B TO CP-OPERATOR
    MOVE WS-C TO CP-CORR
    CALL "CCRCE" USING BK-CCRD-CLR-PARMS
    PERFORM SHOW-EXC.

SHOW-CLR.
    DISPLAY "rc=" CP-RC
    DISPLAY "clr=" FUNCTION TRIM(CP-CLR-ID)
    DISPLAY "status=" FUNCTION TRIM(CP-STATUS)
    DISPLAY "match=" FUNCTION TRIM(CP-MATCH-STATUS)
    DISPLAY "post=" FUNCTION TRIM(CP-POST-STATUS)
    DISPLAY "settle=" FUNCTION TRIM(CP-SETTLE-STATUS)
    DISPLAY "recon=" FUNCTION TRIM(CP-RECON-STATUS)
    DISPLAY "auth=" FUNCTION TRIM(CP-AUTH-ID)
    DISPLAY "txn=" FUNCTION TRIM(CP-TXN-ID)
    DISPLAY "batch=" FUNCTION TRIM(CP-SETTLE-BATCH)
    DISPLAY "amount=" CP-AMOUNT
    DISPLAY "authamt=" CP-AUTH-AMOUNT
    DISPLAY "diff=" CP-DIFF-AMOUNT
    DISPLAY "replay=" CP-REPLAY
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

SHOW-SETTLE.
    DISPLAY "rc=" CP-RC
    DISPLAY "batch=" FUNCTION TRIM(CP-SETTLE-BATCH)
    DISPLAY "count=" CP-COUNT
    DISPLAY "amount=" CP-SETTLE-AMT
    DISPLAY "replay=" CP-REPLAY
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).

SHOW-EXC.
    DISPLAY "rc=" CP-RC
    DISPLAY "exc=" FUNCTION TRIM(CP-EXC-ID)
    DISPLAY "clr=" FUNCTION TRIM(CP-CLR-ID)
    DISPLAY "type=" FUNCTION TRIM(CP-MATCH-STATUS)
    DISPLAY "replay=" CP-REPLAY
    DISPLAY "msg=" FUNCTION TRIM(CP-MSG).
