IDENTIFICATION DIVISION.
PROGRAM-ID. CCRCS.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CLR-FILE ASSIGN TO WS-CLR-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CC-ID
        FILE STATUS IS WS-CLR-ST.

DATA DIVISION.
FILE SECTION.
FD CLR-FILE.
01 CLR-REC.
   COPY "CCRC".

WORKING-STORAGE SECTION.
COPY "CCRCSTO".
COPY "CCRSSTO".
COPY "CCREXCSTO".
COPY "CCRDGP".
COPY "CCRASTO".
COPY "BTXNLFC".
COPY "BTXNRESP".
01 BK-CCRD-CLR.
   COPY "CCRC".
01 BK-CCRD-STL.
   COPY "CCRS".
01 BK-TXN-SQ.
   COPY "BTXREC".
01 WS-QRC PIC X(02).
01 WS-QRY-OP PIC X(08).
01 BK-CCRD-EXC-REC.
   COPY "CCREXC".
01 WS-CLR-PATH PIC X(200).
01 WS-CLR-ST PIC X(02).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).
01 WS-EOF PIC X(01).
01 WS-START-FAIL PIC X(01).
01 WS-MEM-ID PIC X(12).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20).
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-IDX PIC X(12).
01 WS-CNT PIC 9(07).
01 WS-SUM PIC S9(15)V99 COMP-3.
01 WS-MAX PIC 9(07) VALUE 500.
01 WS-TBL.
   05 WS-T-ROW OCCURS 500 TIMES.
      10 WS-T-ID PIC X(12).
01 WS-I PIC 9(07).
01 WS-NOW PIC X(14).
01 WS-REQ PIC X(24).
01 WS-EVT PIC X(16).
01 WS-NEXT PIC X(12).
01 WS-RC-T PIC X(02).
01 WS-OP PIC X(12).
01 WS-AUD-BEFORE PIC X(120).
01 WS-AUD-AFTER PIC X(120).
01 WS-A-ENT PIC X(12).
01 WS-A-ACT PIC X(12).
01 WS-MSGT PIC X(80).

LINKAGE SECTION.
COPY "CCRCP".

PROCEDURE DIVISION USING BK-CCRD-CLR-PARMS.
    MOVE "00" TO CP-RC
    MOVE SPACES TO CP-MSG
    MOVE "N" TO CP-REPLAY
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CP-RC
        MOVE "CONFIG MISSING" TO CP-MSG
        GOBACK
    END-IF
    MOVE SPACES TO WS-CLR-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdclr.idx"
        DELIMITED SIZE INTO WS-CLR-PATH
    EVALUATE CP-OP
        WHEN "SETTLE-BUILD" PERFORM DO-BUILD
        WHEN "SETTLE-CHECK" PERFORM DO-CHECK
        WHEN "SETTLE-MARK" PERFORM DO-MARK
        WHEN "SETTLE-GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO CP-RC
            MOVE "UNKNOWN SETTLEMENT OP" TO CP-MSG
    END-EVALUATE
    GOBACK.

DO-GET.
    MOVE CP-SETTLE-BATCH TO CS-ID
    MOVE "GET" TO SS-OP
    CALL "CCRSSTO" USING BK-CCRD-STO-SETTLE BK-CCRD-STL
    IF SS-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "SETTLEMENT BATCH NOT FOUND" TO CP-MSG
    ELSE
        MOVE CS-ID TO CP-SETTLE-BATCH
        MOVE CS-SOURCE TO CP-SOURCE
        MOVE CS-CURRENCY TO CP-CURRENCY
        MOVE CS-DECL-COUNT TO CP-COUNT
        MOVE CS-DECL-AMT TO CP-SETTLE-AMT
        MOVE CS-STATUS TO CP-STATUS
    END-IF
    GOBACK.

DO-BUILD.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "BEGIN" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CARD.SETTLE-BUILD" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    CALL "CCRDG" USING BK-CCRD-GUARD
    IF GD-RC NOT = "00"
        MOVE GD-RC TO CP-RC
        MOVE "REQUEST IN PROGRESS" TO CP-MSG
        GOBACK
    END-IF
    IF GD-HIT = "Y"
        MOVE GD-RESULT(1:12) TO CP-SETTLE-BATCH
        MOVE "Y" TO CP-REPLAY
        MOVE "SETTLEMENT BATCH REPLAY" TO CP-MSG
        GOBACK
    END-IF
    IF CP-CURRENCY = SPACES
        MOVE "20" TO CP-RC
        MOVE "SOURCE AND CURRENCY REQUIRED" TO CP-MSG
        GOBACK
    END-IF
    PERFORM COLLECT-ELIGIBLE
    IF WS-CNT = 0
        MOVE "20" TO CP-RC
        MOVE "NO SETTLEMENT CANDIDATES" TO CP-MSG
        PERFORM GUARD-FAIL
        GOBACK
    END-IF
    MOVE "CARD-SETTLE" TO WS-SEQ-NAME
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CP-RC
        MOVE "SEQUENCE ERROR" TO CP-MSG
        PERFORM GUARD-FAIL
        GOBACK
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO WS-IDX
    STRING "Z" DELIMITED SIZE WS-ID-ED DELIMITED SIZE INTO WS-IDX
    END-STRING
    MOVE SPACES TO BK-CCRD-STL
    MOVE WS-IDX TO CS-ID
    MOVE CP-SOURCE TO CS-SOURCE
    MOVE CP-CURRENCY TO CS-CURRENCY
    MOVE WS-BIZDATE TO CS-BIZDATE
    MOVE WS-BIZDATE TO CS-SETTLE-DATE
    MOVE WS-CNT TO CS-TOTAL-COUNT
    MOVE WS-SUM TO CS-TOTAL-AMT
    IF CP-COUNT > 0
        MOVE CP-COUNT TO CS-DECL-COUNT
    ELSE
        MOVE WS-CNT TO CS-DECL-COUNT
    END-IF
    IF CP-SETTLE-AMT > 0
        MOVE CP-SETTLE-AMT TO CS-DECL-AMT
    ELSE
        MOVE WS-SUM TO CS-DECL-AMT
    END-IF
    MOVE "BUILT" TO CS-STATUS
    MOVE "PENDING" TO CS-RECON-STATUS
    MOVE CP-OPERATOR TO CS-OPERATOR
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO CS-CREATED
    MOVE WS-NOW(1:14) TO CS-UPDATED
    MOVE 1 TO CS-VERSION
    MOVE "WRITE" TO SS-OP
    CALL "CCRSSTO" USING BK-CCRD-STO-SETTLE BK-CCRD-STL
    IF SS-RC NOT = "00"
        MOVE SS-RC TO CP-RC
        MOVE "SETTLEMENT WRITE FAILED" TO CP-MSG
        PERFORM GUARD-FAIL
        GOBACK
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-CNT
        PERFORM TAG-MEMBER
    END-PERFORM
    MOVE CP-SETTLE-BATCH TO CP-MSG
    MOVE WS-IDX TO CP-SETTLE-BATCH
    MOVE "SETTLEMENT BATCH BUILT" TO CP-MSG
    MOVE WS-IDX TO WS-A-ENT
    MOVE "BUILD" TO WS-A-ACT
    MOVE SPACES TO WS-AUD-BEFORE
    MOVE CS-STATUS TO WS-AUD-AFTER
    CALL "CCRCRA" USING BK-CCRD-CLR-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER
    PERFORM GUARD-DONE
    GOBACK.

COLLECT-ELIGIBLE.
    MOVE 0 TO WS-CNT
    MOVE WS-SUM TO WS-SUM
    OPEN I-O CLR-FILE
    IF WS-CLR-ST NOT = "00"
        MOVE "24" TO CP-RC
        MOVE "CLEARING FILE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CLR-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF CC-POST-STATUS OF CLR-REC = "POSTED" AND
                   CC-SETTLE-STATUS OF CLR-REC = "PENDING" AND
                   CC-SOURCE OF CLR-REC = CP-SOURCE AND
                   CC-SETTLE-CURR OF CLR-REC = CP-CURRENCY AND
                   WS-CNT < WS-MAX
                    ADD 1 TO WS-CNT
                    MOVE CC-ID OF CLR-REC TO WS-T-ID(WS-CNT)
                    ADD CC-AMOUNT OF CLR-REC TO WS-SUM
                END-IF
        END-READ
    END-PERFORM
    CLOSE CLR-FILE.

TAG-MEMBER.
    MOVE SPACES TO BK-CCRD-CLR
    MOVE WS-T-ID(WS-I) TO CC-ID OF BK-CCRD-CLR
    MOVE "GET" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-IDX TO CC-SETTLE-BATCH OF BK-CCRD-CLR
    MOVE "BATCHED" TO CC-SETTLE-STATUS OF BK-CCRD-CLR
    MOVE "BATCH" TO WS-EVT
    CALL "CCRCST" USING CC-STATUS OF BK-CCRD-CLR WS-EVT
        WS-NEXT WS-RC-T WS-MSGT
    IF WS-RC-T = "00"
        MOVE WS-NEXT TO CC-STATUS OF BK-CCRD-CLR
    END-IF
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO CC-UPDATED OF BK-CCRD-CLR
    ADD 1 TO CC-VERSION OF BK-CCRD-CLR
    MOVE "REWRITE" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR.

GUARD-FAIL.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "END" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CARD.SETTLE-BUILD" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    MOVE CP-RC TO GD-RC
    MOVE CP-MSG TO GD-RESULT
    CALL "CCRDG" USING BK-CCRD-GUARD.

GUARD-DONE.
    MOVE SPACES TO BK-CCRD-GUARD
    MOVE "END" TO GD-OP
    MOVE CP-REQUEST TO GD-REQUEST
    MOVE "CARD.SETTLE-BUILD" TO GD-OPERATION
    MOVE CP-OPERATOR TO GD-OPERATOR
    MOVE "00" TO GD-RC
    MOVE CP-SETTLE-BATCH TO GD-RESULT(1:12)
    CALL "CCRDG" USING BK-CCRD-GUARD.

DO-CHECK.
    MOVE CP-SETTLE-BATCH TO CS-ID
    MOVE "GET" TO SS-OP
    CALL "CCRSSTO" USING BK-CCRD-STO-SETTLE BK-CCRD-STL
    IF SS-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "SETTLEMENT BATCH NOT FOUND" TO CP-MSG
        GOBACK
    END-IF
    MOVE CS-DECL-COUNT TO WS-AUD-BEFORE
    PERFORM RECOMPUTE-MEMBERS
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    IF WS-CNT = CS-DECL-COUNT AND WS-SUM = CS-DECL-AMT
        MOVE "BALANCED" TO CS-STATUS
        MOVE "SETTLEMENT BATCH BALANCED" TO CP-MSG
    ELSE
        MOVE "MISMATCH" TO CS-STATUS
        MOVE "20" TO CP-RC
        MOVE "BATCH MISMATCH" TO CP-MSG
        PERFORM OPEN-BATCH-EXCEPTION
    END-IF
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO CS-UPDATED
    ADD 1 TO CS-VERSION
    MOVE "REWRITE" TO SS-OP
    CALL "CCRSSTO" USING BK-CCRD-STO-SETTLE BK-CCRD-STL
    MOVE CP-CLR-ID TO WS-A-ENT
    MOVE CS-STATUS TO WS-AUD-AFTER
    MOVE WS-IDX TO WS-A-ENT
    MOVE "CHECK" TO WS-A-ACT
    CALL "CCRCRA" USING BK-CCRD-CLR-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER
    GOBACK.

RECOMPUTE-MEMBERS.
    MOVE 0 TO WS-CNT
    MOVE 0 TO WS-SUM
    OPEN INPUT CLR-FILE
    IF WS-CLR-ST NOT = "00"
        MOVE "24" TO CP-RC
        MOVE "CLEARING FILE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CLR-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-CLR-ST = "00" AND
                   CC-SETTLE-BATCH OF CLR-REC =
                   CP-SETTLE-BATCH
                    ADD 1 TO WS-CNT
                    ADD CC-AMOUNT OF CLR-REC TO WS-SUM
                END-IF
        END-READ
    END-PERFORM
    CLOSE CLR-FILE
    MOVE WS-CNT TO CP-COUNT
    MOVE WS-SUM TO CP-SETTLE-AMT.

DO-MARK.
    MOVE CP-SETTLE-BATCH TO CS-ID
    MOVE "GET" TO SS-OP
    CALL "CCRSSTO" USING BK-CCRD-STO-SETTLE BK-CCRD-STL
    IF SS-RC NOT = "00"
        MOVE "23" TO CP-RC
        MOVE "SETTLEMENT BATCH NOT FOUND" TO CP-MSG
        GOBACK
    END-IF
    IF CS-STATUS = "SETTLED"
        MOVE "Y" TO CP-REPLAY
        MOVE "SETTLEMENT REPLAY" TO CP-MSG
        GOBACK
    END-IF
    IF CS-STATUS = "MISMATCH"
        MOVE "20" TO CP-RC
        MOVE "BATCH NOT BALANCED" TO CP-MSG
        GOBACK
    END-IF
    PERFORM SETTLE-MEMBERS
    IF CP-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "SETTLED" TO CS-STATUS
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO CS-UPDATED
    ADD 1 TO CS-VERSION
    MOVE "REWRITE" TO SS-OP
    CALL "CCRSSTO" USING BK-CCRD-STO-SETTLE BK-CCRD-STL
    MOVE CP-SETTLE-BATCH TO WS-A-ENT
    MOVE "SETTLED" TO WS-AUD-AFTER
    MOVE "DONE" TO WS-A-ACT
    CALL "CCRCRA" USING BK-CCRD-CLR-PARMS WS-A-ENT WS-A-ACT
        WS-AUD-BEFORE WS-AUD-AFTER
    MOVE "SETTLEMENT DONE" TO CP-MSG
    GOBACK.

SETTLE-MEMBERS.
    MOVE SPACES TO WS-AUD-BEFORE
    OPEN INPUT CLR-FILE
    IF WS-CLR-ST NOT = "00"
        MOVE "24" TO CP-RC
        MOVE "CLEARING FILE ERROR" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CLR-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                IF WS-CLR-ST = "00" AND
                   CC-SETTLE-BATCH OF CLR-REC =
                   CP-SETTLE-BATCH
                    MOVE CC-ID OF CLR-REC TO WS-MEM-ID
                    PERFORM SETTLE-ONE
                END-IF
        END-READ
    END-PERFORM
    CLOSE CLR-FILE
    IF WS-CLR-ST NOT = "00" AND WS-CLR-ST NOT = "10"
        MOVE "24" TO CP-RC
        MOVE "CLEARING SCAN FAILED" TO CP-MSG
    END-IF.

SKIP-IF-SETTLED.
    MOVE "GET" TO WS-QRY-OP
    CALL "BTXNQRY" USING WS-QRY-OP WS-IDX BK-TXN-SQ WS-QRC
    IF WS-QRC = "00" AND TXN-STATUS OF BK-TXN-SQ NOT = "PO"
        MOVE SPACES TO WS-IDX
    END-IF.

SETTLE-ONE.
    MOVE SPACES TO BK-CCRD-CLR
    MOVE WS-MEM-ID TO CC-ID OF BK-CCRD-CLR
    MOVE "GET" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE "24" TO CP-RC
        MOVE "CLEARING LOAD FAILED" TO CP-MSG
        EXIT PARAGRAPH
    END-IF
    IF CC-SETTLE-STATUS OF BK-CCRD-CLR NOT = "BATCHED"
        EXIT PARAGRAPH
    END-IF
    MOVE CC-TXN-ID OF BK-CCRD-CLR TO WS-IDX
    IF WS-IDX NOT = SPACES
        PERFORM SKIP-IF-SETTLED
    END-IF
    IF WS-IDX NOT = SPACES
        MOVE SPACES TO BK-TXN-LFC-REQ
        MOVE "SETTLE" TO LFC-OP
        MOVE WS-IDX TO LFC-TXN-ID
        MOVE CP-OPERATOR TO LFC-OPERATOR
        MOVE CP-CORR TO LFC-CORR
        STRING "KTS-" DELIMITED SIZE WS-MEM-ID DELIMITED SIZE
            INTO LFC-REQUEST
        END-STRING
        CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
        IF TXR-RC NOT = "00"
            MOVE TXR-RC TO CP-RC
            MOVE TXR-MSG TO CP-MSG
            EXIT PARAGRAPH
        END-IF
    END-IF
    MOVE "SETTLE" TO WS-EVT
    CALL "CCRCST" USING CC-STATUS OF BK-CCRD-CLR WS-EVT
        WS-NEXT WS-RC-T WS-MSGT
    IF WS-RC-T = "00"
        MOVE WS-NEXT TO CC-STATUS OF BK-CCRD-CLR
    END-IF
    MOVE "SETTLED" TO CC-SETTLE-STATUS OF BK-CCRD-CLR
    MOVE FUNCTION CURRENT-DATE TO WS-NOW
    MOVE WS-NOW(1:14) TO CC-UPDATED OF BK-CCRD-CLR
    ADD 1 TO CC-VERSION OF BK-CCRD-CLR
    MOVE "REWRITE" TO SC-OP
    CALL "CCRCSTO" USING BK-CCRD-STO-CLR BK-CCRD-CLR
    IF SC-RC NOT = "00"
        MOVE SC-RC TO CP-RC
    END-IF.

OPEN-BATCH-EXCEPTION.
    MOVE SPACES TO BK-CCRD-EXC-REC
    MOVE CP-SETTLE-BATCH TO EX-CLR-ID
    MOVE "BATCH-MISMATCH" TO EX-TYPE
    MOVE "FIND-OPEN" TO SX-OP
    CALL "CCREXCSTO" USING BK-CCRD-STO-EXC BK-CCRD-EXC-REC
    IF SX-RC NOT = "00"
        MOVE "CARD-CEXEC" TO WS-SEQ-NAME
        CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
        IF WS-SEQ-ST = "00"
            MOVE WS-SEQ TO WS-ID-NUM
            MOVE WS-ID-NUM TO WS-ID-ED
            MOVE SPACES TO WS-IDX
            STRING "O" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
                INTO WS-IDX
            END-STRING
            MOVE SPACES TO BK-CCRD-EXC-REC
            MOVE WS-IDX TO EX-ID
            MOVE "BATCH-MISMATCH" TO EX-TYPE
            MOVE CP-SETTLE-BATCH TO EX-CLR-ID
            MOVE CP-SOURCE TO EX-SOURCE
            MOVE "OPEN" TO EX-STATUS
            STRING "ACTUAL=" DELIMITED SIZE WS-CNT
                DELIMITED SIZE " DECLARED=" DELIMITED SIZE
                CS-DECL-COUNT DELIMITED SIZE INTO EX-REASON
            END-STRING
            MOVE CP-OPERATOR TO EX-OPERATOR
            MOVE WS-BIZDATE TO EX-BIZDATE
            MOVE FUNCTION CURRENT-DATE TO WS-NOW
            MOVE WS-NOW(1:14) TO EX-CREATED
            MOVE "WRITE" TO SX-OP
            CALL "CCREXCSTO" USING
                BK-CCRD-STO-EXC BK-CCRD-EXC-REC
        END-IF
    END-IF.
