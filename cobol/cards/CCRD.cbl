IDENTIFICATION DIVISION.
PROGRAM-ID. CCRD.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "CCRDSTO".
COPY "CCRDQP".
01 BK-CCRD-CARD.
   COPY "CCRD".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-HOME PIC X(80).

LINKAGE SECTION.
COPY "CCRDP".

PROCEDURE DIVISION USING BK-CCRD-PARMS.
    MOVE "00" TO CK-RC
    MOVE SPACES TO CK-MSG
    MOVE "N" TO CK-REPLAY
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CK-RC
        MOVE "CONFIG MISSING" TO CK-MSG
        GOBACK
    END-IF
    EVALUATE CK-OP
        WHEN "REGISTER" PERFORM CALL-REG
        WHEN "GET" PERFORM DO-GET
        WHEN "LIST" PERFORM DO-LIST
        WHEN OTHER PERFORM CALL-ACT
    END-EVALUATE
    GOBACK.

CALL-REG.
    CALL "CCRDREG" USING BK-CCRD-PARMS
    GOBACK.

CALL-ACT.
    CALL "CCRDACT" USING BK-CCRD-PARMS
    GOBACK.

DO-GET.
    PERFORM LOAD-CARD
    IF CK-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM EXPOSE-CARD
    GOBACK.

DO-LIST.
    MOVE SPACES TO BK-CCRD-LIST
    MOVE "CARDS" TO QL-OP
    IF CK-CUST-ID NOT = SPACES
        MOVE CK-CUST-ID TO QL-CUST
    END-IF
    IF CK-STATUS NOT = SPACES
        MOVE CK-STATUS TO QL-FSTAT
    END-IF
    IF CK-FACILITY NOT = SPACES
        MOVE CK-FACILITY TO QL-FACILITY
    END-IF
    IF CK-ACCOUNT NOT = SPACES
        MOVE CK-ACCOUNT TO QL-ACCOUNT
    END-IF
    CALL "CCRDLST" USING BK-CCRD-LIST
    MOVE QL-RC TO CK-RC
    MOVE QL-COUNT TO CK-COUNT
    GOBACK.

LOAD-CARD.
    MOVE SPACES TO BK-CCRD-CARD
    MOVE CK-CARD-ID TO CN-ID
    MOVE "GET" TO ST-OP
    CALL "CCRDSTO" USING BK-CCRD-STO-REQ BK-CCRD-CARD
    IF ST-RC NOT = "00"
        MOVE "23" TO CK-RC
        MOVE "CARD NOT FOUND" TO CK-MSG
    END-IF.

EXPOSE-CARD.
    MOVE CN-ID TO CK-CARD-ID
    MOVE CN-CUST-ID TO CK-CUST-ID
    MOVE CN-PRODUCT TO CK-PRODUCT
    MOVE CN-KIND TO CK-KIND
    MOVE CN-ACCOUNT TO CK-ACCOUNT
    MOVE CN-FACILITY TO CK-FACILITY
    MOVE CN-STATUS TO CK-STATUS
    MOVE CN-CURRENCY TO CK-CURRENCY
    MOVE CN-MASKED TO CK-MASKED
    MOVE CN-NETWORK TO CK-NETWORK
    MOVE CN-NET-REF TO CK-NET-REF
    MOVE CN-TOKEN TO CK-TOKEN
    MOVE CN-PIN-SET TO CK-PIN-SET
    MOVE CN-ISSUE-DATE TO CK-ISSUE-DATE
    MOVE CN-ACTIVE-DATE TO CK-ACTIVE-DATE
    MOVE CN-EXP-DATE TO CK-EXP-DATE
    MOVE CN-CANCEL-DATE TO CK-CANCEL-DATE
    MOVE CN-PREV-CARD TO CK-PREV-CARD
    MOVE CN-NEXT-CARD TO CK-NEXT-CARD
    MOVE CN-DESCRIPTION TO CK-DESCRIPTION
    MOVE CN-REASON TO CK-REASON.
