IDENTIFICATION DIVISION.
PROGRAM-ID. CCRMSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT MATCH-FILE ASSIGN TO WS-M-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CM-ID OF MATCH-REC
        FILE STATUS IS WS-M-ST.

DATA DIVISION.
FILE SECTION.
FD MATCH-FILE.
01 MATCH-REC.
   COPY "CCRM".

WORKING-STORAGE SECTION.
01 WS-M-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-M-ST PIC X(02).

LINKAGE SECTION.
COPY "CCRMSTO".
01 BK-CCRD-MATCH.
   COPY "CCRM".

PROCEDURE DIVISION USING BK-CCRD-STO-MATCH BK-CCRD-MATCH.
    MOVE "00" TO SM-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-M-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crdclrm.idx"
        DELIMITED SIZE INTO WS-M-PATH
    OPEN I-O MATCH-FILE
    IF WS-M-ST = "35"
        OPEN OUTPUT MATCH-FILE
        CLOSE MATCH-FILE
        OPEN I-O MATCH-FILE
    END-IF
    IF WS-M-ST NOT = "00"
        MOVE WS-M-ST TO SM-RC
        GOBACK
    END-IF
    EVALUATE SM-OP
        WHEN "WRITE"
            MOVE BK-CCRD-MATCH TO MATCH-REC
            WRITE MATCH-REC
                INVALID KEY MOVE "22" TO SM-RC
            END-WRITE
        WHEN "GET"
            MOVE CM-ID OF BK-CCRD-MATCH TO CM-ID OF MATCH-REC
            READ MATCH-FILE
            IF WS-M-ST = "00"
                MOVE MATCH-REC TO BK-CCRD-MATCH
            ELSE
                MOVE "23" TO SM-RC
            END-IF
        WHEN OTHER
            MOVE "99" TO SM-RC
    END-EVALUATE
    CLOSE MATCH-FILE
    GOBACK.
