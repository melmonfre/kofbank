IDENTIFICATION DIVISION.
PROGRAM-ID. BXTP.

*> Transport adapter contract (GATE 3).  The core calls send/query through
*> this boundary; the boundary routes to a configured adapter.  Only the
*> deterministic local double exists today.  Network/MQ implementations
*> must implement the same contract without touching the core.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-SEAM PIC X(24).
01 WS-KTYPE PIC X(06).
01 WS-KVAL PIC X(32).
01 WS-CNT-AT PIC 9(04).
COPY "BPXSP".
COPY "BPXDP".
COPY "BPXCFG".
01 WS-ENV-CHK PIC X(16).

LINKAGE SECTION.
COPY "BKBNDP".

PROCEDURE DIVISION USING BK-BND-PARMS.
    MOVE "00" TO BD-RC
    MOVE SPACES TO BD-MSG BD-OUTCOME BD-EXT-REF BD-CLASS
        BD-RETRYABLE BD-CORRELATE
    ACCEPT WS-SEAM FROM ENVIRONMENT "KOF_BND_SEAM"
    CALL "BPXCFG" USING BK-PX-CFG
    MOVE PC-ENVIRONMENT TO WS-ENV-CHK
    PERFORM GUARD-ENV
    IF BD-RC NOT = "00"
        GOBACK    END-IF
    IF BD-CHANNEL = SPACES
        MOVE "20" TO BD-RC
        MOVE "CHANNEL REQUIRED" TO BD-MSG
        GOBACK
    END-IF
    IF FUNCTION TRIM(BD-OP) = "SEND"
        PERFORM DO-SEND
    ELSE
        IF FUNCTION TRIM(BD-OP) = "QUERY"
            PERFORM DO-QUERY
        ELSE
            MOVE "20" TO BD-RC
            MOVE "UNKNOWN TRANSPORT OP" TO BD-MSG
        END-IF
    END-IF
    PERFORM CLASSIFY
    GOBACK.

DO-SEND.
    IF WS-SEAM = "TP-BEFORE-SEND"
        MOVE "09" TO BD-RC
        MOVE "SIMULATED TRANSPORT CRASH BEFORE SEND" TO BD-MSG
        MOVE "TPERR" TO BD-CLASS
        MOVE "Y" TO BD-RETRYABLE
        GOBACK
    END-IF
    PERFORM ROUTE-SUBMIT
    IF WS-SEAM = "TP-AFTER-SEND" AND BD-RC = "00"
        MOVE "24" TO BD-RC
        MOVE "SIMULATED CRASH AFTER SEND OUTCOME UNKNOWN"
            TO BD-MSG
        MOVE "UNKNOWN" TO BD-OUTCOME
        MOVE SPACES TO BD-EXT-REF
    END-IF.

DO-QUERY.
    IF BD-CHANNEL = "SPI"
        MOVE "STL-QUERY" TO SI-OP
        MOVE BD-ADAPTER TO SI-ADAPTER
        MOVE BD-E2E-ID TO SI-E2E-ID
        MOVE BD-EXT-REF TO SI-EXT-REF
        CALL "BPXSPI" USING BK-PX-SPI-PARMS
        MOVE SI-RESULT TO BD-OUTCOME
        MOVE SI-EXT-REF TO BD-EXT-REF
        MOVE SI-RC TO BD-RC
        MOVE SI-MSG TO BD-MSG
    ELSE
        MOVE "20" TO BD-RC
        MOVE "QUERY UNSUPPORTED FOR CHANNEL" TO BD-MSG
    END-IF.

ROUTE-SUBMIT.
    EVALUATE FUNCTION TRIM(BD-CHANNEL)
        WHEN "SPI" PERFORM SPI-SUBMIT
        WHEN "DICT" PERFORM DICT-SUBMIT
        WHEN OTHER
            MOVE "20" TO BD-RC
            MOVE "UNKNOWN TRANSPORT CHANNEL" TO BD-MSG
    END-EVALUATE.

SPI-SUBMIT.
    MOVE SPACES TO BK-PX-SPI-PARMS
    MOVE BD-ADAPTER TO SI-ADAPTER
    IF FUNCTION TRIM(BD-OP-KIND) = "STL"
        MOVE "STL-SUBMIT" TO SI-OP
        MOVE BD-E2E-ID TO SI-E2E-ID
    ELSE
        MOVE "PAY-SUBMIT" TO SI-OP
        MOVE BD-E2E-ID TO SI-E2E-ID
    END-IF
    MOVE BD-AMOUNT TO SI-AMOUNT
    MOVE BD-CURRENCY TO SI-CURRENCY
    MOVE BD-SIM TO SI-SIM
    CALL "BPXSPI" USING BK-PX-SPI-PARMS
    MOVE SI-RESULT TO BD-OUTCOME
    MOVE SI-EXT-REF TO BD-EXT-REF
    MOVE SI-RC TO BD-RC
    MOVE SI-MSG TO BD-MSG.

DICT-SUBMIT.
    PERFORM INFER-KEY-TYPE
    MOVE SPACES TO BK-PX-DICT-PARMS
    MOVE BD-ADAPTER TO DT-ADAPTER
    MOVE BD-FAMILY TO DT-OP
    MOVE WS-KTYPE TO DT-KEY-TYPE
    MOVE BD-MSG-ID TO DT-KEY-VALUE
    MOVE BD-SIM TO DT-SIM
    CALL "BPXDICT" USING BK-PX-DICT-PARMS
    MOVE SPACES TO BD-OUTCOME
    IF DT-KEY-STATUS NOT = SPACES
        MOVE DT-KEY-STATUS TO BD-OUTCOME
        MOVE DT-KEY-ID TO BD-EXT-REF
    END-IF
    IF DT-CLAIM-STATUS NOT = SPACES
        MOVE DT-CLAIM-STATUS TO BD-OUTCOME
        MOVE DT-CLAIM-ID TO BD-EXT-REF
    END-IF
    IF BD-OUTCOME = SPACES
        MOVE DT-REPLAY TO BD-OUTCOME
    END-IF
    MOVE DT-RC TO BD-RC
    MOVE DT-MSG TO BD-MSG.

INFER-KEY-TYPE.
    MOVE SPACES TO WS-KTYPE WS-KVAL
    MOVE BD-MSG-ID TO WS-KVAL
    MOVE 0 TO WS-CNT-AT
    INSPECT WS-KVAL TALLYING WS-CNT-AT FOR ALL "@"
    IF WS-CNT-AT > 0
        MOVE "EMAIL" TO WS-KTYPE
    ELSE
        IF FUNCTION LENGTH(FUNCTION TRIM(WS-KVAL)) = 11
            MOVE "CPF" TO WS-KTYPE
        ELSE
            IF FUNCTION LENGTH(FUNCTION TRIM(WS-KVAL)) = 14
                MOVE "CNPJ" TO WS-KTYPE
            ELSE
                MOVE "RANDOM" TO WS-KTYPE
            END-IF
        END-IF
    END-IF.

GUARD-ENV.
    IF WS-ENV-CHK = "PRODUCTION"
        MOVE "20" TO BD-RC
        MOVE "PRODUCTION TRANSPORT ADAPTER NOT INSTALLED"
            TO BD-MSG
        MOVE "TPERR" TO BD-CLASS
        GOBACK
    END-IF
    IF WS-ENV-CHK NOT = "LOCAL_DOUBLE" AND
       WS-ENV-CHK NOT = "QA"
        MOVE "20" TO BD-RC
        MOVE "ENVIRONMENT UNKNOWN OR MISSING" TO BD-MSG
        MOVE "TPERR" TO BD-CLASS
    END-IF.

CLASSIFY.
    MOVE "N" TO BD-RETRYABLE
    MOVE "N" TO BD-CORRELATE
    EVALUATE FUNCTION TRIM(BD-OUTCOME)
        WHEN "SUBMITTED"
            MOVE "OK" TO BD-CLASS
            MOVE "00" TO BD-RC
        WHEN "ACCEPTED"
            MOVE "OK" TO BD-CLASS
            MOVE "00" TO BD-RC
        WHEN "SETTLED"
            MOVE "OK" TO BD-CLASS
            MOVE "00" TO BD-RC
        WHEN "RESOLVED"
            MOVE "OK" TO BD-CLASS
            MOVE "00" TO BD-RC
        WHEN "NOTIF"
            MOVE "OK" TO BD-CLASS
            MOVE "00" TO BD-RC
        WHEN "REJECTED"
            MOVE "RJCT" TO BD-CLASS
            MOVE "20" TO BD-RC
        WHEN "FAILED"
            MOVE "RJCT" TO BD-CLASS
            MOVE "20" TO BD-RC
        WHEN "TIMEOUT"
            MOVE "UNK" TO BD-CLASS
            MOVE "24" TO BD-RC
            MOVE "Y" TO BD-CORRELATE
        WHEN "UNKNOWN"
            MOVE "UNK" TO BD-CLASS
            MOVE "24" TO BD-RC
            MOVE "Y" TO BD-CORRELATE
        WHEN OTHER
            IF BD-RC = "00"
                MOVE "OK" TO BD-CLASS
            END-IF
    END-EVALUATE
    IF BD-CLASS = SPACES AND BD-RC = "09"
        MOVE "TPERR" TO BD-CLASS
        MOVE "Y" TO BD-RETRYABLE
    END-IF.
