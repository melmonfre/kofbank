IDENTIFICATION DIVISION.
PROGRAM-ID. BBNDCLI.

*> Production boundary CLI adapter (GATE 3).  Thin translation from
*> pipe-delimited request lines to the boundary parameter blocks.
*> No financial rule and no transport implementation lives here.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BKBNDP".
COPY "BKCFTP".
COPY "BKMIDP".
01 WS-OP PIC X(20).
01 WS-A PIC X(60).
01 WS-B PIC X(60).
01 WS-C PIC X(60).
01 WS-D PIC X(60).
01 WS-E PIC X(60).
01 WS-F PIC X(60).
01 WS-G PIC X(60).
01 WS-H PIC X(60).
01 WS-I PIC X(60).
01 WS-J PIC X(60).
01 WS-K PIC X(60).
01 WS-L PIC X(200).
01 WS-M PIC X(500).
01 WS-N PIC X(500).
01 WS-F1 PIC X(500).
01 WS-F2 PIC X(500).
01 WS-F3 PIC X(500).
01 WS-F4 PIC X(500).
01 WS-F5 PIC X(500).
01 WS-F6 PIC X(500).
01 WS-F7 PIC X(500).
01 WS-F8 PIC X(500).
01 WS-F9 PIC X(500).
01 WS-F10 PIC X(500).
01 WS-F11 PIC X(500).
01 WS-F12 PIC X(500).
01 WS-F13 PIC X(500).
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-P2000 PIC X(2000).
01 WS-S64 PIC X(64).
01 WS-PIPES PIC 9(02).
01 WS-SCN PIC 9(04).
01 WS-PTR PIC S9(09) COMP-5 VALUE 1.

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H
        WS-I WS-J WS-K WS-L WS-M WS-N WS-F1 WS-F2 WS-F3 WS-F4
        WS-F5 WS-F6 WS-F7 WS-F8 WS-F9 WS-F10 WS-F11 WS-F12
        WS-F13
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H WS-I
        WS-J WS-K WS-L WS-M WS-N WS-F1 WS-F2 WS-F3 WS-F4 WS-F5
        WS-F6 WS-F7 WS-F8 WS-F9 WS-F10 WS-F11 WS-F12 WS-F13
    END-UNSTRING
    MOVE SPACES TO BK-BND-PARMS
    MOVE SPACES TO BK-CRT-PARMS
    EVALUATE FUNCTION TRIM(WS-OP)
        WHEN "cert.register" PERFORM DO-CERT-REG
        WHEN "cert.check" PERFORM DO-CERT-CHECK
        WHEN "cert.rotate" PERFORM DO-CERT-ROTATE
        WHEN "cert.revoke" PERFORM DO-CERT-REVOKE
        WHEN "cert.list" PERFORM DO-CERT-LIST
        WHEN "cert.sign" PERFORM DO-CERT-SIGN
        WHEN "cert.verify" PERFORM DO-CERT-VERIFY
        WHEN "outbox.add" PERFORM DO-OB-ADD
        WHEN "outbox.process" PERFORM DO-OB-PROCESS
        WHEN "outbox.query" PERFORM DO-OB-QUERY
        WHEN "outbox.correlate" PERFORM DO-OB-CORRELATE
        WHEN "outbox.reap" PERFORM DO-OB-REAP
        WHEN "outbox.get" PERFORM DO-OB-GET
        WHEN "outbox.list" PERFORM DO-OB-LIST
        WHEN "tp.send" PERFORM DO-TP-SEND
        WHEN "tp.query" PERFORM DO-TP-QUERY
        WHEN "inbound" PERFORM DO-INBOUND
        WHEN "msgid.get" PERFORM DO-MSGID-GET
        WHEN "msgid.list" PERFORM DO-MSGID-LIST
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN BOUNDARY OP"
    END-EVALUATE
    GOBACK.

DO-CERT-REG.
    MOVE "REG" TO CT-OP
    MOVE WS-A TO CT-ID
    MOVE WS-B TO CT-SUBJECT
    MOVE WS-C TO CT-ISSUER
    MOVE WS-D TO CT-PURPOSE
    MOVE WS-E TO CT-ENV
    MOVE WS-F TO CT-STATE
    MOVE WS-G TO CT-FROM
    MOVE WS-H TO CT-UNTIL
    CALL "BSEC" USING BK-CRT-PARMS WS-P2000 WS-S64
    PERFORM SHOW-CERT.

DO-CERT-CHECK.
    MOVE "CHECK" TO CT-OP
    MOVE WS-A TO CT-ID
    CALL "BSEC" USING BK-CRT-PARMS WS-P2000 WS-S64
    PERFORM SHOW-CERT.

DO-CERT-ROTATE.
    MOVE "ROTATE" TO CT-OP
    MOVE WS-A TO CT-ID
    MOVE WS-B TO CT-NEW-ID
    CALL "BSEC" USING BK-CRT-PARMS WS-P2000 WS-S64
    PERFORM SHOW-CERT.

DO-CERT-REVOKE.
    MOVE "REVOKE" TO CT-OP
    MOVE WS-A TO CT-ID
    CALL "BSEC" USING BK-CRT-PARMS WS-P2000 WS-S64
    PERFORM SHOW-CERT.

DO-CERT-LIST.
    MOVE "LIST" TO CT-OP
    CALL "BSEC" USING BK-CRT-PARMS WS-P2000 WS-S64
    DISPLAY "rc=" CT-RC
    DISPLAY "count=" CT-COUNT.

DO-CERT-SIGN.
    MOVE "SIGN" TO CT-OP
    MOVE WS-A TO CT-ID
    MOVE SPACES TO WS-P2000
    MOVE 1 TO WS-PTR
    STRING FUNCTION TRIM(WS-B) DELIMITED SIZE
        INTO WS-P2000 POINTER WS-PTR
    END-STRING
    IF WS-C NOT = SPACES
        STRING "|" DELIMITED SIZE FUNCTION TRIM(WS-C)
            DELIMITED SIZE INTO WS-P2000 POINTER WS-PTR
        END-STRING
    END-IF
    IF WS-D NOT = SPACES
        STRING "|" DELIMITED SIZE FUNCTION TRIM(WS-D)
            DELIMITED SIZE INTO WS-P2000 POINTER WS-PTR
        END-STRING
    END-IF
    IF WS-E NOT = SPACES
        STRING "|" DELIMITED SIZE FUNCTION TRIM(WS-E)
            DELIMITED SIZE INTO WS-P2000 POINTER WS-PTR
        END-STRING
    END-IF
    CALL "BSEC" USING BK-CRT-PARMS WS-P2000 WS-S64
    DISPLAY "rc=" CT-RC
    DISPLAY "sig=" FUNCTION TRIM(WS-S64)
    DISPLAY "msg=" FUNCTION TRIM(CT-MSG).

DO-CERT-VERIFY.
    MOVE "VERIFY" TO CT-OP
    MOVE WS-A TO CT-ID
    MOVE SPACES TO WS-P2000 WS-S64
    MOVE 1 TO WS-PTR
    STRING FUNCTION TRIM(WS-B) DELIMITED SIZE
        INTO WS-P2000 POINTER WS-PTR
    END-STRING
    IF WS-C(1:4) NOT = "SIG-" AND WS-C NOT = SPACES
        STRING "|" DELIMITED SIZE FUNCTION TRIM(WS-C)
            DELIMITED SIZE INTO WS-P2000 POINTER WS-PTR
        END-STRING
    END-IF
    IF WS-D(1:4) NOT = "SIG-" AND WS-D NOT = SPACES
        STRING "|" DELIMITED SIZE FUNCTION TRIM(WS-D)
            DELIMITED SIZE INTO WS-P2000 POINTER WS-PTR
        END-STRING
    END-IF
    IF WS-E(1:4) NOT = "SIG-" AND WS-E NOT = SPACES
        STRING "|" DELIMITED SIZE FUNCTION TRIM(WS-E)
            DELIMITED SIZE INTO WS-P2000 POINTER WS-PTR
        END-STRING
    END-IF
    IF WS-C(1:4) = "SIG-"
        MOVE WS-C TO WS-S64
    ELSE
        IF WS-D(1:4) = "SIG-"
            MOVE WS-D TO WS-S64
        ELSE
            IF WS-E(1:4) = "SIG-"
                MOVE WS-E TO WS-S64
            ELSE
                MOVE WS-F TO WS-S64
            END-IF
        END-IF
    END-IF
    CALL "BSEC" USING BK-CRT-PARMS WS-P2000 WS-S64
    DISPLAY "rc=" CT-RC
    DISPLAY "msg=" FUNCTION TRIM(CT-MSG).

SHOW-CERT.
    DISPLAY "rc=" CT-RC
    DISPLAY "state=" FUNCTION TRIM(CT-STATE)
    DISPLAY "msg=" FUNCTION TRIM(CT-MSG).

DO-OB-ADD.
    MOVE "ADD" TO BD-OP
    MOVE WS-A TO BD-OP-ID
    MOVE WS-B TO BD-OP-KIND
    MOVE WS-C TO BD-CHANNEL
    MOVE WS-D TO BD-FAMILY
    MOVE WS-E TO BD-MSG-ID
    MOVE WS-F TO BD-E2E-ID
    COMPUTE BD-AMOUNT = FUNCTION NUMVAL(WS-G)
    MOVE WS-H TO BD-CURRENCY
    MOVE WS-I TO BD-INTERNAL
    MOVE WS-J TO BD-SIM
    MOVE WS-K TO BD-CERT-ID
    MOVE WS-L TO BD-REASON
    MOVE WS-M TO BD-OPERATOR
    CALL "BXOUTB" USING BK-BND-PARMS
    PERFORM SHOW-BND.

DO-OB-PROCESS.
    MOVE "PROCESS" TO BD-OP
    MOVE WS-A TO BD-OP-ID
    CALL "BXOUTB" USING BK-BND-PARMS
    PERFORM SHOW-BND.

DO-OB-QUERY.
    MOVE "QUERY" TO BD-OP
    MOVE WS-A TO BD-OP-ID
    CALL "BXOUTB" USING BK-BND-PARMS
    PERFORM SHOW-BND.

DO-OB-CORRELATE.
    MOVE "CORRELATE" TO BD-OP
    MOVE WS-A TO BD-OP-ID
    MOVE WS-B TO BD-RESULT
    MOVE WS-C TO BD-REASON
    MOVE WS-D TO BD-OPERATOR
    CALL "BXOUTB" USING BK-BND-PARMS
    PERFORM SHOW-BND.

DO-OB-REAP.
    MOVE "REAP" TO BD-OP
    COMPUTE BD-AGE-SECS = FUNCTION NUMVAL(WS-A)
    CALL "BXOUTB" USING BK-BND-PARMS
    PERFORM SHOW-BND.

DO-OB-GET.
    MOVE "GET" TO BD-OP
    MOVE WS-A TO BD-OP-ID
    CALL "BXOUTB" USING BK-BND-PARMS
    PERFORM SHOW-BND.

DO-OB-LIST.
    MOVE "LIST" TO BD-OP
    CALL "BXOUTB" USING BK-BND-PARMS
    DISPLAY "rc=" BD-RC
    DISPLAY "count=" BD-CNT.

SHOW-BND.
    DISPLAY "rc=" BD-RC
    DISPLAY "state=" FUNCTION TRIM(BD-STATE)
    DISPLAY "outcome=" FUNCTION TRIM(BD-OUTCOME)
    DISPLAY "class=" FUNCTION TRIM(BD-CLASS)
    DISPLAY "retryable=" FUNCTION TRIM(BD-RETRYABLE)
    DISPLAY "correlate=" FUNCTION TRIM(BD-CORRELATE)
    DISPLAY "extref=" FUNCTION TRIM(BD-EXT-REF)
    DISPLAY "retries=" BD-RETRY
    DISPLAY "fp=" FUNCTION TRIM(BD-FP)
    DISPLAY "msg=" FUNCTION TRIM(BD-MSG).

DO-TP-SEND.
    MOVE "SEND" TO BD-OP
    MOVE WS-A TO BD-CHANNEL
    MOVE "FIXTURE" TO BD-ADAPTER
    MOVE WS-B TO BD-FAMILY
    MOVE WS-C TO BD-MSG-ID
    MOVE WS-D TO BD-E2E-ID
    COMPUTE BD-AMOUNT = FUNCTION NUMVAL(WS-E)
    MOVE WS-F TO BD-CURRENCY
    MOVE WS-G TO BD-SIM
    EVALUATE TRUE
        WHEN WS-A = "SPI" MOVE "STL" TO BD-OP-KIND
        WHEN WS-A = "DICT" MOVE "KEY" TO BD-OP-KIND
        WHEN OTHER MOVE "PAY" TO BD-OP-KIND
    END-EVALUATE
    CALL "BXTP" USING BK-BND-PARMS
    PERFORM SHOW-BND.

DO-TP-QUERY.
    MOVE "QUERY" TO BD-OP
    MOVE WS-A TO BD-CHANNEL
    MOVE "FIXTURE" TO BD-ADAPTER
    MOVE WS-B TO BD-MSG-ID
    MOVE WS-C TO BD-EXT-REF
    CALL "BXTP" USING BK-BND-PARMS
    PERFORM SHOW-BND.

DO-MSGID-GET.
    MOVE SPACES TO BK-MSGID-PARMS
    MOVE "IDM-GET" TO MD-OP
    MOVE WS-A TO MD-MSG-ID
    CALL "BXMSGID" USING BK-MSGID-PARMS
    DISPLAY "rc=" MD-RC
    DISPLAY "state=" FUNCTION TRIM(MD-STATE)
    DISPLAY "ver=" FUNCTION TRIM(MD-VER)
    DISPLAY "family=" FUNCTION TRIM(MD-FAMILY)
    DISPLAY "e2e=" FUNCTION TRIM(MD-E2E)
    DISPLAY "fp=" FUNCTION TRIM(MD-FP)
    DISPLAY "pix=" FUNCTION TRIM(MD-PIX)
    DISPLAY "txn=" FUNCTION TRIM(MD-TXN)
    DISPLAY "jrn=" FUNCTION TRIM(MD-JRN)
    DISPLAY "count=" MD-CNT.

DO-MSGID-LIST.
    DISPLAY "rc=00"
    DISPLAY "msg=USE GET".

DO-INBOUND.
    MOVE SPACES TO BD-PAYLOAD
    MOVE 0 TO WS-PIPES
    MOVE 0 TO WS-SCN
    PERFORM UNTIL WS-PIPES >= 4 OR WS-SCN > FUNCTION LENGTH(WS-LINE)
        ADD 1 TO WS-SCN
        IF WS-LINE(WS-SCN:1) = "|"
            ADD 1 TO WS-PIPES
        END-IF
    END-PERFORM
    IF WS-PIPES < 4
        MOVE "20" TO BD-RC
        DISPLAY "rc=20"
        DISPLAY "msg=INBOUND PAYLOAD REQUIRED"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-LINE(WS-SCN + 1:) TO BD-PAYLOAD
    MOVE "INBOUND" TO BD-OP
    MOVE WS-A TO BD-MSG-ID
    MOVE WS-B TO BD-CERT-ID
    MOVE WS-C TO BD-SIGNATURE
    CALL "BXPIPE" USING BK-BND-PARMS
    DISPLAY "rc=" BD-RC
    DISPLAY "state=" FUNCTION TRIM(BD-STATE)
    DISPLAY "outcome=" FUNCTION TRIM(BD-OUTCOME)
    DISPLAY "class=" FUNCTION TRIM(BD-CLASS)
    DISPLAY "correlate=" FUNCTION TRIM(BD-CORRELATE)
    DISPLAY "pix=" FUNCTION TRIM(BD-OP-ID)
    DISPLAY "txn=" FUNCTION TRIM(BD-INTERNAL)
    DISPLAY "jrn=" FUNCTION TRIM(BD-EXT-REF)
    DISPLAY "msg=" FUNCTION TRIM(BD-MSG).
