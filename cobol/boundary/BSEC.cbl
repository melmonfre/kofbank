IDENTIFICATION DIVISION.
PROGRAM-ID. BSEC.

*> Security & Certificate lifecycle boundary (GATE 3).
*> Manages certificate metadata, lifecycle states (VALID, NOT_YET_VALID,
*> EXPIRED, REVOKED, ROTATION_REQUIRED, ROTATED) and provides a message
*> signing/verification double based on the active certificate reference.
*> Secrets and private keys NEVER enter COBOL records; references only.
*> Production replaces the signing double with a PKCS#11 / HSM adapter.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CRT-FILE ASSIGN TO WS-CRT-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CRT-ID OF CRT-REC
        FILE STATUS IS WS-CRT-ST.

DATA DIVISION.
FILE SECTION.
FD CRT-FILE.
01 CRT-REC.
   05 CRT-ID           PIC X(24).
   05 CRT-SUBJECT      PIC X(24).
   05 CRT-ISSUER       PIC X(24).
   05 CRT-PURPOSE      PIC X(12).
   05 CRT-ENV          PIC X(16).
   05 CRT-STATE        PIC X(16).
   05 CRT-FROM         PIC 9(14).
   05 CRT-UNTIL        PIC 9(14).
   05 CRT-ROTATED-TO   PIC X(24).
   05 CRT-VERSION      PIC 9(03).
   05 CRT-CREATED      PIC 9(14).
   05 CRT-HASH         PIC X(16).

WORKING-STORAGE SECTION.
01 WS-CRT-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-CRT-ST PIC X(02).
01 WS-NOW PIC 9(14).
01 WS-NOW-X PIC X(14).
01 WS-SIGN-BUF PIC X(2400).
01 WS-SIGN-LEN PIC 9(04).
01 WS-HSH PIC X(16).
01 WS-EXPECTED-SIG PIC X(64).
01 WS-FOUND PIC X(01).
01 WS-EOF PIC X(01).
01 WS-COUNT PIC 9(04).
01 WS-THRESHOLD PIC 9(08).
01 WS-THRU PIC 9(08).
01 WS-TODAY8 PIC 9(08).
01 WS-THRU8 PIC 9(08).
01 WS-UNTIL8 PIC 9(08).
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BPXCFG".

LINKAGE SECTION.
COPY "BKCFTP".
01 LS-PAYLOAD PIC X(2000).
01 LS-SIG     PIC X(64).

PROCEDURE DIVISION USING BK-CRT-PARMS LS-PAYLOAD LS-SIG.
    MOVE "00" TO CT-RC
    MOVE SPACES TO CT-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-CRT-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/bndcrt.idx"
        DELIMITED SIZE INTO WS-CRT-PATH
    MOVE FUNCTION CURRENT-DATE TO WS-NOW-X
    MOVE WS-NOW-X(1:14) TO WS-NOW
    PERFORM OPEN-STORE
    IF CT-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE FUNCTION TRIM(CT-OP)
        WHEN "REG" PERFORM DO-REG
        WHEN "CHECK" PERFORM DO-CHECK
        WHEN "ROTATE" PERFORM DO-ROTATE
        WHEN "LIST" PERFORM DO-LIST
        WHEN "EXPSCAN" PERFORM DO-EXPSCAN
        WHEN "SIGN" PERFORM DO-SIGN
        WHEN "VERIFY" PERFORM DO-VERIFY
        WHEN "REVOKE" PERFORM DO-REVOKE
        WHEN OTHER
            MOVE "20" TO CT-RC
            MOVE "UNKNOWN CERT OP" TO CT-MSG
    END-EVALUATE
    CLOSE CRT-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O CRT-FILE
    IF WS-CRT-ST = "35"
        OPEN OUTPUT CRT-FILE
        CLOSE CRT-FILE
        OPEN I-O CRT-FILE
    END-IF
    IF WS-CRT-ST NOT = "00"
        MOVE WS-CRT-ST TO CT-RC
        MOVE "CANNOT OPEN CERT STORE" TO CT-MSG
    END-IF.

DO-REG.
    IF CT-ID = SPACES
        MOVE "20" TO CT-RC
        MOVE "CERT ID REQUIRED" TO CT-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO CRT-REC
    MOVE CT-ID TO CRT-ID OF CRT-REC
    MOVE CT-SUBJECT TO CRT-SUBJECT OF CRT-REC
    MOVE CT-ISSUER TO CRT-ISSUER OF CRT-REC
    MOVE CT-PURPOSE TO CRT-PURPOSE OF CRT-REC
    MOVE CT-ENV TO CRT-ENV OF CRT-REC
    IF CT-STATE = SPACES
        MOVE "ACTIVE" TO CRT-STATE OF CRT-REC
    ELSE
        MOVE CT-STATE TO CRT-STATE OF CRT-REC
    END-IF
    MOVE CT-FROM TO CRT-FROM OF CRT-REC
    MOVE CT-UNTIL TO CRT-UNTIL OF CRT-REC
    MOVE 1 TO CRT-VERSION OF CRT-REC
    MOVE WS-NOW TO CRT-CREATED OF CRT-REC
    WRITE CRT-REC
        INVALID KEY
            MOVE "22" TO CT-RC
            MOVE "CERTIFICATE ALREADY REGISTERED" TO CT-MSG
            EXIT PARAGRAPH
    END-WRITE
    MOVE "CERTIFICATE REGISTERED" TO CT-MSG.

DO-CHECK.
    MOVE CT-ID TO CRT-ID OF CRT-REC
    READ CRT-FILE
        INVALID KEY
            MOVE "23" TO CT-RC
            MOVE "UNKNOWN CERTIFICATE" TO CT-MSG
            EXIT PARAGRAPH
    END-READ
    MOVE CRT-SUBJECT OF CRT-REC TO CT-SUBJECT
    MOVE CRT-ISSUER OF CRT-REC TO CT-ISSUER
    MOVE CRT-PURPOSE OF CRT-REC TO CT-PURPOSE
    MOVE CRT-ENV OF CRT-REC TO CT-ENV
    MOVE CRT-FROM OF CRT-REC TO CT-FROM
    MOVE CRT-UNTIL OF CRT-REC TO CT-UNTIL
    MOVE CRT-STATE OF CRT-REC TO CT-STATE
    IF CRT-STATE OF CRT-REC = "REVOKED"
        MOVE "20" TO CT-RC
        MOVE "CERTIFICATE REVOKED" TO CT-MSG
        EXIT PARAGRAPH
    END-IF
    IF CRT-STATE OF CRT-REC = "ROTATED"
        MOVE "20" TO CT-RC
        MOVE "CERTIFICATE ROTATED OUT" TO CT-MSG
        EXIT PARAGRAPH
    END-IF
    IF CRT-FROM OF CRT-REC > WS-NOW
        MOVE "20" TO CT-RC
        MOVE "CERTIFICATE NOT YET VALID" TO CT-MSG
        EXIT PARAGRAPH
    END-IF
    IF CRT-UNTIL OF CRT-REC < WS-NOW
        MOVE "20" TO CT-RC
        MOVE "CERTIFICATE EXPIRED" TO CT-MSG
        EXIT PARAGRAPH
    END-IF
    IF CRT-STATE OF CRT-REC = "ROTATION_REQUIRED"
        MOVE "20" TO CT-RC
        MOVE "CERTIFICATE ROTATION REQUIRED" TO CT-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "00" TO CT-RC
    MOVE "CERTIFICATE VALID" TO CT-MSG.

DO-ROTATE.
    MOVE CT-ID TO CRT-ID OF CRT-REC
    READ CRT-FILE
        INVALID KEY
            MOVE "23" TO CT-RC
            MOVE "OLD CERTIFICATE NOT FOUND" TO CT-MSG
            EXIT PARAGRAPH
    END-READ
    MOVE "ROTATED" TO CRT-STATE
    MOVE CT-NEW-ID TO CRT-ROTATED-TO
    MOVE CRT-ID TO CT-ID
    REWRITE CRT-REC
        INVALID KEY
            MOVE "20" TO CT-RC
            MOVE "FAILED TO ROTATE OLD CERT" TO CT-MSG
            EXIT PARAGRAPH
    END-REWRITE
    MOVE "CERTIFICATE ROTATED" TO CT-MSG.

DO-REVOKE.
    MOVE CT-ID TO CRT-ID OF CRT-REC
    READ CRT-FILE
        INVALID KEY
            MOVE "23" TO CT-RC
            MOVE "CERTIFICATE NOT FOUND" TO CT-MSG
            EXIT PARAGRAPH
    END-READ
    MOVE "REVOKED" TO CRT-STATE OF CRT-REC
    REWRITE CRT-REC
    MOVE "CERTIFICATE REVOKED" TO CT-MSG.

DO-LIST.
    MOVE 0 TO WS-COUNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CRT-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END ADD 1 TO WS-COUNT
        END-READ
    END-PERFORM
    MOVE WS-COUNT TO CT-COUNT.

DO-EXPSCAN.
    MOVE 0 TO CT-COUNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ CRT-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM CHECK-EXPIRY
        END-READ
    END-PERFORM
    MOVE "EXPIRY SCAN COMPLETE" TO CT-MSG.

CHECK-EXPIRY.
    IF CRT-STATE OF CRT-REC NOT = "ACTIVE"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NOW(1:8) TO WS-TODAY8
    COMPUTE WS-THRESHOLD = FUNCTION INTEGER-OF-DATE(WS-TODAY8)
        + CT-DAYS
    MOVE FUNCTION DATE-OF-INTEGER(WS-THRESHOLD) TO WS-THRU
    MOVE WS-TODAY8 TO WS-THRU8
    MOVE CRT-UNTIL OF CRT-REC(1:8) TO WS-UNTIL8
    IF WS-UNTIL8 < WS-TODAY8
        DISPLAY "CERT-EXPIRED " FUNCTION TRIM(CRT-ID OF CRT-REC)
            " until=" CRT-UNTIL OF CRT-REC
        ADD 1 TO CT-COUNT
    ELSE
        IF WS-UNTIL8 <= WS-THRU8
            DISPLAY "CERT-EXPIRING " FUNCTION TRIM(CRT-ID
                OF CRT-REC) " until=" CRT-UNTIL OF CRT-REC
            ADD 1 TO CT-COUNT
        END-IF
    END-IF.

ENV-GUARD.
    CALL "BPXCFG" USING BK-PX-CFG
    IF PC-ENVIRONMENT = "PRODUCTION"
        MOVE "20" TO CT-RC
        MOVE "PRODUCTION SIGNING PROVIDER NOT INSTALLED"
            TO CT-MSG
        GOBACK
    END-IF
    IF PC-ENVIRONMENT NOT = "LOCAL_DOUBLE" AND
       PC-ENVIRONMENT NOT = "QA"
        MOVE "20" TO CT-RC
        MOVE "ENVIRONMENT UNKNOWN OR MISSING" TO CT-MSG
        GOBACK
    END-IF.

DO-SIGN.
    PERFORM ENV-GUARD
    IF CT-RC NOT = "00" GOBACK END-IF
    PERFORM DO-CHECK
    IF CT-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM COMPUTE-SIG
    MOVE WS-EXPECTED-SIG TO LS-SIG
    MOVE "00" TO CT-RC
    MOVE "MESSAGE SIGNED" TO CT-MSG.

DO-VERIFY.
    PERFORM ENV-GUARD
    IF CT-RC NOT = "00" GOBACK END-IF
    PERFORM DO-CHECK
    IF CT-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    PERFORM COMPUTE-SIG
    IF LS-SIG NOT = WS-EXPECTED-SIG
        MOVE "20" TO CT-RC
        MOVE "INVALID MESSAGE SIGNATURE" TO CT-MSG
    ELSE
        MOVE "00" TO CT-RC
        MOVE "SIGNATURE VERIFIED" TO CT-MSG
    END-IF.

COMPUTE-SIG.
    MOVE SPACES TO WS-SIGN-BUF
    STRING "SIG|" DELIMITED SIZE
        FUNCTION TRIM(CT-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CRT-ENV OF CRT-REC) DELIMITED SIZE "|"
        DELIMITED SIZE
        FUNCTION TRIM(LS-PAYLOAD) DELIMITED SIZE
        INTO WS-SIGN-BUF
    END-STRING
    MOVE 2400 TO WS-SIGN-LEN
    CALL "BHSH" USING WS-SIGN-BUF WS-SIGN-LEN WS-HSH

    MOVE SPACES TO WS-EXPECTED-SIG
    STRING "SIG-" DELIMITED SIZE FUNCTION TRIM(CT-ID)
        DELIMITED SIZE "-" DELIMITED SIZE WS-HSH
        INTO WS-EXPECTED-SIG
    END-STRING.
