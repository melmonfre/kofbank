IDENTIFICATION DIVISION.
PROGRAM-ID. BTXNPOST.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BKJRNP".
COPY "BKPSTT".
01 WS-REV PIC X(01).
01 WS-PST-IDX PIC 9(04).
01 WS-P-GL PIC X(10).
01 WS-P-DC PIC X(01).
01 WS-P-AMT PIC S9(15)V99 COMP-3.
01 WS-P-ENTITY PIC X(20).
01 WS-P-DESC PIC X(40).
01 WS-I PIC 9(04).

LINKAGE SECTION.
COPY "BTXNPSP".

PROCEDURE DIVISION USING BK-TXN-POST-REQ.
    MOVE "00" TO TPO-RC
    MOVE SPACES TO TPO-MSG
    MOVE SPACES TO WS-REV
    IF TPO-STATUS = "RT" OR TPO-STATUS = "RV"
        MOVE "Y" TO WS-REV
    END-IF
    MOVE SPACES TO BK-JRN-ID
    MOVE TPO-JRN-ID TO BK-JRN-ID
    MOVE TPO-TXN-ID TO BK-JRN-TXN-ID
    MOVE TPO-TYPE TO BK-JRN-TYPE
    MOVE TPO-BIZDATE TO BK-JRN-BIZDATE
    MOVE "TXN" TO BK-JRN-CHANNEL
    MOVE TPO-OPERATOR TO BK-JRN-OPERATOR
    MOVE TPO-CORR TO BK-JRN-CORR
    MOVE TPO-REQUEST TO BK-JRN-REQUEST
    MOVE 2 TO BK-JRN-COUNT
    EVALUATE TPO-TYPE
        WHEN "DEPOSIT" PERFORM BUILD-DEPOSIT
        WHEN "WITHDRAW" PERFORM BUILD-WITHDRAW
        WHEN "TRANSFER" PERFORM BUILD-TRANSFER
        WHEN "FEE" PERFORM BUILD-FEE
        WHEN "CREDDISB" PERFORM BUILD-DISBURSE
        WHEN "CREDREPY" PERFORM BUILD-REPAY
        WHEN "CREDFEE" PERFORM BUILD-CREDIT-FEE
        WHEN "CREDWOFF" PERFORM BUILD-WRITEOFF
        WHEN OTHER
            MOVE "20" TO TPO-RC
            MOVE "UNKNOWN TXN TYPE" TO TPO-MSG
            GOBACK
    END-EVALUATE
    CALL "BGLPST" USING BK-JRN-PARMS BK-PST-TABLE
    MOVE BK-JRN-RC TO TPO-RC
    MOVE BK-JRN-MSG TO TPO-MSG.

BUILD-DEPOSIT.
    IF WS-REV = "Y"
        MOVE "2000" TO BK-PST-GL(1)
        MOVE "D" TO BK-PST-DC(1)
        MOVE TPO-DST TO BK-PST-ENTITY(1)
        MOVE "1000" TO BK-PST-GL(2)
        MOVE "C" TO BK-PST-DC(2)
        MOVE SPACES TO BK-PST-ENTITY(2)
    ELSE
        MOVE "1000" TO BK-PST-GL(1)
        MOVE "D" TO BK-PST-DC(1)
        MOVE SPACES TO BK-PST-ENTITY(1)
        MOVE "2000" TO BK-PST-GL(2)
        MOVE "C" TO BK-PST-DC(2)
        MOVE TPO-DST TO BK-PST-ENTITY(2)
    END-IF
    MOVE TPO-AMOUNT TO BK-PST-AMOUNT(1)
    MOVE TPO-AMOUNT TO BK-PST-AMOUNT(2)
    MOVE TPO-CURRENCY TO BK-PST-CURRENCY(1)
    MOVE TPO-CURRENCY TO BK-PST-CURRENCY(2)
    MOVE TPO-DESCR TO BK-PST-DESCR(1)
    MOVE TPO-DESCR TO BK-PST-DESCR(2)
    MOVE TPO-BIZDATE TO BK-PST-VALUEDATE(1)
    MOVE TPO-BIZDATE TO BK-PST-VALUEDATE(2).

BUILD-WITHDRAW.
    IF WS-REV = "Y"
        MOVE "1000" TO BK-PST-GL(1)
        MOVE "D" TO BK-PST-DC(1)
        MOVE SPACES TO BK-PST-ENTITY(1)
        MOVE "2000" TO BK-PST-GL(2)
        MOVE "C" TO BK-PST-DC(2)
        MOVE TPO-SRC TO BK-PST-ENTITY(2)
    ELSE
        MOVE "2000" TO BK-PST-GL(1)
        MOVE "D" TO BK-PST-DC(1)
        MOVE TPO-SRC TO BK-PST-ENTITY(1)
        MOVE "1000" TO BK-PST-GL(2)
        MOVE "C" TO BK-PST-DC(2)
        MOVE SPACES TO BK-PST-ENTITY(2)
    END-IF
    MOVE TPO-AMOUNT TO BK-PST-AMOUNT(1)
    MOVE TPO-AMOUNT TO BK-PST-AMOUNT(2)
    MOVE TPO-CURRENCY TO BK-PST-CURRENCY(1)
    MOVE TPO-CURRENCY TO BK-PST-CURRENCY(2)
    MOVE TPO-DESCR TO BK-PST-DESCR(1)
    MOVE TPO-DESCR TO BK-PST-DESCR(2)
    MOVE TPO-BIZDATE TO BK-PST-VALUEDATE(1)
    MOVE TPO-BIZDATE TO BK-PST-VALUEDATE(2).

BUILD-TRANSFER.
    IF WS-REV = "Y"
        MOVE TPO-DST TO BK-PST-ENTITY(1)
        MOVE TPO-SRC TO BK-PST-ENTITY(2)
    ELSE
        MOVE TPO-SRC TO BK-PST-ENTITY(1)
        MOVE TPO-DST TO BK-PST-ENTITY(2)
    END-IF
    MOVE "2000" TO BK-PST-GL(1)
    MOVE "D" TO BK-PST-DC(1)
    MOVE "2000" TO BK-PST-GL(2)
    MOVE "C" TO BK-PST-DC(2)
    MOVE TPO-AMOUNT TO BK-PST-AMOUNT(1)
    MOVE TPO-AMOUNT TO BK-PST-AMOUNT(2)
    MOVE TPO-CURRENCY TO BK-PST-CURRENCY(1)
    MOVE TPO-CURRENCY TO BK-PST-CURRENCY(2)
    MOVE TPO-DESCR TO BK-PST-DESCR(1)
    MOVE TPO-DESCR TO BK-PST-DESCR(2)
    MOVE TPO-BIZDATE TO BK-PST-VALUEDATE(1)
    MOVE TPO-BIZDATE TO BK-PST-VALUEDATE(2).

BUILD-FEE.
    IF WS-REV = "Y"
        MOVE "4000" TO BK-PST-GL(1)
        MOVE "D" TO BK-PST-DC(1)
        MOVE SPACES TO BK-PST-ENTITY(1)
        MOVE "2000" TO BK-PST-GL(2)
        MOVE "C" TO BK-PST-DC(2)
        MOVE TPO-SRC TO BK-PST-ENTITY(2)
    ELSE
        MOVE "2000" TO BK-PST-GL(1)
        MOVE "D" TO BK-PST-DC(1)
        MOVE TPO-SRC TO BK-PST-ENTITY(1)
        MOVE "4000" TO BK-PST-GL(2)
        MOVE "C" TO BK-PST-DC(2)
        MOVE SPACES TO BK-PST-ENTITY(2)
    END-IF
    MOVE TPO-AMOUNT TO BK-PST-AMOUNT(1)
    MOVE TPO-AMOUNT TO BK-PST-AMOUNT(2)
    MOVE TPO-CURRENCY TO BK-PST-CURRENCY(1)
    MOVE TPO-CURRENCY TO BK-PST-CURRENCY(2)
    MOVE TPO-DESCR TO BK-PST-DESCR(1)
    MOVE TPO-DESCR TO BK-PST-DESCR(2)
    MOVE TPO-BIZDATE TO BK-PST-VALUEDATE(1)
    MOVE TPO-BIZDATE TO BK-PST-VALUEDATE(2).

BUILD-DISBURSE.
    MOVE 0 TO WS-PST-IDX
    MOVE "3000" TO WS-P-GL
    MOVE "D" TO WS-P-DC
    MOVE TPO-PRINCIPAL TO WS-P-AMT
    MOVE TPO-FACILITY TO WS-P-ENTITY
    MOVE TPO-DESCR TO WS-P-DESC
    PERFORM ADD-POST
    MOVE "2000" TO WS-P-GL
    MOVE "C" TO WS-P-DC
    MOVE TPO-PRINCIPAL TO WS-P-AMT
    MOVE TPO-DST TO WS-P-ENTITY
    MOVE TPO-DESCR TO WS-P-DESC
    PERFORM ADD-POST
    IF TPO-FEE-AMT > 0
        MOVE "2000" TO WS-P-GL
        MOVE "D" TO WS-P-DC
        MOVE TPO-FEE-AMT TO WS-P-AMT
        MOVE TPO-DST TO WS-P-ENTITY
        MOVE TPO-DESCR TO WS-P-DESC
        PERFORM ADD-POST
        MOVE "4000" TO WS-P-GL
        MOVE "C" TO WS-P-DC
        MOVE TPO-FEE-AMT TO WS-P-AMT
        MOVE SPACES TO WS-P-ENTITY
        MOVE TPO-DESCR TO WS-P-DESC
        PERFORM ADD-POST
    END-IF
    PERFORM INVERT-IF-REV
    MOVE WS-PST-IDX TO BK-JRN-COUNT.

BUILD-REPAY.
    MOVE 0 TO WS-PST-IDX
    IF TPO-FEE-AMT > 0
        MOVE "2000" TO WS-P-GL
        MOVE "D" TO WS-P-DC
        MOVE TPO-FEE-AMT TO WS-P-AMT
        MOVE TPO-SRC TO WS-P-ENTITY
        MOVE TPO-DESCR TO WS-P-DESC
        PERFORM ADD-POST
        MOVE "4000" TO WS-P-GL
        MOVE "C" TO WS-P-DC
        MOVE TPO-FEE-AMT TO WS-P-AMT
        MOVE SPACES TO WS-P-ENTITY
        MOVE TPO-DESCR TO WS-P-DESC
        PERFORM ADD-POST
    END-IF
    IF TPO-INTEREST > 0
        MOVE "2000" TO WS-P-GL
        MOVE "D" TO WS-P-DC
        MOVE TPO-INTEREST TO WS-P-AMT
        MOVE TPO-SRC TO WS-P-ENTITY
        MOVE TPO-DESCR TO WS-P-DESC
        PERFORM ADD-POST
        MOVE "4100" TO WS-P-GL
        MOVE "C" TO WS-P-DC
        MOVE TPO-INTEREST TO WS-P-AMT
        MOVE SPACES TO WS-P-ENTITY
        MOVE TPO-DESCR TO WS-P-DESC
        PERFORM ADD-POST
    END-IF
    IF TPO-PRINCIPAL > 0
        MOVE "2000" TO WS-P-GL
        MOVE "D" TO WS-P-DC
        MOVE TPO-PRINCIPAL TO WS-P-AMT
        MOVE TPO-SRC TO WS-P-ENTITY
        MOVE TPO-DESCR TO WS-P-DESC
        PERFORM ADD-POST
        MOVE "3000" TO WS-P-GL
        MOVE "C" TO WS-P-DC
        MOVE TPO-PRINCIPAL TO WS-P-AMT
        MOVE TPO-FACILITY TO WS-P-ENTITY
        MOVE TPO-DESCR TO WS-P-DESC
        PERFORM ADD-POST
    END-IF
    PERFORM INVERT-IF-REV
    MOVE WS-PST-IDX TO BK-JRN-COUNT.

BUILD-CREDIT-FEE.
    MOVE 0 TO WS-PST-IDX
    MOVE "2000" TO WS-P-GL
    MOVE "D" TO WS-P-DC
    MOVE TPO-AMOUNT TO WS-P-AMT
    MOVE TPO-SRC TO WS-P-ENTITY
    MOVE TPO-DESCR TO WS-P-DESC
    PERFORM ADD-POST
    MOVE "4000" TO WS-P-GL
    MOVE "C" TO WS-P-DC
    MOVE TPO-AMOUNT TO WS-P-AMT
    MOVE SPACES TO WS-P-ENTITY
    MOVE TPO-DESCR TO WS-P-DESC
    PERFORM ADD-POST
    PERFORM INVERT-IF-REV
    MOVE WS-PST-IDX TO BK-JRN-COUNT.

BUILD-WRITEOFF.
    MOVE 0 TO WS-PST-IDX
    MOVE "5100" TO WS-P-GL
    MOVE "D" TO WS-P-DC
    MOVE TPO-AMOUNT TO WS-P-AMT
    MOVE SPACES TO WS-P-ENTITY
    MOVE TPO-DESCR TO WS-P-DESC
    PERFORM ADD-POST
    MOVE "3000" TO WS-P-GL
    MOVE "C" TO WS-P-DC
    MOVE TPO-AMOUNT TO WS-P-AMT
    MOVE TPO-FACILITY TO WS-P-ENTITY
    MOVE TPO-DESCR TO WS-P-DESC
    PERFORM ADD-POST
    PERFORM INVERT-IF-REV
    MOVE WS-PST-IDX TO BK-JRN-COUNT.

INVERT-IF-REV.
    IF WS-REV NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-PST-IDX
        IF BK-PST-DC(WS-I) = "D"
            MOVE "C" TO BK-PST-DC(WS-I)
        ELSE
            MOVE "D" TO BK-PST-DC(WS-I)
        END-IF
    END-PERFORM.

ADD-POST.
    ADD 1 TO WS-PST-IDX
    MOVE WS-P-GL TO BK-PST-GL(WS-PST-IDX)
    MOVE WS-P-DC TO BK-PST-DC(WS-PST-IDX)
    MOVE WS-P-AMT TO BK-PST-AMOUNT(WS-PST-IDX)
    MOVE TPO-CURRENCY TO BK-PST-CURRENCY(WS-PST-IDX)
    MOVE WS-P-ENTITY TO BK-PST-ENTITY(WS-PST-IDX)
    MOVE WS-P-DESC TO BK-PST-DESCR(WS-PST-IDX)
    MOVE TPO-BIZDATE TO BK-PST-VALUEDATE(WS-PST-IDX).
