IDENTIFICATION DIVISION.
PROGRAM-ID. BTXNRCV.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT GL-FILE ASSIGN TO WS-GL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS GL-CODE
        FILE STATUS IS WS-GL-ST.
    SELECT BAL-FILE ASSIGN TO WS-BAL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS BAL-ACCT-ID
        FILE STATUS IS WS-BAL-ST.
    SELECT PST-FILE ASSIGN TO WS-PST-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-PST-ST.
    SELECT JST-FILE ASSIGN TO WS-JST-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS JST-ID
        FILE STATUS IS WS-JST-ST.

DATA DIVISION.
FILE SECTION.
FD GL-FILE.
01 GL-REC.
   05 GL-CODE PIC X(10).
   05 GL-NAME PIC X(40).
   05 GL-TYPE PIC X(01).
   05 GL-STATUS PIC X(01).
FD BAL-FILE.
01 BAL-REC.
   05 BAL-ACCT-ID PIC X(12).
   05 BAL-LEDGER PIC S9(15)V99 COMP-3.
   05 BAL-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BAL-BLOCKED PIC S9(15)V99 COMP-3.
   05 BAL-CURRENCY PIC X(03).
   05 BAL-UPDATED PIC 9(08).
   05 BAL-SEQ PIC 9(12).
FD PST-FILE.
01 PST-LINE PIC X(300).
FD JST-FILE.
01 JST-REC.
   05 JST-ID PIC X(20).
   05 JST-STATE PIC X(01).
   05 JST-UPDATED PIC 9(14).

WORKING-STORAGE SECTION.
01 WS-GL-PATH PIC X(200).
01 WS-BAL-PATH PIC X(200).
01 WS-PST-PATH PIC X(200).
01 WS-JST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-GL-ST PIC X(02).
01 WS-BAL-ST PIC X(02).
01 WS-PST-ST PIC X(02).
01 WS-JST-ST PIC X(02).
01 WS-I PIC 9(04).
01 WS-DELTA PIC S9(15)V99 COMP-3.
01 WS-AMT-ED PIC -(15)9.99.
01 WS-STAGE PIC X(01) VALUE " ".
01 WS-APPLIED PIC X(01) VALUE "N".
01 WS-CNT-GLP PIC 9(04).
01 WS-EOF PIC X(01).
01 WS-LINE-BUF PIC X(300).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
COPY "BKJRNP".
COPY "BKPSTT".
COPY "BKAUDP".
COPY "BKEVTP".
01 WS-SEQ-TS PIC X(14).
01 WS-FIELDS.
   05 WS-GF PIC X(60) OCCURS 8 TIMES.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
01 WS-EVT-PAYLOAD PIC X(200).
LINKAGE SECTION.
COPY "BTXNSTOP".
01 BK-TXN-OUT.
   COPY "BTXREC".

PROCEDURE DIVISION USING BK-TXN-STO-REQ BK-TXN-OUT.
    MOVE "00" TO TS-RC
    MOVE SPACES TO TS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    PERFORM RESOLVE-PATHS
    MOVE "GET" TO TS-OP
    CALL "BTXNSTO" USING BK-TXN-STO-REQ BK-TXN-OUT
    IF TS-RC NOT = "00"
        GOBACK
    END-IF
    IF TXN-STATUS = "CP" OR TXN-STATUS = "PO"
        OR TXN-STATUS = "RJ" OR TXN-STATUS = "CN"
        OR TXN-STATUS = "RV" OR TXN-STATUS = "RT"
        OR TXN-STATUS = "ST"
            MOVE "ALREADY COMMITTED" TO TS-MSG
            GOBACK
    END-IF
    IF TXN-STATUS = "CR" OR TXN-STATUS = "VA"
        MOVE "20" TO TS-RC
        MOVE "NOT POSTED SAFE TO RETRY" TO TS-MSG
        GOBACK
    END-IF
    IF TXN-STATUS NOT = "AU"
        MOVE "20" TO TS-RC
        MOVE "STATUS NOT RECOVERABLE" TO TS-MSG
        GOBACK
    END-IF
    IF TXN-JRN-ID = SPACES
        MOVE SPACES TO TXN-JRN-ID
        STRING "TXN" DELIMITED SIZE TXN-ID DELIMITED SIZE
            "-P" DELIMITED SIZE INTO TXN-JRN-ID
        END-STRING
    END-IF
    MOVE SPACES TO BK-JRN-PARMS
    MOVE TXN-JRN-ID TO BK-JRN-ID
    MOVE "G" TO BK-JRN-MODE
    CALL "BJRN" USING BK-JRN-PARMS BK-PST-TABLE
    IF BK-JRN-RC NOT = "00"
        MOVE BK-JRN-RC TO TS-RC
        MOVE "JOURNAL SCAN FAILED" TO TS-MSG
        GOBACK
    END-IF
    IF BK-JRN-F-FOUND = 0
        MOVE "20" TO TS-RC
        MOVE "NO DURABLE EFFECT SAFE TO RETRY" TO TS-MSG
        GOBACK
    END-IF
    PERFORM READ-STAGE
    PERFORM APPLY-MISSING
    IF TS-RC NOT = "00"
        GOBACK
    END-IF
    MOVE WS-BIZDATE TO TXN-POSTED
    MOVE "PO" TO TXN-STATUS
    ADD 1 TO TXN-VERSION
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO TS-OP
    CALL "BTXNSTO" USING BK-TXN-STO-REQ BK-TXN-OUT
    IF TS-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM EMIT-AUDIT
    PERFORM EMIT-EVENT
    MOVE "RECOVERED AND COMMITTED" TO TS-MSG
    GOBACK.

RESOLVE-PATHS.
    MOVE SPACES TO WS-GL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/gl.idx"
        DELIMITED SIZE INTO WS-GL-PATH
    MOVE SPACES TO WS-BAL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/acctbal.idx"
        DELIMITED SIZE INTO WS-BAL-PATH
    MOVE SPACES TO WS-PST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/postings.log"
        DELIMITED SIZE INTO WS-PST-PATH
    MOVE SPACES TO WS-JST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/jrst.idx"
        DELIMITED SIZE INTO WS-JST-PATH.

READ-STAGE.
    MOVE " " TO WS-STAGE
    OPEN I-O JST-FILE
    IF WS-JST-ST = "35"
        MOVE "00" TO TS-RC
        EXIT PARAGRAPH
    END-IF
    IF WS-JST-ST NOT = "00"
        MOVE WS-JST-ST TO TS-RC
        MOVE "CANNOT OPEN STAGE STORE" TO TS-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE BK-JRN-ID TO JST-ID
    READ JST-FILE
    IF WS-JST-ST = "00"
        MOVE JST-STATE TO WS-STAGE
    END-IF
    CLOSE JST-FILE.

APPLY-MISSING.
    IF WS-STAGE = "P"
        MOVE "Y" TO WS-APPLIED
        EXIT PARAGRAPH
    END-IF
    IF WS-STAGE = "B"
        PERFORM COUNT-EXISTING-GLP
        IF WS-CNT-GLP >= BK-JRN-F-NCOL
            PERFORM MARK-P
            MOVE "Y" TO WS-APPLIED
            EXIT PARAGRAPH
        END-IF
        PERFORM APPEND-LINES
        PERFORM MARK-P
        MOVE "Y" TO WS-APPLIED
        EXIT PARAGRAPH
    END-IF
    PERFORM UPDATE-BALANCES
    PERFORM MARK-B
    PERFORM COUNT-EXISTING-GLP
    IF WS-CNT-GLP < BK-JRN-F-NCOL
        PERFORM APPEND-LINES
    END-IF
    PERFORM MARK-P
    MOVE "Y" TO WS-APPLIED.

COUNT-EXISTING-GLP.
    MOVE 0 TO WS-CNT-GLP
    OPEN INPUT PST-FILE
    IF WS-PST-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PST-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                MOVE SPACES TO WS-FIELDS
                UNSTRING PST-LINE DELIMITED BY "|"
                    INTO WS-GF(1) WS-GF(2) WS-GF(3) WS-GF(4)
                        WS-GF(5) WS-GF(6) WS-GF(7) WS-GF(8)
                END-UNSTRING
                IF WS-GF(1) = "GLP" AND
                    WS-GF(7) = BK-JRN-ID
                    ADD 1 TO WS-CNT-GLP
                END-IF
        END-READ
    END-PERFORM
    CLOSE PST-FILE.

APPEND-LINES.
    OPEN EXTEND PST-FILE
    IF WS-PST-ST NOT = "00"
        MOVE WS-PST-ST TO TS-RC
        MOVE "CANNOT APPEND POSTINGS" TO TS-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BK-JRN-F-NCOL
        MOVE SPACES TO PST-LINE
        MOVE BK-JRN-L-AMT(WS-I) TO WS-AMT-ED
        STRING "GLP|" DELIMITED SIZE
            FUNCTION TRIM(BK-JRN-L-GL(WS-I)) DELIMITED SIZE "|"
            DELIMITED SIZE
            BK-JRN-L-DC(WS-I) DELIMITED SIZE "|" DELIMITED SIZE
            WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
            FUNCTION TRIM(BK-JRN-L-ENTITY(WS-I)) DELIMITED SIZE
            "|" DELIMITED SIZE
            FUNCTION TRIM(BK-JRN-L-CUR(WS-I)) DELIMITED SIZE "|"
            DELIMITED SIZE
            FUNCTION TRIM(BK-JRN-ID) DELIMITED SIZE "|"
            DELIMITED SIZE
            BK-JRN-F-BIZDATE DELIMITED SIZE
            INTO PST-LINE
        END-STRING
        WRITE PST-LINE
    END-PERFORM
    CLOSE PST-FILE.

UPDATE-BALANCES.
    OPEN I-O BAL-FILE
    IF WS-BAL-ST = "35"
        OPEN OUTPUT BAL-FILE
        CLOSE BAL-FILE
        OPEN I-O BAL-FILE
    END-IF
    IF WS-BAL-ST NOT = "00"
        MOVE WS-BAL-ST TO TS-RC
        MOVE "CANNOT OPEN BALANCES" TO TS-MSG
        EXIT PARAGRAPH
    END-IF
    OPEN INPUT GL-FILE
    IF WS-GL-ST NOT = "00"
        MOVE WS-GL-ST TO TS-RC
        MOVE "CANNOT OPEN GL" TO TS-MSG
        EXIT PARAGRAPH
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BK-JRN-F-NCOL
        IF BK-JRN-L-ENTITY(WS-I) NOT = SPACES
            PERFORM UPDATE-ONE
        END-IF
    END-PERFORM
    CLOSE GL-FILE
    CLOSE BAL-FILE.

UPDATE-ONE.
    MOVE BK-JRN-L-ENTITY(WS-I) TO BAL-ACCT-ID
    MOVE BK-JRN-L-AMT(WS-I) TO WS-DELTA
    MOVE BK-JRN-L-GL(WS-I) TO GL-CODE
    READ GL-FILE
    IF WS-GL-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    IF GL-TYPE = "A" AND BK-JRN-L-DC(WS-I) = "C"
        MULTIPLY -1 BY WS-DELTA
    END-IF
    IF GL-TYPE = "L" AND BK-JRN-L-DC(WS-I) = "D"
        MULTIPLY -1 BY WS-DELTA
    END-IF
    READ BAL-FILE
    EVALUATE WS-BAL-ST
        WHEN "23"
            MOVE 0 TO BAL-LEDGER
            MOVE 0 TO BAL-AVAILABLE
            MOVE 0 TO BAL-BLOCKED
            MOVE 0 TO BAL-SEQ
            MOVE BK-JRN-L-CUR(WS-I) TO BAL-CURRENCY
            ADD WS-DELTA TO BAL-LEDGER
            COMPUTE BAL-AVAILABLE = BAL-LEDGER - BAL-BLOCKED
            MOVE BK-JRN-F-BIZDATE TO BAL-UPDATED
            ADD 1 TO BAL-SEQ
            WRITE BAL-REC
        WHEN "00"
            ADD WS-DELTA TO BAL-LEDGER
            COMPUTE BAL-AVAILABLE = BAL-LEDGER - BAL-BLOCKED
            MOVE BK-JRN-F-BIZDATE TO BAL-UPDATED
            ADD 1 TO BAL-SEQ
            REWRITE BAL-REC
        WHEN OTHER
            CONTINUE
    END-EVALUATE.

MARK-B.
    MOVE "B" TO WS-STAGE
    PERFORM WRITE-STAGE.

MARK-P.
    MOVE "P" TO WS-STAGE
    PERFORM WRITE-STAGE.

WRITE-STAGE.
    OPEN I-O JST-FILE
    IF WS-JST-ST = "35"
        OPEN OUTPUT JST-FILE
        CLOSE JST-FILE
        OPEN I-O JST-FILE
    END-IF
    IF WS-JST-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO JST-ID
    MOVE BK-JRN-ID TO JST-ID
    MOVE WS-STAGE TO JST-STATE
    MOVE FUNCTION CURRENT-DATE TO WS-SEQ-TS
    MOVE WS-SEQ-TS(1:14) TO JST-UPDATED
    DELETE JST-FILE
    WRITE JST-REC
        INVALID KEY CONTINUE
    END-WRITE
    CLOSE JST-FILE.

COMPUTE-HASH.
    MOVE TXN-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(TXN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-SRC) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-DST) DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        TXN-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-CURRENCY) DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO TXN-HASH.

EMIT-AUDIT.
    MOVE TXN-OPERATOR TO BK-AUD-OPERATOR
    MOVE "TXN.RECOVER" TO BK-AUD-ACTION
    MOVE TXN-ID TO BK-AUD-ENTITY
    MOVE TXN-CORR TO BK-AUD-CORR
    MOVE "AU" TO BK-AUD-BEFORE
    MOVE TXN-STATUS TO BK-AUD-AFTER
    MOVE "00" TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS.

EMIT-EVENT.
    MOVE TXN-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-EVT-PAYLOAD
    STRING FUNCTION TRIM(TXN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-STATUS) DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-CURRENCY) DELIMITED SIZE
        INTO WS-EVT-PAYLOAD
    END-STRING
    MOVE "TRANSACTION.POSTED.v1" TO BK-EVT-TYPE
    MOVE TXN-ID TO BK-EVT-KEY
    MOVE WS-EVT-PAYLOAD TO BK-EVT-PAYLOAD
    CALL "BEVT" USING BK-EVT-PARMS.
