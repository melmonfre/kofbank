IDENTIFICATION DIVISION.
PROGRAM-ID. BTXNLFC.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BKIDMP".
COPY "BTXNSTOP".
COPY "BTXNVALP".
01 WS-HOME PIC X(80).
01 WS-OPNAME PIC X(12).
01 WS-LOAD-ID PIC X(12).
01 WS-IDM-HIT PIC X(01) VALUE "N".
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "TRANSACTION".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-EVT-PAYLOAD PIC X(200).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 BK-TXN-OUT.
   COPY "BTXREC".

LINKAGE SECTION.
COPY "BTXNLFC".
COPY "BTXNRESP".

PROCEDURE DIVISION USING BK-TXN-LFC-REQ BK-TXN-RES.
    MOVE SPACES TO BK-TXN-RES
    MOVE SPACES TO BK-TXN-OUT
    MOVE "00" TO TXR-RC
    MOVE "N" TO WS-IDM-HIT
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    PERFORM SET-OPNAME
    PERFORM CHECK-IDEMPOTENCY
    IF WS-IDM-HIT = "Y"
        PERFORM RELOAD-REPLAY
        GOBACK
    END-IF
    IF TXR-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE LFC-OP
        WHEN "CREATE" PERFORM DO-CREATE
        WHEN "AUTHORIZE" PERFORM CALL-CMD
        WHEN "POST" PERFORM CALL-CMD
        WHEN "SETTLE" PERFORM CALL-CMD
        WHEN "COMPLETE" PERFORM CALL-CMD
        WHEN "CANCEL" PERFORM CALL-CMD
        WHEN "REVERSE" PERFORM CALL-REV
        WHEN "RETURN" PERFORM CALL-REV
        WHEN OTHER
            MOVE "99" TO TXR-RC
            MOVE "UNKNOWN TXN OP" TO TXR-MSG
    END-EVALUATE
    IF TXR-RC = "00"
        PERFORM EMIT-AUDIT
        PERFORM EMIT-EVENT
        PERFORM MARK-COMPLETE
    ELSE
        PERFORM MARK-FAIL
    END-IF
    GOBACK.

SET-OPNAME.
    EVALUATE LFC-OP
        WHEN "CREATE" MOVE "TXN.CREATE" TO WS-OPNAME
        WHEN "AUTHORIZE" MOVE "TXN.AUTH" TO WS-OPNAME
        WHEN "POST" MOVE "TXN.POST" TO WS-OPNAME
        WHEN "SETTLE" MOVE "TXN.SETTLE" TO WS-OPNAME
        WHEN "COMPLETE" MOVE "TXN.COMPLETE" TO WS-OPNAME
        WHEN "CANCEL" MOVE "TXN.CANCEL" TO WS-OPNAME
        WHEN "REVERSE" MOVE "TXN.REVERSE" TO WS-OPNAME
        WHEN "RETURN" MOVE "TXN.RETURN" TO WS-OPNAME
        WHEN OTHER MOVE "TXN" TO WS-OPNAME
    END-EVALUATE.

CHECK-IDEMPOTENCY.
    IF LFC-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE LFC-REQUEST TO BK-IDM-TXN-ID
    MOVE WS-OPNAME TO BK-IDM-OPERATION
    MOVE "B" TO BK-IDM-MODE
    MOVE SPACES TO BK-IDM-RESULT
    CALL "BIDM" USING BK-IDM-PARMS
    IF BK-IDM-STATUS = "22"
        MOVE "G" TO BK-IDM-MODE
        CALL "BIDM" USING BK-IDM-PARMS
        EVALUATE BK-IDM-STATUS
            WHEN "C"
                MOVE BK-IDM-RESULT(1:12) TO TXR-ID
                MOVE BK-IDM-RESULT(13:2) TO TXR-STATUS
                MOVE BK-IDM-RESULT(15:8) TO TXR-TYPE
                MOVE BK-IDM-RESULT(31:90) TO TXR-MSG
                MOVE "00" TO TXR-RC
                MOVE "Y" TO WS-IDM-HIT
            WHEN "F"
                CONTINUE
            WHEN OTHER
                MOVE "24" TO TXR-RC
                MOVE "REQUEST IN PROGRESS" TO TXR-MSG
        END-EVALUATE
    ELSE
        IF BK-IDM-STATUS NOT = "00"
            MOVE BK-IDM-STATUS TO TXR-RC
            MOVE "IDEMPOTENCY STORE ERROR" TO TXR-MSG
        END-IF
    END-IF.

RELOAD-REPLAY.
    MOVE SPACES TO BK-TXN-OUT
    MOVE TXR-ID TO TXN-ID
    MOVE "GET" TO TS-OP
    CALL "BTXNSTO" USING BK-TXN-STO-REQ BK-TXN-OUT
    IF TS-RC = "00"
        PERFORM FILL-RES
    END-IF.

DO-CREATE.
    CALL "BTXNVAL" USING BK-TXN-LFC-REQ BK-TXN-VAL
    MOVE VAL-RC TO TXR-RC
    MOVE VAL-MSG TO TXR-MSG
    IF TXR-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM BUILD-ID
    IF TXR-RC NOT = "00"
        GOBACK
    END-IF
    MOVE SPACES TO BK-TXN-OUT
    MOVE TXR-ID TO TXN-ID
    MOVE LFC-TYPE TO TXN-TYPE
    MOVE "VA" TO TXN-STATUS
    MOVE LFC-SRC TO TXN-SRC
    MOVE LFC-DST TO TXN-DST
    MOVE LFC-AMOUNT TO TXN-AMOUNT
    MOVE VAL-CUR TO TXN-CURRENCY
    MOVE LFC-DESCR TO TXN-DESCR
    MOVE LFC-OPERATOR TO TXN-OPERATOR
    MOVE LFC-CORR TO TXN-CORR
    MOVE LFC-REQUEST TO TXN-REQUEST
    MOVE LFC-FACILITY TO TXN-FACILITY
    MOVE LFC-PRINCIPAL TO TXN-PRINCIPAL
    MOVE LFC-INTEREST TO TXN-INTEREST
    MOVE LFC-FEE-AMT TO TXN-FEE-AMT
    MOVE LFC-DUE-DATE TO TXN-DUE-DATE
    MOVE LFC-INSTALLMENT TO TXN-INSTALLMENT
    MOVE WS-BIZDATE TO TXN-CREATED
    MOVE 1 TO TXN-VERSION
    PERFORM COMPUTE-HASH
    MOVE "WRITE" TO TS-OP
    CALL "BTXNSTO" USING BK-TXN-STO-REQ BK-TXN-OUT
    IF TS-RC NOT = "00"
        MOVE TS-RC TO TXR-RC
        MOVE TS-MSG TO TXR-MSG
        GOBACK
    END-IF
    PERFORM FILL-RES
    MOVE "CREATED" TO TXR-MSG.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO TXR-RC
        MOVE "SEQUENCE ERROR" TO TXR-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO TXR-ID
    STRING "T" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO TXR-ID
    END-STRING.

CALL-CMD.
    MOVE SPACES TO BK-TXN-RES
    MOVE SPACES TO BK-TXN-OUT
    CALL "BTXNCMD" USING BK-TXN-LFC-REQ BK-TXN-RES BK-TXN-OUT.

CALL-REV.
    MOVE SPACES TO BK-TXN-RES
    MOVE SPACES TO BK-TXN-OUT
    CALL "BTXNREV" USING BK-TXN-LFC-REQ BK-TXN-RES BK-TXN-OUT.

FILL-RES.
    MOVE TXN-ID TO TXR-ID
    MOVE TXN-STATUS TO TXR-STATUS
    MOVE TXN-TYPE TO TXR-TYPE
    MOVE TXN-JRN-ID TO TXR-JRN-ID
    MOVE TXN-AMOUNT TO TXR-AMOUNT.

COMPUTE-HASH.
    MOVE TXN-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(TXN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-SRC) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-DST) DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        TXN-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-CURRENCY) DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO TXN-HASH.

EMIT-AUDIT.
    MOVE TXN-OPERATOR TO BK-AUD-OPERATOR
    MOVE WS-OPNAME TO BK-AUD-ACTION
    MOVE TXN-ID TO BK-AUD-ENTITY
    MOVE TXN-CORR TO BK-AUD-CORR
    MOVE TXN-STATUS TO BK-AUD-BEFORE
    MOVE TXR-MSG TO BK-AUD-AFTER
    MOVE TXR-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS.

EMIT-EVENT.
    MOVE TXN-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-EVT-PAYLOAD
    STRING FUNCTION TRIM(TXN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-STATUS) DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-CURRENCY) DELIMITED SIZE
        INTO WS-EVT-PAYLOAD
    END-STRING
    EVALUATE TXN-STATUS
        WHEN "RT" MOVE "TRANSACTION.RETURNED.v1" TO BK-EVT-TYPE
        WHEN "RV" MOVE "TRANSACTION.REVERSED.v1" TO BK-EVT-TYPE
        WHEN "CN" MOVE "TRANSACTION.CANCELLED.v1" TO BK-EVT-TYPE
        WHEN "RJ" MOVE "TRANSACTION.REJECTED.v1" TO BK-EVT-TYPE
        WHEN OTHER MOVE "TRANSACTION.POSTED.v1" TO BK-EVT-TYPE
    END-EVALUATE
    MOVE TXN-ID TO BK-EVT-KEY
    MOVE WS-EVT-PAYLOAD TO BK-EVT-PAYLOAD
    CALL "BEVT" USING BK-EVT-PARMS.

MARK-COMPLETE.
    IF LFC-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE LFC-REQUEST TO BK-IDM-TXN-ID
    MOVE SPACES TO BK-IDM-RESULT
    MOVE TXR-ID TO BK-IDM-RESULT(1:12)
    MOVE TXR-STATUS TO BK-IDM-RESULT(13:2)
    MOVE TXR-TYPE TO BK-IDM-RESULT(15:8)
    MOVE TXR-MSG TO BK-IDM-RESULT(31:90)
    MOVE "C" TO BK-IDM-MODE
    CALL "BIDM" USING BK-IDM-PARMS.

MARK-FAIL.
    IF LFC-REQUEST = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE LFC-REQUEST TO BK-IDM-TXN-ID
    MOVE TXR-MSG TO BK-IDM-RESULT
    MOVE "F" TO BK-IDM-MODE
    CALL "BIDM" USING BK-IDM-PARMS.
