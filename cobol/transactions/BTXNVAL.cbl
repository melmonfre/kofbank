IDENTIFICATION DIVISION.
PROGRAM-ID. BTXNVAL.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BCREXP".
01 WS-ACCT-ID-WS PIC X(12).
01 WS-CUR PIC X(03).
01 WS-I PIC 9(02).
01 WS-LEG-SUM PIC S9(15)V99 COMP-3.
01 WS-CUR-SRC PIC X(03).
01 WS-ACCT-OUT.
   05 AO-ID PIC X(12).
   05 AO-CUST PIC X(12).
   05 AO-PRODUCT PIC X(04).
   05 AO-CURRENCY PIC X(03).
   05 AO-STATUS PIC X(02).
   05 AO-OPENED PIC 9(08).
   05 AO-CLOSED PIC 9(08).
   05 AO-VERSION PIC 9(05).
   05 AO-HASH PIC X(16).
   05 AO-RC PIC X(02).
01 WS-BAL-OUT.
   05 BO-LEDGER PIC S9(15)V99 COMP-3.
   05 BO-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BO-BLOCKED PIC S9(15)V99 COMP-3.
   05 BO-CURRENCY PIC X(03).
   05 BO-UPDATED PIC 9(08).
   05 BO-SEQ PIC 9(12).
   05 BO-RC PIC X(02).

LINKAGE SECTION.
COPY "BTXNLFC".
COPY "BTXNVALP".

PROCEDURE DIVISION USING BK-TXN-LFC-REQ BK-TXN-VAL.
    MOVE "00" TO VAL-RC
    MOVE SPACES TO VAL-MSG
    MOVE SPACES TO VAL-CUR
    IF LFC-AMOUNT <= 0
        MOVE "20" TO VAL-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO VAL-MSG
        GOBACK
    END-IF
    EVALUATE LFC-TYPE
        WHEN "DEPOSIT" PERFORM V-DEPOSIT
        WHEN "WITHDRAW" PERFORM V-WITHDRAW
        WHEN "TRANSFER" PERFORM V-TRANSFER
        WHEN "FEE" PERFORM V-FEE
        WHEN "CREDDISB" PERFORM V-DISBURSE
        WHEN "CREDREPY" PERFORM V-REPAY
        WHEN "CREDFEE" PERFORM V-REPAY
        WHEN "CREDWOFF" PERFORM V-WRITEOFF
        WHEN "CREDCHRG" PERFORM V-CHARGE
        WHEN "CREDREF" PERFORM V-CHARGE
        WHEN "SPLITPIX" PERFORM V-SPLITPIX
        WHEN "PIXOUT" PERFORM V-PIXOUT
        WHEN "PIXIN" PERFORM V-PIXIN
        WHEN OTHER
            MOVE "20" TO VAL-RC
            MOVE "UNKNOWN TXN TYPE" TO VAL-MSG
    END-EVALUATE
    GOBACK.

V-ACTIVE.
    CALL "BACQRY" USING WS-ACCT-ID-WS WS-ACCT-OUT
    IF AO-RC NOT = "00"
        MOVE "20" TO VAL-RC
        MOVE "ACCOUNT NOT FOUND" TO VAL-MSG
    ELSE
        IF AO-STATUS NOT = "AC"
            MOVE "20" TO VAL-RC
            MOVE "ACCOUNT NOT ACTIVE" TO VAL-MSG
        ELSE
            MOVE AO-CURRENCY TO WS-CUR
        END-IF
    END-IF.

V-CURRENCY.
    MOVE WS-CUR TO VAL-CUR
    IF LFC-CURRENCY NOT = SPACES AND LFC-CURRENCY NOT = WS-CUR
        MOVE "20" TO VAL-RC
        MOVE "CURRENCY MISMATCH" TO VAL-MSG
    END-IF.

V-FUNDS.
    CALL "BGLBAL" USING WS-ACCT-ID-WS WS-BAL-OUT
    IF BO-RC NOT = "00"
        MOVE "20" TO VAL-RC
        MOVE "BALANCE NOT FOUND" TO VAL-MSG
    ELSE
        IF BO-AVAILABLE < LFC-AMOUNT
            MOVE "20" TO VAL-RC
            MOVE "INSUFFICIENT FUNDS" TO VAL-MSG
        END-IF
    END-IF.

V-DISBURSE.
    IF LFC-FACILITY = SPACES
        MOVE "20" TO VAL-RC
        MOVE "FACILITY REQUIRED" TO VAL-MSG
        GOBACK
    END-IF
    MOVE LFC-DST TO WS-ACCT-ID-WS
    PERFORM V-ACTIVE
    IF VAL-RC = "00"
        PERFORM V-CURRENCY
    END-IF.

V-REPAY.
    IF LFC-FACILITY = SPACES
        MOVE "20" TO VAL-RC
        MOVE "FACILITY REQUIRED" TO VAL-MSG
        GOBACK
    END-IF
    PERFORM V-WITHDRAW.

V-CHARGE.
    IF LFC-FACILITY = SPACES
        MOVE "20" TO VAL-RC
        MOVE "FACILITY REQUIRED" TO VAL-MSG
        GOBACK
    END-IF
    IF LFC-CURRENCY = SPACES
        MOVE "20" TO VAL-RC
        MOVE "CURRENCY REQUIRED" TO VAL-MSG
        GOBACK
    END-IF
    MOVE LFC-CURRENCY TO VAL-CUR
    MOVE "GET" TO CE-OP
    MOVE LFC-FACILITY TO CE-FAC-ID
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        MOVE "20" TO VAL-RC
        MOVE "FACILITY NOT FOUND" TO VAL-MSG
        GOBACK
    END-IF
    IF CE-STATUS = "CLO" OR CE-STATUS = "CANC" OR
       CE-STATUS = "CAN"
        MOVE "20" TO VAL-RC
        MOVE "FACILITY CLOSED" TO VAL-MSG
    END-IF.

V-WRITEOFF.
    IF LFC-FACILITY = SPACES
        MOVE "20" TO VAL-RC
        MOVE "FACILITY REQUIRED" TO VAL-MSG
    END-IF.

V-DEPOSIT.
    MOVE LFC-DST TO WS-ACCT-ID-WS
    PERFORM V-ACTIVE
    IF VAL-RC = "00"
        PERFORM V-CURRENCY
    END-IF.

V-WITHDRAW.
    MOVE LFC-SRC TO WS-ACCT-ID-WS
    PERFORM V-ACTIVE
    IF VAL-RC = "00"
        PERFORM V-CURRENCY
        IF VAL-RC = "00"
            PERFORM V-FUNDS
        END-IF
    END-IF.

V-FEE.
    PERFORM V-WITHDRAW.

V-SPLITPIX.
    IF LFC-SPLIT-CNT < 1 OR LFC-SPLIT-CNT > 20
        MOVE "20" TO VAL-RC
        MOVE "SPLIT REQUIRES 1 TO 20 LEGS" TO VAL-MSG
        GOBACK
    END-IF
    MOVE 0 TO WS-LEG-SUM
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > LFC-SPLIT-CNT
        IF LFC-PS-SEQ(WS-I) NOT = WS-I OR
           LFC-PS-AMT(WS-I) <= 0 OR LFC-PS-DEST(WS-I) = SPACES
            MOVE "20" TO VAL-RC
            MOVE "INVALID SPLIT LEG" TO VAL-MSG
            GOBACK
        END-IF
        ADD LFC-PS-AMT(WS-I) TO WS-LEG-SUM
    END-PERFORM
    IF WS-LEG-SUM NOT = LFC-AMOUNT
        MOVE "20" TO VAL-RC
        MOVE "SPLIT LEGS DO NOT SUM TO GROSS" TO VAL-MSG
        GOBACK
    END-IF
    PERFORM V-WITHDRAW.

V-PIXOUT.
    IF LFC-DST = SPACES
        MOVE "20" TO VAL-RC
        MOVE "RECEIVER PARTICIPANT REQUIRED" TO VAL-MSG
        GOBACK
    END-IF
    PERFORM V-WITHDRAW.

V-PIXIN.
    IF LFC-SRC = SPACES
        MOVE "20" TO VAL-RC
        MOVE "SENDER PARTICIPANT REQUIRED" TO VAL-MSG
        GOBACK
    END-IF
    PERFORM V-DEPOSIT.

V-TRANSFER.
    IF LFC-SRC = LFC-DST
        MOVE "20" TO VAL-RC
        MOVE "SOURCE AND DESTINATION MUST DIFFER" TO VAL-MSG
        GOBACK
    END-IF
    MOVE LFC-SRC TO WS-ACCT-ID-WS
    PERFORM V-ACTIVE
    IF VAL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE WS-CUR TO WS-CUR-SRC
    MOVE LFC-DST TO WS-ACCT-ID-WS
    PERFORM V-ACTIVE
    IF VAL-RC NOT = "00"
        GOBACK
    END-IF
    IF WS-CUR-SRC NOT = WS-CUR
        MOVE "20" TO VAL-RC
        MOVE "CURRENCY MISMATCH" TO VAL-MSG
        GOBACK
    END-IF
    PERFORM V-CURRENCY
    IF VAL-RC NOT = "00"
        GOBACK
    END-IF
    MOVE LFC-SRC TO WS-ACCT-ID-WS
    PERFORM V-FUNDS.
