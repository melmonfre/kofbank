IDENTIFICATION DIVISION.
PROGRAM-ID. BTXNSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TXN-FILE ASSIGN TO WS-TXN-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS TXN-ID
        FILE STATUS IS WS-TXN-ST.

DATA DIVISION.
FILE SECTION.
FD TXN-FILE.
01 TXN-REC.
   COPY "BTXREC".

WORKING-STORAGE SECTION.
01 WS-TXN-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-TXN-ST PIC X(02).
01 WS-LK-MODE PIC X(01).
01 WS-LK-NAME PIC X(64) VALUE "WR-TXN".
01 WS-LK-STATUS PIC X(02).

LINKAGE SECTION.
COPY "BTXNSTOP".
01 BK-TXN-REC.
   COPY "BTXREC".

PROCEDURE DIVISION USING BK-TXN-STO-REQ BK-TXN-REC.
    MOVE "00" TO TS-RC
    MOVE SPACES TO TS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-TXN-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/txn.idx"
        DELIMITED SIZE INTO WS-TXN-PATH
    END-STRING
    PERFORM LOCK-ACQUIRE
    IF WS-LK-STATUS NOT = "00"
        MOVE WS-LK-STATUS TO TS-RC
        MOVE "STORE LOCK UNAVAILABLE" TO TS-MSG
        GOBACK
    END-IF
    PERFORM OPEN-STORE
    IF TS-RC NOT = "00"
        PERFORM LOCK-RELEASE
        GOBACK
    END-IF
    EVALUATE TS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO TS-RC
            MOVE "UNKNOWN TXN STORE OP" TO TS-MSG
    END-EVALUATE
    CLOSE TXN-FILE
    PERFORM LOCK-RELEASE
    GOBACK.

LOCK-ACQUIRE.
    MOVE "W" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-NAME WS-LK-STATUS.

LOCK-RELEASE.
    MOVE "R" TO WS-LK-MODE
    CALL "BWR" USING WS-LK-MODE WS-LK-NAME WS-LK-STATUS.

OPEN-STORE.
    OPEN I-O TXN-FILE
    IF WS-TXN-ST = "35"
        OPEN OUTPUT TXN-FILE
        CLOSE TXN-FILE
        OPEN I-O TXN-FILE
    END-IF
    IF WS-TXN-ST NOT = "00"
        MOVE WS-TXN-ST TO TS-RC
        MOVE "CANNOT OPEN TXN INDEX" TO TS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-TXN-REC TO TXN-REC
    WRITE TXN-REC
        INVALID KEY
            MOVE "22" TO TS-RC
            MOVE "TRANSACTION ALREADY EXISTS" TO TS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE TXN-ID OF BK-TXN-REC TO TXN-ID OF TXN-REC
    READ TXN-FILE
    IF WS-TXN-ST = "00"
        MOVE BK-TXN-REC TO TXN-REC
        REWRITE TXN-REC
    ELSE
        MOVE "23" TO TS-RC
        MOVE "TRANSACTION NOT FOUND" TO TS-MSG
    END-IF.

DO-GET.
    MOVE TXN-ID OF BK-TXN-REC TO TXN-ID OF TXN-REC
    READ TXN-FILE
    IF WS-TXN-ST = "00"
        MOVE TXN-REC TO BK-TXN-REC
        MOVE "00" TO TS-RC
    ELSE
        MOVE "23" TO TS-RC
        MOVE "TRANSACTION NOT FOUND" TO TS-MSG
    END-IF.
