IDENTIFICATION DIVISION.
PROGRAM-ID. BTXNCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(20).
01 WS-A PIC X(24).
01 WS-B PIC X(24).
01 WS-C PIC X(24).
01 WS-D PIC X(24).
01 WS-E PIC X(24).
01 WS-F PIC X(40).
01 WS-G PIC X(12).
01 WS-H PIC X(24).
01 WS-I PIC X(24).
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT-ED PIC -(15)9.99.
COPY "BTXNLFC".
COPY "BTXNRESP".
COPY "BTXNSTOP".
01 WS-TXN-REC.
   COPY "BTXREC".
01 WS-QOP PIC X(08).
01 WS-QRC PIC X(02).
01 WS-LK-ST PIC X(02).
01 WS-LK-MODE PIC X(01).

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "create" PERFORM DO-CREATE
        WHEN "get" PERFORM DO-GET
        WHEN "list" PERFORM DO-LIST
        WHEN "authorize" PERFORM DO-AUTHORIZE
        WHEN "post" PERFORM DO-POST
        WHEN "settle" PERFORM DO-SETTLE
        WHEN "complete" PERFORM DO-COMPLETE
        WHEN "cancel" PERFORM DO-CANCEL
        WHEN "reverse" PERFORM DO-REVERSE
        WHEN "return" PERFORM DO-RETURN
        WHEN "recover" PERFORM DO-RECOVER
        WHEN "lock" PERFORM DO-LOCK
        WHEN "unlock" PERFORM DO-UNLOCK
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN TXN OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F
        WS-G WS-H WS-I
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H WS-I
    END-UNSTRING.

DO-CREATE.
    MOVE "CREATE" TO LFC-OP
    MOVE WS-A TO LFC-TYPE
    MOVE WS-B TO LFC-SRC
    MOVE WS-C TO LFC-DST
    PERFORM PARSE-AMOUNT
    MOVE WS-E TO LFC-CURRENCY
    MOVE WS-F TO LFC-DESCR
    MOVE WS-G TO LFC-OPERATOR
    MOVE WS-H TO LFC-CORR
    MOVE WS-I TO LFC-REQUEST
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    PERFORM SHOW-RESULT.

DO-RECOVER.
    MOVE SPACES TO BK-TXN-STO-REQ
    MOVE SPACES TO WS-TXN-REC
    MOVE WS-A TO TXN-ID
    CALL "BTXNRCV" USING BK-TXN-STO-REQ WS-TXN-REC
    DISPLAY "rc=" TS-RC
    DISPLAY "status=" FUNCTION TRIM(TXN-STATUS)
    DISPLAY "msg=" FUNCTION TRIM(TS-MSG).

DO-LOCK.
    MOVE WS-A(1:1) TO WS-LK-MODE
    CALL "BLCK" USING WS-B WS-C WS-LK-MODE WS-LK-ST
    DISPLAY "rc=" WS-LK-ST.

DO-UNLOCK.
    MOVE "R" TO WS-LK-MODE
    CALL "BLCK" USING WS-B WS-C WS-LK-MODE WS-LK-ST
    DISPLAY "rc=" WS-LK-ST.

DO-GET.
    MOVE "GET" TO LFC-OP
    MOVE WS-A TO LFC-TXN-ID
    MOVE SPACES TO WS-TXN-REC
    MOVE "GET" TO WS-QOP
    CALL "BTXNQRY" USING WS-QOP LFC-TXN-ID WS-TXN-REC WS-QRC
    DISPLAY "rc=" WS-QRC
    IF WS-QRC = "00"
        PERFORM SHOW-RECORD
    END-IF.

DO-LIST.
    MOVE SPACES TO WS-TXN-REC
    MOVE "LIST" TO WS-QOP
    CALL "BTXNQRY" USING WS-QOP WS-A WS-TXN-REC WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-AUTHORIZE.
    MOVE "AUTHORIZE" TO LFC-OP
    MOVE WS-A TO LFC-TXN-ID
    MOVE WS-B TO LFC-OPERATOR
    MOVE WS-C TO LFC-CORR
    MOVE WS-D TO LFC-REQUEST
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    PERFORM SHOW-RESULT.

DO-POST.
    MOVE "POST" TO LFC-OP
    MOVE WS-A TO LFC-TXN-ID
    MOVE WS-B TO LFC-OPERATOR
    MOVE WS-C TO LFC-CORR
    MOVE WS-D TO LFC-REQUEST
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    PERFORM SHOW-RESULT.

DO-SETTLE.
    MOVE "SETTLE" TO LFC-OP
    MOVE WS-A TO LFC-TXN-ID
    MOVE WS-B TO LFC-OPERATOR
    MOVE WS-C TO LFC-CORR
    MOVE WS-D TO LFC-REQUEST
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    PERFORM SHOW-RESULT.

DO-COMPLETE.
    MOVE "COMPLETE" TO LFC-OP
    MOVE WS-A TO LFC-TXN-ID
    MOVE WS-B TO LFC-OPERATOR
    MOVE WS-C TO LFC-CORR
    MOVE WS-D TO LFC-REQUEST
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    PERFORM SHOW-RESULT.

DO-CANCEL.
    MOVE "CANCEL" TO LFC-OP
    MOVE WS-A TO LFC-TXN-ID
    MOVE WS-B TO LFC-REASON
    MOVE WS-C TO LFC-OPERATOR
    MOVE WS-D TO LFC-CORR
    MOVE WS-E TO LFC-REQUEST
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    PERFORM SHOW-RESULT.

DO-REVERSE.
    MOVE "REVERSE" TO LFC-OP
    MOVE WS-A TO LFC-TXN-ID
    MOVE WS-B TO LFC-REASON
    MOVE WS-C TO LFC-OPERATOR
    MOVE WS-D TO LFC-CORR
    MOVE WS-E TO LFC-REQUEST
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    PERFORM SHOW-RESULT.

DO-RETURN.
    MOVE "RETURN" TO LFC-OP
    MOVE WS-A TO LFC-TXN-ID
    MOVE WS-B TO LFC-REASON
    MOVE WS-C TO LFC-OPERATOR
    MOVE WS-D TO LFC-CORR
    MOVE WS-E TO LFC-REQUEST
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    PERFORM SHOW-RESULT.

PARSE-AMOUNT.
    MOVE 0 TO WS-AMT
    MOVE WS-D TO WS-AMT
    MOVE WS-AMT TO LFC-AMOUNT.

SHOW-RESULT.
    MOVE TXR-AMOUNT TO WS-AMT-ED
    DISPLAY "rc=" TXR-RC
    DISPLAY "id=" FUNCTION TRIM(TXR-ID)
    DISPLAY "status=" TXR-STATUS
    DISPLAY "type=" FUNCTION TRIM(TXR-TYPE)
    DISPLAY "amount=" WS-AMT-ED
    DISPLAY "msg=" FUNCTION TRIM(TXR-MSG).

SHOW-RECORD.
    MOVE TXN-AMOUNT TO WS-AMT-ED
    DISPLAY "id=" FUNCTION TRIM(TXN-ID)
    DISPLAY "type=" FUNCTION TRIM(TXN-TYPE)
    DISPLAY "status=" TXN-STATUS
    DISPLAY "source=" FUNCTION TRIM(TXN-SRC)
    DISPLAY "destination=" FUNCTION TRIM(TXN-DST)
    DISPLAY "amount=" WS-AMT-ED
    DISPLAY "currency=" FUNCTION TRIM(TXN-CURRENCY)
    DISPLAY "origin=" FUNCTION TRIM(TXN-ORIGIN)
    DISPLAY "reason=" FUNCTION TRIM(TXN-REASON)
    DISPLAY "journal=" FUNCTION TRIM(TXN-JRN-ID)
    DISPLAY "created=" TXN-CREATED
    DISPLAY "posted=" TXN-POSTED
    DISPLAY "settled=" TXN-SETTLED
    DISPLAY "version=" TXN-VERSION
    DISPLAY "hash=" FUNCTION TRIM(TXN-HASH).
