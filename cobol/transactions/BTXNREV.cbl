IDENTIFICATION DIVISION.
PROGRAM-ID. BTXNREV.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BKEVTP".
COPY "BTXNSTOP".
COPY "BTXNPSP".
COPY "BLIMP".
01 WS-HOME PIC X(80).
01 WS-TARGET PIC X(02).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "TRANSACTION".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-EVT-PAYLOAD PIC X(200).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-ORIG-ID PIC X(12).
01 WS-ORIG-TYPE PIC X(08).
01 WS-ORIG-SRC PIC X(12).
01 WS-ORIG-DST PIC X(12).
01 WS-ORIG-AMOUNT PIC S9(15)V99 COMP-3.
01 WS-ORIG-CUR PIC X(03).
01 WS-ORIG-FAC PIC X(12).
01 WS-ORIG-PRIN PIC S9(15)V99 COMP-3.
01 WS-ORIG-INT PIC S9(15)V99 COMP-3.
01 WS-ORIG-FEE PIC S9(15)V99 COMP-3.
01 WS-ORIG-DUE PIC 9(08).
01 WS-ORIG-INST PIC 9(04).
01 WS-ORIG-REF PIC X(24).

LINKAGE SECTION.
COPY "BTXNLFC".
COPY "BTXNRESP".
01 BK-TXN-OUT.
   COPY "BTXREC".

PROCEDURE DIVISION USING BK-TXN-LFC-REQ BK-TXN-RES BK-TXN-OUT.
    MOVE "00" TO TXR-RC
    MOVE SPACES TO TXR-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF LFC-OP = "REVERSE"
        MOVE "RV" TO WS-TARGET
    ELSE
        MOVE "RT" TO WS-TARGET
    END-IF
    MOVE SPACES TO BK-TXN-OUT
    MOVE LFC-TXN-ID TO TXN-ID
    MOVE "GET" TO TS-OP
    CALL "BTXNSTO" USING BK-TXN-STO-REQ BK-TXN-OUT
    IF TS-RC NOT = "00"
        MOVE TS-RC TO TXR-RC
        MOVE TS-MSG TO TXR-MSG
        GOBACK
    END-IF
    MOVE TXN-ID TO TXR-ID
    MOVE TXN-STATUS TO TXR-STATUS
    MOVE TXN-TYPE TO TXR-TYPE
    MOVE TXN-AMOUNT TO TXR-AMOUNT
    IF TXN-STATUS NOT = "ST" AND TXN-STATUS NOT = "CP"
        MOVE "20" TO TXR-RC
        MOVE "ORIGIN NOT SETTLED" TO TXR-MSG
        GOBACK
    END-IF
    MOVE TXN-ID TO WS-ORIG-ID
    MOVE TXN-TYPE TO WS-ORIG-TYPE
    MOVE TXN-SRC TO WS-ORIG-SRC
    MOVE TXN-DST TO WS-ORIG-DST
    MOVE TXN-AMOUNT TO WS-ORIG-AMOUNT
    MOVE TXN-CURRENCY TO WS-ORIG-CUR
    MOVE TXN-FACILITY TO WS-ORIG-FAC
    MOVE TXN-PRINCIPAL TO WS-ORIG-PRIN
    MOVE TXN-INTEREST TO WS-ORIG-INT
    MOVE TXN-FEE-AMT TO WS-ORIG-FEE
    MOVE TXN-DUE-DATE TO WS-ORIG-DUE
    MOVE TXN-INSTALLMENT TO WS-ORIG-INST
    MOVE TXN-REF TO WS-ORIG-REF
    PERFORM BUILD-ID
    IF TXR-RC NOT = "00"
        GOBACK
    END-IF
    MOVE SPACES TO BK-TXN-OUT
    MOVE TXR-ID TO TXN-ID
    MOVE WS-ORIG-TYPE TO TXN-TYPE
    MOVE WS-TARGET TO TXN-STATUS
    MOVE WS-ORIG-SRC TO TXN-SRC
    MOVE WS-ORIG-DST TO TXN-DST
    MOVE WS-ORIG-AMOUNT TO TXN-AMOUNT
    MOVE WS-ORIG-CUR TO TXN-CURRENCY
    MOVE LFC-DESCR TO TXN-DESCR
    MOVE LFC-OPERATOR TO TXN-OPERATOR
    MOVE LFC-CORR TO TXN-CORR
    MOVE LFC-REQUEST TO TXN-REQUEST
    MOVE WS-ORIG-ID TO TXN-ORIGIN
    MOVE LFC-REASON TO TXN-REASON
    MOVE WS-ORIG-FAC TO TXN-FACILITY
    MOVE WS-ORIG-PRIN TO TXN-PRINCIPAL
    MOVE WS-ORIG-INT TO TXN-INTEREST
    MOVE WS-ORIG-FEE TO TXN-FEE-AMT
    MOVE WS-ORIG-DUE TO TXN-DUE-DATE
    MOVE WS-ORIG-INST TO TXN-INSTALLMENT
    MOVE WS-ORIG-REF TO TXN-REF
    MOVE WS-BIZDATE TO TXN-CREATED
    MOVE WS-BIZDATE TO TXN-POSTED
    MOVE WS-BIZDATE TO TXN-SETTLED
    MOVE 1 TO TXN-VERSION
    PERFORM COMPUTE-HASH
    MOVE "WRITE" TO TS-OP
    CALL "BTXNSTO" USING BK-TXN-STO-REQ BK-TXN-OUT
    IF TS-RC NOT = "00"
        MOVE TS-RC TO TXR-RC
        MOVE TS-MSG TO TXR-MSG
        GOBACK
    END-IF
    PERFORM POST-EFFECT
    IF TXR-RC NOT = "00"
        GOBACK
    END-IF
    ADD 1 TO TXN-VERSION
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO TS-OP
    CALL "BTXNSTO" USING BK-TXN-STO-REQ BK-TXN-OUT
    IF TS-RC NOT = "00"
        MOVE TS-RC TO TXR-RC
        MOVE TS-MSG TO TXR-MSG
        GOBACK
    END-IF
    PERFORM RELEASE-LIMIT
    MOVE WS-TARGET TO TXR-STATUS
    IF WS-TARGET = "RV"
        MOVE "REVERSED" TO TXR-MSG
    ELSE
        MOVE "RETURNED" TO TXR-MSG
    END-IF
    GOBACK.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO TXR-RC
        MOVE "SEQUENCE ERROR" TO TXR-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO TXR-ID
    STRING "T" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO TXR-ID
    END-STRING.

POST-EFFECT.
    MOVE TXN-ID TO TPO-TXN-ID
    MOVE TXN-TYPE TO TPO-TYPE
    MOVE TXN-STATUS TO TPO-STATUS
    MOVE TXN-SRC TO TPO-SRC
    MOVE TXN-DST TO TPO-DST
    MOVE TXN-AMOUNT TO TPO-AMOUNT
    MOVE TXN-CURRENCY TO TPO-CURRENCY
    MOVE TXN-DESCR TO TPO-DESCR
    MOVE TXN-OPERATOR TO TPO-OPERATOR
    MOVE TXN-CORR TO TPO-CORR
    MOVE TXN-REQUEST TO TPO-REQUEST
    MOVE TXN-REASON TO TPO-REASON
    MOVE TXN-ORIGIN TO TPO-ORIGIN
    MOVE TXN-REF TO TPO-REF
    MOVE TXN-FACILITY TO TPO-FACILITY
    MOVE TXN-PRINCIPAL TO TPO-PRINCIPAL
    MOVE TXN-INTEREST TO TPO-INTEREST
    MOVE TXN-FEE-AMT TO TPO-FEE-AMT
    MOVE TXN-DUE-DATE TO TPO-DUE-DATE
    MOVE TXN-INSTALLMENT TO TPO-INSTALLMENT
    MOVE WS-BIZDATE TO TPO-BIZDATE
    MOVE SPACES TO TPO-JRN-ID
    STRING "TXN" DELIMITED SIZE TXN-ID DELIMITED SIZE "-P" DELIMITED SIZE
        INTO TPO-JRN-ID
    END-STRING
    MOVE TPO-JRN-ID TO TXN-JRN-ID
    CALL "BTXNPOST" USING BK-TXN-POST-REQ
    MOVE TPO-RC TO TXR-RC
    MOVE TPO-MSG TO TXR-MSG.

COMPUTE-HASH.
    MOVE TXN-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(TXN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-SRC) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-DST) DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        TXN-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-CURRENCY) DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO TXN-HASH.

RELEASE-LIMIT.
    MOVE "CHANNEL" TO LIM-SCOPE
    MOVE "TXN" TO LIM-KEY
    MOVE "DAILY" TO LIM-PERIOD
    MOVE TXN-AMOUNT TO LIM-AMOUNT
    MOVE TXN-CURRENCY TO LIM-CURRENCY
    MOVE "RELEASE" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ.

