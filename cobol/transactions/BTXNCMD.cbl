IDENTIFICATION DIVISION.
PROGRAM-ID. BTXNCMD.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BKEVTP".
COPY "BTXNSTOP".
COPY "BTXNPSP".
COPY "BLIMP".
01 WS-HOME PIC X(80).
01 WS-ACTION PIC X(08).
01 WS-NEXT PIC X(02).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 WS-LOAD-ID PIC X(12).
01 WS-I PIC 9(02).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-EVT-PAYLOAD PIC X(200).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-CRASH PIC X(12).

LINKAGE SECTION.
COPY "BTXNLFC".
COPY "BTXNRESP".
01 BK-TXN-OUT.
   COPY "BTXREC".

PROCEDURE DIVISION USING BK-TXN-LFC-REQ BK-TXN-RES BK-TXN-OUT.
    MOVE "00" TO TXR-RC
    MOVE SPACES TO TXR-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    ACCEPT WS-CRASH FROM ENVIRONMENT "KOF_CRASH"
    CALL "BCFG" USING WS-CFG
    MOVE LFC-TXN-ID TO WS-LOAD-ID
    PERFORM LOAD-TXN
    IF TXR-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE LFC-OP
        WHEN "AUTHORIZE" MOVE "AUTH" TO WS-ACTION
        WHEN "POST" MOVE "POST" TO WS-ACTION
        WHEN "SETTLE" MOVE "SETTLE" TO WS-ACTION
        WHEN "COMPLETE" MOVE "COMPLETE" TO WS-ACTION
        WHEN "CANCEL" MOVE "CANCEL" TO WS-ACTION
        WHEN OTHER
            MOVE "99" TO TXR-RC
            MOVE "UNKNOWN TXN CMD" TO TXR-MSG
    END-EVALUATE
    IF TXR-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM CHECK-TRANSITION
    IF TXR-RC NOT = "00"
        GOBACK
    END-IF
    IF WS-ACTION = "AUTH"
        PERFORM CHECK-LIMIT
        IF TXR-RC NOT = "00"
            GOBACK
        END-IF
    END-IF
    IF WS-ACTION = "POST"
        PERFORM POST-EFFECT
        IF TXR-RC NOT = "00"
            GOBACK
        END-IF
        IF WS-CRASH = "AFTER-POST"
            MOVE "90" TO TXR-RC
            MOVE "SIMULATED CRASH BEFORE COMMIT" TO TXR-MSG
            GOBACK
        END-IF
        MOVE WS-BIZDATE TO TXN-POSTED
    END-IF
    IF WS-ACTION = "SETTLE"
        MOVE WS-BIZDATE TO TXN-SETTLED
    END-IF
    PERFORM COMMIT-TRANSITION
    IF TXR-RC NOT = "00"
        GOBACK
    END-IF
    IF WS-ACTION = "SETTLE"
        PERFORM CONSUME-LIMIT
    END-IF
    EVALUATE WS-ACTION
        WHEN "AUTH" MOVE "AUTHORIZED" TO TXR-MSG
        WHEN "POST" MOVE "POSTED" TO TXR-MSG
        WHEN "SETTLE" MOVE "SETTLED" TO TXR-MSG
        WHEN "COMPLETE" MOVE "COMPLETED" TO TXR-MSG
        WHEN "CANCEL" MOVE "CANCELLED" TO TXR-MSG
    END-EVALUATE
    GOBACK.

LOAD-TXN.
    MOVE SPACES TO BK-TXN-OUT
    MOVE WS-LOAD-ID TO TXN-ID
    MOVE "GET" TO TS-OP
    CALL "BTXNSTO" USING BK-TXN-STO-REQ BK-TXN-OUT
    IF TS-RC NOT = "00"
        MOVE TS-RC TO TXR-RC
        MOVE TS-MSG TO TXR-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE TXN-ID TO TXR-ID
    MOVE TXN-STATUS TO TXR-STATUS
    MOVE TXN-TYPE TO TXR-TYPE
    MOVE TXN-JRN-ID TO TXR-JRN-ID
    MOVE TXN-AMOUNT TO TXR-AMOUNT.

CHECK-TRANSITION.
    CALL "BTXNSTT" USING TXN-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE "20" TO TXR-RC
        MOVE WS-STT-MSG TO TXR-MSG
    END-IF.

COMMIT-TRANSITION.
    MOVE WS-NEXT TO TXN-STATUS
    PERFORM COMMIT-TXN.

COMMIT-TXN.
    ADD 1 TO TXN-VERSION
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO TS-OP
    CALL "BTXNSTO" USING BK-TXN-STO-REQ BK-TXN-OUT
    MOVE TS-RC TO TXR-RC
    IF TS-RC NOT = "00"
        MOVE TS-MSG TO TXR-MSG
    END-IF
    MOVE TXN-STATUS TO TXR-STATUS
    MOVE TXN-TYPE TO TXR-TYPE.

POST-EFFECT.
    MOVE TXN-ID TO TPO-TXN-ID
    MOVE TXN-TYPE TO TPO-TYPE
    MOVE TXN-STATUS TO TPO-STATUS
    MOVE TXN-SRC TO TPO-SRC
    MOVE TXN-DST TO TPO-DST
    MOVE TXN-AMOUNT TO TPO-AMOUNT
    MOVE TXN-CURRENCY TO TPO-CURRENCY
    MOVE TXN-DESCR TO TPO-DESCR
    MOVE TXN-OPERATOR TO TPO-OPERATOR
    MOVE TXN-CORR TO TPO-CORR
    MOVE TXN-REQUEST TO TPO-REQUEST
    MOVE TXN-REASON TO TPO-REASON
    MOVE TXN-ORIGIN TO TPO-ORIGIN
    MOVE TXN-REF TO TPO-REF
    MOVE TXN-FACILITY TO TPO-FACILITY
    MOVE TXN-PRINCIPAL TO TPO-PRINCIPAL
    MOVE TXN-INTEREST TO TPO-INTEREST
    MOVE TXN-FEE-AMT TO TPO-FEE-AMT
    MOVE TXN-DUE-DATE TO TPO-DUE-DATE
    MOVE TXN-INSTALLMENT TO TPO-INSTALLMENT
    MOVE TXN-SPLIT-CNT TO TPO-SPLIT-CNT
    IF TXN-SPLIT-CNT > 0
        PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I >
            TXN-SPLIT-CNT
            MOVE TXN-PS-SEQ(WS-I) TO TPO-PS-SEQ(WS-I)
            MOVE TXN-PS-ROLE(WS-I) TO TPO-PS-ROLE(WS-I)
            MOVE TXN-PS-DEST(WS-I) TO TPO-PS-DEST(WS-I)
            MOVE TXN-PS-AMT(WS-I) TO TPO-PS-AMT(WS-I)
            MOVE TXN-PS-TYPE(WS-I) TO TPO-PS-TYPE(WS-I)
        END-PERFORM
    END-IF
    MOVE WS-BIZDATE TO TPO-BIZDATE
    MOVE SPACES TO TPO-JRN-ID
    STRING "TXN" DELIMITED SIZE TXN-ID DELIMITED SIZE "-P" DELIMITED SIZE
        INTO TPO-JRN-ID
    END-STRING
    MOVE TPO-JRN-ID TO TXN-JRN-ID
    CALL "BTXNPOST" USING BK-TXN-POST-REQ
    MOVE TPO-RC TO TXR-RC
    MOVE TPO-MSG TO TXR-MSG.

COMPUTE-HASH.
    MOVE TXN-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(TXN-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-SRC) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-DST) DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        TXN-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(TXN-CURRENCY) DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO TXN-HASH.

CHECK-LIMIT.
    MOVE "CHANNEL" TO LIM-SCOPE
    MOVE "TXN" TO LIM-KEY
    MOVE "DAILY" TO LIM-PERIOD
    MOVE TXN-AMOUNT TO LIM-AMOUNT
    MOVE TXN-CURRENCY TO LIM-CURRENCY
    MOVE "CHECK" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ
    IF LIM-RC NOT = "00"
        MOVE LIM-RC TO TXR-RC
        MOVE LIM-MSG TO TXR-MSG
    END-IF.

CONSUME-LIMIT.
    MOVE "CHANNEL" TO LIM-SCOPE
    MOVE "TXN" TO LIM-KEY
    MOVE "DAILY" TO LIM-PERIOD
    MOVE TXN-AMOUNT TO LIM-AMOUNT
    MOVE TXN-CURRENCY TO LIM-CURRENCY
    MOVE "CONSUME" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ.

