IDENTIFICATION DIVISION.
PROGRAM-ID. BPRODCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(20).
01 WS-A PIC X(24).
01 WS-B PIC X(20).
01 WS-COUNT PIC 9(05).
01 WS-RC PIC X(02).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BPRODO".
01 WS-MIN-ED PIC -(15)9.99.
01 WS-DAILY-ED PIC -(15)9.99.
01 WS-MON-ED PIC -(15)9.99.
01 WS-FEE-ED PIC -(15)9.99.
01 WS-MIN-AMT-ED PIC -(15)9.99.
01 WS-MAX-AMT-ED PIC -(15)9.99.

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "init" PERFORM DO-INIT
        WHEN "get" PERFORM DO-GET
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN PRODUCT OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B
    END-UNSTRING.

DO-INIT.
    CALL "BPROD" USING WS-COUNT WS-RC
    DISPLAY "rc=" WS-RC
    DISPLAY "products=" WS-COUNT.

DO-GET.
    CALL "BCFG" USING WS-CFG
    CALL "BPRODQ" USING WS-A WS-BIZDATE BK-PROD-OUT
    DISPLAY "rc=" PQ-RC
    IF PQ-RC = "00"
        PERFORM SHOW-PRODUCT
    END-IF.

SHOW-PRODUCT.
    MOVE PR-MIN-BAL TO WS-MIN-ED
    MOVE PR-DAILY-LIMIT TO WS-DAILY-ED
    MOVE PR-MONTHLY-LIMIT TO WS-MON-ED
    MOVE PR-FEE TO WS-FEE-ED
    MOVE PR-MIN-AMOUNT TO WS-MIN-AMT-ED
    MOVE PR-MAX-AMOUNT TO WS-MAX-AMT-ED
    DISPLAY "id=" PR-ID
    DISPLAY "version=" PR-VERSION
    DISPLAY "status=" PR-STATUS
    DISPLAY "name=" FUNCTION TRIM(PR-NAME)
    DISPLAY "type=" FUNCTION TRIM(PR-TYPE)
    DISPLAY "currency=" PR-CURRENCY
    DISPLAY "effective=" PR-EFF
    DISPLAY "min-balance=" WS-MIN-ED
    DISPLAY "daily-limit=" WS-DAILY-ED
    DISPLAY "monthly-limit=" WS-MON-ED
    DISPLAY "interest-bps=" PR-INTEREST-BPS
    DISPLAY "fee=" WS-FEE-ED
    DISPLAY "min-amount=" WS-MIN-AMT-ED
    DISPLAY "max-amount=" WS-MAX-AMT-ED
    DISPLAY "max-term=" PR-MAX-TERM
    DISPLAY "basis=" PR-BASIS
    DISPLAY "alloc-order=" FUNCTION TRIM(PR-ALLOC-ORDER)
    DISPLAY "amort=" FUNCTION TRIM(PR-AMORT)
    DISPLAY "freq=" PR-FREQ
    DISPLAY "hash=" FUNCTION TRIM(PR-HASH).
