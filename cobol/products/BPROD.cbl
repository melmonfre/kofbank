IDENTIFICATION DIVISION.
PROGRAM-ID. BPROD.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT DEF-FILE ASSIGN TO WS-DEF-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-DEF-ST.
    SELECT PRD-FILE ASSIGN TO WS-PRD-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PR-KEY
        FILE STATUS IS WS-PRD-ST.

DATA DIVISION.
FILE SECTION.
FD DEF-FILE.
01 DEF-LINE PIC X(200).
FD PRD-FILE.
01 PRD-REC.
   COPY "BPROD".

WORKING-STORAGE SECTION.
01 WS-DEF-PATH PIC X(200).
01 WS-PRD-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-DEF-ST PIC X(02).
01 WS-PRD-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-COUNT PIC 9(05).
01 WS-OK PIC X(01).
01 WS-ID PIC X(04).
01 WS-VER-ED PIC X(05).
01 WS-EFF-IN PIC X(10).
01 WS-STATUS PIC X(02).
01 WS-NAME PIC X(40).
01 WS-TYPE PIC X(08).
01 WS-CUR PIC X(03).
01 WS-MIN-ED PIC X(20).
01 WS-DAILY-ED PIC X(20).
01 WS-MON-ED PIC X(20).
01 WS-BPS-ED PIC X(05).
01 WS-FEE-ED PIC X(20).
01 WS-MIN-AMT-ED PIC X(20).
01 WS-MAX-AMT-ED PIC X(20).
01 WS-MAX-TERM-ED PIC X(04).
01 WS-BASIS-ED PIC X(03).
01 WS-ALLOC-ED PIC X(16).
01 WS-AMORT-ED PIC X(12).
01 WS-FREQ-ED PIC X(02).
01 WS-YYYY PIC X(04).
01 WS-MM PIC X(02).
01 WS-DD PIC X(02).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).

LINKAGE SECTION.
01 LS-COUNT PIC 9(05).
01 LS-STATUS PIC X(02).

PROCEDURE DIVISION USING LS-COUNT LS-STATUS.
    MOVE 0 TO LS-COUNT
    MOVE "00" TO LS-STATUS
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-DEF-PATH
    STRING FUNCTION TRIM(WS-HOME) "/etc/product.def"
        DELIMITED SIZE INTO WS-DEF-PATH
    MOVE SPACES TO WS-PRD-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/prod.idx"
        DELIMITED SIZE INTO WS-PRD-PATH
    OPEN INPUT DEF-FILE
    IF WS-DEF-ST NOT = "00"
        MOVE "35" TO LS-STATUS
        GOBACK
    END-IF
    OPEN I-O PRD-FILE
    IF WS-PRD-ST = "35"
        OPEN OUTPUT PRD-FILE
        CLOSE PRD-FILE
        OPEN I-O PRD-FILE
    END-IF
    IF WS-PRD-ST NOT = "00"
        MOVE WS-PRD-ST TO LS-STATUS
        CLOSE DEF-FILE
        GOBACK
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ DEF-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM LOAD-LINE
        END-READ
    END-PERFORM
    CLOSE DEF-FILE
    CLOSE PRD-FILE
    MOVE WS-COUNT TO LS-COUNT
    GOBACK.

LOAD-LINE.
    IF DEF-LINE = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-ID WS-VER-ED WS-EFF-IN WS-STATUS WS-NAME WS-TYPE
        WS-CUR WS-MIN-ED WS-DAILY-ED WS-MON-ED WS-BPS-ED WS-FEE-ED
        WS-MIN-AMT-ED WS-MAX-AMT-ED WS-MAX-TERM-ED WS-BASIS-ED WS-ALLOC-ED
        WS-AMORT-ED WS-FREQ-ED
    UNSTRING DEF-LINE DELIMITED BY "|"
        INTO WS-ID WS-VER-ED WS-EFF-IN WS-STATUS WS-NAME WS-TYPE WS-CUR
        WS-MIN-ED WS-DAILY-ED WS-MON-ED WS-BPS-ED WS-FEE-ED
        WS-MIN-AMT-ED WS-MAX-AMT-ED WS-MAX-TERM-ED WS-BASIS-ED WS-ALLOC-ED
        WS-AMORT-ED WS-FREQ-ED
    END-UNSTRING
    MOVE WS-ID TO PR-ID
    MOVE WS-VER-ED TO PR-VERSION
    MOVE WS-STATUS TO PR-STATUS
    MOVE WS-NAME TO PR-NAME
    MOVE WS-TYPE TO PR-TYPE
    MOVE WS-CUR TO PR-CURRENCY
    PERFORM PARSE-DATE
    MOVE 0 TO PR-MIN-BAL
    IF WS-MIN-ED NOT = SPACES
        MOVE WS-MIN-ED TO PR-MIN-BAL
    END-IF
    MOVE 0 TO PR-DAILY-LIMIT
    IF WS-DAILY-ED NOT = SPACES
        MOVE WS-DAILY-ED TO PR-DAILY-LIMIT
    END-IF
    MOVE 0 TO PR-MONTHLY-LIMIT
    IF WS-MON-ED NOT = SPACES
        MOVE WS-MON-ED TO PR-MONTHLY-LIMIT
    END-IF
    MOVE 0 TO PR-INTEREST-BPS
    IF WS-BPS-ED NOT = SPACES
        MOVE WS-BPS-ED TO PR-INTEREST-BPS
    END-IF
    MOVE 0 TO PR-FEE
    IF WS-FEE-ED NOT = SPACES
        MOVE WS-FEE-ED TO PR-FEE
    END-IF
    MOVE 0 TO PR-MIN-AMOUNT
    IF WS-MIN-AMT-ED NOT = SPACES
        MOVE WS-MIN-AMT-ED TO PR-MIN-AMOUNT
    END-IF
    MOVE 0 TO PR-MAX-AMOUNT
    IF WS-MAX-AMT-ED NOT = SPACES
        MOVE WS-MAX-AMT-ED TO PR-MAX-AMOUNT
    END-IF
    MOVE 0 TO PR-MAX-TERM
    IF WS-MAX-TERM-ED NOT = SPACES
        MOVE WS-MAX-TERM-ED TO PR-MAX-TERM
    END-IF
    MOVE 0 TO PR-BASIS
    IF WS-BASIS-ED NOT = SPACES
        MOVE WS-BASIS-ED TO PR-BASIS
    END-IF
    MOVE SPACES TO PR-ALLOC-ORDER
    IF WS-ALLOC-ED NOT = SPACES
        MOVE WS-ALLOC-ED TO PR-ALLOC-ORDER
    END-IF
    MOVE SPACES TO PR-AMORT
    IF WS-AMORT-ED NOT = SPACES
        MOVE WS-AMORT-ED TO PR-AMORT
    END-IF
    MOVE 0 TO PR-FREQ
    IF WS-FREQ-ED NOT = SPACES
        MOVE WS-FREQ-ED TO PR-FREQ
    END-IF
    PERFORM COMPUTE-HASH
    READ PRD-FILE
    EVALUATE WS-PRD-ST
        WHEN "23"
            WRITE PRD-REC
            ADD 1 TO WS-COUNT
        WHEN "00"
            REWRITE PRD-REC
            ADD 1 TO WS-COUNT
        WHEN OTHER
            CONTINUE
    END-EVALUATE.

PARSE-DATE.
    MOVE 0 TO PR-EFF
    IF WS-EFF-IN = SPACES
        EXIT PARAGRAPH
    END-IF
    MOVE WS-EFF-IN(1:4) TO WS-YYYY
    MOVE WS-EFF-IN(6:2) TO WS-MM
    MOVE WS-EFF-IN(9:2) TO WS-DD
    MOVE WS-YYYY TO PR-EFF(1:4)
    MOVE WS-MM TO PR-EFF(5:2)
    MOVE WS-DD TO PR-EFF(7:2).

COMPUTE-HASH.
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(PR-ID) DELIMITED SIZE "|" DELIMITED SIZE
        PR-VERSION DELIMITED SIZE "|" DELIMITED SIZE
        PR-EFF DELIMITED SIZE "|" DELIMITED SIZE
        PR-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PR-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PR-CURRENCY) DELIMITED SIZE "|" DELIMITED SIZE
        PR-MAX-TERM DELIMITED SIZE "|" DELIMITED SIZE
        PR-BASIS DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PR-ALLOC-ORDER) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PR-AMORT) DELIMITED SIZE "|" DELIMITED SIZE
        PR-FREQ DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO PR-HASH.
