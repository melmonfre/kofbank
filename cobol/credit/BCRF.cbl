IDENTIFICATION DIVISION.
PROGRAM-ID. BCRF.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BCRSTO".
COPY "BCRENVP".
COPY "BCREXP".
COPY "BCRAP".
COPY "BDATP".
01 WS-HOME PIC X(80).
01 WS-ACTION PIC X(12).
01 WS-NEXT PIC X(04).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CREDITFAC".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-EVT-BUF PIC X(200).
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 BK-CR-FAC.
   COPY "BCRF".
01 BK-CR-APP.
   COPY "BCRA".

LINKAGE SECTION.
COPY "BCRFP".

PROCEDURE DIVISION USING BK-CR-FAC-PARMS.
    MOVE "00" TO CF-RC
    MOVE SPACES TO CF-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CF-RC
        MOVE "CONFIG MISSING" TO CF-MSG
        GOBACK
    END-IF
    MOVE "BEGIN" TO CEN-OP
    MOVE CF-REQUEST TO CEN-REQUEST
    MOVE "CREDIT.FAC" TO CEN-OPERATION
    MOVE CF-OPERATOR TO CEN-OPERATOR
    MOVE CF-CORR TO CEN-CORR
    CALL "BCRENV" USING BK-CR-ENV
    IF CEN-HIT = "Y"
        MOVE CEN-ENTITY TO CF-FAC-ID
        MOVE "00" TO CF-RC
        MOVE CEN-MSG TO CF-MSG
        GOBACK
    END-IF
    IF CEN-RC NOT = "00"
        MOVE CEN-RC TO CF-RC
        MOVE CEN-MSG TO CF-MSG
        GOBACK
    END-IF
    EVALUATE CF-OP
        WHEN "CONTRACT" PERFORM DO-CONTRACT
        WHEN "ACTIVATE" PERFORM DO-ACTIVATE
        WHEN "APPROVE" PERFORM DO-ACTION
        WHEN "SUSPEND" PERFORM DO-ACTION
        WHEN "RESUME" PERFORM DO-ACTION
        WHEN "BLOCK" PERFORM DO-ACTION
        WHEN "UNBLOCK" PERFORM DO-ACTION
        WHEN "EXPIRE" PERFORM DO-ACTION
        WHEN "MATURE" PERFORM DO-ACTION
        WHEN "CLOSE" PERFORM DO-ACTION
        WHEN "CANCEL" PERFORM DO-ACTION
        WHEN "DEFAULT" PERFORM DO-ACTION
        WHEN OTHER
            MOVE "99" TO CF-RC
            MOVE "UNKNOWN FACILITY OP" TO CF-MSG
    END-EVALUATE
    MOVE CF-FAC-ID TO CEN-ENTITY
    MOVE CRF-STATUS TO CEN-STATUS
    MOVE CF-MSG TO CEN-MSG
    MOVE CF-RC TO CEN-RC
    MOVE CRF-APPROVED TO CEN-AMOUNT
    MOVE CRF-CURRENCY TO CEN-CURRENCY
    MOVE "CREDIT.FACILITY" TO CEN-EVT-PREFIX
    MOVE "END" TO CEN-OP
    CALL "BCRENV" USING BK-CR-ENV
    GOBACK.

DO-ACTION.
    PERFORM LOAD-FAC
    IF CF-RC NOT = "00"
        GOBACK
    END-IF
    MOVE CF-OP TO WS-ACTION
    IF CF-OP = "MATURE" OR CF-OP = "CLOSE"
        PERFORM CHECK-NO-PRINCIPAL
        IF CF-RC NOT = "00"
            GOBACK
        END-IF
    END-IF
    IF CF-OP = "CANCEL" OR CF-OP = "DEFAULT"
        MOVE CF-REASON TO CRF-REASON
    END-IF
    PERFORM TRANSITION
    IF CF-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM SAVE-FAC
    IF CF-OP NOT = "APPROVE"
        PERFORM SET-EXP-STATUS
    END-IF
    MOVE SPACES TO CF-MSG
    STRING "FACILITY " DELIMITED SIZE FUNCTION TRIM(CF-OP) DELIMITED SIZE
        INTO CF-MSG
    END-STRING.

DO-CONTRACT.
    PERFORM LOAD-FAC
    IF CF-RC NOT = "00"
        GOBACK
    END-IF
    IF CF-AMOUNT > 0
        MOVE CF-AMOUNT TO CRF-CONTRACTED
    ELSE
        MOVE CRF-APPROVED TO CRF-CONTRACTED
    END-IF
    IF CRF-CONTRACTED <= 0
        MOVE "20" TO CF-RC
        MOVE "CONTRACTED AMOUNT REQUIRED" TO CF-MSG
        GOBACK
    END-IF
    IF CRF-CONTRACTED > CRF-APPROVED
        MOVE "20" TO CF-RC
        MOVE "CONTRACTED EXCEEDS APPROVED" TO CF-MSG
        GOBACK
    END-IF
    MOVE "CONTRACT" TO WS-ACTION
    PERFORM TRANSITION
    IF CF-RC NOT = "00"
        GOBACK
    END-IF
    MOVE WS-BIZDATE TO CRF-EFF
    IF CF-COLLATERAL NOT = SPACES
        MOVE CF-COLLATERAL TO CRF-COLLATERAL
    END-IF
    IF CF-CONDITIONS NOT = SPACES
        MOVE CF-CONDITIONS TO CRF-CONDITIONS
    END-IF
    MOVE "ADD-MONTHS" TO DAT-OP
    MOVE WS-BIZDATE TO DAT-DATE
    MOVE CRF-TERM TO DAT-MONTHS
    CALL "BDAT" USING BK-DAT-PARMS
    MOVE DAT-RESULT TO CRF-MATURITY
    PERFORM SAVE-FAC
    PERFORM MARK-APP-CONTRACTED
    MOVE "FACILITY CONTRACTED" TO CF-MSG.

DO-ACTIVATE.
    PERFORM LOAD-FAC
    IF CF-RC NOT = "00"
        GOBACK
    END-IF
    IF CRF-EFF = 0 OR CRF-EFF > WS-BIZDATE
        MOVE "20" TO CF-RC
        MOVE "FACILITY NOT EFFECTIVE" TO CF-MSG
        GOBACK
    END-IF
    IF CRF-CONTRACTED <= 0
        MOVE "20" TO CF-RC
        MOVE "FACILITY NOT CONTRACTED" TO CF-MSG
        GOBACK
    END-IF
    MOVE "ACTIVATE" TO WS-ACTION
    PERFORM TRANSITION
    IF CF-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM SAVE-FAC
    MOVE "OPEN" TO CE-OP
    MOVE CRF-ID TO CE-FAC-ID
    MOVE CRF-CONTRACTED TO CE-AMOUNT
    MOVE CRF-APPROVED TO CE-PRINCIPAL
    MOVE CRF-STATUS TO CE-STATUS
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    MOVE "FACILITY ACTIVE" TO CF-MSG.

LOAD-FAC.
    MOVE SPACES TO BK-CR-FAC
    MOVE CF-FAC-ID TO CRF-ID
    MOVE "GET" TO CS-OP
    CALL "BCRFSTO" USING BK-CR-STO-REQ BK-CR-FAC
    IF CS-RC NOT = "00"
        MOVE CS-RC TO CF-RC
        MOVE "FACILITY NOT FOUND" TO CF-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CRF-ID TO CF-FAC-ID.

TRANSITION.
    CALL "BCRFST" USING CRF-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE "20" TO CF-RC
        MOVE WS-STT-MSG TO CF-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NEXT TO CRF-STATUS.

SAVE-FAC.
    MOVE WS-BIZDATE TO CRF-UPDATED
    ADD 1 TO CRF-VERSION
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO CS-OP
    CALL "BCRFSTO" USING BK-CR-STO-REQ BK-CR-FAC
    IF CS-RC NOT = "00"
        MOVE CS-RC TO CF-RC
        MOVE CS-MSG TO CF-MSG
        GOBACK
    END-IF
    MOVE CRF-ID TO CF-FAC-ID.

MARK-APP-CONTRACTED.
    MOVE CRF-APP-ID TO CRA-ID
    MOVE "CONTRACT" TO WS-ACTION
    CALL "BCRAST" USING CRA-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NEXT TO CRA-STATUS
    MOVE WS-BIZDATE TO CRA-UPDATED
    ADD 1 TO CRA-VERSION
    MOVE "REWRITE" TO CS-OP
    CALL "BCRASTO" USING BK-CR-STO-REQ BK-CR-APP.

CHECK-NO-PRINCIPAL.
    MOVE CF-FAC-ID TO CE-FAC-ID
    MOVE "GET" TO CE-OP
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        MOVE "20" TO CF-RC
        MOVE "EXPOSURE NOT FOUND" TO CF-MSG
        GOBACK
    END-IF
    IF CE-PRINCIPAL > 0
        MOVE "20" TO CF-RC
        MOVE "OUTSTANDING PRINCIPAL" TO CF-MSG
    END-IF.

OPEN-EXPOSURE.
    MOVE "OPEN" TO CE-OP
    MOVE CRF-ID TO CE-FAC-ID
    MOVE CRF-CONTRACTED TO CE-AMOUNT
    MOVE CRF-APPROVED TO CE-PRINCIPAL
    MOVE CRF-PRODUCT TO CE-FEES
    MOVE CRF-CURRENCY TO CE-STATUS
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        MOVE CE-RC TO CF-RC
        MOVE CE-MSG TO CF-MSG
    END-IF.

SET-EXP-STATUS.
    MOVE "STATUS" TO CE-OP
    MOVE CRF-ID TO CE-FAC-ID
    MOVE CRF-STATUS TO CE-STATUS
    CALL "BCRUPD" USING BK-CR-EXP-PARMS.

COMPUTE-HASH.
    MOVE CRF-APPROVED TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(CRF-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CRF-CUST-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CRF-PRODUCT) DELIMITED SIZE "|" DELIMITED SIZE
        CRF-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        CRF-VERSION DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO CRF-HASH.


