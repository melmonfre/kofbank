IDENTIFICATION DIVISION.
PROGRAM-ID. BCRFQ.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT FAC-FILE ASSIGN TO WS-FAC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CRF-ID
        FILE STATUS IS WS-FAC-ST.

DATA DIVISION.
FILE SECTION.
FD FAC-FILE.
01 FAC-REC.
   COPY "BCRF".

WORKING-STORAGE SECTION.
01 WS-FAC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-FAC-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-COUNT PIC 9(06).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-CON-ED PIC -(15)9.99.

LINKAGE SECTION.
01 LS-OP PIC X(08).
01 LS-ID PIC X(12).
01 LS-RC PIC X(02).

PROCEDURE DIVISION USING LS-OP LS-ID LS-RC.
    MOVE "00" TO LS-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-FAC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crfac.idx"
        DELIMITED SIZE INTO WS-FAC-PATH
    OPEN INPUT FAC-FILE
    IF WS-FAC-ST NOT = "00"
        MOVE "35" TO LS-RC
        GOBACK
    END-IF
    EVALUATE LS-OP
        WHEN "GET" PERFORM DO-GET
        WHEN "LIST" PERFORM DO-LIST
        WHEN OTHER MOVE "99" TO LS-RC
    END-EVALUATE
    CLOSE FAC-FILE
    GOBACK.

DO-GET.
    MOVE LS-ID TO CRF-ID
    READ FAC-FILE
    IF WS-FAC-ST = "00"
        PERFORM SHOW-FAC
    ELSE
        MOVE "23" TO LS-RC
    END-IF.

DO-LIST.
    MOVE 0 TO WS-COUNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ FAC-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                ADD 1 TO WS-COUNT
                PERFORM SHOW-FAC
        END-READ
    END-PERFORM
    DISPLAY "facilities=" WS-COUNT.

SHOW-FAC.
    MOVE CRF-APPROVED TO WS-AMT-ED
    MOVE CRF-CONTRACTED TO WS-CON-ED
    DISPLAY "facility=" FUNCTION TRIM(CRF-ID)
    DISPLAY "customer=" FUNCTION TRIM(CRF-CUST-ID)
    DISPLAY "product=" FUNCTION TRIM(CRF-PRODUCT)
    DISPLAY "account=" FUNCTION TRIM(CRF-ACCOUNT)
    DISPLAY "application=" FUNCTION TRIM(CRF-APP-ID)
    DISPLAY "status=" FUNCTION TRIM(CRF-STATUS)
    DISPLAY "approved=" WS-AMT-ED
    DISPLAY "contracted=" WS-CON-ED
    DISPLAY "currency=" FUNCTION TRIM(CRF-CURRENCY)
    DISPLAY "term=" CRF-TERM
    DISPLAY "rate-bps=" CRF-RATE-BPS
    DISPLAY "effective=" CRF-EFF
    DISPLAY "expires=" CRF-EXPIRES
    DISPLAY "maturity=" CRF-MATURITY.
