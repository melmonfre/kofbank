IDENTIFICATION DIVISION.
PROGRAM-ID. BCRA.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BCRSTO".
COPY "BCRENVP".
COPY "BPRODO".
01 WS-HOME PIC X(80).
01 WS-ACTION PIC X(12).
01 WS-NEXT PIC X(04).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CREDITAPP".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 WS-CUST-OUT.
   05 WS-CO-ID PIC X(12).
   05 WS-CO-TYPE PIC X(01).
   05 WS-CO-STATUS PIC X(02).
   05 WS-CO-NAME PIC X(60).
   05 WS-CO-DOC-TYPE PIC X(04).
   05 WS-CO-DOC PIC X(20).
   05 WS-CO-BIRTH PIC 9(08).
   05 WS-CO-RISK PIC X(02).
   05 WS-CO-KYC PIC X(02).
   05 WS-CO-ADDR PIC X(80).
   05 WS-CO-VERSION PIC 9(05).
   05 WS-CO-HASH PIC X(16).
   05 WS-CO-RC PIC X(02).
01 BK-CR-APP.
   COPY "BCRA".

LINKAGE SECTION.
COPY "BCRAP".

PROCEDURE DIVISION USING BK-CR-APP-PARMS.
    MOVE "00" TO CA-RC
    MOVE SPACES TO CA-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CA-RC
        MOVE "CONFIG MISSING" TO CA-MSG
        GOBACK
    END-IF
    MOVE "BEGIN" TO CEN-OP
    MOVE CA-REQUEST TO CEN-REQUEST
    MOVE "CREDIT.APP" TO CEN-OPERATION
    MOVE CA-OPERATOR TO CEN-OPERATOR
    MOVE CA-CORR TO CEN-CORR
    CALL "BCRENV" USING BK-CR-ENV
    IF CEN-HIT = "Y"
        MOVE CEN-ENTITY TO CA-APP-ID
        MOVE "00" TO CA-RC
        MOVE CEN-MSG TO CA-MSG
        GOBACK
    END-IF
    IF CEN-RC NOT = "00"
        MOVE CEN-RC TO CA-RC
        MOVE CEN-MSG TO CA-MSG
        GOBACK
    END-IF
    EVALUATE CA-OP
        WHEN "CREATE" PERFORM DO-CREATE
        WHEN "APPROVE" PERFORM DO-ACTION
        WHEN "CONDITION" PERFORM DO-ACTION
        WHEN "SATISFY" PERFORM DO-ACTION
        WHEN "REJECT" PERFORM DO-ACTION
        WHEN "CANCEL" PERFORM DO-ACTION
        WHEN "EXPIRE" PERFORM DO-ACTION
        WHEN "CONTRACT" PERFORM DO-ACTION
        WHEN OTHER
            MOVE "99" TO CA-RC
            MOVE "UNKNOWN APPLICATION OP" TO CA-MSG
    END-EVALUATE
    MOVE CA-APP-ID TO CEN-ENTITY
    MOVE CRA-STATUS TO CEN-STATUS
    MOVE CA-MSG TO CEN-MSG
    MOVE CA-RC TO CEN-RC
    MOVE CRA-REQUESTED TO CEN-AMOUNT
    MOVE CRA-CURRENCY TO CEN-CURRENCY
    MOVE "CREDIT.APPLICATION" TO CEN-EVT-PREFIX
    MOVE "END" TO CEN-OP
    CALL "BCRENV" USING BK-CR-ENV
    GOBACK.

DO-CREATE.
    PERFORM VALIDATE-INPUT
    IF CA-RC NOT = "00"
        GOBACK
    END-IF
    MOVE SPACES TO BK-CR-APP
    PERFORM BUILD-ID
    MOVE CA-APP-ID TO CRA-ID
    MOVE CA-CUST-ID TO CRA-CUST-ID
    MOVE CA-PRODUCT TO CRA-PRODUCT
    MOVE CA-ACCOUNT TO CRA-ACCOUNT
    MOVE "RCV" TO CRA-STATUS
    MOVE CA-REQUESTED TO CRA-REQUESTED
    MOVE 0 TO CRA-APPROVED
    MOVE WS-CURRENCY TO CRA-CURRENCY
    MOVE CA-TERM TO CRA-TERM
    MOVE PR-BASIS TO CRA-BASIS
    MOVE PR-INTEREST-BPS TO CRA-RATE-BPS
    MOVE WS-BIZDATE TO CRA-EFF
    MOVE 0 TO CRA-EXPIRES
    MOVE SPACES TO CRA-CONDITIONS
    MOVE SPACES TO CRA-REASON
    MOVE WS-BIZDATE TO CRA-CREATED
    MOVE WS-BIZDATE TO CRA-UPDATED
    MOVE 1 TO CRA-VERSION
    PERFORM COMPUTE-HASH
    MOVE "WRITE" TO CS-OP
    CALL "BCRASTO" USING BK-CR-STO-REQ BK-CR-APP
    IF CS-RC NOT = "00"
        MOVE CS-RC TO CA-RC
        MOVE CS-MSG TO CA-MSG
        GOBACK
    END-IF
    MOVE "UND" TO WS-NEXT
    MOVE WS-NEXT TO CRA-STATUS
    ADD 1 TO CRA-VERSION
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO CS-OP
    CALL "BCRASTO" USING BK-CR-STO-REQ BK-CR-APP
    MOVE CRA-ID TO CA-APP-ID
    MOVE "CREATED" TO CA-MSG.

DO-ACTION.
    PERFORM LOAD-APP
    IF CA-RC NOT = "00"
        GOBACK
    END-IF
    MOVE CA-OP TO WS-ACTION
    IF CA-OP = "REJECT" AND CA-REASON = SPACES
        MOVE "20" TO CA-RC
        MOVE "REASON REQUIRED" TO CA-MSG
        GOBACK
    END-IF
    IF CA-OP = "CONDITION" AND CA-CONDITIONS = SPACES
        MOVE "20" TO CA-RC
        MOVE "CONDITIONS REQUIRED" TO CA-MSG
        GOBACK
    END-IF
    PERFORM TRANSITION
    IF CA-RC NOT = "00"
        GOBACK
    END-IF
    IF CA-OP = "APPROVE" OR CA-OP = "CONDITION"
        IF CA-APPROVED > 0
            MOVE CA-APPROVED TO CRA-APPROVED
        ELSE
            MOVE CRA-REQUESTED TO CRA-APPROVED
        END-IF
    END-IF
    IF CA-OP = "CONDITION" OR CA-OP = "APPROVE"
        MOVE CA-CONDITIONS TO CRA-CONDITIONS
    END-IF
    IF CA-OP = "REJECT" OR CA-OP = "CANCEL"
        MOVE CA-REASON TO CRA-REASON
    END-IF
    PERFORM SAVE-APP
    EVALUATE CA-OP
        WHEN "APPROVE" MOVE "APPROVED" TO CA-MSG
        WHEN "CONDITION" MOVE "CONDITIONAL" TO CA-MSG
        WHEN "SATISFY" MOVE "CONDITIONS SATISFIED" TO CA-MSG
        WHEN "REJECT" MOVE "REJECTED" TO CA-MSG
        WHEN "CANCEL" MOVE "CANCELLED" TO CA-MSG
        WHEN "EXPIRE" MOVE "EXPIRED" TO CA-MSG
        WHEN "CONTRACT" MOVE "CONTRACTED" TO CA-MSG
    END-EVALUATE.

LOAD-APP.
    MOVE CA-APP-ID TO CRA-ID
    MOVE "GET" TO CS-OP
    MOVE SPACES TO BK-CR-APP
    MOVE CA-APP-ID TO CRA-ID
    CALL "BCRASTO" USING BK-CR-STO-REQ BK-CR-APP
    IF CS-RC NOT = "00"
        MOVE CS-RC TO CA-RC
        MOVE "APPLICATION NOT FOUND" TO CA-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CRA-ID TO CA-APP-ID
    MOVE CRA-CURRENCY TO WS-CURRENCY.

TRANSITION.
    CALL "BCRAST" USING CRA-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE "20" TO CA-RC
        MOVE WS-STT-MSG TO CA-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-NEXT TO CRA-STATUS.

SAVE-APP.
    MOVE WS-BIZDATE TO CRA-UPDATED
    ADD 1 TO CRA-VERSION
    PERFORM COMPUTE-HASH
    MOVE "REWRITE" TO CS-OP
    CALL "BCRASTO" USING BK-CR-STO-REQ BK-CR-APP
    IF CS-RC NOT = "00"
        MOVE CS-RC TO CA-RC
        MOVE CS-MSG TO CA-MSG
        GOBACK
    END-IF
    MOVE CRA-ID TO CA-APP-ID.

VALIDATE-INPUT.
    IF CA-CUST-ID = SPACES OR CA-PRODUCT = SPACES
        MOVE "20" TO CA-RC
        MOVE "CUSTOMER AND PRODUCT REQUIRED" TO CA-MSG
        GOBACK
    END-IF
    IF CA-REQUESTED <= 0
        MOVE "20" TO CA-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO CA-MSG
        GOBACK
    END-IF
    CALL "BCUSTQ" USING CA-CUST-ID WS-CUST-OUT
    IF WS-CO-RC NOT = "00"
        MOVE "20" TO CA-RC
        MOVE "CUSTOMER NOT FOUND" TO CA-MSG
        GOBACK
    END-IF
    IF WS-CO-STATUS NOT = "AC"
        MOVE "20" TO CA-RC
        MOVE "CUSTOMER NOT ACTIVE" TO CA-MSG
        GOBACK
    END-IF
    CALL "BPRODQ" USING CA-PRODUCT WS-BIZDATE BK-PROD-OUT
    IF PQ-RC NOT = "00"
        MOVE "20" TO CA-RC
        MOVE "UNKNOWN CREDIT PRODUCT" TO CA-MSG
        GOBACK
    END-IF
    IF PR-TYPE NOT = "CREDIT"
        MOVE "20" TO CA-RC
        MOVE "PRODUCT IS NOT CREDIT" TO CA-MSG
        GOBACK
    END-IF
    IF CA-REQUESTED < PR-MIN-AMOUNT OR CA-REQUESTED > PR-MAX-AMOUNT
        MOVE "20" TO CA-RC
        MOVE "AMOUNT OUTSIDE PRODUCT RANGE" TO CA-MSG
        GOBACK
    END-IF
    IF CA-TERM = 0 OR CA-TERM > PR-MAX-TERM
        MOVE "20" TO CA-RC
        MOVE "TERM OUTSIDE PRODUCT RANGE" TO CA-MSG
        GOBACK
    END-IF
    MOVE PR-CURRENCY TO WS-CURRENCY.

BUILD-ID.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    IF WS-SEQ-ST NOT = "00"
        MOVE WS-SEQ-ST TO CA-RC
        MOVE "SEQUENCE ERROR" TO CA-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CA-APP-ID
    STRING "L" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CA-APP-ID
    END-STRING.

COMPUTE-HASH.
    MOVE CRA-REQUESTED TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(CRA-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CRA-CUST-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CRA-PRODUCT) DELIMITED SIZE "|" DELIMITED SIZE
        CRA-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        CRA-VERSION DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO CRA-HASH.


