IDENTIFICATION DIVISION.
PROGRAM-ID. BCRFORG.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BCRSTO".
COPY "BCRENVP".
COPY "BCRAP".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CREDITFAC".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 BK-CR-FAC.
   COPY "BCRF".
01 BK-CR-APP.
   COPY "BCRA".

LINKAGE SECTION.
COPY "BCRFP".

PROCEDURE DIVISION USING BK-CR-FAC-PARMS.
    MOVE "00" TO CF-RC
    MOVE SPACES TO CF-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CF-RC
        MOVE "CONFIG MISSING" TO CF-MSG
        GOBACK
    END-IF
    MOVE "BEGIN" TO CEN-OP
    MOVE CF-REQUEST TO CEN-REQUEST
    MOVE "CREDIT.FAC.ORIGINATE" TO CEN-OPERATION
    MOVE CF-OPERATOR TO CEN-OPERATOR
    MOVE CF-CORR TO CEN-CORR
    CALL "BCRENV" USING BK-CR-ENV
    IF CEN-HIT = "Y"
        MOVE CEN-ENTITY TO CF-FAC-ID
        MOVE "00" TO CF-RC
        MOVE CEN-MSG TO CF-MSG
        GOBACK
    END-IF
    IF CEN-RC NOT = "00"
        MOVE CEN-RC TO CF-RC
        MOVE CEN-MSG TO CF-MSG
        GOBACK
    END-IF
    PERFORM DO-ORIGINATE
    MOVE CF-FAC-ID TO CEN-ENTITY
    MOVE CRF-STATUS TO CEN-STATUS
    MOVE CF-MSG TO CEN-MSG
    MOVE CF-RC TO CEN-RC
    MOVE CRF-APPROVED TO CEN-AMOUNT
    MOVE CRF-CURRENCY TO CEN-CURRENCY
    MOVE "CREDIT.FACILITY" TO CEN-EVT-PREFIX
    MOVE "END" TO CEN-OP
    CALL "BCRENV" USING BK-CR-ENV
    GOBACK.

DO-ORIGINATE.
    IF CF-APP-ID = SPACES
        MOVE "20" TO CF-RC
        MOVE "APPLICATION REQUIRED" TO CF-MSG
        GOBACK
    END-IF
    MOVE SPACES TO BK-CR-APP
    MOVE CF-APP-ID TO CRA-ID
    MOVE "GET" TO CS-OP
    CALL "BCRASTO" USING BK-CR-STO-REQ BK-CR-APP
    IF CS-RC NOT = "00"
        MOVE "20" TO CF-RC
        MOVE "APPLICATION NOT FOUND" TO CF-MSG
        GOBACK
    END-IF
    IF CRA-STATUS NOT = "APV"
        MOVE "20" TO CF-RC
        MOVE "APPLICATION NOT APPROVED" TO CF-MSG
        GOBACK
    END-IF
    MOVE SPACES TO BK-CR-FAC
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO CF-FAC-ID
    STRING "F" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO CF-FAC-ID
    END-STRING
    MOVE CF-FAC-ID TO CRF-ID
    MOVE CRA-CUST-ID TO CRF-CUST-ID
    MOVE CRA-PRODUCT TO CRF-PRODUCT
    MOVE CF-ACCOUNT TO CRF-ACCOUNT
    MOVE CRA-ID TO CRF-APP-ID
    MOVE "REQ" TO CRF-STATUS
    MOVE CRA-APPROVED TO CRF-APPROVED
    MOVE 0 TO CRF-CONTRACTED
    MOVE CRA-CURRENCY TO CRF-CURRENCY
    MOVE CRA-TERM TO CRF-TERM
    MOVE CRA-BASIS TO CRF-BASIS
    MOVE CRA-RATE-BPS TO CRF-RATE-BPS
    MOVE 0 TO CRF-EFF
    MOVE CF-EXPIRES TO CRF-EXPIRES
    MOVE 0 TO CRF-MATURITY
    MOVE CF-COLLATERAL TO CRF-COLLATERAL
    MOVE CRA-CONDITIONS TO CRF-CONDITIONS
    MOVE SPACES TO CRF-REASON
    MOVE WS-BIZDATE TO CRF-CREATED
    MOVE WS-BIZDATE TO CRF-UPDATED
    MOVE 1 TO CRF-VERSION
    PERFORM COMPUTE-HASH
    MOVE "WRITE" TO CS-OP
    CALL "BCRFSTO" USING BK-CR-STO-REQ BK-CR-FAC
    IF CS-RC NOT = "00"
        MOVE CS-RC TO CF-RC
        MOVE CS-MSG TO CF-MSG
        GOBACK
    END-IF
    MOVE "ORIGINATED" TO CF-MSG.

COMPUTE-HASH.
    MOVE CRF-APPROVED TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(CRF-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CRF-CUST-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(CRF-PRODUCT) DELIMITED SIZE "|" DELIMITED SIZE
        CRF-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        CRF-VERSION DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO CRF-HASH.
