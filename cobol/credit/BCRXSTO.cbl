IDENTIFICATION DIVISION.
PROGRAM-ID. BCRXSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT EXP-FILE ASSIGN TO WS-EXP-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CX-FAC-ID
        FILE STATUS IS WS-EXP-ST.

DATA DIVISION.
FILE SECTION.
FD EXP-FILE.
01 EXP-REC.
   COPY "BCEXP".

WORKING-STORAGE SECTION.
01 WS-EXP-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-EXP-ST PIC X(02).

LINKAGE SECTION.
COPY "BCRSTO".
01 BK-CR-EXP-REC.
   COPY "BCEXP".

PROCEDURE DIVISION USING BK-CR-STO-REQ BK-CR-EXP-REC.
    MOVE "00" TO CS-RC
    MOVE SPACES TO CS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-EXP-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crexp.idx"
        DELIMITED SIZE INTO WS-EXP-PATH
    PERFORM OPEN-STORE
    IF CS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE CS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "UPDATE" PERFORM DO-UPDATE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO CS-RC
            MOVE "UNKNOWN CREDIT EXPOSURE STORE OP" TO CS-MSG
    END-EVALUATE
    CLOSE EXP-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O EXP-FILE
    IF WS-EXP-ST = "35"
        OPEN OUTPUT EXP-FILE
        CLOSE EXP-FILE
        OPEN I-O EXP-FILE
    END-IF
    IF WS-EXP-ST NOT = "00"
        MOVE WS-EXP-ST TO CS-RC
        MOVE "CANNOT OPEN CREDIT EXPOSURE INDEX" TO CS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CR-EXP-REC TO EXP-REC
    WRITE EXP-REC
        INVALID KEY
            MOVE "22" TO CS-RC
            MOVE "CREDIT EXPOSURE ALREADY EXISTS" TO CS-MSG
    END-WRITE.

DO-UPDATE.
    MOVE CX-FAC-ID OF BK-CR-EXP-REC TO CX-FAC-ID OF EXP-REC
    READ EXP-FILE
    IF WS-EXP-ST = "00"
        MOVE BK-CR-EXP-REC TO EXP-REC
        REWRITE EXP-REC
    ELSE
        MOVE BK-CR-EXP-REC TO EXP-REC
        WRITE EXP-REC
    END-IF.

DO-GET.
    MOVE CX-FAC-ID OF BK-CR-EXP-REC TO CX-FAC-ID OF EXP-REC
    READ EXP-FILE
    IF WS-EXP-ST = "00"
        MOVE EXP-REC TO BK-CR-EXP-REC
        MOVE "00" TO CS-RC
    ELSE
        MOVE "23" TO CS-RC
        MOVE "CREDIT EXPOSURE NOT FOUND" TO CS-MSG
    END-IF.
