IDENTIFICATION DIVISION.
PROGRAM-ID. BCRDIS.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BCRSTO".
COPY "BCRENVP".
COPY "BCREXP".
COPY "BCRAP".
COPY "BTXNLFC".
COPY "BTXNRESP".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CREDITTXN".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-TXNREQ PIC X(24).
01 WS-TXNTYPE PIC X(08).
01 WS-TXNSRC PIC X(12).
01 WS-TXNDST PIC X(12).
01 WS-TXNAMT PIC S9(15)V99 COMP-3.
01 WS-TXNPRIN PIC S9(15)V99 COMP-3.
01 WS-TXNINT PIC S9(15)V99 COMP-3.
01 WS-TXNFEE PIC S9(15)V99 COMP-3.
01 WS-DESCR PIC X(40).
01 WS-TXN-OK PIC X(01).
01 WS-INST PIC 9(04).
01 WS-A PIC 9(02).
01 WS-REMAIN PIC S9(15)V99 COMP-3.
01 WS-PAY PIC S9(15)V99 COMP-3.
01 WS-DUE PIC S9(15)V99 COMP-3.
01 WS-PAIDTOT PIC S9(15)V99 COMP-3.
01 BK-CR-FAC.
   COPY "BCRF".
01 BK-CR-OBL.
   COPY "BCRO".

LINKAGE SECTION.
COPY "BCRDP".

PROCEDURE DIVISION USING BK-CR-DISB-PARMS.
    MOVE "00" TO CD-RC
    MOVE SPACES TO CD-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CD-RC
        MOVE "CONFIG MISSING" TO CD-MSG
        GOBACK
    END-IF
    MOVE "BEGIN" TO CEN-OP
    MOVE CD-REQUEST TO CEN-REQUEST
    MOVE "CREDIT.DISBURSE" TO CEN-OPERATION
    MOVE CD-OPERATOR TO CEN-OPERATOR
    MOVE CD-CORR TO CEN-CORR
    CALL "BCRENV" USING BK-CR-ENV
    IF CEN-HIT = "Y"
        MOVE CEN-ENTITY TO CD-TXN-ID
        MOVE "00" TO CD-RC
        MOVE CEN-MSG TO CD-MSG
        GOBACK
    END-IF
    IF CEN-RC NOT = "00"
        MOVE CEN-RC TO CD-RC
        MOVE CEN-MSG TO CD-MSG
        GOBACK
    END-IF
    PERFORM LOAD-FAC
    IF CD-RC NOT = "00"
        GOBACK
    END-IF
    IF CRF-STATUS NOT = "ACT"
        MOVE "20" TO CD-RC
        MOVE "FACILITY NOT ACTIVE" TO CD-MSG
        GOBACK
    END-IF
    MOVE CD-AMOUNT TO WS-TXNPRIN
    MOVE CD-FEE TO WS-TXNFEE
    IF WS-TXNPRIN <= 0
        MOVE CRF-CONTRACTED TO WS-TXNPRIN
    END-IF
    COMPUTE WS-TXNAMT = WS-TXNPRIN + WS-TXNFEE
    MOVE "CREDDISB" TO WS-TXNTYPE
    MOVE SPACES TO WS-TXNSRC
    MOVE CRF-ACCOUNT TO WS-TXNDST
    MOVE "CREDIT DISBURSEMENT" TO WS-DESCR
    MOVE 0 TO WS-TXNINT
    PERFORM CHECK-LIMIT
    IF CD-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM RUN-TXN
    IF CD-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "DISBURSE" TO CE-OP
    MOVE CRF-ID TO CE-FAC-ID
    MOVE WS-TXNPRIN TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        MOVE CE-RC TO CD-RC
        MOVE CE-MSG TO CD-MSG
        GOBACK
    END-IF
    MOVE CD-TXN-ID TO CEN-ENTITY
    MOVE "ACT" TO CEN-STATUS
    MOVE CD-MSG TO CEN-MSG
    MOVE CD-RC TO CEN-RC
    MOVE WS-TXNAMT TO CEN-AMOUNT
    MOVE CRF-CURRENCY TO CEN-CURRENCY
    MOVE "CREDIT.DISBURSEMENT" TO CEN-EVT-PREFIX
    MOVE "END" TO CEN-OP
    CALL "BCRENV" USING BK-CR-ENV
    GOBACK.

LOAD-FAC.
    MOVE SPACES TO BK-CR-FAC
    MOVE CD-FAC-ID TO CRF-ID
    MOVE "GET" TO CS-OP
    CALL "BCRFSTO" USING BK-CR-STO-REQ BK-CR-FAC
    IF CS-RC NOT = "00"
        MOVE "20" TO CD-RC
        MOVE "FACILITY NOT FOUND" TO CD-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CRF-ID TO CD-FAC-ID.

CHECK-LIMIT.
    MOVE "GET" TO CE-OP
    MOVE CRF-ID TO CE-FAC-ID
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        MOVE "20" TO CD-RC
        MOVE "EXPOSURE NOT FOUND" TO CD-MSG
        EXIT PARAGRAPH
    END-IF
    IF CE-CONTRACTED > 0 AND CE-PRINCIPAL + WS-TXNPRIN > CE-CONTRACTED
        MOVE "20" TO CD-RC
        MOVE "OVER LIMIT" TO CD-MSG
    END-IF.

RUN-TXN.
    MOVE "CREATE" TO LFC-OP
    PERFORM DO-TXN
    IF CD-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "AUTHORIZE" TO LFC-OP
    PERFORM DO-TXN
    IF CD-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "POST" TO LFC-OP
    PERFORM DO-TXN
    IF CD-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SETTLE" TO LFC-OP
    PERFORM DO-TXN
    IF CD-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE TXR-ID TO CD-TXN-ID
    MOVE "SETTLED" TO CD-MSG.

DO-TXN.
    IF LFC-OP = "CREATE"
        CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
        MOVE WS-SEQ TO WS-ID-NUM
        MOVE WS-ID-NUM TO WS-ID-ED
        MOVE SPACES TO WS-TXNREQ
        STRING "TX" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
            INTO WS-TXNREQ
        END-STRING
    ELSE
        MOVE SPACES TO WS-TXNREQ
    END-IF
    MOVE WS-TXNTYPE TO LFC-TYPE
    MOVE WS-TXNSRC TO LFC-SRC
    MOVE WS-TXNDST TO LFC-DST
    MOVE WS-TXNAMT TO LFC-AMOUNT
    MOVE CRF-CURRENCY TO LFC-CURRENCY
    MOVE WS-DESCR TO LFC-DESCR
    MOVE CD-OPERATOR TO LFC-OPERATOR
    MOVE CD-CORR TO LFC-CORR
    MOVE WS-TXNREQ TO LFC-REQUEST
    MOVE CRF-ID TO LFC-FACILITY
    MOVE WS-TXNPRIN TO LFC-PRINCIPAL
    MOVE WS-TXNINT TO LFC-INTEREST
    MOVE WS-TXNFEE TO LFC-FEE-AMT
    MOVE TXR-ID TO LFC-TXN-ID
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    IF TXR-RC NOT = "00"
        MOVE TXR-RC TO CD-RC
        MOVE TXR-MSG TO CD-MSG
    END-IF.
