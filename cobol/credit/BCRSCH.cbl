IDENTIFICATION DIVISION.
PROGRAM-ID. BCRSCH.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BCRSTO".
COPY "BINTP".
COPY "BDATP".
01 WS-HOME PIC X(80).
01 WS-I PIC 9(04).
01 WS-REM PIC S9(15)V99 COMP-3.
01 WS-PER PIC S9(15)V99 COMP-3.
01 WS-PRIN-I PIC S9(15)V99 COMP-3.
01 WS-INT-I PIC S9(15)V99 COMP-3.
01 WS-PREV PIC 9(08).
01 WS-DUE PIC 9(08).
01 WS-DAYS PIC 9(05).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 BK-CR-OBL.
   COPY "BCRO".

LINKAGE SECTION.
COPY "BCRSP".

PROCEDURE DIVISION USING BK-CR-SCH-PARMS.
    MOVE "00" TO SCH-RC
    MOVE SPACES TO SCH-MSG
    MOVE 0 TO SCH-COUNT
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO SCH-RC
        MOVE "CONFIG MISSING" TO SCH-MSG
        GOBACK
    END-IF
    IF SCH-OP NOT = "GENERATE"
        MOVE "99" TO SCH-RC
        MOVE "UNKNOWN SCHEDULE OP" TO SCH-MSG
        GOBACK
    END-IF
    IF SCH-PRINCIPAL <= 0 OR SCH-TERM = 0
        MOVE "20" TO SCH-RC
        MOVE "PRINCIPAL AND TERM REQUIRED" TO SCH-MSG
        GOBACK
    END-IF
    MOVE SCH-PRINCIPAL TO WS-REM
    MOVE SCH-EFF TO WS-PREV
    DIVIDE SCH-PRINCIPAL BY SCH-TERM GIVING WS-PER ROUNDED
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SCH-TERM
        PERFORM BUILD-INSTALLMENT
    END-PERFORM
    MOVE SCH-TERM TO SCH-COUNT
    MOVE "SCHEDULE GENERATED" TO SCH-MSG
    GOBACK.

BUILD-INSTALLMENT.
    IF WS-I = SCH-TERM
        MOVE WS-REM TO WS-PRIN-I
    ELSE
        MOVE WS-PER TO WS-PRIN-I
    END-IF
    PERFORM DUE-DATE
    PERFORM INTEREST
    SUBTRACT WS-PRIN-I FROM WS-REM
    IF WS-REM < 0
        MOVE 0 TO WS-REM
    END-IF
    MOVE WS-DUE TO WS-PREV
    MOVE SPACES TO BK-CR-OBL
    MOVE SCH-FAC-ID TO CRO-FAC-ID
    MOVE WS-I TO CRO-INSTALLMENT
    MOVE WS-DUE TO CRO-DUE-DATE
    MOVE WS-PRIN-I TO CRO-PRINCIPAL
    MOVE WS-INT-I TO CRO-INTEREST
    MOVE 0 TO CRO-FEES
    MOVE 0 TO CRO-PAID-PRIN
    MOVE 0 TO CRO-PAID-INT
    MOVE 0 TO CRO-PAID-FEE
    COMPUTE CRO-TOTAL-DUE = WS-PRIN-I + WS-INT-I
    MOVE "SC" TO CRO-STATUS
    MOVE WS-BIZDATE TO CRO-EFF-DATE
    MOVE WS-BIZDATE TO CRO-UPDATED
    MOVE 1 TO CRO-VERSION
    MOVE "WRITE" TO CS-OP
    CALL "BCROSTO" USING BK-CR-STO-REQ BK-CR-OBL
    IF CS-RC = "22"
        MOVE "REWRITE" TO CS-OP
        CALL "BCROSTO" USING BK-CR-STO-REQ BK-CR-OBL
    END-IF
    IF CS-RC NOT = "00"
        MOVE CS-RC TO SCH-RC
        MOVE CS-MSG TO SCH-MSG
    END-IF.

DUE-DATE.
    MOVE "ADD-MONTHS" TO DAT-OP
    MOVE SCH-EFF TO DAT-DATE
    MOVE WS-I TO DAT-MONTHS
    CALL "BDAT" USING BK-DAT-PARMS
    MOVE DAT-RESULT TO WS-DUE.

INTEREST.
    MOVE "DIFF-DAYS" TO DAT-OP
    MOVE WS-PREV TO DAT-DATE
    MOVE WS-DUE TO DAT-DATE2
    CALL "BDAT" USING BK-DAT-PARMS
    MOVE DAT-DAYS TO WS-DAYS
    IF WS-DAYS < 1
        MOVE 1 TO WS-DAYS
    END-IF
    MOVE "ACCRUE" TO INT-OP
    MOVE SCH-RATE-BPS TO INT-BPS
    MOVE WS-REM TO INT-AMOUNT
    MOVE WS-DAYS TO INT-DAYS
    MOVE SCH-BASIS TO INT-BASIS
    CALL "BINT" USING BK-INT-REQ
    IF INT-RC NOT = "00"
        MOVE INT-RC TO SCH-RC
        MOVE INT-MSG TO SCH-MSG
        MOVE 0 TO WS-INT-I
    ELSE
        MOVE INT-INTEREST TO WS-INT-I
    END-IF.
