IDENTIFICATION DIVISION.
PROGRAM-ID. BCRPAY.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BCRSTO".
COPY "BCRENVP".
COPY "BCREXP".
COPY "BCRAP".
COPY "BTXNLFC".
COPY "BTXNRESP".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CREDITTXN".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-TXNREQ PIC X(24).
01 WS-INST PIC 9(04).
01 WS-REMAIN PIC S9(15)V99 COMP-3.
01 WS-DUE-FEE PIC S9(15)V99 COMP-3.
01 WS-DUE-INT PIC S9(15)V99 COMP-3.
01 WS-DUE-PRIN PIC S9(15)V99 COMP-3.
01 WS-TF PIC S9(15)V99 COMP-3.
01 WS-TI PIC S9(15)V99 COMP-3.
01 WS-TP PIC S9(15)V99 COMP-3.
01 WS-TAKE PIC S9(15)V99 COMP-3.
01 WS-PAID PIC S9(15)V99 COMP-3.
01 BK-CR-FAC.
   COPY "BCRF".
01 BK-CR-OBL.
   COPY "BCRO".

LINKAGE SECTION.
COPY "BCRRP".

PROCEDURE DIVISION USING BK-CR-REPAY-PARMS.
    MOVE "00" TO CR-RC
    MOVE SPACES TO CR-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CR-RC
        MOVE "CONFIG MISSING" TO CR-MSG
        GOBACK
    END-IF
    MOVE "BEGIN" TO CEN-OP
    MOVE CR-REQUEST TO CEN-REQUEST
    MOVE "CREDIT.REPAY" TO CEN-OPERATION
    MOVE CR-OPERATOR TO CEN-OPERATOR
    MOVE CR-CORR TO CEN-CORR
    CALL "BCRENV" USING BK-CR-ENV
    IF CEN-HIT = "Y"
        MOVE CEN-ENTITY TO CR-TXN-ID
        MOVE "00" TO CR-RC
        MOVE CEN-MSG TO CR-MSG
        GOBACK
    END-IF
    IF CEN-RC NOT = "00"
        MOVE CEN-RC TO CR-RC
        MOVE CEN-MSG TO CR-MSG
        GOBACK
    END-IF
    PERFORM LOAD-FAC
    IF CR-RC NOT = "00"
        GOBACK
    END-IF
    IF CR-AMOUNT <= 0
        MOVE "20" TO CR-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO CR-MSG
        GOBACK
    END-IF
    MOVE CR-AMOUNT TO WS-REMAIN
    MOVE 0 TO CR-FEES
    MOVE 0 TO CR-INTEREST
    MOVE 0 TO CR-PRINCIPAL
    PERFORM PASS-ALLOCATE
    IF CR-RC NOT = "00"
        GOBACK
    END-IF
    COMPUTE CR-EXCESS = WS-REMAIN
    IF CR-EXCESS < 0
        MOVE 0 TO CR-EXCESS
    END-IF
    COMPUTE WS-TAKE = CR-FEES + CR-INTEREST + CR-PRINCIPAL
    IF WS-TAKE <= 0
        MOVE "20" TO CR-RC
        MOVE "NOTHING TO ALLOCATE" TO CR-MSG
        GOBACK
    END-IF
    PERFORM RUN-TXN
    IF CR-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "REPAY" TO CE-OP
    MOVE CR-FAC-ID TO CE-FAC-ID
    MOVE CR-PRINCIPAL TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        MOVE CE-RC TO CR-RC
        MOVE CE-MSG TO CR-MSG
        GOBACK
    END-IF
    MOVE CR-TXN-ID TO CEN-ENTITY
    MOVE "PA" TO CEN-STATUS
    MOVE CR-MSG TO CEN-MSG
    MOVE CR-RC TO CEN-RC
    MOVE WS-TAKE TO CEN-AMOUNT
    MOVE CRF-CURRENCY TO CEN-CURRENCY
    MOVE "CREDIT.REPAYMENT" TO CEN-EVT-PREFIX
    MOVE "END" TO CEN-OP
    CALL "BCRENV" USING BK-CR-ENV
    GOBACK.

LOAD-FAC.
    MOVE SPACES TO BK-CR-FAC
    MOVE CR-FAC-ID TO CRF-ID
    MOVE "GET" TO CS-OP
    CALL "BCRFSTO" USING BK-CR-STO-REQ BK-CR-FAC
    IF CS-RC NOT = "00"
        MOVE "20" TO CR-RC
        MOVE "FACILITY NOT FOUND" TO CR-MSG
    END-IF.

PASS-ALLOCATE.
    PERFORM VARYING WS-INST FROM 1 BY 1 UNTIL WS-INST > CRF-TERM
        PERFORM ALLOCATE-ONE
        IF WS-REMAIN <= 0
            EXIT PERFORM
        END-IF
    END-PERFORM.

ALLOCATE-ONE.
    MOVE SPACES TO BK-CR-OBL
    MOVE CRF-ID TO CRO-FAC-ID
    MOVE WS-INST TO CRO-INSTALLMENT
    MOVE "GET" TO CS-OP
    CALL "BCROSTO" USING BK-CR-STO-REQ BK-CR-OBL
    IF CS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    COMPUTE WS-DUE-FEE = CRO-FEES - CRO-PAID-FEE
    COMPUTE WS-DUE-INT = CRO-INTEREST - CRO-PAID-INT
    COMPUTE WS-DUE-PRIN = CRO-PRINCIPAL - CRO-PAID-PRIN
    MOVE 0 TO WS-TF
    MOVE 0 TO WS-TI
    MOVE 0 TO WS-TP
    PERFORM TAKE-FEE
    PERFORM TAKE-INT
    PERFORM TAKE-PRIN
    ADD WS-TF TO CR-FEES
    ADD WS-TI TO CR-INTEREST
    ADD WS-TP TO CR-PRINCIPAL
    ADD WS-TF TO CRO-PAID-FEE
    ADD WS-TI TO CRO-PAID-INT
    ADD WS-TP TO CRO-PAID-PRIN
    PERFORM SET-STATUS
    MOVE WS-BIZDATE TO CRO-UPDATED
    ADD 1 TO CRO-VERSION
    MOVE "REWRITE" TO CS-OP
    CALL "BCROSTO" USING BK-CR-STO-REQ BK-CR-OBL
    IF CS-RC NOT = "00"
        MOVE CS-RC TO CR-RC
        MOVE CS-MSG TO CR-MSG
    END-IF.

TAKE-FEE.
    IF WS-REMAIN <= 0 OR WS-DUE-FEE <= 0
        EXIT PARAGRAPH
    END-IF
    IF WS-REMAIN < WS-DUE-FEE
        MOVE WS-REMAIN TO WS-TF
    ELSE
        MOVE WS-DUE-FEE TO WS-TF
    END-IF
    SUBTRACT WS-TF FROM WS-REMAIN.

TAKE-INT.
    IF WS-REMAIN <= 0 OR WS-DUE-INT <= 0
        EXIT PARAGRAPH
    END-IF
    IF WS-REMAIN < WS-DUE-INT
        MOVE WS-REMAIN TO WS-TI
    ELSE
        MOVE WS-DUE-INT TO WS-TI
    END-IF
    SUBTRACT WS-TI FROM WS-REMAIN.

TAKE-PRIN.
    IF WS-REMAIN <= 0 OR WS-DUE-PRIN <= 0
        EXIT PARAGRAPH
    END-IF
    IF WS-REMAIN < WS-DUE-PRIN
        MOVE WS-REMAIN TO WS-TP
    ELSE
        MOVE WS-DUE-PRIN TO WS-TP
    END-IF
    SUBTRACT WS-TP FROM WS-REMAIN.

SET-STATUS.
    COMPUTE WS-PAID = CRO-PAID-FEE + CRO-PAID-INT + CRO-PAID-PRIN
    IF WS-PAID >= CRO-TOTAL-DUE
        MOVE "PA" TO CRO-STATUS
    ELSE
        IF WS-PAID > 0
            MOVE "PT" TO CRO-STATUS
        ELSE
            MOVE "SC" TO CRO-STATUS
        END-IF
    END-IF.

RUN-TXN.
    MOVE "CREATE" TO LFC-OP
    PERFORM DO-TXN
    MOVE "AUTHORIZE" TO LFC-OP
    PERFORM DO-TXN
    MOVE "POST" TO LFC-OP
    PERFORM DO-TXN
    MOVE "SETTLE" TO LFC-OP
    PERFORM DO-TXN
    MOVE TXR-ID TO CR-TXN-ID.

DO-TXN.
    IF LFC-OP = "CREATE"
        CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
        MOVE WS-SEQ TO WS-ID-NUM
        MOVE WS-ID-NUM TO WS-ID-ED
        MOVE SPACES TO WS-TXNREQ
        STRING "TX" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
            INTO WS-TXNREQ
        END-STRING
    ELSE
        MOVE SPACES TO WS-TXNREQ
    END-IF
    MOVE "CREDREPY" TO LFC-TYPE
    MOVE CRF-ACCOUNT TO LFC-SRC
    MOVE SPACES TO LFC-DST
    COMPUTE LFC-AMOUNT = CR-FEES + CR-INTEREST + CR-PRINCIPAL
    MOVE CRF-CURRENCY TO LFC-CURRENCY
    MOVE "CREDIT REPAYMENT" TO LFC-DESCR
    MOVE CR-OPERATOR TO LFC-OPERATOR
    MOVE CR-CORR TO LFC-CORR
    MOVE WS-TXNREQ TO LFC-REQUEST
    MOVE CRF-ID TO LFC-FACILITY
    MOVE CR-PRINCIPAL TO LFC-PRINCIPAL
    MOVE CR-INTEREST TO LFC-INTEREST
    MOVE CR-FEES TO LFC-FEE-AMT
    MOVE TXR-ID TO LFC-TXN-ID
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    IF TXR-RC NOT = "00"
        MOVE TXR-RC TO CR-RC
        MOVE TXR-MSG TO CR-MSG
    END-IF.
