IDENTIFICATION DIVISION.
PROGRAM-ID. BCRAQ.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT APP-FILE ASSIGN TO WS-APP-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CRA-ID
        FILE STATUS IS WS-APP-ST.

DATA DIVISION.
FILE SECTION.
FD APP-FILE.
01 APP-REC.
   COPY "BCRA".

WORKING-STORAGE SECTION.
01 WS-APP-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-APP-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-COUNT PIC 9(06).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-APR-ED PIC -(15)9.99.

LINKAGE SECTION.
01 LS-OP PIC X(08).
01 LS-ID PIC X(12).
01 LS-RC PIC X(02).

PROCEDURE DIVISION USING LS-OP LS-ID LS-RC.
    MOVE "00" TO LS-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-APP-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crapp.idx"
        DELIMITED SIZE INTO WS-APP-PATH
    OPEN INPUT APP-FILE
    IF WS-APP-ST NOT = "00"
        MOVE "35" TO LS-RC
        GOBACK
    END-IF
    EVALUATE LS-OP
        WHEN "GET" PERFORM DO-GET
        WHEN "LIST" PERFORM DO-LIST
        WHEN OTHER MOVE "99" TO LS-RC
    END-EVALUATE
    CLOSE APP-FILE
    GOBACK.

DO-GET.
    MOVE LS-ID TO CRA-ID
    READ APP-FILE
    IF WS-APP-ST = "00"
        PERFORM SHOW-APP
    ELSE
        MOVE "23" TO LS-RC
    END-IF.

DO-LIST.
    MOVE 0 TO WS-COUNT
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ APP-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END
                ADD 1 TO WS-COUNT
                PERFORM SHOW-APP
        END-READ
    END-PERFORM
    DISPLAY "applications=" WS-COUNT.

SHOW-APP.
    MOVE CRA-REQUESTED TO WS-AMT-ED
    MOVE CRA-APPROVED TO WS-APR-ED
    DISPLAY "app=" FUNCTION TRIM(CRA-ID)
    DISPLAY "customer=" FUNCTION TRIM(CRA-CUST-ID)
    DISPLAY "product=" FUNCTION TRIM(CRA-PRODUCT)
    DISPLAY "account=" FUNCTION TRIM(CRA-ACCOUNT)
    DISPLAY "status=" FUNCTION TRIM(CRA-STATUS)
    DISPLAY "requested=" WS-AMT-ED
    DISPLAY "approved=" WS-APR-ED
    DISPLAY "currency=" FUNCTION TRIM(CRA-CURRENCY)
    DISPLAY "term=" CRA-TERM
    DISPLAY "rate-bps=" CRA-RATE-BPS
    DISPLAY "reason=" FUNCTION TRIM(CRA-REASON).
