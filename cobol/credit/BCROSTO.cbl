IDENTIFICATION DIVISION.
PROGRAM-ID. BCROSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT OBL-FILE ASSIGN TO WS-OBL-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CRO-KEY
        FILE STATUS IS WS-OBL-ST.

DATA DIVISION.
FILE SECTION.
FD OBL-FILE.
01 OBL-REC.
   COPY "BCRO".

WORKING-STORAGE SECTION.
01 WS-OBL-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-OBL-ST PIC X(02).

LINKAGE SECTION.
COPY "BCRSTO".
01 BK-CR-OBL-REC.
   COPY "BCRO".

PROCEDURE DIVISION USING BK-CR-STO-REQ BK-CR-OBL-REC.
    MOVE "00" TO CS-RC
    MOVE SPACES TO CS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-OBL-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crobl.idx"
        DELIMITED SIZE INTO WS-OBL-PATH
    PERFORM OPEN-STORE
    IF CS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE CS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO CS-RC
            MOVE "UNKNOWN CREDIT OBLIGATION STORE OP" TO CS-MSG
    END-EVALUATE
    CLOSE OBL-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O OBL-FILE
    IF WS-OBL-ST = "35"
        OPEN OUTPUT OBL-FILE
        CLOSE OBL-FILE
        OPEN I-O OBL-FILE
    END-IF
    IF WS-OBL-ST NOT = "00"
        MOVE WS-OBL-ST TO CS-RC
        MOVE "CANNOT OPEN CREDIT OBLIGATION INDEX" TO CS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CR-OBL-REC TO OBL-REC
    WRITE OBL-REC
        INVALID KEY
            MOVE "22" TO CS-RC
            MOVE "CREDIT OBLIGATION ALREADY EXISTS" TO CS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE CRO-KEY OF BK-CR-OBL-REC TO CRO-KEY OF OBL-REC
    READ OBL-FILE
    IF WS-OBL-ST = "00"
        MOVE BK-CR-OBL-REC TO OBL-REC
        REWRITE OBL-REC
    ELSE
        MOVE "23" TO CS-RC
        MOVE "CREDIT OBLIGATION NOT FOUND" TO CS-MSG
    END-IF.

DO-GET.
    MOVE CRO-KEY OF BK-CR-OBL-REC TO CRO-KEY OF OBL-REC
    READ OBL-FILE
    IF WS-OBL-ST = "00"
        MOVE OBL-REC TO BK-CR-OBL-REC
        MOVE "00" TO CS-RC
    ELSE
        MOVE "23" TO CS-RC
        MOVE "CREDIT OBLIGATION NOT FOUND" TO CS-MSG
    END-IF.
