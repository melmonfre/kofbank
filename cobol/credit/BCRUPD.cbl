IDENTIFICATION DIVISION.
PROGRAM-ID. BCRUPD.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BCRSTO".
01 WS-REM PIC S9(15)V99 COMP-3.
01 WS-AMT-ED PIC -(15)9.99.
01 WS-HASH-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-HASH PIC X(16).
01 BK-CR-EXP.
   COPY "BCEXP".

LINKAGE SECTION.
COPY "BCREXP".

PROCEDURE DIVISION USING BK-CR-EXP-PARMS.
    MOVE "00" TO CE-RC
    MOVE SPACES TO CE-MSG
    EVALUATE CE-OP
        WHEN "OPEN" PERFORM DO-OPEN
        WHEN "GET" PERFORM DO-GET
        WHEN "STATUS" PERFORM DO-STATUS
        WHEN "DISBURSE" PERFORM DO-DISBURSE
        WHEN "REPAY" PERFORM DO-REPAY
        WHEN "REVPAY" PERFORM DO-REV-PAY
        WHEN "ACCRUE" PERFORM DO-ACCRUE
        WHEN "MARK-DUE" PERFORM DO-MARK-DUE
        WHEN "MARK-OVERDUE" PERFORM DO-MARK-OVERDUE
        WHEN "SETOVDUE" PERFORM DO-SET-OVERDUE
        WHEN "WRITEOFF" PERFORM DO-WRITEOFF
        WHEN OTHER
            MOVE "99" TO CE-RC
            MOVE "UNKNOWN EXPOSURE OP" TO CE-MSG
    END-EVALUATE
    GOBACK.

DO-OPEN.
    MOVE SPACES TO BK-CR-EXP
    MOVE CE-FAC-ID TO CX-FAC-ID
    MOVE CE-STATUS TO CX-STATUS
    MOVE CE-APPROVED TO CX-APPROVED
    MOVE CE-AMOUNT TO CX-CONTRACTED
    PERFORM ZERO-AMOUNTS
    MOVE "UPDATE" TO CS-OP
    CALL "BCRXSTO" USING BK-CR-STO-REQ BK-CR-EXP
    PERFORM PROPAGATE-RC.

DO-GET.
    PERFORM LOAD-EXP
    IF CE-RC NOT = "00"
        GOBACK
    END-IF
    MOVE CX-APPROVED TO CE-APPROVED
    MOVE CX-CONTRACTED TO CE-CONTRACTED
    MOVE CX-PRINCIPAL TO CE-PRINCIPAL
    MOVE CX-STATUS TO CE-STATUS.

DO-STATUS.
    PERFORM LOAD-EXP
    IF CE-RC NOT = "00"
        GOBACK
    END-IF
    MOVE CE-STATUS TO CX-STATUS
    PERFORM SAVE-EXP.

DO-DISBURSE.
    PERFORM LOAD-EXP
    IF CE-RC NOT = "00"
        GOBACK
    END-IF
    IF CX-STATUS NOT = "ACT"
        MOVE "20" TO CE-RC
        MOVE "FACILITY NOT ACTIVE" TO CE-MSG
        GOBACK
    END-IF
    IF CX-CONTRACTED > 0
        IF CX-PRINCIPAL + CE-AMOUNT > CX-CONTRACTED
            MOVE "20" TO CE-RC
            MOVE "OVER LIMIT" TO CE-MSG
            GOBACK
        END-IF
    END-IF
    ADD CE-AMOUNT TO CX-PRINCIPAL
    PERFORM SAVE-EXP.

DO-REPAY.
    PERFORM LOAD-EXP
    IF CE-RC NOT = "00"
        GOBACK
    END-IF
    SUBTRACT CE-AMOUNT FROM CX-PRINCIPAL
    IF CX-PRINCIPAL < 0
        MOVE 0 TO CX-PRINCIPAL
    END-IF
    PERFORM REDUCE-OUTSTANDING
    PERFORM SAVE-EXP.

DO-REV-PAY.
    PERFORM LOAD-EXP
    IF CE-RC NOT = "00"
        GOBACK
    END-IF
    ADD CE-AMOUNT TO CX-PRINCIPAL
    IF CX-CONTRACTED > 0
        IF CX-PRINCIPAL > CX-CONTRACTED
            MOVE CX-CONTRACTED TO CX-PRINCIPAL
        END-IF
    END-IF
    PERFORM SAVE-EXP.

DO-ACCRUE.
    PERFORM LOAD-EXP
    IF CE-RC NOT = "00"
        GOBACK
    END-IF
    ADD CE-INTEREST TO CX-INTEREST-ACCR
    ADD CE-FEES TO CX-FEES-ACCR
    PERFORM SAVE-EXP.

DO-MARK-DUE.
    PERFORM LOAD-EXP
    IF CE-RC NOT = "00"
        GOBACK
    END-IF
    ADD CE-AMOUNT TO CX-PENDING
    PERFORM SAVE-EXP.

DO-MARK-OVERDUE.
    PERFORM LOAD-EXP
    IF CE-RC NOT = "00"
        GOBACK
    END-IF
    ADD CE-AMOUNT TO CX-OVERDUE
    SUBTRACT CE-AMOUNT FROM CX-PENDING
    IF CX-PENDING < 0
        MOVE 0 TO CX-PENDING
    END-IF
    PERFORM SAVE-EXP.

DO-SET-OVERDUE.
    PERFORM LOAD-EXP
    IF CE-RC NOT = "00"
        GOBACK
    END-IF
    MOVE CE-AMOUNT TO CX-OVERDUE
    PERFORM SAVE-EXP.

DO-WRITEOFF.
    PERFORM LOAD-EXP
    IF CE-RC NOT = "00"
        GOBACK
    END-IF
    SUBTRACT CE-AMOUNT FROM CX-PRINCIPAL
    IF CX-PRINCIPAL < 0
        MOVE 0 TO CX-PRINCIPAL
    END-IF
    SUBTRACT CE-AMOUNT FROM CX-OVERDUE
    IF CX-OVERDUE < 0
        MOVE 0 TO CX-OVERDUE
    END-IF
    PERFORM SAVE-EXP.

REDUCE-OUTSTANDING.
    MOVE CE-AMOUNT TO WS-REM
    IF CX-OVERDUE >= WS-REM
        SUBTRACT WS-REM FROM CX-OVERDUE
    ELSE
        SUBTRACT CX-OVERDUE FROM WS-REM
        MOVE 0 TO CX-OVERDUE
        SUBTRACT WS-REM FROM CX-PENDING
        IF CX-PENDING < 0
            MOVE 0 TO CX-PENDING
        END-IF
    END-IF.

LOAD-EXP.
    MOVE SPACES TO BK-CR-EXP
    MOVE CE-FAC-ID TO CX-FAC-ID
    MOVE "GET" TO CS-OP
    CALL "BCRXSTO" USING BK-CR-STO-REQ BK-CR-EXP
    IF CS-RC NOT = "00"
        MOVE CS-RC TO CE-RC
        MOVE "EXPOSURE NOT FOUND" TO CE-MSG
    END-IF.

SAVE-EXP.
    ADD 1 TO CX-VERSION
    PERFORM COMPUTE-HASH
    MOVE "UPDATE" TO CS-OP
    CALL "BCRXSTO" USING BK-CR-STO-REQ BK-CR-EXP
    PERFORM PROPAGATE-RC.

PROPAGATE-RC.
    MOVE CS-RC TO CE-RC
    IF CS-RC NOT = "00"
        MOVE CS-MSG TO CE-MSG
    END-IF.

ZERO-AMOUNTS.
    MOVE 0 TO CX-PRINCIPAL
    MOVE 0 TO CX-PENDING
    MOVE 0 TO CX-OVERDUE
    MOVE 0 TO CX-INTEREST-ACCR
    MOVE 0 TO CX-FEES-ACCR
    MOVE 0 TO CX-PAID-PRIN
    MOVE 1 TO CX-VERSION.

COMPUTE-HASH.
    MOVE CX-PRINCIPAL TO WS-AMT-ED
    MOVE SPACES TO WS-HASH-BUF
    STRING FUNCTION TRIM(CX-FAC-ID) DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        CX-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        CX-VERSION DELIMITED SIZE
        INTO WS-HASH-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-HASH-BUF WS-HASH-LEN WS-HASH
    MOVE WS-HASH TO CX-HASH.
