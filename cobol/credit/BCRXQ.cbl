IDENTIFICATION DIVISION.
PROGRAM-ID. BCRXQ.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT EXP-FILE ASSIGN TO WS-EXP-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CX-FAC-ID
        FILE STATUS IS WS-EXP-ST.

DATA DIVISION.
FILE SECTION.
FD EXP-FILE.
01 EXP-REC.
   COPY "BCEXP".

WORKING-STORAGE SECTION.
01 WS-EXP-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-EXP-ST PIC X(02).
01 WS-UTIL PIC S9(15)V99 COMP-3.
01 WS-AVAIL PIC S9(15)V99 COMP-3.
01 WS-OVER PIC S9(15)V99 COMP-3.
01 WS-ED PIC -(15)9.99.
01 WS-ED2 PIC -(15)9.99.
01 WS-ED3 PIC -(15)9.99.
01 WS-ED4 PIC -(15)9.99.
01 WS-ED5 PIC -(15)9.99.
01 WS-ED6 PIC -(15)9.99.

LINKAGE SECTION.
01 LS-OP PIC X(08).
01 LS-FAC PIC X(12).
01 LS-RC PIC X(02).

PROCEDURE DIVISION USING LS-OP LS-FAC LS-RC.
    MOVE "00" TO LS-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-EXP-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crexp.idx"
        DELIMITED SIZE INTO WS-EXP-PATH
    OPEN INPUT EXP-FILE
    IF WS-EXP-ST NOT = "00"
        MOVE "35" TO LS-RC
        GOBACK
    END-IF
    IF LS-OP = "GET"
        PERFORM DO-GET
    ELSE
        MOVE "99" TO LS-RC
    END-IF
    CLOSE EXP-FILE
    GOBACK.

DO-GET.
    MOVE LS-FAC TO CX-FAC-ID
    READ EXP-FILE
    IF WS-EXP-ST = "00"
        PERFORM SHOW-EXP
    ELSE
        MOVE "23" TO LS-RC
    END-IF.

SHOW-EXP.
    MOVE CX-PRINCIPAL TO WS-UTIL
    COMPUTE WS-AVAIL = CX-CONTRACTED - WS-UTIL
    IF WS-AVAIL < 0
        MOVE 0 TO WS-AVAIL
    END-IF
    COMPUTE WS-OVER = WS-UTIL - CX-CONTRACTED
    IF WS-OVER < 0
        MOVE 0 TO WS-OVER
    END-IF
    MOVE CX-APPROVED TO WS-ED
    MOVE CX-CONTRACTED TO WS-ED2
    MOVE CX-PRINCIPAL TO WS-ED3
    MOVE CX-OVERDUE TO WS-ED4
    MOVE WS-UTIL TO WS-ED5
    MOVE WS-AVAIL TO WS-ED6
    DISPLAY "facility=" FUNCTION TRIM(CX-FAC-ID)
    DISPLAY "status=" FUNCTION TRIM(CX-STATUS)
    DISPLAY "approved=" WS-ED
    DISPLAY "contracted=" WS-ED2
    DISPLAY "principal=" WS-ED3
    DISPLAY "overdue=" WS-ED4
    DISPLAY "utilized=" WS-ED5
    DISPLAY "available=" WS-ED6.
