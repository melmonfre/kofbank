IDENTIFICATION DIVISION.
PROGRAM-ID. BCRWOF.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BCRSTO".
COPY "BCRENVP".
COPY "BCREXP".
COPY "BCRAP".
COPY "BTXNLFC".
COPY "BTXNRESP".
01 WS-HOME PIC X(80).
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "CREDITTXN".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-TXNREQ PIC X(24).
01 BK-CR-FAC.
   COPY "BCRF".

LINKAGE SECTION.
COPY "BCRWP".

PROCEDURE DIVISION USING BK-CR-WOF-PARMS.
    MOVE "00" TO CW-RC
    MOVE SPACES TO CW-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    IF WS-CFG-ST NOT = "00"
        MOVE WS-CFG-ST TO CW-RC
        MOVE "CONFIG MISSING" TO CW-MSG
        GOBACK
    END-IF
    MOVE "BEGIN" TO CEN-OP
    MOVE CW-REQUEST TO CEN-REQUEST
    MOVE "CREDIT.WRITEOFF" TO CEN-OPERATION
    MOVE CW-OPERATOR TO CEN-OPERATOR
    MOVE CW-CORR TO CEN-CORR
    CALL "BCRENV" USING BK-CR-ENV
    IF CEN-HIT = "Y"
        MOVE CEN-ENTITY TO CW-TXN-ID
        MOVE "00" TO CW-RC
        MOVE CEN-MSG TO CW-MSG
        GOBACK
    END-IF
    IF CEN-RC NOT = "00"
        MOVE CEN-RC TO CW-RC
        MOVE CEN-MSG TO CW-MSG
        GOBACK
    END-IF
    PERFORM LOAD-FAC
    IF CW-RC NOT = "00"
        GOBACK
    END-IF
    IF CW-AMOUNT <= 0
        MOVE "20" TO CW-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO CW-MSG
        GOBACK
    END-IF
    PERFORM RUN-TXN
    IF CW-RC NOT = "00"
        GOBACK
    END-IF
    MOVE "WRITEOFF" TO CE-OP
    MOVE CRF-ID TO CE-FAC-ID
    MOVE CW-AMOUNT TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS
    IF CE-RC NOT = "00"
        MOVE CE-RC TO CW-RC
        MOVE CE-MSG TO CW-MSG
        GOBACK
    END-IF
    MOVE CW-TXN-ID TO CEN-ENTITY
    MOVE "WO" TO CEN-STATUS
    MOVE CW-MSG TO CEN-MSG
    MOVE CW-RC TO CEN-RC
    MOVE CW-AMOUNT TO CEN-AMOUNT
    MOVE CRF-CURRENCY TO CEN-CURRENCY
    MOVE "CREDIT.WRITEOFF" TO CEN-EVT-PREFIX
    MOVE "END" TO CEN-OP
    CALL "BCRENV" USING BK-CR-ENV
    GOBACK.

LOAD-FAC.
    MOVE SPACES TO BK-CR-FAC
    MOVE CW-FAC-ID TO CRF-ID
    MOVE "GET" TO CS-OP
    CALL "BCRFSTO" USING BK-CR-STO-REQ BK-CR-FAC
    IF CS-RC NOT = "00"
        MOVE "20" TO CW-RC
        MOVE "FACILITY NOT FOUND" TO CW-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE CRF-ID TO CW-FAC-ID.

RUN-TXN.
    MOVE "CREATE" TO LFC-OP
    PERFORM DO-TXN
    IF CW-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "AUTHORIZE" TO LFC-OP
    PERFORM DO-TXN
    IF CW-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "POST" TO LFC-OP
    PERFORM DO-TXN
    IF CW-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "SETTLE" TO LFC-OP
    PERFORM DO-TXN
    IF CW-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE TXR-ID TO CW-TXN-ID
    MOVE "WRITTEN OFF" TO CW-MSG.

DO-TXN.
    IF LFC-OP = "CREATE"
        CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
        MOVE WS-SEQ TO WS-ID-NUM
        MOVE WS-ID-NUM TO WS-ID-ED
        MOVE SPACES TO WS-TXNREQ
        STRING "TX" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
            INTO WS-TXNREQ
        END-STRING
    ELSE
        MOVE SPACES TO WS-TXNREQ
    END-IF
    MOVE "CREDWOFF" TO LFC-TYPE
    MOVE SPACES TO LFC-SRC
    MOVE SPACES TO LFC-DST
    MOVE CW-AMOUNT TO LFC-AMOUNT
    MOVE CRF-CURRENCY TO LFC-CURRENCY
    MOVE "CREDIT WRITE OFF" TO LFC-DESCR
    MOVE CW-OPERATOR TO LFC-OPERATOR
    MOVE CW-CORR TO LFC-CORR
    MOVE WS-TXNREQ TO LFC-REQUEST
    MOVE CRF-ID TO LFC-FACILITY
    MOVE 0 TO LFC-PRINCIPAL
    MOVE 0 TO LFC-INTEREST
    MOVE 0 TO LFC-FEE-AMT
    MOVE TXR-ID TO LFC-TXN-ID
    CALL "BTXNLFC" USING BK-TXN-LFC-REQ BK-TXN-RES
    IF TXR-RC NOT = "00"
        MOVE TXR-RC TO CW-RC
        MOVE TXR-MSG TO CW-MSG
    END-IF.
