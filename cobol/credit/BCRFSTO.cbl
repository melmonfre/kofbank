IDENTIFICATION DIVISION.
PROGRAM-ID. BCRFSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT FAC-FILE ASSIGN TO WS-FAC-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CRF-ID
        FILE STATUS IS WS-FAC-ST.

DATA DIVISION.
FILE SECTION.
FD FAC-FILE.
01 FAC-REC.
   COPY "BCRF".

WORKING-STORAGE SECTION.
01 WS-FAC-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-FAC-ST PIC X(02).

LINKAGE SECTION.
COPY "BCRSTO".
01 BK-CR-FAC-REC.
   COPY "BCRF".

PROCEDURE DIVISION USING BK-CR-STO-REQ BK-CR-FAC-REC.
    MOVE "00" TO CS-RC
    MOVE SPACES TO CS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-FAC-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crfac.idx"
        DELIMITED SIZE INTO WS-FAC-PATH
    PERFORM OPEN-STORE
    IF CS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE CS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "UPDATE" PERFORM DO-UPDATE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO CS-RC
            MOVE "UNKNOWN CREDIT FACILITY STORE OP" TO CS-MSG
    END-EVALUATE
    CLOSE FAC-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O FAC-FILE
    IF WS-FAC-ST = "35"
        OPEN OUTPUT FAC-FILE
        CLOSE FAC-FILE
        OPEN I-O FAC-FILE
    END-IF
    IF WS-FAC-ST NOT = "00"
        MOVE WS-FAC-ST TO CS-RC
        MOVE "CANNOT OPEN CREDIT FACILITY INDEX" TO CS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CR-FAC-REC TO FAC-REC
    WRITE FAC-REC
        INVALID KEY
            MOVE "22" TO CS-RC
            MOVE "CREDIT FACILITY ALREADY EXISTS" TO CS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE CRF-ID OF BK-CR-FAC-REC TO CRF-ID OF FAC-REC
    READ FAC-FILE
    IF WS-FAC-ST = "00"
        MOVE BK-CR-FAC-REC TO FAC-REC
        REWRITE FAC-REC
    ELSE
        MOVE "23" TO CS-RC
        MOVE "CREDIT FACILITY NOT FOUND" TO CS-MSG
    END-IF.

DO-UPDATE.
    MOVE CRF-ID OF BK-CR-FAC-REC TO CRF-ID OF FAC-REC
    READ FAC-FILE
    IF WS-FAC-ST = "00"
        MOVE BK-CR-FAC-REC TO FAC-REC
        REWRITE FAC-REC
    ELSE
        MOVE BK-CR-FAC-REC TO FAC-REC
        WRITE FAC-REC
    END-IF.

DO-GET.
    MOVE CRF-ID OF BK-CR-FAC-REC TO CRF-ID OF FAC-REC
    READ FAC-FILE
    IF WS-FAC-ST = "00"
        MOVE FAC-REC TO BK-CR-FAC-REC
        MOVE "00" TO CS-RC
    ELSE
        MOVE "23" TO CS-RC
        MOVE "CREDIT FACILITY NOT FOUND" TO CS-MSG
    END-IF.
