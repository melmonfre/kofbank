IDENTIFICATION DIVISION.
PROGRAM-ID. BCRENV.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BKIDMP".
01 WS-AMT-ED PIC -(15)9.99.
01 WS-PAYLOAD PIC X(200).
01 WS-SUFFIX PIC X(20).

LINKAGE SECTION.
COPY "BCRENVP".

PROCEDURE DIVISION USING BK-CR-ENV.
    MOVE "N" TO CEN-HIT
    EVALUATE CEN-OP
        WHEN "BEGIN" PERFORM DO-BEGIN
        WHEN "END" PERFORM DO-END
        WHEN OTHER
            MOVE "99" TO CEN-RC
    END-EVALUATE
    GOBACK.

DO-BEGIN.
    MOVE "00" TO CEN-RC
    IF CEN-REQUEST = SPACES
        GOBACK
    END-IF
    MOVE CEN-REQUEST TO BK-IDM-TXN-ID
    MOVE CEN-OPERATION TO BK-IDM-OPERATION
    MOVE "B" TO BK-IDM-MODE
    MOVE SPACES TO BK-IDM-RESULT
    CALL "BIDM" USING BK-IDM-PARMS
    IF BK-IDM-STATUS = "22"
        MOVE "G" TO BK-IDM-MODE
        CALL "BIDM" USING BK-IDM-PARMS
        EVALUATE BK-IDM-STATUS
            WHEN "C"
                MOVE BK-IDM-RESULT(1:12) TO CEN-ENTITY
                MOVE BK-IDM-RESULT(13:4) TO CEN-STATUS
                MOVE BK-IDM-RESULT(31:80) TO CEN-MSG
                MOVE "00" TO CEN-RC
                MOVE "Y" TO CEN-HIT
            WHEN "F"
                CONTINUE
            WHEN OTHER
                MOVE "24" TO CEN-RC
                MOVE "REQUEST IN PROGRESS" TO CEN-MSG
        END-EVALUATE
    ELSE
        IF BK-IDM-STATUS NOT = "00"
            MOVE BK-IDM-STATUS TO CEN-RC
            MOVE "IDEMPOTENCY STORE ERROR" TO CEN-MSG
        END-IF
    END-IF.

DO-END.
    IF CEN-RC = "00"
        PERFORM EMIT-AUDIT
        PERFORM EMIT-EVENT
    END-IF
    IF CEN-REQUEST = SPACES
        GOBACK
    END-IF
    MOVE CEN-REQUEST TO BK-IDM-TXN-ID
    MOVE SPACES TO BK-IDM-RESULT
    IF CEN-RC = "00"
        MOVE CEN-ENTITY TO BK-IDM-RESULT(1:12)
        MOVE CEN-STATUS TO BK-IDM-RESULT(13:4)
        MOVE CEN-MSG TO BK-IDM-RESULT(31:80)
        MOVE "C" TO BK-IDM-MODE
    ELSE
        MOVE CEN-MSG TO BK-IDM-RESULT
        MOVE "F" TO BK-IDM-MODE
    END-IF
    CALL "BIDM" USING BK-IDM-PARMS.

EMIT-AUDIT.
    MOVE CEN-OPERATOR TO BK-AUD-OPERATOR
    MOVE CEN-ACTION TO BK-AUD-ACTION
    MOVE CEN-ENTITY TO BK-AUD-ENTITY
    MOVE CEN-CORR TO BK-AUD-CORR
    MOVE CEN-STATUS TO BK-AUD-BEFORE
    MOVE CEN-MSG TO BK-AUD-AFTER
    MOVE CEN-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS.

EMIT-EVENT.
    MOVE CEN-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-PAYLOAD
    STRING FUNCTION TRIM(CEN-ENTITY) DELIMITED SIZE "|" DELIMITED SIZE
        CEN-STATUS DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE
        INTO WS-PAYLOAD
    END-STRING
    MOVE SPACES TO WS-SUFFIX
    EVALUATE CEN-STATUS
        WHEN "UND" MOVE "SUBMITTED.v1" TO WS-SUFFIX
        WHEN "APV" MOVE "APPROVED.v1" TO WS-SUFFIX
        WHEN "CND" MOVE "CONDITIONAL.v1" TO WS-SUFFIX
        WHEN "REJ" MOVE "REJECTED.v1" TO WS-SUFFIX
        WHEN "CAN" MOVE "CANCELLED.v1" TO WS-SUFFIX
        WHEN "EXP" MOVE "EXPIRED.v1" TO WS-SUFFIX
        WHEN "CON" MOVE "CONTRACTED.v1" TO WS-SUFFIX
        WHEN "ACT" MOVE "ACTIVATED.v1" TO WS-SUFFIX
        WHEN "SUS" MOVE "SUSPENDED.v1" TO WS-SUFFIX
        WHEN "BLK" MOVE "BLOCKED.v1" TO WS-SUFFIX
        WHEN "MAT" MOVE "MATURED.v1" TO WS-SUFFIX
        WHEN "CLO" MOVE "CLOSED.v1" TO WS-SUFFIX
        WHEN "DEF" MOVE "DEFAULTED.v1" TO WS-SUFFIX
        WHEN OTHER MOVE "CREATED.v1" TO WS-SUFFIX
    END-EVALUATE
    MOVE SPACES TO BK-EVT-TYPE
    STRING FUNCTION TRIM(CEN-EVT-PREFIX) DELIMITED SIZE "." DELIMITED SIZE
        FUNCTION TRIM(WS-SUFFIX) DELIMITED SIZE
        INTO BK-EVT-TYPE
    END-STRING
    MOVE CEN-ENTITY TO BK-EVT-KEY
    MOVE WS-PAYLOAD TO BK-EVT-PAYLOAD
    CALL "BEVT" USING BK-EVT-PARMS.
