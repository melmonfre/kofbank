IDENTIFICATION DIVISION.
PROGRAM-ID. BCRASTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT APP-FILE ASSIGN TO WS-APP-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CRA-ID
        FILE STATUS IS WS-APP-ST.

DATA DIVISION.
FILE SECTION.
FD APP-FILE.
01 APP-REC.
   COPY "BCRA".

WORKING-STORAGE SECTION.
01 WS-APP-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-APP-ST PIC X(02).

LINKAGE SECTION.
COPY "BCRSTO".
01 BK-CR-APP-REC.
   COPY "BCRA".

PROCEDURE DIVISION USING BK-CR-STO-REQ BK-CR-APP-REC.
    MOVE "00" TO CS-RC
    MOVE SPACES TO CS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-APP-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/crapp.idx"
        DELIMITED SIZE INTO WS-APP-PATH
    PERFORM OPEN-STORE
    IF CS-RC NOT = "00"
        GOBACK
    END-IF
    EVALUATE CS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN "UPDATE" PERFORM DO-UPDATE
        WHEN "GET" PERFORM DO-GET
        WHEN OTHER
            MOVE "99" TO CS-RC
            MOVE "UNKNOWN CREDIT APP STORE OP" TO CS-MSG
    END-EVALUATE
    CLOSE APP-FILE
    GOBACK.

OPEN-STORE.
    OPEN I-O APP-FILE
    IF WS-APP-ST = "35"
        OPEN OUTPUT APP-FILE
        CLOSE APP-FILE
        OPEN I-O APP-FILE
    END-IF
    IF WS-APP-ST NOT = "00"
        MOVE WS-APP-ST TO CS-RC
        MOVE "CANNOT OPEN CREDIT APP INDEX" TO CS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-CR-APP-REC TO APP-REC
    WRITE APP-REC
        INVALID KEY
            MOVE "22" TO CS-RC
            MOVE "CREDIT APPLICATION ALREADY EXISTS" TO CS-MSG
    END-WRITE.

DO-REWRITE.
    MOVE CRA-ID OF BK-CR-APP-REC TO CRA-ID OF APP-REC
    READ APP-FILE
    IF WS-APP-ST = "00"
        MOVE BK-CR-APP-REC TO APP-REC
        REWRITE APP-REC
    ELSE
        MOVE "23" TO CS-RC
        MOVE "CREDIT APPLICATION NOT FOUND" TO CS-MSG
    END-IF.

DO-UPDATE.
    MOVE CRA-ID OF BK-CR-APP-REC TO CRA-ID OF APP-REC
    READ APP-FILE
    IF WS-APP-ST = "00"
        MOVE BK-CR-APP-REC TO APP-REC
        REWRITE APP-REC
    ELSE
        MOVE BK-CR-APP-REC TO APP-REC
        WRITE APP-REC
    END-IF.

DO-GET.
    MOVE CRA-ID OF BK-CR-APP-REC TO CRA-ID OF APP-REC
    READ APP-FILE
    IF WS-APP-ST = "00"
        MOVE APP-REC TO BK-CR-APP-REC
        MOVE "00" TO CS-RC
    ELSE
        MOVE "23" TO CS-RC
        MOVE "CREDIT APPLICATION NOT FOUND" TO CS-MSG
    END-IF.
