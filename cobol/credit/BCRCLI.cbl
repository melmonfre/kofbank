IDENTIFICATION DIVISION.
PROGRAM-ID. BCRCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-OP PIC X(24).
01 WS-A PIC X(24).
01 WS-B PIC X(24).
01 WS-C PIC X(24).
01 WS-D PIC X(24).
01 WS-E PIC X(24).
01 WS-F PIC X(40).
01 WS-G PIC X(12).
01 WS-H PIC X(24).
01 WS-I PIC X(24).
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT-ED PIC -(15)9.99.
01 WS-ACT PIC X(12).
01 WS-INST PIC 9(04).
01 WS-QOP PIC X(08).
01 WS-QRC PIC X(02).
COPY "BCRAP".
COPY "BCRFP".
COPY "BCRRP".
COPY "BCRWP".
COPY "BCRDP".
COPY "BCRSP".
COPY "BCREXP".
COPY "BCRQ".
01 WS-FAC-REC.
   COPY "BCRF".
01 WS-APP-REC.
   COPY "BCRA".

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "application.create" PERFORM DO-APP-CREATE
        WHEN "application.approve" PERFORM DO-APP-ACTION
        WHEN "application.condition" PERFORM DO-APP-ACTION
        WHEN "application.satisfy" PERFORM DO-APP-ACTION
        WHEN "application.reject" PERFORM DO-APP-ACTION
        WHEN "application.cancel" PERFORM DO-APP-ACTION
        WHEN "application.get" PERFORM DO-APP-GET
        WHEN "application.list" PERFORM DO-APP-LIST
        WHEN "facility.originate" PERFORM DO-FAC-ORIG
        WHEN "facility.approve" PERFORM DO-FAC-ACTION
        WHEN "facility.contract" PERFORM DO-FAC-CONTRACT
        WHEN "facility.activate" PERFORM DO-FAC-ACTION
        WHEN "facility.suspend" PERFORM DO-FAC-ACTION
        WHEN "facility.resume" PERFORM DO-FAC-ACTION
        WHEN "facility.block" PERFORM DO-FAC-ACTION
        WHEN "facility.unblock" PERFORM DO-FAC-ACTION
        WHEN "facility.expire" PERFORM DO-FAC-ACTION
        WHEN "facility.mature" PERFORM DO-FAC-ACTION
        WHEN "facility.close" PERFORM DO-FAC-ACTION
        WHEN "facility.cancel" PERFORM DO-FAC-ACTION
        WHEN "facility.default" PERFORM DO-FAC-ACTION
        WHEN "facility.get" PERFORM DO-FAC-GET
        WHEN "facility.list" PERFORM DO-FAC-LIST
        WHEN "facility.exposure" PERFORM DO-FAC-EXP
        WHEN "facility.schedule" PERFORM DO-FAC-SCHED
        WHEN "disbursement.create" PERFORM DO-DISBURSE
        WHEN "repayment.create" PERFORM DO-REPAY
        WHEN "writeoff.create" PERFORM DO-WRITEOFF
        WHEN "installment.get" PERFORM DO-INST-GET
        WHEN "installment.list" PERFORM DO-INST-LIST
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN CREDIT OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H WS-I
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G WS-H WS-I
    END-UNSTRING.

PARSE-AMOUNT.
    MOVE 0 TO WS-AMT
    MOVE WS-A TO WS-AMT.

DO-APP-CREATE.
    MOVE WS-A TO CA-CUST-ID
    MOVE WS-B TO CA-PRODUCT
    MOVE WS-C TO CA-ACCOUNT
    MOVE WS-D TO WS-AMT
    MOVE WS-AMT TO CA-REQUESTED
    MOVE WS-E TO CA-TERM
    MOVE WS-F TO CA-OPERATOR
    MOVE WS-G TO CA-CORR
    MOVE WS-H TO CA-REQUEST
    MOVE "CREATE" TO CA-OP
    CALL "BCRA" USING BK-CR-APP-PARMS
    DISPLAY "rc=" CA-RC
    DISPLAY "application=" FUNCTION TRIM(CA-APP-ID)
    DISPLAY "msg=" FUNCTION TRIM(CA-MSG).

DO-APP-ACTION.
    MOVE WS-A TO CA-APP-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CA-APPROVED
    MOVE WS-C TO CA-CONDITIONS
    MOVE WS-C TO CA-REASON
    MOVE WS-D TO CA-OPERATOR
    MOVE WS-E TO CA-CORR
    MOVE WS-F TO CA-REQUEST
    MOVE FUNCTION UPPER-CASE(WS-OP(13:12)) TO WS-ACT
    MOVE WS-ACT TO CA-OP
    CALL "BCRA" USING BK-CR-APP-PARMS
    DISPLAY "rc=" CA-RC
    DISPLAY "application=" FUNCTION TRIM(CA-APP-ID)
    DISPLAY "msg=" FUNCTION TRIM(CA-MSG).

DO-APP-GET.
    MOVE "GET" TO WS-QOP
    CALL "BCRAQ" USING WS-QOP WS-A WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-APP-LIST.
    MOVE "LIST" TO WS-QOP
    CALL "BCRAQ" USING WS-QOP WS-A WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-FAC-ORIG.
    MOVE WS-A TO CF-APP-ID
    MOVE WS-B TO CF-ACCOUNT
    MOVE WS-C TO CF-EXPIRES
    MOVE WS-D TO CF-COLLATERAL
    MOVE WS-E TO CF-OPERATOR
    MOVE WS-F TO CF-CORR
    MOVE WS-G TO CF-REQUEST
    CALL "BCRFORG" USING BK-CR-FAC-PARMS
    DISPLAY "rc=" CF-RC
    DISPLAY "facility=" FUNCTION TRIM(CF-FAC-ID)
    DISPLAY "msg=" FUNCTION TRIM(CF-MSG).

DO-FAC-CONTRACT.
    MOVE WS-A TO CF-FAC-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CF-AMOUNT
    MOVE WS-C TO CF-COLLATERAL
    MOVE WS-D TO CF-CONDITIONS
    MOVE WS-E TO CF-OPERATOR
    MOVE WS-F TO CF-CORR
    MOVE WS-G TO CF-REQUEST
    MOVE "CONTRACT" TO CF-OP
    CALL "BCRF" USING BK-CR-FAC-PARMS
    DISPLAY "rc=" CF-RC
    DISPLAY "facility=" FUNCTION TRIM(CF-FAC-ID)
    DISPLAY "msg=" FUNCTION TRIM(CF-MSG).

DO-FAC-ACTION.
    MOVE WS-A TO CF-FAC-ID
    MOVE WS-B TO CF-REASON
    MOVE WS-C TO CF-OPERATOR
    MOVE WS-D TO CF-CORR
    MOVE WS-E TO CF-REQUEST
    MOVE FUNCTION UPPER-CASE(WS-OP(10:12)) TO WS-ACT
    MOVE WS-ACT TO CF-OP
    CALL "BCRF" USING BK-CR-FAC-PARMS
    DISPLAY "rc=" CF-RC
    DISPLAY "facility=" FUNCTION TRIM(CF-FAC-ID)
    DISPLAY "msg=" FUNCTION TRIM(CF-MSG).

DO-FAC-GET.
    MOVE "GET" TO WS-QOP
    CALL "BCRFQ" USING WS-QOP WS-A WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-FAC-LIST.
    MOVE "LIST" TO WS-QOP
    CALL "BCRFQ" USING WS-QOP WS-A WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-FAC-EXP.
    MOVE "GET" TO WS-QOP
    CALL "BCRXQ" USING WS-QOP WS-A WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-FAC-SCHED.
    MOVE WS-A TO SCH-FAC-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO SCH-PRINCIPAL
    MOVE WS-C TO SCH-RATE-BPS
    MOVE WS-D TO SCH-BASIS
    MOVE WS-E TO SCH-TERM
    MOVE WS-F TO SCH-EFF
    MOVE "GENERATE" TO SCH-OP
    CALL "BCRSCH" USING BK-CR-SCH-PARMS
    DISPLAY "rc=" SCH-RC
    DISPLAY "installments=" SCH-COUNT
    DISPLAY "msg=" FUNCTION TRIM(SCH-MSG).

DO-DISBURSE.
    MOVE WS-A TO CD-FAC-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CD-AMOUNT
    MOVE WS-C TO WS-AMT
    MOVE WS-AMT TO CD-FEE
    MOVE WS-D TO CD-OPERATOR
    MOVE WS-E TO CD-CORR
    MOVE WS-F TO CD-REQUEST
    CALL "BCRDIS" USING BK-CR-DISB-PARMS
    DISPLAY "rc=" CD-RC
    DISPLAY "txn=" FUNCTION TRIM(CD-TXN-ID)
    DISPLAY "msg=" FUNCTION TRIM(CD-MSG).

DO-REPAY.
    MOVE WS-A TO CR-FAC-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CR-AMOUNT
    MOVE WS-C TO CR-OPERATOR
    MOVE WS-D TO CR-CORR
    MOVE WS-E TO CR-REQUEST
    CALL "BCRPAY" USING BK-CR-REPAY-PARMS
    DISPLAY "rc=" CR-RC
    DISPLAY "txn=" FUNCTION TRIM(CR-TXN-ID)
    DISPLAY "principal=" CR-PRINCIPAL
    DISPLAY "interest=" CR-INTEREST
    DISPLAY "fees=" CR-FEES
    DISPLAY "excess=" CR-EXCESS
    DISPLAY "msg=" FUNCTION TRIM(CR-MSG).

DO-WRITEOFF.
    MOVE WS-A TO CW-FAC-ID
    MOVE WS-B TO WS-AMT
    MOVE WS-AMT TO CW-AMOUNT
    MOVE WS-C TO CW-REASON
    MOVE WS-D TO CW-OPERATOR
    MOVE WS-E TO CW-CORR
    MOVE WS-F TO CW-REQUEST
    CALL "BCRWOF" USING BK-CR-WOF-PARMS
    DISPLAY "rc=" CW-RC
    DISPLAY "txn=" FUNCTION TRIM(CW-TXN-ID)
    DISPLAY "msg=" FUNCTION TRIM(CW-MSG).

DO-INST-GET.
    MOVE WS-B TO WS-INST
    MOVE "GET" TO WS-QOP
    CALL "BCROQ" USING WS-QOP WS-A WS-INST WS-QRC
    DISPLAY "rc=" WS-QRC.

DO-INST-LIST.
    MOVE 0 TO WS-INST
    MOVE "LIST" TO WS-QOP
    CALL "BCROQ" USING WS-QOP WS-A WS-INST WS-QRC
    DISPLAY "rc=" WS-QRC.
