IDENTIFICATION DIVISION.
PROGRAM-ID. BPAYCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BPAYREQP".
COPY "BPAYRESP".
01 WS-OP PIC X(20).
01 WS-A PIC X(24).
01 WS-B PIC X(20).
01 WS-C PIC X(20).
01 WS-D PIC X(20).
01 WS-E PIC X(20).
01 WS-F PIC X(20).
01 WS-G PIC X(40).
01 WS-H PIC X(12).
01 WS-I PIC X(24).
01 WS-J PIC X(24).
01 WS-K PIC X(24).
01 WS-AMT PIC S9(15)V99 COMP-3.
01 WS-AMT-ED PIC -(15)9.99.
01 WS-PAY-REC.
   COPY "BPAYREC".
01 WS-QRC PIC X(02).

LINKAGE SECTION.
01 WS-LINE PIC X(1000).

PROCEDURE DIVISION USING WS-LINE.
    PERFORM PARSE-LINE
    EVALUATE WS-OP
        WHEN "create" PERFORM DO-CREATE
        WHEN "get" PERFORM DO-GET
        WHEN "return" PERFORM DO-RETURN
        WHEN "reverse" PERFORM DO-REVERSE
        WHEN OTHER
            DISPLAY "rc=20"
            DISPLAY "msg=UNKNOWN PAYMENT OP"
    END-EVALUATE
    GOBACK.

PARSE-LINE.
    MOVE SPACES TO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G
        WS-H WS-I WS-J WS-K
    UNSTRING WS-LINE DELIMITED BY "|"
        INTO WS-OP WS-A WS-B WS-C WS-D WS-E WS-F WS-G
        WS-H WS-I WS-J WS-K
    END-UNSTRING.

DO-CREATE.
    MOVE WS-A TO PAY-REQ-TYPE
    MOVE WS-B TO PAY-REQ-RAIL
    MOVE WS-C TO PAY-REQ-SRC
    MOVE WS-D TO PAY-REQ-DST
    MOVE 0 TO WS-AMT
    MOVE WS-E TO WS-AMT
    MOVE WS-AMT TO PAY-REQ-AMOUNT
    MOVE WS-F TO PAY-REQ-CURRENCY
    MOVE WS-G TO PAY-REQ-DESCR
    MOVE WS-H TO PAY-REQ-OPERATOR
    MOVE WS-I TO PAY-REQ-CORR
    MOVE WS-J TO PAY-REQ-REQUEST
    MOVE WS-K TO PAY-REQ-IDEM
    MOVE SPACES TO PAY-REQ-MODE
    MOVE SPACES TO PAY-REQ-REASON
    MOVE SPACES TO PAY-REQ-ORIGIN
    CALL "BPAYOPR" USING BK-PAY-REQ BK-PAY-RES
    PERFORM SHOW-RESULT.

DO-GET.
    CALL "BPAYQRY" USING WS-A WS-PAY-REC WS-QRC
    DISPLAY "rc=" WS-QRC
    IF WS-QRC = "00"
        PERFORM SHOW-RECORD
    END-IF.

DO-RETURN.
    PERFORM SETUP-RTN
    MOVE "RETURN" TO PAY-REQ-MODE
    CALL "BPAYRTN" USING BK-PAY-REQ BK-PAY-RES
    PERFORM SHOW-RESULT.

DO-REVERSE.
    PERFORM SETUP-RTN
    MOVE "REVERSE" TO PAY-REQ-MODE
    CALL "BPAYRTN" USING BK-PAY-REQ BK-PAY-RES
    PERFORM SHOW-RESULT.

SETUP-RTN.
    MOVE WS-A TO PAY-REQ-PAYID
    MOVE WS-B TO PAY-REQ-REASON
    MOVE WS-C TO PAY-REQ-OPERATOR
    MOVE WS-D TO PAY-REQ-CORR
    MOVE WS-E TO PAY-REQ-REQUEST
    MOVE SPACES TO PAY-REQ-IDEM
    MOVE SPACES TO PAY-REQ-TYPE
    MOVE SPACES TO PAY-REQ-RAIL.

SHOW-RESULT.
    DISPLAY "rc=" PAY-RES-RC
    DISPLAY "id=" FUNCTION TRIM(PAY-RES-ID)
    DISPLAY "status=" PAY-RES-STATUS
    DISPLAY "msg=" FUNCTION TRIM(PAY-RES-MSG).

SHOW-RECORD.
    MOVE PAY-AMOUNT TO WS-AMT-ED
    DISPLAY "id=" FUNCTION TRIM(PAY-ID)
    DISPLAY "type=" FUNCTION TRIM(PAY-TYPE)
    DISPLAY "rail=" FUNCTION TRIM(PAY-RAIL)
    DISPLAY "source=" FUNCTION TRIM(PAY-SRC)
    DISPLAY "destination=" FUNCTION TRIM(PAY-DST)
    DISPLAY "amount=" WS-AMT-ED
    DISPLAY "currency=" FUNCTION TRIM(PAY-CURRENCY)
    DISPLAY "status=" PAY-STATUS
    DISPLAY "request=" FUNCTION TRIM(PAY-REQUEST)
    DISPLAY "txn=" FUNCTION TRIM(PAY-TXN-ID)
    DISPLAY "journal=" FUNCTION TRIM(PAY-JRN-ID)
    DISPLAY "created=" PAY-CREATED
    DISPLAY "valuedate=" PAY-VALUEDATE
    DISPLAY "settled=" PAY-SETTLED
    DISPLAY "version=" PAY-VERSION
    DISPLAY "hash=" FUNCTION TRIM(PAY-HASH).
