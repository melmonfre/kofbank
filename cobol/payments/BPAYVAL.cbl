IDENTIFICATION DIVISION.
PROGRAM-ID. BPAYVAL.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-RAIL-ACTIVE PIC X(01).
01 WS-RAIL-RC PIC X(02).
01 WS-CUR-ACTIVE PIC X(01).
01 WS-CUR-RC PIC X(02).
01 WS-SRC-OUT.
   05 SO-ID PIC X(12).
   05 SO-CUST PIC X(12).
   05 SO-PRODUCT PIC X(04).
   05 SO-CURRENCY PIC X(03).
   05 SO-STATUS PIC X(02).
   05 SO-OPENED PIC 9(08).
   05 SO-CLOSED PIC 9(08).
   05 SO-VERSION PIC 9(05).
   05 SO-HASH PIC X(16).
   05 SO-RC PIC X(02).
01 WS-DST-OUT.
   05 DO-ID PIC X(12).
   05 DO-CUST PIC X(12).
   05 DO-PRODUCT PIC X(04).
   05 DO-CURRENCY PIC X(03).
   05 DO-STATUS PIC X(02).
   05 DO-OPENED PIC 9(08).
   05 DO-CLOSED PIC 9(08).
   05 DO-VERSION PIC 9(05).
   05 DO-HASH PIC X(16).
   05 DO-RC PIC X(02).
01 WS-BAL-OUT.
   05 BO-LEDGER PIC S9(15)V99 COMP-3.
   05 BO-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BO-BLOCKED PIC S9(15)V99 COMP-3.
   05 BO-CURRENCY PIC X(03).
   05 BO-UPDATED PIC 9(08).
   05 BO-SEQ PIC 9(12).
   05 BO-RC PIC X(02).
COPY "BLIMP".

LINKAGE SECTION.
COPY "BPAYREQP".
01 LS-RC PIC X(02).
01 LS-MSG PIC X(80).

PROCEDURE DIVISION USING BK-PAY-REQ LS-RC LS-MSG.
    MOVE "00" TO LS-RC
    MOVE SPACES TO LS-MSG
    IF PAY-REQ-TYPE NOT = "INTERNAL"
        MOVE "20" TO LS-RC
        MOVE "UNSUPPORTED PAYMENT TYPE" TO LS-MSG
        GOBACK
    END-IF
    CALL "BPAYRAIL" USING PAY-REQ-RAIL WS-RAIL-ACTIVE WS-RAIL-RC
    IF WS-RAIL-ACTIVE NOT = "Y"
        MOVE "20" TO LS-RC
        MOVE "PAYMENT RAIL NOT ACTIVE" TO LS-MSG
        GOBACK
    END-IF
    CALL "BPAYCUR" USING PAY-REQ-CURRENCY WS-CUR-ACTIVE WS-CUR-RC
    IF WS-CUR-ACTIVE NOT = "Y"
        MOVE "20" TO LS-RC
        MOVE "CURRENCY NOT ACTIVE" TO LS-MSG
        GOBACK
    END-IF
    IF PAY-REQ-AMOUNT <= 0
        MOVE "20" TO LS-RC
        MOVE "AMOUNT MUST BE POSITIVE" TO LS-MSG
        GOBACK
    END-IF
    IF PAY-REQ-SRC = SPACES
        MOVE "20" TO LS-RC
        MOVE "SOURCE ACCOUNT REQUIRED" TO LS-MSG
        GOBACK
    END-IF
    IF PAY-REQ-SRC = PAY-REQ-DST
        MOVE "20" TO LS-RC
        MOVE "SOURCE AND DESTINATION MUST DIFFER" TO LS-MSG
        GOBACK
    END-IF
    CALL "BACQRY" USING PAY-REQ-SRC WS-SRC-OUT
    IF SO-RC NOT = "00"
        MOVE "20" TO LS-RC
        MOVE "SOURCE ACCOUNT NOT FOUND" TO LS-MSG
        GOBACK
    END-IF
    IF SO-STATUS NOT = "AC"
        MOVE "20" TO LS-RC
        MOVE "SOURCE ACCOUNT NOT ACTIVE" TO LS-MSG
        GOBACK
    END-IF
    CALL "BACQRY" USING PAY-REQ-DST WS-DST-OUT
    IF DO-RC NOT = "00"
        MOVE "20" TO LS-RC
        MOVE "DESTINATION ACCOUNT NOT FOUND" TO LS-MSG
        GOBACK
    END-IF
    IF DO-STATUS NOT = "AC"
        MOVE "20" TO LS-RC
        MOVE "DESTINATION ACCOUNT NOT ACTIVE" TO LS-MSG
        GOBACK
    END-IF
    IF SO-CURRENCY NOT = PAY-REQ-CURRENCY
        MOVE "20" TO LS-RC
        MOVE "SOURCE CURRENCY MISMATCH" TO LS-MSG
        GOBACK
    END-IF
    IF DO-CURRENCY NOT = PAY-REQ-CURRENCY
        MOVE "20" TO LS-RC
        MOVE "DESTINATION CURRENCY MISMATCH" TO LS-MSG
        GOBACK
    END-IF
    CALL "BGLBAL" USING PAY-REQ-SRC WS-BAL-OUT
    IF BO-RC NOT = "00"
        MOVE "20" TO LS-RC
        MOVE "SOURCE BALANCE NOT FOUND" TO LS-MSG
        GOBACK
    END-IF
    IF BO-AVAILABLE < PAY-REQ-AMOUNT
        MOVE "20" TO LS-RC
        MOVE "INSUFFICIENT FUNDS" TO LS-MSG
        GOBACK
    END-IF
    PERFORM CHECK-LIMIT.

CHECK-LIMIT.
    MOVE "CHANNEL" TO LIM-SCOPE
    MOVE "PAY" TO LIM-KEY
    MOVE "DAILY" TO LIM-PERIOD
    MOVE PAY-REQ-AMOUNT TO LIM-AMOUNT
    MOVE PAY-REQ-CURRENCY TO LIM-CURRENCY
    MOVE "CHECK" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ
    IF LIM-RC NOT = "00"
        MOVE "20" TO LS-RC
        MOVE LIM-MSG TO LS-MSG
    END-IF.
