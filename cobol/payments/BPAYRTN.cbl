IDENTIFICATION DIVISION.
PROGRAM-ID. BPAYRTN.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PAY-FILE ASSIGN TO WS-PAY-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PAY-ID
        FILE STATUS IS WS-PAY-ST.

DATA DIVISION.
FILE SECTION.
FD PAY-FILE.
01 PAY-REC.
   COPY "BPAYREC".

WORKING-STORAGE SECTION.
01 WS-PAY-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-PAY-ST PIC X(02).
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BKIDMP".
COPY "BPAYPSP".
COPY "BLIMP".
01 WS-AMT-ED PIC -(15)9.99.
01 WS-EVT-PAYLOAD PIC X(200).
01 WS-IDM-HIT PIC X(01) VALUE "N".
01 WS-KEY PIC X(24).
01 WS-ACTION PIC X(08).
01 WS-NEXT PIC X(02).
01 WS-STT-RC PIC X(02).
01 WS-STT-MSG PIC X(80).
01 WS-DST-OUT.
   05 DO-ID PIC X(12).
   05 DO-CUST PIC X(12).
   05 DO-PRODUCT PIC X(04).
   05 DO-CURRENCY PIC X(03).
   05 DO-STATUS PIC X(02).
   05 DO-OPENED PIC 9(08).
   05 DO-CLOSED PIC 9(08).
   05 DO-VERSION PIC 9(05).
   05 DO-HASH PIC X(16).
   05 DO-RC PIC X(02).
01 WS-BAL-OUT.
   05 BO-LEDGER PIC S9(15)V99 COMP-3.
   05 BO-AVAILABLE PIC S9(15)V99 COMP-3.
   05 BO-BLOCKED PIC S9(15)V99 COMP-3.
   05 BO-CURRENCY PIC X(03).
   05 BO-UPDATED PIC 9(08).
   05 BO-SEQ PIC 9(12).
   05 BO-RC PIC X(02).
01 WS-TARGET PIC X(02).

LINKAGE SECTION.
COPY "BPAYREQP".
COPY "BPAYRESP".

PROCEDURE DIVISION USING BK-PAY-REQ BK-PAY-RES.
    MOVE SPACES TO PAY-RES-ID
    MOVE SPACES TO PAY-RES-STATUS
    MOVE SPACES TO PAY-RES-TXN-ID
    MOVE SPACES TO PAY-RES-JRN-ID
    MOVE SPACES TO PAY-RES-MSG
    MOVE "00" TO PAY-RES-RC
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    CALL "BCFG" USING WS-CFG
    MOVE SPACES TO WS-PAY-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pay.idx"
        DELIMITED SIZE INTO WS-PAY-PATH
    IF PAY-REQ-PAYID = SPACES
        MOVE "20" TO PAY-RES-RC
        MOVE "PAYMENT ID REQUIRED" TO PAY-RES-MSG
        GOBACK
    END-IF
    IF PAY-REQ-REQUEST = SPACES
        MOVE "20" TO PAY-RES-RC
        MOVE "REQUEST ID REQUIRED" TO PAY-RES-MSG
        GOBACK
    END-IF
    EVALUATE PAY-REQ-MODE
        WHEN "RETURN"
            MOVE "RETURN" TO WS-ACTION
            MOVE "RT" TO WS-TARGET
        WHEN "REVERSE"
            MOVE "REVERSE" TO WS-ACTION
            MOVE "RV" TO WS-TARGET
        WHEN OTHER
            MOVE "20" TO PAY-RES-RC
            MOVE "MODE MUST BE RETURN OR REVERSE" TO PAY-RES-MSG
            GOBACK
    END-EVALUATE
    MOVE PAY-REQ-REQUEST TO WS-KEY
    PERFORM CHECK-IDEMPOTENCY
    IF WS-IDM-HIT = "Y"
        GOBACK
    END-IF
    IF PAY-RES-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM LOAD-PAYMENT
    IF PAY-RES-RC NOT = "00"
        GOBACK
    END-IF
    CALL "BPAYSTT" USING PAY-STATUS WS-ACTION WS-NEXT
        WS-STT-RC WS-STT-MSG
    IF WS-STT-RC NOT = "00"
        MOVE "20" TO PAY-RES-RC
        MOVE WS-STT-MSG TO PAY-RES-MSG
        PERFORM MARK-FAIL
        GOBACK
    END-IF
    PERFORM CHECK-DESTINATION
    IF PAY-RES-RC NOT = "00"
        PERFORM MARK-FAIL
        GOBACK
    END-IF
    PERFORM POST-RETURN
    GOBACK.

CHECK-IDEMPOTENCY.
    MOVE WS-KEY TO BK-IDM-TXN-ID
    MOVE "PAY.RETURN" TO BK-IDM-OPERATION
    MOVE "B" TO BK-IDM-MODE
    MOVE SPACES TO BK-IDM-RESULT
    CALL "BIDM" USING BK-IDM-PARMS
    IF BK-IDM-STATUS = "22"
        MOVE "G" TO BK-IDM-MODE
        CALL "BIDM" USING BK-IDM-PARMS
        EVALUATE BK-IDM-STATUS
            WHEN "C"
                MOVE BK-IDM-RESULT(1:12) TO PAY-RES-ID
                MOVE BK-IDM-RESULT(13:2) TO PAY-RES-STATUS
                MOVE BK-IDM-RESULT(31:90) TO PAY-RES-MSG
                MOVE "00" TO PAY-RES-RC
                MOVE "Y" TO WS-IDM-HIT
            WHEN "F"
                CONTINUE
            WHEN OTHER
                MOVE "24" TO PAY-RES-RC
                MOVE "REQUEST IN PROGRESS" TO PAY-RES-MSG
        END-EVALUATE
    ELSE
        IF BK-IDM-STATUS NOT = "00"
            MOVE BK-IDM-STATUS TO PAY-RES-RC
            MOVE "IDEMPOTENCY STORE ERROR" TO PAY-RES-MSG
        END-IF
    END-IF.

LOAD-PAYMENT.
    OPEN I-O PAY-FILE
    IF WS-PAY-ST NOT = "00"
        MOVE "35" TO PAY-RES-RC
        MOVE "PAYMENT INDEX MISSING" TO PAY-RES-MSG
        GOBACK
    END-IF
    MOVE PAY-REQ-PAYID TO PAY-ID
    READ PAY-FILE
    IF WS-PAY-ST NOT = "00"
        MOVE "23" TO PAY-RES-RC
        MOVE "PAYMENT NOT FOUND" TO PAY-RES-MSG
    ELSE
        MOVE PAY-ID TO PAY-RES-ID
    END-IF
    CLOSE PAY-FILE.

CHECK-DESTINATION.
    CALL "BACQRY" USING PAY-SRC WS-DST-OUT
    IF DO-RC NOT = "00"
        MOVE "20" TO PAY-RES-RC
        MOVE "ORIGIN ACCOUNT NOT FOUND" TO PAY-RES-MSG
        GOBACK
    END-IF
    IF DO-STATUS NOT = "AC"
        MOVE "20" TO PAY-RES-RC
        MOVE "ORIGIN ACCOUNT NOT ACTIVE" TO PAY-RES-MSG
        GOBACK
    END-IF
    CALL "BGLBAL" USING PAY-SRC WS-BAL-OUT
    IF BO-RC NOT = "00"
        MOVE "20" TO PAY-RES-RC
        MOVE "ORIGIN BALANCE NOT FOUND" TO PAY-RES-MSG
        GOBACK
    END-IF
    IF BO-AVAILABLE < PAY-AMOUNT
        MOVE "20" TO PAY-RES-RC
        MOVE "INSUFFICIENT FUNDS" TO PAY-RES-MSG
    END-IF.

POST-RETURN.
    MOVE PAY-DST TO PPO-SRC
    MOVE PAY-SRC TO PPO-DST
    MOVE PAY-AMOUNT TO PPO-AMOUNT
    MOVE PAY-CURRENCY TO PPO-CURRENCY
    MOVE SPACES TO PPO-JRN-ID
    STRING WS-TARGET DELIMITED SIZE "-" DELIMITED SIZE
        FUNCTION TRIM(PAY-RES-ID) DELIMITED SIZE
        INTO PPO-JRN-ID
    END-STRING
    MOVE SPACES TO PPO-TXN-ID
    STRING WS-TARGET DELIMITED SIZE "-" DELIMITED SIZE
        FUNCTION TRIM(PAY-RES-ID) DELIMITED SIZE
        INTO PPO-TXN-ID
    END-STRING
    MOVE PAY-REQ-REQUEST TO PPO-REQUEST
    MOVE PAY-REQ-REASON TO PPO-DESCR
    MOVE PAY-REQ-OPERATOR TO PPO-OPERATOR
    MOVE PAY-REQ-CORR TO PPO-CORR
    MOVE WS-BIZDATE TO PPO-BIZDATE
    CALL "BPAYPOST" USING BK-PAY-POST-REQ
    IF PPO-RC NOT = "00"
        MOVE PPO-RC TO PAY-RES-RC
        MOVE PPO-MSG TO PAY-RES-MSG
        PERFORM MARK-FAIL
        GOBACK
    END-IF
    MOVE PPO-TXN-ID TO PAY-RES-TXN-ID
    MOVE PPO-JRN-ID TO PAY-RES-JRN-ID
    PERFORM UPDATE-PAYMENT
    PERFORM FINALIZE.

UPDATE-PAYMENT.
    OPEN I-O PAY-FILE
    IF WS-PAY-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE PAY-REQ-PAYID TO PAY-ID
    READ PAY-FILE
    IF WS-PAY-ST = "00"
        MOVE WS-TARGET TO PAY-STATUS
        MOVE PAY-REQ-REASON TO PAY-REASON
        MOVE PAY-REQ-ORIGIN TO PAY-ORIGIN
        ADD 1 TO PAY-VERSION
        REWRITE PAY-REC
    END-IF
    CLOSE PAY-FILE.

FINALIZE.
    PERFORM RELEASE-LIMIT
    MOVE PAY-REQ-OPERATOR TO BK-AUD-OPERATOR
    MOVE "PAY.RETURN" TO BK-AUD-ACTION
    MOVE PAY-RES-ID TO BK-AUD-ENTITY
    MOVE PAY-REQ-CORR TO BK-AUD-CORR
    MOVE WS-TARGET TO BK-AUD-BEFORE
    MOVE PAY-REQ-REASON TO BK-AUD-AFTER
    MOVE PAY-RES-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE PAY-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-EVT-PAYLOAD
    STRING FUNCTION TRIM(PAY-RES-ID) DELIMITED SIZE
        "|" DELIMITED SIZE WS-TARGET DELIMITED SIZE
        "|" DELIMITED SIZE WS-AMT-ED DELIMITED SIZE
        INTO WS-EVT-PAYLOAD
    END-STRING
    IF WS-TARGET = "RV"
        MOVE "PAYMENT.REVERSED.v1" TO BK-EVT-TYPE
    ELSE
        MOVE "PAYMENT.RETURNED.v1" TO BK-EVT-TYPE
    END-IF
    MOVE PAY-RES-ID TO BK-EVT-KEY
    MOVE WS-EVT-PAYLOAD TO BK-EVT-PAYLOAD
    CALL "BEVT" USING BK-EVT-PARMS
    MOVE WS-TARGET TO PAY-RES-STATUS
    IF WS-TARGET = "RV"
        MOVE "REVERSED" TO PAY-RES-MSG
    ELSE
        MOVE "RETURNED" TO PAY-RES-MSG
    END-IF
    MOVE WS-KEY TO BK-IDM-TXN-ID
    MOVE SPACES TO BK-IDM-RESULT
    MOVE PAY-RES-ID TO BK-IDM-RESULT(1:12)
    MOVE PAY-RES-STATUS TO BK-IDM-RESULT(13:2)
    MOVE PAY-RES-MSG TO BK-IDM-RESULT(31:90)
    MOVE "C" TO BK-IDM-MODE
    CALL "BIDM" USING BK-IDM-PARMS.

RELEASE-LIMIT.
    MOVE "CHANNEL" TO LIM-SCOPE
    MOVE "PAY" TO LIM-KEY
    MOVE "DAILY" TO LIM-PERIOD
    MOVE PAY-AMOUNT TO LIM-AMOUNT
    MOVE PAY-CURRENCY TO LIM-CURRENCY
    MOVE "RELEASE" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ.

MARK-FAIL.
    MOVE WS-KEY TO BK-IDM-TXN-ID
    MOVE PAY-RES-MSG TO BK-IDM-RESULT
    MOVE "F" TO BK-IDM-MODE
    CALL "BIDM" USING BK-IDM-PARMS.
