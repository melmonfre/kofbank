IDENTIFICATION DIVISION.
PROGRAM-ID. BPAYOPR.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 PAY-REC.
   COPY "BPAYREC".
01 WS-CFG.
   05 WS-HOME-CFG PIC X(80).
   05 WS-BIZDATE PIC 9(08).
   05 WS-CURRENCY PIC X(03).
   05 WS-JRN-GEN PIC 9(09).
   05 WS-CFG-ST PIC X(02).
COPY "BKAUDP".
COPY "BKEVTP".
COPY "BKIDMP".
COPY "BPAYPSP".
COPY "BPAYSTOP".
COPY "BLIMP".
01 WS-SEQ PIC 9(12).
01 WS-SEQ-ST PIC X(02).
01 WS-SEQ-NAME PIC X(20) VALUE "PAYMENT".
01 WS-ID-NUM PIC 9(11).
01 WS-ID-ED PIC X(11).
01 WS-AMT-ED PIC -(15)9.99.
01 WS-REQ-BUF PIC X(400).
01 WS-HASH-LEN PIC 9(04).
01 WS-REQ-HASH PIC X(16).
01 WS-REC-HASH PIC X(16).
01 WS-EVT-PAYLOAD PIC X(200).
01 WS-IDM-HIT PIC X(01) VALUE "N".
01 WS-USE-IDM PIC X(01) VALUE "N".
01 WS-KEY PIC X(24).

LINKAGE SECTION.
COPY "BPAYREQP".
COPY "BPAYRESP".

PROCEDURE DIVISION USING BK-PAY-REQ BK-PAY-RES.
    MOVE SPACES TO PAY-RES-ID
    MOVE SPACES TO PAY-RES-STATUS
    MOVE SPACES TO PAY-RES-TXN-ID
    MOVE SPACES TO PAY-RES-JRN-ID
    MOVE SPACES TO PAY-RES-MSG
    MOVE "00" TO PAY-RES-RC
    CALL "BCFG" USING WS-CFG
    IF PAY-REQ-REQUEST = SPACES
        MOVE "20" TO PAY-RES-RC
        MOVE "REQUEST ID REQUIRED" TO PAY-RES-MSG
        GOBACK
    END-IF
    PERFORM BUILD-KEY
    PERFORM BUILD-HASH
    PERFORM CHECK-IDEMPOTENCY
    IF WS-IDM-HIT = "Y"
        GOBACK
    END-IF
    IF PAY-RES-RC NOT = "00"
        GOBACK
    END-IF
    PERFORM DO-VALIDATE
    IF PAY-RES-RC NOT = "00"
        PERFORM MARK-FAIL
        GOBACK
    END-IF
    PERFORM CREATE-PAYMENT
    IF PAY-RES-RC NOT = "00"
        PERFORM MARK-FAIL
        GOBACK
    END-IF
    PERFORM SETTLE-PAYMENT
    GOBACK.

BUILD-KEY.
    IF PAY-REQ-IDEM NOT = SPACES
        MOVE PAY-REQ-IDEM TO WS-KEY
        MOVE "Y" TO WS-USE-IDM
    ELSE
        MOVE PAY-REQ-REQUEST TO WS-KEY
        MOVE "Y" TO WS-USE-IDM
    END-IF.

BUILD-HASH.
    MOVE PAY-REQ-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-REQ-BUF
    STRING FUNCTION TRIM(PAY-REQ-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PAY-REQ-RAIL) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PAY-REQ-SRC) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PAY-REQ-DST) DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PAY-REQ-CURRENCY) DELIMITED SIZE
        INTO WS-REQ-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-REQ-BUF WS-HASH-LEN WS-REQ-HASH.

CHECK-IDEMPOTENCY.
    IF WS-USE-IDM NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-KEY TO BK-IDM-TXN-ID
    MOVE "PAY.CREATE" TO BK-IDM-OPERATION
    MOVE "B" TO BK-IDM-MODE
    MOVE SPACES TO BK-IDM-RESULT
    CALL "BIDM" USING BK-IDM-PARMS
    IF BK-IDM-STATUS = "22"
        MOVE "G" TO BK-IDM-MODE
        CALL "BIDM" USING BK-IDM-PARMS
        EVALUATE BK-IDM-STATUS
            WHEN "C"
                IF BK-IDM-RESULT(15:16) = WS-REQ-HASH
                    MOVE BK-IDM-RESULT(1:12) TO PAY-RES-ID
                    MOVE BK-IDM-RESULT(13:2) TO PAY-RES-STATUS
                    MOVE BK-IDM-RESULT(31:90) TO PAY-RES-MSG
                    MOVE "00" TO PAY-RES-RC
                    MOVE "Y" TO WS-IDM-HIT
                ELSE
                    MOVE "20" TO PAY-RES-RC
                    MOVE "IDEMPOTENCY CONFLICT" TO PAY-RES-MSG
                END-IF
            WHEN "F"
                CONTINUE
            WHEN OTHER
                MOVE "24" TO PAY-RES-RC
                MOVE "REQUEST IN PROGRESS" TO PAY-RES-MSG
        END-EVALUATE
    ELSE
        IF BK-IDM-STATUS NOT = "00"
            MOVE BK-IDM-STATUS TO PAY-RES-RC
            MOVE "IDEMPOTENCY STORE ERROR" TO PAY-RES-MSG
        END-IF
    END-IF.

DO-VALIDATE.
    CALL "BPAYVAL" USING BK-PAY-REQ PAY-RES-RC PAY-RES-MSG.

CREATE-PAYMENT.
    CALL "BSEQ" USING WS-SEQ-NAME WS-SEQ WS-SEQ-ST
    MOVE WS-SEQ TO WS-ID-NUM
    MOVE WS-ID-NUM TO WS-ID-ED
    MOVE SPACES TO PAY-RES-ID
    STRING "P" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO PAY-RES-ID
    END-STRING
    MOVE PAY-RES-ID TO PAY-ID
    MOVE PAY-REQ-TYPE TO PAY-TYPE
    MOVE PAY-REQ-RAIL TO PAY-RAIL
    MOVE PAY-REQ-SRC TO PAY-SRC
    MOVE PAY-REQ-DST TO PAY-DST
    MOVE PAY-REQ-AMOUNT TO PAY-AMOUNT
    MOVE PAY-REQ-CURRENCY TO PAY-CURRENCY
    MOVE "CR" TO PAY-STATUS
    MOVE SPACES TO PAY-REF
    MOVE PAY-REQ-REQUEST TO PAY-REQUEST
    MOVE PAY-REQ-CORR TO PAY-CORR
    MOVE PAY-REQ-OPERATOR TO PAY-OPERATOR
    MOVE PAY-REQ-DESCR TO PAY-DESCR
    MOVE SPACES TO PAY-TXN-ID
    MOVE SPACES TO PAY-JRN-ID
    MOVE SPACES TO PAY-ORIGIN
    MOVE SPACES TO PAY-REASON
    MOVE WS-BIZDATE TO PAY-CREATED
    MOVE WS-BIZDATE TO PAY-VALUEDATE
    MOVE 0 TO PAY-SETTLED
    MOVE 1 TO PAY-VERSION
    MOVE SPACES TO PAY-HASH
    PERFORM COMPUTE-REC-HASH
    MOVE "WRITE" TO PS-OP
    CALL "BPAYSTO" USING BK-PAY-STO-REQ PAY-REC
    IF PS-RC NOT = "00"
        MOVE PS-RC TO PAY-RES-RC
        MOVE PS-MSG TO PAY-RES-MSG
    END-IF.

COMPUTE-REC-HASH.
    MOVE PAY-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-REQ-BUF
    STRING FUNCTION TRIM(PAY-ID) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PAY-TYPE) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PAY-RAIL) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PAY-SRC) DELIMITED SIZE "|" DELIMITED SIZE
        FUNCTION TRIM(PAY-DST) DELIMITED SIZE "|" DELIMITED SIZE
        WS-AMT-ED DELIMITED SIZE "|" DELIMITED SIZE
        PAY-STATUS DELIMITED SIZE
        INTO WS-REQ-BUF
    END-STRING
    MOVE 400 TO WS-HASH-LEN
    CALL "BHSH" USING WS-REQ-BUF WS-HASH-LEN WS-REC-HASH
    MOVE WS-REC-HASH TO PAY-HASH.

SETTLE-PAYMENT.
    MOVE PAY-SRC TO PPO-SRC
    MOVE PAY-DST TO PPO-DST
    MOVE PAY-AMOUNT TO PPO-AMOUNT
    MOVE PAY-CURRENCY TO PPO-CURRENCY
    MOVE SPACES TO PPO-JRN-ID
    STRING "PAY" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO PPO-JRN-ID
    END-STRING
    MOVE SPACES TO PPO-TXN-ID
    STRING "PTXN" DELIMITED SIZE WS-ID-ED DELIMITED SIZE
        INTO PPO-TXN-ID
    END-STRING
    MOVE PAY-REQUEST TO PPO-REQUEST
    MOVE PAY-DESCR TO PPO-DESCR
    MOVE PAY-OPERATOR TO PPO-OPERATOR
    MOVE PAY-CORR TO PPO-CORR
    MOVE WS-BIZDATE TO PPO-BIZDATE
    CALL "BPAYPOST" USING BK-PAY-POST-REQ
    IF PPO-RC NOT = "00"
        MOVE PPO-RC TO PAY-RES-RC
        MOVE PPO-MSG TO PAY-RES-MSG
        PERFORM MARK-PAY-FAIL
        PERFORM MARK-FAIL
        GOBACK
    END-IF
    MOVE PPO-TXN-ID TO PAY-RES-TXN-ID
    MOVE PPO-JRN-ID TO PAY-RES-JRN-ID
    MOVE PAY-RES-TXN-ID TO PAY-TXN-ID
    MOVE PAY-RES-JRN-ID TO PAY-JRN-ID
    MOVE "ST" TO PAY-STATUS
    MOVE WS-BIZDATE TO PAY-SETTLED
    MOVE 2 TO PAY-VERSION
    PERFORM COMPUTE-REC-HASH
    PERFORM UPDATE-PAYMENT
    PERFORM CONSUME-LIMIT
    PERFORM FINALIZE.

CONSUME-LIMIT.
    MOVE "CHANNEL" TO LIM-SCOPE
    MOVE "PAY" TO LIM-KEY
    MOVE "DAILY" TO LIM-PERIOD
    MOVE PAY-AMOUNT TO LIM-AMOUNT
    MOVE PAY-CURRENCY TO LIM-CURRENCY
    MOVE "CONSUME" TO LIM-OP
    CALL "BLIM" USING BK-LIM-REQ.

UPDATE-PAYMENT.
    MOVE "REWRITE" TO PS-OP
    CALL "BPAYSTO" USING BK-PAY-STO-REQ PAY-REC.

MARK-PAY-FAIL.
    MOVE "RJ" TO PAY-STATUS
    MOVE PPO-MSG TO PAY-REASON
    MOVE 2 TO PAY-VERSION
    MOVE "REWRITE" TO PS-OP
    CALL "BPAYSTO" USING BK-PAY-STO-REQ PAY-REC.

FINALIZE.
    MOVE PAY-OPERATOR TO BK-AUD-OPERATOR
    MOVE "PAY.CREATE" TO BK-AUD-ACTION
    MOVE PAY-RES-ID TO BK-AUD-ENTITY
    MOVE PAY-CORR TO BK-AUD-CORR
    MOVE PAY-SRC TO BK-AUD-BEFORE
    MOVE PAY-DST TO BK-AUD-AFTER
    MOVE PAY-RES-RC TO BK-AUD-RESULT
    CALL "BAUD" USING BK-AUD-PARMS
    MOVE "ST" TO PAY-RES-STATUS
    MOVE "SETTLED" TO PAY-RES-MSG
    PERFORM EMIT-SETTLED
    PERFORM MARK-COMPLETE.

EMIT-SETTLED.
    MOVE PAY-AMOUNT TO WS-AMT-ED
    MOVE SPACES TO WS-EVT-PAYLOAD
    STRING FUNCTION TRIM(PAY-SRC) DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(PAY-DST) DELIMITED SIZE
        "|" DELIMITED SIZE WS-AMT-ED DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(PAY-CURRENCY) DELIMITED SIZE
        "|" DELIMITED SIZE FUNCTION TRIM(PAY-RAIL) DELIMITED SIZE
        INTO WS-EVT-PAYLOAD
    END-STRING
    MOVE "PAYMENT.SETTLED.v1" TO BK-EVT-TYPE
    MOVE PAY-RES-ID TO BK-EVT-KEY
    MOVE WS-EVT-PAYLOAD TO BK-EVT-PAYLOAD
    CALL "BEVT" USING BK-EVT-PARMS.

MARK-COMPLETE.
    IF WS-USE-IDM NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-KEY TO BK-IDM-TXN-ID
    MOVE SPACES TO BK-IDM-RESULT
    MOVE PAY-RES-ID TO BK-IDM-RESULT(1:12)
    MOVE PAY-RES-STATUS TO BK-IDM-RESULT(13:2)
    MOVE WS-REQ-HASH TO BK-IDM-RESULT(15:16)
    MOVE PAY-RES-MSG TO BK-IDM-RESULT(31:90)
    MOVE "C" TO BK-IDM-MODE
    CALL "BIDM" USING BK-IDM-PARMS.

MARK-FAIL.
    IF WS-USE-IDM NOT = "Y"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-KEY TO BK-IDM-TXN-ID
    MOVE PAY-RES-MSG TO BK-IDM-RESULT
    MOVE "F" TO BK-IDM-MODE
    CALL "BIDM" USING BK-IDM-PARMS.
