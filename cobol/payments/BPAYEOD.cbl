IDENTIFICATION DIVISION.
PROGRAM-ID. BPAYEOD.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PAY-FILE ASSIGN TO WS-PAY-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PAY-ID
        FILE STATUS IS WS-PAY-ST.
    SELECT PST-FILE ASSIGN TO WS-PST-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        ACCESS MODE IS SEQUENTIAL
        FILE STATUS IS WS-PST-ST.

DATA DIVISION.
FILE SECTION.
FD PAY-FILE.
01 PAY-REC.
   COPY "BPAYREC".
FD PST-FILE.
01 PST-LINE PIC X(300).

WORKING-STORAGE SECTION.
01 WS-PAY-PATH PIC X(200).
01 WS-PST-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-PAY-ST PIC X(02).
01 WS-PST-ST PIC X(02).
01 WS-EOF PIC X(01).
01 WS-I PIC 9(04).
01 WS-FOUND PIC X(01).
01 WS-TAG PIC X(04).
01 WS-GL PIC X(10).
01 WS-DC PIC X(01).
01 WS-AMT PIC X(30).
01 WS-ENTITY PIC X(20).
01 WS-CUR PIC X(03).
01 WS-JRN PIC X(20).
01 WS-DATE PIC X(08).
01 WS-J-COUNT PIC 9(04) VALUE 0.
01 WS-J-MAX PIC 9(04) VALUE 300.
01 WS-J-TBL.
   05 WS-J-ROW OCCURS 300 TIMES.
      10 WS-J-ID PIC X(20).

LINKAGE SECTION.
COPY "BPAYEODP".

PROCEDURE DIVISION USING BK-PAY-EOD.
    MOVE 0 TO PE-TOTAL
    MOVE 0 TO PE-CREATED
    MOVE 0 TO PE-SETTLED
    MOVE 0 TO PE-FAILED
    MOVE 0 TO PE-RETURNED
    MOVE 0 TO PE-REVERSED
    MOVE 0 TO PE-CANCELLED
    MOVE 0 TO PE-PENDING
    MOVE 0 TO PE-MATCHED
    MOVE 0 TO PE-BROKEN
    MOVE 0 TO PE-SETTLED-AMT
    MOVE "00" TO PE-RC
    MOVE SPACES TO PE-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-PAY-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pay.idx"
        DELIMITED SIZE INTO WS-PAY-PATH
    MOVE SPACES TO WS-PST-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/journal/postings.log"
        DELIMITED SIZE INTO WS-PST-PATH
    PERFORM LOAD-JOURNALS
    PERFORM SCAN-PAYMENTS
    IF PE-BROKEN > 0
        MOVE "20" TO PE-RC
        MOVE "PAYMENT RECONCILIATION BROKEN" TO PE-MSG
    ELSE
        MOVE "PAYMENTS RECONCILED" TO PE-MSG
    END-IF
    GOBACK.

LOAD-JOURNALS.
    MOVE 0 TO WS-J-COUNT
    OPEN INPUT PST-FILE
    IF WS-PST-ST NOT = "00"
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PST-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM LOAD-ONE-JOURNAL
        END-READ
    END-PERFORM
    CLOSE PST-FILE.

LOAD-ONE-JOURNAL.
    IF PST-LINE(1:4) NOT = "GLP|"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-TAG WS-GL WS-DC WS-AMT WS-ENTITY
        WS-CUR WS-JRN WS-DATE
    UNSTRING PST-LINE DELIMITED BY "|"
        INTO WS-TAG WS-GL WS-DC WS-AMT WS-ENTITY WS-CUR
        WS-JRN WS-DATE
    END-UNSTRING
    IF WS-JRN = SPACES
        EXIT PARAGRAPH
    END-IF
    PERFORM FIND-JOURNAL
    IF WS-FOUND = "N" AND WS-J-COUNT < WS-J-MAX
        ADD 1 TO WS-J-COUNT
        MOVE WS-JRN TO WS-J-ID(WS-J-COUNT)
    END-IF.

FIND-JOURNAL.
    MOVE "N" TO WS-FOUND
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-J-COUNT
        IF WS-J-ID(WS-I) = WS-JRN
            MOVE "Y" TO WS-FOUND
            EXIT PERFORM
        END-IF
    END-PERFORM.

SCAN-PAYMENTS.
    OPEN INPUT PAY-FILE
    IF WS-PAY-ST NOT = "00"
        MOVE "NO PAYMENTS" TO PE-MSG
        EXIT PARAGRAPH
    END-IF
    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ PAY-FILE NEXT RECORD
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM CLASSIFY-PAYMENT
        END-READ
    END-PERFORM
    CLOSE PAY-FILE.

CLASSIFY-PAYMENT.
    ADD 1 TO PE-TOTAL
    EVALUATE PAY-STATUS
        WHEN "CR"
            ADD 1 TO PE-CREATED
            ADD 1 TO PE-PENDING
        WHEN "VA"
            ADD 1 TO PE-PENDING
        WHEN "AU"
            ADD 1 TO PE-PENDING
        WHEN "PR"
            ADD 1 TO PE-PENDING
        WHEN "ST"
            ADD 1 TO PE-SETTLED
            ADD PAY-AMOUNT TO PE-SETTLED-AMT
            PERFORM CHECK-SETTLED
        WHEN "RJ"
            ADD 1 TO PE-FAILED
        WHEN "RT"
            ADD 1 TO PE-RETURNED
        WHEN "RV"
            ADD 1 TO PE-REVERSED
        WHEN "CN"
            ADD 1 TO PE-CANCELLED
        WHEN OTHER
            CONTINUE
    END-EVALUATE.

CHECK-SETTLED.
    MOVE PAY-JRN-ID TO WS-JRN
    PERFORM FIND-JOURNAL
    IF WS-FOUND = "Y"
        ADD 1 TO PE-MATCHED
    ELSE
        ADD 1 TO PE-BROKEN
    END-IF.
