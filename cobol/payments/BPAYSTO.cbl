IDENTIFICATION DIVISION.
PROGRAM-ID. BPAYSTO.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PAY-FILE ASSIGN TO WS-PAY-PATH
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS PAY-ID
        FILE STATUS IS WS-PAY-ST.

DATA DIVISION.
FILE SECTION.
FD PAY-FILE.
01 PAY-REC.
   COPY "BPAYREC".

WORKING-STORAGE SECTION.
01 WS-PAY-PATH PIC X(200).
01 WS-HOME PIC X(80).
01 WS-PAY-ST PIC X(02).

LINKAGE SECTION.
COPY "BPAYSTOP".
01 BK-PAY-REC.
   COPY "BPAYREC".

PROCEDURE DIVISION USING BK-PAY-STO-REQ BK-PAY-REC.
    MOVE "00" TO PS-RC
    MOVE SPACES TO PS-MSG
    ACCEPT WS-HOME FROM ENVIRONMENT "BANK_HOME"
    MOVE SPACES TO WS-PAY-PATH
    STRING FUNCTION TRIM(WS-HOME) "/var/data/pay.idx"
        DELIMITED SIZE INTO WS-PAY-PATH
    EVALUATE PS-OP
        WHEN "WRITE" PERFORM DO-WRITE
        WHEN "REWRITE" PERFORM DO-REWRITE
        WHEN OTHER MOVE "99" TO PS-RC
    END-EVALUATE
    GOBACK.

OPEN-STORE.
    OPEN I-O PAY-FILE
    IF WS-PAY-ST = "35"
        OPEN OUTPUT PAY-FILE
        CLOSE PAY-FILE
        OPEN I-O PAY-FILE
    END-IF
    IF WS-PAY-ST NOT = "00"
        MOVE WS-PAY-ST TO PS-RC
        MOVE "CANNOT OPEN PAYMENT INDEX" TO PS-MSG
    END-IF.

DO-WRITE.
    MOVE BK-PAY-REC TO PAY-REC
    PERFORM OPEN-STORE
    IF PS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    WRITE PAY-REC
        INVALID KEY
            MOVE "22" TO PS-RC
            MOVE "PAYMENT ALREADY EXISTS" TO PS-MSG
    END-WRITE
    CLOSE PAY-FILE.

DO-REWRITE.
    MOVE BK-PAY-REC TO PAY-REC
    PERFORM OPEN-STORE
    IF PS-RC NOT = "00"
        EXIT PARAGRAPH
    END-IF
    READ PAY-FILE
    IF WS-PAY-ST = "00"
        MOVE BK-PAY-REC TO PAY-REC
        REWRITE PAY-REC
    ELSE
        MOVE "23" TO PS-RC
        MOVE "PAYMENT NOT FOUND" TO PS-MSG
    END-IF
    CLOSE PAY-FILE.
