IDENTIFICATION DIVISION.
PROGRAM-ID. TESTBTXNVAL.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BTXNLFC".
COPY "BTXNVALP".
COPY "BCREXP".

PROCEDURE DIVISION.
    *> Setup: Open an active credit facility with contracted limit 100,000.00 BRL
    MOVE SPACES TO BK-CR-EXP-PARMS
    MOVE "OPEN"         TO CE-OP
    MOVE "FAC-TEST-001" TO CE-FAC-ID
    MOVE "ACT"          TO CE-STATUS
    MOVE 100000.00      TO CE-APPROVED
    MOVE 100000.00      TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS

    *> Disburse 20,000.00 to establish current drawn principal (leaving 80,000.00 headroom)
    MOVE "DISBURSE"     TO CE-OP
    MOVE "FAC-TEST-001" TO CE-FAC-ID
    MOVE 20000.00       TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS

    *> Test 1: Valid charge within available credit headroom (30,000.00 <= 80,000.00)
    MOVE SPACES TO BK-TXN-LFC-REQ BK-TXN-VAL
    MOVE "CREDCHRG"     TO LFC-TYPE
    MOVE "FAC-TEST-001" TO LFC-FACILITY
    MOVE 30000.00       TO LFC-AMOUNT
    MOVE "BRL"          TO LFC-CURRENCY
    CALL "BTXNVAL" USING BK-TXN-LFC-REQ BK-TXN-VAL
    DISPLAY "test=charge_valid rc=" VAL-RC " msg=" FUNCTION TRIM(VAL-MSG)

    *> Test 2: Over-limit charge attempt (90,000.00 > 80,000.00 headroom -> 20k + 90k = 110k > 100k)
    *> Must fail with RC 20 and "EXCEEDS CREDIT FACILITY LIMIT"
    MOVE SPACES TO BK-TXN-LFC-REQ BK-TXN-VAL
    MOVE "CREDCHRG"     TO LFC-TYPE
    MOVE "FAC-TEST-001" TO LFC-FACILITY
    MOVE 90000.00       TO LFC-AMOUNT
    MOVE "BRL"          TO LFC-CURRENCY
    CALL "BTXNVAL" USING BK-TXN-LFC-REQ BK-TXN-VAL
    DISPLAY "test=charge_overlimit rc=" VAL-RC " msg=" FUNCTION TRIM(VAL-MSG)

    *> Test 3: Charge attempt against closed facility
    MOVE SPACES TO BK-CR-EXP-PARMS
    MOVE "STATUS"       TO CE-OP
    MOVE "FAC-TEST-001" TO CE-FAC-ID
    MOVE "CLO"          TO CE-STATUS
    CALL "BCRUPD" USING BK-CR-EXP-PARMS

    MOVE SPACES TO BK-TXN-LFC-REQ BK-TXN-VAL
    MOVE "CREDCHRG"     TO LFC-TYPE
    MOVE "FAC-TEST-001" TO LFC-FACILITY
    MOVE 1000.00        TO LFC-AMOUNT
    MOVE "BRL"          TO LFC-CURRENCY
    CALL "BTXNVAL" USING BK-TXN-LFC-REQ BK-TXN-VAL
    DISPLAY "test=charge_closed rc=" VAL-RC " msg=" FUNCTION TRIM(VAL-MSG)

    *> Test 4: Charge attempt against inactive facility (status PEN)
    MOVE SPACES TO BK-CR-EXP-PARMS
    MOVE "OPEN"         TO CE-OP
    MOVE "FAC-TEST-002" TO CE-FAC-ID
    MOVE "PEN"          TO CE-STATUS
    MOVE 50000.00       TO CE-APPROVED
    MOVE 50000.00       TO CE-AMOUNT
    CALL "BCRUPD" USING BK-CR-EXP-PARMS

    MOVE SPACES TO BK-TXN-LFC-REQ BK-TXN-VAL
    MOVE "CREDCHRG"     TO LFC-TYPE
    MOVE "FAC-TEST-002" TO LFC-FACILITY
    MOVE 1000.00        TO LFC-AMOUNT
    MOVE "BRL"          TO LFC-CURRENCY
    CALL "BTXNVAL" USING BK-TXN-LFC-REQ BK-TXN-VAL
    DISPLAY "test=charge_inactive rc=" VAL-RC " msg=" FUNCTION TRIM(VAL-MSG)

    GOBACK.
